---
import type { AcademyItem, AcademySlide } from "../lib/academyDb";

interface Props {
  item: AcademyItem;
  backHref: string;
  autoPrint?: boolean;
  isEditMode?: boolean;
  isPreview?: boolean;
}

const { item, backHref, autoPrint = false, isEditMode = false, isPreview = false } = Astro.props;
const customPdfUrl = item.landingData?.customPdfUrl?.trim() || "";
const slides: AcademySlide[] =
  item.slides.length > 0
    ? item.slides
    : [
        {
          id: "fallback-1",
          layout: "cover",
          eyebrow: item.kind === "course" ? "Adaptif Course" : "Adaptif Guide",
          title: item.title,
          body: item.subtitle || item.description,
          bullets: item.landingData.takeaways.slice(0, 3)
        }
      ];
const ed = (slideIdx: number, field: string, bulletIdx?: number): Record<string, string> =>
  isEditMode
    ? {
        contenteditable: "true",
        spellcheck: "false",
        "data-slide-idx": String(slideIdx),
        "data-slide-field": field,
        ...(bulletIdx !== undefined ? { "data-bullet-idx": String(bulletIdx) } : {})
      }
    : {};
---

<div class="viewer-shell" data-auto-print={autoPrint ? "true" : "false"} data-edit-mode={isEditMode ? "true" : "false"}>
  <!-- Top Controls (hidden in PDF print) -->
  <header class="viewer-topbar no-print">
    <div class="topbar-left">
      <a href={backHref} class="topbar-back">
        <span aria-hidden="true">←</span>
        <span>Back</span>
      </a>
      <div class="topbar-meta">
        <span class:list={["topbar-badge", { "is-course": item.kind === "course" }]}>
          {item.kind === "course" ? "Course" : "Guide"}
        </span>
        <h1 class="topbar-title">{item.title}</h1>
      </div>
    </div>

    <div class="topbar-right">
      {item.kind === "course" && item.toolUrl && (
        <a href={item.toolUrl} target="_blank" rel="noopener noreferrer" class="btn-tool-link">
          <span>{item.toolName || "Open Companion Tool"}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <span class="slide-counter" id="slide-counter">1 / {customPdfUrl ? "…" : slides.length}</span>
      <button type="button" class="btn-viewer-ghost" id="btn-fullscreen" title="Fullscreen">
        Fullscreen
      </button>
      {!customPdfUrl && (
        <button type="button" class="btn-download-pdf" id="btn-download-pdf">
          Download PDF
        </button>
      )}
      {customPdfUrl && (
        <a href={customPdfUrl} download target="_blank" rel="noopener noreferrer" class="btn-download-pdf">
          Download PDF
        </a>
      )}
    </div>
  </header>

  {customPdfUrl ? (
    <div class="viewer-workspace no-print">
      <aside class="viewer-sidebar" aria-label="PDF Page index">
        <div class="sidebar-head">
          <span class="sidebar-label">PAGES INDEX</span>
          <span class="sidebar-count" id="custom-pdf-count">…</span>
        </div>
        <nav class="viewer-strip" id="custom-pdf-strip" aria-label="Page selector"></nav>
      </aside>
      <main class="viewer-stage">
        <button type="button" class="nav-arrow nav-prev" id="pdf-prev" aria-label="Previous page" disabled>
          ←
        </button>
        <div class="slides-stage" id="custom-pdf-stage" data-custom-pdf-url={customPdfUrl} style="width:100%;max-width:960px;display:flex;justify-content:center;align-items:center;">
          <div class="pdf-loading-state" id="custom-pdf-loading">Loading PDF pages…</div>
        </div>
        <button type="button" class="nav-arrow nav-next" id="pdf-next" aria-label="Next page">
          →
        </button>
      </main>
    </div>
  ) : (
    <div class="viewer-workspace no-print">
    <!-- Left Slide Index Sidebar (hidden in PDF print) -->
    <aside class="viewer-sidebar" aria-label="Slide index">
      <div class="sidebar-head">
        <span class="sidebar-label">SLIDES INDEX</span>
        <span class="sidebar-count">{slides.length}</span>
      </div>
      <nav class="viewer-strip" aria-label="Slide selector">
        {slides.map((slide, idx) => (
          <button
            type="button"
            class:list={["strip-btn", { "is-active": idx === 0 }]}
            data-goto-slide={idx}
          >
            <span class="strip-num">{String(idx + 1).padStart(2, "0")}</span>
            <span class="strip-title">{slide.title}</span>
          </button>
        ))}
      </nav>
    </aside>

    <!-- Interactive Web Stage (hidden in PDF print) -->
    <main class="viewer-stage" id="viewer-stage">
    <button type="button" class="stage-nav stage-prev" id="btn-prev" aria-label="Previous slide">
      ←
    </button>

    <div class="stage-viewport">
      {slides.map((slide, idx) => (
        <article
          class:list={["slide-card", `layout-${slide.layout}`, { "is-active": idx === 0 }]}
          data-slide-index={idx}
          aria-hidden={idx === 0 ? "false" : "true"}
        >
          <div class="slide-glow" aria-hidden="true"></div>
          <div class="slide-header-row">
            <span class="slide-eyebrow" {...ed(idx, "eyebrow")}>{slide.eyebrow || item.category}</span>
            <span class="slide-brand-mark">ADAPTIF ACADEMY</span>
          </div>

          <div class="slide-content-area">
            {slide.layout === "cover" ? (
              <div class="slide-cover-wrap">
                <h2 class="slide-title is-cover" {...ed(idx, "title")}>{slide.title}</h2>
                {(slide.body || isEditMode) && <p class="slide-body is-cover" {...ed(idx, "body")}>{slide.body}</p>}
                {slide.bullets.length > 0 && (
                  <div class="slide-pills">
                    {slide.bullets.map((b, bIdx) => (
                      <span class="slide-pill" {...ed(idx, "bullet", bIdx)}>{b}</span>
                    ))}
                  </div>
                )}
              </div>
            ) : slide.layout === "quote" ? (
              <div class="slide-quote-wrap">
                <blockquote class="slide-quote" {...ed(idx, "title")}>{slide.title}</blockquote>
                {(slide.body || isEditMode) && <p class="slide-body" {...ed(idx, "body")}>{slide.body}</p>}
              </div>
            ) : slide.layout === "grid" ? (
              <div class="slide-grid-wrap">
                <div class="slide-head-block">
                  <h2 class="slide-title" {...ed(idx, "title")}>{slide.title}</h2>
                  {(slide.body || isEditMode) && <p class="slide-body" {...ed(idx, "body")}>{slide.body}</p>}
                </div>
                <div class="slide-cards-grid">
                  {slide.bullets.map((b, bIdx) => (
                    <div class="slide-mini-card">
                      <span class="mini-num">0{bIdx + 1}</span>
                      <p class="mini-text" {...ed(idx, "bullet", bIdx)}>{b}</p>
                    </div>
                  ))}
                </div>
              </div>
            ) : slide.layout === "split" ? (
              <div class="slide-split-wrap">
                <div class="split-left">
                  <h2 class="slide-title" {...ed(idx, "title")}>{slide.title}</h2>
                  {(slide.body || isEditMode) && <p class="slide-body" {...ed(idx, "body")}>{slide.body}</p>}
                  {(slide.callout || isEditMode) && <div class="slide-callout" {...ed(idx, "callout")}>{slide.callout}</div>}
                </div>
                <div class="split-right">
                  {slide.image ? (
                    <img src={slide.image} alt={slide.title} class="split-img" />
                  ) : (
                    <ul class="slide-bullet-list">
                      {slide.bullets.map((b, bIdx) => (
                        <li {...ed(idx, "bullet", bIdx)}>{b}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            ) : (
              <div class="slide-bullets-wrap">
                <h2 class="slide-title" {...ed(idx, "title")}>{slide.title}</h2>
                {(slide.body || isEditMode) && <p class="slide-body" {...ed(idx, "body")}>{slide.body}</p>}
                {slide.bullets.length > 0 && (
                  <ul class="slide-bullet-list">
                    {slide.bullets.map((b, bIdx) => (
                      <li {...ed(idx, "bullet", bIdx)}>{b}</li>
                    ))}
                  </ul>
                )}
                {(slide.callout || isEditMode) && <div class="slide-callout" {...ed(idx, "callout")}>{slide.callout}</div>}
              </div>
            )}
          </div>

          <footer class="slide-footer-row">
            <span>{item.title}</span>
            <span>Slide {idx + 1} of {slides.length}</span>
          </footer>
        </article>
      ))}
    </div>

    <button type="button" class="stage-nav stage-next" id="btn-next" aria-label="Next slide">
      →
    </button>
  </main>
  </div>
  )}

  <!-- Print-Only Exact 16:9 Vector PDF Deck -->
  <section class="print-deck" aria-hidden="true">
    {slides.map((slide, idx) => (
      <article class:list={["slide-card", "is-print-page", `layout-${slide.layout}`]}>
        <div class="slide-glow"></div>
        <div class="slide-header-row">
          <span class="slide-eyebrow">{slide.eyebrow || item.category}</span>
          <span class="slide-brand-mark">ADAPTIF ACADEMY</span>
        </div>

        <div class="slide-content-area">
          {slide.layout === "cover" ? (
            <div class="slide-cover-wrap">
              <h2 class="slide-title is-cover">{slide.title}</h2>
              {slide.body && <p class="slide-body is-cover">{slide.body}</p>}
              {slide.bullets.length > 0 && (
                <div class="slide-pills">
                  {slide.bullets.map((b) => (
                    <span class="slide-pill">{b}</span>
                  ))}
                </div>
              )}
            </div>
          ) : slide.layout === "quote" ? (
            <div class="slide-quote-wrap">
              <blockquote class="slide-quote">“{slide.title}”</blockquote>
              {slide.body && <p class="slide-body">{slide.body}</p>}
            </div>
          ) : slide.layout === "grid" ? (
            <div class="slide-grid-wrap">
              <div class="slide-head-block">
                <h2 class="slide-title">{slide.title}</h2>
                {slide.body && <p class="slide-body">{slide.body}</p>}
              </div>
              <div class="slide-cards-grid">
                {slide.bullets.map((b, bIdx) => (
                  <div class="slide-mini-card">
                    <span class="mini-num">0{bIdx + 1}</span>
                    <p class="mini-text">{b}</p>
                  </div>
                ))}
              </div>
            </div>
          ) : slide.layout === "split" ? (
            <div class="slide-split-wrap">
              <div class="split-left">
                <h2 class="slide-title">{slide.title}</h2>
                {slide.body && <p class="slide-body">{slide.body}</p>}
                {slide.callout && <div class="slide-callout">{slide.callout}</div>}
              </div>
              <div class="split-right">
                {slide.image ? (
                  <img src={slide.image} alt={slide.title} class="split-img" />
                ) : (
                  <ul class="slide-bullet-list">
                    {slide.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ) : (
            <div class="slide-bullets-wrap">
              <h2 class="slide-title">{slide.title}</h2>
              {slide.body && <p class="slide-body">{slide.body}</p>}
              {slide.bullets.length > 0 && (
                <ul class="slide-bullet-list">
                  {slide.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
              {slide.callout && <div class="slide-callout">{slide.callout}</div>}
            </div>
          )}
        </div>

        <footer class="slide-footer-row">
          <span>{item.title}</span>
          <span>Slide {idx + 1} of {slides.length}</span>
        </footer>
      </article>
    ))}
  </section>

  {isEditMode && (
    <div class="slide-edit-bar no-print" id="slide-edit-bar">
      <div class="slide-edit-info">
        <span class="slide-edit-dot"></span>
        <span>Slide &amp; PDF Edit Mode — Click any text on the slide to edit</span>
      </div>
      <div class="slide-edit-actions">
        <span class="slide-edit-toast" id="slide-edit-toast" hidden>Saved!</span>
        <button type="button" class="btn-download-pdf" id="btn-save-slides">
          Save Slides / PDF
        </button>
      </div>
    </div>
  )}

  {isEditMode && (
    <script
      type="application/json"
      id="slide-edit-seed"
      set:html={JSON.stringify({ id: item.id, slides })}
    />
  )}
</div>

<script>
  const customPdfStage = document.getElementById("custom-pdf-stage");
  const customPdfUrl = customPdfStage?.getAttribute("data-custom-pdf-url");
  if (customPdfStage && customPdfUrl) {
    (async () => {
      try {
        const pdfjsLib = await import(
          /* @vite-ignore */ "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.min.mjs"
        );
        pdfjsLib.GlobalWorkerOptions.workerSrc =
          "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.worker.min.mjs";

        const pdf = await pdfjsLib.getDocument(customPdfUrl).promise;
        const total = pdf.numPages;
        const countEl = document.getElementById("custom-pdf-count");
        const counterEl = document.getElementById("slide-counter");
        const stripEl = document.getElementById("custom-pdf-strip");
        const loadingEl = document.getElementById("custom-pdf-loading");
        const prevBtn = document.getElementById("pdf-prev") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("pdf-next") as HTMLButtonElement | null;
        if (countEl) countEl.textContent = String(total);
        if (counterEl) counterEl.textContent = `1 / ${total}`;
        if (loadingEl) loadingEl.remove();

        let currentPage = 1;
        const sheets: HTMLElement[] = [];

        function showPage(pageNum: number) {
          if (pageNum < 1 || pageNum > total) return;
          currentPage = pageNum;
          sheets.forEach((s, idx) => {
            s.style.display = idx + 1 === currentPage ? "flex" : "none";
          });
          if (counterEl) counterEl.textContent = `${currentPage} / ${total}`;
          if (prevBtn) prevBtn.disabled = currentPage <= 1;
          if (nextBtn) nextBtn.disabled = currentPage >= total;
          stripEl?.querySelectorAll(".strip-btn").forEach((b, idx) => {
            b.classList.toggle("is-active", idx + 1 === currentPage);
          });
        }

        prevBtn?.addEventListener("click", () => showPage(currentPage - 1));
        nextBtn?.addEventListener("click", () => showPage(currentPage + 1));
        document.getElementById("btn-fullscreen")?.addEventListener("click", () => {
          const shell = document.querySelector(".viewer-shell");
          if (!document.fullscreenElement && shell) {
            shell.requestFullscreen?.().catch(() => {});
          } else {
            document.exitFullscreen?.().catch(() => {});
          }
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") showPage(currentPage - 1);
          if (e.key === "ArrowRight") showPage(currentPage + 1);
        });

        for (let i = 1; i <= total; i++) {
          if (stripEl) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = `strip-btn${i === 1 ? " is-active" : ""}`;
            btn.innerHTML = `<span class="strip-num">${String(i).padStart(2, "0")}</span><span class="strip-title">Page ${i}</span>`;
            btn.addEventListener("click", () => showPage(i));
            stripEl.appendChild(btn);
          }

          const page = await pdf.getPage(i);
          const viewport = page.getViewport({ scale: 1.6 });
          const sheet = document.createElement("section");
          sheet.className = "slide-sheet pdf-page-sheet";
          sheet.id = `pdf-page-${i}`;
          sheet.style.padding = "0";
          sheet.style.overflow = "hidden";
          sheet.style.display = i === 1 ? "flex" : "none";
          sheet.style.alignItems = "center";
          sheet.style.justifyContent = "center";
          sheet.style.background = "#0b1220";
          sheet.style.borderRadius = "16px";
          sheet.style.border = "1px solid rgba(255, 255, 255, 0.12)";
          sheet.style.width = "100%";

          const canvas = document.createElement("canvas");
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          canvas.style.width = "100%";
          canvas.style.height = "auto";
          canvas.style.maxHeight = "calc(100vh - 140px)";
          canvas.style.objectFit = "contain";
          canvas.style.display = "block";
          sheet.appendChild(canvas);
          customPdfStage.appendChild(sheet);
          sheets.push(sheet);

          const ctx = canvas.getContext("2d");
          if (ctx) {
            await page.render({ canvasContext: ctx, viewport }).promise;
          }
        }
        showPage(1);
      } catch (err) {
        const loadingEl = document.getElementById("custom-pdf-loading");
        if (loadingEl) {
          loadingEl.textContent = "Could not render PDF inline. Use Download PDF above.";
        }
      }
    })();
  }
</script>

<script>
  const shell = document.querySelector<HTMLElement>(".viewer-shell");
  const slideCards = Array.from(document.querySelectorAll<HTMLElement>(".stage-viewport .slide-card"));
  const stripBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-goto-slide]"));
  const counterEl = document.getElementById("slide-counter");
  const prevBtn = document.getElementById("btn-prev");
  const nextBtn = document.getElementById("btn-next");
  const pdfBtn = document.getElementById("btn-download-pdf");
  const fsBtn = document.getElementById("btn-fullscreen");
  const stageEl = document.getElementById("viewer-stage");

  let activeIndex = 0;

  function showSlide(index: number) {
    if (slideCards.length === 0) return;
    activeIndex = (index + slideCards.length) % slideCards.length;

    slideCards.forEach((card, i) => {
      const isCurrent = i === activeIndex;
      card.classList.toggle("is-active", isCurrent);
      card.setAttribute("aria-hidden", String(!isCurrent));
    });

    stripBtns.forEach((btn, i) => {
      btn.classList.toggle("is-active", i === activeIndex);
    });

    if (counterEl) {
      counterEl.textContent = `${activeIndex + 1} / ${slideCards.length}`;
    }
  }

  prevBtn?.addEventListener("click", () => showSlide(activeIndex - 1));
  nextBtn?.addEventListener("click", () => showSlide(activeIndex + 1));

  stripBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const idx = Number(btn.dataset.gotoSlide ?? 0);
      showSlide(idx);
    });
  });

  document.addEventListener("keydown", (e) => {
    if ((e.target as HTMLElement | null)?.isContentEditable) return;
    if (e.key === "ArrowRight" || e.key === " ") {
      e.preventDefault();
      showSlide(activeIndex + 1);
    } else if (e.key === "ArrowLeft") {
      e.preventDefault();
      showSlide(activeIndex - 1);
    }
  });

  pdfBtn?.addEventListener("click", () => {
    window.print();
  });

  fsBtn?.addEventListener("click", () => {
    if (!document.fullscreenElement) {
      stageEl?.requestFullscreen?.().catch(() => {});
    } else {
      document.exitFullscreen?.().catch(() => {});
    }
  });

  if (shell?.dataset.autoPrint === "true") {
    window.addEventListener("load", () => {
      setTimeout(() => window.print(), 350);
    });
  }

  // Inline Slide & PDF Edit Mode (?edit=1)
  (() => {
    const seedEl = document.getElementById("slide-edit-seed");
    if (!seedEl) return;
    const seed = JSON.parse(seedEl.textContent || "{}");
    const saveBtn = document.getElementById("btn-save-slides") as HTMLButtonElement | null;
    const toastEl = document.getElementById("slide-edit-toast");

    function showToast(msg: string) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.hidden = false;
      window.setTimeout(() => {
        if (toastEl) toastEl.hidden = true;
      }, 2600);
    }

    function collectEditedSlides() {
      const updated = JSON.parse(JSON.stringify(seed.slides || []));
      document.querySelectorAll<HTMLElement>("[data-slide-idx][data-slide-field]").forEach((el) => {
        const sIdx = Number(el.dataset.slideIdx);
        const field = el.dataset.slideField || "";
        const val = (el.textContent || "").trim();
        if (!updated[sIdx]) return;

        if (field === "bullet") {
          const bIdx = Number(el.dataset.bulletIdx);
          if (!Array.isArray(updated[sIdx].bullets)) updated[sIdx].bullets = [];
          updated[sIdx].bullets[bIdx] = val;
        } else {
          updated[sIdx][field] = val;
        }
      });
      return updated;
    }

    saveBtn?.addEventListener("click", async () => {
      if (!saveBtn || !seed.id) return;
      saveBtn.disabled = true;
      saveBtn.textContent = "Saving...";
      try {
        const updatedSlides = collectEditedSlides();
        const res = await fetch(`/api/academy/items/${seed.id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slides: updatedSlides })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.error || "Save failed");

        seed.slides = updatedSlides;
        updatedSlides.forEach((s: any, idx: number) => {
          const stripTitle = document.querySelector<HTMLElement>(`[data-goto-slide="${idx}"] .strip-title`);
          if (stripTitle) stripTitle.textContent = s.title || "";
          const printCard = document.querySelectorAll<HTMLElement>(".print-deck .slide-card")[idx];
          if (printCard) {
            const pe = printCard.querySelector<HTMLElement>(".slide-eyebrow");
            const pt = printCard.querySelector<HTMLElement>(".slide-title, .slide-quote");
            const pb = printCard.querySelector<HTMLElement>(".slide-body");
            const pc = printCard.querySelector<HTMLElement>(".slide-callout");
            if (pe && s.eyebrow) pe.textContent = s.eyebrow;
            if (pt) pt.textContent = s.title || "";
            if (pb) pb.textContent = s.body || "";
            if (pc) pc.textContent = s.callout || "";
          }
        });
        showToast("Slides & PDF saved!");
      } catch (err: any) {
        showToast(err?.message || "Save failed");
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = "Save Slides / PDF";
      }
    });
  })();
</script>

<style>
  .viewer-shell {
    min-height: 100vh;
    background: #010307;
    color: #f8fafc;
    display: flex;
    flex-direction: column;
  }

  .viewer-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(4, 9, 26, 0.88);
    backdrop-filter: blur(18px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .topbar-left,
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .topbar-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .topbar-back:hover {
    border-color: rgba(72, 200, 255, 0.4);
    color: #ffffff;
  }

  .topbar-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .topbar-badge {
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 9px;
    border-radius: 999px;
    color: #6ee7b7;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    white-space: nowrap;
