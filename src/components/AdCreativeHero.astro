---
// AdCreativeHero.astro - Full-bleed Hero + bottom service marquee strip for /ad-creative

const stripCards = [
  { label: "Static Design", image: "/images/ad-creative/offer-static.jpg", href: "#ad-offer" },
  { label: "Marketing Strategy", image: "/images/ad-creative/offer-strategy.jpg", href: "/marketing-strategy" },
  { label: "Concepting", image: "/images/ad-creative/offer-concepting.jpg", href: "#ad-offer" },
  { label: "Video Production", image: "/images/ad-creative/offer-video.jpg", href: "#ad-offer" },
  { label: "Motion Graphics", image: "/images/ad-creative/offer-motion.jpg", href: "#ad-offer" },
  { label: "Illustration", image: "/images/ad-creative/offer-illustration.jpg", href: "#ad-offer" },
  { label: "Transcreation", image: "/images/ad-creative/offer-localization.jpg", href: "#ad-offer" },
  { label: "Landing Page Design", image: "/images/ad-creative/offer-landing.jpg", href: "/web-design" },
];
---

<section class="ac-hero" id="ad-creative-hero" aria-labelledby="ac-hero-title">
  <div class="ac-hero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/ad-creative/hero-mobile.jpg" />
      <img
        src="/images/ad-creative/hero-desktop.jpg"
        alt=""
        class="ac-hero__bg"
        loading="eager"
        decoding="async"
        data-cms-key="adcreative.hero.image"
      />
    </picture>
    <div class="ac-hero__scrim"></div>
    <div class="ac-hero__bottom-fade"></div>
  </div>

  <div class="container ac-hero__container">
    <div class="ac-hero__content">
      <p class="adaptif-eyebrow" data-cms-key="adcreative.hero.eyebrow">
        Ad creative services
      </p>

      <h1 id="ac-hero-title" class="ac-hero__title" data-cms-key="adcreative.hero.title">
        On-brand ads, delivered on schedule <span class="title-highlight">and built to convert</span>
      </h1>

      <p class="ac-hero__description" data-cms-key="adcreative.hero.description">
        Digital, social, display, print, or out-of-home—get the ads you need quickly and flexibly through our end-to-end creative services.
      </p>

      <div class="ac-hero__actions">
        <a
          href="#book-a-call"
          class="adaptif-btn"
          data-open-book-call
          data-cms-key="adcreative.hero.cta"
        >
          <span>Book a Call</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="ac-strip" aria-label="Ad creative deliverables overview">
    <div class="ac-strip__track">
      {[...stripCards, ...stripCards].map((card, i) => (
        <a href={card.href} class="ac-strip__card" tabindex={i >= stripCards.length ? -1 : undefined}>
          <img src={card.image} alt={card.label} class="ac-strip__img" loading="lazy" decoding="async" />
          <div class="ac-strip__scrim" aria-hidden="true"></div>
          <span class="ac-strip__label">{card.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ac-hero {
    position: relative;
    width: 100%;
    padding: clamp(128px, 16vh, 175px) 0 36px;
    overflow: hidden;
    background-color: var(--color-void);
  }

  .ac-hero__media {
    position: absolute;
    inset: 0 0 110px 0;
    z-index: 0;
    pointer-events: none;
  }

  .ac-hero__media picture {
    display: contents;
  }

  .ac-hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
    opacity: 0.9;
  }

  .ac-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.92) 0%, rgba(1, 3, 7, 0.72) 48%, rgba(1, 3, 7, 0.16) 100%),
      radial-gradient(ellipse 55% 55% at 22% 45%, rgba(72, 200, 255, 0.1) 0%, transparent 70%);
  }

  .ac-hero__bottom-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 150px;
    background: linear-gradient(180deg, transparent 0%, var(--color-void) 100%);
  }

  .ac-hero__container {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(44px, 6vw, 72px);
  }

  .ac-hero__content {
    max-width: 640px;
  }

  .ac-hero__title {
    margin: 16px 0 22px;
    font-family: var(--font-family-display);
    font-size: clamp(2.85rem, 5.4vw, 4.5rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .ac-hero__description {
    max-width: 530px;
    margin: 0 0 32px;
    font-family: var(--font-family-body);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ac-hero__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ac-strip {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 7%, #000 93%, transparent 100%);
  }

  .ac-strip__track {
    display: flex;
    gap: 14px;
    width: max-content;
    padding: 4px 0;
    animation: acStripScroll 38s linear infinite;
  }

  .ac-strip:hover .ac-strip__track {
    animation-play-state: paused;
  }

  @keyframes acStripScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .ac-strip__card {
    position: relative;
    width: 164px;
    height: 112px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    padding: 10px 12px;
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .ac-strip__card:hover {
    transform: translateY(-3px);
    border-color: rgba(72, 200, 255, 0.45);
  }

  .ac-strip__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ac-strip__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 3, 7, 0.08) 0%, rgba(1, 3, 7, 0.88) 100%);
  }

  .ac-strip__label {
    position: relative;
    z-index: 1;
    font-family: var(--font-family-body);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .ac-hero {
      padding: 120px 0 28px;
    }

    .ac-hero__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.88) 0%, rgba(1, 3, 7, 0.68) 60%, rgba(1, 3, 7, 0.94) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ac-strip__track {
      animation: none;
    }
  }
</style>
