---
// AiExcellenceHero.astro - Section 1: Hero (AI excellence)
---

<section class="ai-hero" id="ai-excellence-hero" aria-labelledby="ai-hero-title">
  <div class="ai-hero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/ai-excellence/hero-mobile.jpg" />
      <img
        src="/images/ai-excellence/hero-desktop.jpg"
        alt=""
        class="ai-hero__bg"
        loading="eager"
        decoding="async"
      />
    </picture>
    <div class="ai-hero__scrim"></div>
    <div class="ai-hero__bottom-fade"></div>
  </div>

  <div class="container ai-hero__container">
    <div class="ai-hero__content">
      <p class="adaptif-eyebrow" data-ai-reveal style="--ai-delay: 40ms">AI excellence</p>

      <h1 id="ai-hero-title" class="ai-hero__title" data-ai-reveal style="--ai-delay: 120ms">
        AI is the new <span class="title-highlight">creative standard</span>
      </h1>

      <p class="ai-hero__description" data-ai-reveal style="--ai-delay: 200ms">
        The best AI move is the one your clients never notice. Adaptif blends senior creative direction with AI-powered workflows — so what you get is faster output, tighter brand consistency, and zero coordination overhead on your end.
      </p>

      <div class="ai-hero__actions" data-ai-reveal style="--ai-delay: 280ms">
        <a href="#book-a-call" class="adaptif-btn" data-open-book-call>
          <span>Book a Call</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <span class="ai-hero__badge" aria-hidden="true">Made With AI</span>
</section>

<style>
  .ai-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: clamp(110px, 14vh, 160px) 0 clamp(72px, 10vh, 110px);
    overflow: hidden;
    background-color: var(--color-void);
  }

  .ai-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .ai-hero__media picture {
    display: contents;
  }

  .ai-hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    opacity: 0.92;
  }

  .ai-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.82) 0%, rgba(1, 3, 7, 0.45) 48%, rgba(1, 3, 7, 0.06) 100%),
      radial-gradient(ellipse 60% 55% at 22% 45%, rgba(72, 200, 255, 0.1) 0%, transparent 70%);
  }

  .ai-hero__bottom-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 160px;
    background: linear-gradient(180deg, transparent 0%, var(--color-void) 100%);
  }

  .ai-hero__container {
    position: relative;
    z-index: 2;
  }

  .ai-hero__content {
    max-width: 620px;
  }

  .ai-hero__title {
    margin: 18px 0 22px;
    font-family: var(--font-family-display);
    font-size: clamp(2.85rem, 5.4vw, 4.5rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .ai-hero__description {
    max-width: 540px;
    margin: 0 0 34px;
    font-family: var(--font-family-body);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ai-hero__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-hero__badge {
    position: absolute;
    right: clamp(96px, 8vw, 120px);
    bottom: 32px;
    z-index: 2;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgba(248, 250, 252, 0.65);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .ai-hero__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.62) 0%, rgba(1, 3, 7, 0.88) 58%, var(--color-void) 100%);
    }

    .ai-hero__badge {
      display: none;
    }
  }
</style>
