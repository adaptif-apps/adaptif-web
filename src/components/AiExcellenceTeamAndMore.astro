---
// AiExcellenceTeamAndMore.astro - Sections 7, 8, 9 & 10: Experts, Join 100+ brands, Resources, Why Adaptif
const experts = [
  {
    name: "Néstor Paredes",
    role: "Creative Director",
    image: "/images/ai-excellence/expert-nestor.jpg",
  },
  {
    name: "Valentina Lugo",
    role: "CEO",
    image: "/images/ai-excellence/expert-valentina.jpg",
  },
  {
    name: "Jesús Paredes",
    role: "Web Developer",
    image: "/images/ai-excellence/expert-jesus.jpg",
  },
];

const blogResources = Array.from({ length: 4 }, () => ({
  meta: "Creative Leadership • 8 min read",
  title: "6 AI applications that actually save time (with real examples)",
  excerpt:
    "Creative teams don’t need more AI hype. They need practical, proven applications—and real results. The real question is: where does AI actually create measurable capacity — and how do you apply it without sacrificing judgment?",
  author: "Tessa",
  role: "Sr. Content Marketing Manager",
  image: "/images/ai-excellence/blog-thumb.jpg",
  href: "/blog",
}));

const whyAdaptifCards = [
  {
    label: "Our creative talent",
    href: "/our-creative-talent",
    image: "/images/our-creative-talent/why-creative-talent.jpg",
  },
  {
    label: "AI excellence",
    href: "/ai-excellence",
    image: "/images/our-creative-talent/why-ai-excellence.jpg",
  },
  {
    label: "Our work",
    href: "/our-work",
    image: "/images/our-creative-talent/why-our-work.jpg",
  },
];
---

<!-- Section 7: Leading the charge -->
<section class="ai-team" id="experts" aria-labelledby="ai-team-title">
  <div class="container">
    <header class="ai-team__header" data-ai-reveal>
      <p class="adaptif-eyebrow">Let’s talk AI</p>
      <h2 id="ai-team-title" class="ai-team__title">
        Leading the charge <span class="title-highlight">with a team of experts</span>
      </h2>
      <div class="ai-team__cta">
        <a href="#book-a-call" class="adaptif-btn" data-open-book-call>
          <span>Book a Call</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </header>

    <div class="ai-team__grid">
      {experts.map((person, idx) => (
        <article class="ai-team__card" data-ai-reveal="scale" style={`--ai-delay: ${idx * 90}ms`}>
          <div class="ai-team__photo">
            <img src={person.image} alt={`${person.name} — ${person.role}`} loading="lazy" decoding="async" />
            <div class="ai-team__photo-scrim" aria-hidden="true"></div>
          </div>
          <div class="ai-team__meta">
            <h3 class="ai-team__name">{person.name}</h3>
            <p class="ai-team__role">{person.role}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Section 8: Join 100+ brands -->
<section class="ai-cta" id="join-brands" aria-labelledby="ai-cta-title">
  <div class="container">
    <div class="ai-cta__banner" data-ai-reveal="scale">
      <picture class="ai-cta__picture">
        <source media="(max-width: 768px)" srcset="/images/our-creative-talent/join-brands-mobile.jpg" />
        <img
          src="/images/our-creative-talent/join-brands-desktop.jpg"
          alt=""
          class="ai-cta__bg"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="ai-cta__scrim" aria-hidden="true"></div>

      <div class="ai-cta__content">
        <p class="adaptif-eyebrow" data-ai-reveal style="--ai-delay: 80ms">Join 100+ brands</p>
        <h2 id="ai-cta-title" class="ai-cta__title" data-ai-reveal style="--ai-delay: 140ms">
          Get creative support <span class="title-highlight">you can trust.</span>
        </h2>
        <p class="ai-cta__desc" data-ai-reveal style="--ai-delay: 200ms">
          You’ve seen what AI-powered creative looks like when it’s done right. Let’s talk about what that would look like for your brand.
        </p>
        <div class="ai-cta__actions" data-ai-reveal style="--ai-delay: 260ms">
          <a href="#book-a-call" class="adaptif-btn" data-open-book-call>
            <span>Book a Call</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 9: Resources -->
<section class="ai-blog" id="resources" aria-labelledby="ai-blog-title">
  <div class="container">
    <header class="ai-blog__header" data-ai-reveal>
      <p class="adaptif-eyebrow">Resources</p>
      <h2 id="ai-blog-title" class="ai-blog__title">
        Get deeper insights, real results, and practical AI strategy from the blog.
      </h2>
    </header>

    <div class="ai-blog__grid">
      {blogResources.map((post, idx) => (
        <a href={post.href} class="glass-panel ai-blog__card" data-ai-reveal="scale" style={`--ai-delay: ${idx * 75}ms`}>
          <div class="ai-blog__thumb">
            <img src={post.image} alt={post.title} loading="lazy" decoding="async" />
          </div>
          <div class="ai-blog__body">
            <p class="ai-blog__meta">{post.meta}</p>
            <h3 class="ai-blog__card-title">{post.title}</h3>
            <p class="ai-blog__excerpt">{post.excerpt}</p>
            <div class="ai-blog__author">
              <span class="ai-blog__avatar" aria-hidden="true">T</span>
              <div>
                <span class="ai-blog__author-name">{post.author}</span>
                <span class="ai-blog__author-role">{post.role}</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Section 10: Why Adaptif -->
<section class="ai-why" id="why-adaptif" aria-labelledby="ai-why-title">
  <div class="container">
    <header class="ai-why__header" data-ai-reveal>
      <p class="adaptif-eyebrow">Why Adaptif</p>
      <h2 id="ai-why-title" class="ai-why__title">
        See why the best teams <span class="title-highlight">use Adaptif</span>
      </h2>
    </header>

    <div class="ai-why__grid">
      {whyAdaptifCards.map((card, idx) => (
        <a href={card.href} class="glass-panel ai-why__card" data-ai-reveal="scale" style={`--ai-delay: ${idx * 100}ms`}>
          <div class="ai-why__media">
            <img src={card.image} alt={card.label} loading="lazy" decoding="async" />
            <div class="ai-why__media-scrim" aria-hidden="true"></div>
          </div>
          <div class="ai-why__footer">
            <span class="ai-why__label">{card.label}</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ai-team {
    padding: clamp(64px, 8vw, 110px) 0;
    background-color: var(--color-void);
  }

  .ai-team__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(42px, 5.5vw, 60px);
  }

  .ai-team__title {
    margin: 14px 0 26px;
    font-family: var(--font-family-display);
    font-size: clamp(2.15rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ai-team__cta {
    display: flex;
    justify-content: center;
  }

  .ai-team__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .ai-team__card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ai-team__photo {
    position: relative;
    aspect-ratio: 4 / 4.6;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-bevel-card);
  }

  .ai-team__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .ai-team__photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(1, 3, 7, 0.55) 100%);
  }

  .ai-team__name {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .ai-team__role {
    margin: 3px 0 0;
    font-family: var(--font-family-body);
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }

  .ai-cta {
    padding: clamp(40px, 6vw, 72px) 0;
    background-color: var(--color-void);
  }

  .ai-cta__banner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(72, 200, 255, 0.25);
    padding: clamp(40px, 6vw, 68px);
    box-shadow: var(--shadow-bevel-floating);
  }

  .ai-cta__picture {
    display: contents;
  }

  .ai-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
  }

  .ai-cta__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.78) 0%, rgba(1, 3, 7, 0.42) 50%, rgba(1, 3, 7, 0.06) 100%),
      radial-gradient(circle at 18% 50%, rgba(72, 200, 255, 0.14), transparent 65%);
  }

  .ai-cta__content {
    position: relative;
    z-index: 1;
    max-width: 520px;
  }

  .ai-cta__title {
    margin: 14px 0 16px;
    font-family: var(--font-family-display);
    font-size: clamp(2.1rem, 3.8vw, 3.1rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ai-cta__desc {
    margin: 0 0 28px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ai-blog {
    padding: clamp(64px, 8vw, 110px) 0;
    background-color: var(--color-void);
  }

  .ai-blog__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(40px, 5vw, 56px);
  }

  .ai-blog__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 3.6vw, 2.95rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .ai-blog__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-blog__card {
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-fast) var(--ease-spring), border-color var(--duration-fast) ease;
  }

  .ai-blog__card:hover {
    transform: translateY(-4px);
    border-color: rgba(72, 200, 255, 0.4);
  }

  .ai-blog__thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .ai-blog__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-blog__body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .ai-blog__meta {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.74rem;
    color: var(--color-brand-cyan);
  }

  .ai-blog__card-title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-primary);
  }

  .ai-blog__excerpt {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-blog__author {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-blog__avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-family-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-brand-cyan);
    background: rgba(72, 200, 255, 0.12);
    border: 1px solid rgba(72, 200, 255, 0.26);
    flex-shrink: 0;
  }

  .ai-blog__author-name {
    display: block;
    font-family: var(--font-family-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .ai-blog__author-role {
    display: block;
    font-family: var(--font-family-body);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .ai-why {
    padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 108px);
    background-color: var(--color-void);
  }

  .ai-why__header {
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .ai-why__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ai-why__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .ai-why__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 4.4;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring), border-color var(--duration-fast) ease;
  }

  .ai-why__card:hover {
    transform: translateY(-4px);
    border-color: rgba(72, 200, 255, 0.42);
  }

  .ai-why__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ai-why__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-why__card:hover .ai-why__media img {
    transform: scale(1.04);
  }

  .ai-why__media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 3, 7, 0.05) 35%, rgba(1, 3, 7, 0.72) 72%, rgba(1, 3, 7, 0.94) 100%);
  }

  .ai-why__footer {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-white);
    text-shadow: 0 2px 12px rgba(1, 3, 7, 0.8);
    transition: color var(--duration-fast) ease;
  }

  .ai-why__card:hover .ai-why__footer {
    color: var(--color-brand-cyan);
  }

  .ai-why__label {
    font-family: var(--font-family-body);
    font-size: 1.02rem;
    font-weight: 600;
  }

  .ai-why__footer svg {
    color: var(--color-brand-cyan);
    transition: transform var(--duration-fast) ease;
  }

  .ai-why__card:hover .ai-why__footer svg {
    transform: translateX(3px);
  }

  @media (max-width: 1024px) {
    .ai-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .ai-team__grid,
    .ai-why__grid,
    .ai-blog__grid {
      grid-template-columns: 1fr;
    }

    .ai-cta__banner {
      padding: 32px 24px;
    }

    .ai-cta__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.86) 0%, rgba(1, 3, 7, 0.95) 100%);
    }
  }
</style>
