---
// AiExcellenceWorkflows.astro - Section 5: AI workflows + Section 6: Choose your AI approach
const approaches = [
  {
    name: "Full AI",
    featured: false,
    summary:
      "Fast and scalable. Best for high-volume, format-specific production where speed and cost-per-asset matter most.",
    bullets: [
      "High-volume output at low cost per asset",
      "Always-on, no capacity constraints",
      "Ideal for repeatable, rules-based formats",
      "Requires a clear brief and brand model",
    ],
  },
  {
    name: "Hybrid",
    featured: true,
    summary:
      "AI does the heavy lifting. Humans do the heavy thinking. The model that delivers the most value for most clients.",
    bullets: [
      "Strategy and creative direction: human",
      "Production, iteration, and variation: AI",
      "Campaigns with volume and one clear idea",
      "Efficiency without losing originality",
    ],
  },
  {
    name: "Human-only",
    featured: false,
    summary:
      "100% human-crafted for high-concept, high-stakes work where nuance, emotion, and originality are non-negotiable.",
    bullets: [
      "Brand launches, rebrands & concepts",
      "Storytelling that feels genuinely human",
      "Work that challenges the brief itself",
      "When craft and judgment set you apart",
    ],
  },
];
---

<!-- Section 5: Workflows that work -->
<section class="ai-wf" id="ai-workflows" aria-labelledby="ai-wf-title">
  <div class="container">
    <div class="ai-wf__intro-grid">
      <header class="ai-wf__header" data-ai-reveal>
        <p class="adaptif-eyebrow">Workflows that work</p>
        <h2 id="ai-wf-title" class="ai-wf__title">
          AI workflows <span class="title-highlight">aren’t</span> just about speed
        </h2>
        <p class="ai-wf__subtitle">
          Every project runs through a defined sequence of human-guided, AI-powered steps from briefing through to final delivery. The result is consistent quality without the coordination overhead.
        </p>
        <p class="ai-wf__subnote">
          We’ve purpose-built workflows for ads, brand identity, social content, video, and web so your team never starts from zero, and nothing falls through the gaps.
        </p>
      </header>

      <div class="ai-wf__intro-media" data-ai-reveal="scale" style="--ai-delay: 120ms">
        <img
          src="/images/ai-excellence/workflows-preview.png"
          alt="Adaptif presentation and collaborative review workflow"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Feature 1: Custom AI image models -->
    <div class="ai-wf__split">
      <div class="ai-wf__media ai-wf__media--frameless" data-ai-reveal="scale">
        <img src="/images/ai-excellence/custom-models.png" alt="Custom AI workflow from brief to delivery" loading="lazy" decoding="async" />
      </div>
      <div class="ai-wf__body" data-ai-reveal style="--ai-delay: 100ms">
        <p class="adaptif-eyebrow">Custom AI image models</p>
        <h3 class="ai-wf__split-title">
          Custom models: <span class="title-highlight">Your brand, your AI</span>
        </h3>
        <p class="ai-wf__split-lead">Gen AI shouldn’t stand for generic AI.</p>
        <p class="ai-wf__split-desc">
          An Adaptif custom AI image model is trained on your brand: your visual language, your palette, your aesthetic rules. The result is on-brand imagery generated in minutes, usable by your internal team or executed by us.
        </p>
      </div>
    </div>

    <!-- Feature 2: AI briefing -->
    <div class="ai-wf__split ai-wf__split--reverse">
      <div class="ai-wf__body" data-ai-reveal>
        <p class="adaptif-eyebrow">AI briefing</p>
        <h3 class="ai-wf__split-title">
          A briefing expert <span class="title-highlight">at your fingertips</span>
        </h3>
        <p class="ai-wf__split-lead">
          Vague briefs cost time, money, and creative quality. Our AI-guided briefing process extracts exactly what your project needs — faster and with far less back-and-forth than traditional brief templates.
        </p>
        <p class="ai-wf__split-desc">
          Describe your project in plain language or upload an existing brief. We handle the structure, the specs, and the gaps.
        </p>
      </div>
      <div class="ai-wf__media ai-wf__media--frameless" data-ai-reveal="scale" style="--ai-delay: 100ms">
        <img src="/images/ai-excellence/ai-briefing.png" alt="AI-guided project briefing interface" loading="lazy" decoding="async" />
      </div>
    </div>

    <!-- Feature 3: AI consultancy -->
    <div class="ai-wf__split">
      <div class="ai-wf__mosaic" aria-hidden="true">
        <div class="ai-wf__tile" data-ai-reveal="scale" style="--ai-delay: 0ms">
          <img src="/images/ai-excellence/consult-1.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="ai-wf__tile" data-ai-reveal="scale" style="--ai-delay: 80ms">
          <img src="/images/ai-excellence/consult-2.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="ai-wf__tile" data-ai-reveal="scale" style="--ai-delay: 160ms">
          <img src="/images/ai-excellence/consult-3.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="ai-wf__tile ai-wf__tile--brand" data-ai-reveal="scale" style="--ai-delay: 240ms">
          <img src="/images/ai-excellence/consult-brand-mark.png" alt="" loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="ai-wf__body" data-ai-reveal style="--ai-delay: 120ms">
        <p class="adaptif-eyebrow">AI consultancy</p>
        <h3 class="ai-wf__split-title">
          Transform your <span class="title-highlight">creative operations</span>
        </h3>
        <p class="ai-wf__split-lead">
          Adaptif is the trusted partner for founders, marketing directors, and agencies ready to build AI into how they create — not just what they create.
        </p>
        <p class="ai-wf__split-desc">
          We provide end-to-end support: from identifying where AI creates the most leverage in your workflow, to implementing and scaling the systems that make it stick. Measurable output improvements, not a PDF with recommendations.
        </p>
        <div class="ai-wf__cta">
          <a href="#book-a-call" class="adaptif-btn" data-open-book-call>
            <span>Book a Call</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 6: Choose your AI approach -->
<section class="ai-approach" id="ai-approach" aria-labelledby="ai-approach-title">
  <div class="container">
    <header class="ai-approach__header" data-ai-reveal>
      <p class="adaptif-eyebrow">Choose your AI approach</p>
      <h2 id="ai-approach-title" class="ai-approach__title">
        Your AI, <span class="title-highlight">your rules</span>
      </h2>
      <p class="ai-approach__subtitle">
        Every Adaptif member chooses how AI is used in their projects. Your data stays protected. Your brand guidelines stay intact. You stay in control of what AI touches and what it doesn’t.
      </p>
    </header>

    <div class="ai-approach__grid">
      {approaches.map((plan, idx) => (
        <article
          class={`glass-panel ai-approach__card ${plan.featured ? "ai-approach__card--featured" : ""}`}
          data-ai-reveal="scale"
          style={`--ai-delay: ${idx * 90}ms`}
        >
          <h3 class="ai-approach__name">{plan.name}</h3>
          <p class="ai-approach__summary">{plan.summary}</p>
          <ul class="ai-approach__bullets">
            {plan.bullets.map((b) => (
              <li>
                <span class="ai-approach__dot" aria-hidden="true"></span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ai-wf {
    padding: clamp(64px, 8vw, 110px) 0;
    background-color: var(--color-void);
  }

  .ai-wf__intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-bottom: clamp(48px, 7vw, 84px);
  }

  .ai-wf__header {
    max-width: none;
    margin-bottom: 0;
  }

  .ai-wf__intro-media img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
  }

  .ai-wf__title {
    margin: 14px 0 18px;
    font-family: var(--font-family-display);
    font-size: clamp(2.2rem, 4.1vw, 3.35rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ai-wf__subtitle {
    margin: 0 0 12px;
    font-family: var(--font-family-body);
    font-size: 1.04rem;
    line-height: 1.65;
    color: var(--color-text-primary);
  }

  .ai-wf__subnote {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ai-wf__split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(36px, 6vw, 76px);
    align-items: center;
    padding: clamp(36px, 5vw, 56px) 0;
  }

  .ai-wf__media {
    border-radius: 22px;
    overflow: hidden;
  }

  .ai-wf__media--frameless {
    border-radius: 0;
    overflow: visible;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .ai-wf__media img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .ai-wf__media--frameless img {
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
  }

  .ai-wf__split-title {
    margin: 14px 0 16px;
    font-family: var(--font-family-display);
    font-size: clamp(1.95rem, 3.4vw, 2.8rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .ai-wf__split-lead {
    margin: 0 0 12px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-primary);
  }

  .ai-wf__split-desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ai-wf__cta {
    margin-top: 26px;
  }

  .ai-wf__mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-wf__tile {
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--color-obsidian-900);
  }

  .ai-wf__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-wf__tile--brand {
    border: none;
    background: transparent;
  }

  .ai-approach {
    padding: clamp(64px, 8vw, 110px) 0;
    background-color: var(--color-void);
  }

  .ai-approach__header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto clamp(42px, 5.5vw, 64px);
  }

  .ai-approach__title {
    margin: 14px 0 16px;
    font-family: var(--font-family-display);
    font-size: clamp(2.15rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ai-approach__subtitle {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ai-approach__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .ai-approach__card {
    padding: 32px 28px;
    border-radius: 22px;
    display: flex;
    flex-direction: column;
  }

  .ai-approach__card--featured {
    border-color: rgba(72, 200, 255, 0.45);
    background: linear-gradient(180deg, rgba(14, 28, 66, 0.78) 0%, rgba(8, 18, 44, 0.72) 100%);
    box-shadow: var(--shadow-bevel-floating);
  }

  .ai-approach__name {
    margin: 0 0 12px;
    font-family: var(--font-family-body);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .ai-approach__summary {
    margin: 0 0 24px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-family-body);
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .ai-approach__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-approach__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-family-body);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  .ai-approach__dot {
    width: 6px;
    height: 6px;
    margin-top: 7px;
    border-radius: 50%;
    background: var(--color-brand-cyan);
    box-shadow: 0 0 8px var(--color-cyan-glow);
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .ai-wf__intro-grid,
    .ai-wf__split {
      grid-template-columns: 1fr;
    }

    .ai-wf__split--reverse .ai-wf__media {
      order: -1;
    }

    .ai-approach__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
