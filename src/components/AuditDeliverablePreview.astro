</section>

<script define:vars={{ brandSamples }}>
  const initAuditPreview = () => {
    const root = document.getElementById("audit-sample");
    if (!root || root.dataset.auInit === "1") return;
    root.dataset.auInit = "1";

    const brandPills = root.querySelectorAll("[data-brand-pill]");
    const viewTabs = root.querySelectorAll("[data-view-tab]");
    const viewPanels = root.querySelectorAll("[data-view-panel]");

    const brandEl = root.querySelector("[data-preview-brand]");
    const metaEl = root.querySelector("[data-preview-meta]");
    const scorecardList = root.querySelector("[data-scorecard-list]");
    const leakTitle = root.querySelector("[data-finding-leak-title]");
    const leakDesc = root.querySelector("[data-finding-leak-desc]");
    const recTitle = root.querySelector("[data-finding-rec-title]");
    const recDesc = root.querySelector("[data-finding-rec-desc]");
    const oppGrid = root.querySelector("[data-opp-grid]");
    const roadmapGrid = root.querySelector("[data-roadmap-grid]");
    const dashUrl = root.querySelector("[data-dash-url]");
    const dashTitle = root.querySelector("[data-dash-title]");
    const dashKpis = root.querySelector("[data-dash-kpis]");
    const dashMini = root.querySelector("[data-dash-mini]");

    const renderBrand = (brandId) => {
      const sample = brandSamples.find((b) => b.id === brandId) || brandSamples[0];
      if (brandEl) brandEl.textContent = sample.brandName;
      if (metaEl) metaEl.textContent = sample.meta;

      if (scorecardList) {
        scorecardList.innerHTML = sample.scorecard
          .map(
            (row) => `
            <div class="au-scorecard__row">
              <div class="au-scorecard__area">${row.area}</div>
              <div class="au-scorecard__note">${row.note}</div>
              <div class="au-scorecard__badge-wrap">
                <span class="au-level-badge au-level-badge--${row.level.toLowerCase()}">${row.level}</span>
              </div>
            </div>`
          )
          .join("");
      }

      if (leakTitle) leakTitle.textContent = sample.finding.leakTitle;
      if (leakDesc) leakDesc.textContent = sample.finding.leakDesc;
      if (recTitle) recTitle.textContent = sample.finding.recTitle;
      if (recDesc) recDesc.textContent = sample.finding.recDesc;

      if (oppGrid) {
        oppGrid.innerHTML = sample.opportunities
          .map(
            (opp) => `
            <div class="au-opp-card">
              <div class="au-opp-card__top">
                <span class="au-opp-card__priority">${opp.priority}</span>
                <span class="au-opp-card__window">${opp.window}</span>
              </div>
              <h3 class="au-opp-card__title">${opp.title}</h3>
              <div class="au-opp-card__metrics">
                <div>
                  <span class="au-opp-card__metric-label">IMPACT</span>
                  <span class="au-opp-card__metric-val">${opp.impact}</span>
                </div>
                <div>
                  <span class="au-opp-card__metric-label">EFFORT</span>
                  <span class="au-opp-card__metric-val">${opp.effort}</span>
                </div>
              </div>
            </div>`
          )
          .join("");
      }

      if (roadmapGrid) {
        roadmapGrid.innerHTML = sample.roadmap
          .map(
            (col) => `
            <div class="au-roadmap-col">
              <div class="au-roadmap-col__num">${col.number}</div>
              <div class="au-roadmap-col__label">${col.label}</div>
              <ul class="au-roadmap-col__list">
                ${col.items
                  .map(
                    (item) =>
                      `<li><span class="au-check-dot" aria-hidden="true"></span><span>${item}</span></li>`
                  )
                  .join("")}
              </ul>
            </div>`
          )
          .join("");
      }

      if (dashUrl) dashUrl.textContent = sample.dashboardSlug;
      if (dashTitle) dashTitle.textContent = sample.dashboardFocus;

      if (dashKpis) {
        dashKpis.innerHTML = sample.dashboard.kpis
          .map(
            (kpi) => `
            <div class="au-dash-mock__kpi">
              <div class="au-dash-mock__kpi-val">${kpi.value}</div>
              <div class="au-dash-mock__kpi-label">${kpi.label}</div>
            </div>`
          )
          .join("");
      }

      if (dashMini) {
        dashMini.innerHTML = sample.dashboard.miniRows
          .map(
            (row) => `
            <div class="au-dash-mock__mini-row">
              <span>${row.area}</span>
              <span class="au-level-badge au-level-badge--${row.level.toLowerCase()}">${row.level}</span>
            </div>`
          )
          .join("");
      }
    };

    const triggerPanelEnter = (el) => {
      if (!el) return;
      el.classList.remove("au-panel-enter");
      void el.offsetWidth;
      el.classList.add("au-panel-enter");
    };

    brandPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const id = pill.getAttribute("data-brand-pill");
        brandPills.forEach((p) => {
          const active = p === pill;
          p.classList.toggle("is-active", active);
          p.setAttribute("aria-selected", active ? "true" : "false");
        });
        if (id) renderBrand(id);
        const activePanel = root.querySelector("[data-view-panel].is-active");
        triggerPanelEnter(activePanel);
      });
    });

    viewTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.getAttribute("data-view-tab");
        viewTabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle("is-active", active);
          t.setAttribute("aria-selected", active ? "true" : "false");
        });
        viewPanels.forEach((panel) => {
          const match = panel.getAttribute("data-view-panel") === target;
          panel.classList.toggle("is-active", match);
          if (match) {
            panel.removeAttribute("hidden");
            triggerPanelEnter(panel);
          } else {
            panel.setAttribute("hidden", "");
          }
        });
      });
    });
  };

  initAuditPreview();
  document.addEventListener("astro:page-load", initAuditPreview);
</script>

