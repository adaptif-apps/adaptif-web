const deliverableTabs = [
  { id: "scorecard", label: "Scorecard" },
  { id: "finding", label: "A finding" },
  { id: "opportunity", label: "Opportunity map" },
  { id: "roadmap", label: "30/60/90 roadmap" },
  { id: "dashboard", label: "The dashboard" },
];
---

<section class="au-preview" id="audit-sample" aria-labelledby="au-preview-title">
  <div class="container">
    <div class="au-preview__header" data-audit-reveal>
      <div class="au-preview__heading-col">
        <p class="adaptif-eyebrow">WHAT YOU ACTUALLY RECEIVE</p>
        <h2 id="au-preview-title" class="au-section-title">
          See the deliverable <span class="title-highlight">before you buy it.</span>
        </h2>
      </div>
      <p class="au-preview__note">
        Illustrative examples based on the patterns we see in e-commerce audits. Switch the brand type to see how the same format reads for a different business.
      </p>
    </div>

    <!-- Brand Type Selector Pills -->
    <div class="au-brand-pills" role="tablist" aria-label="Brand types" data-audit-reveal style="--au-delay: 80ms">
      {brandSamples.map((brand, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected={idx === 0 ? "true" : "false"}
          class:list={["au-brand-pill", { "is-active": idx === 0 }]}
          data-brand-pill={brand.id}
        >
          {brand.pill}
        </button>
      ))}
    </div>

    <!-- Interactive Deliverable Window -->
    <div class="glass-panel au-window" data-audit-reveal style="--au-delay: 140ms">
      <!-- Deliverable View Tabs -->
      <div class="au-window__tabs" role="tablist" aria-label="Deliverable views">
        {deliverableTabs.map((tab, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            class:list={["au-window__tab", { "is-active": idx === 0 }]}
            data-view-tab={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Brand Meta Header -->
      <div class="au-window__meta-bar">
        <span class="au-window__brand" data-preview-brand>{brandSamples[0].brandName}</span>
        <span class="au-window__meta" data-preview-meta>{brandSamples[0].meta}</span>
      </div>

      <!-- Panel 1: Scorecard -->
      <div class="au-view-panel is-active" data-view-panel="scorecard">
        <div class="au-scorecard" data-scorecard-list>
          {brandSamples[0].scorecard.map((row) => (
            <div class="au-scorecard__row">
              <div class="au-scorecard__area">{row.area}</div>
              <div class="au-scorecard__note">{row.note}</div>
              <div class="au-scorecard__badge-wrap">
                <span class={`au-level-badge au-level-badge--${row.level.toLowerCase()}`}>
                  {row.level}
                </span>
              </div>
            </div>
          ))}
        </div>
        <p class="au-window__caption">Five levels: critical, weak, acceptable, solid, advanced.</p>
      </div>

      <!-- Panel 2: A finding -->
      <div class="au-view-panel" data-view-panel="finding" hidden>
        <div class="au-finding-grid">
          <div class="au-finding-col">
            <span class="au-finding__label au-finding__label--leak">THE LEAK</span>
            <h3 class="au-finding__title" data-finding-leak-title>{brandSamples[0].finding.leakTitle}</h3>
            <p class="au-finding__body" data-finding-leak-desc>{brandSamples[0].finding.leakDesc}</p>
          </div>
          <div class="au-finding-col">
            <span class="au-finding__label au-finding__label--rec">THE RECOMMENDATION</span>
            <h3 class="au-finding__title" data-finding-rec-title>{brandSamples[0].finding.recTitle}</h3>
            <p class="au-finding__body" data-finding-rec-desc>{brandSamples[0].finding.recDesc}</p>
          </div>
        </div>
        <p class="au-window__caption">
          Every finding in the dashboard is written this way: what leaks, why, and what to do about it.
        </p>
      </div>

      <!-- Panel 3: Opportunity map -->
      <div class="au-view-panel" data-view-panel="opportunity" hidden>
        <div class="au-opp-grid" data-opp-grid>
          {brandSamples[0].opportunities.map((opp) => (
            <div class="au-opp-card">
              <div class="au-opp-card__top">
                <span class="au-opp-card__priority">{opp.priority}</span>
                <span class="au-opp-card__window">{opp.window}</span>
              </div>
              <h3 class="au-opp-card__title">{opp.title}</h3>
              <div class="au-opp-card__metrics">
                <div>
                  <span class="au-opp-card__metric-label">IMPACT</span>
                  <span class="au-opp-card__metric-val">{opp.impact}</span>
                </div>
                <div>
                  <span class="au-opp-card__metric-label">EFFORT</span>
                  <span class="au-opp-card__metric-val">{opp.effort}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Panel 4: 30/60/90 roadmap -->
      <div class="au-view-panel" data-view-panel="roadmap" hidden>
        <div class="au-roadmap-grid" data-roadmap-grid>
          {brandSamples[0].roadmap.map((col) => (
            <div class="au-roadmap-col">
              <div class="au-roadmap-col__num">{col.number}</div>
              <div class="au-roadmap-col__label">{col.label}</div>
              <ul class="au-roadmap-col__list">
                {col.items.map((item) => (
                  <li>
                    <span class="au-check-dot" aria-hidden="true"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Panel 5: The dashboard -->
      <div class="au-view-panel" data-view-panel="dashboard" hidden>
        <div class="au-dash-mock">
          <div class="au-dash-mock__chrome">
            <div class="au-dash-mock__dots" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="au-dash-mock__url" data-dash-url>{brandSamples[0].dashboardSlug}</div>
          </div>

          <div class="au-dash-mock__body">
            <p class="adaptif-eyebrow">PRIVATE AUDIT DASHBOARD</p>
            <h3 class="au-dash-mock__title" data-dash-title>{brandSamples[0].dashboardFocus}</h3>

            <div class="au-dash-mock__kpis" data-dash-kpis>
              {brandSamples[0].dashboard.kpis.map((kpi) => (
                <div class="au-dash-mock__kpi">
                  <div class="au-dash-mock__kpi-val">{kpi.value}</div>
                  <div class="au-dash-mock__kpi-label">{kpi.label}</div>
                </div>
              ))}
            </div>

            <div class="au-dash-mock__mini-list" data-dash-mini>
              {brandSamples[0].dashboard.miniRows.map((row) => (
                <div class="au-dash-mock__mini-row">
                  <span>{row.area}</span>
                  <span class={`au-level-badge au-level-badge--${row.level.toLowerCase()}`}>
                    {row.level}
                  </span>
                </div>
              ))}
            </div>

            <div class="au-dash-mock__cta-wrap">
              <a href="#audit-pricing" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm">
