---
// AuditDeliverablePreview.astro - Interactive "See the deliverable before you buy it" preview
// Supports 5 brand types and 5 deliverable tabs matching the exact PDF reference.

interface ScorecardRow {
  area: string;
  note: string;
  level: "Critical" | "Weak" | "Acceptable" | "Solid" | "Advanced";
}

interface OpportunityItem {
  priority: string;
  window: string;
  title: string;
  impact: "High" | "Medium";
  effort: "Low" | "Medium" | "High";
}

interface RoadmapColumn {
  number: string;
  label: string;
  items: string[];
}

interface BrandSample {
  id: string;
  pill: string;
  brandName: string;
  meta: string;
  dashboardSlug: string;
  dashboardFocus: string;
  scorecard: ScorecardRow[];
  finding: {
    leakTitle: string;
    leakDesc: string;
    recTitle: string;
    recDesc: string;
  };
  opportunities: OpportunityItem[];
  roadmap: RoadmapColumn[];
  dashboard: {
    kpis: { value: string; label: string }[];
    miniRows: { area: string; level: ScorecardRow["level"] }[];
  };
}

