---
// AuditDeliverablesAndProcess.astro - "Deliverables" (01-08) + "How it works" (6 steps)

const deliverables = [
  {
    num: "01",
    title: "Executive Snapshot",
    desc: "The central findings and the primary opportunity.",
  },
  {
    num: "02",
    title: "Visual Scorecard",
    desc: "Maturity level per area: critical, weak, acceptable, solid or advanced.",
  },
  {
    num: "03",
    title: "Revenue / Conversion Leaks",
    desc: "Where intent, clarity or revenue is being lost.",
  },
  {
    num: "04",
    title: "Opportunity Map",
    desc: "Recommendations ordered by impact, effort and priority.",
  },
  {
    num: "05",
    title: "Quick Wins",
    desc: "The actions you can execute first.",
  },
  {
    num: "06",
    title: "30/60/90 Day Roadmap",
    desc: "A clear implementation sequence.",
  },
  {
    num: "07",
    title: "Private Audit Dashboard",
    desc: "A private visual micro-site holding the whole diagnosis.",
  },
  {
    num: "08",
    title: "Loom Walkthrough",
    desc: "A 15–20 minute video explaining the diagnosis and the plan.",
  },
];

const steps = [
  {
    num: "1",
    text: "You choose the focus that represents your main bottleneck, and pay.",
  },
  {
    num: "2",
    text: "You receive the intake form and complete it in 10 to 15 minutes.",
  },
  {
    num: "3",
    text: "You share read only access and any assets we need.",
  },
  {
    num: "4",
    text: "Adaptif audits the system over 4–5 business days.",
  },
  {
    num: "5",
    text: "You get your private dashboard, the roadmap and the Loom.",
  },
  {
    num: "6",
    text: "If you want to move: implement in house, run a project with Adaptif, or go monthly.",
  },
];
---

<!-- Deliverables -->
<section class="au-deliverables" id="audit-deliverables" aria-labelledby="au-deliverables-title">
  <div class="container">
    <div class="au-deliverables__header" data-audit-reveal>
      <div>
        <p class="adaptif-eyebrow">DELIVERABLES</p>
        <h2 id="au-deliverables-title" class="au-section-title">
          The same deliverables{" "}
          <span class="title-highlight">across all three focuses.</span>
        </h2>
      </div>
      <p class="au-deliverables__sub">
        A repeatable format, so you know exactly what arrives.
      </p>
    </div>

    <div class="au-deliverables__grid" data-audit-stagger>
      {deliverables.map((item) => (
        <div class="au-deliverable-item">
          <span class="au-deliverable-item__num">{item.num}</span>
          <h3 class="au-deliverable-item__title">{item.title}</h3>
          <p class="au-deliverable-item__desc">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- How it works -->
<section class="au-process" id="audit-process" aria-labelledby="au-process-title">
  <div class="container">
    <div class="au-process__split">
      <div class="au-process__left" data-audit-reveal>
        <p class="adaptif-eyebrow">HOW IT WORKS</p>
        <h2 id="au-process-title" class="au-section-title">
          Six steps, no{" "}
          <span class="title-highlight">mandatory meetings.</span>
        </h2>
      </div>

      <ol class="au-process__list" data-audit-stagger>
        {steps.map((step) => (
          <li class="au-process__step">
            <span class="au-process__num">{step.num}</span>
            <span class="au-process__text">{step.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .au-deliverables {
    padding: clamp(56px, 8vh, 96px) 0;
    background-color: var(--color-void);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .au-deliverables__header {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    gap: 28px;
    align-items: end;
    margin-bottom: 40px;
  }

  .au-section-title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.15rem, 4.2vw, 3.35rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .au-deliverables__sub {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* Open editorial 4x2 grid with hairline borders */
  .au-deliverables__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .au-deliverable-item {
    padding: 26px 22px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: background-color 0.22s ease;
  }

  .au-deliverable-item:hover {
    background: rgba(72, 200, 255, 0.03);
  }

  .au-deliverable-item__num {
    font-family: var(--font-family-body);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-brand-cyan);
  }

  .au-deliverable-item__title {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .au-deliverable-item__desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* How it works */
  .au-process {
    padding: clamp(56px, 8vh, 96px) 0;
    background-color: var(--color-void);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .au-process__split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.25fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .au-process__left {
    position: sticky;
    top: 112px;
  }

  .au-process__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .au-process__step {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .au-process__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(72, 200, 255, 0.12);
    border: 1px solid rgba(72, 200, 255, 0.32);
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-brand-cyan);
  }

  .au-process__text {
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-text-primary);
  }

  @media (max-width: 960px) {
    .au-deliverables__header {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .au-deliverables__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .au-process__split {
      grid-template-columns: 1fr;
    }

    .au-process__left {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .au-deliverables__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
