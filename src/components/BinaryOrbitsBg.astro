---
// Faithful 3D WebGL 70,000-particle spiral galaxy implementation of Binary Orbits.
// Matches the exact configuration:
//   colors: ["#48c8ff", "#8c6d00"], backgroundColor: "#0A0A0A",
//   stars: 70000, starSize: 1.7, sparkle: 0.5, arms: 3, twist: 3.5,
//   armStrength: 0.5, dust: 0.5, core: 1.3, coreSize: 0.07, innerVoid: 0,
//   thickness: 0.05, tilt: 62, roll: -8, scale: 1.76,
//   centerX: 0.5, centerY: 0.52, speed: 0.15000000000000036,
//   twinkle: 0.35, depth: 0.4, glow: 0.45, intensity: 1

interface Props {
  colors?: [string, string];
  backgroundColor?: string;
  stars?: number;
  starSize?: number;
  sparkle?: number;
  arms?: number;
  twist?: number;
  armStrength?: number;
  dust?: number;
  core?: number;
  coreSize?: number;
  innerVoid?: number;
  thickness?: number;
  tilt?: number;
  roll?: number;
  scale?: number;
  centerX?: number;
  centerY?: number;
  speed?: number;
  twinkle?: number;
  depth?: number;
  glow?: number;
  intensity?: number;
  class?: string;
}

const {
  colors = ["#48c8ff", "#8c6d00"],
  backgroundColor = "#0A0A0A",
  stars = 70000,
  starSize = 1.7,
  sparkle = 0.5,
  arms = 3,
  twist = 3.5,
  armStrength = 0.5,
  dust = 0.5,
  core = 1.3,
  coreSize = 0.07,
  innerVoid = 0,
  thickness = 0.05,
  tilt = 62,
  roll = -8,
  scale = 1.76,
  centerX = 0.5,
  centerY = 0.52,
  speed = 0.15000000000000036,
  twinkle = 0.35,
  depth = 0.4,
  glow = 0.45,
  intensity = 1,
  class: className = "",
} = Astro.props;
---

<div
  class={`binary-orbits-wrap ${className}`}
  style={`background-color: ${backgroundColor};`}
  data-color-a={colors[0]}
  data-color-b={colors[1]}
  data-bg={backgroundColor}
  data-stars={stars}
  data-star-size={starSize}
  data-sparkle={sparkle}
  data-arms={arms}
  data-twist={twist}
  data-arm-strength={armStrength}
  data-dust={dust}
  data-core={core}
  data-core-size={coreSize}
  data-inner-void={innerVoid}
  data-thickness={thickness}
  data-tilt={tilt}
  data-roll={roll}
  data-scale={scale}
  data-center-x={centerX}
  data-center-y={centerY}
  data-speed={speed}
  data-twinkle={twinkle}
  data-depth={depth}
  data-glow={glow}
  data-intensity={intensity}
  aria-hidden="true"
>
  <div class="binary-orbits-canvas-host"></div>
</div>

<style>
  .binary-orbits-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .binary-orbits-canvas-host {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import * as THREE from "three";

  const VERTEX_SHADER = `
    attribute float aSize;
    attribute float aPhase;
    attribute float aRadius;
    attribute float aIsCore;
    attribute vec3 aColor;

    uniform float uTime;
    uniform float uSpeed;
    uniform float uScale;
    uniform float uTiltRad;
    uniform float uRollRad;
    uniform float uStarSize;
    uniform float uPixelRatio;
    uniform float uAspect;
    uniform float uDepth;
    uniform float uTwinkle;
    uniform vec2 uCenter;

    varying vec3 vColor;
    varying float vAlpha;
    varying float vSparkle;

    mat2 rot2(float a) {
      float s = sin(a);
      float c = cos(a);
      return mat2(c, -s, s, c);
    }

    void main() {
      vec3 pos = position;

      // Differential orbital rotation in galaxy disc plane (XZ)
      float angularVel = uSpeed * (1.0 + 0.45 / (aRadius + 0.18));
      float angle = uTime * angularVel;
      pos.xz = rot2(angle) * pos.xz;

      // Apply galaxy tilt (around X axis) and roll (around Z axis)
      pos.yz = rot2(uTiltRad) * pos.yz;
      pos.xy = rot2(uRollRad) * pos.xy;

      // Scale galaxy
      pos *= uScale;

      // Perspective depth attenuation
      float zOffset = 2.6 - pos.z * (0.75 + uDepth * 0.65);
      float persp = 2.2 / max(zOffset, 0.4);

      // Map to NDC centered at (uCenter.x, uCenter.y)
      vec2 centerNdc = vec2(uCenter.x * 2.0 - 1.0, (1.0 - uCenter.y) * 2.0 - 1.0);
      vec2 ndc = pos.xy * persp;
      ndc.x /= max(uAspect, 0.5);
      ndc += centerNdc;

      gl_Position = vec4(ndc, clamp(pos.z * 0.2, -0.9, 0.9), 1.0);

      // Twinkle & depth fade
      float tw = 1.0 - uTwinkle * 0.5 * (0.5 + 0.5 * sin(uTime * 2.4 + aPhase * 6.28318));
      float depthFade = mix(1.0, clamp(persp * 0.95, 0.25, 1.35), uDepth);

      vColor = aColor;
      vAlpha = tw * depthFade * (0.45 + 0.55 * aIsCore);
      vSparkle = aPhase;

      gl_PointSize = clamp(aSize * uStarSize * persp * uPixelRatio, 0.8, 16.0);
    }
  `;

  const FRAGMENT_SHADER = `
    precision highp float;

    uniform float uGlow;
    uniform float uSparkle;
    uniform float uIntensity;

    varying vec3 vColor;
    varying float vAlpha;
    varying float vSparkle;

    void main() {
      vec2 uv = gl_PointCoord - 0.5;
      float d = length(uv) * 2.0;
      if (d > 1.0) discard;

      // Sharp star core + soft additive halo controlled by uGlow
      float coreDot = exp(-d * d * 10.0);
      float softGlow = pow(max(1.0 - d, 0.0), 2.4) * (0.35 + uGlow * 0.95);

      // Subtle 4-point diffraction sparkle on brighter stars
      float crossMask = (exp(-abs(uv.x) * 22.0) * exp(-abs(uv.y) * 5.0) +
                         exp(-abs(uv.y) * 22.0) * exp(-abs(uv.x) * 5.0));
      float sparkleFactor = step(0.72, vSparkle) * uSparkle * crossMask * 0.45;

      float alpha = (coreDot * 0.85 + softGlow * 0.45 + sparkleFactor) * vAlpha * uIntensity;
      vec3 finalCol = mix(vColor, vec3(1.0), coreDot * 0.45);

      gl_FragColor = vec4(finalCol * alpha, alpha);
    }
  `;

  // Deterministic fast PRNG for consistent particle distribution
  const mulberry32 = (seed: number) => {
    let a = seed >>> 0;
    return () => {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  };

  const initBinaryOrbits = () => {
    const wraps = document.querySelectorAll<HTMLElement>(".binary-orbits-wrap");
    wraps.forEach((wrap) => {
      if (wrap.dataset.initialized === "true") return;
      wrap.dataset.initialized = "true";

      const host = wrap.querySelector<HTMLElement>(".binary-orbits-canvas-host");
      if (!host) return;

      const colorA = new THREE.Color(wrap.dataset.colorA || "#48c8ff");
      const colorB = new THREE.Color(wrap.dataset.colorB || "#8c6d00");
      const bgHex = wrap.dataset.bg || "#0A0A0A";
      const starCount = parseInt(wrap.dataset.stars || "70000", 10);
      const starSize = parseFloat(wrap.dataset.starSize || "1.7");
      const sparkle = parseFloat(wrap.dataset.sparkle || "0.5");
      const arms = parseInt(wrap.dataset.arms || "3", 10);
      const twist = parseFloat(wrap.dataset.twist || "3.5");
      const armStrength = parseFloat(wrap.dataset.armStrength || "0.5");
      const dust = parseFloat(wrap.dataset.dust || "0.5");
      const core = parseFloat(wrap.dataset.core || "1.3");
      const coreSize = parseFloat(wrap.dataset.coreSize || "0.07");
      const innerVoid = parseFloat(wrap.dataset.innerVoid || "0");
      const thickness = parseFloat(wrap.dataset.thickness || "0.05");
      const tiltDeg = parseFloat(wrap.dataset.tilt || "62");
      const rollDeg = parseFloat(wrap.dataset.roll || "-8");
      const scale = parseFloat(wrap.dataset.scale || "1.76");
      const centerX = parseFloat(wrap.dataset.centerX || "0.5");
      const centerY = parseFloat(wrap.dataset.centerY || "0.52");
      const speed = parseFloat(wrap.dataset.speed || "0.15000000000000036");
      const twinkle = parseFloat(wrap.dataset.twinkle || "0.35");
      const depth = parseFloat(wrap.dataset.depth || "0.4");
      const glow = parseFloat(wrap.dataset.glow || "0.45");
      const intensity = parseFloat(wrap.dataset.intensity || "1");

      const canvas = document.createElement("canvas");
      canvas.style.cssText =
        "position:absolute;inset:0;width:100%;height:100%;display:block;pointer-events:none;";

      let renderer: THREE.WebGLRenderer;
      try {
        renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: false,
          antialias: false,
          powerPreference: "high-performance",
        });
      } catch (err) {
        console.warn("WebGL not available for BinaryOrbitsBg", err);
        return;
      }

      host.appendChild(canvas);
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      renderer.setPixelRatio(dpr);
      renderer.setClearColor(new THREE.Color(bgHex), 1);

      // Build 70,000-particle 3-arm spiral galaxy geometry
      const positions = new Float32Array(starCount * 3);
      const colors = new Float32Array(starCount * 3);
      const sizes = new Float32Array(starCount);
      const phases = new Float32Array(starCount);
      const radii = new Float32Array(starCount);
      const isCoreArr = new Float32Array(starCount);

      const rand = mulberry32(42069);
      const tmpColor = new THREE.Color();

      for (let i = 0; i < starCount; i++) {
        // Radial distribution: concentrated near coreSize, extending to 1.0
        const u = rand();
        const isCoreStar = u < 0.18 * core;
        let r: number;
        if (isCoreStar) {
          r = innerVoid + Math.pow(rand(), 1.6) * coreSize * 2.8;
        } else {
          r = innerVoid + Math.pow(rand(), 1.45) * (1.0 - innerVoid);
        }

        // Spiral arm angle with twist & scatter controlled by armStrength
        const armIdx = i % Math.max(arms, 1);
        const armBaseAngle = (armIdx / Math.max(arms, 1)) * Math.PI * 2;
        const spiralAngle = r * twist;

        // Gaussian-like scatter around the arm
        const g1 = (rand() + rand() + rand() - 1.5) * 0.9;
        const scatter = g1 * (1.0 - armStrength * 0.72) * (0.45 + r * 0.85);
        const theta = armBaseAngle + spiralAngle + scatter;

        const x = Math.cos(theta) * r;
        const z = Math.sin(theta) * r;

        // Disc thickness (thin plane with slight bulge at core)
        const gY = (rand() + rand() + rand() - 1.5) * 0.75;
        const y = gY * thickness * (1.2 - r * 0.65);

        const i3 = i * 3;
        positions[i3] = x;
        positions[i3 + 1] = y;
        positions[i3 + 2] = z;

        // Color blend: core leans bright cyan/warm gold, outer arms & dust blend #48c8ff & #8c6d00
        const dustMix = Math.min(1, Math.max(0, (r * 0.65 + rand() * 0.55) * dust + (isCoreStar ? 0.18 : 0)));
        tmpColor.copy(colorA).lerp(colorB, dustMix);

        // Core brightness boost
        const coreBoost = r < coreSize * 2.5 ? (1.0 - r / (coreSize * 2.5)) * 0.45 * core : 0;
        colors[i3] = Math.min(1, tmpColor.r + coreBoost * 0.5);
        colors[i3 + 1] = Math.min(1, tmpColor.g + coreBoost * 0.55);
        colors[i3 + 2] = Math.min(1, tmpColor.b + coreBoost * 0.65);

        // Star size variation
        const sizeRand = rand();
        sizes[i] = sizeRand > 0.96 ? 1.8 + rand() * 1.4 : 0.45 + Math.pow(sizeRand, 2.0) * 1.15;
        phases[i] = rand();
        radii[i] = r;
        isCoreArr[i] = isCoreStar ? 1.0 : 0.65;
      }

      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute("position", new THREE.BufferAttribute(positions, 3));
      geometry.setAttribute("aColor", new THREE.BufferAttribute(colors, 3));
      geometry.setAttribute("aSize", new THREE.BufferAttribute(sizes, 1));
      geometry.setAttribute("aPhase", new THREE.BufferAttribute(phases, 1));
      geometry.setAttribute("aRadius", new THREE.BufferAttribute(radii, 1));
      geometry.setAttribute("aIsCore", new THREE.BufferAttribute(isCoreArr, 1));

      const uniforms = {
        uTime: { value: 0 },
        uSpeed: { value: speed },
        uScale: { value: scale },
        uTiltRad: { value: (tiltDeg * Math.PI) / 180 },
        uRollRad: { value: (rollDeg * Math.PI) / 180 },
        uStarSize: { value: starSize },
        uPixelRatio: { value: dpr },
        uAspect: { value: 1 },
        uDepth: { value: depth },
        uTwinkle: { value: twinkle },
        uGlow: { value: glow },
        uSparkle: { value: sparkle },
        uIntensity: { value: intensity },
        uCenter: { value: new THREE.Vector2(centerX, centerY) },
      };

      const material = new THREE.ShaderMaterial({
        vertexShader: VERTEX_SHADER,
        fragmentShader: FRAGMENT_SHADER,
        uniforms,
        transparent: true,
        depthWrite: false,
        depthTest: false,
        blending: THREE.AdditiveBlending,
      });

      const points = new THREE.Points(geometry, material);
      points.frustumCulled = false;

      const scene = new THREE.Scene();
      scene.add(points);
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

      const resize = () => {
        const w = Math.max(host.clientWidth, 1);
        const h = Math.max(host.clientHeight, 1);
        renderer.setSize(w, h, false);
        uniforms.uAspect.value = w / h;
      };

      resize();
      const ro = new ResizeObserver(resize);
      ro.observe(host);

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let isVisible = true;
      let rafId = 0;
      let lastTime = performance.now();

      const renderFrame = (now: number) => {
        if (!isVisible) {
          rafId = 0;
          return;
        }
        const dt = Math.min((now - lastTime) * 0.001, 0.05);
        lastTime = now;
        if (!reducedMotion) {
          uniforms.uTime.value += dt;
        }
        renderer.render(scene, camera);
        rafId = requestAnimationFrame(renderFrame);
      };

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isVisible = entry.isIntersecting;
            if (isVisible && !rafId) {
              lastTime = performance.now();
              rafId = requestAnimationFrame(renderFrame);
            }
          });
        },
        { threshold: 0.01 }
      );
      io.observe(wrap);

      rafId = requestAnimationFrame(renderFrame);
    });
  };

  initBinaryOrbits();
  document.addEventListener("astro:page-load", initBinaryOrbits);
</script>
