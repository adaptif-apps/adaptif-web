---
// BrandLogos.astro - Infinite Marquee of World-Class Bold Brands
import fs from "node:fs";
import path from "node:path";

const logosDir = path.resolve("./assets/logos-clients");
const filenames = [
  "Brand Logo Container.svg",
  "Brand Logo Container-1.svg",
  "Brand Logo Container-2.svg",
  "Brand Logo Container-3.svg",
  "Brand Logo Container-4.svg",
  "Brand Logo Container-5.svg",
  "Brand Logo Container-6.svg",
  "Brand Logo Container-7.svg",
];

const baseLogos = filenames.map((filename, i) => {
  let content = fs.readFileSync(path.join(logosDir, filename), "utf-8");
  // Adapt fill to currentColor so it responds to CSS hover states and dark Obsidian palette
  content = content.replace(/fill="#17263A"/g, 'fill="currentColor"');
  // Fluid SVG scaling
  content = content.replace(/width="126"\s+height="72"/, 'width="100%" height="100%"');
  return { id: i, content };
});

// Double the set to guarantee continuous seamless looping across ultra-wide monitors
const fullSet = [...baseLogos, ...baseLogos];

const sequence1 = fullSet.map((logo, idx) => ({
  id: `s1-${idx}`,
  svg: logo.content.replaceAll("mask0_74275_31564", `mask_s1_${idx}`),
}));

const sequence2 = fullSet.map((logo, idx) => ({
  id: `s2-${idx}`,
  svg: logo.content.replaceAll("mask0_74275_31564", `mask_s2_${idx}`),
}));
---

<section class="brand-logos-section" aria-label="Brands that trust Adaptif">
  <div class="brand-logos-container">
    <p class="brand-logos-heading">
      Chosen by 500+ of the world’s boldest brands
    </p>

    <!-- Infinite Scrolling Marquee Track -->
    <div class="marquee-viewport" aria-hidden="true">
      <div class="marquee-track">
        <!-- Sequence 1 -->
        <div class="marquee-group">
          {sequence1.map((brand) => (
            <div class="brand-item">
              <Fragment set:html={brand.svg} />
            </div>
          ))}
        </div>

        <!-- Sequence 2 (Cloned for seamless infinite loop) -->
        <div class="marquee-group">
          {sequence2.map((brand) => (
            <div class="brand-item">
              <Fragment set:html={brand.svg} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .brand-logos-section {
    position: relative;
    width: 100%;
    background-color: var(--color-void, #010307);
    padding-top: clamp(20px, 4vh, 36px);
    padding-bottom: clamp(36px, 6vh, 60px);
    overflow: hidden;
  }

  .brand-logos-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .brand-logos-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
    transition: color 0.3s ease;
  }

  .brand-logos-heading:hover {
    color: #cbd5e1;
  }

  /* Marquee Viewport with Edge Fade Masks */
  .marquee-viewport {
    position: relative;
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marqueeScroll 45s linear infinite;
    will-change: transform;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: clamp(36px, 5.5vw, 64px);
    padding-right: clamp(36px, 5.5vw, 64px);
    flex-shrink: 0;
  }

  .brand-item {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    opacity: 0.65;
    cursor: default;
    transition: 
      opacity 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease-spring),
      filter 0.25s ease;
  }

  .brand-item:hover {
    opacity: 1;
    color: #ffffff;
    transform: translateY(-1px);
    filter: drop-shadow(0 0 14px rgba(72, 200, 255, 0.45));
  }

  .brand-item :global(svg) {
    height: clamp(34px, 4.5vh, 46px);
    width: auto;
    max-width: 120px;
    display: block;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .marquee-track {
      animation-duration: 30s;
    }
    .brand-logos-heading {
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      padding-inline: 12px;
    }
    .brand-item :global(svg) {
      height: clamp(28px, 4vh, 36px);
      max-width: 95px;
    }
  }
</style>
