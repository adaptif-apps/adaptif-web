---

<section class="brand-logos-section" aria-label="Brands that trust Adaptif">
  <div class="brand-logos-container">
    <p class="brand-logos-heading">
      Chosen by 500+ of the world’s boldest brands
    </p>

    <!-- Infinite Scrolling Marquee Track -->
    <div class="marquee-viewport" aria-hidden="true">
      <div class="marquee-track">
        <!-- Sequence 1 -->
        <div class="marquee-group">
          {brands.map((brand) => (
            <div class="brand-item" title={brand.name}>
              <Fragment set:html={brand.svg} />
              <span class="brand-name">{brand.name}</span>
            </div>
          ))}
        </div>

        <!-- Sequence 2 (Cloned for seamless infinite loop) -->
        <div class="marquee-group">
          {brands.map((brand) => (
            <div class="brand-item" title={brand.name}>
              <Fragment set:html={brand.svg} />
              <span class="brand-name">{brand.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .brand-logos-section {
    position: relative;
    width: 100%;
    padding-top: clamp(20px, 4vh, 36px);
    padding-bottom: clamp(36px, 6vh, 60px);
    overflow: hidden;
  }

  .brand-logos-container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .brand-logos-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
    transition: color 0.3s ease;
  }

  .brand-logos-heading:hover {
    color: #cbd5e1;
  }

  /* Marquee Viewport with Edge Fade Masks */
  .marquee-viewport {
    position: relative;
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marqueeScroll 36s linear infinite;
    will-change: transform;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: clamp(32px, 5vw, 56px);
    padding-right: clamp(32px, 5vw, 56px);
    flex-shrink: 0;
  }

  .brand-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #64748b;
    opacity: 0.65;
    cursor: default;
    transition: 
      opacity 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease-spring),
      filter 0.25s ease;
  }

  .brand-item:hover {
    opacity: 1;
    color: #ffffff;
    transform: translateY(-1px);
    filter: drop-shadow(0 0 10px rgba(72, 200, 255, 0.45));
  }

  .brand-name {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .marquee-track {
      animation-duration: 24s;
    }
    .brand-logos-heading {
      font-size: 0.78rem;
      letter-spacing: 0.06em;
      padding-inline: 12px;
    }
  }
</style>
