---
// ComparisonTable.astro - Dark Mode Section: "Get a creative core engine instead"
// Comparison matrix comparing Adaptif against In-house team, Freelancers, Agencies, and DIY Tools

interface ComparisonRow {
  id: string;
  isFeatured?: boolean;
  title: string;
  desc?: string;
  platform: boolean;
  speed: boolean;
  quality: boolean;
  support: boolean;
  cost: boolean;
}

const comparisonRows: ComparisonRow[] = [
  {
    id: "row-adaptif",
    isFeatured: true,
    title: "Adaptif",
    platform: true,
    speed: true,
    quality: true,
    support: true,
    cost: true
  },
  {
    id: "row-in-house",
    title: "In-house team",
    desc: "Hiring takes time, replacements are slow, and ongoing salaries make in-house design costly, especially when needs fluctuate.",
    platform: false,
    speed: false,
    quality: true,
    support: true,
    cost: true
  },
  {
    id: "row-freelancers",
    title: "Freelancers",
    desc: "Hit or miss. Sourcing and managing talent for every project keeps you chasing consistency, not building your brand.",
    platform: false,
    speed: false,
    quality: true,
    support: true,
    cost: false
  },
  {
    id: "row-agencies",
    title: "Agencies",
    desc: "Strategic partners, but high-cost retainers, rigid scopes, and slow timelines make them a poor fit for everyday creative needs.",
    platform: false,
    speed: false,
    quality: true,
    support: true,
    cost: false
  },
  {
    id: "row-diy-tools",
    title: "DIY Tools",
    desc: "Quick to use, but the output is off-brand, inconsistent, and still needs heavy manual effort to finish.",
    platform: true,
    speed: true,
    quality: false,
    support: false,
    cost: false
  }
];

const columnHeaders = ["Platform", "Speed", "Quality", "Support", "Cost"];
---

<section class="comparison-section" id="comparison">
  <!-- Atmospheric Cyan Ambient Lighting -->
  <div class="comparison-glow-ambient" aria-hidden="true"></div>

  <div class="container comparison-container">
    <!-- Header Block -->
    <header class="comparison-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">BEYOND HIRING AND AGENCIES</span>
      </div>

      <h2 class="comparison-title">
        Get a creative core <span class="title-highlight title-engine">engine</span> instead.
      </h2>
    </header>

    <!-- Table Container (Responsive with horizontal overflow guard) -->
    <div class="comparison-table-wrap">
      <div class="comparison-table">
        <!-- Table Column Headers -->
        <div class="table-head-row" role="row">
          <div class="col-head col-working-style" role="columnheader">Working Style</div>
          {columnHeaders.map((header) => (
            <div class="col-head col-metric" role="columnheader">{header}</div>
          ))}
        </div>

        <!-- Table Body Rows -->
        <div class="table-body">
          {comparisonRows.map((row) => (
            <article 
              class={`comparison-row ${row.isFeatured ? "row-featured" : "row-standard"}`}
              role="row"
            >
              {row.isFeatured && (
                <div class="featured-glow-halo" aria-hidden="true"></div>
              )}

              <!-- Working Style Column -->
              <div class="col-cell cell-identity" role="cell">
                {row.isFeatured ? (
                  <div class="featured-logo-wrap">
                    <img 
                      src="/logo-dark.svg" 
                      alt="Adaptif" 
                      class="featured-brand-logo" 
                      width="132" 
                      height="64" 
                      loading="eager" 
                    />
                  </div>
                ) : (
                  <div class="row-info-wrap">
                    <h3 class="row-title">{row.title}</h3>
                    {row.desc && <p class="row-desc">{row.desc}</p>}
                  </div>
                )}
              </div>

              <!-- Metric Columns: Platform, Speed, Quality, Support, Cost -->
              <div class="col-cell cell-metric" role="cell" data-label="Platform">
                {row.platform ? (
                  <span class={`check-icon ${row.isFeatured ? "icon-featured" : "icon-check"}`} aria-label="Yes">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 13L9.5 17.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                ) : (
                  <span class="cross-icon" aria-label="No">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                )}
              </div>

              <div class="col-cell cell-metric" role="cell" data-label="Speed">
                {row.speed ? (
                  <span class={`check-icon ${row.isFeatured ? "icon-featured" : "icon-check"}`} aria-label="Yes">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 13L9.5 17.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                ) : (
                  <span class="cross-icon" aria-label="No">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                )}
              </div>

              <div class="col-cell cell-metric" role="cell" data-label="Quality">
                {row.quality ? (
                  <span class={`check-icon ${row.isFeatured ? "icon-featured" : "icon-check"}`} aria-label="Yes">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 13L9.5 17.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                ) : (
                  <span class="cross-icon" aria-label="No">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                )}
              </div>

              <div class="col-cell cell-metric" role="cell" data-label="Support">
                {row.support ? (
                  <span class={`check-icon ${row.isFeatured ? "icon-featured" : "icon-check"}`} aria-label="Yes">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 13L9.5 17.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                ) : (
                  <span class="cross-icon" aria-label="No">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                )}
              </div>

              <div class="col-cell cell-metric" role="cell" data-label="Cost">
                {row.cost ? (
                  <span class={`check-icon ${row.isFeatured ? "icon-featured" : "icon-check"}`} aria-label="Yes">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 13L9.5 17.5L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                ) : (
                  <span class="cross-icon" aria-label="No">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initComparisonSection() {
    const section = document.getElementById("comparison");
    if (!section) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add("is-visible");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    observer.observe(section);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initComparisonSection);
  } else {
    initComparisonSection();
  }

  document.addEventListener("astro:page-load", initComparisonSection);
</script>

<style>
  /* ==========================================================================
     DARK OBSIDIAN SECTION CONTAINER
     ========================================================================== */
  .comparison-section {
    position: relative;
    width: 100%;
    padding-top: clamp(80px, 12vh, 130px);
    padding-bottom: clamp(90px, 13vh, 150px);
    background-color: var(--color-void, #010307);
    color: var(--color-text-primary, #ffffff);
    overflow: hidden;
    isolation: isolate;
  }

  /* Atmospheric Radial Aura */
  .comparison-glow-ambient {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(1000px, 92vw);
    height: 520px;
    background: radial-gradient(ellipse at 50% 50%, rgba(56, 189, 248, 0.1) 0%, rgba(2, 132, 199, 0.04) 50%, transparent 75%);
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  .comparison-container {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ==========================================================================
     HEADER: Dark Mode Typography
     ========================================================================== */
  .comparison-header {
    text-align: center;
    max-width: 860px;
    margin-bottom: clamp(48px, 7vh, 72px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(12px, 1.8vh, 18px);
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #48C8FF;
    display: inline-block;
  }

  .comparison-title {
    font-family: var(--font-family-display, sans-serif);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  .title-highlight {
    background: linear-gradient(135deg, #7fe2ff 0%, #48C8FF 50%, #1da5ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 14px rgba(72, 200, 255, 0.4));
  }

  .title-engine {
    font-style: italic;
    font-family: var(--font-family-display, sans-serif);
  }

  /* Staggered entrance */
  .comparison-section.is-visible .eyebrow-wrapper,
  .comparison-section.is-visible .comparison-title {
    opacity: 1;
    transform: translateY(0);
  }

  .comparison-section.is-visible .comparison-table-wrap {
    opacity: 1;
    transform: translateY(0);
  }

  /* ==========================================================================
     TABLE WRAPPER & GRID ARCHITECTURE
     ========================================================================== */
  .comparison-table-wrap {
    width: 100%;
    overflow: visible;
    padding-top: 40px;
    padding-bottom: 30px;
    padding-inline: 40px;
    margin-top: -40px;
    margin-bottom: -30px;
    margin-inline: -40px;
    opacity: 0;
    transform: translateY(28px);
    transition: 
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  .comparison-table {
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: visible;
  }

  /* Table Header Row */
  .table-head-row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 2.2fr 1fr 1fr 1fr 1fr 1fr;
    align-items: center;
    padding: 0 28px 12px 28px;
  }

  .col-head {
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .col-working-style {
    text-align: left;
  }

  .col-metric {
    text-align: center;
  }

  /* ==========================================================================
     BODY ROWS: Featured (Adaptif) vs Standard Dark Rows
     ========================================================================== */
  .table-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: visible;
  }

  .comparison-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.2fr 1fr 1fr 1fr 1fr 1fr;
    align-items: center;
    border-radius: 20px;
    padding: 24px 28px;
    transition: 
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* --------------------------------------------------------------------------
     FEATURED ROW: Adaptif Glowing Cyan Pill Card
     -------------------------------------------------------------------------- */
  .row-featured {
    position: relative;
    z-index: 2;
    background: linear-gradient(135deg, #7fe2ff 0%, #48C8FF 45%, #22b3ff 100%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: 
      inset 0 1px 2px 0 rgba(255, 255, 255, 0.8),
      0 12px 36px -6px rgba(0, 162, 255, 0.35),
      0 0 50px 0 rgba(72, 200, 255, 0.3);
    margin-bottom: 6px;
  }

  .row-featured:hover {
    transform: translateY(-2px);
    box-shadow: 
      inset 0 1px 2.5px 0 rgba(255, 255, 255, 0.9),
      0 18px 48px -4px rgba(0, 162, 255, 0.45),
      0 0 65px 0 rgba(72, 200, 255, 0.45);
  }

  /* Neon halo aura */
  .featured-glow-halo {
    position: absolute;
    inset: -6px;
    border-radius: 26px;
    background: radial-gradient(ellipse at 50% 50%, rgba(72, 200, 255, 0.45) 0%, transparent 75%);
    filter: blur(16px);
    pointer-events: none;
    z-index: -1;
  }

  .featured-logo-wrap {
    display: flex;
    align-items: center;
  }

  .featured-brand-logo {
    height: 36px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.15));
  }

  /* --------------------------------------------------------------------------
     STANDARD ROWS: Obsidian Glass Cards
     -------------------------------------------------------------------------- */
  .row-standard {
    background: radial-gradient(ellipse 100% 60% at 50% 0%, rgba(18, 32, 65, 0.4) 0%, rgba(6, 12, 30, 0.72) 100%);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.1),
      0 8px 24px -6px rgba(0, 2, 8, 0.6);
  }

  .row-standard:hover {
    border-color: rgba(72, 200, 255, 0.22);
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.16),
      0 12px 32px -4px rgba(0, 2, 8, 0.75),
      0 0 20px -4px rgba(72, 200, 255, 0.15);
    transform: translateY(-2px);
  }

  /* Row Information (Title + Description) */
  .row-info-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-right: 20px;
  }

  .row-title {
    font-size: 1.12rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .row-desc {
    font-size: 0.875rem;
    color: #94a3b8;
    line-height: 1.45;
    margin: 0;
    max-width: 420px;
  }

  /* Metric Cells (Check / Cross) */
  .cell-metric {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* --------------------------------------------------------------------------
     ICONS: Featured vs Standard Check & Cross
     -------------------------------------------------------------------------- */
  /* Featured row checks: deep obsidian navy for ultra high contrast against bright cyan */
  .icon-featured {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #061838;
    filter: drop-shadow(0 1px 2px rgba(255, 255, 255, 0.3));
  }

  /* Standard row checks: clean white */
  .icon-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    filter: drop-shadow(0 1px 6px rgba(255, 255, 255, 0.3));
  }

  /* Cross icons: subtle slate muted */
  .cross-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    opacity: 0.75;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 860px) {
    .comparison-table-wrap {
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      padding-top: 36px;
      padding-bottom: 24px;
      padding-inline: 24px;
      margin-top: -36px;
      margin-inline: -24px;
      scrollbar-width: thin;
      scrollbar-color: rgba(72, 200, 255, 0.25) transparent;
    }

    .comparison-table {
      min-width: 720px;
    }

    .comparison-row {
      padding: 20px 22px;
    }

    .row-desc {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 768px) {
    .comparison-section {
      padding-top: 60px;
      padding-bottom: 80px;
    }

    .table-head-row {
      padding: 0 16px 10px 16px;
    }

    .col-head {
      font-size: 0.8rem;
    }
  }
</style>
