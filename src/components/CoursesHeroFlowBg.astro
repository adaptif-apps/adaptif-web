<canvas id="courses-hero-flow-canvas" class="courses-hero-flow-canvas" aria-hidden="true"></canvas>

<script>
  (() => {
    const canvas = document.getElementById("courses-hero-flow-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let rafId = 0;

    let seed = 42;
    const rand = () => {
      seed = (seed * 1664525 + 1013904223) % 4294967296;
      return seed / 4294967296;
    };

    interface FlowNode {
      x: number;
      y: number;
      z: number;
      phase: number;
      radius: number;
    }

    interface FlowLink {
      a: number;
      b: number;
      pulseOffset: number;
      pulseSpeed: number;
      hasPulse: boolean;
    }

    const nodes: FlowNode[] = [];
    const cols = 7;
    const rows = 4;
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const nx = (c / (cols - 1) - 0.5) * 2.1 + (rand() - 0.5) * 0.22;
        const ny = (r / (rows - 1) - 0.5) * 1.45 + (rand() - 0.5) * 0.2;
        const nz = 0.75 + rand() * 1.65;
        nodes.push({
          x: nx,
          y: ny,
          z: nz,
          phase: rand() * Math.PI * 2,
          radius: 1.6 + rand() * 1.4,
        });
      }
    }

    const links: FlowLink[] = [];
    for (let i = 0; i < nodes.length; i++) {
      const col = i % cols;
      const row = Math.floor(i / cols);
      if (col < cols - 1) {
        links.push({
          a: i,
          b: i + 1,
          pulseOffset: rand(),
          pulseSpeed: 0.08 + rand() * 0.08,
          hasPulse: rand() > 0.35,
        });
      }
      if (row < rows - 1) {
        links.push({
          a: i,
          b: i + cols,
          pulseOffset: rand(),
          pulseSpeed: 0.07 + rand() * 0.08,
          hasPulse: rand() > 0.45,
        });
      }
      if (col < cols - 1 && row < rows - 1 && rand() > 0.58) {
        links.push({
          a: i,
          b: i + cols + 1,
          pulseOffset: rand(),
          pulseSpeed: 0.06 + rand() * 0.07,
          hasPulse: rand() > 0.5,
        });
      }
    }

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(canvas);

    const project = (nx: number, ny: number, nz: number, t: number) => {
      const driftX = Math.sin(t * 0.25 + ny * 2.0) * 0.025;
      const driftY = Math.cos(t * 0.22 + nx * 2.0) * 0.02;
      const perspective = 1.35 / (nz + 0.55);
      const cx = width * 0.5;
      const cy = height * 0.42;
      const scale = Math.min(width, height * 1.45) * 0.56;
      return {
        x: cx + (nx + driftX) * scale * perspective,
        y: cy + (ny + driftY) * scale * perspective,
        depth: perspective,
      };
    };

    const drawFrame = (timeMs: number) => {
      const t = prefersReducedMotion ? 0 : timeMs * 0.001;
      ctx.clearRect(0, 0, width, height);

      const glow = ctx.createRadialGradient(
        width * 0.5,
        height * 0.36,
        0,
        width * 0.5,
        height * 0.36,
        Math.max(width, height) * 0.55
      );
      glow.addColorStop(0, "rgba(72, 200, 255, 0.085)");
      glow.addColorStop(0.55, "rgba(22, 82, 130, 0.035)");
      glow.addColorStop(1, "rgba(1, 3, 7, 0)");
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      const projected = nodes.map((n) => ({
        ...project(n.x, n.y, n.z, t),
        phase: n.phase,
        radius: n.radius,
      }));

      ctx.lineWidth = 1;
      for (const link of links) {
        const p1 = projected[link.a];
        const p2 = projected[link.b];
        const avgDepth = (p1.depth + p2.depth) * 0.5;
        const alpha = Math.min(0.24, Math.max(0.05, avgDepth * 0.16));

        const midX = (p1.x + p2.x) * 0.5;
        const midY = (p1.y + p2.y) * 0.5 - 12 * avgDepth;

        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.quadraticCurveTo(midX, midY, p2.x, p2.y);
        ctx.strokeStyle = `rgba(72, 200, 255, ${alpha.toFixed(3)})`;
        ctx.stroke();

        if (link.hasPulse && !prefersReducedMotion) {
          const u = (t * link.pulseSpeed + link.pulseOffset) % 1;
          const inv = 1 - u;
          const px = inv * inv * p1.x + 2 * inv * u * midX + u * u * p2.x;
          const py = inv * inv * p1.y + 2 * inv * u * midY + u * u * p2.y;
          const pulseAlpha = Math.sin(u * Math.PI) * Math.min(0.45, avgDepth * 0.35);

          ctx.beginPath();
          ctx.arc(px, py, 1.8 * avgDepth, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(156, 225, 255, ${pulseAlpha.toFixed(3)})`;
          ctx.fill();
        }
      }

      for (const p of projected) {
        const pulse = 0.75 + 0.25 * Math.sin(t * 1.4 + p.phase);
        const nodeAlpha = Math.min(0.42, Math.max(0.1, p.depth * 0.28)) * pulse;
        const r = Math.max(1.1, p.radius * p.depth);

        ctx.beginPath();
        ctx.arc(p.x, p.y, r * 2.6, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(72, 200, 255, ${(nodeAlpha * 0.16).toFixed(3)})`;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(156, 225, 255, ${nodeAlpha.toFixed(3)})`;
        ctx.fill();
      }

      if (!prefersReducedMotion) {
        rafId = requestAnimationFrame(drawFrame);
      }
    };

    rafId = requestAnimationFrame(drawFrame);

    window.addEventListener("pagehide", () => {
      cancelAnimationFrame(rafId);
      ro.disconnect();
    }, { once: true });
  })();
</script>
