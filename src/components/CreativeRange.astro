const column4: TileItem[] = [
  { id: "col4-1", image: "/header_images/work-6.jpg", title: "Velvet Couture SS26", category: "Fashion" },
  { id: "col4-2", image: "/header_images/work-10.jpg", title: "Quantico Crypto Vault", category: "Tech" },
  { id: "col4-3", image: "/header_images/work-11.jpg", title: "Seraph Mindful Routine", category: "Wellness" },
  { id: "col4-4", image: "/header_images/work-12.jpg", title: "Vector 3D Topology", category: "3D" },
  { id: "col4-5", image: "/work/1fce34a3758cff5e47cf0a25904b4854.jpg", title: "Aura Botanical Skin", category: "Wellness" },
];

const column5: TileItem[] = [
  { id: "col5-1", image: "/work/9e80968f8b616f415454cfd43eb454c8.jpg", title: "Solstice AI Assistant", category: "Tech" },
  { id: "col5-2", image: "/header_images/work-3.jpg", title: "Vogue Maison Capsule", category: "Fashion" },
  { id: "col5-3", image: "/header_images/work-0.jpg", title: "Apex FinTech Core", category: "Tech" },
  { id: "col5-4", image: "/header_images/work-7.jpg", title: "Luminary High Jewelry", category: "Fashion" },
  { id: "col5-5", image: "/work/0cb17cbee8ef36202bfb1b0e17338257.jpg", title: "Kinetics Form & Motion", category: "3D" },
