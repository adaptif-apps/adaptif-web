---
// CreativeRange.astro - Light/Dark Mode Section with Tilted Tiles Gallery
// Configuration: columns=15, perspective=900, rotateX=48, rotateY=0, rotateZ=0, planeWidth=210, parallax=false
import { listProjects } from "../lib/portfolioDb";
import type { PortfolioProject } from "../data/portfolioSeed";

interface Props {
  theme?: "light" | "dark";
  eyebrow?: string;
  title?: string;
  highlightTitle?: string;
  asHero?: boolean;
  projects?: PortfolioProject[];
}

const {
  theme = "light",
  eyebrow = "Creative range",
  title = "Tech, fashion, wellness,",
  highlightTitle = "everywhere in between.",
  asHero = false,
  projects,
} = Astro.props;

interface TileItem {
  id: string;
  image: string;
  title: string;
}

const cmsProjects = projects ?? (await listProjects({ includeHidden: false }));

// Collect unique images from the Portfolio CMS (thumbnails + galleries)
const seenImages = new Set<string>();
const cmsAssets: TileItem[] = [];

for (const project of cmsProjects) {
  const candidates = [project.image, ...(project.gallery ?? [])];
  for (const imgUrl of candidates) {
    if (imgUrl && !seenImages.has(imgUrl)) {
      seenImages.add(imgUrl);
      cmsAssets.push({
        id: `${project.id}-${cmsAssets.length}`,
        image: imgUrl,
        title: project.title,
      });
    }
  }
}

// Deterministic seeded PRNG (Mulberry32) so the random layout stays fixed across loads
function createSeededRng(seed: number) {
  let a = seed >>> 0;
  return function next() {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Seeded Fisher-Yates shuffle for a fixed random ordering
function shuffleArray<T>(arr: T[], rand: () => number): T[] {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const seededRng = createSeededRng(0x41646170);

const pool = cmsAssets.length > 0
  ? shuffleArray(cmsAssets, seededRng)
  : [{ id: "fallback-1", image: "/work-featured/sideline.jpg", title: "Sideline Podcast" }];

const totalColumns = 15;
const tilesPerCol = 12;
const speedPresets = [
  "42s", "36s", "46s", "38s", "44s",
  "34s", "42s", "37s", "45s", "35s",
  "41s", "48s", "39s", "36s", "43s",
];

// Build 15 columns with fixed-seed randomized CMS images
let cursor = 0;
let bag = shuffleArray(pool, seededRng);

const columns = Array.from({ length: totalColumns }).map((_, colIdx) => {
  const colItems: TileItem[] = [];
  for (let i = 0; i < tilesPerCol; i++) {
    if (cursor >= bag.length) {
      bag = shuffleArray(pool, seededRng);
      cursor = 0;
    }
    colItems.push(bag[cursor++]);
  }
  return {
    items: colItems,
    reverse: colIdx % 2 === 1,
    duration: speedPresets[colIdx % speedPresets.length],
  };
});
---

<section
  class={asHero ? "creative-range-section is-visible" : "creative-range-section"}
  id="creative-range"
  data-theme={theme}
  data-hero={asHero ? "true" : undefined}
>
  <!-- Subtle Ambient Tone -->
  <div class="creative-ambient-light" aria-hidden="true"></div>

  <div class="container creative-container">
    <!-- Header Block -->
    <header class="creative-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">{eyebrow}</span>
      </div>

      {asHero ? (
        <h1 class="creative-title">
          {title}{highlightTitle ? <> <span class="title-highlight">{highlightTitle}</span></> : null}
        </h1>
      ) : (
        <h2 class="creative-title">
          {title}{highlightTitle ? <> <span class="title-highlight">{highlightTitle}</span></> : null}
        </h2>
      )}
    </header>
  </div>

  <!-- Tilted Tiles 3D Gallery Viewport (Exact Spec: perspective=900, planeWidth=210) -->
  <div class="tilted-tiles-viewport" id="tilted-tiles-scene">
    <!-- Top & Bottom Gradient Masks to blend into white canvas -->
    <div class="tile-mask-fade tile-mask-top" aria-hidden="true"></div>
    <div class="tile-mask-fade tile-mask-bottom" aria-hidden="true"></div>

    <!-- 3D Perspective Plane: rotateX=48, rotateY=0, rotateZ=0, planeWidth=210% -->
    <div class="tilted-plane" id="tilted-plane">
      {columns.map((col) => (
        <div 
          class={`tile-column ${col.reverse ? "scroll-reverse" : "scroll-forward"}`}
          style={`--col-duration: ${col.duration};`}
        >
          <!-- Single unified track with Set A and Set B for true mathematically seamless infinite marquee -->
          <div class="tile-column-track">
            <!-- Set A -->
            {col.items.map((tile) => (
              <figure class="tile-card">
                <div class="tile-image-wrap">
                  <img 
                    src={tile.image} 
                    alt={tile.title} 
                    loading={asHero ? "eager" : "lazy"} 
                    decoding="async" 
                    class="tile-img" 
                  />
                </div>
              </figure>
            ))}

            <!-- Set B (exact clone of Set A for seamless -50% loop) -->
            {col.items.map((tile) => (
              <figure class="tile-card" aria-hidden="true">
                <div class="tile-image-wrap">
                  <img 
                    src={tile.image} 
                    alt="" 
                    loading={asHero ? "eager" : "lazy"} 
                    decoding="async" 
                    class="tile-img" 
                  />
                </div>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Soft bottom fade to blend the section naturally into the light background -->
  <div class="section-bottom-fade" aria-hidden="true"></div>
</section>

<script>
  function initCreativeRange() {
    const section = document.getElementById("creative-range");
    if (!section) return;

    // Viewport Intersection Observer for Staggered Entrance
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add("is-visible");
          }
        });
      },
      { threshold: 0.06, rootMargin: "0px 0px -40px 0px" }
    );
    observer.observe(section);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCreativeRange);
  } else {
    initCreativeRange();
  }

  document.addEventListener("astro:page-load", initCreativeRange);
</script>

<style>
  /* ==========================================================================
     LIGHT MODE SECTION CONTAINER
     Inverse of Dark Obsidian: Background is pure luminous white, Text is Dark
     ========================================================================== */
  .creative-range-section {
    position: relative;
    width: 100%;
    padding-top: clamp(80px, 11vh, 120px);
    padding-bottom: clamp(90px, 13vh, 150px);
    background-color: #ffffff;
    color: #050811;
    overflow: hidden;
    isolation: isolate;
  }

  /* Soft ethereal ambient illumination */
  .creative-ambient-light {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, 100vw);
    height: 500px;
    background: radial-gradient(ellipse at 50% 0%, rgba(2, 132, 199, 0.06) 0%, rgba(240, 249, 255, 0.6) 45%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .creative-container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ==========================================================================
     HEADER: Light Mode Typography
     ========================================================================== */
  .creative-header {
    text-align: center;
    max-width: 860px;
    margin-bottom: clamp(40px, 6vh, 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(12px, 1.8vh, 18px);
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0284c7; /* Vibrant brand cyan-blue */
    display: inline-block;
  }

  .creative-title {
    font-family: var(--font-family-display);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: #050811;
    margin: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  /* Celestial Gradient Accent for "everywhere in between." on Light Background */
  .title-highlight {
    background: linear-gradient(135deg, #0070f3 0%, #0099ff 45%, #00c0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 10px rgba(0, 153, 255, 0.18));
  }

  /* Staggered entrance trigger */
  .creative-range-section.is-visible .eyebrow-wrapper,
  .creative-range-section.is-visible .creative-title {
    opacity: 1;
    transform: translateY(0);
  }

  .creative-range-section.is-visible .tilted-tiles-viewport {
    opacity: 1;
    transform: scale(1);
  }

  /* ==========================================================================
     TILTED TILES 3D PERSPECTIVE SCENE
     Exact User Configuration:
     columns={15}
     perspective={900}
     rotateX={48}
     rotateY={0}
     rotateZ={0}
     planeWidth={210}
     parallax={false}
     ========================================================================== */
  .tilted-tiles-viewport {
    position: relative;
    width: 100%;
    height: clamp(850px, 110vh, 1350px);
    perspective: 900px;
    perspective-origin: 50% 50%;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    transform: scale(0.97);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.4) 3%,
      black 15%,
      black 68%,
      rgba(0, 0, 0, 0.5) 86%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.4) 3%,
      black 15%,
      black 68%,
      rgba(0, 0, 0, 0.5) 86%,
      transparent 100%
    );
    transition: 
      opacity 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
      transform 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  /* Gradient Vignette Mask fading top & bottom into light background */
  .tile-mask-fade {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
    z-index: 25;
  }

  .tile-mask-top {
    top: 0;
    height: clamp(120px, 18vh, 220px);
    background: linear-gradient(to bottom, #ffffff 0%, rgba(255, 255, 255, 0.94) 40%, rgba(255, 255, 255, 0) 100%);
  }

  .tile-mask-bottom {
    bottom: 0;
    height: clamp(180px, 26vh, 320px);
    background: linear-gradient(to top, #ffffff 0%, rgba(255, 255, 255, 0.96) 50%, rgba(255, 255, 255, 0) 100%);
    transform: translateZ(600px); /* Guaranteed to float well in front of tilted 3D items */
  }

  /* Section-level bottom fade overlay */
  .section-bottom-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: clamp(140px, 20vh, 260px);
    background: linear-gradient(to top, #ffffff 0%, rgba(255, 255, 255, 0.95) 50%, rgba(255, 255, 255, 0) 100%);
    z-index: 10;
    pointer-events: none;
  }

  /* 3D Tilted Plane: planeWidth=210%, rotateX=48, rotateY=0, rotateZ=0 */
  .tilted-plane {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 210%;
    height: 360%;
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    column-gap: clamp(8px, 0.9vw, 14px);
    pointer-events: none;
    transform-style: preserve-3d;
    transform: 
      translate(-50%, -50%)
      rotateX(48deg)
      rotateY(0deg)
      rotateZ(0deg);
    will-change: transform;
  }

  /* Scrolling Columns */
  .tile-column {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    pointer-events: none;
  }

  .tile-column-track {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    will-change: transform;
    pointer-events: none;
  }

  /* Forward scroll (upwards) */
  .scroll-forward .tile-column-track {
    animation: scrollUpTrack var(--col-duration, 38s) linear infinite;
  }

  /* Reverse scroll (downwards) */
  .scroll-reverse .tile-column-track {
    animation: scrollDownTrack var(--col-duration, 38s) linear infinite;
  }

  /* Single unified track loops 50% seamlessly with zero gaps */
  @keyframes scrollUpTrack {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-50%);
    }
  }

  @keyframes scrollDownTrack {
    0% {
      transform: translateY(-50%);
    }
    100% {
      transform: translateY(0);
    }
  }

  /* ==========================================================================
     TILE CARDS: Clean aspect, crisp subtle borders & natural shadow
     ========================================================================== */
  .tile-card {
    position: relative;
    margin: 0;
    margin-bottom: clamp(8px, 0.9vw, 14px);
    border-radius: clamp(10px, 1.2vw, 16px);
    overflow: hidden;
    background: #f1f5f9;
    box-shadow: 
      0 8px 20px -6px rgba(15, 23, 42, 0.12),
      0 2px 6px -1px rgba(15, 23, 42, 0.05),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    pointer-events: none;
    flex-shrink: 0;
  }

  .tile-image-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
    pointer-events: none;
    background: #e2e8f0;
  }

  .tile-img {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 1024px) {
    .tilted-tiles-viewport {
      height: clamp(750px, 95vh, 1050px);
    }

    .tilted-plane {
      width: 230%;
      grid-template-columns: repeat(12, 1fr);
    }

    .tile-column:nth-child(n+13) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .creative-range-section {
      padding-top: clamp(60px, 9vh, 90px);
      padding-bottom: clamp(60px, 9vh, 100px);
    }

    .tilted-tiles-viewport {
      height: clamp(600px, 80vh, 800px);
      perspective: 750px;
    }

    .tilted-plane {
      width: 250%;
      grid-template-columns: repeat(9, 1fr);
      column-gap: 8px;
    }

    .tile-column:nth-child(n+10) {
      display: none;
    }

    .tile-card {
      border-radius: 8px;
      margin-bottom: 8px;
    }
  }

  /* Dark Mode & Hero Overrides */
  .creative-range-section[data-hero="true"] {
    padding-top: clamp(132px, 16vh, 176px);
  }

  .creative-range-section[data-theme="dark"] {
    background-color: var(--color-void, #010307);
    color: #ffffff;
  }

  .creative-range-section[data-theme="dark"] .creative-ambient-light {
    background: radial-gradient(
      ellipse at center,
      rgba(14, 165, 233, 0.14) 0%,
      rgba(56, 189, 248, 0.04) 45%,
      transparent 70%
    );
  }

  .creative-range-section[data-theme="dark"] .eyebrow-text {
    color: #38bdf8;
  }

  .creative-range-section[data-theme="dark"] .creative-title {
    color: #ffffff;
  }

  .creative-range-section[data-theme="dark"] .title-highlight {
    background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 55%, #7dd3fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .creative-range-section[data-theme="dark"] .tile-mask-top {
    background: linear-gradient(
      to bottom,
      #010307 0%,
      rgba(1, 3, 7, 0.94) 40%,
      rgba(1, 3, 7, 0) 100%
    );
  }

  .creative-range-section[data-theme="dark"] .tile-mask-bottom {
    background: linear-gradient(
      to top,
      #010307 0%,
      rgba(1, 3, 7, 0.96) 50%,
      rgba(1, 3, 7, 0) 100%
    );
  }

  .creative-range-section[data-theme="dark"] .section-bottom-fade {
    background: linear-gradient(
      to top,
      #010307 0%,
      rgba(1, 3, 7, 0.95) 50%,
      rgba(1, 3, 7, 0) 100%
    );
  }

  .creative-range-section[data-theme="dark"] .tile-card {
    background: #0b111e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-column-track {
      animation: none !important;
    }

    .tilted-plane {
      transform: translate(-50%, -50%) rotateX(0deg) !important;
    }
  }
</style>
