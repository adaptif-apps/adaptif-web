  { id: "col3-1", image: "/header_images/work-2.jpg", title: "Equinox Organic Ritual", category: "Wellness" },
  { id: "col3-2", image: "/work/dcbe45c0e1ae80c24e20cf0d5abba272.jpg", title: "Synthetix Neural UI", category: "Tech" },
  { id: "col3-3", image: "/header_images/work-5.jpg", title: "Moderne Atelier Runway", category: "Fashion" },
  { id: "col3-4", image: "/work/ade59a73aba7c39e38d6aa91565627bc.jpg", title: "Prism Spatial Sound", category: "3D" },
  { id: "col3-5", image: "/header_images/work-9.jpg", title: "Nirvana Flow Tonic", category: "Wellness" },
