---
// CreativeRange.astro - Light Mode Section with Tilted Tiles Gallery
// Configuration: columns=15, perspective=900, rotateX=48, rotateY=0, rotateZ=0, planeWidth=210, parallax=false

interface TileItem {
  id: string;
  image: string;
  title: string;
  category: "Tech" | "Fashion" | "Wellness" | "Brand" | "3D";
}

const allAssets: TileItem[] = [
  { id: "ast-1", image: "/header_images/work-0.jpg", title: "Apex FinTech Core", category: "Tech" },
  { id: "ast-2", image: "/work/1fce34a3758cff5e47cf0a25904b4854.jpg", title: "Aura Botanical Skin", category: "Wellness" },
  { id: "ast-3", image: "/header_images/work-3.jpg", title: "Vogue Maison Capsule", category: "Fashion" },
  { id: "ast-4", image: "/work/9e80968f8b616f415454cfd43eb454c8.jpg", title: "Solstice AI Assistant", category: "Tech" },
  { id: "ast-5", image: "/header_images/work-7.jpg", title: "Luminary High Jewelry", category: "Fashion" },
  { id: "ast-6", image: "/images/why-us/creative-talent.jpg", title: "Studio Form & Brand", category: "Brand" },
  { id: "ast-7", image: "/header_images/work-11.jpg", title: "Seraph Mindful Routine", category: "Wellness" },
  { id: "ast-8", image: "/work/0cb17cbee8ef36202bfb1b0e17338257.jpg", title: "Kinetics Form & Motion", category: "3D" },
  { id: "ast-9", image: "/header_images/work-1.jpg", title: "Hyperion Cloud OS", category: "Tech" },
  { id: "ast-10", image: "/work/664bbf117716eb69519b17e2f37bee2a.jpg", title: "Zenith Herbal Essence", category: "Wellness" },
  { id: "ast-11", image: "/header_images/work-4.jpg", title: "Studio Noir Editorial", category: "Fashion" },
  { id: "ast-12", image: "/header_images/work-8.jpg", title: "Chrono Kinetic Engine", category: "Tech" },
  { id: "ast-13", image: "/images/why-us/our-technology.jpg", title: "Quantum Neural Stack", category: "Tech" },
  { id: "ast-14", image: "/header_images/work-2.jpg", title: "Equinox Organic Ritual", category: "Wellness" },
  { id: "ast-15", image: "/work/dcbe45c0e1ae80c24e20cf0d5abba272.jpg", title: "Synthetix Neural UI", category: "3D" },
  { id: "ast-16", image: "/header_images/work-5.jpg", title: "Moderne Atelier Runway", category: "Fashion" },
  { id: "ast-17", image: "/work/ade59a73aba7c39e38d6aa91565627bc.jpg", title: "Prism Spatial Sound", category: "3D" },
  { id: "ast-18", image: "/header_images/work-9.jpg", title: "Nirvana Flow Tonic", category: "Wellness" },
  { id: "ast-19", image: "/images/why-us/ai-excellence.jpg", title: "Cognitive Visuals", category: "Tech" },
  { id: "ast-20", image: "/header_images/work-6.jpg", title: "Velvet Couture SS26", category: "Fashion" },
  { id: "ast-21", image: "/header_images/work-10.jpg", title: "Quantico Crypto Vault", category: "Tech" },
  { id: "ast-22", image: "/images/designed-to-keep-up/card-1-deadlines.jpg", title: "Pulse Velocity Tracker", category: "Tech" },
  { id: "ast-23", image: "/header_images/work-12.jpg", title: "Vector 3D Topology", category: "3D" },
  { id: "ast-24", image: "/images/designed-to-keep-up/card-2-talent.jpg", title: "Collective Design Studio", category: "Brand" },
  { id: "ast-25", image: "/images/rethinking-creative-teams.jpg", title: "Rethink Creative Labs", category: "Brand" },
  { id: "ast-26", image: "/images/designed-to-keep-up/card-3-plan.jpg", title: "Blueprint Architecture", category: "Tech" },
];

// Generate 15 distinct columns with 12 items per column (24 items total per track)
// to guarantee zero empty gaps or missing cards at any point during continuous loop
const totalColumns = 15;
const tilesPerCol = 12;
const speedPresets = [
  "42s", "36s", "46s", "38s", "44s", 
  "34s", "42s", "37s", "45s", "35s", 
  "41s", "48s", "39s", "36s", "43s"
];

const columns = Array.from({ length: totalColumns }).map((_, colIdx) => {
  const colItems: TileItem[] = [];
  for (let i = 0; i < tilesPerCol; i++) {
    const assetIdx = (colIdx * 3 + i * 7) % allAssets.length;
    colItems.push(allAssets[assetIdx]);
  }
  return {
    items: colItems,
    reverse: colIdx % 2 === 1,
    duration: speedPresets[colIdx % speedPresets.length]
  };
});
---

<section class="creative-range-section" id="creative-range" data-theme="light">
  <!-- Subtle Light Ambient Tone -->
  <div class="creative-ambient-light" aria-hidden="true"></div>

  <div class="container creative-container">
    <!-- Header Block (Light Mode) -->
    <header class="creative-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">Creative range</span>
      </div>

      <h2 class="creative-title">
        Tech, fashion, wellness, <span class="title-highlight">everywhere in between.</span>
      </h2>
    </header>
  </div>

  <!-- Tilted Tiles 3D Gallery Viewport (Exact Spec: perspective=900, planeWidth=210) -->
  <div class="tilted-tiles-viewport" id="tilted-tiles-scene">
    <!-- Top & Bottom Gradient Masks to blend into white canvas -->
    <div class="tile-mask-fade tile-mask-top" aria-hidden="true"></div>
    <div class="tile-mask-fade tile-mask-bottom" aria-hidden="true"></div>

    <!-- 3D Perspective Plane: rotateX=48, rotateY=0, rotateZ=0, planeWidth=210% -->
    <div class="tilted-plane" id="tilted-plane">
      {columns.map((col) => (
        <div 
          class={`tile-column ${col.reverse ? "scroll-reverse" : "scroll-forward"}`}
          style={`--col-duration: ${col.duration};`}
        >
          <!-- Single unified track with Set A and Set B for true mathematically seamless infinite marquee -->
          <div class="tile-column-track">
            <!-- Set A -->
            {col.items.map((tile) => (
              <figure class="tile-card" data-category={tile.category}>
                <div class="tile-image-wrap">
                  <img 
                    src={tile.image} 
                    alt={tile.title} 
                    loading="eager" 
                    decoding="sync" 
                    class="tile-img" 
                  />
                </div>
              </figure>
            ))}

            <!-- Set B (exact clone of Set A for seamless -50% loop) -->
            {col.items.map((tile) => (
              <figure class="tile-card" data-category={tile.category} aria-hidden="true">
                <div class="tile-image-wrap">
                  <img 
                    src={tile.image} 
                    alt="" 
                    loading="eager" 
                    decoding="sync" 
                    class="tile-img" 
                  />
                </div>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initCreativeRange() {
    const section = document.getElementById("creative-range");
    if (!section) return;

    // Viewport Intersection Observer for Staggered Entrance
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add("is-visible");
          }
        });
      },
      { threshold: 0.06, rootMargin: "0px 0px -40px 0px" }
    );
    observer.observe(section);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCreativeRange);
  } else {
    initCreativeRange();
  }

  document.addEventListener("astro:page-load", initCreativeRange);
</script>

<style>
  /* ==========================================================================
     LIGHT MODE SECTION CONTAINER
     Inverse of Dark Obsidian: Background is pure luminous white, Text is Dark
     ========================================================================== */
  .creative-range-section {
    position: relative;
    width: 100%;
    padding-top: clamp(80px, 11vh, 120px);
    padding-bottom: clamp(90px, 13vh, 150px);
    background-color: #ffffff;
    color: #050811;
    overflow: hidden;
    isolation: isolate;
  }

  /* Soft ethereal ambient illumination */
  .creative-ambient-light {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, 100vw);
    height: 500px;
    background: radial-gradient(ellipse at 50% 0%, rgba(2, 132, 199, 0.06) 0%, rgba(240, 249, 255, 0.6) 45%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .creative-container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ==========================================================================
     HEADER: Light Mode Typography
     ========================================================================== */
  .creative-header {
    text-align: center;
    max-width: 860px;
    margin-bottom: clamp(40px, 6vh, 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(12px, 1.8vh, 18px);
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0284c7; /* Vibrant brand cyan-blue */
    display: inline-block;
  }

  .creative-title {
    font-family: var(--font-family-display);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: #050811;
    margin: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  /* Celestial Gradient Accent for "everywhere in between." on Light Background */
  .title-highlight {
    background: linear-gradient(135deg, #0070f3 0%, #0099ff 45%, #00c0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 10px rgba(0, 153, 255, 0.18));
  }

  /* Staggered entrance trigger */
  .creative-range-section.is-visible .eyebrow-wrapper,
  .creative-range-section.is-visible .creative-title {
    opacity: 1;
    transform: translateY(0);
  }

  .creative-range-section.is-visible .tilted-tiles-viewport {
    opacity: 1;
    transform: scale(1);
  }

  /* ==========================================================================
     TILTED TILES 3D PERSPECTIVE SCENE
     Exact User Configuration:
     columns={15}
     perspective={900}
     rotateX={48}
     rotateY={0}
     rotateZ={0}
     planeWidth={210}
     parallax={false}
     ========================================================================== */
  .tilted-tiles-viewport {
    position: relative;
    width: 100%;
    height: clamp(850px, 110vh, 1350px);
    perspective: 900px;
    perspective-origin: 50% 50%;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    transform: scale(0.97);
    transition: 
      opacity 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
      transform 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  /* Gradient Vignette Mask fading top & bottom into light background */
  .tile-mask-fade {
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(120px, 18vh, 220px);
    z-index: 10;
    pointer-events: none;
  }

  .tile-mask-top {
    top: 0;
    background: linear-gradient(to bottom, #ffffff 0%, rgba(255, 255, 255, 0.94) 35%, rgba(255, 255, 255, 0) 100%);
  }

  .tile-mask-bottom {
    bottom: 0;
    background: linear-gradient(to top, #ffffff 0%, rgba(255, 255, 255, 0.94) 35%, rgba(255, 255, 255, 0) 100%);
  }

  /* 3D Tilted Plane: planeWidth=210%, rotateX=48, rotateY=0, rotateZ=0 */
  .tilted-plane {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 210%;
    height: 360%;
    display: grid;
    grid-template-columns: repeat(15, 1fr);
    column-gap: clamp(8px, 0.9vw, 14px);
    pointer-events: none;
    transform-style: preserve-3d;
    transform: 
      translate(-50%, -50%)
      rotateX(48deg)
      rotateY(0deg)
      rotateZ(0deg);
    will-change: transform;
  }

  /* Scrolling Columns */
  .tile-column {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    pointer-events: none;
  }

  .tile-column-track {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    will-change: transform;
    pointer-events: none;
  }

  /* Forward scroll (upwards) */
  .scroll-forward .tile-column-track {
    animation: scrollUpTrack var(--col-duration, 38s) linear infinite;
  }

  /* Reverse scroll (downwards) */
  .scroll-reverse .tile-column-track {
    animation: scrollDownTrack var(--col-duration, 38s) linear infinite;
  }

  /* Single unified track loops 50% seamlessly with zero gaps */
  @keyframes scrollUpTrack {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-50%);
    }
  }

  @keyframes scrollDownTrack {
    0% {
      transform: translateY(-50%);
    }
    100% {
      transform: translateY(0);
    }
  }

  /* ==========================================================================
     TILE CARDS: Clean aspect, crisp subtle borders & natural shadow
     ========================================================================== */
  .tile-card {
    position: relative;
    margin: 0;
    margin-bottom: clamp(8px, 0.9vw, 14px);
    border-radius: clamp(10px, 1.2vw, 16px);
    overflow: hidden;
    background: #f1f5f9;
    box-shadow: 
      0 8px 20px -6px rgba(15, 23, 42, 0.12),
      0 2px 6px -1px rgba(15, 23, 42, 0.05),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    pointer-events: none;
    flex-shrink: 0;
  }

  .tile-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    pointer-events: none;
    background: #e2e8f0;
  }

  .tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 1024px) {
    .tilted-tiles-viewport {
      height: clamp(750px, 95vh, 1050px);
    }

    .tilted-plane {
      width: 230%;
      grid-template-columns: repeat(12, 1fr);
    }

    .tile-column:nth-child(n+13) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .creative-range-section {
      padding-top: clamp(60px, 9vh, 90px);
      padding-bottom: clamp(60px, 9vh, 100px);
    }

    .tilted-tiles-viewport {
      height: clamp(600px, 80vh, 800px);
      perspective: 750px;
    }

    .tilted-plane {
      width: 250%;
      grid-template-columns: repeat(9, 1fr);
      column-gap: 8px;
    }

    .tile-column:nth-child(n+10) {
      display: none;
    }

    .tile-card {
      border-radius: 8px;
      margin-bottom: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-column-track {
      animation: none !important;
    }

    .tilted-plane {
      transform: translate(-50%, -50%) rotateX(0deg) !important;
    }
  }
</style>
