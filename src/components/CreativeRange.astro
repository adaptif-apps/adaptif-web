  { id: "col2-2", image: "/header_images/work-1.jpg", title: "Hyperion Cloud OS", category: "Tech" },
  { id: "col2-3", image: "/work/664bbf117716eb69519b17e2f37bee2a.jpg", title: "Zenith Herbal Essence", category: "Wellness" },
  { id: "col2-4", image: "/header_images/work-4.jpg", title: "Studio Noir Editorial", category: "Fashion" },
