---
// CreativeTalentBottom.astro - Sections 8 & 9: Join 100+ brands CTA & Why Adaptif showcase
const whyAdaptifCards = [
  {
    label: "Our creative talent",
    href: "/our-creative-talent",
    image: "/images/our-creative-talent/why-creative-talent.jpg",
  },
  {
    label: "AI excellence",
    href: "/ai-excellence",
    image: "/images/our-creative-talent/why-ai-excellence.jpg",
  },
  {
    label: "Our work",
    href: "/our-work",
    image: "/images/our-creative-talent/why-our-work.jpg",
  },
];
---

<!-- Section 8: Join 100+ brands -->
<section class="ct-cta" id="join-brands" aria-labelledby="ct-cta-title">
  <div class="container">
    <div class="ct-cta__banner" data-ct-reveal="scale">
      <picture class="ct-cta__picture">
        <source media="(max-width: 768px)" srcset="/images/our-creative-talent/join-brands-mobile.jpg" />
        <img
          src="/images/our-creative-talent/join-brands-desktop.jpg"
          alt=""
          class="ct-cta__bg"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="ct-cta__scrim" aria-hidden="true"></div>

      <div class="ct-cta__content">
        <p class="adaptif-eyebrow" data-ct-reveal style="--ct-delay: 80ms">Join 100+ brands</p>
        <h2 id="ct-cta-title" class="ct-cta__title" data-ct-reveal style="--ct-delay: 140ms">
          Get creative support <span class="title-highlight">you can trust.</span>
        </h2>
        <p class="ct-cta__desc" data-ct-reveal style="--ct-delay: 200ms">
          You’ve seen what AI-powered creative looks like when it’s done right. Let’s talk about what that would look like for your brand.
        </p>
        <div class="ct-cta__actions" data-ct-reveal style="--ct-delay: 260ms">
          <a href="#book-a-call" class="adaptif-btn" data-open-book-call>
            <span>Book a Call</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Section 9: Why Adaptif -->
<section class="ct-why" id="why-adaptif" aria-labelledby="ct-why-title">
  <div class="container">
    <header class="ct-why__header" data-ct-reveal>
      <p class="adaptif-eyebrow">Why Adaptif</p>
      <h2 id="ct-why-title" class="ct-why__title">
        See why the best teams <span class="title-highlight">use Adaptif</span>
      </h2>
    </header>

    <div class="ct-why__grid">
      {whyAdaptifCards.map((card, idx) => (
        <a href={card.href} class="glass-panel ct-why__card" data-ct-reveal="scale" style={`--ct-delay: ${idx * 100}ms`}>
          <div class="ct-why__media">
            <img src={card.image} alt={card.label} loading="lazy" decoding="async" />
            <div class="ct-why__media-scrim" aria-hidden="true"></div>
          </div>
          <div class="ct-why__footer">
            <span class="ct-why__label">{card.label}</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ct-cta {
    padding: clamp(40px, 6vw, 72px) 0;
    background-color: var(--color-void);
  }

  .ct-cta__banner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(72, 200, 255, 0.25);
    padding: clamp(40px, 6vw, 68px);
    box-shadow: var(--shadow-bevel-floating);
  }

  .ct-cta__picture {
    display: contents;
  }

  .ct-cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
  }

  .ct-cta__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.78) 0%, rgba(1, 3, 7, 0.42) 50%, rgba(1, 3, 7, 0.06) 100%),
      radial-gradient(circle at 18% 50%, rgba(72, 200, 255, 0.14), transparent 65%);
  }

  .ct-cta__content {
    position: relative;
    z-index: 1;
    max-width: 520px;
  }

  .ct-cta__title {
    margin: 14px 0 16px;
    font-family: var(--font-family-display);
    font-size: clamp(2.1rem, 3.8vw, 3.1rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ct-cta__desc {
    margin: 0 0 28px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ct-why {
    padding: clamp(64px, 8vw, 110px) 0 clamp(80px, 10vw, 128px);
    background-color: var(--color-void);
  }

  .ct-why__header {
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .ct-why__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ct-why__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .ct-why__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 4.4;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring), border-color var(--duration-fast) ease;
  }

  .ct-why__card:hover {
    transform: translateY(-4px);
    border-color: rgba(72, 200, 255, 0.42);
  }

  .ct-why__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ct-why__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ct-why__card:hover .ct-why__media img {
    transform: scale(1.04);
  }

  .ct-why__media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 3, 7, 0.05) 35%, rgba(1, 3, 7, 0.72) 72%, rgba(1, 3, 7, 0.94) 100%);
  }

  .ct-why__footer {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-white);
    text-shadow: 0 2px 12px rgba(1, 3, 7, 0.8);
    transition: color var(--duration-fast) ease;
  }

  .ct-why__card:hover .ct-why__footer {
    color: var(--color-brand-cyan);
  }

  .ct-why__label {
    font-family: var(--font-family-body);
    font-size: 1.02rem;
    font-weight: 600;
  }

  .ct-why__footer svg {
    color: var(--color-brand-cyan);
    transition: transform var(--duration-fast) ease;
  }

  .ct-why__card:hover .ct-why__footer svg {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .ct-why__grid {
      grid-template-columns: 1fr;
    }

    .ct-cta__banner {
      padding: 32px 24px;
    }

    .ct-cta__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.86) 0%, rgba(1, 3, 7, 0.95) 100%);
    }
  }
</style>
