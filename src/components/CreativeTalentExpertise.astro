---
// CreativeTalentExpertise.astro - Sections 5, 6 & 7: Full-stack expertise, Fully managed, Hassle-free help
const expertiseList = [
  "Brand and visual identity",
  "UX/UI, product, and web design",
  "Design systems and component libraries",
  "Motion, video, and interactive content",
  "Campaign, lifecycle, and performance creative",
  "Copywriting and creative concepting",
];
---

<!-- Section 5: Full-stack expertise -->
<section class="ct-spectrum" id="full-stack-expertise" aria-labelledby="ct-spectrum-title">
  <div class="container">
    <div class="ct-spectrum__panel" data-ct-reveal="scale">
      <picture class="ct-spectrum__picture">
        <source media="(max-width: 768px)" srcset="/images/our-creative-talent/full-stack-expertise-mobile.jpg" />
        <img
          src="/images/our-creative-talent/full-stack-expertise-desktop.jpg"
          alt="Adaptif creative specialists collaborating across disciplines"
          class="ct-spectrum__bg"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="ct-spectrum__scrim" aria-hidden="true"></div>

      <div class="ct-spectrum__content">
        <p class="adaptif-eyebrow" data-ct-reveal style="--ct-delay: 80ms">Full-stack expertise</p>
        <h2 id="ct-spectrum-title" class="ct-spectrum__title" data-ct-reveal style="--ct-delay: 140ms">
          Partner with specialists across <span class="title-highlight">the creative spectrum</span>
        </h2>
        <p class="ct-spectrum__desc" data-ct-reveal style="--ct-delay: 200ms">
          Modern brands need more than “a designer.” They need a bench of people who can think across channels, formats, and funnels.
        </p>

        <p class="ct-spectrum__sublabel" data-ct-reveal style="--ct-delay: 240ms">We cover 20+ services across:</p>
        <ul class="ct-spectrum__list">
          {expertiseList.map((item, idx) => (
            <li data-ct-reveal style={`--ct-delay: ${280 + idx * 55}ms`}>
              <span class="ct-spectrum__dot" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Section 6: Fully managed -->
<section class="ct-split" id="fully-managed" aria-labelledby="ct-managed-title">
  <div class="container">
    <div class="ct-split__grid">
      <div class="ct-mosaic" aria-hidden="true">
        <div class="ct-mosaic__tile" data-ct-reveal="scale" style="--ct-delay: 0ms">
          <img src="/images/why-us/creative-talent.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="ct-mosaic__tile" data-ct-reveal="scale" style="--ct-delay: 80ms">
          <img src="/images/designed-to-keep-up/card-2-talent.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="ct-mosaic__tile" data-ct-reveal="scale" style="--ct-delay: 160ms">
          <img src="/images/why-us/ai-excellence.jpg" alt="" loading="lazy" decoding="async" />
        </div>
        <div class="ct-mosaic__tile ct-mosaic__tile--brand" data-ct-reveal="scale" style="--ct-delay: 240ms">
          <img src="/images/why-us/our-technology.jpg" alt="" class="ct-mosaic__brand-bg" loading="lazy" decoding="async" />
          <span class="ct-mosaic__mark">a</span>
        </div>
      </div>

      <div class="ct-split__body" data-ct-reveal style="--ct-delay: 120ms">
        <p class="adaptif-eyebrow">Fully managed</p>
        <h2 id="ct-managed-title" class="ct-split__title">
          Strong creative needs <span class="title-highlight">strong project management</span>
        </h2>
        <p class="ct-split__text">
          You’ll partner with a core team—Creative Direction, Design, and Delivery—who keep strategy, timelines, and execution aligned. They manage scope, communication, and priorities so you don’t have to play traffic controller between multiple vendors.
        </p>
        <p class="ct-split__text ct-split__text--muted">
          No more chasing updates, guessing who owns what, or stitching together disconnected teams.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Section 7: Hassle-free help -->
<section class="ct-split ct-split--alt" id="hassle-free-help" aria-labelledby="ct-capacity-title">
  <div class="container">
    <div class="ct-split__grid ct-split__grid--reverse">
      <div class="ct-split__body" data-ct-reveal>
        <p class="adaptif-eyebrow">Hassle-free help</p>
        <h2 id="ct-capacity-title" class="ct-split__title">
          Senior creative capacity, <span class="title-highlight">without the hiring cycle</span>
        </h2>
        <p class="ct-split__text">
          Adaptif Lab is drastically faster than recruiting, interviewing, and onboarding a full internal team. Our onboarding process immerses us in your product, brand, and roadmap quickly, so we can start shipping meaningful work in days, not months.
        </p>
        <p class="ct-split__text ct-split__text--muted">
          You get the impact of a seasoned team, with the flexibility of a partner you can dial up or down as the business changes.
        </p>
      </div>

      <div class="ct-split__visual" data-ct-reveal="scale" style="--ct-delay: 140ms">
        <picture>
          <source media="(max-width: 768px)" srcset="/images/our-creative-talent/hassle-free-help-mobile.jpg" />
          <img
            src="/images/our-creative-talent/hassle-free-help-desktop.jpg"
            alt="Fast creative momentum without hiring cycles"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <div class="ct-split__visual-scrim" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .ct-spectrum {
    padding: clamp(40px, 5vw, 72px) 0;
    background-color: var(--color-void);
  }

  .ct-spectrum__panel {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    min-height: 520px;
    display: flex;
    align-items: center;
    padding: clamp(36px, 5.5vw, 68px);
    box-shadow: var(--shadow-bevel-card);
  }

  .ct-spectrum__picture,
  .ct-split__visual picture {
    display: contents;
  }

  .ct-spectrum__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
  }

  .ct-spectrum__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.78) 0%, rgba(1, 3, 7, 0.44) 50%, rgba(1, 3, 7, 0.06) 100%),
      radial-gradient(circle at 25% 40%, rgba(72, 200, 255, 0.1), transparent 65%);
  }

  .ct-spectrum__content {
    position: relative;
    z-index: 1;
    max-width: 540px;
  }

  .ct-spectrum__title {
    margin: 14px 0 18px;
    font-family: var(--font-family-display);
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ct-spectrum__desc {
    margin: 0 0 26px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ct-spectrum__sublabel {
    margin: 0 0 14px;
    font-family: var(--font-family-body);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .ct-spectrum__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ct-spectrum__list li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .ct-spectrum__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-cyan);
    box-shadow: 0 0 10px var(--color-cyan-glow);
    flex-shrink: 0;
  }

  .ct-split {
    padding: clamp(64px, 8vw, 110px) 0;
    background-color: var(--color-void);
  }

  .ct-split--alt {
    padding-top: clamp(24px, 4vw, 48px);
  }

  .ct-split__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(36px, 6vw, 76px);
    align-items: center;
    max-width: 1040px;
    margin: 0 auto;
  }

  .ct-mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .ct-mosaic__tile {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--color-obsidian-900);
  }

  .ct-mosaic__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ct-mosaic__tile--brand {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(72, 200, 255, 0.32), rgba(14, 28, 66, 0.9));
    border-color: rgba(72, 200, 255, 0.35);
  }

  .ct-mosaic__brand-bg {
    position: absolute;
    inset: 0;
    opacity: 0.25;
  }

  .ct-mosaic__mark {
    position: relative;
    z-index: 1;
    font-family: var(--font-family-display);
    font-style: italic;
    font-size: clamp(4.5rem, 7vw, 6rem);
    line-height: 1;
    color: var(--color-text-white);
    text-shadow: 0 0 28px rgba(72, 200, 255, 0.7);
  }

  .ct-split__title {
    margin: 14px 0 20px;
    font-family: var(--font-family-display);
    font-size: clamp(2.1rem, 3.8vw, 3.1rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ct-split__text {
    margin: 0 0 16px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ct-split__text--muted {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  .ct-split__visual {
    position: relative;
    aspect-ratio: 4 / 3.4;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-bevel-card);
  }

  .ct-split__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ct-split__visual-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 3, 7, 0.08) 0%, rgba(1, 3, 7, 0.45) 100%);
  }

  @media (max-width: 860px) {
    .ct-split__grid {
      grid-template-columns: 1fr;
    }

    .ct-split__grid--reverse .ct-split__visual {
      order: -1;
    }

    .ct-spectrum__panel {
      padding: 32px 24px;
    }

    .ct-spectrum__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.86) 0%, rgba(1, 3, 7, 0.95) 100%);
    }
  }
</style>
