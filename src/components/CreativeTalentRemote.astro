---
// CreativeTalentRemote.astro - Section 3: Easy & hassle-free
const remoteHighlights = [
  {
    icon: "globe",
    text: "Talent across 10+ countries (and counting)",
  },
  {
    icon: "clock",
    text: "Production hubs in key time zones for web, product, and content",
  },
  {
    icon: "layers",
    text: "Built for async collaboration, documentation, and fast feedback",
  },
];
---

<section class="ct-remote" id="easy-hassle-free" aria-labelledby="ct-remote-title">
  <div class="container">
    <div class="ct-remote__panel" data-ct-reveal="scale">
      <picture class="ct-remote__picture">
        <source media="(max-width: 768px)" srcset="/images/our-creative-talent/easy-hassle-free-mobile.jpg" />
        <img
          src="/images/our-creative-talent/easy-hassle-free-desktop.jpg"
          alt="Adaptif creative specialist working across global time zones"
          class="ct-remote__bg"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="ct-remote__scrim" aria-hidden="true"></div>

      <div class="ct-remote__content">
        <p class="adaptif-eyebrow" data-ct-reveal style="--ct-delay: 80ms">Easy &amp; hassle-free</p>
        <h2 id="ct-remote-title" class="ct-remote__title" data-ct-reveal style="--ct-delay: 140ms">
          Every type of creative work you’ll ever need, <span class="title-highlight">and more.</span>
        </h2>
        <p class="ct-remote__desc" data-ct-reveal style="--ct-delay: 200ms">
          We’re remote from day one, which means we hire for craft and mindset, not postcode. Our team spans Latin America, Europe and beyond, giving you near-continuous momentum on your projects.
        </p>

        <ul class="ct-remote__list">
          {remoteHighlights.map((item, idx) => (
            <li class="ct-remote__item" data-ct-reveal style={`--ct-delay: ${260 + idx * 80}ms`}>
              <span class="ct-remote__icon" aria-hidden="true">
                {item.icon === "globe" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                )}
                {item.icon === "clock" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                )}
                {item.icon === "layers" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2" />
                    <polyline points="2 17 12 22 22 17" />
                    <polyline points="2 12 12 17 22 12" />
                  </svg>
                )}
              </span>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .ct-remote {
    padding: clamp(48px, 6vw, 84px) 0;
    background-color: var(--color-void);
  }

  .ct-remote__panel {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    min-height: 500px;
    display: flex;
    align-items: center;
    padding: clamp(36px, 5.5vw, 68px);
    box-shadow: var(--shadow-bevel-card);
  }

  .ct-remote__picture {
    display: contents;
  }

  .ct-remote__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.92;
  }

  .ct-remote__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.78) 0%, rgba(1, 3, 7, 0.45) 48%, rgba(1, 3, 7, 0.06) 100%),
      radial-gradient(circle at 20% 50%, rgba(72, 200, 255, 0.1), transparent 65%);
  }

  .ct-remote__content {
    position: relative;
    z-index: 1;
    max-width: 560px;
  }

  .ct-remote__title {
    margin: 14px 0 18px;
    font-family: var(--font-family-display);
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ct-remote__desc {
    margin: 0 0 30px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ct-remote__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ct-remote__item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(8, 18, 44, 0.68);
    backdrop-filter: var(--glass-blur-sm);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .ct-remote__icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    color: var(--color-brand-cyan);
    background: rgba(72, 200, 255, 0.12);
    border: 1px solid rgba(72, 200, 255, 0.24);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .ct-remote__panel {
      padding: 32px 24px;
    }

    .ct-remote__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.86) 0%, rgba(1, 3, 7, 0.94) 100%);
    }
  }
</style>
