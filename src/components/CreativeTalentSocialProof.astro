---
// CreativeTalentSocialProof.astro - Section 2: Creative excellence (Metrics & Testimonials)
---

<section class="ct-proof" id="creative-excellence" aria-labelledby="ct-proof-title">
  <div class="ct-proof__glow" aria-hidden="true"></div>
  <canvas class="ct-proof__canvas" id="ct-proof-glow-canvas" aria-hidden="true"></canvas>

  <div class="container ct-proof__container">
    <header class="ct-proof__header" data-ct-reveal>
      <p class="adaptif-eyebrow">Creative excellence</p>
      <h2 id="ct-proof-title" class="ct-proof__title">
        The engine behind fast <span class="title-highlight">moving brands</span>
      </h2>
    </header>

    <div class="ct-proof__grid">
      <!-- Row 1: 99% Metric + Kayla Parker Testimonial -->
      <div class="ct-proof__metric" data-ct-reveal style="--ct-delay: 60ms">
        <div class="ct-proof__number" data-ct-count="99" data-ct-suffix="%">99%</div>
        <p class="ct-proof__metric-desc">
          of projects are delivered on time or ahead of schedule, so you can launch when the rest of the business is ready.
        </p>
      </div>

      <blockquote class="glass-panel ct-proof__quote" data-ct-reveal="scale" style="--ct-delay: 140ms">
        <p class="ct-proof__quote-text">
          “Adaptif is the creative team our own designers lean on—the kind of partner you can trust with complex, brand-sensitive work.”
        </p>
        <footer class="ct-proof__author">
          <div class="ct-proof__avatar" aria-hidden="true">KP</div>
          <div>
            <cite class="ct-proof__author-name">Kayla Parker</cite>
            <span class="ct-proof__author-role">Brand Design Manager</span>
          </div>
        </footer>
      </blockquote>

      <!-- Row 2: Myriam Malinge Testimonial + 92% Metric -->
      <blockquote class="glass-panel ct-proof__quote" data-ct-reveal="scale" style="--ct-delay: 180ms">
        <p class="ct-proof__quote-text">
          “For us it was key to find a partner like Adaptif — a team we can rely on to bring smart creative to the table and still hit aggressive timelines.”
        </p>
        <footer class="ct-proof__author">
          <div class="ct-proof__avatar" aria-hidden="true">MM</div>
          <div>
            <cite class="ct-proof__author-name">Myriam Malinge</cite>
            <span class="ct-proof__author-role">Head of Marketing · Babolat</span>
          </div>
        </footer>
      </blockquote>

      <div class="ct-proof__metric" data-ct-reveal style="--ct-delay: 240ms">
        <div class="ct-proof__number" data-ct-count="92" data-ct-suffix="%">92%</div>
        <p class="ct-proof__metric-desc">
          of our clients say the final work goes beyond what they initially imagined for the brief.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .ct-proof {
    position: relative;
    padding: clamp(72px, 9vw, 120px) 0;
    background-color: var(--color-void);
    overflow: hidden;
  }

  .ct-proof__glow {
    position: absolute;
    top: 56%;
    left: 50%;
    width: min(920px, 95vw);
    height: 540px;
    transform: translate(-50%, -50%);
    background:
      radial-gradient(ellipse 36% 32% at 62% 34%, rgba(255, 204, 0, 0.32) 0%, rgba(249, 6, 44, 0.34) 42%, transparent 74%),
      radial-gradient(ellipse 38% 34% at 38% 68%, rgba(255, 138, 0, 0.32) 0%, rgba(249, 6, 44, 0.36) 44%, transparent 76%);
    filter: blur(28px);
    pointer-events: none;
  }

  .ct-proof__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .ct-proof__container {
    position: relative;
    z-index: 1;
  }

  .ct-proof__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(48px, 6vw, 72px);
  }

  .ct-proof__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ct-proof__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    max-width: 980px;
    margin: 0 auto;
    align-items: stretch;
  }

  .ct-proof__metric {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 36px 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ct-proof__number {
    font-family: var(--font-family-display);
    font-size: clamp(3.5rem, 5.5vw, 4.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--color-text-white) 0%, var(--color-brand-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 14px;
  }

  .ct-proof__metric-desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(248, 250, 252, 0.92);
    text-shadow: 0 1px 14px rgba(1, 3, 7, 0.85);
    max-width: 360px;
  }

  .ct-proof__quote {
    margin: 0;
    padding: 34px 32px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.28),
      0 18px 42px -12px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .ct-proof__quote-text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 1.06rem;
    line-height: 1.65;
    color: var(--color-text-white);
    text-shadow: 0 1px 10px rgba(1, 3, 7, 0.55);
  }

  .ct-proof__author {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ct-proof__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-family-body);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-text-white);
    background: rgba(1, 3, 7, 0.38);
    border: 1px solid rgba(255, 255, 255, 0.26);
    flex-shrink: 0;
  }

  .ct-proof__author-name {
    display: block;
    font-style: normal;
    font-family: var(--font-family-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .ct-proof__author-role {
    display: block;
    font-family: var(--font-family-body);
    font-size: 0.84rem;
    color: rgba(248, 250, 252, 0.82);
    margin-top: 2px;
  }

  @media (max-width: 820px) {
    .ct-proof__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ct-proof__metric {
      padding: 26px 8px;
    }
  }
</style>

<script>
  import * as THREE from "three";

  const initProofRedLight = () => {
    const section = document.getElementById("creative-excellence");
    const canvas = document.getElementById("ct-proof-glow-canvas") as HTMLCanvasElement | null;
    if (!section || !canvas || canvas.dataset.ctInit === "1") return;
    canvas.dataset.ctInit = "1";

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: "low-power" });
    } catch {
      return;
    }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.5));
    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    const uniforms = {
      uTime: { value: 0 },
      uRes: { value: new THREE.Vector2(section.clientWidth || 1200, section.clientHeight || 700) },
    };

    const material = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      uniforms,
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        precision highp float;
        varying vec2 vUv;
        uniform float uTime;
        uniform vec2 uRes;

        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
        }

        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(
            mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
            mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
            u.y
          );
        }

        float fbm(vec2 p) {
          float v = 0.0;
          float a = 0.5;
          mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
          for (int i = 0; i < 4; i++) {
            v += a * noise(p);
            p = rot * p * 2.05;
            a *= 0.5;
          }
          return v;
        }

        vec3 heatPalette(float h) {
          vec3 deepRed   = vec3(0.55, 0.01, 0.08);
          vec3 brandRed  = vec3(0.97647, 0.02353, 0.17255); // #F9062C
          vec3 warmAmber = vec3(1.0, 0.42, 0.02);
          vec3 hotYellow = vec3(1.0, 0.86, 0.12);

          vec3 col = mix(deepRed, brandRed, smoothstep(0.05, 0.42, h));
          col = mix(col, warmAmber, smoothstep(0.40, 0.72, h));
          col = mix(col, hotYellow, smoothstep(0.70, 0.98, h));
          return col;
        }

        void main() {
          vec2 uv = vUv;
          float aspect = uRes.x / max(uRes.y, 1.0);
          vec2 p = vec2((uv.x - 0.5) * aspect, uv.y - 0.58);

          float t = uTime * 0.35;

          // Domain warping for abstract fluid heatmap contours
          vec2 q = vec2(
            fbm(p * 2.4 + vec2(t * 0.4, -t * 0.3)),
            fbm(p * 2.4 + vec2(-t * 0.3, t * 0.45) + vec2(5.2, 1.3))
          );
          vec2 warped = p + (q - 0.5) * 0.24;

          // Tighter drifting thermal focal zones behind the two glass cards
          vec2 c1 = vec2(0.22 * aspect + sin(t * 0.9) * 0.07, 0.12 + cos(t * 0.7) * 0.04);
          vec2 c2 = vec2(-0.22 * aspect + cos(t * 0.8) * 0.07, -0.14 + sin(t * 0.85) * 0.04);

          float d1 = length(warped - c1);
          float d2 = length(warped - c2);

          float heat =
            exp(-d1 * d1 * 10.5) * (0.9 + 0.12 * sin(t * 1.3)) +
            exp(-d2 * d2 * 10.0) * (0.9 + 0.12 * cos(t * 1.1));

          // Subtle abstract thermal bands
          heat += (fbm(warped * 4.2 - vec2(t * 0.25)) - 0.48) * 0.22 * smoothstep(0.65, 0.1, min(d1, d2));
          heat = clamp(heat, 0.0, 1.0);

          // Keep heading clear & fade softly at section bounds
          float edge = smoothstep(0.02, 0.22, uv.y) * smoothstep(0.84, 0.62, uv.y)
                     * smoothstep(0.02, 0.16, uv.x) * smoothstep(0.98, 0.84, uv.x);

          vec3 col = heatPalette(heat);
          float alpha = smoothstep(0.04, 0.82, heat) * 0.46 * edge;
          gl_FragColor = vec4(col, alpha);
        }
      `,
    });

    const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);
    scene.add(mesh);

    // Hide static CSS fallback once WebGL is active
    const cssFallback = section.querySelector<HTMLElement>(".ct-proof__glow");
    if (cssFallback) cssFallback.style.opacity = "0";

    const resize = () => {
      const w = section.clientWidth;
      const h = section.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      uniforms.uRes.value.set(w, h);
    };
    resize();

    const ro = new ResizeObserver(resize);
    ro.observe(section);

    let rafId = 0;
    let visible = false;
    const start = performance.now();

    const renderFrame = (now: number) => {
      if (!visible) return;
      uniforms.uTime.value = (now - start) * 0.001;
      renderer.render(scene, camera);
      rafId = requestAnimationFrame(renderFrame);
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) {
          cancelAnimationFrame(rafId);
          rafId = requestAnimationFrame(renderFrame);
        } else {
          cancelAnimationFrame(rafId);
        }
      },
      { threshold: 0.05 }
    );
    io.observe(section);
  };

  initProofRedLight();
  document.addEventListener("astro:page-load", initProofRedLight);
</script>
