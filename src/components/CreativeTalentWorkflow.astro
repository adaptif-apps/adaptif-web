---
// CreativeTalentWorkflow.astro - Section 4: How we work with you (5-step editorial process)
const processSteps = [
  {
    number: "1",
    eyebrow: "FLEXIBLE",
    title: "Endless extra pairs of hands",
    description:
      "Our unique model means you get access to a modular team, which can effortlessly scale up or down to meet your needs, whether you need bandwidth or a specialist skill.",
  },
  {
    number: "2",
    eyebrow: "ULTRA-FAST",
    title: "Designed for speed",
    description:
      "We leverage our team’s time zones to meet even the tightest timeline. 98% of projects are delivered on or before the deadline.",
  },
  {
    number: "3",
    eyebrow: "READY FOR THE FUTURE",
    title: "AI-enhanced",
    description:
      "Almost 100% of Adaptif creatives are AI-certified so they can move faster while ensuring alignment with brand and brief. In 2024, we delivered 3000+ AI-enhanced projects, saving our customers over $3.5M in costs.",
  },
  {
    number: "4",
    eyebrow: "CENTRALIZED",
    title: "Workspace: our platform for briefs, feedback, and asset delivery",
    description:
      "A single, streamlined hub where creative collaboration happens. Workspace reduces feedback loops by 30%, keeping projects moving efficiently.",
  },
  {
    number: "5",
    eyebrow: "COLLABORATIVE",
    title: "One consistent team",
    description:
      "No hand-offs, delays, or resourcing guesswork. You’ll work with a team that knows your brand inside out and who is used to working with each other, minimizing friction and maximizing creative impact.",
  },
];
---

<section class="ct-workflow" id="how-we-work" aria-labelledby="ct-workflow-title">
  <div class="container">
    <div class="ct-workflow__layout">
      <div class="ct-workflow__intro" data-ct-reveal>
        <p class="adaptif-eyebrow">How we work with you</p>
        <h2 id="ct-workflow-title" class="ct-workflow__title">
          A process built to give your brand <span class="title-highlight">the support it deserves</span>
        </h2>
        <p class="ct-workflow__desc">
          Finding the best people is just the first step. Our process is equally delightful—from onboarding to delivery, we make collaboration seamless.
        </p>
        <div class="ct-workflow__cta">
          <a href="#book-a-call" class="adaptif-btn" data-open-book-call>
            <span>Book a Call</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>

      <ul class="ct-workflow__steps">
        {processSteps.map((step, idx) => (
          <li class="ct-workflow__step" data-ct-reveal style={`--ct-delay: ${idx * 70}ms`}>
            <p class="adaptif-eyebrow ct-workflow__step-eyebrow">{step.eyebrow}</p>
            <h3 class="ct-workflow__step-title">{step.title}</h3>
            <p class="ct-workflow__step-desc">{step.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ct-workflow {
    padding: clamp(72px, 9vw, 120px) 0;
    background-color: var(--color-void);
  }

  .ct-workflow__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .ct-workflow__intro {
    position: sticky;
    top: 120px;
  }

  .ct-workflow__title {
    margin: 14px 0 20px;
    font-family: var(--font-family-display);
    font-size: clamp(2.15rem, 3.8vw, 3.2rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .ct-workflow__desc {
    margin: 0 0 32px;
    max-width: 440px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .ct-workflow__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ct-workflow__step {
    padding: 28px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ct-workflow__step-eyebrow {
    font-size: 0.74rem;
    margin-bottom: 10px;
  }

  /* Body font required for headings <= 24px per design-system rule */
  .ct-workflow__step-title {
    margin: 0 0 10px;
    font-family: var(--font-family-body);
    font-size: 1.32rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-primary);
  }

  .ct-workflow__step-desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .ct-workflow__layout {
      grid-template-columns: 1fr;
    }

    .ct-workflow__intro {
      position: static;
    }
  }
</style>
