---
// DedicatedTeamHero.astro - Full-bleed Hero for the Dedicated Team page
---

<section class="dt-hero" id="dedicated-team-hero" aria-labelledby="dt-hero-title">
  <!-- Background Image & Atmospheric Scrims -->
  <div class="dt-hero__media" aria-hidden="true">
    <img
      src="/images/dedicated-team/hero-bg.jpg"
      alt=""
      class="dt-hero__bg-img"
      loading="eager"
      decoding="async"
    />
    <div class="dt-hero__scrim"></div>
    <div class="dt-hero__bottom-fade"></div>
  </div>

  <div class="container dt-hero__container">
    <div class="dt-hero__content">
      <!-- Eyebrow -->
      <div class="dt-hero__eyebrow">
        <span class="dt-hero__dot" aria-hidden="true"></span>
        <span>Dedicated Creative Team</span>
      </div>

      <!-- Title -->
      <h1 id="dt-hero-title" class="dt-hero__title">
        Your full-time creative team,
        <span class="title-highlight dt-hero__title-accent">on retainer</span>
      </h1>

      <!-- Description -->
      <p class="dt-hero__description">
        Skip the hiring process. Get a complete creative department, designers, strategists, producers, ready to ship on day one.
      </p>

      <!-- Call to Actions -->
      <div class="dt-hero__cta-group">
        <a href="#contact" class="adaptif-btn dt-hero__cta-primary">
          <span>Get Started</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <a href="/pricing" class="dt-hero__cta-secondary">
          <span>See Pricing</span>
          <span class="dt-hero__cta-secondary-glow" aria-hidden="true"></span>
        </a>
      </div>

      <!-- Statistics Strip -->
      <div class="dt-hero__stats" role="list" aria-label="Key metrics">
        <div class="dt-stat" role="listitem">
          <span class="dt-stat__value">500+</span>
          <span class="dt-stat__label">Brands served</span>
        </div>
        <div class="dt-stat__divider" aria-hidden="true"></div>
        <div class="dt-stat" role="listitem">
          <span class="dt-stat__value">48hr</span>
          <span class="dt-stat__label">Avg. turnaround</span>
        </div>
        <div class="dt-stat__divider" aria-hidden="true"></div>
        <div class="dt-stat" role="listitem">
          <span class="dt-stat__value">Pause</span>
          <span class="dt-stat__label">Anytime, always</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dt-hero {
    position: relative;
    min-height: 100dvh;
    padding-top: calc(var(--header-height) + clamp(36px, 6vh, 72px));
    padding-bottom: clamp(56px, 8vh, 96px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-void, #010307);
  }

  .dt-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .dt-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    display: block;
  }

  .dt-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        95deg,
        rgba(1, 3, 7, 0.94) 0%,
        rgba(1, 3, 7, 0.84) 36%,
        rgba(1, 3, 7, 0.45) 62%,
        rgba(1, 3, 7, 0.14) 100%
      ),
      linear-gradient(
        180deg,
        rgba(1, 3, 7, 0.62) 0%,
        rgba(1, 3, 7, 0.08) 28%,
        rgba(1, 3, 7, 0.25) 100%
      );
  }

  .dt-hero__bottom-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: clamp(120px, 18vh, 220px);
    background: linear-gradient(
      to top,
      var(--color-void, #010307) 0%,
      rgba(1, 3, 7, 0.72) 45%,
      transparent 100%
    );
  }

  .dt-hero__container {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .dt-hero__content {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Eyebrow Pill */
  .dt-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: rgba(6, 15, 38, 0.68);
    backdrop-filter: var(--glass-blur-sm);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    border: 1px solid rgba(72, 200, 255, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 8px 24px -6px rgba(0, 0, 0, 0.55);
    margin-bottom: clamp(18px, 2.5vh, 26px);
    animation: dtFadeInDown 0.75s var(--ease-spring) both;
  }

  .dt-hero__eyebrow span:last-child {
    font-size: var(--font-size-badge, 0.82rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    color: #e2e8f0;
  }

  .dt-hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-brand-cyan, #48C8FF);
    box-shadow: 0 0 10px rgba(72, 200, 255, 0.9);
    flex-shrink: 0;
  }

  /* Title */
  .dt-hero__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.85rem, 5.4vw + 0.5rem, 5.25rem);
    line-height: 1.02;
    letter-spacing: var(--font-letter-spacing-display, -0.04em);
    font-weight: 400;
    color: var(--color-text-white, #ffffff);
    margin-bottom: clamp(16px, 2.2vh, 24px);
    text-wrap: balance;
    animation: dtFadeInUp 0.85s var(--ease-spring) 0.06s both;
  }

  .dt-hero__title-accent {
    font-style: italic;
    padding-right: 0.06em;
  }

  /* Description */
  .dt-hero__description {
    font-size: var(--font-size-subhero);
    line-height: var(--font-line-height-subhero);
    letter-spacing: var(--font-letter-spacing-subhero);
    color: rgba(226, 232, 240, 0.86);
    max-width: 540px;
    font-weight: 400;
    margin-bottom: clamp(26px, 3.6vh, 38px);
    animation: dtFadeInUp 0.85s var(--ease-spring) 0.14s both;
  }

  /* CTAs */
  .dt-hero__cta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: clamp(32px, 4.8vh, 52px);
    animation: dtFadeInUp 0.85s var(--ease-spring) 0.22s both;
  }

  .dt-hero__cta-primary {
    padding: 14px 30px;
    font-size: var(--font-size-btn);
  }

  .dt-hero__cta-secondary {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    background: rgba(10, 20, 48, 0.52);
    backdrop-filter: var(--glass-blur-sm);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    border: 1px solid rgba(72, 200, 255, 0.35);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.15),
      0 0 20px -5px rgba(72, 200, 255, 0.15),
      0 8px 24px -6px rgba(0, 0, 0, 0.6);
    color: #e2e8f0;
    font-size: var(--font-size-btn);
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow: hidden;
    transition:
      transform var(--duration-fast) var(--ease-spring),
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .dt-hero__cta-secondary:hover {
    transform: translateY(-2px);
    border-color: rgba(72, 200, 255, 0.72);
    background: rgba(14, 28, 66, 0.72);
    color: #ffffff;
  }

  .dt-hero__cta-secondary-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(72, 200, 255, 0.22) 0%, transparent 70%);
    opacity: 0;
    transition: opacity var(--duration-fast) ease;
    pointer-events: none;
  }

  .dt-hero__cta-secondary:hover .dt-hero__cta-secondary-glow {
    opacity: 1;
  }

  /* Statistics Strip */
  .dt-hero__stats {
    display: inline-flex;
    align-items: center;
    gap: clamp(18px, 3vw, 32px);
    padding: 18px clamp(20px, 3vw, 30px);
    border-radius: var(--radius-lg, 20px);
    background: rgba(4, 9, 26, 0.62);
    backdrop-filter: var(--glass-blur-md);
    -webkit-backdrop-filter: var(--glass-blur-md);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 18px 40px -12px rgba(0, 0, 0, 0.75);
    animation: dtFadeInUp 0.9s var(--ease-spring) 0.3s both;
  }

  .dt-stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .dt-stat__value {
    font-family: var(--font-family-display);
    font-size: clamp(1.65rem, 2.3vw, 2.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #ffffff;
    font-weight: 400;
  }

  .dt-stat__label {
    font-size: 0.82rem;
    line-height: 1.3;
    color: var(--color-text-secondary, #94a3b8);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .dt-stat__divider {
    width: 1px;
    height: 36px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 255, 255, 0.18) 50%,
      transparent 100%
    );
    flex-shrink: 0;
  }

  @keyframes dtFadeInDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes dtFadeInUp {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .dt-hero__bg-img {
      object-position: 68% center;
    }

    .dt-hero__scrim {
      background:
        linear-gradient(
          180deg,
          rgba(1, 3, 7, 0.84) 0%,
          rgba(1, 3, 7, 0.72) 55%,
          rgba(1, 3, 7, 0.92) 100%
        );
    }
  }

  @media (max-width: 600px) {
    .dt-hero__cta-group {
      width: 100%;
    }

    .dt-hero__cta-primary,
    .dt-hero__cta-secondary {
      flex: 1 1 auto;
      justify-content: center;
    }

    .dt-hero__stats {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 16px;
    }

    .dt-stat__label {
      font-size: 0.74rem;
      white-space: normal;
    }
  }
</style>
