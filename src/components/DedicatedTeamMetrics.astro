---
// DedicatedTeamMetrics.astro - Light-mode typographic metrics pause with one-time count-up
import { dedicatedTeamMetrics } from "../data/dedicatedTeamMetrics";
---

<section
  class="dt-metrics"
  id="team-metrics"
  data-theme="light"
  aria-label="Adaptif track record and delivery metrics"
>
  <div class="dt-metrics__ambient" aria-hidden="true"></div>

  <div class="container dt-metrics__container">
    <div class="dt-metrics__intro">
      <span class="dt-metrics__eyebrow">BY THE NUMBERS</span>
    </div>

    <dl class="dt-metrics__grid">
      {dedicatedTeamMetrics.map((metric, idx) => (
        <div
          class="dt-metric reveal-metric"
          style={`--metric-delay: ${idx * 70}ms;`}
        >
          <dt class="dt-metric__label">{metric.label}</dt>
          <dd
            class="dt-metric__value"
            aria-label={`${metric.value}${metric.unit} ${metric.label}`}
          >
            <span
              class="dt-metric__num"
              data-count-target={metric.value}
              aria-hidden="true"
            >{metric.value}</span><span class="dt-metric__unit" aria-hidden="true">{metric.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  const initDedicatedTeamMetrics = () => {
    const section = document.getElementById("team-metrics");
    if (!section) return;

    const items = section.querySelectorAll<HTMLElement>(".reveal-metric");
    const counters = section.querySelectorAll<HTMLElement>("[data-count-target]");
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      items.forEach((item) => item.classList.add("is-visible"));
      counters.forEach((el) => {
        el.textContent = el.dataset.countTarget ?? el.textContent;
      });
      return;
    }

    let hasAnimated = false;

    const animateCounters = () => {
      if (hasAnimated) return;
      hasAnimated = true;

      const duration = 1100;
      const startTime = performance.now();

      const targets = Array.from(counters).map((el) => ({
        el,
        target: Number(el.dataset.countTarget || 0),
      }));

      // Initialize visual display to 0 at animation start
      targets.forEach(({ el }) => {
        el.textContent = "0";
      });

      const step = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // Ease-out cubic for smooth deceleration
        const eased = 1 - Math.pow(1 - progress, 3);

        targets.forEach(({ el, target }) => {
          const current = Math.round(eased * target);
          el.textContent = String(current);
        });

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          targets.forEach(({ el, target }) => {
            el.textContent = String(target);
          });
        }
      };

      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            items.forEach((item) => item.classList.add("is-visible"));
            animateCounters();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(section);
  };

  initDedicatedTeamMetrics();
  document.addEventListener("astro:page-load", initDedicatedTeamMetrics);
</script>

<style>
  .dt-metrics {
    position: relative;
    padding: clamp(72px, 10vw, 120px) 0;
    background: linear-gradient(180deg, #f5faff 0%, #eaf6fe 100%);
    overflow: hidden;
  }

  .dt-metrics__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 60% at 50% 0%,
      rgba(56, 189, 248, 0.12) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .dt-metrics__container {
    position: relative;
    z-index: 1;
  }

  .dt-metrics__intro {
    margin-bottom: clamp(24px, 3.5vw, 38px);
  }

  .dt-metrics__eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0284c7;
  }

  .dt-metrics__grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 0;
  }

  .dt-metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding-right: clamp(18px, 2.8vw, 36px);
    user-select: text;
  }

  .dt-metric + .dt-metric {
    padding-left: clamp(18px, 2.8vw, 36px);
    border-left: 1px solid rgba(15, 23, 42, 0.1);
  }

  .dt-metric__value {
    margin: 0;
    font-family: var(--font-family-display);
    font-size: clamp(3.1rem, 4.8vw, 4.6rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    font-weight: 400;
    color: #0b0f19;
    font-variant-numeric: tabular-nums;
  }

  .dt-metric__unit {
    color: #0284c7;
    font-style: italic;
    padding-left: 0.03em;
  }

  .dt-metric__label {
    font-size: 0.96rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #475569;
    font-weight: 500;
  }

  /* Subtle one-time reveal */
  .reveal-metric {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.45s ease var(--metric-delay, 0ms),
      transform 0.45s var(--ease-spring) var(--metric-delay, 0ms);
  }

  .reveal-metric.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-metric {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .dt-metrics__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 0;
    }

    .dt-metric:nth-child(odd) {
      padding-left: 0;
      border-left: none;
    }

    .dt-metric:nth-child(even) {
      padding-right: 0;
    }
  }

  @media (max-width: 520px) {
    .dt-metrics__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .dt-metric,
    .dt-metric + .dt-metric {
      padding-left: 0;
      padding-right: 0;
      border-left: none;
    }

    .dt-metric + .dt-metric {
      padding-top: 22px;
      border-top: 1px solid rgba(15, 23, 42, 0.1);
    }
  }
</style>
