---
// DedicatedTeamMetrics.astro - Open typographic metrics pause with one-time count-up
import { dedicatedTeamMetrics } from "../data/dedicatedTeamMetrics";
---

<section
  class="dt-metrics"
  id="team-metrics"
  aria-label="Adaptif track record and delivery metrics"
>
  <div class="container dt-metrics__container">
    <div class="dt-metrics__intro">
      <span class="dt-metrics__eyebrow">BY THE NUMBERS</span>
    </div>

    <dl class="dt-metrics__grid">
      {dedicatedTeamMetrics.map((metric, idx) => (
        <div
          class="dt-metric reveal-metric"
          style={`--metric-delay: ${idx * 70}ms;`}
        >
          <dt class="dt-metric__label">{metric.label}</dt>
          <dd class="dt-metric__value" aria-label={`${metric.value}${metric.unit} ${metric.label}`}>
            <span aria-hidden="true">
              <span
                class="dt-metric__num"
                data-target={metric.value}
              >{metric.value}</span><span class="dt-metric__unit">{metric.unit}</span>
            </span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  const initDedicatedTeamMetrics = () => {
    const section = document.getElementById("team-metrics");
    if (!section) return;

    const items = section.querySelectorAll<HTMLElement>(".reveal-metric");
    const numEls = section.querySelectorAll<HTMLElement>(".dt-metric__num");
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    let hasAnimated = false;

    const animateNumbers = () => {
      if (hasAnimated) return;
      hasAnimated = true;

      const duration = 1100;
      const startTime = performance.now();

      const step = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);

        numEls.forEach((el) => {
          const target = Number(el.dataset.target || "0");
          const current = Math.round(target * eased);
          el.textContent = String(current);
        });

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          numEls.forEach((el) => {
            el.textContent = el.dataset.target || "0";
          });
        }
      };

      numEls.forEach((el) => {
        el.textContent = "0";
      });
      requestAnimationFrame(step);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            items.forEach((item) => item.classList.add("is-visible"));
            animateNumbers();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(section);
  };

  initDedicatedTeamMetrics();
  document.addEventListener("astro:page-load", initDedicatedTeamMetrics);
</script>

<style>
  .dt-metrics {
    position: relative;
    padding: clamp(64px, 9vw, 112px) 0;
    background: var(--color-void, #010307);
  }

  .dt-metrics__container {
    position: relative;
    z-index: 1;
  }

  .dt-metrics__intro {
    margin-bottom: clamp(24px, 3.2vw, 36px);
  }

  .dt-metrics__eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-cyan, #48C8FF);
  }

  .dt-metrics__grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 0;
  }

  .dt-metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding-right: clamp(16px, 2.5vw, 32px);
    user-select: text;
  }

  .dt-metric + .dt-metric {
    padding-left: clamp(16px, 2.5vw, 32px);
    border-left: 1px solid rgba(255, 255, 255, 0.09);
  }

  .dt-metric__value {
    margin: 0;
    font-family: var(--font-family-display);
    font-size: clamp(3.1rem, 4.8vw, 4.6rem);
    line-height: 0.96;
    letter-spacing: -0.04em;
    font-weight: 400;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
  }

  .dt-metric__unit {
    color: var(--color-brand-cyan, #48C8FF);
    font-style: italic;
    padding-left: 0.03em;
  }

  .dt-metric__label {
    font-size: 0.96rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #cbd5e1;
    font-weight: 400;
  }

  /* Subtle one-time reveal */
  .reveal-metric {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.45s ease var(--metric-delay, 0ms),
      transform 0.45s var(--ease-spring) var(--metric-delay, 0ms);
  }

  .reveal-metric.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-metric {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .dt-metrics__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 0;
    }

    .dt-metric:nth-child(odd) {
      padding-left: 0;
      border-left: none;
    }

    .dt-metric:nth-child(even) {
      padding-right: 0;
    }
  }

  @media (max-width: 520px) {
    .dt-metrics__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .dt-metric,
    .dt-metric + .dt-metric {
      padding-left: 0;
      padding-right: 0;
      border-left: none;
    }

    .dt-metric + .dt-metric {
      padding-top: 22px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
  }
</style>
