---
// DedicatedTeamModel.astro - Infographic explanation of Adaptif's subscription model
interface Props {
  flexibilityTitle?: string;
  flexibilityDescription?: string;
}

const {
  flexibilityTitle = "Pause or cancel anytime",
  flexibilityDescription =
    "Your subscription adapts to your pipeline. Upgrade, downgrade, or pause between billing cycles when your workload shifts—without managing separate per-project agreements.",
} = Astro.props;

const disciplines = [
  { name: "Brand & Identity", code: "SYS-01", tags: ["Logos", "Guidelines", "Visual Systems"] },
  { name: "Product & Web", code: "SYS-02", tags: ["UI/UX", "Landing Pages", "Design Systems"] },
  { name: "Motion & 3D", code: "SYS-03", tags: ["Reels", "Lottie", "3D Assets"] },
  { name: "Creative Direction", code: "SYS-04", tags: ["Art Direction", "Campaigns", "Decks"] },
];

const timelineSteps = [
  { cycle: "Cycle 01", label: "Launch Sprint", state: "active", badge: "Active" },
  { cycle: "Cycle 02", label: "Scale Capacity", state: "upgrade", badge: "Upgrade" },
  { cycle: "Cycle 03", label: "Hold Between Launches", state: "paused", badge: "Paused $0" },
  { cycle: "Cycle 04", label: "Resume On Demand", state: "active", badge: "Resume" },
];
---

<section
  class="dt-model"
  id="subscription-model"
  aria-labelledby="dt-model-heading"
>
  <div class="container dt-model__container">
    <!-- Section Intro -->
    <header class="dt-model__header">
      <span class="dt-model__eyebrow">The model</span>

      <h2 id="dt-model-heading" class="dt-model__title">
        One subscription.
        <span class="title-highlight dt-model__title-accent">Everything your brand needs</span>
      </h2>

      <p class="dt-model__subtitle">
        A single creative relationship structured around clear scope, predictable billing, and a pace that moves with your roadmap.
      </p>
    </header>

    <!-- Infographic Blueprint Canvas -->
    <div class="dt-model__blueprint" role="region" aria-label="Adaptif subscription model infographic">
      <!-- Top Schematic Bar -->
      <div class="dt-model__bar" aria-hidden="true">
        <div class="dt-model__bar-left">
          <span class="dt-model__pulse-dot"></span>
          <span class="dt-model__bar-label">ADAPTIF SUBSCRIPTION ARCHITECTURE</span>
        </div>
        <div class="dt-model__bar-flow">
          <span class="dt-model__flow-pill">01 Scope</span>
          <span class="dt-model__flow-arrow">→</span>
          <span class="dt-model__flow-pill">02 Predictability</span>
          <span class="dt-model__flow-arrow">→</span>
          <span class="dt-model__flow-pill">03 Pace</span>
        </div>
      </div>

      <!-- Asymmetric Infographic Grid -->
      <div class="dt-model__grid">
        <!-- 01 · SCOPE: Hub-and-Spoke Discipline Convergence (7 cols) -->
        <article class="dt-model__module dt-model__module--scope reveal-model" style="--model-delay: 0ms;">
          <div class="dt-model__module-head">
            <span class="dt-model__tag">01 · Scope</span>
            <span class="dt-model__meta-pill">Zero vendor juggling</span>
          </div>

          <div class="dt-model__scope-layout">
            <div class="dt-model__copy-block">
              <h3 class="dt-model__module-title">One team. Every discipline.</h3>
              <p class="dt-model__module-copy">
                Access design, branding, motion, and web capabilities from a single working relationship, aligned with your chosen plan’s scope—no sourcing or coordinating separate vendors for every need.
              </p>
            </div>

            <!-- Visual Hub-and-Spoke Diagram -->
            <div class="dt-model__hub-diagram" aria-hidden="true">
              <div class="dt-model__hub-nodes">
                {disciplines.map((d) => (
                  <div class="dt-model__node">
                    <span class="dt-model__node-code">{d.code}</span>
                    <span class="dt-model__node-name">{d.name}</span>
                    <div class="dt-model__node-tags">
                      {d.tags.map((tag) => (
                        <span class="dt-model__node-tag">{tag}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              <div class="dt-model__hub-connector">
                <svg class="dt-model__connector-svg" viewBox="0 0 120 160" fill="none" preserveAspectRatio="none">
                  <path d="M0 20 C55 20, 55 80, 118 80" stroke="url(#hubGrad)" stroke-width="1.5" />
                  <path d="M0 60 C55 60, 55 80, 118 80" stroke="url(#hubGrad)" stroke-width="1.5" />
                  <path d="M0 100 C55 100, 55 80, 118 80" stroke="url(#hubGrad)" stroke-width="1.5" />
                  <path d="M0 140 C55 140, 55 80, 118 80" stroke="url(#hubGrad)" stroke-width="1.5" />
                  <defs>
                    <linearGradient id="hubGrad" x1="0" y1="0" x2="120" y2="0" gradientUnits="userSpaceOnUse">
                      <stop offset="0%" stop-color="rgba(72, 200, 255, 0.18)" />
                      <stop offset="100%" stop-color="rgba(72, 200, 255, 0.75)" />
                    </linearGradient>
                  </defs>
                </svg>
              </div>

              <div class="dt-model__hub-core">
                <div class="dt-model__core-ring">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="5.5" r="2.5" />
                    <circle cx="6" cy="17.5" r="2.5" />
                    <circle cx="18" cy="17.5" r="2.5" />
                    <path d="M10.8 7.7L7.2 15.3M13.2 7.7L16.8 15.3M8.5 17.5H15.5" />
                  </svg>
                </div>
                <span class="dt-model__core-title">1 Team</span>
                <span class="dt-model__core-sub">Unified Queue</span>
              </div>
            </div>
          </div>
        </article>

        <!-- 02 · PREDICTABILITY: Flat Retainer vs Variable Quotes Chart -->
        <article class="dt-model__module dt-model__module--retainer reveal-model" style="--model-delay: 90ms;">
          <div class="dt-model__module-head">
            <span class="dt-model__tag">02 · Predictability</span>
            <span class="dt-model__meta-pill">Monthly or Annual</span>
          </div>

          <div class="dt-model__retainer-layout">
            <div class="dt-model__copy-block">
              <h3 class="dt-model__module-title">Flat monthly retainer.</h3>
              <p class="dt-model__module-copy">
                One defined rate covers your plan’s active capacity and queue—whether billed monthly or annually—so you don’t negotiate separate quotes for every included request or revision.
              </p>
            </div>

            <!-- Visual Cost Stability Comparison -->
            <div class="dt-model__chart" aria-hidden="true">
              <div class="dt-model__chart-row dt-model__chart-row--legacy">
                <div class="dt-model__chart-meta">
                  <span>Traditional Quotes</span>
                  <span class="dt-model__chart-note">Variable + Extras</span>
                </div>
                <div class="dt-model__bars">
                  <span style="height: 38%"></span>
                  <span style="height: 76%"></span>
                  <span style="height: 52%"></span>
                  <span style="height: 94%"></span>
                  <span style="height: 64%"></span>
                  <span style="height: 85%"></span>
                </div>
              </div>

              <div class="dt-model__chart-row dt-model__chart-row--adaptif">
                <div class="dt-model__chart-meta">
                  <span>Adaptif Retainer</span>
                  <span class="dt-model__chart-note dt-model__chart-note--cyan">1 Flat Rate</span>
                </div>
                <div class="dt-model__flat-line">
                  <span class="dt-model__flat-fill"></span>
                  <span class="dt-model__flat-tag">Active capacity & revisions included</span>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- 03 · PACE: Full-Width Lifecycle Timeline (12 cols) -->
        <article class="dt-model__module dt-model__module--pace reveal-model" style="--model-delay: 160ms;">
          <div class="dt-model__pace-top">
            <div class="dt-model__pace-copy">
              <div class="dt-model__module-head">
                <span class="dt-model__tag">03 · Pace</span>
              </div>
              <h3 class="dt-model__module-title">{flexibilityTitle}</h3>
              <p class="dt-model__module-copy">{flexibilityDescription}</p>
            </div>

            <!-- Interactive-feeling Pipeline Timeline -->
            <div class="dt-model__timeline" aria-hidden="true">
              <div class="dt-model__timeline-track"></div>
              <div class="dt-model__timeline-steps">
                {timelineSteps.map((step) => (
                  <div class={`dt-model__step dt-model__step--${step.state}`}>
                    <div class="dt-model__step-node">
                      {step.state === "paused" && (
                        <span class="dt-model__lockin-pill">No lock-in</span>
                      )}
                      <span class="dt-model__step-dot"></span>
                    </div>
                    <div class="dt-model__step-card">
                      <div class="dt-model__step-top">
                        <span class="dt-model__step-cycle">{step.cycle}</span>
                        <span class="dt-model__step-badge">{step.badge}</span>
                      </div>
                      <span class="dt-model__step-label">{step.label}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  const initDedicatedTeamModel = () => {
    const items = document.querySelectorAll("#subscription-model .reveal-model");
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -30px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  };

  initDedicatedTeamModel();
  document.addEventListener("astro:page-load", initDedicatedTeamModel);
</script>

<style>
  .dt-model {
    position: relative;
    padding: clamp(72px, 10vw, 124px) 0;
    background: var(--color-void, #010307);
  }

  .dt-model__container {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .dt-model__header {
    max-width: 720px;
    margin: 0 auto clamp(36px, 5vw, 56px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dt-model__eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-cyan, #48C8FF);
    margin-bottom: 14px;
  }

  .dt-model__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.3vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--font-letter-spacing-display, -0.04em);
    font-weight: 400;
    color: var(--color-text-white, #ffffff);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .dt-model__title-accent {
    font-style: italic;
    padding-right: 0.06em;
  }

  .dt-model__subtitle {
    font-size: clamp(0.98rem, 1.1vw, 1.12rem);
    line-height: 1.6;
    letter-spacing: -0.015em;
    color: var(--color-text-secondary, #94a3b8);
    max-width: 560px;
    margin: 0;
  }

  /* Blueprint Shell */
  .dt-model__blueprint {
    border-radius: 24px;
    background:
      radial-gradient(rgba(72, 200, 255, 0.06) 1px, transparent 1px),
      linear-gradient(180deg, rgba(8, 18, 42, 0.72) 0%, rgba(4, 9, 24, 0.88) 100%);
    background-size: 22px 22px, 100% 100%;
    border: 1px solid rgba(255, 255, 255, 0.11);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 28px 70px -24px rgba(0, 0, 0, 0.85);
    overflow: hidden;
  }

  /* Top Schematic Bar */
  .dt-model__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px clamp(20px, 3vw, 34px);
    background: rgba(2, 6, 16, 0.72);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
  }

  .dt-model__bar-left {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .dt-model__pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--color-brand-cyan, #48C8FF);
    box-shadow: 0 0 10px rgba(72, 200, 255, 0.85);
  }

  .dt-model__bar-label {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    color: #94a3b8;
  }

  .dt-model__bar-flow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .dt-model__flow-pill {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.7rem;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: #cbd5e1;
    white-space: nowrap;
  }

  .dt-model__flow-arrow {
    color: var(--color-brand-cyan, #48C8FF);
    font-size: 0.78rem;
    opacity: 0.8;
  }

  /* Asymmetric 12-col Grid */
  .dt-model__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }

  .dt-model__module {
    padding: clamp(24px, 3.2vw, 38px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    transition: background 0.25s ease;
  }

  .dt-model__module:hover {
    background: rgba(72, 200, 255, 0.025);
  }

  .dt-model__module--scope {
    grid-column: span 12;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-model__module--retainer {
    grid-column: span 12;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-model__module--pace {
    grid-column: span 12;
  }

  .dt-model__module-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .dt-model__tag {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    color: var(--color-brand-cyan, #48C8FF);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dt-model__meta-pill {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: #94a3b8;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    white-space: nowrap;
  }

  .dt-model__module-title {
    font-family: var(--font-family-display);
    font-size: clamp(1.55rem, 2.2vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--color-text-primary, #ffffff);
    margin: 0 0 12px;
  }

  .dt-model__module-copy {
    font-size: 0.95rem;
    line-height: 1.62;
    color: #cbd5e1;
    margin: 0;
  }

  /* 01 · Scope Hub Diagram & 02 · Retainer Horizontal Split */
  .dt-model__scope-layout,
  .dt-model__retainer-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    flex: 1;
  }

  .dt-model__hub-diagram {
    display: grid;
    grid-template-columns: 1fr 48px auto;
    align-items: center;
    padding: 16px;
    border-radius: 16px;
    background: rgba(2, 6, 18, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-model__hub-nodes {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dt-model__node {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .dt-model__module--scope:hover .dt-model__node {
    border-color: rgba(72, 200, 255, 0.25);
    background: rgba(72, 200, 255, 0.05);
  }

  .dt-model__node-code {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.62rem;
    color: var(--color-brand-cyan, #48C8FF);
    opacity: 0.85;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .dt-model__node-name {
    font-size: 0.78rem;
    font-weight: 500;
    color: #e2e8f0;
    white-space: nowrap;
  }

  .dt-model__node-tags {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .dt-model__node-tag {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.02em;
    color: #94a3b8;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .dt-model__module--scope:hover .dt-model__node-tag {
    color: #cbd5e1;
    border-color: rgba(72, 200, 255, 0.16);
  }

  .dt-model__hub-connector {
    height: 148px;
    display: flex;
    align-items: center;
  }

  .dt-model__connector-svg {
    width: 100%;
    height: 100%;
  }

  .dt-model__hub-core {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 14px 12px;
    border-radius: 14px;
    background: radial-gradient(circle at 50% 0%, rgba(72, 200, 255, 0.16), rgba(72, 200, 255, 0.04));
    border: 1px solid rgba(72, 200, 255, 0.35);
    box-shadow: 0 0 28px -8px rgba(72, 200, 255, 0.4);
  }

  .dt-model__core-ring {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-cyan, #48C8FF);
    background: rgba(72, 200, 255, 0.12);
    border: 1px solid rgba(72, 200, 255, 0.3);
    margin-bottom: 8px;
  }

  .dt-model__core-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
  }

  .dt-model__core-sub {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.64rem;
    color: #94a3b8;
    margin-top: 2px;
    white-space: nowrap;
  }

  /* 02 · Predictability Chart */
  .dt-model__chart {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
    border-radius: 16px;
    background: rgba(2, 6, 18, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-model__chart-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.76rem;
    color: #cbd5e1;
    margin-bottom: 8px;
  }

  .dt-model__chart-note {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.66rem;
    color: #64748b;
  }

  .dt-model__chart-note--cyan {
    color: var(--color-brand-cyan, #48C8FF);
  }

  .dt-model__bars {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    align-items: end;
    gap: 6px;
    height: 36px;
    padding: 4px 0 0;
  }

  .dt-model__bars span {
    border-radius: 4px 4px 2px 2px;
    background: rgba(148, 163, 184, 0.25);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .dt-model__flat-line {
    position: relative;
    height: 28px;
    border-radius: 8px;
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.35);
    display: flex;
    align-items: center;
    padding: 0 10px;
    overflow: hidden;
  }

  .dt-model__flat-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background: linear-gradient(90deg, rgba(72, 200, 255, 0.22), rgba(72, 200, 255, 0.06));
  }

  .dt-model__flat-tag {
    position: relative;
    z-index: 1;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.68rem;
    color: #e0f2fe;
    white-space: nowrap;
  }

  /* 03 · Pace Timeline */
  .dt-model__pace-top {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.45fr);
    gap: clamp(24px, 3.6vw, 44px);
    align-items: center;
  }

  .dt-model__timeline {
    position: relative;
    padding: 32px 0 8px;
  }

  .dt-model__timeline-track {
    position: absolute;
    top: 46px;
    left: 24px;
    right: 24px;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(72, 200, 255, 0.65) 0%,
      rgba(72, 200, 255, 0.5) 45%,
      rgba(148, 163, 184, 0.25) 65%,
      rgba(72, 200, 255, 0.65) 100%
    );
  }

  .dt-model__timeline-steps {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .dt-model__step {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dt-model__step-node {
    position: relative;
    display: flex;
    align-items: center;
    padding-left: 14px;
    height: 28px;
  }

  .dt-model__lockin-pill {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 20px;
    transform: translateX(-50%);
    font-family: var(--font-family-mono, monospace);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: #94a3b8;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
