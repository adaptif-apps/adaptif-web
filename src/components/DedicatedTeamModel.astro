---
// DedicatedTeamModel.astro - Unified explanation of Adaptif's subscription model
interface Props {
  flexibilityTitle?: string;
  flexibilityDescription?: string;
}

const {
  flexibilityTitle = "Pause or cancel anytime",
  flexibilityDescription =
    "Your subscription adapts to your pipeline. Upgrade, downgrade, or pause between billing cycles when your workload shifts—without managing separate per-project agreements.",
} = Astro.props;

interface ModelPillar {
  key: string;
  tag: string;
  title: string;
  description: string;
  icon: "disciplines" | "retainer" | "flexibility";
}

const pillars: ModelPillar[] = [
  {
    key: "disciplines",
    tag: "01 · Scope",
    title: "One team. Every discipline.",
    description:
      "Access design, branding, motion, and web capabilities from a single working relationship, aligned with your chosen plan’s scope—no sourcing or coordinating separate vendors for every need.",
    icon: "disciplines",
  },
  {
    key: "retainer",
    tag: "02 · Predictability",
    title: "Flat monthly retainer.",
    description:
      "One defined rate covers your plan’s active capacity and queue—whether billed monthly or annually—so you don’t negotiate separate quotes for every included request or revision.",
    icon: "retainer",
  },
  {
    key: "flexibility",
    tag: "03 · Pace",
    title: flexibilityTitle,
    description: flexibilityDescription,
    icon: "flexibility",
  },
];
---

<section
  class="dt-model"
  id="subscription-model"
  aria-labelledby="dt-model-heading"
>
  <div class="container dt-model__container">
    <!-- Section Intro -->
    <header class="dt-model__header">
      <div class="dt-model__eyebrow">
        <span class="dt-model__dot" aria-hidden="true"></span>
        <span>The model</span>
      </div>

      <h2 id="dt-model-heading" class="dt-model__title">
        One subscription.
        <span class="title-highlight dt-model__title-accent">Everything your brand needs</span>
      </h2>

      <p class="dt-model__subtitle">
        A single creative relationship structured around clear scope, predictable billing, and a pace that moves with your roadmap.
      </p>
    </header>

    <!-- Unified 3-Part Architectural Model Frame -->
    <div class="dt-model__shell" role="region" aria-label="How the Adaptif subscription model works">
      <!-- Top Connector Bar -->
      <div class="dt-model__system-bar" aria-hidden="true">
        <span class="dt-model__system-label">ADAPTIF SUBSCRIPTION ARCHITECTURE</span>
        <span class="dt-model__system-flow">
          <span>Scope</span>
          <span class="dt-model__flow-sep">→</span>
          <span>Cost</span>
          <span class="dt-model__flow-sep">→</span>
          <span>Flexibility</span>
        </span>
      </div>

      <!-- Connected Pillars Grid -->
      <div class="dt-model__pillars">
        {pillars.map((pillar, index) => (
          <article
            class="dt-model__pillar reveal-model"
            style={`--model-delay: ${index * 80}ms;`}
          >
            <div class="dt-model__pillar-top">
              <span class="dt-model__icon" aria-hidden="true">
                {pillar.icon === "disciplines" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="5.5" r="2.5" />
                    <circle cx="6" cy="17.5" r="2.5" />
                    <circle cx="18" cy="17.5" r="2.5" />
                    <path d="M10.8 7.7L7.2 15.3M13.2 7.7L16.8 15.3M8.5 17.5H15.5" />
                  </svg>
                )}
                {pillar.icon === "retainer" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="5.5" width="17" height="13" rx="2.5" />
                    <path d="M3.5 10H20.5M7.5 14.5H12" />
                  </svg>
                )}
                {pillar.icon === "flexibility" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12a8 8 0 0 1 13.66-5.66L20 8.5" />
                    <path d="M20 4v4.5h-4.5" />
                    <path d="M20 12a8 8 0 0 1-13.66 5.66L4 15.5" />
                    <path d="M4 20v-4.5h4.5" />
                  </svg>
                )}
              </span>
              <span class="dt-model__tag">{pillar.tag}</span>
            </div>

            <h3 class="dt-model__pillar-title">{pillar.title}</h3>
            <p class="dt-model__pillar-copy">{pillar.description}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const initDedicatedTeamModel = () => {
    const items = document.querySelectorAll("#subscription-model .reveal-model");
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: "0px 0px -30px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  };

  initDedicatedTeamModel();
  document.addEventListener("astro:page-load", initDedicatedTeamModel);
</script>

<style>
  .dt-model {
    position: relative;
    padding: clamp(72px, 10vw, 124px) 0;
    background: var(--color-void, #010307);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dt-model__container {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .dt-model__header {
    max-width: 720px;
    margin: 0 auto clamp(36px, 5vw, 56px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dt-model__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: rgba(8, 18, 44, 0.65);
    border: 1px solid rgba(72, 200, 255, 0.25);
    margin-bottom: 18px;
  }

  .dt-model__eyebrow span:last-child {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #cbd5e1;
  }

  .dt-model__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-cyan, #48C8FF);
    flex-shrink: 0;
  }

  .dt-model__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.3vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--font-letter-spacing-display, -0.04em);
    font-weight: 400;
    color: var(--color-text-white, #ffffff);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .dt-model__title-accent {
    font-style: italic;
    padding-right: 0.06em;
  }

  .dt-model__subtitle {
    font-size: clamp(0.98rem, 1.1vw, 1.12rem);
    line-height: 1.6;
    letter-spacing: -0.015em;
    color: var(--color-text-secondary, #94a3b8);
    max-width: 560px;
    margin: 0;
  }

  /* Unified Architectural Shell */
  .dt-model__shell {
    border-radius: 24px;
    background: linear-gradient(
      180deg,
      rgba(8, 18, 42, 0.65) 0%,
      rgba(4, 9, 24, 0.78) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.11);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 24px 60px -20px rgba(0, 0, 0, 0.8);
    overflow: hidden;
  }

  .dt-model__system-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px clamp(20px, 3vw, 34px);
    background: rgba(2, 6, 16, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-model__system-label {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .dt-model__system-flow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.78rem;
    font-weight: 500;
    color: #cbd5e1;
  }

  .dt-model__flow-sep {
    color: var(--color-brand-cyan, #48C8FF);
    opacity: 0.75;
  }

  .dt-model__pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .dt-model__pillar {
    position: relative;
    padding: clamp(26px, 3.4vw, 40px);
    display: flex;
    flex-direction: column;
    transition: background 0.25s ease;
  }

  .dt-model__pillar + .dt-model__pillar {
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-model__pillar:hover {
    background: rgba(72, 200, 255, 0.03);
  }

  .dt-model__pillar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
  }

  .dt-model__icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-cyan, #48C8FF);
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.24);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
  }

  .dt-model__tag {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: #94a3b8;
  }

  .dt-model__pillar-title {
    font-family: var(--font-family-display);
    font-size: clamp(1.55rem, 2.1vw, 1.95rem);
    line-height: 1.14;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .dt-model__pillar-copy {
    font-size: 0.96rem;
    line-height: 1.62;
    color: #cbd5e1;
    margin: 0;
  }

  /* Subtle reveal animation */
  .reveal-model {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s ease var(--model-delay, 0ms),
      transform 0.5s var(--ease-spring) var(--model-delay, 0ms),
      background 0.25s ease;
  }

  .reveal-model.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-model {
      opacity: 1;
      transform: none;
      transition: background 0.25s ease;
    }
  }

  @media (max-width: 960px) {
    .dt-model__pillars {
      grid-template-columns: 1fr;
    }

    .dt-model__pillar + .dt-model__pillar {
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 600px) {
    .dt-model__system-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
