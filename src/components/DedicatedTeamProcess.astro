---
// DedicatedTeamProcess.astro - 4-step connected workflow: One-time setup (01) -> Ongoing cycle (02-04)
interface ProcessStep {
  number: string;
  title: string;
  description: string;
  cue: string;
  icon: "onboard" | "request" | "motion" | "ship";
}

const setupStep: ProcessStep = {
  number: "01",
  title: "Subscribe & Onboard",
  description:
    "Choose your plan, share your brand guidelines and assets, and align on priorities. Your team reviews your context so you are ready to submit your first request.",
  cue: "Brand kit & goals",
  icon: "onboard",
};

const cycleSteps: ProcessStep[] = [
  {
    number: "02",
    title: "Submit a Request",
    description:
      "Send a brief outlining what you need, who it’s for, and your target timing. Queued requests advance in priority order within your plan’s active-ticket capacity.",
    cue: "Brief & priority",
    icon: "request",
  },
  {
    number: "03",
    title: "Creative in Motion",
    description:
      "Your creative team picks up the active request and gets to work. Most standard design deliverables turn around in 1–2 days, depending on scope and complexity.",
    cue: "Active ticket · 1–2 day cycles",
    icon: "motion",
  },
  {
    number: "04",
    title: "Review & Ship",
    description:
      "Approve the deliverable or request unlimited revisions within the brief’s scope until it’s right—then the next queued request moves into motion.",
    cue: "Feedback & final files",
    icon: "ship",
  },
];
---

<section
  class="dt-proc"
  id="the-process"
  aria-labelledby="dt-proc-heading"
>
  <div class="container dt-proc__container">
    <!-- Section Header -->
    <header class="dt-proc__header">
      <span class="dt-proc__eyebrow">THE PROCESS</span>

      <h2 id="dt-proc-heading" class="dt-proc__title">
        Built to work,
        <span class="title-highlight dt-proc__title-accent">the way you work</span>
      </h2>

      <p class="dt-proc__subtitle">
        Onboard once to establish your brand foundation, then move through a steady request, production, and review cycle.
      </p>
    </header>

    <!-- Connected Sequence: One-Time Setup (01) -> Recurring Cycle (02 -> 03 -> 04) -->
    <div class="dt-proc__flow">
      <!-- Phase 1: One-Time Setup -->
      <div class="dt-proc__setup-wrap reveal-proc" style="--proc-delay: 0ms;">
        <div class="dt-proc__phase-badge">
          <span class="dt-proc__phase-dot" aria-hidden="true"></span>
          <span>One-time setup</span>
        </div>

        <article class="dt-proc__card dt-proc__card--setup">
          <div class="dt-proc__card-top">
            <span class="dt-proc__num">{setupStep.number}</span>
            <span class="dt-proc__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            </span>
          </div>

          <h3 class="dt-proc__card-title">{setupStep.title}</h3>
          <p class="dt-proc__card-copy">{setupStep.description}</p>

          <div class="dt-proc__cue">
            <span class="dt-proc__cue-dot" aria-hidden="true"></span>
            <span>{setupStep.cue}</span>
          </div>
        </article>
      </div>

      <!-- Bridge Arrow (01 -> Cycle) -->
      <div class="dt-proc__bridge" aria-hidden="true">
        <span class="dt-proc__bridge-arrow">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
            <path d="M4 10h12m0 0-4-4m4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>

      <!-- Phase 2: Recurring Delivery Cycle (02 -> 03 -> 04) -->
      <div class="dt-proc__cycle-wrap reveal-proc" style="--proc-delay: 100ms;">
        <div class="dt-proc__cycle-header">
          <div class="dt-proc__phase-badge dt-proc__phase-badge--cycle">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 12a8 8 0 0 1 13.66-5.66L20 8.5" />
              <path d="M20 4v4.5h-4.5" />
              <path d="M20 12a8 8 0 0 1-13.66 5.66L4 15.5" />
              <path d="M4 20v-4.5h4.5" />
            </svg>
            <span>Ongoing creative cycle</span>
          </div>
          <span class="dt-proc__cycle-note">Repeat from request to delivery</span>
        </div>

        <ol class="dt-proc__cycle-grid" aria-label="Ongoing creative workflow">
          {cycleSteps.map((step, idx) => (
            <li class="dt-proc__cycle-item">
              <article class="dt-proc__card dt-proc__card--cycle">
                <div class="dt-proc__card-top">
                  <span class="dt-proc__num">{step.number}</span>
                  <span class="dt-proc__icon" aria-hidden="true">
                    {step.icon === "request" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 3 14 8 19 8" />
                        <line x1="9" y1="13" x2="15" y2="13" />
                        <line x1="9" y1="17" x2="13" y2="17" />
                      </svg>
                    )}
                    {step.icon === "motion" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="13 2 4 14 12 14 11 22 20 10 12 10 13 2" />
                      </svg>
                    )}
                    {step.icon === "ship" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="m8.5 12.5 2.5 2.5 4.5-5" />
                      </svg>
                    )}
                  </span>
                </div>

                <h3 class="dt-proc__card-title">{step.title}</h3>
                <p class="dt-proc__card-copy">{step.description}</p>

                <div class="dt-proc__cue">
                  <span class="dt-proc__cue-dot" aria-hidden="true"></span>
                  <span>{step.cue}</span>
                </div>
              </article>

              {idx < cycleSteps.length - 1 && (
                <span class="dt-proc__step-connector" aria-hidden="true">→</span>
              )}
            </li>
          ))}
        </ol>

        <div class="dt-proc__loop-bar" aria-hidden="true">
          <span class="dt-proc__loop-line"></span>
          <span class="dt-proc__loop-label">
            Approved &amp; shipped → Next queued request moves up
          </span>
          <span class="dt-proc__loop-line"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initDedicatedTeamProcess = () => {
    const items = document.querySelectorAll("#the-process .reveal-proc");
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -30px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  };

  initDedicatedTeamProcess();
  document.addEventListener("astro:page-load", initDedicatedTeamProcess);
</script>

<style>
  .dt-proc {
    position: relative;
    padding: clamp(72px, 10vw, 128px) 0;
    background: var(--color-void, #010307);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dt-proc__container {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .dt-proc__header {
    max-width: 680px;
    margin-bottom: clamp(36px, 5vw, 56px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .dt-proc__eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-cyan, #48C8FF);
    margin-bottom: 14px;
  }

  .dt-proc__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.4rem, 4.3vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--font-letter-spacing-display, -0.04em);
    font-weight: 400;
    color: var(--color-text-white, #ffffff);
    margin-bottom: 16px;
    text-wrap: balance;
  }

  .dt-proc__title-accent {
    font-style: italic;
  }

  .dt-proc__subtitle {
    font-size: clamp(0.98rem, 1.1vw, 1.12rem);
    line-height: 1.6;
    letter-spacing: -0.015em;
    color: var(--color-text-secondary, #94a3b8);
    max-width: 560px;
    margin: 0;
  }

  /* Flow Layout: Setup (01) + Bridge + Cycle (02-04) */
  .dt-proc__flow {
    display: grid;
    grid-template-columns: minmax(250px, 0.95fr) 36px minmax(0, 3fr);
    gap: 12px;
    align-items: stretch;
  }

  .dt-proc__setup-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dt-proc__phase-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #cbd5e1;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .dt-proc__phase-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #94a3b8;
  }

  .dt-proc__phase-badge--cycle {
    color: var(--color-brand-cyan, #48C8FF);
    background: rgba(72, 200, 255, 0.08);
    border-color: rgba(72, 200, 255, 0.25);
  }

  /* Bridge */
  .dt-proc__bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 38px;
    position: relative;
  }

  .dt-proc__bridge-arrow {
    position: relative;
    z-index: 1;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #060d1e;
    border: 1px solid rgba(72, 200, 255, 0.35);
    color: var(--color-brand-cyan, #48C8FF);
  }

  /* Cycle Container */
  .dt-proc__cycle-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .dt-proc__cycle-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dt-proc__cycle-note {
    font-size: 0.82rem;
    color: #94a3b8;
  }

  .dt-proc__cycle-grid {
    list-style: none;
    margin: 0;
    padding: 16px;
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgba(8, 18, 42, 0.52) 0%,
      rgba(4, 9, 24, 0.68) 100%
    );
    border: 1px solid rgba(72, 200, 255, 0.18);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    flex: 1 1 auto;
  }

  .dt-proc__cycle-item {
    position: relative;
    display: flex;
    align-items: stretch;
  }

  .dt-proc__step-connector {
    position: absolute;
    right: -13px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    font-size: 0.85rem;
    color: var(--color-brand-cyan, #48C8FF);
    opacity: 0.85;
    pointer-events: none;
  }

  /* Step Cards */
  .dt-proc__card {
    width: 100%;
    padding: 22px;
    border-radius: 16px;
    background: rgba(6, 13, 30, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .dt-proc__card--setup {
    flex: 1 1 auto;
    border-radius: 20px;
    padding: 24px;
    background: rgba(6, 13, 30, 0.72);
  }

  .dt-proc__card:hover {
    border-color: rgba(72, 200, 255, 0.32);
    background: rgba(8, 18, 40, 0.88);
  }

  .dt-proc__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .dt-proc__num {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-brand-cyan, #48C8FF);
  }

  .dt-proc__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-cyan, #48C8FF);
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.22);
    flex-shrink: 0;
  }

  .dt-proc__card-title {
    font-family: var(--font-family-display);
    font-size: clamp(1.35rem, 1.7vw, 1.62rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .dt-proc__card-copy {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0 0 18px;
    flex: 1 1 auto;
  }

  .dt-proc__cue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    font-size: 0.78rem;
    font-weight: 500;
    color: #94a3b8;
  }

  .dt-proc__cue-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-brand-cyan, #48C8FF);
    opacity: 0.85;
  }

  /* Loop-back bar */
  .dt-proc__loop-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 4px;
  }

  .dt-proc__loop-line {
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(72, 200, 255, 0.3), transparent);
  }

  .dt-proc__loop-label {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.73rem;
    letter-spacing: 0.03em;
    color: #94a3b8;
    white-space: nowrap;
  }

  /* Reveal animation */
  .reveal-proc {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s ease var(--proc-delay, 0ms),
      transform 0.55s var(--ease-spring) var(--proc-delay, 0ms);
  }

  .reveal-proc.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-proc {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .dt-proc__card {
      transition: none;
    }
  }

  @media (max-width: 1100px) {
    .dt-proc__flow {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .dt-proc__bridge {
      padding-top: 0;
      height: 32px;
    }

    .dt-proc__bridge-arrow {
      transform: rotate(90deg);
    }
  }

  @media (max-width: 820px) {
    .dt-proc__cycle-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .dt-proc__step-connector {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -17px;
      transform: translateX(-50%) rotate(90deg);
    }

    .dt-proc__loop-label {
      white-space: normal;
      text-align: center;
    }
  }
</style>
