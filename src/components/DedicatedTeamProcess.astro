---
// DedicatedTeamProcess.astro - Two-tier workflow: One-time Launchpad (01) -> Continuous Pipeline Loop (02 -> 03 -> 04)
interface ProcessStep {
  number: string;
  title: string;
  description: string;
  cue: string;
  icon: "onboard" | "request" | "motion" | "ship";
}

const setupStep: ProcessStep = {
  number: "01",
  title: "Subscribe & Onboard",
  description:
    "Choose your plan, share your brand guidelines and assets, and align on priorities. Your team reviews your context so you are ready to submit your first request.",
  cue: "Brand kit & goals",
  icon: "onboard",
};

const setupChecklist = [
  "Plan & capacity active",
  "Brand guidelines synced",
  "Priorities aligned",
];

const cycleSteps: ProcessStep[] = [
  {
    number: "01",
    title: "Submit a Request",
    description:
      "Send a brief outlining what you need, who it’s for, and your target timing. Queued requests advance in priority order within your plan’s active-ticket capacity.",
    cue: "Brief & priority",
    icon: "request",
  },
  {
    number: "02",
    title: "Creative in Motion",
    description:
      "Your creative team picks up the active request and gets to work. Most standard design deliverables turn around in 1–2 days, depending on scope and complexity.",
    cue: "Active ticket · 1–2 day cycles",
    icon: "motion",
  },
  {
    number: "03",
    title: "Review & Ship",
    description:
      "Approve the deliverable or request unlimited revisions within the brief’s scope until it’s right—then the next queued request moves into motion.",
    cue: "Feedback & final files",
    icon: "ship",
  },
];
---

<section
  class="dt-proc"
  id="the-process"
  aria-labelledby="dt-proc-heading"
>
  <div class="container dt-proc__container">
    <!-- Centered Editorial Header -->
    <header class="dt-proc__header">
      <span class="dt-proc__eyebrow">THE PROCESS</span>

      <h2 id="dt-proc-heading" class="dt-proc__title">
        Built to work,
        <span class="title-highlight dt-proc__title-accent">the way you work</span>
      </h2>

      <p class="dt-proc__subtitle">
        Onboard once to establish your brand foundation, then move through a steady request, production, and review cycle.
      </p>
    </header>

    <!-- Tier 1: One-Time Setup Launchpad (01) -->
    <div class="dt-proc__launchpad reveal-proc" style="--proc-delay: 0ms;">
      <div class="dt-proc__launchpad-main">
        <div class="dt-proc__launchpad-meta">
          <span class="dt-proc__phase-badge dt-proc__phase-badge--setup">
            <span class="dt-proc__phase-dot" aria-hidden="true"></span>
            <span>One-time setup</span>
          </span>
        </div>

        <h3 class="dt-proc__launchpad-title">{setupStep.title}</h3>
        <p class="dt-proc__launchpad-copy">{setupStep.description}</p>
      </div>

      <div class="dt-proc__launchpad-aside" aria-hidden="true">
        <div class="dt-proc__aside-head">
          <span class="dt-proc__aside-label">FOUNDATION READY</span>
          <span class="dt-proc__icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
          </span>
        </div>
        <ul class="dt-proc__checklist">
          {setupChecklist.map((check) => (
            <li>
              <span class="dt-proc__check-mark">✓</span>
              <span>{check}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Downward Bridge into Loop -->
    <div class="dt-proc__handoff" aria-hidden="true">
      <span class="dt-proc__handoff-line"></span>
      <span class="dt-proc__handoff-pill">Enters ongoing cycle ↓</span>
      <span class="dt-proc__handoff-line"></span>
    </div>

    <!-- Tier 2: Continuous Creative Cycle Pipeline (02 -> 03 -> 04) -->
    <div class="dt-proc__pipeline reveal-proc" style="--proc-delay: 110ms;">
      <div class="dt-proc__pipeline-head">
        <div class="dt-proc__phase-badge dt-proc__phase-badge--cycle">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12a8 8 0 0 1 13.66-5.66L20 8.5" />
            <path d="M20 4v4.5h-4.5" />
            <path d="M20 12a8 8 0 0 1-13.66 5.66L4 15.5" />
            <path d="M4 20v-4.5h4.5" />
          </svg>
          <span>Ongoing creative cycle</span>
        </div>
        <span class="dt-proc__cycle-note">Repeat from request to delivery</span>
      </div>

      <!-- Horizontal Rail + 3 Open Pipeline Stages -->
      <div class="dt-proc__track-wrap">
        <div class="dt-proc__rail" aria-hidden="true"></div>

        <ol class="dt-proc__stages" aria-label="Ongoing creative workflow">
          {cycleSteps.map((step) => (
            <li class="dt-proc__stage">
              <div class="dt-proc__stage-node" aria-hidden="true">
                <span class="dt-proc__icon dt-proc__icon--stage">
                  {step.icon === "request" && (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 3 14 8 19 8" />
                      <line x1="9" y1="13" x2="15" y2="13" />
                      <line x1="9" y1="17" x2="13" y2="17" />
                    </svg>
                  )}
                  {step.icon === "motion" && (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="13 2 4 14 12 14 11 22 20 10 12 10 13 2" />
                    </svg>
                  )}
                  {step.icon === "ship" && (
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9" />
                      <path d="m8.5 12.5 2.5 2.5 4.5-5" />
                    </svg>
                  )}
                </span>
                <span class="dt-proc__stage-num">{step.number}</span>
              </div>

              <div class="dt-proc__stage-body">
                <h3 class="dt-proc__stage-title">{step.title}</h3>
                <p class="dt-proc__stage-copy">{step.description}</p>
                <span class="dt-proc__cue">{step.cue}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Return Loop Footer -->
      <div class="dt-proc__loop-bar" aria-hidden="true">
        <span class="dt-proc__loop-arrow">↺</span>
        <span class="dt-proc__loop-label">
          Approved &amp; shipped → Next queued request moves up
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const initDedicatedTeamProcess = () => {
    const items = document.querySelectorAll("#the-process .reveal-proc");
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -30px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  };

  initDedicatedTeamProcess();
  document.addEventListener("astro:page-load", initDedicatedTeamProcess);
</script>

<style>
  .dt-proc {
    position: relative;
    padding: clamp(72px, 10vw, 128px) 0;
    background: var(--color-void, #010307);
  }

  .dt-proc__container {
    position: relative;
    z-index: 1;
  }

  /* Centered Header */
  .dt-proc__header {
    max-width: 680px;
    margin: 0 auto clamp(36px, 5vw, 56px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dt-proc__eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-cyan, #48C8FF);
    margin-bottom: 14px;
  }

  .dt-proc__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.4rem, 4.3vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--font-letter-spacing-display, -0.04em);
    font-weight: 400;
    color: var(--color-text-white, #ffffff);
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .dt-proc__title-accent {
    font-style: italic;
    padding-right: 0.06em;
  }

  .dt-proc__subtitle {
    font-size: clamp(0.98rem, 1.1vw, 1.1rem);
    line-height: 1.62;
    letter-spacing: -0.015em;
    color: var(--color-text-secondary, #94a3b8);
    margin: 0;
  }

  /* Shared Badges & Icons */
  .dt-proc__phase-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
  }

  .dt-proc__phase-badge--setup {
    background: rgba(52, 211, 153, 0.1);
    border-color: rgba(52, 211, 153, 0.34);
    color: #34d399;
  }

  .dt-proc__phase-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #34d399;
    box-shadow: 0 0 8px rgba(52, 211, 153, 0.75);
  }

  .dt-proc__phase-badge--cycle {
    background: rgba(72, 200, 255, 0.09);
    border-color: rgba(72, 200, 255, 0.28);
    color: var(--color-brand-cyan, #48C8FF);
  }

  .dt-proc__icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brand-cyan, #48C8FF);
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.24);
    flex-shrink: 0;
  }

  /* Tier 1: Horizontal Launchpad (01) — Fades upwards */
  .dt-proc__launchpad {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.85fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(24px, 3.2vw, 34px);
    border-radius: 20px;
    background: linear-gradient(
      0deg,
      rgba(6, 15, 36, 0.82) 0%,
      rgba(4, 10, 26, 0.42) 55%,
      rgba(1, 3, 7, 0) 100%
    );
  }

  .dt-proc__launchpad::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      0deg,
      rgba(72, 200, 255, 0.48) 0%,
      rgba(255, 255, 255, 0.14) 38%,
      rgba(255, 255, 255, 0) 92%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .dt-proc__launchpad-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .dt-proc__num-pill {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-brand-cyan, #48C8FF);
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.22);
  }

  .dt-proc__launchpad-title {
    font-family: var(--font-family-display);
    font-size: clamp(1.55rem, 2.2vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--color-text-primary, #ffffff);
    margin: 0 0 10px;
  }

  .dt-proc__launchpad-copy {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  .dt-proc__launchpad-aside {
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(2, 6, 18, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-proc__aside-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .dt-proc__aside-label {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }

  .dt-proc__checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dt-proc__checklist li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.84rem;
    color: #e2e8f0;
  }

  .dt-proc__check-mark {
    color: var(--color-brand-cyan, #48C8FF);
    font-weight: 700;
    font-size: 0.8rem;
  }

  /* Handoff Connector */
  .dt-proc__handoff {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6px 0;
  }

  .dt-proc__handoff-line {
    width: 1px;
    height: 14px;
    background: linear-gradient(180deg, rgba(72, 200, 255, 0.15), rgba(72, 200, 255, 0.6));
  }

  .dt-proc__handoff-pill {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-brand-cyan, #48C8FF);
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.28);
  }

  /* Tier 2: Continuous Pipeline Loop — Fades downwards */
  .dt-proc__pipeline {
    position: relative;
    padding: clamp(24px, 3.2vw, 36px);
    border-radius: 22px;
    background: linear-gradient(
      180deg,
      rgba(6, 15, 36, 0.82) 0%,
      rgba(4, 10, 26, 0.42) 60%,
      rgba(1, 3, 7, 0) 100%
    );
  }

  .dt-proc__pipeline::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      180deg,
      rgba(72, 200, 255, 0.48) 0%,
      rgba(255, 255, 255, 0.14) 40%,
      rgba(255, 255, 255, 0) 94%
    );
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .dt-proc__pipeline-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: clamp(26px, 3.5vw, 38px);
  }

  .dt-proc__cycle-note {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .dt-proc__track-wrap {
    position: relative;
  }

  .dt-proc__rail {
    position: absolute;
    top: 18px;
    left: 20px;
    right: 20px;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(72, 200, 255, 0.35) 0%,
      rgba(72, 200, 255, 0.75) 50%,
      rgba(72, 200, 255, 0.35) 100%
    );
  }

  .dt-proc__stages {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3.5vw, 40px);
  }

  .dt-proc__stage {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .dt-proc__stage-node {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    padding-right: 12px;
    background: #050d20;
  }

  .dt-proc__icon--stage {
    box-shadow: 0 0 18px -4px rgba(72, 200, 255, 0.45);
  }

  .dt-proc__stage-num {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-brand-cyan, #48C8FF);
  }

  .dt-proc__stage-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .dt-proc__stage-title {
    font-family: var(--font-family-body);
    font-size: clamp(1.18rem, 1.5vw, 1.38rem);
    line-height: 1.24;
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--color-text-primary, #ffffff);
    margin: 0 0 10px;
  }

  .dt-proc__stage-copy {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0 0 16px;
    flex: 1;
  }

  .dt-proc__cue {
    display: inline-block;
    width: fit-content;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.03em;
    color: #94a3b8;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Return Loop Bar */
  .dt-proc__loop-bar {
    margin-top: clamp(24px, 3vw, 32px);
    padding: 10px 16px;
    border-radius: 12px;
    border: 1px dashed rgba(72, 200, 255, 0.3);
    background: rgba(72, 200, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .dt-proc__loop-arrow {
    color: var(--color-brand-cyan, #48C8FF);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .dt-proc__loop-label {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: #bae6fd;
    text-align: center;
  }

  /* Reveal animation */
  .reveal-proc {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s ease var(--proc-delay, 0ms),
      transform 0.5s var(--ease-spring) var(--proc-delay, 0ms);
  }

  .reveal-proc.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-proc {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .dt-proc__launchpad {
      grid-template-columns: 1fr;
    }

    .dt-proc__rail {
      display: none;
    }

    .dt-proc__stages {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .dt-proc__stage {
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .dt-proc__stage:first-child {
      padding-top: 0;
      border-top: none;
    }

    .dt-proc__stage-node {
      background: transparent;
    }
  }
</style>
