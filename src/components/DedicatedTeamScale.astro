---
// DedicatedTeamScale.astro - Overcoming the 3 scaling obstacles (Hiring, Skill Gaps, Deadlines)
interface Props {
  ctaHref?: string;
}

const { ctaHref = "#contact" } = Astro.props;

interface ScalePillar {
  step: string;
  eyebrow: string;
  problemTitle: string;
  solutionText: string;
  takeaway: string;
}

const pillars: ScalePillar[] = [
  {
    step: "01",
    eyebrow: "Hiring challenges?",
    problemTitle: "Recruiting and onboarding pull focus away from shipping.",
    solutionText:
      "Finding, vetting, and integrating creative talent takes significant time and resources. Adaptif gives you a practical alternative to access creative support without organizing a hiring process for every new need.",
    takeaway: "Skip the hiring process",
  },
  {
    step: "02",
    eyebrow: "Skill gaps?",
    problemTitle: "One designer can’t cover every discipline.",
    solutionText:
      "Branding, motion, web design, and campaign production each require distinct capabilities. Adaptif lets you tap into multiple creative disciplines from a single service, tailored to the scope of your chosen plan.",
    takeaway: "Multiple creative disciplines",
  },
  {
    step: "03",
    eyebrow: "Missing deadlines?",
    problemTitle: "Slow creative holds back your whole team.",
    solutionText:
      "Pending creative assets can stall campaigns, product launches, and growth experiments. Adaptif’s structured request-and-delivery workflow keeps work moving steadily without juggling isolated freelancers.",
    takeaway: "A steady creative workflow",
  },
];
---

<section
  class="dt-scale"
  id="scaling-challenges"
  aria-labelledby="dt-scale-heading"
>
  <div class="container dt-scale__container">
    <div class="dt-scale__grid">
      <!-- Left Column: Sticky Narrative Intro & CTA -->
      <div class="dt-scale__intro">
        <span class="dt-scale__eyebrow">Struggling to scale?</span>

        <h2 id="dt-scale-heading" class="dt-scale__title">
          The right team changes
          <span class="title-highlight dt-scale__title-accent">everything</span>
        </h2>

        <p class="dt-scale__lead">
          Most brands hit the same creative wall. Adaptif is built to break through it.
        </p>

        <div class="dt-scale__cta-wrap">
          <a href={ctaHref} class="adaptif-btn dt-scale__cta">
            <span>Hire your team</span>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Connected Problem -> Response Progression -->
      <ol class="dt-scale__rail" aria-label="How Adaptif resolves creative scaling bottlenecks">
        {pillars.map((pillar, index) => (
          <li
            class="dt-pillar reveal-pillar"
            data-pillar-index={index}
            style={`--pillar-delay: ${index * 90}ms;`}
          >
            <div class="dt-pillar__track" aria-hidden="true">
              <span class="dt-pillar__node">{pillar.step}</span>
              {index < pillars.length - 1 && <span class="dt-pillar__line"></span>}
            </div>

            <article class="dt-pillar__card">
              <div class="dt-pillar__header">
                <span class="dt-pillar__eyebrow">{pillar.eyebrow}</span>
                <span class="dt-pillar__takeaway">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{pillar.takeaway}</span>
                </span>
              </div>

              <h3 class="dt-pillar__title">{pillar.problemTitle}</h3>

              <div class="dt-pillar__response">
                <span class="dt-pillar__response-label">Adaptif response</span>
                <p class="dt-pillar__copy">{pillar.solutionText}</p>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const initDedicatedTeamScale = () => {
    const items = document.querySelectorAll("#scaling-challenges .reveal-pillar");
    if (!items.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      items.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.16, rootMargin: "0px 0px -40px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  };

  initDedicatedTeamScale();
  document.addEventListener("astro:page-load", initDedicatedTeamScale);
</script>

<style>
  .dt-scale {
    position: relative;
    padding: clamp(72px, 10vw, 128px) 0;
    background: var(--color-void, #010307);
  }

  .dt-scale__container {
    position: relative;
    z-index: 1;
  }

  .dt-scale__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  /* Left Sticky Intro */
  .dt-scale__intro {
    position: sticky;
    top: calc(var(--header-height, 84px) + 40px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .dt-scale__eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-cyan, #48C8FF);
    margin-bottom: 14px;
  }

  .dt-scale__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.4rem, 4.3vw, 4.1rem);
    line-height: 1.04;
    letter-spacing: var(--font-letter-spacing-display, -0.04em);
    font-weight: 400;
    color: var(--color-text-white, #ffffff);
    margin-bottom: 18px;
    text-wrap: balance;
  }

  .dt-scale__title-accent {
    font-style: italic;
    padding-right: 0.06em;
  }

  .dt-scale__lead {
    font-size: clamp(1rem, 1.15vw, 1.15rem);
    line-height: 1.6;
    letter-spacing: -0.015em;
    color: var(--color-text-secondary, #94a3b8);
    max-width: 440px;
    margin-bottom: 30px;
  }

  .dt-scale__cta {
    padding: 14px 28px;
  }

  .dt-scale__cta:focus-visible {
    outline: 2px solid var(--color-brand-cyan, #48C8FF);
    outline-offset: 4px;
  }

  /* Right Progression Rail */
  .dt-scale__rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .dt-pillar {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: clamp(16px, 2.2vw, 24px);
    padding-bottom: clamp(22px, 3vw, 30px);
  }

  .dt-pillar:last-child {
    padding-bottom: 0;
  }

  .dt-pillar__track {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dt-pillar__node {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-mono, monospace);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #e2e8f0;
    background: rgba(8, 18, 44, 0.85);
    border: 1px solid rgba(72, 200, 255, 0.28);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
    flex-shrink: 0;
    transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease;
  }

  .dt-pillar__line {
    width: 1px;
    flex: 1 1 auto;
    min-height: 28px;
    margin-top: 10px;
    background: linear-gradient(
      180deg,
      rgba(72, 200, 255, 0.35) 0%,
      rgba(255, 255, 255, 0.08) 100%
    );
  }

  .dt-pillar__card {
    padding: clamp(22px, 2.8vw, 30px);
    border-radius: 20px;
    background: rgba(6, 13, 30, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 14px 34px -14px rgba(0, 0, 0, 0.75);
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .dt-pillar:hover .dt-pillar__card,
  .dt-pillar:focus-within .dt-pillar__card {
    border-color: rgba(72, 200, 255, 0.32);
    background: rgba(8, 18, 40, 0.84);
  }

  .dt-pillar:hover .dt-pillar__node,
  .dt-pillar:focus-within .dt-pillar__node {
    border-color: rgba(72, 200, 255, 0.65);
    color: var(--color-brand-cyan, #48C8FF);
  }

  .dt-pillar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-bottom: 14px;
  }

  .dt-pillar__eyebrow {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-brand-cyan, #48C8FF);
  }

  .dt-pillar__takeaway {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.22);
    font-size: 0.78rem;
    font-weight: 500;
    color: #e2e8f0;
  }

  .dt-pillar__takeaway svg {
    color: var(--color-brand-cyan, #48C8FF);
    flex-shrink: 0;
  }

  .dt-pillar__title {
    font-family: var(--font-family-display);
    font-size: clamp(1.45rem, 2.1vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .dt-pillar__response {
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .dt-pillar__response-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-bottom: 6px;
  }

  .dt-pillar__copy {
    font-size: 0.96rem;
    line-height: 1.62;
    color: #cbd5e1;
    margin: 0;
  }

  /* Subtle reveal animation */
  .reveal-pillar {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.55s ease var(--pillar-delay, 0ms),
      transform 0.55s var(--ease-spring) var(--pillar-delay, 0ms);
  }

  .reveal-pillar.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-pillar {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .dt-pillar__card,
    .dt-pillar__node {
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .dt-scale__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .dt-scale__intro {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .dt-pillar {
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 14px;
    }

    .dt-pillar__node {
      width: 34px;
      height: 34px;
      font-size: 0.72rem;
    }

    .dt-pillar__card {
      padding: 18px;
    }
  }
</style>
