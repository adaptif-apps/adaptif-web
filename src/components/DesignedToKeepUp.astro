---
// DesignedToKeepUp.astro - Feature Cards: Designed to Keep Up (Full Bleed Image Cards)
interface Card {
  image: string;
  alt: string;
  title: string;
  description: string;
  accentGlow?: string;
}

const cards: Card[] = [
  {
    image: "/images/designed-to-keep-up/card-1-deadlines.jpg",
    alt: "Smartphone traversing through cosmic speed rays",
    title: "Deadlines measured in hours",
    description: "Clear ownership, async collaboration and smart use of AI let us ship selected projects in 12 hours, keeping feedback loops tight and quality high.",
    accentGlow: "rgba(72, 200, 255, 0.22)"
  },
  {
    image: "/images/designed-to-keep-up/card-2-talent.jpg",
    alt: "Athletic sneaker in motion breaking limits on city pavement",
    title: "We’re limits off, talent on",
    description: "Global creatives and smart AI tools working as one team, giving your brand richer ideas, faster delivery and reliably strong creative output.",
    accentGlow: "rgba(255, 140, 60, 0.2)"
  },
  {
    image: "/images/designed-to-keep-up/card-3-plan.jpg",
    alt: "Designer hands typing on laptop in vibrant botanical workspace",
    title: "One plan for whatever’s next",
    description: "Tap into a wide range of services and pivot whenever you need, while AI‑assisted workflows keep your creative efficient, on‑brief and worth it.",
    accentGlow: "rgba(50, 200, 150, 0.2)"
  }
];
---

<section class="keep-up-section" id="designed-to-keep-up">
  <!-- Subtle Ambient Background Illumination -->
  <div class="ambient-glow-top" aria-hidden="true"></div>
  <div class="ambient-glow-bottom" aria-hidden="true"></div>

  <div class="container keep-up-container">
    <!-- Header Block -->
    <div class="keep-up-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">DESIGNED TO KEEP UP</span>
      </div>

      <h2 class="keep-up-title">
        Fast, sharp and always in sync with your team. <br class="br-desktop" />
        <span class="title-sub">Work with a creative partner to match your pace.</span>
      </h2>
    </div>

    <!-- 3 Full-Bleed Image Cards Grid -->
    <div class="cards-grid">
      {cards.map((card, index) => (
        <article class="fullbleed-card" style={`--accent-glow: ${card.accentGlow || 'rgba(72, 200, 255, 0.25)'}; --card-idx: ${index};`}>
          <!-- Full Bleed Image Background -->
          <div class="card-bg-wrap">
            <img 
              src={card.image} 
              alt={card.alt} 
              class="card-bg-img"
              width="409"
              height="648"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Deep Scrim Gradient Overlay for Text Legibility -->
          <div class="card-scrim-overlay" aria-hidden="true"></div>

          <!-- Top Subtle Specular Rim -->
          <div class="card-specular-edge" aria-hidden="true"></div>

          <!-- Bottom Content Layer -->
          <div class="card-content-overlay">
            <h3 class="card-title">{card.title}</h3>
            <div class="card-description-wrap">
              <div class="card-description-inner">
                <p class="card-description">{card.description}</p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .keep-up-section {
    position: relative;
    width: 100%;
    padding-top: clamp(60px, 9vh, 100px);
    padding-bottom: clamp(70px, 11vh, 130px);
    background-color: var(--color-void, #010307);
    overflow: hidden;
  }

  /* Ambient Glows */
  .ambient-glow-top {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: min(90vw, 1000px);
    height: 380px;
    background: radial-gradient(ellipse at 50% 50%, rgba(72, 200, 255, 0.08) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .ambient-glow-bottom {
    position: absolute;
    bottom: -100px;
    right: 5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 102, 255, 0.07) 0%, transparent 65%);
    filter: blur(90px);
    pointer-events: none;
    z-index: 0;
  }

  .keep-up-container {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Header Section */
  .keep-up-header {
    text-align: center;
    max-width: 920px;
    margin-bottom: clamp(40px, 6vh, 64px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(12px, 1.8vh, 18px);
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #48C8FF;
    display: inline-block;
  }

  .keep-up-title {
    font-family: var(--font-family-display);
    font-size: clamp(2.2rem, 3.8vw, 3.4rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--color-text-white);
    margin: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: 
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.08s,
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
  }

  .title-sub {
    color: var(--color-text-secondary);
    display: inline;
  }

  .br-desktop {
    display: inline;
  }

  /* 3 Full-Bleed Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.8vw, 32px);
    width: 100%;
  }

  /* Full-Bleed Card Item (Image covers 100% of card) */
  .fullbleed-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 9 / 13.5;
    min-height: clamp(440px, 56vh, 540px);
    border-radius: 26px;
    overflow: hidden;
    background-color: #02050e;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
      0 20px 45px -12px rgba(0, 0, 0, 0.85),
      0 0 35px -8px var(--accent-glow);
    cursor: default;
    opacity: 0;
    transform: translateY(36px);
    transition: 
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      box-shadow 0.45s ease;
  }

  /* Staggered card entrance */
  .fullbleed-card[style*="--card-idx: 0"] {
    transition-delay: 0.16s, 0.16s, 0s, 0s;
  }

  .fullbleed-card[style*="--card-idx: 1"] {
    transition-delay: 0.28s, 0.28s, 0s, 0s;
  }

  .fullbleed-card[style*="--card-idx: 2"] {
    transition-delay: 0.40s, 0.40s, 0s, 0s;
  }

  .keep-up-section.is-visible .eyebrow-wrapper,
  .keep-up-section.is-visible .keep-up-title,
  .keep-up-section.is-visible .fullbleed-card {
    opacity: 1;
    transform: translateY(0);
  }

  .keep-up-section.is-visible .fullbleed-card:hover {
    transform: translateY(-6px);
    border-color: rgba(72, 200, 255, 0.45);
    box-shadow: 
      0 30px 65px -14px rgba(0, 0, 0, 0.95),
      0 0 50px -4px var(--accent-glow);
  }

  /* Full Bleed Background Container */
  .card-bg-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
  }

  .card-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    filter: brightness(0.92) saturate(1.05);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .fullbleed-card:hover .card-bg-img {
    transform: scale(1.045);
    filter: brightness(1.0) saturate(1.12);
  }

  /* Deep Scrim Gradient Overlay for 100% Text Legibility */
  .card-scrim-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(1, 3, 7, 0) 0%,
      rgba(1, 3, 7, 0.1) 35%,
      rgba(1, 3, 7, 0.7) 65%,
      rgba(1, 3, 7, 0.92) 85%,
      rgba(1, 3, 7, 0.98) 100%
    );
    z-index: 1;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .fullbleed-card:hover .card-scrim-overlay {
    opacity: 0.94;
  }

  /* Subtle Top Specular Edge Rim */
  .card-specular-edge {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 40%,
      rgba(72, 200, 255, 0.45) 60%,
      transparent 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Card Content Layer placed at bottom */
  .card-content-overlay {
    position: relative;
    z-index: 2;
    padding: clamp(22px, 3vw, 30px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .card-title {
    font-size: clamp(1.22rem, 1.45vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
    line-height: 1.25;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fullbleed-card:hover .card-title {
    transform: translateY(-2px);
  }

  /* Description reveals smoothly on hover only */
  .card-description-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fullbleed-card:hover .card-description-wrap {
    grid-template-rows: 1fr;
  }

  .card-description-inner {
    overflow: hidden;
  }

  .card-description {
    font-size: clamp(0.88rem, 0.95vw, 0.96rem);
    line-height: 1.58;
    letter-spacing: -0.01em;
    color: #cbd5e1;
    margin: 0;
    padding-top: 10px;
    opacity: 0;
    transform: translateY(8px);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
    text-wrap: pretty;
    transition: 
      opacity 0.35s ease 0.05s,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s;
  }

  .fullbleed-card:hover .card-description {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive Breakpoints */
  @media (max-width: 980px) {
    .cards-grid {
      grid-template-columns: 1fr;
      max-width: 440px;
      margin-inline: auto;
    }

    .fullbleed-card {
      aspect-ratio: 9 / 12;
      min-height: 460px;
    }

    .br-desktop {
      display: none;
    }

    /* On mobile, show description by default */
    .card-description-wrap {
      grid-template-rows: 1fr;
    }

    .card-description {
      opacity: 1;
      transform: translateY(0);
      padding-top: 8px;
    }

    .card-scrim-overlay {
      background: linear-gradient(
        180deg,
        rgba(1, 3, 7, 0) 0%,
        rgba(1, 3, 7, 0.15) 30%,
        rgba(1, 3, 7, 0.75) 60%,
        rgba(1, 3, 7, 0.95) 85%,
        rgba(1, 3, 7, 0.99) 100%
      );
    }
  }

  @media (hover: none) {
    /* Touch devices without cursor hover show description by default */
    .card-description-wrap {
      grid-template-rows: 1fr;
    }

    .card-description {
      opacity: 1;
      transform: translateY(0);
      padding-top: 8px;
    }
  }

  @media (min-width: 641px) and (max-width: 980px) {
    .cards-grid {
      max-width: 500px;
    }
  }

  @media (max-width: 640px) {
    .keep-up-header {
      text-align: left;
      align-items: flex-start;
    }

    .eyebrow-wrapper {
      margin-bottom: 10px;
    }

    .card-content-overlay {
      padding: 20px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eyebrow-wrapper,
    .keep-up-title,
    .fullbleed-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
