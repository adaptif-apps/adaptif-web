---
// EmailWorkflowAndBottom.astro - "Your dedicated team of email specialists" (5 steps) + Creative power banner + Related articles

const steps = [
  {
    num: "1",
    title: "Flexible by design",
    desc: "Need a reusable email template this month and a complete campaign next month? Our support adapts to your priorities, from strategy and content to creative production and targeted refinements.",
  },
  {
    num: "2",
    title: "Designed for performance",
    desc: "Every layout, module, and message is built with a clear goal: encourage action, strengthen customer relationships, and improve conversions.",
  },
  {
    num: "3",
    title: "Ready for your platform",
    desc: "We work within the email platforms and processes your team already uses, including HubSpot, Salesforce, Klaviyo, and Mailchimp.",
  },
  {
    num: "4",
    title: "One connected creative team",
    desc: "Designers, copywriters, and email specialists collaborate as one team. When needed, we also bring in complementary support for landing pages, video assets, and other campaign materials.",
  },
  {
    num: "5",
    title: "A simpler production process",
    desc: "Briefs, feedback, approvals, and collaboration stay organized in one shared workspace—making every stage of email production easier to manage.",
  },
];

const articles = [
  {
    id: "art1",
    category: "Creative Leadership",
    readTime: "8 min read",
    title: "6 AI applications that actually save time (with real examples)",
    excerpt:
      "Creative teams don’t need more AI hype. They need practical, proven applications and real results.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
  {
    id: "art2",
    category: "Email Systems",
    readTime: "6 min read",
    title: "How modular email design systems cut campaign launch times in half",
    excerpt:
      "Replace one-off templates with reusable brand blocks inside Klaviyo, HubSpot, and Salesforce.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
  {
    id: "art3",
    category: "Lifecycle Marketing",
    readTime: "7 min read",
    title: "Designing onboarding and retention flows that actually convert",
    excerpt:
      "Align visual hierarchy, copy pacing, and mobile-first CTAs across every stage of the customer journey.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
  {
    id: "art4",
    category: "Performance",
    readTime: "5 min read",
    title: "What makes a high-performing email in a crowded inbox",
    excerpt:
      "Practical rules for scannable layouts, dark-mode resilience, and consistent A/B creative testing.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
];
---

<!-- 1. How we work (5 steps) -->
<section class="em-work" id="email-workflow" aria-labelledby="em-work-title">
  <div class="container em-work__grid">
    <div class="em-work__intro" data-em-reveal>
      <p class="adaptif-eyebrow" data-cms-key="email.workflow.eyebrow">
        How we work
      </p>
      <h2 id="em-work-title" class="em-work__title" data-cms-key="email.workflow.title">
        Your <span class="title-highlight">dedicated team</span> of email specialists
      </h2>
      <p class="em-work__subtitle" data-cms-key="email.workflow.subtitle">
        From strategy and creative direction to copy, design, and optimization, Adaptif integrates with your team to deliver reliable, high-quality email execution at scale.
      </p>
    </div>

    <ol class="em-work__steps">
      {steps.map((step, idx) => (
        <li class="em-step" data-em-reveal style={`--em-delay: ${idx * 55}ms`}>
          <span class="em-step__num" aria-hidden="true">{step.num}</span>
          <div class="em-step__body">
            <h3 class="em-step__title" data-cms-key={`email.workflow.step${step.num}.title`}>
              {step.title}
            </h3>
            <p class="em-step__desc" data-cms-key={`email.workflow.step${step.num}.desc`}>
              {step.desc}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 2. Creative power banner -->
<section class="em-power" id="email-creative-power" aria-labelledby="em-power-title">
  <div class="em-power__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/branding/creative-power-mobile.jpg" />
      <img
        src="/images/branding/creative-power-desktop.jpg"
        alt=""
        class="em-power__bg"
        loading="lazy"
        decoding="async"
        data-cms-key="email.power.image"
      />
    </picture>
    <div class="em-power__scrim"></div>
  </div>

  <div class="container em-power__container">
    <div class="em-power__content" data-em-reveal>
      <h2 id="em-power-title" class="em-power__title" data-cms-key="email.power.title">
        Now imagine this <span class="title-highlight">creative power</span> behind your next project
      </h2>
      <p class="em-power__desc" data-cms-key="email.power.desc">
        This is just one of many creative services—what you do with them is up to you. Let’s chat.
      </p>
      <a
        href="#book-a-call"
        class="adaptif-btn"
        data-open-book-call
        data-cms-key="email.power.cta"
      >
        <span>Book a Call</span>
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- 3. Related articles -->
<section class="em-articles" id="email-articles" aria-labelledby="em-articles-title">
  <div class="container">
    <header class="em-articles__header" data-em-reveal>
      <p class="adaptif-eyebrow" data-cms-key="email.articles.eyebrow">
        Related articles
      </p>
      <h2 id="em-articles-title" class="em-articles__title" data-cms-key="email.articles.title">
        Read more about <span class="title-highlight">email marketing</span> for creative teams
      </h2>
    </header>

    <div class="em-articles__grid">
      {articles.map((art, idx) => (
        <a
          href={art.href}
          class="em-article-card"
          data-em-reveal
          style={`--em-delay: ${idx * 65}ms`}
        >
          <div class="em-article-card__media">
            <img
              src="/images/branding/article-cover.jpg"
              alt={art.title}
              class="em-article-card__img"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="em-article-card__body">
            <p class="em-article-card__meta">
              <span>{art.category}</span>
              <span aria-hidden="true">•</span>
              <span>{art.readTime}</span>
            </p>
            <h3 class="em-article-card__title" data-cms-key={`email.articles.${art.id}.title`}>
              {art.title}
            </h3>
            <p class="em-article-card__excerpt" data-cms-key={`email.articles.${art.id}.excerpt`}>
              {art.excerpt}
            </p>

            <div class="em-article-card__author">
              <img
                src="/images/branding/author-tessa.jpg"
                alt={art.author}
                class="em-article-card__avatar"
                loading="lazy"
                decoding="async"
              />
              <div>
                <span class="em-article-card__author-name">{art.author}</span>
                <span class="em-article-card__author-role">{art.role}</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .em-work {
    padding: clamp(64px, 8.5vw, 112px) 0;
    background: var(--color-void);
  }

  .em-work__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }

  .em-work__intro {
    position: sticky;
    top: 112px;
  }

  .em-work__title {
    margin: 14px 0 18px;
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.1vw, 3.35rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .em-work__subtitle {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    line-height: 1.62;
    color: var(--color-text-secondary);
  }

  .em-work__steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .em-step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .em-step:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .em-step__num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-body);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-brand-cyan);
    background: rgba(72, 200, 255, 0.1);
    border: 1px solid rgba(72, 200, 255, 0.35);
    margin-top: 2px;
  }

  .em-step__title {
    margin: 0 0 8px;
    font-family: var(--font-family-body);
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .em-step__desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Power banner */
  .em-power {
    position: relative;
    min-height: clamp(380px, 44vw, 520px);
    display: flex;
    align-items: center;
    padding: clamp(64px, 8vw, 100px) 0;
    overflow: hidden;
    background: var(--color-void);
  }

  .em-power__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .em-power__media picture {
    display: contents;
  }

  .em-power__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .em-power__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(1, 3, 7, 0.9) 0%,
      rgba(1, 3, 7, 0.65) 48%,
      rgba(1, 3, 7, 0.14) 100%
    );
  }

  .em-power__container {
    position: relative;
    z-index: 2;
  }

  .em-power__content {
    max-width: 560px;
  }

  .em-power__title {
    margin: 0 0 16px;
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.3vw, 3.5rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .em-power__desc {
    margin: 0 0 28px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Related articles */
  .em-articles {
    padding: clamp(68px, 8.5vw, 112px) 0;
    background: var(--color-void);
  }

  .em-articles__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(36px, 5vw, 52px);
  }

  .em-articles__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .em-articles__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .em-article-card {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.025);
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
  }

  .em-article-card:hover {
    transform: translateY(-4px);
    border-color: rgba(72, 200, 255, 0.35);
  }

  .em-article-card__media {
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .em-article-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s ease;
  }

  .em-article-card:hover .em-article-card__img {
    transform: scale(1.04);
  }

  .em-article-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px;
  }

  .em-article-card__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
    font-family: var(--font-family-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-brand-cyan);
  }

  .em-article-card__title {
    margin: 0 0 10px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-primary);
  }

  .em-article-card__excerpt {
    margin: 0 0 18px;
    font-family: var(--font-family-body);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .em-article-card__author {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .em-article-card__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .em-article-card__author-name {
    display: block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .em-article-card__author-role {
    display: block;
    font-family: var(--font-family-body);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1100px) {
    .em-articles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .em-work__grid {
      grid-template-columns: 1fr;
    }

    .em-work__intro {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .em-power__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.86) 0%, rgba(1, 3, 7, 0.65) 55%, rgba(1, 3, 7, 0.9) 100%);
    }
  }

  @media (max-width: 600px) {
    .em-articles__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
