---
import FooterVortexCanvas from "./FooterVortexCanvas.astro";

const creativeDesignLinks = [
  { label: "Ad creative", href: "#service-ad-creative" },
  { label: "Social media creative", href: "#service-social-media" },
  { label: "Presentation design", href: "#service-presentation-design" },
  { label: "Illustration design", href: "#service-illustration-design" },
  { label: "Branding services", href: "#service-branding-services" },
  { label: "eBook & report design", href: "#service-ebook-report" },
  { label: "Concept creation", href: "#service-concept-creation" },
  { label: "Print design", href: "#service-print-design" },
  { label: "Packaging & merchandise design", href: "#service-packaging-merchandise" },
];

const productionLinks = [
  { label: "Video production", href: "#service-video-production" },
  { label: "Motion design", href: "#service-motion-design" },
  { label: "Email creation", href: "#service-email-creation" },
  { label: "Web design", href: "#service-web-design" },
  { label: "Design Systems", href: "#service-design-systems" },
  { label: "Product Design", href: "#service-product-design" },
  { label: "Copywriting", href: "#service-copywriting" },
];

const aiServiceLinks = [
  { label: "AI-powered creative", href: "#service-ai-powered-creative" },
  { label: "AI consulting", href: "#service-ai-consulting" },
  { label: "Automation", href: "#service-automation" },
  { label: "Data services", href: "#service-data-services" },
];

const marketingLinks = [
  { label: "Campaign strategy", href: "#service-campaign-strategy" },
];

const whyUsLinks = [
  { label: "Our creative talent", href: "#creative-talent" },
  { label: "AI excellence", href: "#ai-excellence" },
  { label: "Our technology", href: "#our-technology" },
  { label: "Meet your dedicated team", href: "#dedicated-team" },
];

const mainMenuLinks = [
  { label: "Our Work", href: "#our-work" },
  { label: "Resources", href: "#resources" },
  { label: "Pricing", href: "#pricing" },
  { label: "Dedicated Team", href: "#dedicated-team" },
  { label: "FAQs", href: "#faqs" },
  { label: "Book a Call", href: "#contact" },
];
---

<footer class="site-footer" id="contact" data-theme="dark">
  <FooterVortexCanvas />

  <div class="footer-inner">
    <!-- Top CTA Band -->
    <div class="footer-cta-band reveal-item">
      <div class="footer-cta-copy">
        <span class="footer-eyebrow">GET STARTED</span>
        <h2 class="footer-headline">
          Ready to fuel your <span class="title-highlight">creative engine?</span>
        </h2>
        <p class="footer-subcopy">
          Plug an AI-driven creative department into your team with unlimited requests, rapid turnarounds, and one predictable monthly subscription.
        </p>
      </div>

      <div class="footer-cta-action">
        <a href="#contact" class="adaptif-btn">
          <span>Book a Call</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 20 20"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>

    <!-- Full Menu & Submenu Sitemap -->
    <nav class="footer-sitemap reveal-item" aria-label="Footer Navigation" style="--reveal-delay: 80ms;">
      <!-- Column 1: Creative Design Services -->
      <div class="footer-col">
        <a href="#creative-design" class="footer-col-heading">
          <span>Creative Design Services</span>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <ul class="footer-link-list">
          {creativeDesignLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 2: Production Services -->
      <div class="footer-col">
        <a href="#production-services" class="footer-col-heading">
          <span>Production Services</span>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <ul class="footer-link-list">
          {productionLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 3: AI Services & Marketing Services -->
      <div class="footer-col footer-col-stacked">
        <div class="footer-subgroup">
          <a href="#ai-services" class="footer-col-heading">
            <span>AI Services</span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="footer-link-list">
            {aiServiceLinks.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-subgroup">
          <a href="#marketing-services" class="footer-col-heading">
            <span>Marketing services</span>
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul class="footer-link-list">
            {marketingLinks.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Column 4: Why Us -->
      <div class="footer-col">
        <span class="footer-col-heading is-static">Why Us</span>
        <ul class="footer-link-list">
          {whyUsLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Column 5: Navigation / Company -->
      <div class="footer-col">
        <span class="footer-col-heading is-static">Explore</span>
        <ul class="footer-link-list">
          {mainMenuLinks.map((link) => (
            <li><a href={link.href} class="footer-link">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- Bottom Brand & Legal Bar -->
    <div class="footer-bottom reveal-item" style="--reveal-delay: 140ms;">
      <div class="footer-brand-wrap">
        <a href="/" class="footer-logo-link" aria-label="Adaptif Home">
          <img
            src="/logo.svg"
            alt="Adaptif"
            class="footer-logo"
            width="124"
            height="48"
            loading="lazy"
            decoding="async"
          />
        </a>
        <span class="footer-tagline">The fuel behind your creative engine.</span>
      </div>

      <div class="footer-meta">
        <span class="footer-status">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Accepting new partners</span>
        </span>
        <span class="footer-copyright">© 2026 Adaptif. All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>

<script>
  const initFooter = () => {
    const items = document.querySelectorAll("#contact .reveal-item");
    if (!items.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -20px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  };

  initFooter();
  document.addEventListener("astro:page-load", initFooter);
</script>

<style>
  .site-footer {
    position: relative;
    width: 100vw;
    min-height: 100dvh;
    background-color: var(--color-void, #010307);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--color-text-primary, #f8fafc);
    user-select: text;
  }

  .footer-ambient-glow {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(1240px, 96vw);
    height: 92%;
    background: radial-gradient(
      ellipse 58% 52% at 50% 50%,
      rgba(72, 200, 255, 0.085) 0%,
      rgba(10, 163, 248, 0.03) 45%,
      transparent 75%
    );
    pointer-events: none;
    z-index: 0;
  }

  .footer-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-max, 1240px);
    min-height: 100dvh;
    margin: 0 auto;
    padding: clamp(118px, 14vh, 148px) clamp(20px, 3.5vw, 32px) clamp(28px, 3.5vh, 40px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(32px, 4vh, 52px);
  }

  /* Top CTA Band */
  .footer-cta-band {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: clamp(32px, 4.5vh, 48px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-cta-copy {
    max-width: 680px;
  }

  .footer-eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #48c8ff;
    margin-bottom: 12px;
  }

  .footer-headline {
    margin: 0 0 14px;
    font-family: var(--font-family-display, serif);
    font-size: clamp(2.4rem, 4.4vw, 3.85rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #ffffff;
  }

  .footer-headline .title-highlight {
    font-style: italic;
    background: linear-gradient(135deg, #7fe2ff 0%, #48c8ff 50%, #1da5ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
    padding-right: 0.06em;
    filter: drop-shadow(0 2px 14px rgba(72, 200, 255, 0.4));
  }

  .footer-subcopy {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: clamp(0.94rem, 1.15vw, 1.04rem);
    line-height: 1.55;
    color: rgba(226, 232, 240, 0.72);
    max-width: 560px;
  }

  .footer-cta-action {
    flex-shrink: 0;
  }

  /* Sitemap Grid */
  .footer-sitemap {
    display: grid;
    grid-template-columns: 1.2fr 1.05fr 1fr 0.95fr 0.85fr;
    gap: clamp(24px, 3vw, 40px);
    align-items: start;
  }

  .footer-col-stacked {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .footer-col-heading {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-family-body);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #48c8ff;
    margin-bottom: 16px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col-heading svg {
    opacity: 0.7;
    transition: transform 0.25s var(--ease-spring), opacity 0.2s ease;
  }

  a.footer-col-heading:hover {
    color: #9ce6ff;
  }

  a.footer-col-heading:hover svg {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  .footer-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.4;
    color: rgba(241, 245, 249, 0.86);
    text-shadow: 0 1px 8px rgba(3, 7, 18, 0.85);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s var(--ease-spring);
  }

  .footer-link:hover {
    color: #ffffff;
    transform: translateX(3px);
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: clamp(22px, 3vh, 30px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-brand-wrap {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
  }

  .footer-logo {
    height: 32px;
    width: auto;
    display: block;
  }

  .footer-tagline {
    font-family: var(--font-family-body);
    font-size: 0.85rem;
    color: rgba(148, 163, 184, 0.8);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-pill, 9999px);
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.2);
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 500;
    color: #9ce6ff;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px rgba(56, 189, 248, 0.85);
  }

  .footer-copyright {
    font-family: var(--font-family-body);
    font-size: 0.82rem;
    color: rgba(148, 163, 184, 0.75);
  }

  /* Reveal Animation */
  .reveal-item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .reveal-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .footer-sitemap {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 24px;
    }
  }

  @media (max-width: 768px) {
    .footer-cta-band {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .footer-sitemap {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 20px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }

  @media (max-width: 480px) {
    .footer-sitemap {
      grid-template-columns: 1fr;
    }
  }
</style>
