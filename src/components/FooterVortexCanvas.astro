---
---

<div class="footer-vortex-layer" aria-hidden="true">
  <canvas id="footer-vortex-canvas" class="footer-vortex-canvas"></canvas>
  <div class="footer-vortex-scrim"></div>
</div>

<script>
  import * as THREE from "three";

  const initFooterVortex = () => {
    const canvas = document.getElementById("footer-vortex-canvas") as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.initialized === "true") return;
    canvas.dataset.initialized = "true";

    const footer = canvas.closest("footer");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
    } catch {
      return;
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 100);
    camera.position.set(0, 0.18, 2.35);
    camera.lookAt(0, 0, 0);

    // -----------------------------------------------------------------------
    // 1. Procedural Translucent Painterly Cosmic Vortex Shader (3D Perspective)
    // -----------------------------------------------------------------------
    const vortexVertexShader = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = vec4(position, 1.0);
      }
    `;

    const vortexFragmentShader = `
      precision highp float;
      varying vec2 vUv;
      uniform float uTime;
      uniform vec2 uResolution;
      uniform vec2 uMouse;

      float hash(vec2 p) {
        p = fract(p * vec2(123.34, 456.21));
        p += dot(p, p + 45.32);
        return fract(p.x * p.y);
      }

      float noise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = hash(i);
        float b = hash(i + vec2(1.0, 0.0));
        float c = hash(i + vec2(0.0, 1.0));
        float d = hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
      }

      float fbm(vec2 p) {
        float v = 0.0;
        float a = 0.5;
        mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
        for (int i = 0; i < 5; i++) {
          v += a * noise(p);
          p = rot * p * 2.04 + vec2(1.7, 9.2);
          a *= 0.5;
        }
        return v;
      }

      void main() {
        vec2 aspect = vec2(uResolution.x / max(uResolution.y, 1.0), 1.0);
        vec2 uv = (vUv - 0.5) * aspect;

        // Subtle mouse parallax
        uv += (uMouse - 0.5) * 0.03;

        // Diagonal galaxy tilt
        float tilt = -0.16;
        float ct = cos(tilt);
        float st = sin(tilt);
        vec2 q = mat2(ct, -st, st, ct) * uv;

        // True 3D perspective projection onto an inclined galactic plane
        // Near edge (bottom) expands toward viewer; far edge (top) recedes
        float persp = 1.0 / max(0.32, 1.0 + q.y * 0.62);
        vec2 p = vec2(q.x * persp, q.y * 1.65 * persp);

        float r = length(p);
        float angle = atan(p.y, p.x);

        // Slower, graceful differential spiral rotation
        float invR = 1.0 / (r + 0.18);
        float spin = uTime * 0.045;
        float spiralAngle = angle + invR * 2.15 - spin * (0.6 + 0.45 * invR);

        // Domain-warped translucent nebula currents
        vec2 warpCoord = vec2(
          cos(spiralAngle) * (r * 3.0 + 0.35),
          sin(spiralAngle) * (r * 3.0 + 0.35)
        );
        float n1 = fbm(warpCoord * 1.4 + vec2(uTime * 0.012, -uTime * 0.01));
        float n2 = fbm(warpCoord * 2.9 - vec2(n1 * 1.3) + vec2(-uTime * 0.015));

        float arms = sin(spiralAngle * 2.0 + n1 * 4.0 + log(r + 0.08) * 3.5);
        float filaments = sin(spiralAngle * 5.0 - n2 * 5.2 + r * 7.0);
        float swirl = smoothstep(-0.3, 0.9, arms * 0.65 + filaments * 0.35 + (n2 - 0.5) * 0.75);

        // Radial envelope: deep black hole center, translucent accretion cloud, soft outer fade
        float holeMask = smoothstep(0.14, 0.34, r + (n1 - 0.5) * 0.04);
        float innerRim = exp(-pow((r - 0.30) * 4.8, 2.0));
        float midDisk = exp(-pow((r - 0.56) * 1.9, 2.0));
        float outerGlow = exp(-r * 1.25);

        // Palette matching reference + Adaptif #21BCFF cyan, tuned for airy translucency
        vec3 cVoid = vec3(0.012, 0.024, 0.058);
        vec3 cCobalt = vec3(0.05, 0.16, 0.34);
        vec3 cSlateBlue = vec3(0.12, 0.28, 0.46);
        vec3 cBrandCyan = vec3(0.129, 0.737, 1.0); // #21BCFF
        vec3 cViolet = vec3(0.22, 0.13, 0.32);
        vec3 cAmber = vec3(0.72, 0.36, 0.11);
        vec3 cGold = vec3(0.95, 0.70, 0.28);
        vec3 cSpark = vec3(1.0, 0.92, 0.74);

        vec3 col = cVoid;

        // Translucent nebula layers with #21BCFF cyan highlights
        float blueBand = smoothstep(0.22, 0.88, n1) * outerGlow;
        col = mix(col, cCobalt, blueBand * 0.44);
        col = mix(col, cSlateBlue, smoothstep(0.5, 0.94, n2) * midDisk * 0.34);
        col += cBrandCyan * smoothstep(0.42, 0.95, n2) * (midDisk * 0.26 + innerRim * 0.22);
        col += cViolet * innerRim * (0.4 + 0.6 * n1) * 0.28;

        float warmMask = swirl * (midDisk * 0.62 + outerGlow * 0.24);
        col = mix(col, cAmber, clamp(warmMask * 0.68, 0.0, 1.0));
        col += cGold * pow(clamp(warmMask, 0.0, 1.0), 1.7) * (0.45 + 0.4 * n2);
        col += cSpark * pow(clamp(swirl * n2 * midDisk, 0.0, 1.0), 3.0) * 0.58;

        // Black hole core
        col *= holeMask;

        // Seamless edge blend into #030712
        float edgeFade = 1.0 - smoothstep(0.65, 1.55, length(uv));
        col = mix(vec3(0.012, 0.027, 0.071), col, edgeFade);

        gl_FragColor = vec4(col, 1.0);
      }
    `;

    const vortexUniforms = {
      uTime: { value: 0 },
      uResolution: { value: new THREE.Vector2(1, 1) },
      uMouse: { value: new THREE.Vector2(0.5, 0.5) },
    };

    const vortexGeo = new THREE.PlaneGeometry(2, 2);
    const vortexMat = new THREE.ShaderMaterial({
      vertexShader: vortexVertexShader,
      fragmentShader: vortexFragmentShader,
      uniforms: vortexUniforms,
      depthWrite: false,
      depthTest: false,
    });
    const vortexMesh = new THREE.Mesh(vortexGeo, vortexMat);
    vortexMesh.frustumCulled = false;
    scene.add(vortexMesh);

    // Shared 3D galaxy group inclined in true 3D perspective
    const galaxyGroup = new THREE.Group();
    galaxyGroup.rotation.x = -0.92; // ~53 deg perspective tilt
    galaxyGroup.rotation.z = 0.16;  // subtle diagonal angle
    scene.add(galaxyGroup);

    // -----------------------------------------------------------------------
    // 2. Orbiting Golden, White & #21BCFF Stardust & Fine Stars (3D Spiral)
    // -----------------------------------------------------------------------
    const dustCount = 8500;
    const dustPositions = new Float32Array(dustCount * 3);
    const dustData = new Float32Array(dustCount * 4); // radius, angle, speed, size
    const dustTint = new Float32Array(dustCount);      // 0..1 color selector

    for (let i = 0; i < dustCount; i++) {
      const r = 0.24 + Math.pow(Math.random(), 1.05) * 1.85;
      const armOffset = (i % 2) * Math.PI;
      const angle = armOffset + r * 3.0 + (Math.random() - 0.5) * 3.2;
      const speed = (0.12 + Math.random() * 0.12) / (r + 0.28);
      const size = 1.0 + Math.random() * 2.9;

      dustData[i * 4] = r;
      dustData[i * 4 + 1] = angle;
      dustData[i * 4 + 2] = speed;
      dustData[i * 4 + 3] = size;
      dustTint[i] = Math.random();

      dustPositions[i * 3] = Math.cos(angle) * r;
      dustPositions[i * 3 + 1] = Math.sin(angle) * r;
      dustPositions[i * 3 + 2] = (Math.random() - 0.5) * 0.14 - 0.16 / (r + 0.35);
    }

    const dustGeo = new THREE.BufferGeometry();
    dustGeo.setAttribute("position", new THREE.BufferAttribute(dustPositions, 3));
    dustGeo.setAttribute("aData", new THREE.BufferAttribute(dustData, 4));
    dustGeo.setAttribute("aTint", new THREE.BufferAttribute(dustTint, 1));

    const dustMat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uPixelRatio: { value: dpr },
      },
      vertexShader: `
        attribute vec4 aData;
        attribute float aTint;
        uniform float uTime;
        uniform float uPixelRatio;
        varying float vAlpha;
        varying float vHeat;
        varying float vTint;

        void main() {
          float r = aData.x;
          float angle0 = aData.y;
          float speed = aData.z;
          float size = aData.w;

          // Slower spiral orbit
          float a = angle0 - uTime * speed * 0.14;
          vec3 localPos = vec3(cos(a) * r, sin(a) * r, position.z);

          vec4 mvPosition = modelViewMatrix * vec4(localPos, 1.0);
          gl_Position = projectionMatrix * mvPosition;
          gl_PointSize = size * uPixelRatio * (2.6 / max(-mvPosition.z, 0.5));

          float twinkle = 0.65 + 0.35 * sin(uTime * 1.4 + angle0 * 7.0);
          float holeFade = smoothstep(0.22, 0.38, r);
          float outerFade = 1.0 - smoothstep(1.45, 2.1, r);
          vAlpha = twinkle * holeFade * outerFade * 0.94;
          vHeat = clamp(1.0 - (r - 0.25) * 0.55, 0.0, 1.0);
          vTint = aTint;
        }
      `,
      fragmentShader: `
        varying float vAlpha;
        varying float vHeat;
        varying float vTint;
        void main() {
          vec2 c = gl_PointCoord - 0.5;
          float d = length(c);
          if (d > 0.5) discard;
          float glow = pow(1.0 - d * 2.0, 2.0);
          vec3 warmCol = mix(vec3(0.95, 0.65, 0.28), vec3(1.0, 0.96, 0.86), vHeat);
          vec3 cyanCol = vec3(0.129, 0.737, 1.0); // #21BCFF
          // ~30% of stars carry the #21BCFF cyan glow
          vec3 col = mix(warmCol, cyanCol, smoothstep(0.68, 0.88, vTint));
          gl_FragColor = vec4(col, glow * vAlpha);
        }
      `,
    });

    const dustPoints = new THREE.Points(dustGeo, dustMat);
    galaxyGroup.add(dustPoints);

    // -----------------------------------------------------------------------
    // 3. Bright 4-Point Diffraction Spike Stars (Orbiting in Spiral!)
    // -----------------------------------------------------------------------
    const starCount = 240;
    const starPositions = new Float32Array(starCount * 3);
    const starOrbits = new Float32Array(starCount * 4); // radius, angle0, speed, size
    const starSeeds = new Float32Array(starCount * 2);  // phase, warmth

    for (let i = 0; i < starCount; i++) {
      const r = 0.34 + Math.pow(Math.random(), 0.95) * 1.65;
      const armOffset = (i % 2) * Math.PI;
      const angle = armOffset + r * 2.6 + (Math.random() - 0.5) * 3.4;
      const speed = (0.10 + Math.random() * 0.10) / (r + 0.3);
      const size = 14.0 + Math.random() * 24.0;

      starOrbits[i * 4] = r;
      starOrbits[i * 4 + 1] = angle;
      starOrbits[i * 4 + 2] = speed;
      starOrbits[i * 4 + 3] = size;

      starPositions[i * 3] = Math.cos(angle) * r;
      starPositions[i * 3 + 1] = Math.sin(angle) * r;
      starPositions[i * 3 + 2] = (Math.random() - 0.5) * 0.18 - 0.12 / (r + 0.35);

      starSeeds[i * 2] = Math.random() * Math.PI * 2.0;
      starSeeds[i * 2 + 1] = Math.random(); // 0 = cool white, 1 = warm gold
    }

    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute("position", new THREE.BufferAttribute(starPositions, 3));
    starGeo.setAttribute("aOrbit", new THREE.BufferAttribute(starOrbits, 4));
    starGeo.setAttribute("aSeed", new THREE.BufferAttribute(starSeeds, 2));

    const starMat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uPixelRatio: { value: dpr },
      },
      vertexShader: `
        attribute vec4 aOrbit;
        attribute vec2 aSeed;
        uniform float uTime;
        uniform float uPixelRatio;
        varying float vTwinkle;
        varying float vWarmth;
        varying float vFade;

        void main() {
          float r = aOrbit.x;
          float angle0 = aOrbit.y;
          float speed = aOrbit.z;
          float size = aOrbit.w;

          // Spiral orbit synchronized with the galaxy
          float a = angle0 - uTime * speed * 0.14;
          vec3 localPos = vec3(cos(a) * r, sin(a) * r, position.z);

          vec4 mvPosition = modelViewMatrix * vec4(localPos, 1.0);
          gl_Position = projectionMatrix * mvPosition;

          vTwinkle = 0.68 + 0.32 * sin(uTime * 1.2 + aSeed.x);
          vWarmth = aSeed.y;
          vFade = smoothstep(0.28, 0.45, r) * (1.0 - smoothstep(1.45, 2.0, r));

          gl_PointSize = size * uPixelRatio * (2.4 / max(-mvPosition.z, 0.5)) * (0.85 + 0.15 * vTwinkle);
        }
      `,
      fragmentShader: `
        varying float vTwinkle;
        varying float vWarmth;
        varying float vFade;
        void main() {
          vec2 uv = gl_PointCoord - 0.5;
          float d = length(uv);
          if (d > 0.5) discard;

          float core = exp(-d * 13.0);
          float spikeH = exp(-abs(uv.y) * 34.0) * exp(-abs(uv.x) * 6.0);
          float spikeV = exp(-abs(uv.x) * 34.0) * exp(-abs(uv.y) * 6.0);
          float intensity = clamp(core + (spikeH + spikeV) * 0.78, 0.0, 1.0);

          vec3 coolStar = vec3(0.88, 0.95, 1.0);
          vec3 warmStar = vec3(1.0, 0.87, 0.56);
          vec3 cyanStar = vec3(0.129, 0.737, 1.0); // #21BCFF
          vec3 col = mix(coolStar, warmStar, smoothstep(0.0, 0.65, vWarmth));
          col = mix(col, cyanStar, smoothstep(0.68, 0.92, vWarmth));

          gl_FragColor = vec4(col, intensity * vTwinkle * vFade * 0.95);
        }
      `,
    });

    const starPoints = new THREE.Points(starGeo, starMat);
    galaxyGroup.add(starPoints);

    // -----------------------------------------------------------------------
    // Resize, Mouse Parallax & Visibility Loop
    // -----------------------------------------------------------------------
    const handleResize = () => {
      const rect = canvas.parentElement?.getBoundingClientRect();
      const width = rect?.width || window.innerWidth;
      const height = rect?.height || window.innerHeight;
      renderer.setSize(width, height, false);
      camera.aspect = width / Math.max(height, 1);
      camera.updateProjectionMatrix();
      vortexUniforms.uResolution.value.set(width, height);
    };

    handleResize();
    window.addEventListener("resize", handleResize);

    const targetMouse = { x: 0.5, y: 0.5 };
    const currentMouse = { x: 0.5, y: 0.5 };

    const handlePointerMove = (e: PointerEvent) => {
      targetMouse.x = e.clientX / Math.max(window.innerWidth, 1);
      targetMouse.y = 1.0 - e.clientY / Math.max(window.innerHeight, 1);
    };

    if (footer) {
      footer.addEventListener("pointermove", handlePointerMove, { passive: true });
    }

    let isVisible = true;
    const observer = new IntersectionObserver(
      (entries) => {
        isVisible = entries[0]?.isIntersecting ?? true;
      },
      { threshold: 0.02 }
    );
    if (footer) observer.observe(footer);

    const clock = new THREE.Clock();
    let rafId = 0;

    const renderFrame = () => {
      rafId = requestAnimationFrame(renderFrame);
      if (!isVisible) return;

      const elapsed = prefersReducedMotion ? 0 : clock.getElapsedTime();
      currentMouse.x += (targetMouse.x - currentMouse.x) * 0.04;
      currentMouse.y += (targetMouse.y - currentMouse.y) * 0.04;

      // Subtle 3D camera parallax
      camera.position.x = (currentMouse.x - 0.5) * 0.14;
      camera.position.y = 0.18 + (currentMouse.y - 0.5) * 0.08;
      camera.lookAt(0, 0, 0);

      vortexUniforms.uTime.value = elapsed;
      vortexUniforms.uMouse.value.set(currentMouse.x, currentMouse.y);
      dustMat.uniforms.uTime.value = elapsed;
      starMat.uniforms.uTime.value = elapsed;

      renderer.render(scene, camera);
    };

    renderFrame();

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(rafId);
        observer.disconnect();
        window.removeEventListener("resize", handleResize);
        if (footer) footer.removeEventListener("pointermove", handlePointerMove);
        renderer.dispose();
        vortexGeo.dispose();
        vortexMat.dispose();
        dustGeo.dispose();
        dustMat.dispose();
        starGeo.dispose();
        starMat.dispose();
      },
      { once: true }
    );
  };

  initFooterVortex();
  document.addEventListener("astro:page-load", initFooterVortex);
</script>

<style>
  .footer-vortex-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .footer-vortex-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.94;
  }

  .footer-vortex-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(3, 7, 18, 0.86) 0%,
        rgba(3, 7, 18, 0.38) 22%,
        rgba(3, 7, 18, 0.44) 72%,
        rgba(3, 7, 18, 0.88) 100%
      ),
      radial-gradient(
        ellipse 75% 65% at 50% 52%,
        rgba(3, 7, 18, 0.1) 0%,
        rgba(3, 7, 18, 0.58) 100%
      );
    pointer-events: none;
  }
</style>
