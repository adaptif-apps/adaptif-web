---
---

<div class="footer-vortex-layer" aria-hidden="true">
  <canvas id="footer-vortex-canvas" class="footer-vortex-canvas"></canvas>
  <div class="footer-vortex-scrim"></div>
</div>

<script>
  import * as THREE from "three";

  const initFooterVortex = () => {
    const canvas = document.getElementById("footer-vortex-canvas") as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.initialized === "true") return;
    canvas.dataset.initialized = "true";

    const footer = canvas.closest("footer");
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
    } catch {
      return;
    }

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    renderer.setPixelRatio(dpr);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.z = 2.4;

    // -----------------------------------------------------------------------
    // 1. Procedural Painterly Cosmic Vortex Shader
    // -----------------------------------------------------------------------
    const vortexVertexShader = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = vec4(position, 1.0);
      }
    `;

    const vortexFragmentShader = `
      precision highp float;
      varying vec2 vUv;
      uniform float uTime;
      uniform vec2 uResolution;
      uniform vec2 uMouse;

      // Hash & 2D Simplex-like Value Noise
      float hash(vec2 p) {
        p = fract(p * vec2(123.34, 456.21));
        p += dot(p, p + 45.32);
        return fract(p.x * p.y);
      }

      float noise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = hash(i);
        float b = hash(i + vec2(1.0, 0.0));
        float c = hash(i + vec2(0.0, 1.0));
        float d = hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
      }

      float fbm(vec2 p) {
        float v = 0.0;
        float a = 0.5;
        mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
        for (int i = 0; i < 5; i++) {
          v += a * noise(p);
          p = rot * p * 2.04 + vec2(1.7, 9.2);
          a *= 0.5;
        }
        return v;
      }

      void main() {
        vec2 aspect = vec2(uResolution.x / max(uResolution.y, 1.0), 1.0);
        vec2 uv = (vUv - 0.5) * aspect;

        // Subtle mouse parallax
        uv += (uMouse - 0.5) * 0.035;

        // Perspective tilt to match the oval funnel in the reference
        vec2 p = uv;
        p.y *= 1.38;
        // Slight diagonal tilt
        float tilt = -0.14;
        float ct = cos(tilt);
        float st = sin(tilt);
        p = mat2(ct, -st, st, ct) * p;

        float r = length(p);
        float angle = atan(p.y, p.x);

        // Differential spiral twist (stronger near the event horizon)
        float invR = 1.0 / (r + 0.16);
        float spin = uTime * 0.16;
        float spiralAngle = angle + invR * 2.05 - spin * (0.65 + 0.55 * invR);

        // Domain-warped painterly brush strokes along the spiral
        vec2 warpCoord = vec2(
          cos(spiralAngle) * (r * 3.2 + 0.4),
          sin(spiralAngle) * (r * 3.2 + 0.4)
        );
        float n1 = fbm(warpCoord * 1.45 + vec2(uTime * 0.04, -uTime * 0.03));
        float n2 = fbm(warpCoord * 3.1 - vec2(n1 * 1.35) + vec2(-uTime * 0.05));

        // Spiral arm density (2 major + harmonic filaments)
        float arms = sin(spiralAngle * 2.0 + n1 * 4.2 + log(r + 0.08) * 3.6);
        float filaments = sin(spiralAngle * 5.0 - n2 * 5.5 + r * 7.5);
        float swirl = smoothstep(-0.35, 0.88, arms * 0.65 + filaments * 0.35 + (n2 - 0.5) * 0.8);

        // Radial envelope: deep black event horizon in center, glowing accretion band, soft outer falloff
        float holeMask = smoothstep(0.14, 0.31, r + (n1 - 0.5) * 0.04);
        float innerRim = exp(-pow((r - 0.28) * 5.2, 2.0));
        float midDisk = exp(-pow((r - 0.52) * 2.1, 2.0));
        float outerGlow = exp(-r * 1.35);

        // Color Palette matching reference image
        vec3 cVoid = vec3(0.008, 0.014, 0.032);
        vec3 cCobalt = vec3(0.06, 0.17, 0.34);
        vec3 cSlateBlue = vec3(0.14, 0.31, 0.50);
        vec3 cViolet = vec3(0.24, 0.14, 0.34);
        vec3 cAmber = vec3(0.76, 0.37, 0.11);
        vec3 cGold = vec3(0.98, 0.72, 0.28);
        vec3 cSpark = vec3(1.0, 0.93, 0.76);

        // Base cosmic canvas
        vec3 col = cVoid;

        // Deep blue & violet swirling currents
        float blueBand = smoothstep(0.15, 0.85, n1) * outerGlow;
        col = mix(col, cCobalt, blueBand * 0.92);
        col = mix(col, cSlateBlue, smoothstep(0.45, 0.92, n2) * midDisk * 0.78);
        col += cViolet * innerRim * (0.45 + 0.55 * n1) * 0.65;

        // Warm copper, amber & golden accretion streams
        float warmMask = swirl * (midDisk * 1.15 + outerGlow * 0.45);
        col = mix(col, cAmber, clamp(warmMask * 0.95, 0.0, 1.0));
        col += cGold * pow(clamp(warmMask, 0.0, 1.0), 1.8) * (0.75 + 0.55 * n2);
        col += cSpark * pow(clamp(swirl * n2 * midDisk, 0.0, 1.0), 3.0) * 1.25;

        // Carve out the black hole center with a crisp dark depth
        col *= holeMask;

        // Subtle outer vignette so edges blend seamlessly into #030712
        float edgeFade = 1.0 - smoothstep(0.65, 1.45, length(uv));
        col = mix(vec3(0.012, 0.027, 0.071), col, edgeFade);

        gl_FragColor = vec4(col, 1.0);
      }
    `;

    const vortexUniforms = {
      uTime: { value: 0 },
      uResolution: { value: new THREE.Vector2(1, 1) },
      uMouse: { value: new THREE.Vector2(0.5, 0.5) },
    };

    const vortexGeo = new THREE.PlaneGeometry(2, 2);
    const vortexMat = new THREE.ShaderMaterial({
      vertexShader: vortexVertexShader,
      fragmentShader: vortexFragmentShader,
      uniforms: vortexUniforms,
      depthWrite: false,
      depthTest: false,
    });
    const vortexMesh = new THREE.Mesh(vortexGeo, vortexMat);
    vortexMesh.frustumCulled = false;
    scene.add(vortexMesh);

    // -----------------------------------------------------------------------
    // 2. Orbiting Golden Stardust Particles
    // -----------------------------------------------------------------------
    const dustCount = 2200;
    const dustPositions = new Float32Array(dustCount * 3);
    const dustData = new Float32Array(dustCount * 4); // radius, angle, speed, size

    for (let i = 0; i < dustCount; i++) {
      // Bias density toward the glowing accretion band (0.28 - 1.15)
      const r = 0.24 + Math.pow(Math.random(), 1.25) * 1.15;
      const armOffset = (i % 2) * Math.PI;
      const angle = armOffset + r * 3.1 + (Math.random() - 0.5) * 2.4;
      const speed = (0.14 + Math.random() * 0.14) / (r + 0.22);
      const size = 1.0 + Math.random() * 2.6;

      dustData[i * 4] = r;
      dustData[i * 4 + 1] = angle;
      dustData[i * 4 + 2] = speed;
      dustData[i * 4 + 3] = size;

      dustPositions[i * 3] = Math.cos(angle) * r;
      dustPositions[i * 3 + 1] = (Math.sin(angle) * r) / 1.38;
      dustPositions[i * 3 + 2] = (Math.random() - 0.5) * 0.08;
    }

    const dustGeo = new THREE.BufferGeometry();
    dustGeo.setAttribute("position", new THREE.BufferAttribute(dustPositions, 3));
    dustGeo.setAttribute("aData", new THREE.BufferAttribute(dustData, 4));

    const dustMat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uPixelRatio: { value: dpr },
      },
      vertexShader: `
        attribute vec4 aData;
        uniform float uTime;
        uniform float uPixelRatio;
        varying float vAlpha;
        varying float vHeat;

        void main() {
          float r = aData.x;
          float angle0 = aData.y;
          float speed = aData.z;
          float size = aData.w;

          float a = angle0 - uTime * speed * 0.45;
          vec2 pos2d = vec2(cos(a) * r, sin(a) * r / 1.38);

          // Match slight diagonal tilt
          float tilt = 0.14;
          float ct = cos(tilt);
          float st = sin(tilt);
          pos2d = mat2(ct, -st, st, ct) * pos2d;

          vec4 mvPosition = modelViewMatrix * vec4(pos2d, position.z, 1.0);
          gl_Position = projectionMatrix * mvPosition;
          gl_PointSize = size * uPixelRatio * (2.2 / max(-mvPosition.z, 0.5));

          float twinkle = 0.65 + 0.35 * sin(uTime * 1.8 + angle0 * 7.0);
          float holeFade = smoothstep(0.22, 0.36, r);
          float outerFade = 1.0 - smoothstep(0.95, 1.42, r);
          vAlpha = twinkle * holeFade * outerFade * 0.85;
          vHeat = clamp(1.0 - (r - 0.25) * 0.75, 0.0, 1.0);
        }
      `,
      fragmentShader: `
        varying float vAlpha;
        varying float vHeat;
        void main() {
          vec2 c = gl_PointCoord - 0.5;
          float d = length(c);
          if (d > 0.5) discard;
          float glow = pow(1.0 - d * 2.0, 2.2);
          vec3 col = mix(vec3(0.95, 0.62, 0.24), vec3(1.0, 0.94, 0.78), vHeat);
          gl_FragColor = vec4(col, glow * vAlpha);
        }
      `,
    });

    const dustPoints = new THREE.Points(dustGeo, dustMat);
    scene.add(dustPoints);

    // -----------------------------------------------------------------------
    // 3. Bright 4-Point Diffraction Spike Stars
    // -----------------------------------------------------------------------
    const starCount = 42;
    const starPositions = new Float32Array(starCount * 3);
    const starSeeds = new Float32Array(starCount * 3); // size, phase, warmth

    for (let i = 0; i < starCount; i++) {
      // Keep stars mostly outside the black hole core
      const angle = Math.random() * Math.PI * 2;
      const dist = 0.38 + Math.random() * 1.05;
      starPositions[i * 3] = Math.cos(angle) * dist * 1.25;
      starPositions[i * 3 + 1] = Math.sin(angle) * dist * 0.78;
      starPositions[i * 3 + 2] = 0.05;

      starSeeds[i * 3] = 14.0 + Math.random() * 22.0;
      starSeeds[i * 3 + 1] = Math.random() * Math.PI * 2.0;
      starSeeds[i * 3 + 2] = Math.random(); // 0 = cool white, 1 = warm gold
    }

    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute("position", new THREE.BufferAttribute(starPositions, 3));
    starGeo.setAttribute("aSeed", new THREE.BufferAttribute(starSeeds, 3));

    const starMat = new THREE.ShaderMaterial({
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uPixelRatio: { value: dpr },
      },
      vertexShader: `
        attribute vec3 aSeed;
        uniform float uTime;
        uniform float uPixelRatio;
        varying float vTwinkle;
        varying float vWarmth;

        void main() {
          vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
          gl_Position = projectionMatrix * mvPosition;
          vTwinkle = 0.65 + 0.35 * sin(uTime * 1.4 + aSeed.y);
          vWarmth = aSeed.z;
          gl_PointSize = aSeed.x * uPixelRatio * (0.85 + 0.15 * vTwinkle);
        }
      `,
      fragmentShader: `
        varying float vTwinkle;
        varying float vWarmth;
        void main() {
          vec2 uv = gl_PointCoord - 0.5;
          float d = length(uv);
          if (d > 0.5) discard;

          // Core + 4-point diffraction spikes
          float core = exp(-d * 14.0);
          float spikeH = exp(-abs(uv.y) * 34.0) * exp(-abs(uv.x) * 6.5);
          float spikeV = exp(-abs(uv.x) * 34.0) * exp(-abs(uv.y) * 6.5);
          float intensity = clamp(core + (spikeH + spikeV) * 0.75, 0.0, 1.0);

          vec3 coolStar = vec3(0.86, 0.94, 1.0);
          vec3 warmStar = vec3(1.0, 0.85, 0.52);
          vec3 col = mix(coolStar, warmStar, vWarmth);

          gl_FragColor = vec4(col, intensity * vTwinkle * 0.9);
        }
      `,
    });

    const starPoints = new THREE.Points(starGeo, starMat);
    scene.add(starPoints);

    // -----------------------------------------------------------------------
    // Resize, Mouse & Visibility Loop
    // -----------------------------------------------------------------------
    const handleResize = () => {
      const rect = canvas.parentElement?.getBoundingClientRect();
      const width = rect?.width || window.innerWidth;
      const height = rect?.height || window.innerHeight;
      renderer.setSize(width, height, false);
      camera.aspect = width / Math.max(height, 1);
      camera.updateProjectionMatrix();
      vortexUniforms.uResolution.value.set(width, height);
    };

    handleResize();
    window.addEventListener("resize", handleResize);

    const targetMouse = { x: 0.5, y: 0.5 };
    const currentMouse = { x: 0.5, y: 0.5 };

    const handlePointerMove = (e: PointerEvent) => {
      targetMouse.x = e.clientX / Math.max(window.innerWidth, 1);
      targetMouse.y = 1.0 - e.clientY / Math.max(window.innerHeight, 1);
    };

    if (footer) {
      footer.addEventListener("pointermove", handlePointerMove, { passive: true });
    }

    let isVisible = true;
    const observer = new IntersectionObserver(
      (entries) => {
        isVisible = entries[0]?.isIntersecting ?? true;
      },
      { threshold: 0.02 }
    );
    if (footer) observer.observe(footer);

    const clock = new THREE.Clock();
    let rafId = 0;

    const renderFrame = () => {
      rafId = requestAnimationFrame(renderFrame);
      if (!isVisible) return;

      const elapsed = prefersReducedMotion ? 0 : clock.getElapsedTime();
      currentMouse.x += (targetMouse.x - currentMouse.x) * 0.04;
      currentMouse.y += (targetMouse.y - currentMouse.y) * 0.04;

      vortexUniforms.uTime.value = elapsed;
      vortexUniforms.uMouse.value.set(currentMouse.x, currentMouse.y);
      dustMat.uniforms.uTime.value = elapsed;
      starMat.uniforms.uTime.value = elapsed;

      renderer.render(scene, camera);
    };

    renderFrame();

    // Cleanup on Astro view transition if applicable
    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(rafId);
        observer.disconnect();
        window.removeEventListener("resize", handleResize);
        if (footer) footer.removeEventListener("pointermove", handlePointerMove);
        renderer.dispose();
        vortexGeo.dispose();
        vortexMat.dispose();
        dustGeo.dispose();
        dustMat.dispose();
        starGeo.dispose();
        starMat.dispose();
      },
      { once: true }
    );
  };

  initFooterVortex();
  document.addEventListener("astro:page-load", initFooterVortex);
</script>

<style>
  .footer-vortex-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .footer-vortex-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0.92;
  }

  /* Subtle dark scrim & top-edge blend so footer typography stays crisp */
  .footer-vortex-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(3, 7, 18, 0.86) 0%,
        rgba(3, 7, 18, 0.42) 22%,
        rgba(3, 7, 18, 0.48) 72%,
        rgba(3, 7, 18, 0.88) 100%
      ),
      radial-gradient(
        ellipse 75% 65% at 50% 52%,
        rgba(3, 7, 18, 0.12) 0%,
        rgba(3, 7, 18, 0.62) 100%
      );
    pointer-events: none;
  }
</style>
