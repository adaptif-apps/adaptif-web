<script>
  function setElementTextPreservingIcons(el: HTMLElement, newText: string) {
    const svg = el.querySelector("svg");
    if (svg) {
      const textSpan = el.querySelector("span:not(:has(svg))");
      if (textSpan && el.children.length <= 2) {
        textSpan.textContent = newText;
        return;
      }
      for (const node of Array.from(el.childNodes)) {
        if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
          node.textContent = newText + " ";
          return;
        }
      }
    }
    el.textContent = newText;
  }

  function assignAutoCmsKeys() {
    const roots = document.querySelectorAll<HTMLElement>("header, main, footer");
    let sectionIdx = 0;
    const counters: Record<string, number> = {};

    const nextKey = (scope: string, tag: string) => {
      const prefix = `${scope}.${tag}`;
      counters[prefix] = (counters[prefix] || 0) + 1;
      return `auto.${prefix}.${counters[prefix]}`;
    };

    const isIgnored = (el: HTMLElement) =>
      Boolean(
        el.closest("#gce-root, #book-call-modal, #adaptif-whatsapp-fab, [aria-hidden='true'], script, style, noscript, svg")
      );

    function tagElementsInScope(container: HTMLElement, scope: string) {
      const candidates = container.querySelectorAll<HTMLElement>(
        'h1, h2, h3, h4, h5, h6, p, li, blockquote, figcaption, a, button, img, span, [class*="eyebrow"]'
      );
      candidates.forEach((el) => {
        if (el.dataset.cmsKey || isIgnored(el)) return;
        const tag = el.tagName.toLowerCase();

        if (tag === "img") {
          const img = el as HTMLImageElement;
          if (!img.getAttribute("src")) return;
          el.dataset.cmsKey = nextKey(scope, "img");
          return;
        }

        if (tag === "a" || tag === "button") {
          const txt = (el.textContent || "").trim();
          if (!txt && !el.getAttribute("href")) return;
          el.dataset.cmsKey = nextKey(scope, tag);
          return;
        }

        if (tag === "span" || el.className?.toString().includes("eyebrow")) {
          if (el.closest("h1, h2, h3, h4, h5, h6, p, li, a, button, [data-cms-key]")) return;
          const hasNonBrChild = Array.from(el.children).some((c) => c.tagName !== "BR");
          if (hasNonBrChild) return;
          const txt = (el.textContent || "").trim();
          if (!txt) return;
          el.dataset.cmsKey = nextKey(scope, "text");
          return;
        }

        if (el.querySelector("h1, h2, h3, h4, h5, h6, p, ul, ol, section, article")) return;
        const txt = (el.textContent || "").trim();
        if (!txt) return;
        el.dataset.cmsKey = nextKey(scope, tag);
      });
    }

    roots.forEach((root) => {
      const rootName = root.tagName.toLowerCase();
      if (rootName === "main") {
        const sections = root.querySelectorAll<HTMLElement>(":scope > section, :scope > div");
        const containers = sections.length > 0 ? Array.from(sections) : [root];
        containers.forEach((sec) => {
          sectionIdx += 1;
          const scope = sec.id ? `s-${sec.id}` : `s${sectionIdx}`;
          tagElementsInScope(sec, scope);
        });
      } else {
        tagElementsInScope(root, rootName);
      }
    });
  }

  function applyCmsOverrides() {
    assignAutoCmsKeys();
    const data = (window as any).__ADAPTIF_CMS__;
    if (!data || !data.overrides) return;
    const map = data.overrides as Record<string, { text?: string; html?: string; href?: string; src?: string; alt?: string }>;

    document.querySelectorAll<HTMLElement>("[data-cms-key]").forEach((el) => {
      const key = el.dataset.cmsKey;
      if (!key || !map[key]) return;
      const val = map[key];

      if (el.tagName === "IMG") {
        const img = el as HTMLImageElement;
        if (val.src) img.src = val.src;
        if (typeof val.alt === "string") img.alt = val.alt;
        return;
      }

      if (typeof val.html === "string") {
        el.innerHTML = val.html;
      } else if (typeof val.text === "string") {
        setElementTextPreservingIcons(el, val.text);
      }

      if (typeof val.href === "string" && el.tagName === "A") {
        (el as HTMLAnchorElement).setAttribute("href", val.href);
      }
    });
  }

  (window as any).__ADAPTIF_ASSIGN_CMS_KEYS__ = assignAutoCmsKeys;

  function runApplyCms() {
    applyCmsOverrides();
    window.dispatchEvent(new CustomEvent("adaptif:cms-ready"));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", runApplyCms);
  } else {
    runApplyCms();
  }
  document.addEventListener("astro:page-load", runApplyCms);

  (() => {
    const cms = (window as any).__ADAPTIF_CMS__;
    if (!cms || !cms.isEditMode) return;

      document.body.classList.add("gce-editing");

      const currentPath: string = cms.currentPath || "/";
      const overrides: Record<string, { text?: string; href?: string; src?: string; alt?: string }> =
        JSON.parse(JSON.stringify(cms.overrides || {}));
      let isDirty = false;
      let pendingNavUrl: string | null = null;

      const dirtyPill = document.getElementById("gce-dirty-pill");
      const saveBtn = document.getElementById("gce-save-btn") as HTMLButtonElement | null;
      const resetBtn = document.getElementById("gce-reset-btn") as HTMLButtonElement | null;
      const exitBtn = document.getElementById("gce-exit-btn") as HTMLButtonElement | null;
      const toastEl = document.getElementById("gce-toast");

      const drawer = document.getElementById("gce-drawer");
      const toggleDrawerBtn = document.getElementById("gce-toggle-drawer");
      const closeDrawerBtn = document.getElementById("gce-close-drawer");
      const edgeHandle = document.getElementById("gce-edge-handle");
      const drawerNav = document.getElementById("gce-drawer-nav");

      const popover = document.getElementById("gce-link-popover");
      const popKind = document.getElementById("gce-pop-kind");
      const popTextWrap = document.getElementById("gce-pop-text-wrap");
      const popText = document.getElementById("gce-pop-text") as HTMLInputElement | null;
      const popHrefWrap = document.getElementById("gce-pop-href-wrap");
      const popHref = document.getElementById("gce-pop-href") as HTMLInputElement | null;
      const popGo = document.getElementById("gce-pop-go") as HTMLButtonElement | null;
      const popDone = document.getElementById("gce-pop-done");
      const popClose = document.getElementById("gce-pop-close");

      const imgHoverBtn = document.getElementById("gce-img-hover-btn") as HTMLButtonElement | null;
      const imgFileInput = document.getElementById("gce-img-file") as HTMLInputElement | null;

      const unsavedModal = document.getElementById("gce-unsaved-modal");
      const modalCancel = document.getElementById("gce-modal-cancel");
      const modalDiscard = document.getElementById("gce-modal-discard");
      const modalSaveGo = document.getElementById("gce-modal-save-go") as HTMLButtonElement | null;

      const titleToolbar = document.getElementById("gce-title-toolbar");
      const ttWhiteBtn = document.getElementById("gce-tt-white");
      const ttCyanBtn = document.getElementById("gce-tt-cyan");
      let activeHeadingEl: HTMLElement | null = null;

      function markDirty() {
        isDirty = true;
        if (dirtyPill) dirtyPill.hidden = false;
      }

      function clearDirty() {
        isDirty = false;
        if (dirtyPill) dirtyPill.hidden = true;
      }

      function showToast(msg: string) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.hidden = false;
        setTimeout(() => {
          if (toastEl) toastEl.hidden = true;
        }, 2600);
      }

      function setDrawerOpen(open: boolean) {
        drawer?.classList.toggle("is-open", open);
        toggleDrawerBtn?.setAttribute("aria-expanded", open ? "true" : "false");
        if (edgeHandle) edgeHandle.hidden = open;
      }

      toggleDrawerBtn?.addEventListener("click", () => {
        setDrawerOpen(!drawer?.classList.contains("is-open"));
      });
      closeDrawerBtn?.addEventListener("click", () => setDrawerOpen(false));
      edgeHandle?.addEventListener("click", () => setDrawerOpen(true));

      function buildEditUrl(rawUrl: string): { url: string; isExternal: boolean } {
        const trimmed = (rawUrl || "").trim();
        if (!trimmed) return { url: "", isExternal: false };
        if (trimmed.startsWith("#")) return { url: trimmed, isExternal: false };
        if (/^https?:\/\//i.test(trimmed)) {
          try {
            const parsed = new URL(trimmed);
            if (parsed.origin !== window.location.origin) {
              return { url: trimmed, isExternal: true };
            }
            parsed.searchParams.set("edit", "1");
            return { url: parsed.pathname + parsed.search + parsed.hash, isExternal: false };
          } catch {
            return { url: trimmed, isExternal: true };
          }
        }
        const [base, hash] = trimmed.split("#");
        const sep = base.includes("?") ? "&" : "?";
        const withEdit = base.includes("edit=1") ? base : `${base}${sep}edit=1`;
        return { url: hash ? `${withEdit}#${hash}` : withEdit, isExternal: false };
      }

      function navigateWithGuard(rawUrl: string) {
        const { url, isExternal } = buildEditUrl(rawUrl);
        if (!url) return;
        if (isExternal) {
          window.open(url, "_blank", "noopener,noreferrer");
          return;
        }
        if (isDirty) {
          pendingNavUrl = url;
          if (unsavedModal) unsavedModal.hidden = false;
          return;
        }
        window.location.href = url;
      }

      // Render left drawer pages tree
      function renderNavNode(node: any): string {
        const hasChildren = Array.isArray(node.children) && node.children.length > 0;
        const isCurrent = currentPath === node.path;
        if (!hasChildren) {
          return `<button type="button" class="gce-nav-link ${isCurrent ? "is-current" : ""}" data-nav-path="${node.path}">${node.label}</button>`;
        }
        const childHtml = node.children.map(renderNavNode).join("");
        const containsCurrent = JSON.stringify(node).includes(`"path":"${currentPath}"`);
        return `
          <div class="gce-nav-group ${containsCurrent || node.path === "/academy" ? "is-open" : ""}">
            <div class="gce-nav-row">
              <button type="button" class="gce-nav-caret" aria-label="Toggle ${node.label}">▸</button>
              <button type="button" class="gce-nav-link ${isCurrent ? "is-current" : ""}" data-nav-path="${node.path}">${node.label}</button>
            </div>
            <div class="gce-nav-children">${childHtml}</div>
          </div>
        `;
      }

      if (drawerNav) {
        drawerNav.innerHTML = (cms.pages || []).map(renderNavNode).join("");
        drawerNav.querySelectorAll<HTMLButtonElement>(".gce-nav-caret").forEach((caret) => {
          caret.addEventListener("click", (e) => {
            e.stopPropagation();
            caret.closest(".gce-nav-group")?.classList.toggle("is-open");
          });
        });
        drawerNav.querySelectorAll<HTMLButtonElement>("[data-nav-path]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const p = btn.dataset.navPath || "/";
            navigateWithGuard(p);
          });
        });
      }

      // Inline text editing on non-link, non-image [data-cms-key]
      function getCleanText(el: HTMLElement): string {
        return (el.innerText || el.textContent || "").trim();
      }

      function isHeadingTag(el: HTMLElement): boolean {
        return /^H[1-6]$/.test(el.tagName);
      }

      function positionTitleToolbar(heading: HTMLElement) {
        if (!titleToolbar) return;
        const r = heading.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight - 64) {
          titleToolbar.hidden = true;
          return;
        }
        const top = Math.max(12, r.top - 44);
        const left = Math.min(window.innerWidth - 230, Math.max(12, r.left));
        titleToolbar.style.top = `${top}px`;
        titleToolbar.style.left = `${left}px`;
        titleToolbar.hidden = false;
      }

      const syncFloatingPositionsOnScroll = () => {
        if (activeHeadingEl && document.activeElement === activeHeadingEl) {
          positionTitleToolbar(activeHeadingEl);
        }
        if (imgHoverBtn && !imgHoverBtn.hidden) {
          imgHoverBtn.hidden = true;
        }
      };

      window.addEventListener("scroll", syncFloatingPositionsOnScroll, { passive: true });
      window.addEventListener("resize", syncFloatingPositionsOnScroll, { passive: true });

      function findHighlightAncestor(node: Node | null, root: HTMLElement): HTMLElement | null {
        let cur: Node | null = node;
        while (cur && cur !== root) {
          if (
            cur instanceof HTMLElement &&
            (cur.classList.contains("title-highlight") ||
              cur.classList.contains("title-engine") ||
              cur.classList.contains("academy-highlight") ||
              cur.dataset.gceColor === "cyan")
          ) {
            return cur;
          }
          cur = cur.parentNode;
        }
        return null;
      }

      function stripHighlightSpans(container: ParentNode) {
        container
          .querySelectorAll("span.title-highlight, span.title-engine, span.academy-highlight, span[data-gce-color]")
          .forEach((sp) => {
            const parent = sp.parentNode;
            while (sp.firstChild) parent?.insertBefore(sp.firstChild, sp);
            parent?.removeChild(sp);
          });
      }

      function applyTitleStyle(mode: "white" | "cyan") {
        if (!activeHeadingEl) return;
        const key = activeHeadingEl.dataset.cmsKey;
        const sel = window.getSelection();
        const hasRange =
          sel &&
          sel.rangeCount > 0 &&
          !sel.getRangeAt(0).collapsed &&
          activeHeadingEl.contains(sel.getRangeAt(0).commonAncestorContainer);

        const range = hasRange && sel ? sel.getRangeAt(0) : (() => {
          const r = document.createRange();
          r.selectNodeContents(activeHeadingEl!);
          return r;
        })();

        const startHl = findHighlightAncestor(range.startContainer, activeHeadingEl);
        const endHl = findHighlightAncestor(range.endContainer, activeHeadingEl);

        if (mode === "cyan") {
          // Already inside a highlight span -> do NOT stack another highlight
          if (startHl && startHl === endHl) {
            return;
          }
          const frag = range.extractContents();
          stripHighlightSpans(frag);
          const span = document.createElement("span");
          span.className = "title-highlight";
          span.dataset.gceColor = "cyan";
          span.appendChild(frag);
          range.insertNode(span);
          // Flatten any nested highlight spans just in case
          span.querySelectorAll("span.title-highlight, span.title-engine, span.academy-highlight").forEach((inner) => {
            const p = inner.parentNode;
            while (inner.firstChild) p?.insertBefore(inner.firstChild, inner);
            p?.removeChild(inner);
          });
        } else {
          // mode === "white": unwrap highlight spans cleanly so white text has NO glow
          if (startHl && startHl === endHl) {
            // Split startHl around the selected range so the selected part becomes plain white text
            const beforeRange = document.createRange();
            beforeRange.setStart(startHl, 0);
            beforeRange.setEnd(range.startContainer, range.startOffset);
            const afterRange = document.createRange();
            afterRange.setStart(range.endContainer, range.endOffset);
            afterRange.setEnd(startHl, startHl.childNodes.length);

            const beforeText = beforeRange.toString();
            const selectedFrag = range.extractContents();
            stripHighlightSpans(selectedFrag);
            const afterText = afterRange.toString();

            const parent = startHl.parentNode;
            if (parent) {
              if (beforeText) {
                const bSpan = startHl.cloneNode(false) as HTMLElement;
                bSpan.textContent = beforeText;
                parent.insertBefore(bSpan, startHl);
              }
              parent.insertBefore(selectedFrag, startHl);
              if (afterText) {
                const aSpan = startHl.cloneNode(false) as HTMLElement;
                aSpan.textContent = afterText;
                parent.insertBefore(aSpan, startHl);
              }
              parent.removeChild(startHl);
            }
          } else {
            const frag = range.extractContents();
            stripHighlightSpans(frag);
            range.insertNode(frag);
          }
          activeHeadingEl.normalize();
        }

        if (key) {
          overrides[key] = {
            ...(overrides[key] || {}),
            html: activeHeadingEl.innerHTML,
            text: activeHeadingEl.textContent || "",
          };
          markDirty();
        }
      }

      [ttWhiteBtn, ttCyanBtn].forEach((btn) => {
        btn?.addEventListener("mousedown", (e) => e.preventDefault());
      });
      ttWhiteBtn?.addEventListener("click", () => applyTitleStyle("white"));
      ttCyanBtn?.addEventListener("click", () => applyTitleStyle("cyan"));

      function bindInlineTextEditors() {
        (window as any).__ADAPTIF_ASSIGN_CMS_KEYS__?.();
        document.querySelectorAll<HTMLElement>("[data-cms-key]").forEach((el) => {
          if (el.tagName === "IMG" || el.tagName === "A" || el.tagName === "BUTTON") return;
          if (el.dataset.gceBound === "1") return;
          el.dataset.gceBound = "1";
          el.setAttribute("contenteditable", "true");
          el.setAttribute("spellcheck", "false");

          if (isHeadingTag(el)) {
            el.addEventListener("focus", () => {
              activeHeadingEl = el;
              positionTitleToolbar(el);
            });
          }

          el.addEventListener("input", () => {
            const key = el.dataset.cmsKey;
            if (!key) return;
            if (isHeadingTag(el)) {
              overrides[key] = {
                ...(overrides[key] || {}),
                html: el.innerHTML,
                text: el.textContent || "",
              };
            } else {
              overrides[key] = { ...(overrides[key] || {}), text: el.textContent || "" };
            }
            markDirty();
          });
        });
      }

      document.addEventListener("click", (e) => {
        const t = e.target as HTMLElement | null;
        if (!t) return;
        if (t.closest("#gce-title-toolbar")) return;
        const h = t.closest<HTMLElement>("h1[data-cms-key], h2[data-cms-key], h3[data-cms-key], h4[data-cms-key], h5[data-cms-key], h6[data-cms-key]");
        if (!h && titleToolbar) {
          titleToolbar.hidden = true;
          activeHeadingEl = null;
        }
      });

      window.addEventListener("adaptif:cms-ready", bindInlineTextEditors);
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bindInlineTextEditors);
      } else {
        bindInlineTextEditors();
      }
      document.addEventListener("astro:page-load", bindInlineTextEditors);

      // Link & Button Popover
      let activeLinkEl: HTMLElement | null = null;

      function openPopoverFor(el: HTMLElement) {
        activeLinkEl = el;
        if (!popover) return;
        const isAnchor = el.tagName === "A";
        const hasCmsKey = Boolean(el.dataset.cmsKey);
        const currentText = getCleanText(el);
        const currentHref = isAnchor ? (el as HTMLAnchorElement).getAttribute("href") || "" : "";

        if (popKind) {
          popKind.textContent = hasCmsKey
            ? isAnchor
              ? "Edit Link / Button"
              : "Edit Button"
            : "Link Navigation";
        }
        if (popTextWrap) popTextWrap.hidden = !hasCmsKey;
        if (popText) popText.value = currentText;
        if (popHrefWrap) popHrefWrap.hidden = !isAnchor;
        if (popHref) popHref.value = currentHref;
        if (popGo) popGo.hidden = !isAnchor || !currentHref;

        const rect = el.getBoundingClientRect();
        const top = Math.min(window.innerHeight - 280, Math.max(16, rect.bottom + 8));
        const left = Math.min(window.innerWidth - 336, Math.max(12, rect.left));
        popover.style.top = `${top}px`;
        popover.style.left = `${left}px`;
        popover.hidden = false;
      }

      function closePopover() {
        if (popover) popover.hidden = true;
        activeLinkEl = null;
      }

      popClose?.addEventListener("click", closePopover);
      popDone?.addEventListener("click", closePopover);

      popText?.addEventListener("input", () => {
        if (!activeLinkEl || !popText) return;
        const key = activeLinkEl.dataset.cmsKey;
        if (!key) return;
        const val = popText.value;
        const svg = activeLinkEl.querySelector("svg");
        if (svg) {
          const span = activeLinkEl.querySelector("span:not(:has(svg))");
          if (span && activeLinkEl.children.length <= 2) {
            span.textContent = val;
          } else {
            for (const node of Array.from(activeLinkEl.childNodes)) {
              if (node.nodeType === Node.TEXT_NODE && node.textContent?.trim()) {
                node.textContent = val + " ";
                break;
              }
            }
          }
        } else {
          activeLinkEl.textContent = val;
        }
        overrides[key] = { ...(overrides[key] || {}), text: val };
        markDirty();
      });

      popHref?.addEventListener("input", () => {
        if (!activeLinkEl || !popHref || activeLinkEl.tagName !== "A") return;
        const val = popHref.value.trim();
        (activeLinkEl as HTMLAnchorElement).setAttribute("href", val || "#");
        if (popGo) popGo.hidden = !val;
        const key = activeLinkEl.dataset.cmsKey;
        if (key) {
          overrides[key] = { ...(overrides[key] || {}), href: val };
          markDirty();
        }
      });

      popGo?.addEventListener("click", () => {
        const href = popHref?.value.trim() || "";
        if (!href) return;
        closePopover();
        navigateWithGuard(href);
      });

      // Intercept clicks on editable buttons/links and navigation links
      document.addEventListener(
        "click",
        (e) => {
          const target = e.target as HTMLElement | null;
          if (!target || target.closest("#gce-root")) return;

          const clickable = target.closest<HTMLElement>("a, button[data-cms-key]");
          if (!clickable) {
            if (!target.closest("#gce-link-popover")) closePopover();
            return;
          }

          if (clickable.tagName === "A" || clickable.dataset.cmsKey) {
            e.preventDefault();
            e.stopPropagation();
            openPopoverFor(clickable);
          }
        },
        true
      );

      // Image editing
      let activeImgEl: HTMLImageElement | null = null;

      document.addEventListener("mouseover", (e) => {
        const img = (e.target as HTMLElement | null)?.closest<HTMLImageElement>("img[data-cms-key]");
        if (!img || !imgHoverBtn) return;
        activeImgEl = img;
        const r = img.getBoundingClientRect();
        imgHoverBtn.style.top = `${Math.max(72, r.top + 10)}px`;
        imgHoverBtn.style.left = `${Math.max(12, r.left + 10)}px`;
        imgHoverBtn.hidden = false;
      });

      imgHoverBtn?.addEventListener("click", () => {
        imgFileInput?.click();
      });

      document.addEventListener(
        "click",
        (e) => {
          const img = (e.target as HTMLElement | null)?.closest<HTMLImageElement>("img[data-cms-key]");
          if (!img) return;
          e.preventDefault();
          e.stopPropagation();
          activeImgEl = img;
          imgFileInput?.click();
        },
        true
      );

      imgFileInput?.addEventListener("change", async () => {
        const file = imgFileInput.files?.[0];
        if (!file || !activeImgEl) return;
        const key = activeImgEl.dataset.cmsKey;
        if (!key) return;
        try {
          showToast("Uploading image...");
          const fd = new FormData();
          fd.append("file", file);
          const res = await fetch("/api/upload", { method: "POST", body: fd });
          const data = await res.json();
          if (!res.ok || !data?.url) throw new Error(data?.error || "Upload failed");
          activeImgEl.src = data.url;
          overrides[key] = { ...(overrides[key] || {}), src: data.url };
          markDirty();
          showToast("Image updated (remember to Save Changes)");
        } catch (err: any) {
          showToast(err?.message || "Image upload failed");
        } finally {
          imgFileInput.value = "";
        }
      });

      // Save / Reset / Exit
      async function saveChanges(): Promise<boolean> {
        if (saveBtn) {
          saveBtn.disabled = true;
          saveBtn.textContent = "Saving...";
        }
        try {
          const res = await fetch("/api/cms/content", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ path: currentPath, overrides }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.error || "Failed to save changes");
          clearDirty();
          showToast("Changes saved & live!");
          return true;
        } catch (err: any) {
          showToast(err?.message || "Error saving changes");
          return false;
        } finally {
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.textContent = "Save Changes";
          }
        }
      }

      saveBtn?.addEventListener("click", saveChanges);

      resetBtn?.addEventListener("click", async () => {
        if (!confirm(`Reset all custom text/link/image edits on "${currentPath}" back to defaults?`)) {
          return;
        }
        try {
          const res = await fetch(`/api/cms/content?path=${encodeURIComponent(currentPath)}`, {
            method: "DELETE",
          });
          if (!res.ok) throw new Error("Failed to reset page");
          clearDirty();
          window.location.reload();
        } catch (err: any) {
          showToast(err?.message || "Reset failed");
        }
      });

      exitBtn?.addEventListener("click", () => {
        const url = new URL(window.location.href);
        url.searchParams.delete("edit");
        if (isDirty) {
          pendingNavUrl = url.pathname + url.search + url.hash;
          if (unsavedModal) unsavedModal.hidden = false;
          return;
        }
        window.location.href = url.pathname + url.search + url.hash;
      });

      // Unsaved modal handlers
      modalCancel?.addEventListener("click", () => {
        pendingNavUrl = null;
        if (unsavedModal) unsavedModal.hidden = true;
      });

      modalDiscard?.addEventListener("click", () => {
        clearDirty();
        if (unsavedModal) unsavedModal.hidden = true;
        if (pendingNavUrl) window.location.href = pendingNavUrl;
      });

      modalSaveGo?.addEventListener("click", async () => {
        const ok = await saveChanges();
        if (ok && pendingNavUrl) {
          if (unsavedModal) unsavedModal.hidden = true;
          window.location.href = pendingNavUrl;
        }
      });
    })();
  </script>
