---
import type { CmsNavNode, CmsPageOverrides } from "../lib/cmsContentDb";

interface Props {
  currentPath: string;
  overrides: CmsPageOverrides;
  isEditMode: boolean;
  pages?: CmsNavNode[];
}

const { currentPath, overrides, isEditMode, pages = [] } = Astro.props;
---

<script is:inline define:vars={{ currentPath, overrides, isEditMode, pages }}>
  window.__ADAPTIF_CMS__ = {
    currentPath,
    overrides: overrides || {},
    isEditMode: Boolean(isEditMode),
    pages: pages || [],
  };
</script>

{isEditMode && (
  <div id="gce-root" class="gce-root">
    <!-- Top Floating Bar -->
    <div class="gce-topbar" role="region" aria-label="Page Editor Toolbar">
      <div class="gce-topbar-left">
        <button
          type="button"
          class="adaptif-btn adaptif-btn--dark adaptif-btn--sm"
          id="gce-toggle-drawer"
          aria-expanded="false"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2" />
            <path d="M9 3v18" />
          </svg>
          <span>Pages</span>
        </button>

        <span class="gce-path-pill">
          Editing: <strong>{currentPath}</strong>
        </span>

        <span class="gce-dirty-pill" id="gce-dirty-pill" hidden>
          ● Unsaved changes
        </span>
      </div>

      <div class="gce-topbar-actions">
        <button type="button" class="adaptif-btn adaptif-btn--danger adaptif-btn--sm" id="gce-reset-btn">
          Reset Page
        </button>
        <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="gce-exit-btn">
          Exit Edit Mode
        </button>
        <button type="button" class="adaptif-btn adaptif-btn--sm" id="gce-save-btn">
          Save Changes
        </button>
      </div>
    </div>

    <!-- Retractable Left Pages Drawer -->
    <aside class="gce-drawer" id="gce-drawer" aria-label="Site pages navigation">
      <div class="gce-drawer-head">
        <div>
          <span class="gce-drawer-kicker">Site Map</span>
          <h2 class="gce-drawer-title">Pages &amp; Sub-pages</h2>
        </div>
        <button type="button" class="gce-icon-close" id="gce-close-drawer" aria-label="Collapse pages panel">
          ✕
        </button>
      </div>
      <nav class="gce-drawer-nav" id="gce-drawer-nav"></nav>
    </aside>

    <!-- Retractable Edge Handle (when drawer is closed) -->
    <button
      type="button"
      class="gce-edge-handle"
      id="gce-edge-handle"
      title="Open Pages Panel"
      aria-label="Open Pages Panel"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
      <span>Pages</span>
    </button>

    <!-- Floating Title Color Toolbar (White vs Cyan Highlight) -->
    <div class="gce-title-toolbar" id="gce-title-toolbar" hidden role="toolbar" aria-label="Title text color">
      <span class="gce-tt-label">Title Style:</span>
      <button type="button" class="gce-tt-btn is-white" id="gce-tt-white" title="Set selected text (or title) to White">
        <span class="gce-tt-swatch is-white"></span>
        <span>White</span>
      </button>
      <button type="button" class="gce-tt-btn is-cyan" id="gce-tt-cyan" title="Set selected text (or title) to Cyan Highlight">
        <span class="gce-tt-swatch is-cyan"></span>
        <span>Highlight</span>
      </button>
    </div>

    <!-- Floating Button / Link Popover -->
    <div class="gce-popover" id="gce-link-popover" hidden role="dialog" aria-label="Edit button or link">
      <div class="gce-popover-head">
        <span id="gce-pop-kind">Edit Link / Button</span>
        <button type="button" class="gce-icon-close" id="gce-pop-close" aria-label="Close">✕</button>
      </div>
      <div class="gce-popover-body">
        <label class="gce-pop-field" id="gce-pop-text-wrap">
          <span>Button / Link Text</span>
          <input type="text" id="gce-pop-text" placeholder="Button text..." />
        </label>
        <label class="gce-pop-field" id="gce-pop-href-wrap">
          <span>Destination URL (Link)</span>
          <input type="text" id="gce-pop-href" placeholder="/pricing or https://..." />
        </label>
      </div>
      <div class="gce-popover-foot">
        <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="gce-pop-go">
          Go to URL ↗
        </button>
        <button type="button" class="adaptif-btn adaptif-btn--sm" id="gce-pop-done">
          Done
        </button>
      </div>
    </div>

    <!-- Floating Image Hover Trigger -->
    <button type="button" class="gce-img-btn" id="gce-img-hover-btn" hidden>
      Change Image
    </button>
    <input type="file" id="gce-img-file" accept="image/*" hidden />

    <!-- Unsaved Changes Confirmation Modal -->
    <div class="gce-modal-backdrop" id="gce-unsaved-modal" hidden>
      <div class="gce-modal" role="dialog" aria-modal="true" aria-label="Unsaved changes">
        <h3>Unsaved changes</h3>
        <p>You have unsaved edits on this page. Would you like to save them before navigating away?</p>
        <div class="gce-modal-actions">
          <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="gce-modal-cancel">
            Cancel
          </button>
          <button type="button" class="adaptif-btn adaptif-btn--danger adaptif-btn--sm" id="gce-modal-discard">
            Discard &amp; Go
          </button>
          <button type="button" class="adaptif-btn adaptif-btn--sm" id="gce-modal-save-go">
            Save &amp; Go
          </button>
        </div>
      </div>
    </div>

    <!-- Toast -->
    <div class="gce-toast" id="gce-toast" hidden></div>
  </div>
)}

<style is:global>
  body.gce-editing {
    padding-bottom: 64px !important;
  }

  body.gce-editing .wa-fab {
    bottom: 82px !important;
  }

  body.gce-editing [data-cms-key]:not(img):not(a):not(button) {
    outline: 1px dashed rgba(72, 200, 255, 0.38);
    outline-offset: 4px;
    border-radius: 4px;
    cursor: text;
    user-select: text !important;
    -webkit-user-select: text !important;
    pointer-events: auto !important;
    transition: outline-color 0.15s ease, background-color 0.15s ease;
  }

  body.gce-editing [data-cms-key]:not(img):not(a):not(button):hover {
    outline-color: rgba(72, 200, 255, 0.85);
    background-color: rgba(72, 200, 255, 0.06);
  }

  body.gce-editing [data-cms-key]:not(img):not(a):not(button):focus {
    outline: 2px solid #48c8ff;
    background-color: rgba(72, 200, 255, 0.1);
  }

  body.gce-editing a[data-cms-key],
  body.gce-editing button[data-cms-key],
  body.gce-editing header a,
  body.gce-editing footer a {
    outline: 1px dashed rgba(72, 200, 255, 0.5);
    outline-offset: 3px;
    cursor: pointer !important;
  }

  body.gce-editing img[data-cms-key] {
    outline: 2px dashed rgba(72, 200, 255, 0.55);
    outline-offset: 3px;
    cursor: pointer;
  }
</style>

