<script>
  // Header detachment on scroll, Mega Menu interactions & Mobile drawer
  const headerContainer = document.getElementById('site-header');
  const toggleBtn = document.getElementById('mobile-toggle-btn');
  const mobileNav = document.getElementById('mobile-nav');

  // Services Mega Menu Elements
  const servicesItem = document.querySelector('.nav-item-services');
  const servicesTrigger = document.getElementById('services-trigger');
  const servicesMegaMenu = document.getElementById('services-mega-menu');

  // Why Us Mega Menu Elements
  const whyUsItem = document.querySelector('.nav-item-why-us');
  const whyUsTrigger = document.getElementById('why-us-trigger');
  const whyUsMegaMenu = document.getElementById('why-us-mega-menu');

  // Mobile Accordion Elements
  const mobileServicesBtn = document.getElementById('mobile-services-accordion');
  const mobileServicesPanel = document.getElementById('mobile-services-panel');
  const mobileWhyUsBtn = document.getElementById('mobile-why-us-accordion');
  const mobileWhyUsPanel = document.getElementById('mobile-why-us-panel');

  function updateHeaderTheme() {
    if (!headerContainer) return;
    const capsule = headerContainer.querySelector('.header-capsule');
    const rect = capsule ? capsule.getBoundingClientRect() : headerContainer.getBoundingClientRect();
    const sampleY = rect.top + (rect.height / 2);

    const lightSections = document.querySelectorAll('[data-theme="light"], .creative-range-section');
    let isOverLight = false;

    for (const sec of lightSections) {
      const sRect = sec.getBoundingClientRect();
      if (sRect.top <= sampleY && sRect.bottom >= sampleY) {
        isOverLight = true;
        break;
      }
    }

    headerContainer.classList.toggle('theme-light', isOverLight);
  }

  function handleScroll() {
    if (!headerContainer) return;
    const isScrolled = window.scrollY > 20;
    headerContainer.classList.toggle('is-scrolled', isScrolled);
    updateHeaderTheme();
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  window.addEventListener('resize', updateHeaderTheme, { passive: true });
  document.addEventListener('astro:page-load', handleScroll);
  handleScroll();

  // Desktop Mega Menus: Helper to wire hover, click, and accessibility
  const setupDesktopMenu = (
    item: HTMLElement | null,
    trigger: HTMLElement | null,
    menu: HTMLElement | null,
    onOpenOther?: () => void
  ) => {
    if (!item || !trigger || !menu) return { open: () => {}, close: () => {} };

    const openMenu = () => {
      onOpenOther?.();
      item.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    };

    const closeMenu = () => {
      item.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    };

    // Open immediately on mouseenter
    item.addEventListener('mouseenter', openMenu);
    menu.addEventListener('mouseenter', openMenu);

    // Close immediately when pointer leaves without delay
    item.addEventListener('mouseleave', (e) => {
      if (!menu.contains(e.relatedTarget as Node)) {
        closeMenu();
      }
    });

    menu.addEventListener('mouseleave', (e) => {
      if (!item.contains(e.relatedTarget as Node)) {
        closeMenu();
      }
    });

    // Click toggle
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = item.classList.contains('is-open');
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Close menu when a link inside is clicked
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    return { open: openMenu, close: closeMenu };
  };

  let closeServices: () => void = () => {};
  let closeWhyUs: () => void = () => {};

  if (servicesItem && servicesTrigger && servicesMegaMenu) {
    const sMenu = setupDesktopMenu(
      servicesItem as HTMLElement,
      servicesTrigger as HTMLElement,
      servicesMegaMenu as HTMLElement,
      () => closeWhyUs()
    );
    closeServices = sMenu.close;
  }

  if (whyUsItem && whyUsTrigger && whyUsMegaMenu) {
    const wMenu = setupDesktopMenu(
      whyUsItem as HTMLElement,
      whyUsTrigger as HTMLElement,
      whyUsMegaMenu as HTMLElement,
      () => closeServices()
    );
    closeWhyUs = wMenu.close;
  }

  // Close menus when pressing Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (servicesItem?.classList.contains('is-open')) {
        closeServices();
        servicesTrigger?.focus();
      }
      if (whyUsItem?.classList.contains('is-open')) {
        closeWhyUs();
        whyUsTrigger?.focus();
      }
    }
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (
      !servicesItem?.contains(target) && 
      !servicesMegaMenu?.contains(target) &&
      !whyUsItem?.contains(target) &&
      !whyUsMegaMenu?.contains(target)
    ) {
      closeServices();
      closeWhyUs();
    }
  });

  // Mobile Drawer Toggle with Backdrop and Scroll Lock
  const backdrop = document.getElementById('mobile-backdrop');

  const openMobileMenu = () => {
    toggleBtn?.setAttribute('aria-expanded', 'true');
    mobileNav?.setAttribute('aria-hidden', 'false');
    mobileNav?.classList.add('is-open');
    backdrop?.classList.add('is-open');
    headerContainer?.classList.add('mobile-open');
    document.body.style.overflow = 'hidden';
  };

  const closeMobileMenu = () => {
    toggleBtn?.setAttribute('aria-expanded', 'false');
    mobileNav?.setAttribute('aria-hidden', 'true');
    mobileNav?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    headerContainer?.classList.remove('mobile-open');
    document.body.style.overflow = '';
  };

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    backdrop?.addEventListener('click', closeMobileMenu);

    // Close drawer when any normal navigation link is clicked
    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!toggleBtn.contains(e.target as Node) && !mobileNav.contains(e.target as Node) && !backdrop?.contains(e.target as Node)) {
        closeMobileMenu();
      }
    });
  }

  // Mobile Services Master Accordion
  if (mobileServicesBtn && mobileServicesPanel) {
    const servicesItem = mobileServicesBtn.closest('.mobile-services-item');
    mobileServicesBtn.addEventListener('click', () => {
      const isExpanded = mobileServicesBtn.getAttribute('aria-expanded') === 'true';
      const willBeOpen = !isExpanded;
      mobileServicesBtn.setAttribute('aria-expanded', String(willBeOpen));
      mobileServicesPanel.classList.toggle('is-open', willBeOpen);
      servicesItem?.classList.toggle('is-open', willBeOpen);
    });
  }

  // Mobile Why Us Accordion
  if (mobileWhyUsBtn && mobileWhyUsPanel) {
    const whyUsMobileItem = mobileWhyUsBtn.closest('.mobile-why-us-item');
    mobileWhyUsBtn.addEventListener('click', () => {
      const isExpanded = mobileWhyUsBtn.getAttribute('aria-expanded') === 'true';
      const willBeOpen = !isExpanded;
      mobileWhyUsBtn.setAttribute('aria-expanded', String(willBeOpen));
      mobileWhyUsPanel.classList.toggle('is-open', willBeOpen);
      whyUsMobileItem?.classList.toggle('is-open', willBeOpen);
    });
  }

  // Mobile Category Accordions (sub-dropdowns without cards)
  const categoryGroups = document.querySelectorAll<HTMLElement>('[data-category-group]');
  categoryGroups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>('.mobile-category-trigger-btn');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = group.classList.contains('is-open');
      group.classList.toggle('is-open', !isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
