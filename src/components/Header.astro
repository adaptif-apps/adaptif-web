---
// Header.astro - Floating Luminous Glass Capsule with Services Mega Menu

interface ServiceItem {
  title: string;
  desc: string;
  href: string;
}

interface ServiceCategory {
  title: string;
  href: string;
  items: ServiceItem[];
}

const serviceCategories: ServiceCategory[] = [
  {
    title: "Creative Design Services",
    href: "#creative-design",
    items: [
      { title: "Ad creative", desc: "Eye-catching designs that perform", href: "#service-ad-creative" },
      { title: "Social media creative", desc: "Engaging assets for all platforms", href: "#service-social-media" },
      { title: "Presentation design", desc: "Captivating slides that tell your story", href: "#service-presentation-design" },
      { title: "Illustration design", desc: "Visual storytelling for your brand", href: "#service-illustration-design" },
      { title: "Branding services", desc: "Expertise & custom design services", href: "#service-branding-services" },
      { title: "eBook & report design", desc: "Your digital content supercharged", href: "#service-ebook-report" },
      { title: "Concept creation", desc: "Big ideas crafted for maximum impact", href: "#service-concept-creation" },
      { title: "Print design", desc: "Tangible designs that leave a lasting impression", href: "#service-print-design" },
      { title: "Packaging & merchandise design", desc: "Bring your brand to life", href: "#service-packaging-merchandise" }
    ]
  },
  {
    title: "Production Services",
    href: "#production-services",
    items: [
      { title: "Video production", desc: "Effortless video production at scale", href: "#service-video-production" },
      { title: "Motion design", desc: "For websites, ads, and presentations", href: "#service-motion-design" },
      { title: "Email creation", desc: "Click-worthy emails that drive engagement", href: "#service-email-creation" },
      { title: "Web design", desc: "High-converting websites and landing pages", href: "#service-web-design" },
      { title: "Design Systems", desc: "Robust design systems that drive visual consistency", href: "#service-design-systems" },
      { title: "Product Design", desc: "Engaging & intuitive experiences", href: "#service-product-design" },
      { title: "Copywriting", desc: "Persuasive words for clarity and action", href: "#service-copywriting" }
    ]
  },
  {
    title: "AI Services",
    href: "#ai-services",
    items: [
      { title: "AI-powered creative", desc: "Human brilliance powered by AI", href: "#service-ai-powered-creative" },
      { title: "AI consulting", desc: "Transform your team with AI", href: "#service-ai-consulting" },
      { title: "Automation", desc: "Move fast without compromising craft", href: "#service-automation" },
      { title: "Data services", desc: "Train your AI with creative data", href: "#service-data-services" }
    ]
  },
  {
    title: "Marketing services",
    href: "#marketing-services",
    items: [
      { title: "Campaign strategy", desc: "Strategy, messaging, and concept for multi-market campaigns", href: "#service-campaign-strategy" }
    ]
  }
];
---

<header class="header-container" id="site-header">
  <div class="header-capsule">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="Adaptif Home">
      <img 
        src="/logo.svg" 
        alt="Adaptif" 
        class="brand-logo" 
        width="116" 
        height="56" 
        loading="eager" 
        decoding="async" 
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="Main Navigation">
      <ul class="nav-list">
        <!-- Services Mega Menu Item -->
        <li class="nav-item nav-item-services">
          <button 
            type="button" 
            class="nav-link nav-link-services" 
            id="services-trigger" 
            aria-expanded="false" 
            aria-haspopup="true"
            aria-controls="services-mega-menu"
          >
            <span>Services</span>
            <svg class="chevron-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Mega Menu Dropdown Container -->
          <div class="mega-menu-wrapper" id="services-mega-menu" role="region" aria-label="Services Mega Menu">
            <div class="mega-menu-panel">
              <div class="mega-menu-grid">
                <!-- Column 1: Creative Design Services -->
                <div class="mega-column">
                  <a href={serviceCategories[0].href} class="mega-column-title">
                    <span class="column-title-text">{serviceCategories[0].title}</span>
                    <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <ul class="mega-item-list">
                    {serviceCategories[0].items.map((item) => (
                      <li>
                        <a href={item.href} class="mega-item">
                          <span class="mega-item-header">
                            <span class="mega-item-title">{item.title}</span>
                            <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="mega-item-desc">{item.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Column 2: Production Services -->
                <div class="mega-column">
                  <a href={serviceCategories[1].href} class="mega-column-title">
                    <span class="column-title-text">{serviceCategories[1].title}</span>
                    <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <ul class="mega-item-list">
                    {serviceCategories[1].items.map((item) => (
                      <li>
                        <a href={item.href} class="mega-item">
                          <span class="mega-item-header">
                            <span class="mega-item-title">{item.title}</span>
                            <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="mega-item-desc">{item.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Column 3: AI Services -->
                <div class="mega-column">
                  <a href={serviceCategories[2].href} class="mega-column-title">
                    <span class="column-title-text">{serviceCategories[2].title}</span>
                    <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <ul class="mega-item-list">
                    {serviceCategories[2].items.map((item) => (
                      <li>
                        <a href={item.href} class="mega-item">
                          <span class="mega-item-header">
                            <span class="mega-item-title">{item.title}</span>
                            <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="mega-item-desc">{item.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Column 4: Marketing Services & Spotlight Feature -->
                <div class="mega-column mega-column-marketing">
                  <a href={serviceCategories[3].href} class="mega-column-title">
                    <span class="column-title-text">{serviceCategories[3].title}</span>
                    <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <ul class="mega-item-list">
                    {serviceCategories[3].items.map((item) => (
                      <li>
                        <a href={item.href} class="mega-item">
                          <span class="mega-item-header">
                            <span class="mega-item-title">{item.title}</span>
                            <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="mega-item-desc">{item.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>

                  <!-- Feature Spotlight Card -->
                  <div class="mega-spotlight-card">
                    <div class="spotlight-tag">
                      <span class="tag-pulse"></span>
                      <span>Subscription Model</span>
                    </div>
                    <div class="spotlight-title">Creative Pipeline On-Demand</div>
                    <p class="spotlight-text">
                      Plugs an AI-augmented creative team directly into your workflow: senior designers, developers & strategists.
                    </p>
                    <a href="#contact" class="spotlight-cta">
                      <span>Book a Discovery Call</span>
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                        <path d="M3.33 8h9.34M8 3.33L12.67 8 8 12.67" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>

              <!-- Mega Menu Bottom Bar -->
              <div class="mega-footer-bar">
                <div class="mega-footer-info">
                  <span class="mega-footer-dot" aria-hidden="true"></span>
                  <span>All 21+ services included in your subscription. Unlimited requests & revisions.</span>
                </div>
                <a href="#pricing" class="mega-footer-link">
                  <span>View Pricing Plans</span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.33 8h9.34M8 3.33L12.67 8 8 12.67" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </li>

        <li><a href="#our-work" class="nav-link">Our Work</a></li>
        <li><a href="#why-us" class="nav-link">Why Us</a></li>
        <li><a href="#resources" class="nav-link">Resources</a></li>
        <li><a href="#pricing" class="nav-link">Pricing</a></li>
        <li><a href="#dedicated-team" class="nav-link">Dedicated Team</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="#contact" class="btn-cta-header">
        <span class="btn-glow-pulse" aria-hidden="true"></span>
        <span class="btn-text">Book a Call</span>
        <svg class="btn-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M3.33334 8H12.6667M12.6667 8L8.00001 3.33334M12.6667 8L8.00001 12.6667" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button 
        class="mobile-toggle" 
        id="mobile-toggle-btn" 
        aria-label="Open menu" 
        aria-expanded="false" 
        aria-controls="mobile-nav"
      >
        <span class="bar bar-top"></span>
        <span class="bar bar-bottom"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Blur & Dark Dimmer -->
  <div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

  <!-- Mobile Drawer Overlay -->
  <div class="mobile-drawer" id="mobile-nav" aria-hidden="true">
    <div class="mobile-drawer-scroll">
      <div class="mobile-drawer-content">
        <ul class="mobile-nav-list">
          <!-- Mobile Services Accordion Item -->
          <li class="mobile-nav-item">
            <button 
              type="button" 
              class="mobile-nav-accordion-btn" 
              id="mobile-services-accordion" 
              aria-expanded="false"
              aria-controls="mobile-services-panel"
            >
              <span>Services</span>
              <svg class="mobile-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            
            <div class="mobile-services-panel" id="mobile-services-panel">
              <div class="mobile-services-inner">
                {serviceCategories.map((category, catIndex) => (
                  <div class={`mobile-category-accordion-group ${catIndex === 0 ? 'is-open' : ''}`} data-category-group>
                    <button 
                      type="button" 
                      class="mobile-category-trigger-btn" 
                      aria-expanded={catIndex === 0 ? "true" : "false"}
                    >
                      <div class="mobile-cat-btn-left">
                        <span class="mobile-cat-dot"></span>
                        <span class="mobile-cat-btn-title">{category.title}</span>
                      </div>
                      <svg class="mobile-cat-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>

                    <div class="mobile-category-collapse">
                      <div class="mobile-category-collapse-inner">
                        <ul class="mobile-category-items">
                          {category.items.map((item) => (
                            <li>
                              <a href={item.href} class="mobile-service-subitem">
                                <div class="mobile-subitem-top">
                                  <span class="mobile-service-title">{item.title}</span>
                                  <svg class="mobile-subitem-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                                    <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </div>
                                <span class="mobile-service-desc">{item.desc}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                ))}

                <!-- Mobile Spotlight Card -->
                <div class="mobile-spotlight-card">
                  <div class="spotlight-tag">
                    <span class="tag-pulse"></span>
                    <span>Subscription Model</span>
                  </div>
                  <div class="spotlight-title">Creative Pipeline On-Demand</div>
                  <p class="spotlight-text">
                    Plugs an AI-augmented creative team directly into your workflow: senior designers, developers & strategists.
                  </p>
                  <a href="#contact" class="spotlight-cta">
                    <span>Book a Discovery Call</span>
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                      <path d="M3.33 8h9.34M8 3.33L12.67 8 8 12.67" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>

                <!-- Mobile Services Footer Note -->
                <div class="mobile-services-footer-note">
                  <span class="mega-footer-dot"></span>
                  <span>All 21+ services included in your subscription. Unlimited requests & revisions.</span>
                </div>
              </div>
            </div>
          </li>

          <li><a href="#our-work" class="mobile-nav-link">Our Work</a></li>
          <li><a href="#why-us" class="mobile-nav-link">Why Us</a></li>
          <li><a href="#resources" class="mobile-nav-link">Resources</a></li>
          <li><a href="#pricing" class="mobile-nav-link">Pricing</a></li>
          <li><a href="#dedicated-team" class="mobile-nav-link">Dedicated Team</a></li>
        </ul>

        <div class="mobile-drawer-footer">
          <a href="#contact" class="btn-cta-mobile">
            <span>Book a Call</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.33334 8H12.6667M12.6667 8L8.00001 3.33334M12.6667 8L8.00001 12.6667" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .header-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-top: clamp(14px, 2.5vh, 24px);
    padding-inline: clamp(1rem, 3.5vw, 2.5rem);
    z-index: 100;
    pointer-events: none;
    transition: 
      padding-top 0.4s var(--ease-spring),
      top 0.4s var(--ease-spring);
  }

  /* When Scrolled: Detaches into floating frosted capsule */
  .header-container.is-scrolled {
    top: 14px;
    padding-top: 0;
  }

  .header-capsule {
    position: relative;
    z-index: 101;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 10px 18px;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    box-shadow: none;
    transition: 
      background 0.45s var(--ease-spring),
      border-color 0.45s var(--ease-spring),
      box-shadow 0.45s var(--ease-spring),
      backdrop-filter 0.45s var(--ease-spring),
      padding 0.45s var(--ease-spring);
  }

  /* Scrolled floating glass state */
  .header-container.is-scrolled .header-capsule,
  .header-container.mobile-open .header-capsule {
    padding: 8px 14px 8px 18px;
    background: var(--glass-bg-surface);
    backdrop-filter: var(--glass-blur-md);
    -webkit-backdrop-filter: var(--glass-blur-md);
    border: var(--border-hairline);
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.2),
      0 14px 36px -6px rgba(1, 3, 10, 0.85),
      0 0 28px -5px rgba(72, 200, 255, 0.25);
  }

  .header-container.is-scrolled .header-capsule:hover {
    border-color: rgba(72, 200, 255, 0.4);
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.3),
      0 18px 44px -4px rgba(0, 2, 8, 0.9),
      0 0 38px -2px rgba(72, 200, 255, 0.35);
  }

  /* Brand Logo */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    outline-offset: 4px;
    padding: 4px 6px;
  }

  .brand-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 102, 255, 0.25));
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .brand-link:hover .brand-logo {
    transform: scale(1.03);
  }

  /* Desktop Navigation */
  .nav-desktop {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 4px;
  }

  .nav-item {
    position: relative;
  }

  /* Specifically for Services mega-menu anchoring to capsule */
  .nav-item-services {
    position: static;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-size: var(--font-size-nav);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-pill);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--duration-fast) var(--ease-spring);
  }

  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    opacity: 0;
    transform: scale(0.92);
    transition: 
      opacity var(--duration-fast) var(--ease-spring),
      transform var(--duration-fast) var(--ease-spring);
  }

  .nav-link:hover,
  .nav-item-services:hover .nav-link-services,
  .nav-item-services.is-open .nav-link-services {
    color: var(--color-text-white);
  }

  .nav-link:hover::before,
  .nav-item-services:hover .nav-link-services::before,
  .nav-item-services.is-open .nav-link-services::before {
    opacity: 1;
    transform: scale(1);
  }

  .chevron-arrow {
    color: var(--color-text-secondary);
    transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), color var(--duration-fast);
  }

  .nav-item-services:hover .chevron-arrow,
  .nav-item-services.is-open .chevron-arrow {
    transform: rotate(180deg);
    color: #48C8FF;
  }

  /* ==========================================================================
     MEGA MENU CONTAINER & DROPDOWN PANEL
     ========================================================================== */
  .mega-menu-wrapper {
    position: absolute;
    top: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%) translateY(-10px) scale(0.975);
    width: min(1160px, calc(100vw - 36px));
    padding-top: 14px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 150;
    will-change: transform, opacity;
    transform-origin: top center;
    transition: 
      transform 0.22s cubic-bezier(0.25, 0.1, 0.25, 1),
      opacity 0.2s cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s 0.22s;
  }

  /* Extended invisible hover bridge to span the gap seamlessly */
  .mega-menu-wrapper::before {
    content: "";
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: 36px;
    background: transparent;
    pointer-events: auto;
  }

  /* Hover & Open States */
  .nav-item-services:hover .mega-menu-wrapper,
  .nav-item-services:focus-within .mega-menu-wrapper,
  .nav-item-services.is-open .mega-menu-wrapper {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
    transition: 
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s 0s;
  }

  .mega-menu-panel {
    position: relative;
    background-color: #030716;
    background-image: 
      radial-gradient(ellipse 65% 45% at 50% 0%, rgba(72, 200, 255, 0.14) 0%, transparent 70%),
      radial-gradient(ellipse 45% 35% at 85% 60%, rgba(0, 102, 255, 0.08) 0%, transparent 60%);
    border: 1px solid rgba(72, 200, 255, 0.24);
    border-radius: 22px;
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.25),
      inset 0 -1px 1px 0 rgba(0, 229, 255, 0.15),
      0 28px 70px -12px rgba(0, 2, 8, 0.96),
      0 0 45px -5px rgba(72, 200, 255, 0.25);
    padding: 24px 28px 16px 28px;
    max-height: calc(85vh - 70px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(72, 200, 255, 0.3) transparent;
  }

  .mega-menu-panel::-webkit-scrollbar {
    width: 6px;
  }

  .mega-menu-panel::-webkit-scrollbar-thumb {
    background: rgba(72, 200, 255, 0.3);
    border-radius: 10px;
  }

