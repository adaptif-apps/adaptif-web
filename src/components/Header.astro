---
// Header.astro - Floating Luminous Glass Capsule with Services Mega Menu

interface ServiceItem {
  title: string;
  desc: string;
  href: string;
}

interface ServiceCategory {
  title: string;
  href: string;
  items: ServiceItem[];
}

interface WhyUsItem {
  title: string;
  desc: string;
  href: string;
  image: string;
}

const serviceCategories: ServiceCategory[] = [
  {
    title: "Creative Design Services",
    href: "#creative-design",
    items: [
      { title: "Ad creative", desc: "Eye-catching designs that perform", href: "#service-ad-creative" },
      { title: "Social media creative", desc: "Engaging assets for all platforms", href: "#service-social-media" },
      { title: "Presentation design", desc: "Captivating slides that tell your story", href: "#service-presentation-design" },
      { title: "Illustration design", desc: "Visual storytelling for your brand", href: "#service-illustration-design" },
      { title: "Branding services", desc: "Expertise & custom design services", href: "#service-branding-services" },
      { title: "eBook & report design", desc: "Your digital content supercharged", href: "#service-ebook-report" },
      { title: "Concept creation", desc: "Big ideas crafted for maximum impact", href: "#service-concept-creation" },
      { title: "Print design", desc: "Tangible designs that leave a lasting impression", href: "#service-print-design" },
      { title: "Packaging & merchandise design", desc: "Bring your brand to life", href: "#service-packaging-merchandise" }
    ]
  },
  {
    title: "Production Services",
    href: "#production-services",
    items: [
      { title: "Video production", desc: "Effortless video production at scale", href: "#service-video-production" },
      { title: "Motion design", desc: "For websites, ads, and presentations", href: "#service-motion-design" },
      { title: "Email creation", desc: "Click-worthy emails that drive engagement", href: "#service-email-creation" },
      { title: "Web design", desc: "High-converting websites and landing pages", href: "#service-web-design" },
      { title: "Design Systems", desc: "Robust design systems that drive visual consistency", href: "#service-design-systems" },
      { title: "Product Design", desc: "Engaging & intuitive experiences", href: "#service-product-design" },
      { title: "Copywriting", desc: "Persuasive words for clarity and action", href: "#service-copywriting" }
    ]
  },
  {
    title: "AI Services",
    href: "#ai-services",
    items: [
      { title: "AI-powered creative", desc: "Human brilliance powered by AI", href: "#service-ai-powered-creative" },
      { title: "AI consulting", desc: "Transform your team with AI", href: "#service-ai-consulting" },
      { title: "Automation", desc: "Move fast without compromising craft", href: "#service-automation" },
      { title: "Data services", desc: "Train your AI with creative data", href: "#service-data-services" }
    ]
  },
  {
    title: "Marketing services",
    href: "#marketing-services",
    items: [
      { title: "Campaign strategy", desc: "Strategy, messaging, and concept for multi-market campaigns", href: "#service-campaign-strategy" }
    ]
  }
];

const whyUsItems: WhyUsItem[] = [
  {
    title: "Our creative talent",
    desc: "Meet your dedicated team",
    href: "#creative-talent",
    image: "/images/why-us/creative-talent.jpg"
  },
  {
    title: "AI excellence",
    desc: "Your shortcut to AI’s creative advantage",
    href: "#ai-excellence",
    image: "/images/why-us/ai-excellence.jpg"
  },
  {
    title: "Our technology",
    desc: "The tech powering your creative edge",
    href: "#our-technology",
    image: "/images/why-us/our-technology.jpg"
  }
];
---

<header class="header-container" id="site-header">
  <div class="header-capsule">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="Adaptif Home">
      <img 
        src="/logo.svg" 
        alt="Adaptif" 
        class="brand-logo brand-logo-default" 
        width="116" 
        height="56" 
        loading="eager" 
        decoding="async" 
      />
      <img 
        src="/logo-dark.svg" 
        alt="Adaptif" 
        class="brand-logo brand-logo-dark" 
        width="116" 
        height="56" 
        loading="eager" 
        decoding="async" 
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop" aria-label="Main Navigation">
      <ul class="nav-list">
        <!-- Services Mega Menu Item -->
        <li class="nav-item nav-item-services">
          <button 
            type="button" 
            class="nav-link nav-link-services" 
            id="services-trigger" 
            aria-expanded="false" 
            aria-haspopup="true"
            aria-controls="services-mega-menu"
          >
            <span>Services</span>
            <svg class="chevron-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Mega Menu Dropdown Container -->
          <div class="mega-menu-wrapper" id="services-mega-menu" role="region" aria-label="Services Mega Menu">
            <div class="mega-menu-panel">
              <div class="mega-menu-grid">
                <!-- Column 1: Creative Design Services -->
                <div class="mega-column">
                  <a href={serviceCategories[0].href} class="mega-column-title">
                    <span class="column-title-text">{serviceCategories[0].title}</span>
                    <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <ul class="mega-item-list">
                    {serviceCategories[0].items.map((item) => (
                      <li>
                        <a href={item.href} class="mega-item">
                          <span class="mega-item-header">
                            <span class="mega-item-title">{item.title}</span>
                            <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="mega-item-desc">{item.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Column 2: Production Services -->
                <div class="mega-column">
                  <a href={serviceCategories[1].href} class="mega-column-title">
                    <span class="column-title-text">{serviceCategories[1].title}</span>
                    <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                      <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <ul class="mega-item-list">
                    {serviceCategories[1].items.map((item) => (
                      <li>
                        <a href={item.href} class="mega-item">
                          <span class="mega-item-header">
                            <span class="mega-item-title">{item.title}</span>
                            <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                              <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>
                          <span class="mega-item-desc">{item.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Column 3: AI Services & Marketing Services -->
                <div class="mega-column">
                  <!-- AI Services -->
                  <div class="mega-subgroup">
                    <a href={serviceCategories[2].href} class="mega-column-title">
                      <span class="column-title-text">{serviceCategories[2].title}</span>
                      <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                        <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                    <ul class="mega-item-list">
                      {serviceCategories[2].items.map((item) => (
                        <li>
                          <a href={item.href} class="mega-item">
                            <span class="mega-item-header">
                              <span class="mega-item-title">{item.title}</span>
                              <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span>
                            <span class="mega-item-desc">{item.desc}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Marketing Services -->
                  <div class="mega-subgroup mega-subgroup-marketing">
                    <a href={serviceCategories[3].href} class="mega-column-title">
                      <span class="column-title-text">{serviceCategories[3].title}</span>
                      <svg class="title-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                        <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                    <ul class="mega-item-list">
                      {serviceCategories[3].items.map((item) => (
                        <li>
                          <a href={item.href} class="mega-item">
                            <span class="mega-item-header">
                              <span class="mega-item-title">{item.title}</span>
                              <svg class="item-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span>
                            <span class="mega-item-desc">{item.desc}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Mega Menu Bottom Bar -->
              <div class="mega-footer-bar">
                <div class="mega-footer-info">
                  <span class="mega-footer-dot" aria-hidden="true"></span>
                  <span>All 21+ services included in your subscription. Unlimited requests & revisions.</span>
                </div>
                <a href="/pricing" class="mega-footer-link">
                  <span>View Pricing Plans</span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.33 8h9.34M8 3.33L12.67 8 8 12.67" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </li>

        <li><a href="#our-work" class="nav-link">Our Work</a></li>
        
        <!-- Why Us Mega Menu Item -->
        <li class="nav-item nav-item-why-us">
          <button 
            type="button" 
            class="nav-link nav-link-why-us" 
            id="why-us-trigger" 
            aria-expanded="false" 
            aria-haspopup="true"
            aria-controls="why-us-mega-menu"
          >
            <span>Why Us</span>
            <svg class="chevron-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Why Us Mega Menu Dropdown Container -->
          <div class="mega-menu-wrapper why-us-wrapper" id="why-us-mega-menu" role="region" aria-label="Why Us Mega Menu">
            <div class="mega-menu-panel why-us-panel">
              <div class="why-us-grid">
                {whyUsItems.map((item) => (
                  <a href={item.href} class="why-us-card">
                    <div class="why-us-media">
                      <img 
                        src={item.image} 
                        alt={item.title} 
                        class="why-us-img"
                        width="406"
                        height="250"
                        loading="eager"
                      />
                      <div class="why-us-media-glow"></div>
                    </div>
                    <div class="why-us-info">
                      <div class="why-us-title-row">
                        <span class="why-us-title">{item.title}</span>
                        <div class="why-us-arrow-wrap" aria-hidden="true">
                          <svg class="why-us-arrow" width="13" height="13" viewBox="0 0 16 16" fill="none">
                            <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </div>
                      </div>
                      <span class="why-us-desc">{item.desc}</span>
                    </div>
                  </a>
                ))}
              </div>

              <!-- Why Us Bottom Bar -->
              <div class="mega-footer-bar">
                <div class="mega-footer-info">
                  <span class="mega-footer-dot" aria-hidden="true"></span>
                  <span>A unified creative engine combining world-class designers, AI velocity, and proprietary tech.</span>
                </div>
                <a href="#dedicated-team" class="mega-footer-link">
                  <span>Meet your dedicated team</span>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.33 8h9.34M8 3.33L12.67 8 8 12.67" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </li>
        <li><a href="#resources" class="nav-link">Resources</a></li>
        <li><a href="/pricing" class="nav-link">Pricing</a></li>
        <li><a href="#dedicated-team" class="nav-link">Dedicated Team</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="#contact" class="btn-cta-header">
        <span class="btn-glow-aurora" aria-hidden="true"></span>
        <span class="btn-text">Book a Call</span>
        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button 
        class="mobile-toggle" 
        id="mobile-toggle-btn" 
        aria-label="Open menu" 
        aria-expanded="false" 
        aria-controls="mobile-nav"
      >
        <span class="bar bar-top"></span>
        <span class="bar bar-bottom"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Blur & Dark Dimmer -->
  <div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

  <!-- Mobile Drawer Overlay -->
  <div class="mobile-drawer" id="mobile-nav" aria-hidden="true">
    <div class="mobile-drawer-scroll">
      <div class="mobile-drawer-content">
        <ul class="mobile-nav-list">
          <!-- Mobile Services Accordion Item -->
          <li class="mobile-nav-item mobile-services-item" id="mobile-services-item">
            <button 
              type="button" 
              class="mobile-nav-accordion-btn" 
              id="mobile-services-accordion" 
              aria-expanded="false"
              aria-controls="mobile-services-panel"
            >
              <span>Services</span>
              <svg class="mobile-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            
            <div class="mobile-services-panel" id="mobile-services-panel">
              <div class="mobile-services-inner">
                <div class="mobile-services-body">
                  {serviceCategories.map((category) => (
                    <div class="mobile-category-accordion-group" data-category-group>
                      <button 
                        type="button" 
                        class="mobile-category-trigger-btn" 
                        aria-expanded="false"
                      >
                        <div class="mobile-cat-btn-left">
                          <span class="mobile-cat-dot"></span>
                          <span class="mobile-cat-btn-title">{category.title}</span>
                        </div>
                        <svg class="mobile-cat-chevron" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>

                      <div class="mobile-category-collapse">
                        <div class="mobile-category-collapse-inner">
                          <ul class="mobile-category-items">
                            {category.items.map((item) => (
                              <li>
                                <a href={item.href} class="mobile-service-subitem">
                                  <div class="mobile-subitem-top">
                                    <span class="mobile-service-title">{item.title}</span>
                                    <svg class="mobile-subitem-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                                      <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                  </div>
                                  <span class="mobile-service-desc">{item.desc}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  ))}


                  <!-- Mobile Services Footer Note -->
                  <div class="mobile-services-footer-note">
                    <span class="mega-footer-dot"></span>
                    <span>All 21+ services included in your subscription. Unlimited requests & revisions.</span>
                  </div>
                </div>
              </div>
            </div>
          </li>

          <li><a href="#our-work" class="mobile-nav-link">Our Work</a></li>

          <!-- Mobile Why Us Accordion Item -->
          <li class="mobile-nav-item mobile-why-us-item" id="mobile-why-us-item">
            <button 
              type="button" 
              class="mobile-nav-accordion-btn" 
              id="mobile-why-us-accordion" 
              aria-expanded="false"
              aria-controls="mobile-why-us-panel"
            >
              <span>Why Us</span>
              <svg class="mobile-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3.5 6L8 10.5L12.5 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            
            <div class="mobile-why-us-panel" id="mobile-why-us-panel">
              <div class="mobile-why-us-inner">
                <div class="mobile-why-us-body">
                  {whyUsItems.map((item) => (
                    <a href={item.href} class="mobile-why-us-card">
                      <div class="mobile-why-us-thumb-box">
                        <img 
                          src={item.image} 
                          alt={item.title} 
                          class="mobile-why-us-thumb" 
                          width="96" 
                          height="60"
                          loading="lazy"
                        />
                      </div>
                      <div class="mobile-why-us-content">
                        <div class="mobile-why-us-header">
                          <span class="mobile-why-us-title">{item.title}</span>
                          <svg class="mobile-subitem-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none">
                            <path d="M3.5 8H12.5M12.5 8L8.5 4M12.5 8L8.5 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </div>
                        <span class="mobile-why-us-desc">{item.desc}</span>
                      </div>
                    </a>
                  ))}

                  <!-- Mobile Why Us Footer Note -->
                  <div class="mobile-services-footer-note">
                    <span class="mega-footer-dot"></span>
                    <span>Dedicated talent, AI workflows, and proprietary creative tech.</span>
                  </div>
                </div>
              </div>
            </div>
          </li>
          <li><a href="#resources" class="mobile-nav-link">Resources</a></li>
          <li><a href="/pricing" class="mobile-nav-link">Pricing</a></li>
          <li><a href="#dedicated-team" class="mobile-nav-link">Dedicated Team</a></li>
        </ul>

        <div class="mobile-drawer-footer">
          <a href="#contact" class="btn-cta-mobile">
            <span class="btn-glow-aurora" aria-hidden="true"></span>
            <span>Book a Call</span>
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .header-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-top: clamp(14px, 2.5vh, 24px);
    padding-inline: clamp(1rem, 3.5vw, 2.5rem);
    z-index: 100;
    pointer-events: none;
    transition: 
      padding-top 0.4s var(--ease-spring),
      top 0.4s var(--ease-spring);
  }

  /* When Scrolled: Detaches into floating frosted capsule */
  .header-container.is-scrolled {
    top: 14px;
    padding-top: 0;
  }

  .header-capsule {
    position: relative;
    z-index: 101;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px 10px 18px;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    box-shadow: none;
    transition: 
      background 0.45s var(--ease-spring),
      border-color 0.45s var(--ease-spring),
      box-shadow 0.45s var(--ease-spring),
      backdrop-filter 0.45s var(--ease-spring),
      padding 0.45s var(--ease-spring);
  }

  /* Scrolled floating glass state (only when mobile menu is closed) */
  .header-container.is-scrolled:not(.mobile-open) .header-capsule {
    padding: 8px 14px 8px 18px;
    background: var(--glass-bg-surface);
    backdrop-filter: var(--glass-blur-md);
    -webkit-backdrop-filter: var(--glass-blur-md);
    border: var(--border-hairline);
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.2),
      0 14px 36px -6px rgba(1, 3, 10, 0.85),
      0 0 28px -5px rgba(72, 200, 255, 0.25);
  }

  .header-container.is-scrolled:not(.mobile-open) .header-capsule:hover {
    border-color: rgba(72, 200, 255, 0.4);
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.3),
      0 18px 44px -4px rgba(0, 2, 8, 0.9),
      0 0 38px -2px rgba(72, 200, 255, 0.35);
  }

  /* ==========================================================================
     LIGHT THEME (WHEN MENU FLOATS OVER LIGHT BACKGROUND SECTIONS)
     ========================================================================== */
  .header-container.theme-light.is-scrolled:not(.mobile-open) .header-capsule {
    background: rgba(255, 255, 255, 0.84);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(15, 23, 42, 0.09);
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 1),
      0 12px 32px -6px rgba(15, 23, 42, 0.08),
      0 0 24px -4px rgba(2, 132, 199, 0.12);
  }

  .header-container.theme-light.is-scrolled:not(.mobile-open) .header-capsule:hover {
    border-color: rgba(2, 132, 199, 0.32);
    box-shadow: 
      inset 0 1px 2px 0 rgba(255, 255, 255, 1),
      0 16px 40px -4px rgba(15, 23, 42, 0.12),
      0 0 32px -2px rgba(2, 132, 199, 0.2);
  }

  .header-container.theme-light .nav-link {
    color: #334155;
  }

  .header-container.theme-light .nav-link:hover,
  .header-container.theme-light .nav-item-services:hover .nav-link-services,
  .header-container.theme-light .nav-item-services.is-open .nav-link-services,
  .header-container.theme-light .nav-item-why-us:hover .nav-link-why-us,
  .header-container.theme-light .nav-item-why-us.is-open .nav-link-why-us {
    color: #0f172a;
  }

  .header-container.theme-light .nav-link::before {
    background: rgba(15, 23, 42, 0.06);
  }

  .header-container.theme-light .chevron-arrow {
    color: #64748b;
  }

  .header-container.theme-light .nav-item-services:hover .chevron-arrow,
  .header-container.theme-light .nav-item-services.is-open .chevron-arrow,
  .header-container.theme-light .nav-item-why-us:hover .chevron-arrow,
  .header-container.theme-light .nav-item-why-us.is-open .chevron-arrow {
    color: #0284c7;
  }

  .header-container.theme-light:not(.mobile-open) .mobile-toggle {
    background: rgba(15, 23, 42, 0.05);
    border-color: rgba(15, 23, 42, 0.12);
  }

  .header-container.theme-light:not(.mobile-open) .mobile-toggle:hover {
    background: rgba(15, 23, 42, 0.1);
  }

  .header-container.theme-light:not(.mobile-open) .mobile-toggle .bar {
    background-color: #0f172a;
  }

  .header-container.theme-light .btn-cta-header {
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.65),
      0 4px 16px -2px rgba(10, 163, 248, 0.45);
  }

  .header-container.theme-light .btn-cta-header:hover {
    box-shadow: 
      inset 0 1px 2px 0 rgba(255, 255, 255, 0.8),
      0 8px 24px -2px rgba(10, 163, 248, 0.6);
  }

  /* When mobile menu is open: completely borderless, glowless, and completely static (no shrinking or hover shifts) */
  .header-container.mobile-open .header-capsule,
  .header-container.mobile-open .header-capsule:hover {
    background: transparent !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    border: 1px solid transparent !important;
    box-shadow: none !important;
    transition: none !important;
  }

  .header-container.mobile-open .brand-link,
  .header-container.mobile-open .brand-link:hover,
  .header-container.mobile-open .brand-link:hover .brand-logo,
  .header-container.mobile-open .brand-logo {
    transform: none !important;
    transition: none !important;
  }

  .header-container.mobile-open .mobile-toggle,
  .header-container.mobile-open .mobile-toggle:hover {
    transform: none !important;
  }

  /* Brand Logo */
  .brand-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    outline-offset: 4px;
    padding: 4px 6px;
  }

  .brand-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
    transition: 
      transform var(--duration-fast) var(--ease-spring),
      opacity 0.35s ease;
  }

  .brand-logo-default {
    display: block;
    opacity: 1;
    filter: drop-shadow(0 2px 8px rgba(0, 102, 255, 0.25));
  }

  .brand-logo-dark {
    position: absolute;
    top: 4px;
    left: 6px;
    display: block;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.06));
  }

  .brand-link:hover .brand-logo {
    transform: scale(1.03);
  }

  /* When over light background (and mobile drawer is closed): crossfade logo */
  .header-container.theme-light:not(.mobile-open) .brand-logo-default {
    opacity: 0;
    pointer-events: none;
  }

  .header-container.theme-light:not(.mobile-open) .brand-logo-dark {
    opacity: 1;
    pointer-events: auto;
  }

  /* Desktop Navigation */
  .nav-desktop {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 4px;
  }

  .nav-item {
    position: relative;
  }

  /* Specifically for Services and Why Us mega-menus anchoring to capsule */
  .nav-item-services,
  .nav-item-why-us {
    position: static;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-size: var(--font-size-nav);
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-pill);
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--duration-fast) var(--ease-spring);
  }

  .nav-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    opacity: 0;
    transform: scale(0.92);
    transition: 
      opacity var(--duration-fast) var(--ease-spring),
      transform var(--duration-fast) var(--ease-spring);
  }

  .nav-link:hover,
  .nav-item-services:hover .nav-link-services,
  .nav-item-services.is-open .nav-link-services,
  .nav-item-why-us:hover .nav-link-why-us,
  .nav-item-why-us.is-open .nav-link-why-us {
    color: var(--color-text-white);
  }

  .nav-link:hover::before,
  .nav-item-services:hover .nav-link-services::before,
  .nav-item-services.is-open .nav-link-services::before,
  .nav-item-why-us:hover .nav-link-why-us::before,
  .nav-item-why-us.is-open .nav-link-why-us::before {
    opacity: 1;
    transform: scale(1);
  }

  .chevron-arrow {
    color: var(--color-text-secondary);
    transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), color var(--duration-fast);
  }

  .nav-item-services:hover .chevron-arrow,
  .nav-item-services.is-open .chevron-arrow,
  .nav-item-why-us:hover .chevron-arrow,
  .nav-item-why-us.is-open .chevron-arrow {
    transform: rotate(180deg);
    color: #48C8FF;
  }

  /* ==========================================================================
     MEGA MENU CONTAINER & DROPDOWN PANEL
     ========================================================================== */
  .mega-menu-wrapper {
    position: absolute;
    top: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%) translateY(-10px) scale(0.975);
    width: min(1160px, calc(100vw - 36px));
    padding-top: 14px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    z-index: 150;
    will-change: transform, opacity;
    transform-origin: top center;
    transition: 
      transform 0.22s cubic-bezier(0.25, 0.1, 0.25, 1),
      opacity 0.2s cubic-bezier(0.25, 0.1, 0.25, 1),
      visibility 0s 0.22s;
  }

  /* Extended invisible hover bridge to span the gap seamlessly */
  .mega-menu-wrapper::before {
    content: "";
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: 36px;
    background: transparent;
    pointer-events: auto;
  }

  /* Hover & Open States */
  .nav-item-services:hover #services-mega-menu,
  .nav-item-services:focus-within #services-mega-menu,
  .nav-item-services.is-open #services-mega-menu,
  .nav-item-why-us:hover #why-us-mega-menu,
  .nav-item-why-us:focus-within #why-us-mega-menu,
  .nav-item-why-us.is-open #why-us-mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0) scale(1);
    transition: 
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s 0s;
  }

  .mega-menu-panel {
    position: relative;
    background-color: #030716;
    background-image: 
      radial-gradient(ellipse 65% 45% at 50% 0%, rgba(72, 200, 255, 0.14) 0%, transparent 70%),
      radial-gradient(ellipse 45% 35% at 85% 60%, rgba(0, 102, 255, 0.08) 0%, transparent 60%);
    border: 1px solid rgba(72, 200, 255, 0.24);
    border-radius: 22px;
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.25),
      inset 0 -1px 1px 0 rgba(0, 229, 255, 0.15),
      0 28px 70px -12px rgba(0, 2, 8, 0.96),
      0 0 45px -5px rgba(72, 200, 255, 0.25);
    padding: 24px 28px 16px 28px;
    max-height: calc(85vh - 70px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(72, 200, 255, 0.3) transparent;
  }

  .mega-menu-panel::-webkit-scrollbar {
    width: 6px;
  }

  .mega-menu-panel::-webkit-scrollbar-thumb {
    background: rgba(72, 200, 255, 0.3);
    border-radius: 10px;
  }

  /* 3-Column Grid */
  .mega-menu-grid {
    display: grid;
    grid-template-columns: 1.05fr 1.05fr 1fr;
    gap: 24px;
  }

  .mega-subgroup-marketing {
    margin-top: 18px;
  }

  .mega-column {
    display: flex;
    flex-direction: column;
  }

  /* Column Category Title [Link/Título] */
  .mega-column-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px 10px 10px;
    margin-bottom: 8px;
    border-bottom: 1px solid rgba(72, 200, 255, 0.18);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #48C8FF;
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }

  .title-arrow {
    opacity: 0.6;
    color: #48C8FF;
    transition: opacity var(--duration-fast), transform var(--duration-fast);
  }

  .mega-column-title:hover {
    color: #ffffff;
    border-color: rgba(72, 200, 255, 0.45);
  }

  .mega-column-title:hover .title-arrow {
    opacity: 1;
    color: #ffffff;
    transform: translate(2px, -2px);
  }

  /* Item List */
  .mega-item-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mega-item {
    display: flex;
    flex-direction: column;
    padding: 7px 10px;
    border-radius: 10px;
    background: transparent;
    border: 1px solid transparent;
    transition: 
      background var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .mega-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .mega-item-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #f1f5f9;
    letter-spacing: -0.01em;
    transition: color var(--duration-fast);
  }

  .item-arrow {
    color: #48C8FF;
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--duration-fast) ease, transform var(--duration-fast) ease;
  }

  .mega-item-desc {
    font-size: 0.74rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
    margin-top: 2px;
    transition: color var(--duration-fast);
  }

  .mega-item:hover {
    background: rgba(72, 200, 255, 0.07);
    border-color: rgba(72, 200, 255, 0.2);
    transform: translateX(3px);
  }

  .mega-item:hover .mega-item-title {
    color: #48C8FF;
  }

  .mega-item:hover .mega-item-desc {
    color: #cbd5e1;
  }

  .mega-item:hover .item-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Spotlight Feature Card in Column 4 */
  .mega-spotlight-card {
    margin-top: 14px;
    padding: 14px 16px;
    background: linear-gradient(135deg, rgba(8, 18, 44, 0.8) 0%, rgba(14, 28, 66, 0.5) 100%);
    border: 1px solid rgba(72, 200, 255, 0.25);
    border-radius: 14px;
    box-shadow: 
      inset 0 1px 1px rgba(255, 255, 255, 0.15),
      0 8px 20px -4px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .spotlight-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #48C8FF;
  }

  .tag-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #48C8FF;
    box-shadow: 0 0 8px #48C8FF;
    animation: spotPulse 2s infinite;
  }

  @keyframes spotPulse {
    0%, 100% { opacity: 0.6; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .spotlight-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
  }

  .spotlight-text {
    font-size: 0.74rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  .spotlight-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #48C8FF;
    margin-top: 4px;
    transition: color var(--duration-fast), transform var(--duration-fast);
  }

  .spotlight-cta:hover {
    color: #ffffff;
    transform: translateX(3px);
  }

  /* Mega Menu Bottom Bar */
  .mega-footer-bar {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .mega-footer-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  .mega-footer-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #48C8FF;
    box-shadow: 0 0 8px rgba(72, 200, 255, 0.8);
  }

  .mega-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #48C8FF;
    white-space: nowrap;
    transition: color var(--duration-fast), transform var(--duration-fast);
  }

  .mega-footer-link:hover {
    color: #ffffff;
    transform: translateX(2px);
  }

  /* ==========================================================================
     WHY US MEGA MENU (3-Column Rich Visual Cards)
     ========================================================================== */
  .why-us-wrapper {
    width: min(940px, calc(100vw - 36px));
  }

  .why-us-panel {
    padding: 22px 24px 16px 24px;
    background-color: #030716;
    background-image: 
      radial-gradient(ellipse 65% 50% at 50% 0%, rgba(72, 200, 255, 0.14) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 85% 80%, rgba(0, 102, 255, 0.08) 0%, transparent 60%);
    border: 1px solid rgba(72, 200, 255, 0.24);
    border-radius: 22px;
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.25),
      inset 0 -1px 1px 0 rgba(0, 229, 255, 0.15),
      0 28px 70px -12px rgba(0, 2, 8, 0.96),
      0 0 45px -5px rgba(72, 200, 255, 0.25);
  }

  .why-us-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .why-us-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    background: rgba(4, 9, 26, 0.7);
    border: 1px solid rgba(72, 200, 255, 0.16);
    overflow: hidden;
    text-decoration: none;
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.1),
      0 12px 28px -6px rgba(0, 0, 0, 0.7);
    transition: 
      transform 0.28s var(--ease-spring),
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .why-us-card:hover {
    transform: translateY(-4px);
    background: rgba(8, 18, 44, 0.85);
    border-color: rgba(72, 200, 255, 0.45);
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.22),
      0 20px 45px -8px rgba(0, 0, 0, 0.9),
      0 0 32px -4px rgba(72, 200, 255, 0.3);
  }

  .why-us-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #02050e;
    border-bottom: 1px solid rgba(72, 200, 255, 0.14);
  }

  .why-us-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.96) saturate(1.05);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }

  .why-us-card:hover .why-us-img {
    transform: scale(1.06);
    filter: brightness(1.08) saturate(1.15);
  }

  .why-us-media-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(72, 200, 255, 0.15) 0%, transparent 70%);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .why-us-card:hover .why-us-media-glow {
    opacity: 1;
  }

  .why-us-info {
    padding: 14px 16px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .why-us-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .why-us-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .why-us-card:hover .why-us-title {
    color: #48C8FF;
  }

  .why-us-arrow-wrap {
    width: 24px;
    height: 24px;
    min-width: 24px;
    border-radius: 50%;
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #48C8FF;
    transition: 
      transform 0.22s var(--ease-spring),
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .why-us-card:hover .why-us-arrow-wrap {
    transform: translateX(3px);
    background: #48C8FF;
    border-color: #48C8FF;
    color: #020716;
  }

  .why-us-desc {
    font-size: 0.78rem;
    color: #8FA0BA;
    line-height: 1.4;
    margin: 0;
    transition: color 0.2s ease;
  }

  .why-us-card:hover .why-us-desc {
    color: #cbd5e1;
  }

  /* ==========================================================================
     ACTIONS & BUTTONS
     ========================================================================== */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-cta-header {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    font-size: var(--font-size-btn);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
    background: 
      radial-gradient(ellipse 90% 65% at 50% 0%, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0) 72%),
      linear-gradient(180deg, #56d3ff 0%, #30baff 48%, #0aa3f8 100%);
    border: none;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-button-primary);
    text-shadow: 0 1px 2px rgba(0, 60, 130, 0.35);
    overflow: hidden;
    cursor: pointer;
    transition: 
      transform var(--duration-fast) var(--ease-spring),
      box-shadow var(--duration-fast) var(--ease-spring);
  }

  .btn-text {
    position: relative;
    z-index: 2;
  }

  .btn-arrow {
    position: relative;
    z-index: 2;
    color: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0, 20, 60, 0.4));
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .btn-glow-aurora {
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at 50% 0%, rgba(72, 200, 255, 0.8) 0%, transparent 70%);
    opacity: 0.6;
    transition: opacity var(--duration-fast);
  }

  .btn-cta-header:hover {
    transform: translateY(-1.5px) scale(1.01);
    box-shadow: var(--shadow-button-hover);
  }

  .btn-cta-header:hover .btn-glow-aurora {
    opacity: 1;
  }

  .btn-cta-header:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* Mobile Toggle Button */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-white);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-spring);
  }

  .mobile-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .bar {
    width: 18px;
    height: 1.75px;
    background-color: var(--color-text-white);
    border-radius: var(--radius-pill);
    transition: transform 0.3s var(--ease-spring), opacity 0.2s ease;
  }

  /* ==========================================================================
     MOBILE DRAWER & ACCORDION
     ========================================================================== */
  .mobile-backdrop {
    display: none;
  }

  .mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    height: 100vh;
    pointer-events: auto;
    background: #030716;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: 
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s 0.28s;
    z-index: 95;
  }

  .mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: 
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
