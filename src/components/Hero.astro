---
// Hero.astro - Luminous Obsidian Glass & Kinetic Creative Engine
import HeroBackground from "./HeroBackground.astro";
import ReelGallery from "./ReelGallery.astro";
---

<section class="hero-section" id="hero">
  <!-- Animated Kinetic Looping Background (Aurora, Anamorphic Flare & Volumetric Laser) -->
  <HeroBackground />

  <div class="container hero-container">
    <!-- Top Pill Badge -->
    <div class="hero-badge-wrapper">
      <div class="hero-badge">
        <span class="badge-text desktop-only">AI-Driven Creative Department • Subscription Model</span>
        <span class="badge-text mobile-only">AI Creative Department • Subscription</span>
      </div>
    </div>

    <!-- Main Typography Header -->
    <div class="hero-copy-wrapper">
      <h1 class="hero-title">
        The fuel behind your <br class="br-desktop" />
        creative <span class="title-engine">engine</span>
      </h1>
      <p class="hero-description">
        A subscription that plugs an AI‑driven creative department into your team:
        <strong>design</strong>, <strong>dev</strong> and <strong>marketing</strong>, 
        unlimited requests and revisions, rapid turnarounds and a single, predictable monthly cost.
      </p>
    </div>

    <!-- Call to Actions -->
    <div class="hero-cta-group">
      <a href="#contact" class="btn-primary-hero">
        <span class="btn-glow-aurora" aria-hidden="true"></span>
        <span class="btn-primary-content">
          <span>Book a Call</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>

      <a href="#pricing" class="btn-secondary-hero">
        <span>Get Started</span>
        <span class="btn-secondary-glow" aria-hidden="true"></span>
      </a>
    </div>

    <!-- Guarantees Row -->
    <div class="hero-perks">
      <div class="perk-item">
        <svg class="perk-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Agile 48-72h turnarounds</span>
      </div>
      <div class="perk-separator">•</div>
      <div class="perk-item">
        <svg class="perk-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Unlimited requests & revisions</span>
      </div>
      <div class="perk-separator">•</div>
      <div class="perk-item">
        <svg class="perk-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>Pause or cancel anytime</span>
      </div>
    </div>

    <!-- Reel Gallery Showcase (Infinite drifting gallery with user-specified configuration) -->
    <div class="hero-reel-wrapper">
      <ReelGallery
        rows={1}
        rowHeight={180}
        tilt={0}
        speed={1.55}
        dim={0.35}
      />
    </div>
  </div>

  <!-- Dissolves WebGL stars seamlessly into the flat obsidian void -->
  <div class="hero-bottom-fade" aria-hidden="true"></div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100dvh;
    background-color: var(--color-void);
    padding-top: calc(var(--header-height) + clamp(30px, 6vh, 60px));
    padding-bottom: clamp(40px, 8vh, 90px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  /* Dissolves WebGL stars seamlessly into flat obsidian void with zero line */
  .hero-bottom-fade {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: clamp(160px, 24vh, 320px);
    background: linear-gradient(
      180deg,
      rgba(1, 3, 7, 0) 0%,
      rgba(1, 3, 7, 0.25) 30%,
      rgba(1, 3, 7, 0.65) 60%,
      rgba(1, 3, 7, 0.92) 85%,
      var(--color-void) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  /* Volumetric Light Shaft emanating from top into hero */
  .hero-light-shaft {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(200px, 35vw, 420px);
    height: clamp(350px, 50vh, 550px);
    background: linear-gradient(
      180deg,
      rgba(0, 229, 255, 0.45) 0%,
      rgba(0, 102, 255, 0.22) 40%,
      rgba(4, 9, 26, 0) 100%
    );
    filter: blur(55px);
    pointer-events: none;
    z-index: 1;
    opacity: 0.7;
    animation: shaftGlow 6s ease-in-out infinite alternate;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Badge Wrapper */
  .hero-badge-wrapper {
    margin-bottom: clamp(16px, 2.5vh, 24px);
    animation: fadeInDown 0.8s var(--ease-spring) both;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 18px;
    background: rgba(6, 15, 38, 0.65);
    backdrop-filter: var(--glass-blur-sm);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: var(--radius-pill);
    box-shadow: 
      inset 0 1px 1px rgba(255, 255, 255, 0.2),
      0 4px 20px -2px rgba(0, 102, 255, 0.25);
    cursor: default;
  }

  .desktop-only {
    display: inline;
  }

  .mobile-only {
    display: none;
  }

  .badge-text {
    font-size: var(--font-size-badge);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #e2e8f0;
    white-space: nowrap;
  }

  /* Headline & Description */
  .hero-copy-wrapper {
    max-width: 900px;
    animation: fadeInUp 0.9s var(--ease-spring) 0.1s both;
  }

  .hero-title {
    font-size: var(--font-size-hero);
    line-height: var(--font-line-height-hero);
    letter-spacing: var(--font-letter-spacing-hero);
    font-weight: 400;
    margin-bottom: clamp(14px, 2vh, 22px);
    text-wrap: balance;
  }

  .title-engine {
    color: #48C8FF;
    position: relative;
    display: inline-block;
    text-shadow: 
      0 0 10px rgba(72, 200, 255, 0.85),
      0 0 25px rgba(72, 200, 255, 0.65),
      0 0 50px rgba(0, 140, 255, 0.45);
    filter: drop-shadow(0 0 20px rgba(72, 200, 255, 0.55));
    animation: engineGlowPulse 5.5s ease-in-out infinite;
  }

  .title-engine::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 120%;
    background: radial-gradient(
      ellipse at center,
      rgba(72, 200, 255, 0.32) 0%,
      rgba(0, 102, 255, 0.12) 50%,
      transparent 75%
    );
    filter: blur(14px);
    pointer-events: none;
    z-index: -1;
    animation: engineHaloBreathe 5.5s ease-in-out infinite;
  }

  .hero-description {
    font-size: var(--font-size-subhero);
    line-height: var(--font-line-height-subhero);
    letter-spacing: var(--font-letter-spacing-subhero);
    color: var(--color-text-secondary);
    max-width: 760px;
    margin-inline: auto;
    font-weight: 400;
    text-wrap: pretty;
  }

  .hero-description strong {
    color: #ffffff;
    font-weight: 500;
  }

  /* CTAs */
  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: clamp(24px, 3.5vh, 36px);
    width: 100%;
    animation: fadeInUp 0.9s var(--ease-spring) 0.2s both;
  }

  .btn-primary-hero {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    border-radius: var(--radius-pill);
    background: linear-gradient(135deg, #48C8FF 0%, #29beff 100%);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: var(--shadow-button-primary);
    color: #020716;
    font-size: var(--font-size-btn);
    font-weight: 700;
    letter-spacing: -0.01em;
    overflow: hidden;
    cursor: pointer;
    transition: 
      transform var(--duration-fast) var(--ease-spring),
      box-shadow var(--duration-fast) var(--ease-spring),
      border-color var(--duration-fast);
  }

  .btn-primary-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-primary-content svg {
    color: #020716;
  }

  .btn-glow-aurora {
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at 50% 0%, rgba(72, 200, 255, 0.8) 0%, transparent 70%);
    opacity: 0.6;
    transition: opacity var(--duration-fast);
  }

  .btn-primary-hero:hover {
    transform: translateY(-2px) scale(1.01);
    border-color: #ffffff;
    box-shadow: var(--shadow-button-hover);
  }

  .btn-primary-hero:hover .btn-glow-aurora {
    opacity: 1;
  }

  .btn-secondary-hero {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    background: rgba(10, 20, 48, 0.45);
    backdrop-filter: var(--glass-blur-sm);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    border: 1px solid rgba(72, 200, 255, 0.35);
    box-shadow: 
      inset 0 1px 1px rgba(255, 255, 255, 0.15),
      0 0 20px -5px rgba(72, 200, 255, 0.15),
      0 8px 24px -6px rgba(0, 0, 0, 0.6);
    color: #e2e8f0;
    font-size: var(--font-size-btn);
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
    transition: 
      transform var(--duration-fast) var(--ease-spring),
      border-color var(--duration-fast),
      color var(--duration-fast);
  }

  .btn-secondary-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(72, 200, 255, 0.1) 0%, transparent 60%);
    opacity: 0;
    transition: opacity var(--duration-fast);
  }

  .btn-secondary-hero:hover {
    transform: translateY(-2px);
    border-color: #48C8FF;
    color: #48C8FF;
  }

  .btn-secondary-hero:hover .btn-secondary-glow {
    opacity: 1;
  }

  /* Perks List */
  .hero-perks {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(20px, 3vh, 30px);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    animation: fadeInUp 0.9s var(--ease-spring) 0.3s both;
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .perk-icon {
    color: #48C8FF;
  }

  .perk-separator {
    color: #48C8FF;
    opacity: 0.5;
    user-select: none;
  }

  /* Reel Gallery Wrapper */
  .hero-reel-wrapper {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-top: clamp(28px, 4.5vh, 48px);
    z-index: 2;
    animation: fadeInUp 1s var(--ease-spring) 0.35s both;
  }

  /* Keyframe Animations */
  @keyframes engineGlowPulse {
    0%, 100% {
      text-shadow: 
        0 0 8px rgba(72, 200, 255, 0.75),
        0 0 20px rgba(72, 200, 255, 0.5),
        0 0 40px rgba(0, 140, 255, 0.3);
      filter: drop-shadow(0 0 12px rgba(72, 200, 255, 0.4));
    }
    50% {
      text-shadow: 
        0 0 16px rgba(72, 200, 255, 1),
        0 0 35px rgba(72, 200, 255, 0.85),
        0 0 70px rgba(0, 140, 255, 0.6),
        0 0 95px rgba(0, 102, 255, 0.35);
      filter: drop-shadow(0 0 28px rgba(72, 200, 255, 0.85));
    }
  }

  @keyframes engineHaloBreathe {
    0%, 100% {
      opacity: 0.5;
      transform: translate(-50%, -50%) scale(0.92);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.12);
    }
  }

  @keyframes shaftGlow {
    0% { opacity: 0.55; transform: translateX(-50%) scaleX(0.95); }
    100% { opacity: 0.8; transform: translateX(-50%) scaleX(1.05); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive Design for Viewport Width & Height */
  @media (max-width: 640px) {
    .desktop-only {
      display: none;
    }

    .mobile-only {
      display: inline;
    }

    .hero-section {
      padding-top: calc(var(--header-height) + 16px);
      justify-content: flex-start;
    }

    .hero-title {
      font-size: clamp(2.2rem, 9.5vw, 3.2rem);
      line-height: 1.05;
      letter-spacing: var(--font-letter-spacing-hero, -0.04em);
    }

    .hero-description {
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .br-desktop {
      display: none;
    }

    .hero-cta-group {
      flex-direction: column;
      width: 100%;
      padding-inline: 10px;
    }

    .btn-primary-hero,
    .btn-secondary-hero {
      width: 100%;
    }

    .hero-perks {
      flex-direction: column;
      gap: 6px;
    }

    .perk-separator {
      display: none;
    }
  }

  @media (max-height: 800px) and (min-width: 768px) {
    .hero-section {
      padding-top: calc(var(--header-height) + 20px);
      padding-bottom: 40px;
    }

    .hero-title {
      margin-bottom: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .title-engine,
    .title-engine::before,
    .hero-badge-wrapper,
    .hero-copy-wrapper,
    .hero-cta-group,
    .hero-perks {
      animation: none !important;
    }
  }
</style>
