---
const differences = [
  {
    label: "Scalable",
    title: "Strengthen your in-house creative team",
    description:
      "We take care of the heavy lifting so you can focus on strategic, high-impact work without increasing overhead or expanding your team.",
    icon: "pen",
  },
  {
    label: "Flexible",
    title: "Take on more projects with confidence",
    description:
      "Whether you need extra bandwidth or specific skills, Adaptif gives you the creative support required to keep work moving forward.",
    icon: "checklist",
  },
  {
    label: "Responsive",
    title: "Speed without lowering standards",
    description:
      "Our global team delivers agency-level creative work quickly, helping you move faster without compromising on quality.",
    icon: "star",
  },
];
---

<section class="our-difference-section" id="our-difference" data-theme="light">
  <div class="our-difference-ambient-glow" aria-hidden="true"></div>

  <div class="our-difference-container">
    <header class="our-difference-header reveal-item">
      <span class="our-difference-eyebrow">OUR DIFFERENCE</span>
      <h2 class="our-difference-title">
        Adaptif is the <span class="title-highlight">perfect fit</span> for fast moving brands
      </h2>
    </header>

    <div class="our-difference-grid">
      {
        differences.map((item, idx) => (
          <article
            class="difference-item reveal-item"
            style={`--reveal-delay: ${100 + idx * 80}ms;`}
          >
            <div class="difference-icon-badge" aria-hidden="true">
              {item.icon === "pen" && (
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 19l7-7 3 3-7 7-3-3z" />
                  <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
                  <path d="M2 2l7.586 7.586" />
                  <circle cx="11" cy="11" r="2" />
                </svg>
              )}
              {item.icon === "checklist" && (
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3.5 6.5L5 8l3-3" />
                  <path d="M3.5 12.5L5 14l3-3" />
                  <path d="M3.5 18.5L5 20l3-3" />
                  <path d="M11 6.5h9.5" />
                  <path d="M11 12.5h9.5" />
                  <path d="M11 18.5h9.5" />
                </svg>
              )}
              {item.icon === "star" && (
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon points="12 2.5 14.95 8.48 21.55 9.44 16.77 14.09 17.9 20.66 12 17.56 6.1 20.66 7.23 14.09 2.45 9.44 9.05 8.48 12 2.5" />
                </svg>
              )}
            </div>

            <span class="difference-label">{item.label}</span>
            <h3 class="difference-heading">{item.title}</h3>
            <p class="difference-description">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const initOurDifference = () => {
    const items = document.querySelectorAll("#our-difference .reveal-item");
    if (!items.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
    );

    items.forEach((item) => observer.observe(item));
  };

  initOurDifference();
  document.addEventListener("astro:page-load", initOurDifference);
</script>

<style>
  .our-difference-section {
    position: relative;
    width: 100%;
    background-color: #fafaf8;
    padding: 120px 0 130px;
    overflow: hidden;
    color: #0b0f19;
    user-select: text;
  }

  .our-difference-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(1100px, 95vw);
    height: 100%;
    background: radial-gradient(
      ellipse 60% 50% at 50% 50%,
      rgba(56, 189, 248, 0.055) 0%,
      rgba(56, 189, 248, 0.015) 45%,
      transparent 75%
    );
    pointer-events: none;
    z-index: 0;
  }

  .our-difference-container {
    position: relative;
    z-index: 1;
    max-width: var(--container-max, 1240px);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .our-difference-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 72px;
  }

  .our-difference-eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0284c7;
    margin-bottom: 14px;
  }

  .our-difference-title {
    margin: 0;
    font-family: var(--font-family-display, serif);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.14;
    color: #0b0f19;
  }

  .our-difference-title .title-highlight {
    font-style: italic;
    background: linear-gradient(135deg, #0070f3 0%, #0099ff 45%, #00c0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: inline-block;
    padding-right: 0.06em;
    filter: drop-shadow(0 2px 10px rgba(0, 153, 255, 0.18));
  }

  /* Grid */
  .our-difference-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px;
  }

  .difference-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .difference-icon-badge {
    width: 58px;
    height: 58px;
    border-radius: 12px;
    background: linear-gradient(145deg, #eaf6fe 0%, #dcf0fc 100%);
    border: 1px solid rgba(56, 189, 248, 0.22);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #0ea5e9;
    margin-bottom: 32px;
    box-shadow: 0 6px 18px -6px rgba(14, 165, 233, 0.14);
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s ease;
  }

  .difference-item:hover .difference-icon-badge {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px -6px rgba(14, 165, 233, 0.22);
  }

  .difference-label {
    font-family: var(--font-family-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #0284c7;
    margin-bottom: 10px;
  }

  .difference-heading {
    margin: 0 0 14px;
    font-family: var(--font-family-body);
    font-size: 1.32rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.28;
    color: #0b0f19;
  }

  .difference-description {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.6;
    color: #64748b;
  }

  /* Reveal Animation */
  .reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .reveal-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Tablet / Mobile */
  @media (max-width: 960px) {
    .our-difference-section {
      padding: 96px 0 104px;
    }

    .our-difference-grid {
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .our-difference-section {
      padding: 80px 0 88px;
    }

    .our-difference-header {
      margin-bottom: 52px;
    }

    .our-difference-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .difference-icon-badge {
      width: 52px;
      height: 52px;
      margin-bottom: 22px;
    }

    .difference-heading {
      font-size: 1.22rem;
      margin-bottom: 10px;
    }
  }
</style>
