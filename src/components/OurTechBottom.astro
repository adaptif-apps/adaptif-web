---
// OurTechBottom.astro - Why Adaptif 3-card showcase
const whyAdaptifCards = [
  {
    label: "Our creative talent",
    href: "/our-creative-talent",
    image: "/images/our-creative-talent/why-creative-talent.jpg",
  },
  {
    label: "AI excellence",
    href: "/ai-excellence",
    image: "/images/our-creative-talent/why-ai-excellence.jpg",
  },
  {
    label: "Our work",
    href: "/our-work",
    image: "/images/our-creative-talent/why-our-work.jpg",
  },
];
---

<section class="tech-why" id="why-adaptif" aria-labelledby="tech-why-title">
  <div class="container">
    <header class="tech-why__header" data-tech-reveal>
      <p class="adaptif-eyebrow">Why Adaptif</p>
      <h2 id="tech-why-title" class="tech-why__title">
        See why the best teams <span class="title-highlight">use Adaptif</span>
      </h2>
    </header>

    <div class="tech-why__grid">
      {whyAdaptifCards.map((card, idx) => (
        <a href={card.href} class="glass-panel tech-why__card" data-tech-reveal="scale" style={`--tech-delay: ${idx * 100}ms`}>
          <div class="tech-why__media">
            <img src={card.image} alt={card.label} loading="lazy" decoding="async" />
            <div class="tech-why__media-scrim" aria-hidden="true"></div>
          </div>
          <div class="tech-why__footer">
            <span class="tech-why__label">{card.label}</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-why {
    padding: clamp(56px, 7vw, 96px) 0 clamp(64px, 8vw, 108px);
    background-color: var(--color-void);
  }

  .tech-why__header {
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .tech-why__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    font-weight: 400;
    line-height: 1.08;
    color: var(--color-text-primary);
  }

  .tech-why__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .tech-why__card {
    position: relative;
    display: block;
    aspect-ratio: 4 / 4.4;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring), border-color var(--duration-fast) ease;
  }

  .tech-why__card:hover {
    transform: translateY(-4px);
    border-color: rgba(72, 200, 255, 0.42);
  }

  .tech-why__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .tech-why__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .tech-why__card:hover .tech-why__media img {
    transform: scale(1.04);
  }

  .tech-why__media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(1, 3, 7, 0.05) 35%, rgba(1, 3, 7, 0.72) 72%, rgba(1, 3, 7, 0.94) 100%);
  }

  .tech-why__footer {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 20px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-text-white);
    text-shadow: 0 2px 12px rgba(1, 3, 7, 0.8);
    transition: color var(--duration-fast) ease;
  }

  .tech-why__card:hover .tech-why__footer {
    color: var(--color-brand-cyan);
  }

  .tech-why__label {
    font-family: var(--font-family-body);
    font-size: 1.02rem;
    font-weight: 600;
  }

  .tech-why__footer svg {
    color: var(--color-brand-cyan);
    transition: transform var(--duration-fast) ease;
  }

  .tech-why__card:hover .tech-why__footer svg {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .tech-why__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
