---
// OurWorkGrid.astro - Featured Work Bento Grid (Light Mode)
// Sketch Specification:
// Header:
//   - Eyebrow: "OUR WORK"
//   - Title: "See how top brands use Adaptif" (with "top brands" in italic cyan accent)
//   - CTA: "Explore all our work" pill button
// Grid: 4-column balanced modular Bento layout:
//   Even rows: [span 2] [span 1] [span 1]
//   Odd rows:  [span 1] [span 1] [span 2]
//   Incomplete last row: 1 item -> span 4; 2 items -> span 2 + span 2

import { portfolioSeed, type PortfolioProject } from "../data/portfolioSeed";
import WorkProjectModal from "./WorkProjectModal.astro";

interface Props {
  projects?: PortfolioProject[];
}

const { projects = portfolioSeed.filter((p) => p.isPublished && p.showOnHome) } = Astro.props;

function getCardSpan(index: number, total: number): number {
  const rowIndex = Math.floor(index / 3);
  const posInRow = index % 3;
  const totalRows = Math.ceil(total / 3);
  const rem = total % 3;

  if (rowIndex === totalRows - 1 && rem !== 0) {
    return rem === 1 ? 4 : 2;
  }

  return rowIndex % 2 === 0 ? (posInRow === 0 ? 2 : 1) : (posInRow === 2 ? 2 : 1);
}
---

<section class="our-work-section" id="our-work" data-theme="light">
  <!-- Subtle Light Ambient Tone -->
  <div class="our-work-ambient-glow" aria-hidden="true"></div>

  <div class="container our-work-container">
    <!-- Header Block: Title on Left, Action Pill on Right -->
    <header class="our-work-header">
      <div class="header-left">
        <div class="eyebrow-wrapper">
          <span class="eyebrow-text">OUR WORK</span>
        </div>
        <h2 class="our-work-title">
          See how <span class="title-highlight">top brands</span> use Adaptif
        </h2>
      </div>

      <div class="header-right">
        <a href="#work" class="explore-btn">
          <span>Explore all our work</span>
          <svg class="btn-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3.33337 8H12.6667M12.6667 8L8.66671 4M12.6667 8L8.66671 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </header>

    <!-- Modular Bento Work Grid -->
    <div class="work-grid">
      {projects.map((item, index) => {
        const span = getCardSpan(index, projects.length);
        return (
          <article
            class={`work-card span-${span}`}
            style={`--card-index: ${index};`}
            data-open-project={item.id}
            role="button"
            tabindex="0"
            aria-label={`View ${item.title} gallery`}
          >
            <div class="work-card-media">
              <img
                src={item.image}
                alt={item.title}
                loading="lazy"
                decoding="async"
                class="work-card-img"
              />
            </div>

            <div class="work-card-info">
              <h3 class="work-card-title">{item.title}</h3>
              <p class="work-card-categories">{item.tags.join(", ")}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<WorkProjectModal projects={projects} syncUrl={false} />

<script is:inline>
  (function () {
    function initOurWork() {
      const section = document.getElementById("our-work");
      if (!section) return;

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              section.classList.add("is-visible");
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
      );
      observer.observe(section);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initOurWork);
    } else {
      initOurWork();
    }
    document.addEventListener("astro:page-load", initOurWork);
  })();
</script>

<style>
  /* ==========================================================================
     OUR WORK SECTION: Light Mode Clean Canvas & Modern Layout
     ========================================================================== */
  .our-work-section {
    position: relative;
    width: 100%;
    padding-top: clamp(80px, 11vh, 130px);
    padding-bottom: clamp(90px, 12vh, 140px);
    background-color: #fafaf8;
    color: #0b0f19;
    overflow: hidden;
    isolation: isolate;
  }

  /* Soft Light Cyan/Sky Ambient Glow */
  .our-work-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(1400px, 100vw);
    height: 90%;
    background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(2, 132, 199, 0.05) 0%, rgba(240, 249, 255, 0.4) 40%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .our-work-container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max, 1240px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  /* ==========================================================================
     HEADER: Title (Left) + Explore CTA (Right)
     ========================================================================== */
  .our-work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(36px, 5vh, 56px);
  }

  .header-left {
    max-width: 680px;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(10px, 1.6vh, 16px);
    opacity: 0;
    transform: translateY(14px);
    transition: 
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0284c7;
    display: inline-block;
  }

  .our-work-title {
    font-family: var(--font-family-display, serif);
    font-size: clamp(2.2rem, 4.2vw, 3.7rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: #0b0f19;
    margin: 0;
    opacity: 0;
    transform: translateY(20px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  /* Accent italic for "top brands" */
  .our-work-title .title-highlight {
    font-style: italic;
    background: linear-gradient(135deg, #0070f3 0%, #0099ff 45%, #00c0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 10px rgba(0, 153, 255, 0.18));
  }

  /* Explore All Our Work Button */
  .header-right {
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
    flex-shrink: 0;
  }

  .explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 24px;
    font-size: 0.88rem;
    font-weight: 500;
    color: #0f172a;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.14);
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.05);
    transition: 
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
      box-shadow 0.25s ease;
  }

  .explore-btn .btn-arrow {
    transition: transform 0.25s ease;
  }

  .explore-btn:hover {
    background: #0b0f19;
    color: #ffffff;
    border-color: #0b0f19;
    box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.22);
    transform: translateY(-2px);
  }

  .explore-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Staggered entrance trigger */
  .our-work-section.is-visible .eyebrow-wrapper,
  .our-work-section.is-visible .our-work-title,
  .our-work-section.is-visible .header-right {
    opacity: 1;
    transform: translateY(0);
  }

  /* ==========================================================================
     BENTO WORK GRID: 4 Columns Balanced Layout
     ========================================================================== */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2vw, 24px);
  }

  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    opacity: 0;
    transform: translateY(28px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) calc(0.15s + var(--card-index, 0) * 0.08s),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) calc(0.15s + var(--card-index, 0) * 0.08s);
  }

  .work-card:focus-visible {
    outline: 2px solid #0284c7;
    outline-offset: 6px;
    border-radius: 20px;
  }

  .our-work-section.is-visible .work-card {
    opacity: 1;
    transform: translateY(0);
  }

  .work-card.span-4 {
    grid-column: span 4;
  }

  .work-card.span-2 {
    grid-column: span 2;
  }

  .work-card.span-1 {
    grid-column: span 1;
  }

  /* Card Media Wrapper (Rounded container with hover zoom) */
  .work-card-media {
    position: relative;
    width: 100%;
    height: clamp(220px, 22vw, 300px);
    border-radius: clamp(16px, 1.8vw, 24px);
    overflow: hidden;
    background-color: #e2e8f0;
    box-shadow: 
      0 10px 28px -10px rgba(15, 23, 42, 0.1),
      0 2px 8px -2px rgba(15, 23, 42, 0.04),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    transition: 
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.002);
    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-card:hover .work-card-media {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 40px -12px rgba(15, 23, 42, 0.16),
      0 4px 12px -2px rgba(15, 23, 42, 0.06),
      0 0 0 1px rgba(15, 23, 42, 0.1);
  }

  .work-card:hover .work-card-img {
    transform: scale(1.04);
  }

  /* Card Text Meta */
  .work-card-info {
    padding-top: clamp(12px, 1.4vw, 18px);
    padding-inline: 4px;
  }

  .work-card-title {
    font-family: var(--font-family-display, serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1.8vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #0b0f19;
    margin: 0;
    transition: color 0.3s ease;
  }

  .work-card:hover .work-card-title {
    color: #0284c7;
  }

  .work-card-categories {
    font-family: var(--font-family-body, sans-serif);
    font-size: clamp(0.78rem, 0.88vw, 0.88rem);
    color: #64748b;
    line-height: 1.45;
    margin-top: 5px;
    margin-bottom: 0;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 960px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .work-card.span-4,
    .work-card.span-2 {
      grid-column: span 2;
    }

    .work-card.span-1 {
      grid-column: span 1;
    }

    .work-card-media {
      height: clamp(200px, 32vw, 280px);
    }
  }

  @media (max-width: 640px) {
    .our-work-section {
      padding-top: 60px;
      padding-bottom: 80px;
    }

    .our-work-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 32px;
    }

    .work-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .work-card.span-4,
    .work-card.span-2,
    .work-card.span-1 {
      grid-column: span 1;
    }

    .work-card-media {
      height: clamp(220px, 58vw, 290px);
      border-radius: 18px;
    }

    .work-card-title {
      font-size: 1.45rem;
    }
  }
</style>
