---
// OurWorkShowcase.astro - Square 1:1 Portfolio Grid + Shareable Horizontal Bento Gallery Overlay
import { portfolioSeed, type PortfolioProject } from "../data/portfolioSeed";

interface Props {
  projects?: PortfolioProject[];
}

const { projects = portfolioSeed } = Astro.props;

const filterGroups = [
  { id: "all", label: "All Projects" },
  { id: "branding", label: "Branding" },
  { id: "web", label: "Web & Ecommerce" },
  { id: "app", label: "App Design" },
  { id: "social", label: "Social, Ads & Email" },
  { id: "packaging", label: "Packaging & Print" },
  { id: "motion", label: "Motion & Video" },
];

function getFilterCategories(tags: string[]): string[] {
  const joined = tags.join(" ").toLowerCase();
  const cats = ["all"];
  if (joined.includes("branding")) cats.push("branding");
  if (joined.includes("web") || joined.includes("ecommerce")) cats.push("web");
  if (joined.includes("app design")) cats.push("app");
  if (
    joined.includes("social") ||
    joined.includes("ad creative") ||
    joined.includes("email") ||
    joined.includes("marketing")
  ) {
    cats.push("social");
  }
  if (
    joined.includes("packaging") ||
    joined.includes("p.o.p") ||
    joined.includes("print")
  ) {
    cats.push("packaging");
  }
  if (joined.includes("motion") || joined.includes("video")) cats.push("motion");
  return cats;
}
---

<section class="work-showcase-section" id="work-showcase" aria-label="Selected client projects">
  <div class="showcase-ambient-glow" aria-hidden="true"></div>

  <div class="showcase-container">
    <div class="showcase-toolbar">
      <div class="filter-bar" id="filter-bar" role="group" aria-label="Filter projects by discipline">
        <span class="filter-indicator" id="filter-indicator" aria-hidden="true"></span>
        {filterGroups.map((group, idx) => (
          <button
            type="button"
            class={idx === 0 ? "filter-pill is-active" : "filter-pill"}
            data-filter={group.id}
            data-label={group.label}
            aria-pressed={idx === 0 ? "true" : "false"}
          >
            <span class="filter-pill-text">{group.label}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="showcase-grid" id="showcase-grid">
      {projects.map((project, index) => {
        const categories = getFilterCategories(project.tags).join(",");

        return (
          <article
            class="project-card"
            data-categories={categories}
            data-project-id={project.id}
          >
            <button
              type="button"
              class="project-trigger"
              data-open-project={project.id}
              aria-label={`Open ${project.title} gallery`}
            >
              <div class="project-thumb">
                <img
                  src={project.image}
                  alt={`${project.title} project showcase`}
                  loading={index < 6 ? "eager" : "lazy"}
                  decoding="async"
                  class="project-img"
                />
                <div class="project-thumb-vignette" aria-hidden="true"></div>

                <div class="project-overlay">
                  <h3 class="project-title">{project.title}</h3>
                  <div class="project-tags-wrap">
                    <ul class="project-tags" aria-label={`${project.title} disciplines`}>
                      {project.tags.map((tag) => (
                        <li class="project-tag">{tag}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </button>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- Shareable Project Gallery Overlay -->
<div
  class="work-modal"
  id="work-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="work-modal-title"
  hidden
>
  <div class="work-modal-backdrop" data-close-modal></div>

  <div class="work-modal-shell">
    <div class="work-modal-topbar">
      <div class="work-modal-actions">
        <button type="button" class="modal-close-btn" id="work-modal-close" aria-label="Close gallery" data-close-modal>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="work-modal-body">
      <!-- Horizontal Bento Gallery Strip (Desktop) / Stacked Bento (Mobile) -->
      <div class="modal-gallery-viewport" id="modal-gallery-viewport" tabindex="0" aria-label="Project image gallery">
        <div class="modal-gallery-track" id="modal-gallery-track"></div>
      </div>

      <!-- Bottom Info Bar (Desktop) / Top Info Header (Mobile) -->
      <div class="modal-info-row">
        <div class="modal-info-title-col">
          <h2 class="modal-title" id="work-modal-title"></h2>
        </div>
        <div class="modal-info-desc-col">
          <p class="modal-desc" id="work-modal-desc"></p>
        </div>
        <div class="modal-info-tags-col">
          <ul class="modal-tags" id="work-modal-tags"></ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ projects }}>
  window.__ADAPTIF_PROJECTS__ = projects;
</script>

<script>
  interface ProjectItem {
    id: string;
    title: string;
    description: string;
    tags: string[];
    image: string;
    gallery: string[];
  }

  function initWorkShowcase() {
    const section = document.getElementById("work-showcase");
    const filterBar = document.getElementById("filter-bar");
    const indicator = document.getElementById("filter-indicator");
    const grid = document.getElementById("showcase-grid");

    const modal = document.getElementById("work-modal");
    const modalTitle = document.getElementById("work-modal-title");
    const modalDesc = document.getElementById("work-modal-desc");
    const modalTags = document.getElementById("work-modal-tags");
    const galleryViewport = document.getElementById("modal-gallery-viewport");
    const galleryTrack = document.getElementById("modal-gallery-track");
    const closeBtn = document.getElementById("work-modal-close");

    if (!section || !filterBar || !indicator || !grid) return;

    const projectList: ProjectItem[] = (window as any).__ADAPTIF_PROJECTS__ || [];
    const projectMap = new Map(projectList.map((p) => [p.id, p]));

    const buttons = Array.from(filterBar.querySelectorAll<HTMLButtonElement>(".filter-pill"));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".project-card"));

    function positionIndicator(target: HTMLElement, animate = true) {
      if (!indicator) return;
      if (!animate) indicator.style.transition = "none";
      indicator.style.width = `${target.offsetWidth}px`;
      indicator.style.height = `${target.offsetHeight}px`;
      indicator.style.transform = `translate3d(${target.offsetLeft}px, ${target.offsetTop}px, 0)`;
      indicator.style.opacity = "1";
      if (!animate) {
        void indicator.offsetWidth;
        indicator.style.transition = "";
      }
    }

    const initialActive = buttons.find((b) => b.classList.contains("is-active")) || buttons[0];
    if (initialActive) {
      requestAnimationFrame(() => positionIndicator(initialActive, false));
    }

    window.addEventListener("resize", () => {
      const current = buttons.find((b) => b.classList.contains("is-active"));
      if (current) positionIndicator(current, false);
    });

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter || "all";

        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-pressed", active ? "true" : "false");
        });

        positionIndicator(btn, true);

        let visibleOrder = 0;
        cards.forEach((card) => {
          const cats = (card.dataset.categories || "").split(",");
          const matches = filter === "all" || cats.includes(filter);
          card.classList.remove("is-entering");

          if (matches) {
            card.hidden = false;
            card.style.setProperty("--enter-delay", `${Math.min(visibleOrder, 8) * 35}ms`);
            void card.offsetWidth;
            card.classList.add("is-entering");
            visibleOrder++;
          } else {
            card.hidden = true;
          }
        });
      });
    });

    // --- Shareable Overlay Gallery ---
    let lastFocusedTrigger: HTMLElement | null = null;

    function createTile(src: string, alt: string, extraClass = "") {
      const div = document.createElement("div");
      div.className = `bento-tile ${extraClass}`.trim();
      const img = document.createElement("img");
      img.src = src;
      img.alt = alt;
      img.loading = "eager";
      img.decoding = "async";
      div.appendChild(img);
      return div;
    }

    function renderGalleryBento(project: ProjectItem) {
      if (!galleryTrack) return;
      galleryTrack.innerHTML = "";
      const source = project.gallery && project.gallery.length > 0 ? project.gallery : [project.image];
      const imgs = Array.from({ length: 12 }, (_, idx) => source[idx % source.length]);

      // Block 1: Large 2x2 square (0)
      const b1 = document.createElement("div");
      b1.className = "bento-block bento-block-square";
      b1.appendChild(createTile(imgs[0], `${project.title} — featured visual`));
      galleryTrack.appendChild(b1);

      // Block 2: Top wide (1) + Bottom 2 squares (2, 3)
      const b2 = document.createElement("div");
      b2.className = "bento-block bento-block-top-wide";
      b2.appendChild(createTile(imgs[1], `${project.title} — campaign view`, "tile-wide"));
      b2.appendChild(createTile(imgs[2], `${project.title} — detail 1`));
      b2.appendChild(createTile(imgs[3], `${project.title} — detail 2`));
      galleryTrack.appendChild(b2);

      // Block 3: Tall portrait (4)
      const b3 = document.createElement("div");
      b3.className = "bento-block bento-block-tall";
      b3.appendChild(createTile(imgs[4], `${project.title} — vertical asset`));
      galleryTrack.appendChild(b3);

      // Block 4: Top 2 squares (5, 6) + Bottom wide (7)
      const b4 = document.createElement("div");
      b4.className = "bento-block bento-block-bottom-wide";
      b4.appendChild(createTile(imgs[5], `${project.title} — detail 3`));
      b4.appendChild(createTile(imgs[6], `${project.title} — detail 4`));
      b4.appendChild(createTile(imgs[7], `${project.title} — wide showcase`, "tile-wide-bottom"));
      galleryTrack.appendChild(b4);

      // Block 5: Tall portrait (8)
      const b5 = document.createElement("div");
      b5.className = "bento-block bento-block-tall";
      b5.appendChild(createTile(imgs[8], `${project.title} — vertical highlight`));
      galleryTrack.appendChild(b5);

      // Block 6: Top wide (9) + Bottom 2 squares (10, 11)
      const b6 = document.createElement("div");
      b6.className = "bento-block bento-block-top-wide";
      b6.appendChild(createTile(imgs[9], `${project.title} — wide layout`, "tile-wide"));
      b6.appendChild(createTile(imgs[10], `${project.title} — detail 5`));
      b6.appendChild(createTile(imgs[11], `${project.title} — detail 6`));
      galleryTrack.appendChild(b6);
    }

    function openProjectModal(projectId: string, updateUrl = true) {
      const project = projectMap.get(projectId);
      if (!project || !modal || !modalTitle || !modalDesc || !modalTags) return;

      lastFocusedTrigger = document.activeElement as HTMLElement | null;

      modalTitle.textContent = project.title;
      modalDesc.textContent = project.description;
      modalTags.innerHTML = "";
      project.tags.forEach((tag) => {
        const li = document.createElement("li");
        li.className = "modal-tag";
        li.textContent = tag;
        modalTags.appendChild(li);
      });

      renderGalleryBento(project);

      modal.hidden = false;
      requestAnimationFrame(() => {
        modal.classList.add("is-open");
        if (galleryViewport) galleryViewport.scrollLeft = 0;
        closeBtn?.focus({ preventScroll: true });
      });

      document.documentElement.style.overflow = "hidden";

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set("project", project.id);
        window.history.pushState({ project: project.id }, "", url.toString());
      }
    }

    function closeProjectModal(updateUrl = true) {
      if (!modal || modal.hidden) return;
      modal.classList.remove("is-open");
      document.documentElement.style.overflow = "";

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.delete("project");
        window.history.pushState({}, "", url.pathname + url.search);
      }

      setTimeout(() => {
        if (!modal.classList.contains("is-open")) {
          modal.hidden = true;
          lastFocusedTrigger?.focus({ preventScroll: true });
        }
      }, 220);
    }

    grid.querySelectorAll<HTMLButtonElement>("[data-open-project]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const id = trigger.dataset.openProject;
        if (id) openProjectModal(id, true);
      });
    });

    modal?.querySelectorAll("[data-close-modal]").forEach((el) => {
      el.addEventListener("click", () => closeProjectModal(true));
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.hidden) {
        closeProjectModal(true);
      }
    });

    // Convert vertical wheel into horizontal scroll inside the desktop gallery strip
    galleryViewport?.addEventListener(
      "wheel",
      (e) => {
        if (window.innerWidth <= 768) return;
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          galleryViewport.scrollLeft += e.deltaY;
        }
      },
      { passive: false }
    );

    window.addEventListener("popstate", () => {
      const id = new URLSearchParams(window.location.search).get("project");
      if (id && projectMap.has(id)) {
        openProjectModal(id, false);
      } else {
        closeProjectModal(false);
      }
    });

    // Open project directly if URL contains ?project=<id> (shareable link)
    const initialProjectId = new URLSearchParams(window.location.search).get("project");
    if (initialProjectId && projectMap.has(initialProjectId)) {
      openProjectModal(initialProjectId, false);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWorkShowcase);
  } else {
    initWorkShowcase();
  }

  document.addEventListener("astro:page-load", initWorkShowcase);
</script>

<style>
  .work-showcase-section {
    position: relative;
    width: 100%;
    background-color: var(--color-void, #010307);
    padding: clamp(28px, 4vh, 48px) 0 clamp(80px, 10vh, 130px);
    overflow: hidden;
  }

  .showcase-ambient-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: min(1100px, 95vw);
    height: 420px;
    background: radial-gradient(
      ellipse at center,
      rgba(14, 165, 233, 0.1) 0%,
      rgba(56, 189, 248, 0.03) 45%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  .showcase-container {
    position: relative;
    z-index: 1;
    max-width: var(--container-max, 1280px);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3.5vw, 2.5rem);
  }

  .showcase-toolbar {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(28px, 4vh, 44px);
  }

  .filter-bar {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    padding: 6px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .filter-indicator {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 9px;
    background: linear-gradient(135deg, #7dd3fc 0%, #38bdf8 50%, #0ea5e9 100%);
    box-shadow: 0 4px 16px rgba(56, 189, 248, 0.3);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition:
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.36s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.36s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease;
  }

  .filter-pill {
    position: relative;
    z-index: 1;
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    color: #94a3b8;
    font-family: var(--font-sans, "Plus Jakarta Sans", sans-serif);
    font-size: 0.84rem;
    font-weight: 500;
    padding: 8px 15px;
    border-radius: 9px;
    cursor: pointer;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .filter-pill::after {
    content: attr(data-label);
    font-weight: 600;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    user-select: none;
    pointer-events: none;
  }

  .filter-pill:hover:not(.is-active) {
    color: #f8fafc;
    background: rgba(255, 255, 255, 0.045);
  }

  .filter-pill:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }

  .filter-pill.is-active,
  .filter-pill.is-active:hover {
    color: #04101d;
    font-weight: 600;
    background: transparent;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2vw, 24px);
  }

  .project-card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: #060a13;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition:
      transform 0.38s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      box-shadow 0.38s ease;
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card.is-entering {
    animation: cardRevealIn 0.42s cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0ms) both;
  }

  @keyframes cardRevealIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.975);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.38);
    box-shadow:
      0 20px 44px rgba(0, 0, 0, 0.55),
      0 0 28px rgba(56, 189, 248, 0.1);
  }

  .project-trigger {
    appearance: none;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    display: block;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .project-trigger:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: -2px;
  }

  .project-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #060a13;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .project-card:hover .project-img,
  .project-card:focus-within .project-img {
    transform: scale(1.06);
    filter: brightness(0.84);
  }

  .project-thumb-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(3, 6, 14, 0.92) 0%,
      rgba(3, 6, 14, 0.5) 36%,
      rgba(3, 6, 14, 0.06) 72%,
      transparent 100%
    );
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .project-card:hover .project-thumb-vignette,
  .project-card:focus-within .project-thumb-vignette {
    background: linear-gradient(
      to top,
      rgba(3, 6, 14, 0.96) 0%,
      rgba(3, 6, 14, 0.72) 52%,
      rgba(3, 6, 14, 0.2) 85%,
      rgba(3, 6, 14, 0.06) 100%
    );
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    z-index: 2;
  }

  .project-title {
    font-family: var(--font-sans, "Plus Jakarta Sans", sans-serif);
    font-size: clamp(1.08rem, 1.35vw, 1.25rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #f8fafc;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-tags-wrap {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(8px);
    transition:
      max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.28s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      margin-top 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 0;
  }

  .project-card:hover .project-tags-wrap,
  .project-card:focus-within .project-tags-wrap {
    max-height: 150px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 10px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(8, 14, 28, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #e2e8f0;
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  /* --- Shareable Project Gallery Overlay --- */
  .work-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  .work-modal[hidden] {
    display: none;
  }

  .work-modal.is-open {
    opacity: 1;
  }

  .work-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 5, 11, 0.94);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .work-modal-shell {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(18px, 3vh, 32px) clamp(16px, 3.5vw, 44px);
    gap: clamp(16px, 2.5vh, 26px);
    overflow-y: auto;
  }

  .work-modal-topbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
  }

  .work-modal-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .modal-action-btn,
  .modal-close-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    font-family: var(--font-sans, "Plus Jakarta Sans", sans-serif);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition:
