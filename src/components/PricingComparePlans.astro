---
import {
  PLAN_CONFIGS,
  COMPARISON_CATEGORIES,
  type FeatureAvailability,
} from "../data/pricingComparison";

const creativePlan = PLAN_CONFIGS[0];
const fullStackPlan = PLAN_CONFIGS[1];

const isDifferent = (a: FeatureAvailability, b: FeatureAvailability) => a !== b;
---

<section
  id="compare-plans"
  class="compare-section"
  aria-labelledby="compare-plans-heading"
>
  <div class="compare-glow" aria-hidden="true"></div>

  <div class="container compare-container">
    <!-- Section Header + Essential Differences Synthesis -->
    <header class="compare-header">
      <div class="compare-eyebrow">
        <span class="compare-eyebrow__dot" aria-hidden="true"></span>
        <span>PLAN COMPARISON</span>
      </div>
      <h2 id="compare-plans-heading" class="compare-title">
        Compare our <span class="title-highlight">plans</span>
      </h2>

      <!-- Essential Differences Synthesis -->
      <div class="compare-synthesis" role="region" aria-label="Key differences summary">
        {
          PLAN_CONFIGS.map((plan) => (
            <div class={`synthesis-item ${plan.id === "full-stack" ? "synthesis-item--highlight" : ""}`}>
              <span class="synthesis-item__label">{plan.name}</span>
              <p class="synthesis-item__copy">{plan.summaryLine}</p>
            </div>
          ))
        }
      </div>
    </header>

    <!-- Controls: Billing Cycle + Show Differences Only -->
    <div class="compare-controls">
      <div class="cmp-billing-toggle" role="tablist" aria-label="Billing cycle">
        <span class="cmp-billing-slider" aria-hidden="true"></span>
        <button
          type="button"
          class="cmp-billing-btn"
          role="tab"
          aria-selected="false"
          data-cmp-billing="monthly"
        >
          <span>Monthly</span>
        </button>
        <button
          type="button"
          class="cmp-billing-btn is-active"
          role="tab"
          aria-selected="true"
          data-cmp-billing="annual"
        >
          <span>Annual</span>
          <span class="cmp-save-pill">Save 20%</span>
        </button>
      </div>

      <button
        type="button"
        class="diff-toggle-btn"
        aria-pressed="false"
        data-diff-toggle
      >
        <span class="diff-toggle-indicator" aria-hidden="true"></span>
        <span>Show differences only</span>
      </button>
    </div>

    <!-- Sticky Desktop Plan Header Row (also serves as stacked Plan Cards on Mobile) -->
    <div class="plan-header-grid" role="region" aria-label="Plans overview">
      <div class="plan-header-spacer">
        <span class="plan-header-spacer__kicker">CAPABILITIES &amp; DELIVERABLES</span>
        <span class="plan-header-spacer__hint" data-filter-status>
          Showing all 10 categories
        </span>
      </div>

      {
        PLAN_CONFIGS.map((plan) => (
          <article
            class={`cmp-plan-card ${plan.id === "full-stack" ? "cmp-plan-card--featured" : ""}`}
            data-plan-card={plan.id}
          >
            {plan.badge && <div class="cmp-popular-badge">{plan.badge}</div>}
            <div class="cmp-plan-card__head">
              <h3 class="cmp-plan-name">{plan.name}</h3>
              <p class="cmp-plan-desc">{plan.description}</p>
            </div>

            <div class="cmp-plan-price-block">
              <div class="cmp-plan-price-row">
                <span
                  class="cmp-plan-amount"
                  data-annual={plan.pricing.annual.monthlyEquivalent}
                  data-monthly={plan.pricing.monthly.monthlyEquivalent}
                >
                  {plan.pricing.annual.monthlyEquivalent}
                </span>
                <span class="cmp-plan-unit">USD/mo</span>
                {plan.pricing.annual.saveBadge && (
                  <span class="cmp-plan-save-tag" data-cmp-save-badge>
                    {plan.pricing.annual.saveBadge}
                  </span>
                )}
              </div>
              <p
                class="cmp-plan-billing-note"
                data-annual-note={plan.pricing.annual.billingNote}
                data-monthly-note={plan.pricing.monthly.billingNote}
              >
                {plan.pricing.annual.billingNote}
              </p>
            </div>

            <a
              href={plan.ctaHref}
              class={`adaptif-btn cmp-plan-cta ${plan.id === "creative" ? "adaptif-btn--dark" : ""}`}
            >
              <span>{plan.ctaLabel}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </article>
        ))
      }
    </div>

    <!-- Collapsible Categories Matrix -->
    <div class="categories-stack" data-categories-stack>
      {
        COMPARISON_CATEGORIES.map((category) => {
          const hasDifferences = category.features.some((f) =>
            isDifferent(f.creative, f.fullStack)
          );
          const panelId = `cat-panel-${category.id}`;
          return (
            <section
              class="cmp-category"
              data-category={category.id}
              data-has-diff={hasDifferences ? "true" : "false"}
              data-default-open={category.defaultOpen ? "true" : "false"}
            >
              <h4 class="cmp-category__heading">
                <button
                  type="button"
                  class="cmp-category__trigger"
                  aria-expanded={category.defaultOpen ? "true" : "false"}
                  aria-controls={panelId}
                  data-category-trigger
                >
                  <span class="cmp-category__title-group">
                    <span class="cmp-category__title">{category.title}</span>
                    {category.fullStackOnly ? (
                      <span class="cmp-cat-badge cmp-cat-badge--cyan">Full Stack only</span>
                    ) : (
                      <span class="cmp-cat-badge">{category.features.length} items</span>
                    )}
                  </span>
                  <svg
                    class="cmp-category__chevron"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </button>
              </h4>

              <div
                id={panelId}
                class={`cmp-category__panel ${category.defaultOpen ? "is-open" : ""}`}
                hidden={!category.defaultOpen}
              >
                <ul class="cmp-rows" role="list">
                  {category.features.map((feat) => {
                    const diff = isDifferent(feat.creative, feat.fullStack);
                    return (
                      <li
                        class={`cmp-row ${diff ? "cmp-row--diff" : ""}`}
                        data-diff-row={diff ? "true" : "false"}
                      >
                        <div class="cmp-row__feature">
                          <span class="cmp-row__name">{feat.name}</span>
                          {feat.note && <span class="cmp-row__note">{feat.note}</span>}
                        </div>

                        {/* Creative Cell */}
                        <div class="cmp-row__cell cmp-row__cell--creative">
                          <span class="cmp-mobile-plan-label">{creativePlan.name}</span>
                          {typeof feat.creative === "string" ? (
                            <span class="cmp-value-text">{feat.creative}</span>
                          ) : feat.creative ? (
                            <span class="cmp-status cmp-status--yes">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12" />
                              </svg>
                              <span class="cmp-status__label">Included</span>
                            </span>
                          ) : (
                            <span class="cmp-status cmp-status--no">
                              <span class="cmp-dash" aria-hidden="true">—</span>
                              <span class="cmp-status__label">Not included</span>
                            </span>
                          )}
                        </div>

                        {/* Full Stack Cell */}
                        <div class="cmp-row__cell cmp-row__cell--fullstack">
                          <span class="cmp-mobile-plan-label">{fullStackPlan.name}</span>
                          {typeof feat.fullStack === "string" ? (
                            <span class="cmp-value-text cmp-value-text--cyan">
                              {feat.fullStack}
                            </span>
                          ) : feat.fullStack ? (
                            <span class="cmp-status cmp-status--yes cmp-status--cyan">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12" />
                              </svg>
                              <span class="cmp-status__label">Included</span>
                            </span>
                          ) : (
                            <span class="cmp-status cmp-status--no">
                              <span class="cmp-dash" aria-hidden="true">—</span>
                              <span class="cmp-status__label">Not included</span>
                            </span>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>

                {category.footnote && (
                  <p class="cmp-category__footnote">{category.footnote}</p>
                )}
              </div>
            </section>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .compare-section {
    position: relative;
    padding: 5.5rem 0 7rem;
    background: var(--color-void);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .compare-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 720px;
    height: 360px;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 0%,
      rgba(72, 200, 255, 0.12) 0%,
      rgba(1, 3, 7, 0) 72%
    );
    z-index: 0;
  }

  .compare-container {
    position: relative;
    z-index: 1;
  }

  /* Header & Synthesis */
  .compare-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 2.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.15rem;
  }

  .compare-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-brand-cyan);
  }

  .compare-eyebrow__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-cyan);
    box-shadow: 0 0 10px var(--color-brand-cyan);
  }

  .compare-title {
    font-family: var(--font-family-display);
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-white);
    margin: 0;
  }

  .compare-synthesis {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 0.5rem;
    text-align: left;
  }

  .synthesis-item {
    padding: 1rem 1.25rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .synthesis-item--highlight {
    background: linear-gradient(135deg, rgba(72, 200, 255, 0.07) 0%, rgba(255, 255, 255, 0.025) 100%);
    border-color: rgba(72, 200, 255, 0.24);
  }

  .synthesis-item__label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-white);
  }

  .synthesis-item--highlight .synthesis-item__label {
    color: var(--color-brand-cyan);
  }

  .synthesis-item__copy {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Controls Bar */
  .compare-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .cmp-billing-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: rgba(8, 15, 28, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cmp-billing-slider {
    position: absolute;
    top: 4px;
    left: 4px;
    height: calc(100% - 8px);
    width: var(--cmp-slider-w, 138px);
    transform: translateX(var(--cmp-slider-x, 96px));
    border-radius: var(--radius-pill);
    background: linear-gradient(180deg, rgba(135, 224, 255, 0.96) 0%, rgba(72, 200, 255, 0.92) 100%);
    box-shadow: 0 2px 14px rgba(72, 200, 255, 0.35);
    transition: transform 0.32s var(--ease-spring), width 0.32s var(--ease-spring);
    pointer-events: none;
  }

  .cmp-billing-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-family-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--radius-pill);
    transition: color 0.2s ease;
  }

  .cmp-billing-btn.is-active {
    color: #031528;
  }

  .cmp-billing-btn:focus-visible,
  .diff-toggle-btn:focus-visible,
  .cmp-category__trigger:focus-visible,
  .cmp-plan-cta:focus-visible {
    outline: 2px solid var(--color-brand-cyan);
    outline-offset: 2px;
  }

  .cmp-save-pill {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.16rem 0.45rem;
    border-radius: var(--radius-pill);
    background: rgba(3, 21, 40, 0.14);
    color: inherit;
  }

  .diff-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.58rem 1.05rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--color-text-white);
    font-family: var(--font-family-body);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .diff-toggle-btn:hover {
    border-color: rgba(72, 200, 255, 0.45);
    background: rgba(72, 200, 255, 0.08);
  }

  .diff-toggle-btn[aria-pressed="true"] {
    border-color: rgba(72, 200, 255, 0.65);
    background: rgba(72, 200, 255, 0.14);
    color: var(--color-brand-cyan);
  }

  .diff-toggle-indicator {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .diff-toggle-btn[aria-pressed="true"] .diff-toggle-indicator {
    background: var(--color-brand-cyan);
    border-color: var(--color-brand-cyan);
  }

  .diff-toggle-btn[aria-pressed="true"] .diff-toggle-indicator::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 1.5px;
    background: #031528;
  }

  /* Sticky Plan Header Grid */
  .plan-header-grid {
    position: sticky;
    top: 5.25rem;
    z-index: 20;
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr;
    gap: 1rem;
    padding: 1rem;
    border-radius: 22px;
    background: rgba(5, 11, 22, 0.94);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
    margin-bottom: 1.25rem;
  }

  .plan-header-spacer {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0.75rem;
    gap: 0.35rem;
  }

  .plan-header-spacer__kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-brand-cyan);
  }

  .plan-header-spacer__hint {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .cmp-plan-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .cmp-plan-card--featured {
    background: linear-gradient(160deg, rgba(72, 200, 255, 0.11) 0%, rgba(12, 24, 44, 0.85) 100%);
    border-color: rgba(72, 200, 255, 0.42);
  }

  .cmp-popular-badge {
    position: absolute;
    top: -11px;
    right: 16px;
    padding: 0.22rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-cyan);
    color: #031528;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 4px 16px rgba(72, 200, 255, 0.4);
  }

  .cmp-plan-card__head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cmp-plan-name {
    font-family: var(--font-family-display);
    font-size: 1.65rem;
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-text-white);
    margin: 0;
  }

  .cmp-plan-desc {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .cmp-plan-price-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cmp-plan-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .cmp-plan-amount {
    font-family: var(--font-family-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-text-white);
    font-variant-numeric: tabular-nums;
  }

  .cmp-plan-unit {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
  }

  .cmp-plan-save-tag {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.16rem 0.5rem;
    border-radius: var(--radius-pill);
    background: rgba(72, 200, 255, 0.16);
    border: 1px solid rgba(72, 200, 255, 0.35);
    color: var(--color-brand-cyan);
  }

  .cmp-plan-billing-note {
    font-size: 0.74rem;
    color: rgba(148, 163, 184, 0.85);
    margin: 0;
  }

  .cmp-plan-cta {
    width: 100%;
    justify-content: center;
    padding: 0.72rem 1.1rem;
    font-size: 0.88rem;
  }

  /* Categories Stack */
  .categories-stack {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .cmp-category {
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .cmp-category.is-hidden-by-filter {
    display: none;
  }

  .cmp-category__heading {
    margin: 0;
  }

  .cmp-category__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    background: rgba(255, 255, 255, 0.025);
    border: none;
    color: var(--color-text-white);
    font-family: var(--font-family-body);
    cursor: pointer;
    text-align: left;
    transition: background 0.2s ease;
  }

  .cmp-category__trigger:hover {
    background: rgba(72, 200, 255, 0.05);
  }

  .cmp-category__title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cmp-category__title {
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .cmp-cat-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-secondary);
  }

  .cmp-cat-badge--cyan {
    background: rgba(72, 200, 255, 0.14);
    border: 1px solid rgba(72, 200, 255, 0.3);
    color: var(--color-brand-cyan);
  }

  .cmp-category__chevron {
    flex-shrink: 0;
    color: var(--color-text-secondary);
    transition: transform 0.25s var(--ease-spring);
  }

  .cmp-category__trigger[aria-expanded="true"] .cmp-category__chevron {
    transform: rotate(180deg);
    color: var(--color-brand-cyan);
  }

  .cmp-category__panel {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .cmp-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cmp-row {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.95rem 1.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: background 0.18s ease;
  }

  .cmp-row:last-child {
    border-bottom: none;
  }

  .cmp-row:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .cmp-row.is-hidden-by-filter {
    display: none;
  }

  .cmp-row__feature {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-right: 0.75rem;
  }

  .cmp-row__name {
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--color-text-white);
  }

  .cmp-row__note {
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  .cmp-row__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cmp-mobile-plan-label {
    display: none;
  }

  .cmp-value-text {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-white);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
  }

  .cmp-value-text--cyan {
    color: var(--color-brand-cyan);
    background: rgba(72, 200, 255, 0.12);
    border: 1px solid rgba(72, 200, 255, 0.28);
  }

  .cmp-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.84rem;
    font-weight: 500;
  }

  .cmp-status--yes {
    color: #e2e8f0;
  }

  .cmp-status--yes svg {
    color: var(--color-brand-cyan);
  }

  .cmp-status--cyan {
    color: var(--color-text-white);
  }

  .cmp-status--no {
    color: rgba(148, 163, 184, 0.58);
  }

  .cmp-dash {
    font-weight: 600;
  }

  .cmp-status__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cmp-category__footnote {
    margin: 0;
    padding: 0.85rem 1.4rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    background: rgba(72, 200, 255, 0.03);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Responsive Mobile Adaptation (no horizontal scroll) */
  @media (max-width: 920px) {
    .compare-section {
      padding: 4rem 0 5rem;
    }

    .compare-synthesis {
      grid-template-columns: 1fr;
    }

    .plan-header-grid {
      position: static;
      grid-template-columns: 1fr;
      padding: 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: none;
      box-shadow: none;
    }

    .plan-header-spacer {
      display: none;
    }

    .cmp-popular-badge {
      top: 12px;
      right: 12px;
    }

    .cmp-row {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      padding: 1rem 1.15rem;
    }

    .cmp-row__feature {
      grid-column: 1 / -1;
      padding-right: 0;
    }

    .cmp-row__cell {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      text-align: left;
      gap: 0.35rem;
      padding: 0.65rem 0.75rem;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .cmp-row__cell--fullstack {
      border-color: rgba(72, 200, 255, 0.18);
    }

    .cmp-mobile-plan-label {
      display: block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-secondary);
    }

    .cmp-row__cell--fullstack .cmp-mobile-plan-label {
      color: var(--color-brand-cyan);
    }

    .cmp-status__label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      font-size: 0.82rem;
    }

    .cmp-dash {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmp-billing-slider,
    .cmp-category__chevron,
    .cmp-row,
    .diff-toggle-btn {
      transition: none !important;
    }
  }
</style>

<script>
  const section = document.getElementById("compare-plans");

  if (section) {
    // 1. Billing Cycle Toggle
    const billingBar = section.querySelector<HTMLElement>(".cmp-billing-toggle");
    const billingBtns = section.querySelectorAll<HTMLButtonElement>("[data-cmp-billing]");
    const amounts = section.querySelectorAll<HTMLElement>(".cmp-plan-amount");
    const notes = section.querySelectorAll<HTMLElement>(".cmp-plan-billing-note");
    const saveBadges = section.querySelectorAll<HTMLElement>("[data-cmp-save-badge]");

    const positionSlider = (activeBtn: HTMLButtonElement) => {
      if (!billingBar) return;
      const barRect = billingBar.getBoundingClientRect();
      const btnRect = activeBtn.getBoundingClientRect();
      billingBar.style.setProperty("--cmp-slider-w", `${btnRect.width}px`);
      billingBar.style.setProperty("--cmp-slider-x", `${btnRect.left - barRect.left - 4}px`);
    };

    const setBilling = (cycle: "annual" | "monthly") => {
      billingBtns.forEach((btn) => {
        const isActive = btn.dataset.cmpBilling === cycle;
        btn.classList.toggle("is-active", isActive);
        btn.setAttribute("aria-selected", String(isActive));
        if (isActive) positionSlider(btn);
      });

      amounts.forEach((el) => {
        const nextVal = el.dataset[cycle];
        if (nextVal) el.textContent = nextVal;
      });

      notes.forEach((el) => {
        const nextNote = cycle === "annual" ? el.dataset.annualNote : el.dataset.monthlyNote;
        if (nextNote) el.textContent = nextNote;
      });

      saveBadges.forEach((el) => {
        el.hidden = cycle !== "annual";
      });
    };

    const initialActive = section.querySelector<HTMLButtonElement>("[data-cmp-billing].is-active");
    if (initialActive) {
      requestAnimationFrame(() => positionSlider(initialActive));
      window.addEventListener("resize", () => {
        const current = section.querySelector<HTMLButtonElement>("[data-cmp-billing].is-active");
        if (current) positionSlider(current);
      });
    }

    billingBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cycle = btn.dataset.cmpBilling === "monthly" ? "monthly" : "annual";
        setBilling(cycle);
      });
    });

    // 2. Category Accordions
    const categories = section.querySelectorAll<HTMLElement>("[data-category]");

    const setCategoryOpen = (cat: HTMLElement, open: boolean) => {
      const trigger = cat.querySelector<HTMLButtonElement>("[data-category-trigger]");
      const panelId = trigger?.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!trigger || !panel) return;
      trigger.setAttribute("aria-expanded", String(open));
      panel.hidden = !open;
      panel.classList.toggle("is-open", open);
    };

    categories.forEach((cat) => {
      const trigger = cat.querySelector<HTMLButtonElement>("[data-category-trigger]");
      trigger?.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        setCategoryOpen(cat, !isOpen);
      });
    });

    // 3. "Show differences only" Filter
    const diffToggle = section.querySelector<HTMLButtonElement>("[data-diff-toggle]");
    const filterStatus = section.querySelector<HTMLElement>("[data-filter-status]");

    diffToggle?.addEventListener("click", () => {
      const nextPressed = diffToggle.getAttribute("aria-pressed") !== "true";
      diffToggle.setAttribute("aria-pressed", String(nextPressed));

      let visibleCategoryCount = 0;

      categories.forEach((cat) => {
        const hasDiff = cat.dataset.hasDiff === "true";
        const rows = cat.querySelectorAll<HTMLElement>("[data-diff-row]");

        if (nextPressed) {
          cat.classList.toggle("is-hidden-by-filter", !hasDiff);
          rows.forEach((row) => {
            row.classList.toggle("is-hidden-by-filter", row.dataset.diffRow !== "true");
          });
          if (hasDiff) {
            visibleCategoryCount++;
            setCategoryOpen(cat, true);
          }
        } else {
          cat.classList.remove("is-hidden-by-filter");
          rows.forEach((row) => row.classList.remove("is-hidden-by-filter"));
          visibleCategoryCount++;
          setCategoryOpen(cat, cat.dataset.defaultOpen === "true");
        }
      });

      if (filterStatus) {
        filterStatus.textContent = nextPressed
          ? `Showing differences across ${visibleCategoryCount} categories`
          : `Showing all ${categories.length} categories`;
      }
    });
  }
</script>
