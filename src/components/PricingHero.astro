---
// PricingHero.astro - Adaptif Luminous Obsidian Glass Pricing Hero
import UnderwaterLightRays from "./UnderwaterLightRays.astro";

interface PlanFeature {
  id: string;
  label: string;
  detail: string;
  icon:
    | "ticket"
    | "chat"
    | "branding"
    | "digital"
    | "uiux"
    | "print"
    | "headset"
    | "code"
    | "megaphone"
    | "wrench"
    | "ai";
}

const creativeFeatures: PlanFeature[] = [
  {
    id: "creative-ticket",
    label: "1 Ticket at a Time",
    detail:
      "Queue unlimited requests; we execute one active deliverable at a time with 1–2 day turnarounds.",
    icon: "ticket",
  },
  {
    id: "creative-chat",
    label: "Real-Time Chat",
    detail:
      "Direct Slack or workspace channel with your creative lead for rapid feedback and daily momentum.",
    icon: "chat",
  },
  {
    id: "creative-branding",
    label: "Branding",
    detail:
      "Visual identities, logos, typography systems, brand guidelines, and cohesive art direction.",
    icon: "branding",
  },
  {
    id: "creative-digital",
    label: "Digital Media",
    detail:
      "Social content, paid ad creatives, pitch decks, motion graphics, and campaign assets.",
    icon: "digital",
  },
  {
    id: "creative-uiux",
    label: "UIUX",
    detail:
      "High-converting landing pages, web apps, mobile interfaces, wireframes, and Figma systems.",
    icon: "uiux",
  },
  {
    id: "creative-print",
    label: "Print Media",
    detail:
      "Packaging, merchandise, editorial layouts, brochures, and print-ready production files.",
    icon: "print",
  },
];

const fullStackFeatures: PlanFeature[] = [
  {
    id: "fs-ticket",
    label: "2 Tickets at a Time",
    detail:
      "Double your active throughput with two parallel workstreams moving forward every business day.",
    icon: "ticket",
  },
  {
    id: "fs-strategy",
    label: "Weekly Strategy Call",
    detail:
      "Dedicated weekly sync with your creative director to align on roadmap, campaigns, and growth.",
    icon: "headset",
  },
  {
    id: "fs-dev",
    label: "Development",
    detail:
      "Production web development, custom frontends, interactive animations, and CMS integrations.",
    icon: "code",
  },
  {
    id: "fs-marketing",
    label: "Marketing",
    detail:
      "Campaign strategy, conversion copywriting, multi-channel ad creative, and launch execution.",
    icon: "megaphone",
  },
  {
    id: "fs-maintenance",
    label: "Maintenance",
    detail:
      "Ongoing site updates, performance optimization, QA, and continuous design system upkeep.",
    icon: "wrench",
  },
  {
    id: "fs-ai",
    label: "AI",
    detail:
      "Custom AI visuals, generative asset pipelines, and AI-accelerated workflows directed by senior leads.",
    icon: "ai",
  },
];
---

<section class="pricing-hero" id="pricing-hero">
  <!-- Volumetric Underwater Light Rays Atmosphere -->
  <div class="pricing-bg" aria-hidden="true">
    <div class="pricing-rays-layer">
      <UnderwaterLightRays />
    </div>
    <div class="pricing-bottom-fade"></div>
  </div>

  <div class="container pricing-container">
    <div class="pricing-grid">
      <!-- Left Column: Introduction -->
      <div class="pricing-intro">
        <div class="pricing-eyebrow-pill">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          <span>FLEXIBLE PLANS</span>
        </div>

        <h1 class="pricing-title">
          Your full-time creative team,
          <span class="title-highlight pricing-title-italic">for one hire.</span>
        </h1>

        <p class="pricing-copy">
          From brand identity and social content to web, AI visuals, and copywriting, one Adaptif subscription gives you a dedicated creative team that delivers work in 1–2 days, every day.
        </p>

        <div class="pricing-intro-actions">
          <a href="#contact" class="adaptif-btn pricing-book-btn">
            <span>Book a call</span>
            <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Billing Selector + Plan Cards -->
      <div class="pricing-plans-col">
        <!-- Billing Frequency Selector -->
        <div class="billing-bar">
          <div class="billing-toggle" role="tablist" aria-label="Billing frequency">
            <span class="billing-slider" aria-hidden="true"></span>
            <button
              type="button"
              class="billing-btn"
              role="tab"
              aria-selected="false"
              data-billing="monthly"
            >
              <span>MONTHLY</span>
            </button>
            <button
              type="button"
              class="billing-btn is-active"
              role="tab"
              aria-selected="true"
              data-billing="annual"
            >
              <span>ANNUAL</span>
              <span class="billing-save-pill">SAVE 20%</span>
            </button>
          </div>
        </div>

        <!-- Two-Card Comparison Grid -->
        <div class="plans-grid">
          <!-- Plan 1: Creative -->
          <article class="plan-card plan-card--creative">
            <header class="plan-head">
              <div class="plan-emblem" aria-hidden="true">
                <svg width="34" height="34" viewBox="0 0 36 36" fill="none">
                  <path
                    d="M18 4.5L31.5 29.5H4.5L18 4.5Z"
                    stroke="currentColor"
                    stroke-width="1.35"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M18 4.5V29.5M11.2 17H24.8M7.8 23.2H28.2"
                    stroke="currentColor"
                    stroke-width="1.15"
                    stroke-opacity="0.78"
                  />
                </svg>
              </div>
              <div class="plan-title-group">
                <h2 class="plan-name">Creative</h2>
                <p class="plan-subtitle">For brands that need consistent creative output.</p>
              </div>
            </header>

            <div class="plan-pricing">
              <div class="plan-amount-box">
                <span class="plan-amount-sizer" aria-hidden="true">$8.888</span>
                <span
                  class="plan-amount"
                  data-annual="$1.750"
                  data-monthly="$2.190"
                >$1.750</span>
              </div>
              <div class="plan-pricing-meta">
                <div class="plan-unit-line">
                  <span class="plan-unit">USD/Month</span>
                  <span class="plan-save-badge" data-save-badge>SAVE 20%</span>
                </div>
                <span class="plan-pause">Pause anytime</span>
              </div>
            </div>

            <div class="plan-divider-label">
              <span>What's included</span>
            </div>

            <ul class="plan-feature-list" role="list">
              {creativeFeatures.map((feat) => (
                <li class="plan-feature-item">
                  <button
                    type="button"
                    class="feature-row-btn"
                    aria-expanded="false"
                    aria-controls={feat.id}
                  >
                    <span class="feature-row-left">
                      <span class="feature-row-icon" aria-hidden="true">
                        {feat.icon === "ticket" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
                            <path d="M13 5v2M13 17v2M13 11v2" />
                          </svg>
                        )}
                        {feat.icon === "chat" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                          </svg>
                        )}
                        {feat.icon === "branding" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z" />
                          </svg>
                        )}
                        {feat.icon === "digital" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" />
                            <path d="M8 21h8M12 17v4" />
                          </svg>
                        )}
                        {feat.icon === "uiux" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="18" x="3" y="3" rx="2" />
                            <path d="M3 9h18M9 21V9" />
                          </svg>
                        )}
                        {feat.icon === "print" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                            <path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6" />
                            <rect x="6" y="14" width="12" height="8" rx="1" />
                          </svg>
                        )}
                      </span>
                      <span class="feature-row-label">{feat.label}</span>
                    </span>
                    <svg class="feature-row-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </button>
                  <div class="feature-row-detail" id={feat.id} aria-hidden="true">
                    <div class="feature-row-detail-inner">
                      <p>{feat.detail}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>

            <a href="#contact" class="adaptif-btn adaptif-btn--dark plan-cta plan-cta--creative">
              <span>Start with Creative →</span>
            </a>
          </article>

          <!-- Plan 2: Full Stack (Most Popular) -->
          <article class="plan-card plan-card--featured">
            <div class="popular-pill">
              <span>✦ MOST POPULAR ✦</span>
            </div>

            <header class="plan-head">
              <div class="plan-emblem plan-emblem--cyan" aria-hidden="true">
                <svg width="34" height="34" viewBox="0 0 36 36" fill="none">
                  <rect x="7" y="7" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.35" />
                  <rect x="22" y="7" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.35" />
                  <rect x="7" y="22" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.35" />
                  <rect x="22" y="22" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.35" />
                  <path d="M14 10.5H22M14 25.5H22M10.5 14V22M25.5 14V22" stroke="currentColor" stroke-width="1.25" />
                  <circle cx="18" cy="18" r="2.2" stroke="currentColor" stroke-width="1.35" />
                </svg>
              </div>
              <div class="plan-title-group">
                <h2 class="plan-name">Full Stack</h2>
                <p class="plan-subtitle">For teams that can't afford creative bottlenecks.</p>
              </div>
            </header>

            <div class="plan-pricing">
              <div class="plan-amount-box">
                <span class="plan-amount-sizer" aria-hidden="true">$8.888</span>
                <span
                  class="plan-amount"
                  data-annual="$3.750"
                  data-monthly="$4.690"
                >$3.750</span>
              </div>
              <div class="plan-pricing-meta">
                <div class="plan-unit-line">
                  <span class="plan-unit">USD/Month</span>
                  <span class="plan-save-badge" data-save-badge>SAVE 20%</span>
                </div>
                <span class="plan-pause">Pause anytime</span>
              </div>
            </div>

            <div class="plan-divider-label plan-divider-label--plus">
              <span>All in Creative Plan</span>
              <span class="plus-glyph" aria-hidden="true">+</span>
            </div>

            <ul class="plan-feature-list" role="list">
              {fullStackFeatures.map((feat) => (
                <li class="plan-feature-item">
                  <button
                    type="button"
                    class="feature-row-btn"
                    aria-expanded="false"
                    aria-controls={feat.id}
                  >
                    <span class="feature-row-left">
                      <span class="feature-row-icon" aria-hidden="true">
                        {feat.icon === "ticket" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
                            <path d="M13 5v2M13 17v2M13 11v2" />
                          </svg>
                        )}
                        {feat.icon === "headset" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" />
                          </svg>
                        )}
                        {feat.icon === "code" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 18 22 12 16 6" />
                            <polyline points="8 6 2 12 8 18" />
                            <line x1="14" y1="4" x2="10" y2="20" />
                          </svg>
                        )}
                        {feat.icon === "megaphone" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m3 11 18-5v12L3 14v-3z" />
                            <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
                          </svg>
                        )}
                        {feat.icon === "wrench" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                          </svg>
                        )}
                        {feat.icon === "ai" && (
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" />
                            <circle cx="12" cy="12" r="2.5" />
                          </svg>
                        )}
                      </span>
                      <span class="feature-row-label">{feat.label}</span>
                    </span>
                    <svg class="feature-row-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9" />
                    </svg>
                  </button>
                  <div class="feature-row-detail" id={feat.id} aria-hidden="true">
                    <div class="feature-row-detail-inner">
                      <p>{feat.detail}</p>
                    </div>
                  </div>
                </li>
              ))}
            </ul>

            <a href="#contact" class="adaptif-btn plan-cta">
              <span>Get Full Stack →</span>
            </a>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupPricingHero() {
    const root = document.getElementById("pricing-hero");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const toggle = root.querySelector<HTMLElement>(".billing-toggle");
    const slider = root.querySelector<HTMLElement>(".billing-slider");
    const billingButtons = root.querySelectorAll<HTMLButtonElement>(".billing-btn");
    const priceElements = root.querySelectorAll<HTMLElement>(".plan-amount");
    const saveBadges = root.querySelectorAll<HTMLElement>("[data-save-badge]");

    const positionSlider = (activeBtn: HTMLButtonElement | null, animate = true) => {
      if (!toggle || !slider || !activeBtn) return;
      if (!animate) {
        slider.style.transition = "none";
      }
      const x = activeBtn.offsetLeft;
      const w = activeBtn.offsetWidth;
      slider.style.width = `${w}px`;
      slider.style.transform = `translateX(${x - 4}px)`;
      if (!animate) {
        slider.getBoundingClientRect();
        slider.style.transition = "";
      }
    };

    const initialActive = root.querySelector<HTMLButtonElement>(".billing-btn.is-active");
    positionSlider(initialActive, false);
    window.addEventListener("resize", () => {
      const current = root.querySelector<HTMLButtonElement>(".billing-btn.is-active");
      positionSlider(current, false);
    });

    const parsePrice = (raw: string | undefined) =>
      Number((raw || "0").replace(/[^0-9]/g, "")) || 0;

    const formatPrice = (value: number) =>
      "$" + Math.round(value).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");

    const activeCountAnimations = new WeakMap<HTMLElement, number>();

    const animatePrice = (el: HTMLElement, from: number, to: number, duration = 900, delay = 0) => {
      const prevRaf = activeCountAnimations.get(el);
      if (prevRaf) cancelAnimationFrame(prevRaf);

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        el.textContent = formatPrice(to);
        return;
      }

      el.textContent = formatPrice(from);
      const startAt = performance.now() + delay;

      const step = (now: number) => {
        if (now < startAt) {
          activeCountAnimations.set(el, requestAnimationFrame(step));
          return;
        }
        const progress = Math.min((now - startAt) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = from + (to - from) * eased;
        el.textContent = formatPrice(current);

        if (progress < 1) {
          activeCountAnimations.set(el, requestAnimationFrame(step));
        } else {
          el.textContent = formatPrice(to);
          activeCountAnimations.delete(el);
        }
      };

      activeCountAnimations.set(el, requestAnimationFrame(step));
    };

    // Initial count-up from $0 to target amount on page load
    priceElements.forEach((el, idx) => {
      const target = parsePrice(el.dataset.annual || el.textContent || "0");
      animatePrice(el, 0, target, 950, 260 + idx * 100);
    });

    billingButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.billing === "monthly" ? "monthly" : "annual";

        billingButtons.forEach((other) => {
          const isActive = other === btn;
          other.classList.toggle("is-active", isActive);
          other.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        positionSlider(btn, true);

        priceElements.forEach((el) => {
          const nextValue = mode === "monthly" ? el.dataset.monthly : el.dataset.annual;
          if (nextValue) {
            const currentNum = parsePrice(el.textContent || "0");
            const targetNum = parsePrice(nextValue);
            if (currentNum !== targetNum) {
              animatePrice(el, currentNum, targetNum, 420, 0);
            }
          }
        });

        saveBadges.forEach((badge) => {
          badge.style.opacity = mode === "annual" ? "1" : "0";
          badge.style.transform = mode === "annual" ? "scale(1)" : "scale(0.9)";
          badge.style.pointerEvents = mode === "annual" ? "auto" : "none";
        });
      });
    });

    const featureButtons = root.querySelectorAll<HTMLButtonElement>(".feature-row-btn");
    featureButtons.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const item = trigger.closest(".plan-feature-item");
        const detail = item?.querySelector<HTMLElement>(".feature-row-detail");
        if (!item || !detail) return;

        const isOpen = trigger.getAttribute("aria-expanded") === "true";

        // Close any other open dropdown before opening the clicked one
        if (!isOpen) {
          root.querySelectorAll<HTMLElement>(".plan-feature-item.is-open").forEach((openItem) => {
            if (openItem === item) return;
            openItem.classList.remove("is-open");
            openItem.querySelector<HTMLButtonElement>(".feature-row-btn")?.setAttribute("aria-expanded", "false");
            openItem.querySelector<HTMLElement>(".feature-row-detail")?.setAttribute("aria-hidden", "true");
          });
        }

        trigger.setAttribute("aria-expanded", isOpen ? "false" : "true");
        item.classList.toggle("is-open", !isOpen);
        detail.setAttribute("aria-hidden", isOpen ? "true" : "false");
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPricingHero);
  } else {
    setupPricingHero();
  }
  document.addEventListener("astro:page-load", setupPricingHero);
</script>

<style>
  .pricing-hero {
    position: relative;
    min-height: 100dvh;
    padding-top: calc(var(--header-height) + clamp(52px, 8vh, 96px));
    padding-bottom: clamp(72px, 10vh, 128px);
    display: flex;
    align-items: center;
    background-color: var(--color-void);
    overflow: hidden;
  }

  /* ========================================================================
     Atmospheric WebGL & Volumetric Background
     ======================================================================== */
  .pricing-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .pricing-rays-layer {
    position: absolute;
    inset: 0;
  }

  .pricing-bottom-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: linear-gradient(to top, var(--color-void) 0%, transparent 100%);
  }

  .pricing-container {
    position: relative;
    z-index: 2;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.22fr);
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }

  /* ========================================================================
     Left Column: Intro Copy
     ======================================================================== */
  .pricing-intro {
    max-width: 470px;
  }

  .pricing-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: rgba(8, 18, 44, 0.65);
    border: 1px solid rgba(72, 200, 255, 0.28);
    backdrop-filter: var(--glass-blur-sm);
    -webkit-backdrop-filter: var(--glass-blur-sm);
    font-family: var(--font-family-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
