---
const inputs = [
  {
    label: "Your brief",
    detail: "Project scope & creative direction",
    icon: "brief",
  },
  {
    label: "Your goals",
    detail: "Business outcomes & timelines",
    icon: "goals",
  },
  {
    label: "Your brand",
    detail: "Identity, voice & guidelines",
    icon: "brand",
  },
];

const outputs = [
  {
    label: "Websites",
    detail: "Webflow builds & landing pages",
    icon: "websites",
  },
  {
    label: "Brand identities",
    detail: "Systems, logos & guidelines",
    icon: "identities",
  },
  {
    label: "Marketing assets",
    detail: "Campaigns, ads & social creatives",
    icon: "marketing",
  },
  {
    label: "Videos & animations",
    detail: "Motion design & AI production",
    icon: "video",
  },
];

const benefits = [
  {
    title: "Access to all creative services",
    subtitle: "Submit your requests through tickets",
    icon: "services",
    featured: true,
  },
  {
    title: "Delivery starting from 24 hours",
    subtitle: "Turnaround depends on the scope and complexity of each request",
    icon: "clock",
    featured: true,
  },
  {
    title: "Dedicated manager & direct support",
    icon: "support",
  },
  {
    title: "Global service across time zones",
    icon: "globe",
  },
  {
    title: "AI-enhanced creative workflows",
    icon: "ai",
  },
  {
    title: "Unlimited brand management",
    icon: "layers",
  },
  {
    title: "Unlimited revisions",
    icon: "refresh",
  },
  {
    title: "All your tickets in one place",
    icon: "tickets",
  },
];
---

<section
  id="pricing-value-engine"
  class="value-engine"
  aria-labelledby="value-engine-heading"
>
  <div class="ambient-glow ambient-glow--top" aria-hidden="true"></div>
  <div class="ambient-glow ambient-glow--bottom" aria-hidden="true"></div>

  <div class="container value-engine__container">
    <!-- Section Header -->
    <header class="value-engine__header" data-reveal>
      <span class="adaptif-eyebrow">HOW ADAPTIF WORKS</span>
      <h2 id="value-engine-heading" class="value-engine__title">
        From your vision to <span class="title-highlight">shipped creative.</span>
      </h2>
      <p class="value-engine__subtitle">
        One streamlined creative engine: share what you need, our team handles the craft, and every plan comes backed by the same core standards.
      </p>
    </header>

    <!-- Visual Transformation Pipeline: Your input -> Adaptif -> Your output -->
    <div
      class="pipeline-shell"
      data-reveal
      role="region"
      aria-label="How Adaptif transforms your input into deliverables"
    >
      <!-- Stage Labels (Desktop) -->
      <div class="pipeline-stages" aria-hidden="true">
        <span class="stage-tag">01 / Your input</span>
        <span class="stage-tag stage-tag--core">02 / Adaptif</span>
        <span class="stage-tag">03 / Your output</span>
      </div>

      <div class="pipeline-grid">
        <!-- Column 1: Your Input -->
        <div class="pipeline-col pipeline-col--input">
          <div class="mobile-stage-label">01 / Your input</div>
          <ul class="node-list" aria-label="Your input">
            {
              inputs.map((item, idx) => (
                <li class="pipeline-node pipeline-node--input" style={`--node-idx: ${idx}`}>
                  <span class="node-icon" aria-hidden="true">
                    {item.icon === "brief" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                      </svg>
                    )}
                    {item.icon === "goals" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <circle cx="12" cy="12" r="6" />
                        <circle cx="12" cy="12" r="2" />
                      </svg>
                    )}
                    {item.icon === "brand" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2L2 7l10 5 10-5-10-5z" />
                        <path d="M2 17l10 5 10-5" />
                        <path d="M2 12l10 5 10-5" />
                      </svg>
                    )}
                  </span>
                  <div class="node-copy">
                    <span class="node-title">{item.label}</span>
                    <span class="node-detail">{item.detail}</span>
                  </div>
                  <span class="node-port node-port--out" aria-hidden="true"></span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- SVG Conduits: Input -> Adaptif (Desktop) -->
        <div class="conduit conduit--left" aria-hidden="true">
          <svg viewBox="0 0 120 260" preserveAspectRatio="none" class="conduit-svg">
            <defs>
              <linearGradient id="conduit-grad-in" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="120" y2="0">
                <stop offset="0%" stop-color="rgba(148, 163, 184, 0.25)" />
                <stop offset="100%" stop-color="rgba(72, 200, 255, 0.85)" />
              </linearGradient>
              <marker id="arrow-cyan-in" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                <path d="M 1 1 L 8 5 L 1 9 z" fill="rgba(72, 200, 255, 0.85)" />
              </marker>
            </defs>
            <!-- Static guide paths with directional arrows -->
            <path data-in-track="0" d="M 0 42 C 60 42, 60 130, 114 130" class="conduit-track" stroke="url(#conduit-grad-in)" marker-end="url(#arrow-cyan-in)" />
            <path data-in-track="1" d="M 0 130 C 55 130, 65 130, 114 130" class="conduit-track" stroke="url(#conduit-grad-in)" marker-end="url(#arrow-cyan-in)" />
            <path data-in-track="2" d="M 0 218 C 60 218, 60 130, 114 130" class="conduit-track" stroke="url(#conduit-grad-in)" marker-end="url(#arrow-cyan-in)" />

            <!-- Animated flow pulses -->
            <path data-in-pulse="0" d="M 0 42 C 60 42, 60 130, 114 130" class="conduit-pulse conduit-pulse--1" />
            <path data-in-pulse="1" d="M 0 130 C 55 130, 65 130, 114 130" class="conduit-pulse conduit-pulse--2" />
            <path data-in-pulse="2" d="M 0 218 C 60 218, 60 130, 114 130" class="conduit-pulse conduit-pulse--3" />
          </svg>
        </div>

        <!-- Mobile Directional Connector -->
        <div class="mobile-flow-arrow" aria-hidden="true">
          <svg width="24" height="32" viewBox="0 0 24 32" fill="none">
            <line x1="12" y1="2" x2="12" y2="26" stroke="rgba(72, 200, 255, 0.65)" stroke-width="1.5" stroke-dasharray="3 3" />
            <path d="M6 21L12 28L18 21" stroke="#48C8FF" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <!-- Column 2: Adaptif Core -->
        <div class="pipeline-col pipeline-col--core">
          <div class="mobile-stage-label">02 / Adaptif</div>
          <div class="core-wrap">
            <div class="core-card">
              <div class="core-ring core-ring--outer" aria-hidden="true"></div>
              <div class="core-ring core-ring--inner" aria-hidden="true"></div>
              <img
                src="/logo.svg"
                alt="Adaptif"
                width="148"
                height="71"
                class="core-logo"
                loading="lazy"
              />
              <p class="core-tagline">We design, develop &amp; deliver</p>
              <div class="core-divider" aria-hidden="true"></div>
              <span class="core-meta">Your dedicated creative team</span>
            </div>
            <!-- Desktop spine directly anchored to Core bottom -->
            <div class="engine-spine engine-spine--desktop" aria-hidden="true">
              <span class="engine-spine__line"></span>
              <span class="engine-spine__dot"></span>
            </div>
          </div>
        </div>

        <!-- Mobile Directional Connector -->
        <div class="mobile-flow-arrow" aria-hidden="true">
          <svg width="24" height="32" viewBox="0 0 24 32" fill="none">
            <line x1="12" y1="2" x2="12" y2="26" stroke="rgba(72, 200, 255, 0.65)" stroke-width="1.5" stroke-dasharray="3 3" />
            <path d="M6 21L12 28L18 21" stroke="#48C8FF" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>

        <!-- SVG Conduits: Adaptif -> Output (Desktop) -->
        <div class="conduit conduit--right" aria-hidden="true">
          <svg viewBox="0 0 120 310" preserveAspectRatio="none" class="conduit-svg">
            <defs>
              <linearGradient id="conduit-grad-out" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="120" y2="0">
                <stop offset="0%" stop-color="rgba(72, 200, 255, 0.85)" />
                <stop offset="100%" stop-color="rgba(72, 200, 255, 0.35)" />
              </linearGradient>
              <marker id="arrow-cyan-out" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                <path d="M 1 1 L 8 5 L 1 9 z" fill="#48C8FF" />
              </marker>
            </defs>
            <path data-out-track="0" d="M 0 155 C 58 155, 58 38, 114 38" class="conduit-track" stroke="url(#conduit-grad-out)" marker-end="url(#arrow-cyan-out)" />
            <path data-out-track="1" d="M 0 155 C 58 155, 58 116, 114 116" class="conduit-track" stroke="url(#conduit-grad-out)" marker-end="url(#arrow-cyan-out)" />
            <path data-out-track="2" d="M 0 155 C 58 155, 58 194, 114 194" class="conduit-track" stroke="url(#conduit-grad-out)" marker-end="url(#arrow-cyan-out)" />
            <path data-out-track="3" d="M 0 155 C 58 155, 58 272, 114 272" class="conduit-track" stroke="url(#conduit-grad-out)" marker-end="url(#arrow-cyan-out)" />

            <path data-out-pulse="0" d="M 0 155 C 58 155, 58 38, 114 38" class="conduit-pulse conduit-pulse--out-1" />
            <path data-out-pulse="1" d="M 0 155 C 58 155, 58 116, 114 116" class="conduit-pulse conduit-pulse--out-2" />
            <path data-out-pulse="2" d="M 0 155 C 58 155, 58 194, 114 194" class="conduit-pulse conduit-pulse--out-3" />
            <path data-out-pulse="3" d="M 0 155 C 58 155, 58 272, 114 272" class="conduit-pulse conduit-pulse--out-4" />
          </svg>
        </div>

        <!-- Column 3: Your Output -->
        <div class="pipeline-col pipeline-col--output">
          <div class="mobile-stage-label">03 / Your output</div>
          <ul class="node-list" aria-label="Your output">
            {
              outputs.map((item, idx) => (
                <li class="pipeline-node pipeline-node--output" style={`--node-idx: ${idx}`}>
                  <span class="node-port node-port--in" aria-hidden="true"></span>
                  <span class="node-icon node-icon--output" aria-hidden="true">
                    {item.icon === "websites" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <line x1="3" y1="9" x2="21" y2="9" />
                        <line x1="9" y1="21" x2="9" y2="9" />
                      </svg>
                    )}
                    {item.icon === "identities" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                      </svg>
                    )}
                    {item.icon === "marketing" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 11l18-5v12L3 14v-3z" />
                        <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
                      </svg>
                    )}
                    {item.icon === "video" && (
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="5 3 19 12 5 21 5 3" />
                      </svg>
                    )}
                  </span>
                  <div class="node-copy">
                    <span class="node-title">{item.label}</span>
                    <span class="node-detail">{item.detail}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Mobile Vertical Flow Spine -->
    <div class="engine-spine engine-spine--mobile" aria-hidden="true">
      <span class="engine-spine__line"></span>
      <span class="engine-spine__dot"></span>
    </div>

    <!-- Included in all plans -->
    <div class="benefits-panel" data-reveal aria-labelledby="included-plans-heading">
      <div class="benefits-panel__intro">
        <span class="benefits-kicker">EVERY SUBSCRIPTION INCLUDES</span>
        <h3 id="included-plans-heading" class="benefits-panel__title">
          Included in all plans
        </h3>
        <div class="benefits-panel__cta">
          <a href="#contact" class="adaptif-btn">
            Book a call
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <ul class="benefits-grid">
        {
          benefits.map((benefit) => (
            <li class={`benefit-item ${benefit.featured ? "benefit-item--featured" : ""}`}>
              <div class="benefit-item__icon" aria-hidden="true">
                {benefit.icon === "services" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="3" width="7" height="7" rx="1.5" />
                    <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    <rect x="3" y="14" width="7" height="7" rx="1.5" />
                  </svg>
                )}
                {benefit.icon === "clock" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <polyline points="12 7 12 12 15.5 14" />
                  </svg>
                )}
                {benefit.icon === "support" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  </svg>
                )}
                {benefit.icon === "globe" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <line x1="3.6" y1="9" x2="20.4" y2="9" />
                    <line x1="3.6" y1="15" x2="20.4" y2="15" />
                    <path d="M12 3a14.5 14.5 0 0 0 0 18" />
                    <path d="M12 3a14.5 14.5 0 0 1 0 18" />
                  </svg>
                )}
                {benefit.icon === "ai" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l1.9 5.2L19 10l-5.1 1.8L12 17l-1.9-5.2L5 10l5.1-1.8L12 3z" />
                    <path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16z" />
                  </svg>
                )}
                {benefit.icon === "layers" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 2 7 12 12 22 7 12 2" />
                    <polyline points="2 12 12 17 22 12" />
                    <polyline points="2 17 12 22 22 17" />
                  </svg>
                )}
                {benefit.icon === "refresh" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10" />
                    <polyline points="1 20 1 14 7 14" />
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                  </svg>
                )}
                {benefit.icon === "tickets" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4V7z" />
                    <line x1="9" y1="9" x2="15" y2="9" />
                    <line x1="9" y1="15" x2="13" y2="15" />
                  </svg>
                )}
              </div>
              <div class="benefit-item__body">
                <h4 class="benefit-item__title">{benefit.title}</h4>
                {benefit.subtitle && (
                  <p class="benefit-item__subtitle">{benefit.subtitle}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .value-engine {
    position: relative;
    padding: 5.5rem 0 6.5rem;
    background: var(--color-void);
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(110px);
    z-index: 0;
  }

  .ambient-glow--top {
    width: 680px;
    height: 380px;
    top: 4%;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(72, 200, 255, 0.14) 0%, rgba(1, 3, 7, 0) 72%);
  }

  .ambient-glow--bottom {
    width: 560px;
    height: 360px;
    bottom: 2%;
    right: 8%;
    background: radial-gradient(circle, rgba(16, 120, 255, 0.1) 0%, rgba(1, 3, 7, 0) 75%);
  }

  .value-engine__container {
    position: relative;
    z-index: 1;
  }

  /* Header */
  .value-engine__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.15rem;
  }

  .value-engine__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.5vw, 3.6rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-white);
  }

  .value-engine__subtitle {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  /* Pipeline Shell (open on void canvas, no outer card) */
  .pipeline-shell {
    position: relative;
    padding: 0;
    margin-bottom: 3.75rem;
  }

  .pipeline-stages {
    display: grid;
    grid-template-columns: 1fr 110px 1.05fr 110px 1fr;
    align-items: center;
    margin-bottom: 1.35rem;
    padding: 0 0.25rem;
  }

  .stage-tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.56);
  }

  .stage-tag--core {
    grid-column: 3;
    text-align: center;
    color: var(--color-brand-cyan);
  }

  .pipeline-stages .stage-tag:last-child {
    grid-column: 5;
    text-align: right;
  }

  .mobile-stage-label {
    display: none;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 0.85rem;
    text-align: center;
  }

  .pipeline-grid {
    display: grid;
    grid-template-columns: 1fr 110px 1.05fr 110px 1fr;
    align-items: center;
    gap: 0;
  }

  .node-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
  }

  .pipeline-node {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.09);
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .pipeline-node:hover {
    border-color: rgba(72, 200, 255, 0.35);
    background: rgba(72, 200, 255, 0.06);
    transform: translateY(-2px);
  }

  .pipeline-node--output {
    border-color: rgba(72, 200, 255, 0.16);
    background: linear-gradient(135deg, rgba(72, 200, 255, 0.06) 0%, rgba(255, 255, 255, 0.025) 100%);
  }

  .node-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-white);
  }

  .node-icon--output {
    background: rgba(72, 200, 255, 0.12);
    border-color: rgba(72, 200, 255, 0.28);
    color: var(--color-brand-cyan);
  }

  .node-copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .node-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-white);
    line-height: 1.25;
  }

  .node-detail {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
  }

  .node-port {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand-cyan);
    box-shadow: 0 0 10px rgba(72, 200, 255, 0.7);
  }

  .node-port--out {
    right: -4px;
  }

  .node-port--in {
    left: -4px;
  }

  /* SVG Conduits */
  .conduit {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: stretch;
  }

  .conduit-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .conduit-track {
    fill: none;
    stroke-width: 1.5;
  }

  .conduit-pulse {
    fill: none;
    stroke: #48C8FF;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 22 140;
    stroke-dashoffset: 162;
    animation: flowPulse 3.2s linear infinite;
    filter: drop-shadow(0 0 6px rgba(72, 200, 255, 0.8));
  }

  .conduit-pulse--2 { animation-delay: 0.55s; }
  .conduit-pulse--3 { animation-delay: 1.1s; }
  .conduit-pulse--out-1 { animation-delay: 1.3s; }
  .conduit-pulse--out-2 { animation-delay: 1.75s; }
  .conduit-pulse--out-3 { animation-delay: 2.2s; }
  .conduit-pulse--out-4 { animation-delay: 2.65s; }

  @keyframes flowPulse {
    from {
      stroke-dashoffset: 162;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .mobile-flow-arrow {
    display: none;
    justify-content: center;
    padding: 0.55rem 0;
  }

  /* Adaptif Core */
  .core-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 1.75rem;
    border-radius: 24px;
    background: radial-gradient(circle at 50% 35%, rgba(72, 200, 255, 0.16) 0%, rgba(12, 24, 44, 0.92) 70%);
    border: 1px solid rgba(72, 200, 255, 0.42);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 0 48px rgba(72, 200, 255, 0.16);
    overflow: hidden;
  }

  .core-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(72, 200, 255, 0.22);
    pointer-events: none;
  }

  .core-ring--outer {
    width: 260px;
    height: 260px;
    animation: slowSpin 38s linear infinite;
  }

  .core-ring--inner {
    width: 190px;
    height: 190px;
    border-color: rgba(72, 200, 255, 0.14);
    animation: slowSpin 24s linear infinite reverse;
  }

  @keyframes slowSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .core-badge {
    position: relative;
    z-index: 1;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-brand-cyan);
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-pill);
    background: rgba(72, 200, 255, 0.1);
    border: 1px solid rgba(72, 200, 255, 0.25);
    margin-bottom: 1.25rem;
  }

  .core-logo {
    position: relative;
    z-index: 1;
    width: 148px;
    height: auto;
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 18px rgba(72, 200, 255, 0.25));
  }

  .core-tagline {
    position: relative;
    z-index: 1;
    font-family: var(--font-family-display);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1.2;
    color: var(--color-text-white);
    margin: 0;
  }

  .core-divider {
    position: relative;
    z-index: 1;
    width: 44px;
    height: 1px;
    background: rgba(72, 200, 255, 0.4);
    margin: 1rem 0 0.85rem;
  }

  .core-meta {
    position: relative;
    z-index: 1;
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }

  .core-wrap {
    position: relative;
  }

  /* Spine linking Core to Benefits */
  .engine-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .engine-spine--desktop {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .engine-spine--mobile {
    display: none;
    padding: 0.25rem 0;
  }

  .engine-spine__line {
    width: 1px;
    height: var(--spine-height, 92px);
    background: linear-gradient(180deg, rgba(72, 200, 255, 0.78) 0%, rgba(72, 200, 255, 0.35) 100%);
  }

  .engine-spine__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-top: -4px;
    background: var(--color-brand-cyan);
    box-shadow: 0 0 12px rgba(72, 200, 255, 0.85);
  }

  /* Included in all plans — Editorial Split + Hairline Matrix */
  .benefits-panel {
    position: relative;
    padding-top: 3.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    grid-template-columns: minmax(250px, 0.78fr) 1.55fr;
    gap: 3.5rem;
    align-items: start;
  }

  .benefits-panel__intro {
    position: sticky;
    top: 7.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .benefits-kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-brand-cyan);
    margin: 0;
  }

  .benefits-panel__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.1rem, 3.6vw, 2.95rem);
    font-weight: 400;
    line-height: 1.06;
    color: var(--color-text-white);
    margin: 0;
  }

  .benefits-panel__cta {
    margin-top: 0.35rem;
  }

  .benefits-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.45rem 1.5rem 1.45rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: background 0.25s ease;
  }

  .benefit-item:nth-child(even) {
    padding-left: 1.75rem;
    padding-right: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .benefit-item:hover .benefit-item__icon {
    border-color: rgba(72, 200, 255, 0.5);
    background: rgba(72, 200, 255, 0.16);
  }

  .benefit-item__icon {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(72, 200, 255, 0.09);
    border: 1px solid rgba(72, 200, 255, 0.22);
    color: var(--color-brand-cyan);
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .benefit-item--featured .benefit-item__icon {
    background: rgba(72, 200, 255, 0.14);
    border-color: rgba(72, 200, 255, 0.35);
  }

  .benefit-item__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.1rem;
  }

  .benefit-item__title {
    font-family: var(--font-family-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-white);
    margin: 0;
  }

  .benefit-item__subtitle {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Reveal animation */
  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s var(--ease-spring), transform 0.7s var(--ease-spring);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .pipeline-stages {
      display: none;
    }

    .mobile-stage-label {
      display: block;
    }

    .pipeline-grid {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .pipeline-shell {
      margin-bottom: 0;
    }

    .conduit,
    .node-port,
    .engine-spine--desktop {
      display: none;
    }

    .engine-spine--mobile {
      display: flex;
      padding: 0;
    }

    .engine-spine--mobile .engine-spine__line {
      height: 44px;
    }

    .mobile-flow-arrow {
      display: flex;
    }

    .benefits-panel {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-top: 2.5rem;
    }

    .benefits-panel__intro {
      position: static;
    }
  }

  @media (max-width: 680px) {
    .value-engine {
      padding: 4rem 0 4.5rem;
    }

    .benefits-panel {
      padding-top: 2rem;
    }

    .benefits-grid {
      grid-template-columns: 1fr;
    }

    .benefit-item,
    .benefit-item:nth-child(even) {
      padding: 1.2rem 0;
      border-left: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .conduit-pulse,
    .core-ring {
      animation: none !important;
    }

    .conduit-pulse {
      display: none;
    }

    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .pipeline-node:hover,
    .benefit-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const root = document.getElementById("pricing-value-engine");

  if (root) {
    const revealEls = root.querySelectorAll<HTMLElement>("[data-reveal]");

    if (
      revealEls.length > 0 &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
      "IntersectionObserver" in window
    ) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 }
      );

      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add("is-visible"));
    }

    const syncConduitPaths = () => {
      const leftConduit = root.querySelector<HTMLElement>(".conduit--left");
      const rightConduit = root.querySelector<HTMLElement>(".conduit--right");
      const coreCard = root.querySelector<HTMLElement>(".core-card");
      const benefitsPanel = root.querySelector<HTMLElement>(".benefits-panel");
      const desktopSpine = root.querySelector<HTMLElement>(".engine-spine--desktop");

      if (!leftConduit || !rightConduit || !coreCard) return;

      const coreRect = coreCard.getBoundingClientRect();

      if (desktopSpine && benefitsPanel) {
        const panelRect = benefitsPanel.getBoundingClientRect();
        const spineGap = Math.max(24, Math.round(panelRect.top - coreRect.bottom));
        desktopSpine.style.setProperty("--spine-height", `${spineGap}px`);
      }

      if (leftConduit.offsetParent !== null) {
        const lRect = leftConduit.getBoundingClientRect();
        const lW = lRect.width;
        const lH = lRect.height;
        const lSvg = leftConduit.querySelector("svg");
        const lGrad = leftConduit.querySelector("#conduit-grad-in");
        if (lSvg && lW > 0 && lH > 0) {
          lSvg.setAttribute("viewBox", `0 0 ${lW} ${lH}`);
          if (lGrad) lGrad.setAttribute("x2", `${lW}`);
          const coreMidY = coreRect.top + coreRect.height / 2 - lRect.top;
          const inPorts = root.querySelectorAll<HTMLElement>(".pipeline-node--input .node-port");
          inPorts.forEach((port, i) => {
            const pRect = port.getBoundingClientRect();
            const startY = pRect.top + pRect.height / 2 - lRect.top;
            const endX = lW - 6;
            const c1x = lW * 0.5;
            const d = `M 0 ${startY.toFixed(1)} C ${c1x.toFixed(1)} ${startY.toFixed(1)}, ${c1x.toFixed(1)} ${coreMidY.toFixed(1)}, ${endX.toFixed(1)} ${coreMidY.toFixed(1)}`;
            leftConduit.querySelector(`[data-in-track="${i}"]`)?.setAttribute("d", d);
            leftConduit.querySelector(`[data-in-pulse="${i}"]`)?.setAttribute("d", d);
          });
        }
      }

      if (rightConduit.offsetParent !== null) {
        const rRect = rightConduit.getBoundingClientRect();
        const rW = rRect.width;
        const rH = rRect.height;
        const rSvg = rightConduit.querySelector("svg");
        const rGrad = rightConduit.querySelector("#conduit-grad-out");
        if (rSvg && rW > 0 && rH > 0) {
          rSvg.setAttribute("viewBox", `0 0 ${rW} ${rH}`);
          if (rGrad) rGrad.setAttribute("x2", `${rW}`);
          const coreMidY = coreRect.top + coreRect.height / 2 - rRect.top;
          const outPorts = root.querySelectorAll<HTMLElement>(".pipeline-node--output .node-port");
          outPorts.forEach((port, i) => {
            const pRect = port.getBoundingClientRect();
            const endY = pRect.top + pRect.height / 2 - rRect.top;
            const endX = rW - 6;
            const c1x = rW * 0.48;
            const d = `M 0 ${coreMidY.toFixed(1)} C ${c1x.toFixed(1)} ${coreMidY.toFixed(1)}, ${c1x.toFixed(1)} ${endY.toFixed(1)}, ${endX.toFixed(1)} ${endY.toFixed(1)}`;
            rightConduit.querySelector(`[data-out-track="${i}"]`)?.setAttribute("d", d);
            rightConduit.querySelector(`[data-out-pulse="${i}"]`)?.setAttribute("d", d);
          });
        }
      }
    };

    syncConduitPaths();
    requestAnimationFrame(syncConduitPaths);
    if (document.fonts?.ready) {
      document.fonts.ready.then(syncConduitPaths);
    }
    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(syncConduitPaths);
      ro.observe(root);
    } else {
      window.addEventListener("resize", syncConduitPaths);
    }
  }
</script>
