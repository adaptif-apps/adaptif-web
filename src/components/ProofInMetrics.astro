---
// ProofInMetrics.astro - Section: Proof in the metrics
interface StatItem {
  id: string;
  target: number;
  suffix: string;
  decimals: number;
  unit: string;
  label: string;
  iconType: "industries" | "speed" | "rating";
  accentColor?: string;
}

const stats: StatItem[] = [
  {
    id: "stat-industries",
    target: 12,
    suffix: "+",
    decimals: 0,
    unit: "Industries",
    label: "Trusted by growing brands",
    iconType: "industries",
    accentColor: "rgba(72, 200, 255, 0.4)"
  },
  {
    id: "stat-turnaround",
    target: 48,
    suffix: "",
    decimals: 0,
    unit: "hrs",
    label: "Avg. turnaround",
    iconType: "speed",
    accentColor: "rgba(0, 190, 255, 0.4)"
  },
  {
    id: "stat-satisfaction",
    target: 4.9,
    suffix: "",
    decimals: 1,
    unit: "/5",
    label: "Client satisfaction",
    iconType: "rating",
    accentColor: "rgba(72, 220, 255, 0.4)"
  }
];
---

<section class="metrics-section" id="proof-in-the-metrics">
  <!-- Ambient Atmospheric Lighting -->
  <div class="metrics-glow-ambient" aria-hidden="true"></div>

  <div class="container metrics-container">
    <!-- Header Block -->
    <div class="metrics-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">PROOF IN THE METRICS</span>
      </div>

      <h2 class="metrics-title">
        Work that actually <span class="title-highlight">moves the numbers</span>
      </h2>
    </div>

    <!-- 3 Statistics Cards Grid -->
    <div class="metrics-grid">
      {stats.map((stat, idx) => (
        <article class="stat-card" style={`--stat-accent: ${stat.accentColor}; --card-idx: ${idx};`}>
          <!-- Card Specular Rim -->
          <div class="stat-specular-edge" aria-hidden="true"></div>

          <!-- Subtle Radial Spotlight on Hover -->
          <div class="stat-hover-glow" aria-hidden="true"></div>

          <!-- Card Header: Micro Icon & Indicator -->
          <div class="stat-card-top">
            <div class="stat-icon-badge" aria-hidden="true">
              {stat.iconType === "industries" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/>
                  <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
              )}
              {stat.iconType === "speed" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
              )}
              {stat.iconType === "rating" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              )}
            </div>

            {stat.iconType === "rating" && (
              <div class="rating-stars" aria-label="5 stars rating">
                {[...Array(5)].map((_, sIdx) => (
                  <svg 
                    class="rating-star-icon"
                    style={`--star-idx: ${sIdx};`}
                    width="12" 
                    height="12" 
                    viewBox="0 0 24 24" 
                    fill="#48C8FF" 
                    stroke="none" 
                    aria-hidden="true"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                ))}
              </div>
            )}
          </div>

          <!-- Main Metric Block -->
          <div class="stat-body">
            <div class="stat-number-wrap">
              <span 
                class="stat-number" 
                data-target={stat.target} 
                data-suffix={stat.suffix} 
                data-decimals={stat.decimals}
              >
                0{stat.suffix}
              </span>
              <span class="stat-unit">{stat.unit}</span>
            </div>

            <p class="stat-label">{stat.label}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA Trigger -->
    <div class="metrics-cta-row">
      <a href="#work" class="btn-primary-cta">
        <span class="btn-glow-aurora" aria-hidden="true"></span>
        <span class="btn-content">
          <span>Our Work</span>
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  function setupMetricsObserver() {
    const section = document.getElementById("proof-in-the-metrics");
    if (!section) return;

    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add("is-visible");

            if (!prefersReducedMotion) {
              startCountUp(section);
            } else {
              // Direct assignment if motion is reduced
              const counters = section.querySelectorAll<HTMLElement>(".stat-number[data-target]");
              counters.forEach((el) => {
                const target = el.dataset.target || "0";
                const suffix = el.dataset.suffix || "";
                el.textContent = target + suffix;
              });
            }

            observer.unobserve(section);
          }
        });
      },
      {
        threshold: 0.2,
        rootMargin: "0px 0px -40px 0px"
      }
    );

    observer.observe(section);
  }

  function startCountUp(container: HTMLElement) {
    const counters = container.querySelectorAll<HTMLElement>(".stat-number[data-target]");
    const duration = 1800; // 1.8s for ultra smooth and satisfying count-up

    // Small delay to allow the card entrance animation to settle
    setTimeout(() => {
      const startTime = performance.now();

      function update(currentTime: number) {
        const elapsed = currentTime - startTime;
        const rawProgress = Math.min(elapsed / duration, 1);
        // Exponential ease out for smooth deceleration
        const progress = rawProgress === 1 ? 1 : 1 - Math.pow(2, -10 * rawProgress);

        counters.forEach((el) => {
          const target = parseFloat(el.dataset.target || "0");
          const suffix = el.dataset.suffix || "";
          const decimals = parseInt(el.dataset.decimals || "0", 10);

          const currentVal = target * progress;
          el.textContent = currentVal.toFixed(decimals) + suffix;
        });

        if (rawProgress < 1) {
          requestAnimationFrame(update);
        } else {
          // Guarantee final exact value
          counters.forEach((el) => {
            const target = el.dataset.target || "0";
            const suffix = el.dataset.suffix || "";
            el.textContent = target + suffix;
          });
        }
      }

      requestAnimationFrame(update);
    }, 280);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMetricsObserver);
  } else {
    setupMetricsObserver();
  }

  // Astro page swap / client hydration support
  document.addEventListener("astro:page-load", setupMetricsObserver);
</script>

<style>
  .metrics-section {
    position: relative;
    width: 100%;
    padding-top: clamp(60px, 9vh, 100px);
    padding-bottom: clamp(70px, 11vh, 130px);
    background-color: var(--color-void, #010307);
    overflow: hidden;
  }

  /* Ambient Lighting */
  .metrics-glow-ambient {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(900px, 90vw);
    height: 450px;
    background: radial-gradient(ellipse at 50% 50%, rgba(72, 200, 255, 0.08) 0%, rgba(0, 102, 255, 0.03) 50%, transparent 75%);
    filter: blur(90px);
    pointer-events: none;
    z-index: 0;
  }

  .metrics-container {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Header */
  .metrics-header {
    text-align: center;
    max-width: 840px;
    margin-bottom: clamp(40px, 6vh, 60px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(12px, 1.8vh, 18px);
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #48C8FF;
    display: inline-block;
  }

  .metrics-title {
    font-family: var(--font-family-display);
    font-size: clamp(2.3rem, 4.2vw, 3.6rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--color-text-white);
    margin: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: 
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.08s,
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
  }

  /* Celestial Gradient Highlight for "moves the numbers" */
  .title-highlight {
    color: #48C8FF;
    background: linear-gradient(135deg, #7fe2ff 0%, #48C8FF 50%, #1da5ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 14px rgba(72, 200, 255, 0.35));
  }

  /* Grid of 3 Cards */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.4vw, 28px);
    width: 100%;
    max-width: 1160px;
  }

  /* Obsidian Glass Card */
  .stat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 240px;
    padding: clamp(26px, 3.2vw, 36px);
    background: 
      radial-gradient(ellipse 100% 60% at 50% 0%, rgba(20, 38, 85, 0.45) 0%, rgba(5, 11, 28, 0.75) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg, 24px);
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 -1px 2px 0 rgba(0, 102, 255, 0.12),
      0 16px 40px -10px rgba(0, 4, 15, 0.7);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    overflow: hidden;
    opacity: 0;
    transform: translateY(32px);
    transition: 
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  /* Staggered entrance delays for the cards */
  .stat-card[style*="--card-idx: 0"] {
    transition-delay: 0.18s, 0.18s, 0s, 0s;
  }

  .stat-card[style*="--card-idx: 1"] {
    transition-delay: 0.30s, 0.30s, 0s, 0s;
  }

  .stat-card[style*="--card-idx: 2"] {
    transition-delay: 0.42s, 0.42s, 0s, 0s;
  }

  /* Top Specular Rim */
  .stat-specular-edge {
    position: absolute;
    top: 0;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.35) 40%,
      rgba(72, 200, 255, 0.5) 60%,
      transparent
    );
    pointer-events: none;
  }

  /* Hover Radial Ambient Light */
  .stat-hover-glow {
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 220px;
    height: 220px;
    background: radial-gradient(circle, var(--stat-accent, rgba(72, 200, 255, 0.35)) 0%, transparent 70%);
    opacity: 0.18;
    filter: blur(35px);
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* Card Top Row */
  .stat-card-top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: clamp(24px, 3vh, 32px);
  }

  .stat-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #48C8FF;
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15);
    opacity: 0;
    transform: scale(0.82);
    transition: 
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.32s,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.32s;
  }

  .rating-stars {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 6px 10px;
    background: rgba(72, 200, 255, 0.08);
    border: 1px solid rgba(72, 200, 255, 0.18);
    border-radius: var(--radius-pill);
    opacity: 0;
    transform: scale(0.85);
    transition: 
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.38s,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.38s;
  }

  .rating-star-icon {
    opacity: 0;
    transform: scale(0.1) rotate(-20deg);
    transition: 
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* One by one sequential entrance */
  .metrics-section.is-visible .rating-star-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  .metrics-section.is-visible .rating-star-icon[style*="--star-idx: 0"] {
    transition-delay: 0.46s;
  }
  .metrics-section.is-visible .rating-star-icon[style*="--star-idx: 1"] {
    transition-delay: 0.56s;
  }
  .metrics-section.is-visible .rating-star-icon[style*="--star-idx: 2"] {
    transition-delay: 0.66s;
  }
  .metrics-section.is-visible .rating-star-icon[style*="--star-idx: 3"] {
    transition-delay: 0.76s;
  }
  .metrics-section.is-visible .rating-star-icon[style*="--star-idx: 4"] {
    transition-delay: 0.86s;
  }

  /* Main Stat Body */
  .stat-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stat-number-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .stat-number {
    font-size: clamp(2.8rem, 4.4vw, 4.2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 4px 18px rgba(72, 200, 255, 0.25);
  }

  .stat-unit {
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.85);
  }

  .stat-label {
    font-size: clamp(0.92rem, 1.1vw, 1.05rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--color-text-secondary, #94a3b8);
    margin: 0;
    opacity: 0;
    transform: translateY(8px);
    transition: 
      opacity 0.6s ease 0.36s,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.36s;
  }

  /* CTA Row */
  .metrics-cta-row {
    position: relative;
    z-index: 2;
    margin-top: clamp(40px, 6vh, 56px);
    display: flex;
    justify-content: center;
    opacity: 0;
    transform: translateY(24px);
    transition: 
      opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.52s,
      transform 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.52s;
  }

  /* Triggered State when entering viewport */
  .metrics-section.is-visible .eyebrow-wrapper,
  .metrics-section.is-visible .metrics-title,
  .metrics-section.is-visible .stat-card,
  .metrics-section.is-visible .stat-label,
  .metrics-section.is-visible .metrics-cta-row {
    opacity: 1;
    transform: translateY(0);
  }

  .metrics-section.is-visible .stat-icon-badge,
  .metrics-section.is-visible .rating-stars {
    opacity: 1;
    transform: scale(1);
  }

  /* Card Hover Interactions */
  .metrics-section.is-visible .stat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(72, 200, 255, 0.32);
    box-shadow: 
      inset 0 1px 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 2px 0 rgba(0, 102, 255, 0.2),
      0 24px 50px -12px rgba(0, 6, 22, 0.85),
      0 0 30px -8px rgba(72, 200, 255, 0.25);
  }

  .stat-card:hover .stat-hover-glow {
    opacity: 0.45;
    transform: translateX(-50%) scale(1.15);
  }

  /* CTA Button (Identical to Hero & Rethinking Button Style) */
  .btn-primary-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: var(--font-size-btn, 0.95rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
    background: 
      radial-gradient(ellipse 90% 65% at 50% 0%, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0) 72%),
      linear-gradient(180deg, #56d3ff 0%, #30baff 48%, #0aa3f8 100%);
    border: none;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-button-primary);
    text-shadow: 0 1px 2px rgba(0, 60, 130, 0.35);
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    transition: 
      transform var(--duration-fast, 160ms) var(--ease-spring),
      box-shadow var(--duration-fast, 160ms) var(--ease-spring);
  }

  .btn-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-content svg {
    color: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0, 20, 60, 0.4));
    transition: transform var(--duration-fast, 160ms) var(--ease-spring);
  }

  .btn-glow-aurora {
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at 50% 0%, rgba(72, 200, 255, 0.8) 0%, transparent 70%);
    opacity: 0.6;
    transition: opacity var(--duration-fast, 160ms);
  }

  .btn-primary-cta:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: var(--shadow-button-hover);
  }

  .btn-primary-cta:hover .btn-glow-aurora {
    opacity: 1;
  }

  .btn-primary-cta:hover .btn-content svg {
    transform: translateX(4px);
  }

  /* Responsive Design */
  @media (max-width: 960px) {
    .metrics-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat-card:last-child {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .metrics-header {
      text-align: left;
      align-items: flex-start;
    }

    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .stat-card:last-child {
      grid-column: span 1;
    }

    .stat-card {
      min-height: auto;
      padding: 24px 20px;
    }

    .stat-card-top {
      margin-bottom: 20px;
    }

    .stat-number {
      font-size: 2.8rem;
    }

    .stat-unit {
      font-size: 1.25rem;
    }

    .metrics-cta-row {
      width: 100%;
    }

    .btn-primary-cta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eyebrow-wrapper,
    .metrics-title,
    .stat-card,
    .stat-icon-badge,
    .rating-stars,
    .rating-star-icon,
    .stat-label,
    .metrics-cta-row {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
