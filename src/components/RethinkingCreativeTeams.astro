---
// RethinkingCreativeTeams.astro - Feature Section: Rethinking Creative Teams
---

<section class="rethinking-section" id="why-us">
  <!-- Volumetric Ambient Light Glows with Smooth Bottom Mask to prevent any edge cut -->
  <div class="ambient-glow-wrapper" aria-hidden="true">
    <div class="ambient-glow-left"></div>
    <div class="ambient-glow-right"></div>
  </div>

  <div class="rethinking-container">
    <div class="rethinking-grid">
      <!-- Left Column: Copy & Actions -->
      <div class="rethinking-copy">
        <!-- Eyebrow (Plain Text Only, No Border, No Icon) -->
        <div class="eyebrow-wrapper">
          <span class="eyebrow-text">RETHINKING CREATIVE TEAMS</span>
        </div>

        <!-- Main Title -->
        <h2 class="rethinking-title">
          The backup your creative team has been waiting for
        </h2>

        <!-- Description Paragraph -->
        <p class="rethinking-paragraph">
          Adaptif plugs into your day‑to‑day workflow, increasing your production capacity so you can launch more brands, campaigns and high‑impact landing pages with consistent quality.
        </p>

        <!-- CTA and Highlights -->
        <div class="rethinking-action-row">
          <a href="#contact" class="btn-primary-cta">
            <span class="btn-glow-aurora" aria-hidden="true"></span>
            <span class="btn-content">
              <span>Book a Call</span>
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>

          <div class="action-caption">
            <span class="caption-dot"></span>
            <span>No hiring overhead • Ready in 24 hours</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Clean Feature Image (No Frame, No Tag) -->
      <div class="rethinking-visual-wrapper">
        <div class="image-viewport">
          <img 
            src="/images/rethinking-creative-teams.jpg" 
            alt="Adaptif creative team collaborating with luminous connected workstations" 
            class="rethinking-img"
            width="1200"
            height="806"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rethinking-section {
    position: relative;
    width: 100%;
    padding-top: clamp(60px, 9vh, 100px);
    padding-bottom: clamp(70px, 11vh, 130px);
    overflow: hidden;
  }

  /* Ambient Diffuse Illumination Fields with Smooth Bottom Feather */
  .ambient-glow-wrapper {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
    mask-image: linear-gradient(to bottom, black 0%, black 65%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 65%, transparent 100%);
  }

  .ambient-glow-left {
    position: absolute;
    top: 15%;
    left: -10%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, rgba(0, 102, 255, 0.12) 0%, transparent 65%);
    filter: blur(80px);
  }

  .ambient-glow-right {
    position: absolute;
    top: 20%;
    right: -8%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(72, 200, 255, 0.14) 0%, rgba(0, 70, 220, 0.05) 50%, transparent 70%);
    filter: blur(90px);
  }

  .rethinking-container {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .rethinking-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: clamp(36px, 5vw, 68px);
  }

  /* ==========================================================================
     Left Column: Typography & CTAs
     ========================================================================== */
  .rethinking-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(14px, 2vh, 20px);
  }

  .eyebrow-text {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #48C8FF;
    display: inline-block;
  }

  .rethinking-title {
    font-family: var(--font-family-display);
    font-size: clamp(2.3rem, 3.8vw, 3.5rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: var(--color-text-white);
    margin: 0;
    margin-bottom: clamp(18px, 2.5vh, 24px);
    max-width: 540px;
    text-wrap: balance;
  }

  .rethinking-paragraph {
    font-size: clamp(1.02rem, 1.15vw, 1.18rem);
    line-height: 1.65;
    letter-spacing: -0.012em;
    color: var(--color-text-secondary);
    margin: 0;
    margin-bottom: clamp(28px, 4vh, 38px);
    max-width: 520px;
    text-wrap: pretty;
  }

  .rethinking-action-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .btn-primary-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: var(--font-size-btn);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
    background: 
      radial-gradient(ellipse 90% 65% at 50% 0%, rgba(255, 255, 255, 0.48) 0%, rgba(255, 255, 255, 0) 72%),
      linear-gradient(180deg, #56d3ff 0%, #30baff 48%, #0aa3f8 100%);
    border: none;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-button-primary);
    text-shadow: 0 1px 2px rgba(0, 60, 130, 0.35);
    overflow: hidden;
    cursor: pointer;
    transition: 
      transform var(--duration-fast) var(--ease-spring),
      box-shadow var(--duration-fast) var(--ease-spring);
  }

  .btn-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-content svg {
    color: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0, 20, 60, 0.4));
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .btn-glow-aurora {
    position: absolute;
    inset: -2px;
    background: radial-gradient(circle at 50% 0%, rgba(72, 200, 255, 0.8) 0%, transparent 70%);
    opacity: 0.6;
    transition: opacity var(--duration-fast);
  }

  .btn-primary-cta:hover {
    transform: translateY(-2px) scale(1.01);
    box-shadow: var(--shadow-button-hover);
  }

  .btn-primary-cta:hover .btn-glow-aurora {
    opacity: 1;
  }

  .btn-primary-cta:hover .btn-content svg {
    transform: translateX(4px);
  }

  .action-caption {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .caption-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #48C8FF;
    opacity: 0.8;
  }

  /* ==========================================================================
     Right Column: Clean Feature Image (No Frame, No Tag)
     ========================================================================== */
  .rethinking-visual-wrapper {
    position: relative;
    width: 100%;
  }

  .image-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10.75;
    border-radius: 20px;
    overflow: hidden;
    background: transparent;
    box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.75);
  }

  .rethinking-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.98) saturate(1.05);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .image-viewport:hover .rethinking-img {
    transform: scale(1.025);
    filter: brightness(1.04) saturate(1.1);
  }

  @keyframes chipPulse {
    0%, 100% { opacity: 0.6; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .chip-text {
    font-size: 0.78rem;
    font-weight: 600;
    color: #f1f5f9;
    letter-spacing: -0.01em;
  }

  /* ==========================================================================
     Responsive Breakpoints
     ========================================================================== */
  @media (max-width: 980px) {
    .rethinking-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .br-desktop {
      display: none;
    }

    .rethinking-title {
      font-size: clamp(2.2rem, 6vw, 3.2rem);
    }

    .rethinking-paragraph {
      max-width: 100%;
    }

    .rethinking-visual-wrapper {
      max-width: 680px;
      margin-inline: auto;
    }
  }

  @media (max-width: 640px) {
    .rethinking-section {
      padding-top: 48px;
      padding-bottom: 60px;
    }

    .rethinking-glass-card {
      padding: 8px;
      border-radius: 18px;
    }

    .image-viewport {
      border-radius: 12px;
    }

    .floating-glass-chip {
      bottom: 16px;
      left: 16px;
      padding: 5px 11px;
    }

    .chip-text {
      font-size: 0.72rem;
    }
  }
</style>
