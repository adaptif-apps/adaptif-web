---
// ServiceAiBanner.astro - Reusable 1-column "How Adaptif uses AI" banner for all service landing pages

export interface AiBannerItem {
  id: string;
  title?: string;
  description: string;
}

interface Props {
  id: string;
  cmsPrefix: string;
  eyebrow?: string;
  titleLead: string;
  titleHighlight: string;
  lead: string;
  image: string;
  items: AiBannerItem[];
  showCta?: boolean;
  revealAttr?: "data-br-reveal" | "data-mk-reveal" | "data-sv-reveal";
}

const {
  id,
  cmsPrefix,
  eyebrow = "How Adaptif uses AI",
  titleLead,
  titleHighlight,
  lead,
  image,
  items,
  showCta = false,
  revealAttr = "data-br-reveal",
} = Astro.props;

const revealProps =
  revealAttr === "data-mk-reveal"
    ? { "data-mk-reveal": "" }
    : revealAttr === "data-sv-reveal"
      ? { "data-sv-reveal": "" }
      : { "data-br-reveal": "" };

const titleId = `${id}-title`;
---

<section class="sv-ai-section" id={id} aria-labelledby={titleId}>
  <div class="container">
    <div class="sv-ai-banner" {...revealProps}>
      <img
        src={image}
        alt=""
        class="sv-ai-banner__bg"
        loading="eager"
        decoding="async"
        data-cms-key={`${cmsPrefix}.image`}
      />
      <div class="sv-ai-banner__scrim" aria-hidden="true"></div>

      <div class="sv-ai-banner__content">
        <p class="adaptif-eyebrow" data-cms-key={`${cmsPrefix}.eyebrow`}>
          {eyebrow}
        </p>

        <h2 id={titleId} class="sv-ai-banner__title" data-cms-key={`${cmsPrefix}.title`}>
          {titleLead} <span class="title-highlight">{titleHighlight}</span>
        </h2>

        <p class="sv-ai-banner__lead" data-cms-key={`${cmsPrefix}.lead`}>
          {lead}
        </p>

        <ul class="sv-ai-banner__list">
          {items.map((item) => (
            <li class="sv-ai-banner__item">
              <span class="sv-ai-banner__icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <div class="sv-ai-banner__item-copy">
                {item.title && (
                  <h3 class="sv-ai-banner__item-title" data-cms-key={`${cmsPrefix}.${item.id}.title`}>
                    {item.title}
                  </h3>
                )}
                <p
                  class={item.title ? "sv-ai-banner__item-desc" : "sv-ai-banner__item-text"}
                  data-cms-key={item.title ? `${cmsPrefix}.${item.id}.desc` : `${cmsPrefix}.${item.id}`}
                >
                  {item.description}
                </p>
              </div>
            </li>
          ))}
        </ul>

        {showCta && (
          <div class="sv-ai-banner__actions">
            <a
              href="#book-a-call"
              class="adaptif-btn"
              data-open-book-call
              data-cms-key={`${cmsPrefix}.cta`}
            >
              <span>Book a Call</span>
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .sv-ai-section {
    position: relative;
    padding: clamp(56px, 7vw, 96px) 0;
    background: var(--color-void);
  }

  .sv-ai-banner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(32px, 5vw, 64px);
    min-height: clamp(460px, 46vw, 580px);
    display: flex;
    align-items: center;
    background: #070b14;
    box-shadow:
      0 28px 64px -20px rgba(0, 0, 0, 0.8),
      0 0 38px -14px rgba(72, 200, 255, 0.14);
  }

  .sv-ai-banner__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    z-index: 0;
  }

  .sv-ai-banner__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(1, 3, 7, 0.94) 0%,
      rgba(1, 3, 7, 0.8) 48%,
      rgba(1, 3, 7, 0.16) 100%
    );
    pointer-events: none;
  }

  .sv-ai-banner__content {
    position: relative;
    z-index: 2;
    max-width: 580px;
  }

  .sv-ai-banner__title {
    margin: 14px 0 18px;
    font-family: var(--font-family-display);
    font-size: clamp(2.25rem, 3.8vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .sv-ai-banner__lead {
    margin: 0 0 26px;
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    line-height: 1.62;
    color: var(--color-text-secondary);
  }

  .sv-ai-banner__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sv-ai-banner__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 13px 16px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(5, 10, 20, 0.68);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .sv-ai-banner__icon {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(72, 200, 255, 0.14);
    border: 1px solid rgba(72, 200, 255, 0.36);
    color: var(--color-brand-cyan);
    margin-top: 1px;
  }

  .sv-ai-banner__item-copy {
    min-width: 0;
  }

  .sv-ai-banner__item-title {
    margin: 0 0 4px;
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .sv-ai-banner__item-desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.86rem;
    line-height: 1.48;
    color: var(--color-text-secondary);
  }

  .sv-ai-banner__item-text {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.92rem;
    line-height: 1.48;
    color: var(--color-text-primary);
  }

  .sv-ai-banner__actions {
    margin-top: 28px;
  }

  @media (max-width: 960px) {
    .sv-ai-banner__scrim {
      background: linear-gradient(
        180deg,
        rgba(1, 3, 7, 0.92) 0%,
        rgba(1, 3, 7, 0.84) 60%,
        rgba(1, 3, 7, 0.74) 100%
      );
    }
  }
</style>
