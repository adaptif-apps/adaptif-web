---
// ServicesCarousel.astro - Light Mode Horizontal Auto-scrolling Cards Carousel
// Cards: 380px x 570px, auto-scroll with pause-on-hover, initial title-only reveal tags on hover
// Header: Eyebrow "Built for simplicity", Title "Every creative need covered in one place."

interface ServiceCard {
  id: string;
  highlight: string;
  rest: string;
  tags: string[];
  image: string;
}

const serviceCards: ServiceCard[] = [
  {
    id: "card-social-media",
    highlight: "Social Media",
    rest: "Creative",
    tags: ["REELS", "POSTS", "STORIES", "CONCEPTS", "CAMPAIGNS"],
    image: "/images/services-carousel/social-media.jpg"
  },
  {
    id: "card-marketing",
    highlight: "Marketing",
    rest: "Strategy",
    tags: ["DIGITAL CHANNEL STRATEGY", "CONTENT STRATEGY DEVELOPMENT", "CAMPAIGN PLANNING", "QUICK WINS STRATEGY"],
    image: "/images/services-carousel/marketing-strategy.jpg"
  },
  {
    id: "card-website",
    highlight: "Website",
    rest: "Design",
    tags: ["LANDING PAGE DESIGN", "UX/UI AUDIT", "DESIGN SYSTEMS", "WEBSITE GRAPHICS"],
    image: "/images/services-carousel/website-design.jpg"
  },
  {
    id: "card-brand",
    highlight: "Brand",
    rest: "Identity",
    tags: ["BRAND DESIGN", "BRAND DEVELOPMENT", "LOGO DESIGN", "BRAND GUIDELINES", "STORY DEVELOPMENT", "REBRANDING"],
    image: "/images/services-carousel/brand-identity.jpg"
  },
  {
    id: "card-email",
    highlight: "Email",
    rest: "Design",
    tags: ["DESIGN & STRATEGY", "HTML5", "TEMPLATES", "NEWSLETTERS"],
    image: "/images/services-carousel/email-design.jpg"
  },
  {
    id: "card-print",
    highlight: "Print",
    rest: "Design",
    tags: ["MAGAZINE / NEWSPAPER", "EDITORIAL", "EVENT COLLATERAL", "POSTER", "STATIONERY", "BROCHURE"],
    image: "/images/services-carousel/print-design.jpg"
  },
  {
    id: "card-ad",
    highlight: "Ad",
    rest: "Creative",
    tags: ["AD DESIGN", "SOCIAL MEDIA ADS", "DISPLAY ADS", "NATIVE ADS"],
    image: "/images/services-carousel/ad-creative.jpg"
  }
];
---

<section class="services-carousel-section" id="services-carousel" data-theme="light">
  <!-- Soft Ambient Glow -->
  <div class="carousel-ambient-glow" aria-hidden="true"></div>

  <!-- Header Block (Light Mode) -->
  <div class="container carousel-header-container">
    <header class="carousel-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">Built for simplicity</span>
      </div>

      <h2 class="carousel-title">
        Every creative need covered <span class="title-highlight">in one place.</span>
      </h2>
    </header>
  </div>

  <!-- Horizontal Auto-Scrolling Viewport -->
  <div class="carousel-viewport" id="carousel-viewport">
    <!-- Unified Track: Set A + Set B for Seamless -50% Loop -->
    <div class="carousel-track" id="carousel-track">
      <!-- Set A -->
      {serviceCards.map((card) => (
        <article class="service-card" tab-index="0">
          <!-- Background Visual -->
          <div class="card-media">
            <img 
              src={card.image} 
              alt={`${card.highlight} ${card.rest}`} 
              loading="eager" 
              decoding="sync" 
              class="card-img" 
            />
            <div class="card-scrim-default"></div>
            <div class="card-scrim-hover"></div>
          </div>

          <!-- Card Content Body -->
          <div class="card-content">
            <!-- Title: Always visible -->
            <h3 class="card-title">
              <span class="title-highlight">{card.highlight}</span> {card.rest}
            </h3>

            <!-- Tags: Hidden initially, revealed on card hover -->
            <div class="card-tags-drawer">
              <div class="card-tags-inner">
                <div class="tags-divider"></div>
                <div class="tags-cloud">
                  {card.tags.map((tag) => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}

      <!-- Set B (Exact Clone for Infinite Seamless -50% Loop) -->
      {serviceCards.map((card) => (
        <article class="service-card" aria-hidden="true">
          <!-- Background Visual -->
          <div class="card-media">
            <img 
              src={card.image} 
              alt="" 
              loading="eager" 
              decoding="sync" 
              class="card-img" 
            />
            <div class="card-scrim-default"></div>
            <div class="card-scrim-hover"></div>
          </div>

          <!-- Card Content Body -->
          <div class="card-content">
            <!-- Title: Always visible -->
            <h3 class="card-title">
              <span class="title-highlight">{card.highlight}</span> {card.rest}
            </h3>

            <!-- Tags: Hidden initially, revealed on card hover -->
            <div class="card-tags-drawer">
              <div class="card-tags-inner">
                <div class="tags-divider"></div>
                <div class="tags-cloud">
                  {card.tags.map((tag) => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function initServicesCarousel() {
      const section = document.getElementById("services-carousel");
      const viewport = document.getElementById("carousel-viewport");
      const track = document.getElementById("carousel-track");
      if (!section || !viewport || !track) return;

      if (track.__servicesCarouselInitialized) return;
      track.__servicesCarouselInitialized = true;

      const cards = Array.from(track.querySelectorAll(".service-card"));
      const originalCount = Math.floor(cards.length / 2);

      let isVisible = true;
      let isPausedByHover = false;
      let activeCard = null;

      // Dragging state
      let isMouseDown = false;
      let isTouchActive = false;
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let dragStartX = 0;
      let hasMoved = false;
      let isHorizontal = false;

      let currentX = 0;
      let loopDistance = 0;

      function updateDimensions() {
        if (cards.length > originalCount && cards[originalCount]) {
          const firstOffset = cards[0].offsetLeft;
          const cloneOffset = cards[originalCount].offsetLeft;
          const dist = cloneOffset - firstOffset;
          if (dist > 0) {
            loopDistance = dist;
            return;
          }
        }
        loopDistance = (track.scrollWidth / 2) || 1;
      }

      updateDimensions();
      window.addEventListener("resize", updateDimensions);
      window.addEventListener("load", updateDimensions);

      // Section visibility via IntersectionObserver
      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              section.classList.add("is-visible");
              isVisible = true;
            } else {
              isVisible = false;
            }
          });
        },
        { threshold: 0.05, rootMargin: "60px 0px" }
      );
      observer.observe(section);

      // Smooth continuous auto-scroll ticker
      let lastTime = performance.now();
      const speedPixelsPerSecond = 55; // Silky smooth marquee speed

      function tick(now) {
        const dt = Math.min((now - lastTime) / 1000, 0.1);
        lastTime = now;

        if (loopDistance <= 1) {
          updateDimensions();
        }

        const isPaused = isPausedByHover || isDragging || isMouseDown || isTouchActive || (activeCard !== null);

        if (isVisible && !isPaused && loopDistance > 1) {
          currentX -= speedPixelsPerSecond * dt;
          while (currentX <= -loopDistance) currentX += loopDistance;
          while (currentX > 0) currentX -= loopDistance;
          track.style.transform = "translate3d(" + currentX.toFixed(2) + "px, 0, 0)";
        }

        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      // Desktop Hover Pause
      viewport.addEventListener("mouseenter", function () {
        if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
          isPausedByHover = true;
        }
      });
      viewport.addEventListener("mouseleave", function () {
        isPausedByHover = false;
      });

      // Desktop Mouse Drag
      viewport.addEventListener("mousedown", function (e) {
        if (e.button !== 0) return;
        isMouseDown = true;
        hasMoved = false;
        isDragging = false;
        startX = e.clientX;
        dragStartX = currentX;
      });

      window.addEventListener("mousemove", function (e) {
        if (!isMouseDown) return;
        const deltaX = e.clientX - startX;

        if (!hasMoved) {
          if (Math.abs(deltaX) > 4) {
            hasMoved = true;
            isDragging = true;
            viewport.classList.add("is-dragging");
          }
        }

        if (isDragging) {
          e.preventDefault();
          currentX = dragStartX + deltaX;
          if (loopDistance > 0) {
            while (currentX <= -loopDistance) currentX += loopDistance;
            while (currentX > 0) currentX -= loopDistance;
          }
          track.style.transform = "translate3d(" + currentX.toFixed(2) + "px, 0, 0)";
        }
      });

      window.addEventListener("mouseup", function () {
        if (!isMouseDown) return;
        isMouseDown = false;
        viewport.classList.remove("is-dragging");

        if (hasMoved) {
          setTimeout(function () {
            isDragging = false;
            hasMoved = false;
          }, 60);
        } else {
          isDragging = false;
        }
      });

      // Mobile Touch Drag
      viewport.addEventListener("touchstart", function (e) {
        if (e.touches.length !== 1) return;
        const touch = e.touches[0];
        startX = touch.clientX;
        startY = touch.clientY;
        dragStartX = currentX;
        hasMoved = false;
        isHorizontal = false;
        isTouchActive = true;
        isDragging = false;
      }, { passive: true });

      window.addEventListener("touchmove", function (e) {
        if (!isTouchActive || e.touches.length !== 1) return;
        const touch = e.touches[0];
        const deltaX = touch.clientX - startX;
        const deltaY = touch.clientY - startY;

        if (!hasMoved) {
          if (Math.abs(deltaX) > 6 || Math.abs(deltaY) > 6) {
            if (Math.abs(deltaX) >= Math.abs(deltaY)) {
              isHorizontal = true;
              hasMoved = true;
              isDragging = true;
              viewport.classList.add("is-dragging");
            } else {
              isTouchActive = false;
              isDragging = false;
              return;
            }
          }
        }

        if (isHorizontal && isDragging) {
          if (e.cancelable) e.preventDefault();
          currentX = dragStartX + deltaX;
          if (loopDistance > 0) {
            while (currentX <= -loopDistance) currentX += loopDistance;
            while (currentX > 0) currentX -= loopDistance;
          }
          track.style.transform = "translate3d(" + currentX.toFixed(2) + "px, 0, 0)";
        }
      }, { passive: false });

      function onTouchEnd() {
        if (!isTouchActive && !isDragging) return;
        isTouchActive = false;
        viewport.classList.remove("is-dragging");

        if (hasMoved) {
          setTimeout(function () {
            isDragging = false;
            hasMoved = false;
          }, 60);
        } else {
          isDragging = false;
        }
      }

      window.addEventListener("touchend", onTouchEnd, { passive: true });
      window.addEventListener("touchcancel", onTouchEnd, { passive: true });

      // Card Tap Toggle (Desktop and Mobile)
      cards.forEach(function (card) {
        card.addEventListener("click", function () {
          if (hasMoved || isDragging) {
            return;
          }

          const isActive = card.classList.contains("is-active");

          cards.forEach(function (c) { c.classList.remove("is-active"); });

          if (!isActive) {
            card.classList.add("is-active");
            activeCard = card;
          } else {
            activeCard = null;
          }
        });
      });

      // Tap outside cards closes active card and resumes movement
      document.addEventListener("click", function (e) {
        if (!track.contains(e.target)) {
          if (activeCard) {
            cards.forEach(function (c) { c.classList.remove("is-active"); });
            activeCard = null;
          }
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initServicesCarousel);
    } else {
      initServicesCarousel();
    }
    document.addEventListener("astro:page-load", initServicesCarousel);
  })();
</script>

<style>
  /* ==========================================================================
     LIGHT MODE SECTION CONTAINER
     ========================================================================== */
  .services-carousel-section {
    position: relative;
    width: 100%;
    padding-top: clamp(70px, 9vh, 110px);
    padding-bottom: clamp(90px, 12vh, 140px);
    background-color: #ffffff;
    color: #050811;
    overflow: hidden;
    isolation: isolate;
  }

  .carousel-ambient-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: min(1100px, 90vw);
    height: 480px;
    background: radial-gradient(ellipse at 50% 50%, rgba(2, 132, 199, 0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* ==========================================================================
     HEADER: Light Mode Typography
     ========================================================================== */
  .carousel-header-container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(36px, 5vh, 56px);
  }

  .carousel-header {
    text-align: center;
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(12px, 1.8vh, 18px);
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0284c7; /* Vibrant brand cyan-blue */
    display: inline-block;
  }

  .carousel-title {
    font-family: var(--font-family-display, sans-serif);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: #050811;
    margin: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  /* Header Title Accent for "in one place." on Light Background */
  .carousel-title .title-highlight {
    background: linear-gradient(135deg, #0070f3 0%, #0099ff 45%, #00c0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 10px rgba(0, 153, 255, 0.18));
  }

  /* Staggered entrance */
  .services-carousel-section.is-visible .eyebrow-wrapper,
  .services-carousel-section.is-visible .carousel-title {
    opacity: 1;
    transform: translateY(0);
  }

  .services-carousel-section.is-visible .carousel-viewport {
    opacity: 1;
    transform: translateY(0);
  }

  /* ==========================================================================
     CAROUSEL VIEWPORT & HORIZONTAL TRACK
     ========================================================================== */
  .carousel-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-top: 24px;
    padding-bottom: 76px;
    margin-bottom: -44px;
    touch-action: pan-y;
    cursor: grab;
    opacity: 0;
    transform: translateY(24px);
    transition: 
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  .carousel-viewport.is-dragging,
  .carousel-viewport.is-dragging * {
    cursor: grabbing !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  /* Unified track for continuous horizontal marquee */
  .carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ==========================================================================
     SERVICE CARD: 380px x 570px Exact Scale & Interactions
     ========================================================================== */
  .service-card {
    position: relative;
    width: clamp(280px, 32vw, 380px);
    height: clamp(420px, 48vw, 570px);
    margin-right: clamp(16px, 1.8vw, 24px);
    flex-shrink: 0;
    border-radius: 24px;
    overflow: hidden;
    background-color: #0b1120;
    box-shadow: 
      0 16px 36px -10px rgba(15, 23, 42, 0.12),
      0 4px 12px -2px rgba(15, 23, 42, 0.06),
      0 0 0 1px rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(22px, 2.6vw, 32px);
    cursor: pointer;
    user-select: none;
    transition: 
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Media Background */
  .card-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
    pointer-events: none;
    -webkit-user-drag: none;
    user-drag: none;
    transition: 
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s ease;
  }

  /* Default Scrim */
  .card-scrim-default {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(4, 8, 20, 0.38) 0%,
      rgba(4, 8, 20, 0.15) 30%,
      rgba(4, 8, 20, 0.55) 60%,
      rgba(2, 5, 14, 0.94) 100%
    );
    transition: opacity 0.45s ease;
  }

  /* Hover / Active Scrim: Darkens slightly from bottom to amplify tags readability */
  .card-scrim-hover {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 6, 18, 0.55) 0%,
      rgba(2, 6, 18, 0.45) 35%,
      rgba(1, 4, 12, 0.96) 78%,
      rgba(1, 3, 10, 0.99) 100%
    );
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ==========================================================================
     CARD CONTENT & TAGS DRAWER
     ========================================================================== */
  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .card-title {
    font-family: var(--font-family-display, sans-serif);
    font-size: clamp(1.75rem, 2.5vw, 2.35rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Accent Highlight inside Card (Celestial blue for dark backdrop) */
  .card-title .title-highlight {
    background: linear-gradient(135deg, #7fe2ff 0%, #48C8FF 50%, #1da5ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 12px rgba(72, 200, 255, 0.35));
  }

  /* Tags Drawer: Hidden by default, expands on desktop hover or mobile tap */
  .card-tags-drawer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: 
      grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-tags-inner {
    overflow: hidden;
  }

  .tags-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(72, 200, 255, 0.4) 0%, rgba(255, 255, 255, 0.1) 100%);
    margin-top: 16px;
    margin-bottom: 14px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.05s;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding-bottom: 4px;
    transform: translateY(14px);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
  }

  /* ==========================================================================
     ACTIVE STATE (Controlled by explicit tap/click toggle on mobile & desktop)
     ========================================================================== */
  .service-card.is-active {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 
      0 28px 56px -12px rgba(15, 23, 42, 0.2),
      0 10px 20px -4px rgba(15, 23, 42, 0.1),
      0 0 0 1px rgba(2, 132, 199, 0.35);
  }

  .service-card.is-active .card-img {
    transform: scale(1.08);
    filter: brightness(0.92);
  }

  .service-card.is-active .card-scrim-hover {
    opacity: 1;
  }

  .service-card.is-active .card-tags-drawer {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .service-card.is-active .tags-divider {
    transform: scaleX(1);
  }

  .service-card.is-active .tags-cloud {
    transform: translateY(0);
  }

  /* ==========================================================================
     DESKTOP HOVER ONLY (Disabled on mobile / touch devices)
     ========================================================================== */
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      transform: translateY(-8px) scale(1.01);
      box-shadow: 
        0 28px 56px -12px rgba(15, 23, 42, 0.2),
        0 10px 20px -4px rgba(15, 23, 42, 0.1),
        0 0 0 1px rgba(2, 132, 199, 0.35);
    }

    .service-card:hover .card-img {
      transform: scale(1.08);
      filter: brightness(0.92);
    }

    .service-card:hover .card-scrim-hover {
      opacity: 1;
    }

    .service-card:hover .card-tags-drawer {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .service-card:hover .tags-divider {
      transform: scaleX(1);
    }

    .service-card:hover .tags-cloud {
      transform: translateY(0);
    }

    .tag-chip:hover {
      background: rgba(72, 200, 255, 0.22);
      border-color: rgba(72, 200, 255, 0.5);
      color: #ffffff;
    }
  }

  .tag-chip {
    display: inline-block;
    padding: 5px 11px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: 
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .tag-chip:hover {
    background: rgba(72, 200, 255, 0.22);
    border-color: rgba(72, 200, 255, 0.5);
    color: #ffffff;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS
     ========================================================================== */
  @media (max-width: 768px) {
    .services-carousel-section {
      padding-top: 50px;
      padding-bottom: 70px;
    }

