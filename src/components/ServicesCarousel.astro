---
// ServicesCarousel.astro - Light Mode Horizontal Auto-scrolling Cards Carousel
// Cards: 380px x 570px, auto-scroll with pause-on-hover, initial title-only reveal tags on hover
// Header: Eyebrow "Built for simplicity", Title "Every creative need covered in one place."

interface ServiceCard {
  id: string;
  highlight: string;
  rest: string;
  tags: string[];
  image: string;
}

const serviceCards: ServiceCard[] = [
  {
    id: "card-social-media",
    highlight: "Social Media",
    rest: "Creative",
    tags: ["REELS", "POSTS", "STORIES", "CONCEPTS", "CAMPAIGNS"],
    image: "/header_images/work-3.jpg"
  },
  {
    id: "card-marketing",
    highlight: "Marketing",
    rest: "Strategy",
    tags: ["DIGITAL CHANNEL STRATEGY", "CONTENT STRATEGY DEVELOPMENT", "CAMPAIGN PLANNING", "QUICK WINS STRATEGY"],
    image: "/images/designed-to-keep-up/card-1-deadlines.jpg"
  },
  {
    id: "card-website",
    highlight: "Website",
    rest: "Design",
    tags: ["LANDING PAGE DESIGN", "UX/UI AUDIT", "DESIGN SYSTEMS", "WEBSITE GRAPHICS"],
    image: "/header_images/work-1.jpg"
  },
  {
    id: "card-brand",
    highlight: "Brand",
    rest: "Identity",
    tags: ["BRAND DESIGN", "BRAND DEVELOPMENT", "LOGO DESIGN", "BRAND GUIDELINES", "STORY DEVELOPMENT", "REBRANDING"],
    image: "/images/why-us/creative-talent.jpg"
  },
  {
    id: "card-email",
    highlight: "Email",
    rest: "Design",
    tags: ["DESIGN & STRATEGY", "HTML5", "TEMPLATES", "NEWSLETTERS"],
    image: "/images/designed-to-keep-up/card-3-plan.jpg"
  },
  {
    id: "card-print",
    highlight: "Print",
    rest: "Design",
    tags: ["MAGAZINE / NEWSPAPER", "EDITORIAL", "EVENT COLLATERAL", "POSTER", "STATIONERY", "BROCHURE"],
    image: "/header_images/work-5.jpg"
  },
  {
    id: "card-ad",
    highlight: "Ad",
    rest: "Creative",
    tags: ["AD DESIGN", "SOCIAL MEDIA ADS", "DISPLAY ADS", "NATIVE ADS"],
    image: "/header_images/work-0.jpg"
  }
];
---

<section class="services-carousel-section" id="services-carousel" data-theme="light">
  <!-- Soft Ambient Glow -->
  <div class="carousel-ambient-glow" aria-hidden="true"></div>

  <!-- Header Block (Light Mode) -->
  <div class="container carousel-header-container">
    <header class="carousel-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">Built for simplicity</span>
      </div>

      <h2 class="carousel-title">
        Every creative need covered <span class="title-highlight">in one place.</span>
      </h2>
    </header>
  </div>

  <!-- Horizontal Auto-Scrolling Viewport with Edge Fade Masks -->
  <div class="carousel-viewport" id="carousel-viewport">
    <div class="carousel-mask-edge mask-left" aria-hidden="true"></div>
    <div class="carousel-mask-edge mask-right" aria-hidden="true"></div>

    <!-- Unified Track: Set A + Set B for Seamless -50% Loop -->
    <div class="carousel-track" id="carousel-track">
      <!-- Set A -->
      {serviceCards.map((card) => (
        <article class="service-card" tab-index="0">
          <!-- Background Visual -->
          <div class="card-media">
            <img 
              src={card.image} 
              alt={`${card.highlight} ${card.rest}`} 
              loading="eager" 
              decoding="sync" 
              class="card-img" 
            />
            <div class="card-scrim-default"></div>
            <div class="card-scrim-hover"></div>
          </div>

          <!-- Card Content Body -->
          <div class="card-content">
            <!-- Title: Always visible -->
            <h3 class="card-title">
              <span class="title-highlight">{card.highlight}</span> {card.rest}
            </h3>

            <!-- Tags: Hidden initially, revealed on card hover -->
            <div class="card-tags-drawer">
              <div class="card-tags-inner">
                <div class="tags-divider"></div>
                <div class="tags-cloud">
                  {card.tags.map((tag) => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}

      <!-- Set B (Exact Clone for Infinite Seamless -50% Loop) -->
      {serviceCards.map((card) => (
        <article class="service-card" aria-hidden="true">
          <!-- Background Visual -->
          <div class="card-media">
            <img 
              src={card.image} 
              alt="" 
              loading="eager" 
              decoding="sync" 
              class="card-img" 
            />
            <div class="card-scrim-default"></div>
            <div class="card-scrim-hover"></div>
          </div>

          <!-- Card Content Body -->
          <div class="card-content">
            <!-- Title: Always visible -->
            <h3 class="card-title">
              <span class="title-highlight">{card.highlight}</span> {card.rest}
            </h3>

            <!-- Tags: Hidden initially, revealed on card hover -->
            <div class="card-tags-drawer">
              <div class="card-tags-inner">
                <div class="tags-divider"></div>
                <div class="tags-cloud">
                  {card.tags.map((tag) => (
                    <span class="tag-chip">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function initServicesCarousel() {
    const section = document.getElementById("services-carousel");
    const viewport = document.getElementById("carousel-viewport");
    const track = document.getElementById("carousel-track");
    if (!section || !viewport || !track) return;

    // Prevent duplicate initialization on Astro page loads
    if ((track as any).__servicesCarouselInitialized) return;
    (track as any).__servicesCarouselInitialized = true;

    let isVisible = false;
    let isHovered = false;
    let isDragging = false;
    let isMouseDown = false;
    let activeCard: HTMLElement | null = null;

    let currentX = 0;
    const speed = 0.85; // smooth ~60fps auto-scroll speed
    let animationFrameId: number | null = null;
    let halfWidth = track.scrollWidth / 2;

    function updateHalfWidth() {
      const totalWidth = track.scrollWidth;
      if (totalWidth > 0) {
        halfWidth = totalWidth / 2;
      }
    }

    // Touch & Mouse Drag variables
    let startX = 0;
    let startY = 0;
    let dragStartX = 0;
    let hasMoved = false;
    let isHorizontalGesture = false;

    // Viewport Intersection Observer for Staggered Entrance & CPU optimization
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add("is-visible");
            isVisible = true;
            updateHalfWidth();
            startLoop();
          } else {
            isVisible = false;
            stopLoop();
          }
        });
      },
      { threshold: 0.05, rootMargin: "0px 0px -40px 0px" }
    );
    observer.observe(section);

    function tick() {
      if (!isVisible) return;

      const shouldPause = isHovered || isDragging || activeCard !== null;

      if (!shouldPause) {
        currentX -= speed;
        if (halfWidth > 0) {
          while (currentX <= -halfWidth) currentX += halfWidth;
          while (currentX > 0) currentX -= halfWidth;
        }
        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
      }

      animationFrameId = requestAnimationFrame(tick);
    }

    function startLoop() {
      if (!animationFrameId) {
        animationFrameId = requestAnimationFrame(tick);
      }
    }

    function stopLoop() {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    }

    // Desktop hover pause
    viewport.addEventListener("mouseenter", () => {
      // Only pause on hover if device has fine pointer (mouse), not touch
      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        isHovered = true;
      }
    });

    viewport.addEventListener("mouseleave", () => {
      isHovered = false;
    });

    // Touch Drag & Tap Handlers for Mobile
    function onTouchStart(e: TouchEvent) {
      if (e.touches.length !== 1) return;
      const touch = e.touches[0];
      startX = touch.clientX;
      startY = touch.clientY;
      dragStartX = currentX;
      hasMoved = false;
      isHorizontalGesture = false;
      isDragging = true;
      updateHalfWidth();
    }

    function onTouchMove(e: TouchEvent) {
      if (!isDragging || e.touches.length !== 1) return;
      const touch = e.touches[0];
      const deltaX = touch.clientX - startX;
      const deltaY = touch.clientY - startY;

      // Determine gesture direction on initial movement
      if (!hasMoved) {
        if (Math.abs(deltaX) > 6 || Math.abs(deltaY) > 6) {
          if (Math.abs(deltaX) >= Math.abs(deltaY)) {
            isHorizontalGesture = true;
            hasMoved = true;
            viewport.classList.add("is-dragging");
          } else {
            // User is scrolling vertically down the page
            isDragging = false;
            return;
          }
        }
      }

      if (isHorizontalGesture) {
        // Prevent vertical page scroll while actively dragging carousel horizontally
        if (e.cancelable) e.preventDefault();

        currentX = dragStartX + deltaX;
        if (halfWidth > 0) {
          while (currentX <= -halfWidth) currentX += halfWidth;
          while (currentX > 0) currentX -= halfWidth;
        }
        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
      }
    }

    function onTouchEnd() {
      isDragging = false;
      viewport.classList.remove("is-dragging");
    }

    viewport.addEventListener("touchstart", onTouchStart, { passive: true });
    window.addEventListener("touchmove", onTouchMove, { passive: false });
    window.addEventListener("touchend", onTouchEnd, { passive: true });
    window.addEventListener("touchcancel", onTouchEnd, { passive: true });

    // Desktop Mouse Drag support
    viewport.addEventListener("mousedown", (e: MouseEvent) => {
      if (e.button !== 0) return; // Left click only
      isMouseDown = true;
      startX = e.clientX;
      dragStartX = currentX;
      hasMoved = false;
      updateHalfWidth();
    });

    window.addEventListener("mousemove", (e: MouseEvent) => {
      if (!isMouseDown) return;
      const deltaX = e.clientX - startX;
      if (Math.abs(deltaX) > 5) {
        hasMoved = true;
        isDragging = true;
        viewport.classList.add("is-dragging");
        currentX = dragStartX + deltaX;
        if (halfWidth > 0) {
          while (currentX <= -halfWidth) currentX += halfWidth;
          while (currentX > 0) currentX -= halfWidth;
        }
        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
      }
    });

    window.addEventListener("mouseup", () => {
      if (isMouseDown) {
        isMouseDown = false;
        viewport.classList.remove("is-dragging");
        setTimeout(() => {
          isDragging = false;
        }, 50);
      }
    });

    // Card Tap / Click: toggle active description and pause/resume
    const cards = track.querySelectorAll<HTMLElement>(".service-card");
    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        // If it was a drag gesture, do not toggle
        if (hasMoved) {
          hasMoved = false;
          return;
        }

        const isCurrentlyActive = card.classList.contains("is-active");

        // Close any currently active card
        cards.forEach((c) => c.classList.remove("is-active"));

        if (!isCurrentlyActive) {
          // Open this card and pause
          card.classList.add("is-active");
          activeCard = card;
        } else {
          // Re-tap closes the card and resumes movement!
          activeCard = null;
        }
      });
    });

    // Tapping outside cards closes any active card and resumes movement
    document.addEventListener("click", (e) => {
      if (!track.contains(e.target as Node)) {
        if (activeCard) {
          cards.forEach((c) => c.classList.remove("is-active"));
          activeCard = null;
        }
      }
    });

    // Window resize
    window.addEventListener("resize", () => {
      updateHalfWidth();
    });

    // Initial measurement
    updateHalfWidth();
    startLoop();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initServicesCarousel);
  } else {
    initServicesCarousel();
  }

  document.addEventListener("astro:page-load", initServicesCarousel);
</script>

<style>
  /* ==========================================================================
     LIGHT MODE SECTION CONTAINER
     ========================================================================== */
  .services-carousel-section {
    position: relative;
    width: 100%;
    padding-top: clamp(70px, 9vh, 110px);
    padding-bottom: clamp(90px, 12vh, 140px);
    background-color: #ffffff;
    color: #050811;
    overflow: hidden;
    isolation: isolate;
  }

  .carousel-ambient-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: min(1100px, 90vw);
    height: 480px;
    background: radial-gradient(ellipse at 50% 50%, rgba(2, 132, 199, 0.05) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* ==========================================================================
     HEADER: Light Mode Typography
     ========================================================================== */
  .carousel-header-container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(36px, 5vh, 56px);
  }

  .carousel-header {
    text-align: center;
    max-width: 860px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(12px, 1.8vh, 18px);
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0284c7; /* Vibrant brand cyan-blue */
    display: inline-block;
  }

  .carousel-title {
    font-family: var(--font-family-display, sans-serif);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: #050811;
    margin: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  /* Header Title Accent for "in one place." on Light Background */
  .carousel-title .title-highlight {
    background: linear-gradient(135deg, #0070f3 0%, #0099ff 45%, #00c0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 10px rgba(0, 153, 255, 0.18));
  }

  /* Staggered entrance */
  .services-carousel-section.is-visible .eyebrow-wrapper,
  .services-carousel-section.is-visible .carousel-title {
    opacity: 1;
    transform: translateY(0);
  }

  .services-carousel-section.is-visible .carousel-viewport {
    opacity: 1;
    transform: translateY(0);
  }

  /* ==========================================================================
     CAROUSEL VIEWPORT & HORIZONTAL TRACK
     ========================================================================== */
  .carousel-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-top: 24px;
    padding-bottom: 76px;
    margin-bottom: -44px;
    touch-action: pan-y;
    cursor: grab;
    opacity: 0;
    transform: translateY(24px);
    transition: 
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  .carousel-viewport.is-dragging {
    cursor: grabbing;
  }

  /* Left and Right Edge Fade Masks */
  .carousel-mask-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(40px, 8vw, 140px);
    z-index: 10;
    pointer-events: none;
  }

  .mask-left {
    left: 0;
    background: linear-gradient(to right, #ffffff 0%, rgba(255, 255, 255, 0.9) 30%, rgba(255, 255, 255, 0) 100%);
  }

  .mask-right {
    right: 0;
    background: linear-gradient(to left, #ffffff 0%, rgba(255, 255, 255, 0.9) 30%, rgba(255, 255, 255, 0) 100%);
  }

  /* Unified track for continuous horizontal marquee */
  .carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  /* ==========================================================================
     SERVICE CARD: 380px x 570px Exact Scale & Interactions
     ========================================================================== */
  .service-card {
    position: relative;
    width: clamp(280px, 32vw, 380px);
    height: clamp(420px, 48vw, 570px);
    margin-right: clamp(16px, 1.8vw, 24px);
    flex-shrink: 0;
    border-radius: 24px;
    overflow: hidden;
    background-color: #0b1120;
    box-shadow: 
      0 16px 36px -10px rgba(15, 23, 42, 0.12),
      0 4px 12px -2px rgba(15, 23, 42, 0.06),
      0 0 0 1px rgba(15, 23, 42, 0.08);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(22px, 2.6vw, 32px);
    cursor: pointer;
    user-select: none;
    transition: 
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Media Background */
  .card-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
    transition: 
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.5s ease;
  }

  /* Default Scrim */
  .card-scrim-default {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(4, 8, 20, 0.38) 0%,
      rgba(4, 8, 20, 0.15) 30%,
      rgba(4, 8, 20, 0.55) 60%,
      rgba(2, 5, 14, 0.94) 100%
    );
    transition: opacity 0.45s ease;
  }

  /* Hover / Active Scrim: Darkens slightly from bottom to amplify tags readability */
  .card-scrim-hover {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 6, 18, 0.55) 0%,
      rgba(2, 6, 18, 0.45) 35%,
      rgba(1, 4, 12, 0.96) 78%,
      rgba(1, 3, 10, 0.99) 100%
    );
    opacity: 0;
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ==========================================================================
     CARD CONTENT & TAGS DRAWER
     ========================================================================== */
  .card-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .card-title {
    font-family: var(--font-family-display, sans-serif);
    font-size: clamp(1.75rem, 2.5vw, 2.35rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Accent Highlight inside Card (Celestial blue for dark backdrop) */
  .card-title .title-highlight {
    background: linear-gradient(135deg, #7fe2ff 0%, #48C8FF 50%, #1da5ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 12px rgba(72, 200, 255, 0.35));
  }

  /* Tags Drawer: Hidden by default, expands on desktop hover or mobile tap */
  .card-tags-drawer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: 
      grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-tags-inner {
    overflow: hidden;
  }

  .tags-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(72, 200, 255, 0.4) 0%, rgba(255, 255, 255, 0.1) 100%);
    margin-top: 16px;
    margin-bottom: 14px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.05s;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    padding-bottom: 4px;
    transform: translateY(14px);
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1) 0.08s;
  }

  /* ==========================================================================
     ACTIVE STATE (Controlled by explicit tap/click toggle on mobile & desktop)
     ========================================================================== */
  .service-card.is-active {
    transform: translateY(-8px) scale(1.01);
    box-shadow: 
      0 28px 56px -12px rgba(15, 23, 42, 0.2),
      0 10px 20px -4px rgba(15, 23, 42, 0.1),
      0 0 0 1px rgba(2, 132, 199, 0.35);
  }

  .service-card.is-active .card-img {
    transform: scale(1.08);
    filter: brightness(0.92);
  }

  .service-card.is-active .card-scrim-hover {
    opacity: 1;
  }

  .service-card.is-active .card-tags-drawer {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .service-card.is-active .tags-divider {
    transform: scaleX(1);
  }

  .service-card.is-active .tags-cloud {
    transform: translateY(0);
  }

  /* ==========================================================================
     DESKTOP HOVER ONLY (Disabled on mobile / touch devices)
     ========================================================================== */
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      transform: translateY(-8px) scale(1.01);
      box-shadow: 
        0 28px 56px -12px rgba(15, 23, 42, 0.2),
        0 10px 20px -4px rgba(15, 23, 42, 0.1),
        0 0 0 1px rgba(2, 132, 199, 0.35);
    }

    .service-card:hover .card-img {
      transform: scale(1.08);
      filter: brightness(0.92);
    }

    .service-card:hover .card-scrim-hover {
      opacity: 1;
    }

    .service-card:hover .card-tags-drawer {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .service-card:hover .tags-divider {
      transform: scaleX(1);
    }

    .service-card:hover .tags-cloud {
      transform: translateY(0);
    }

    .tag-chip:hover {
      background: rgba(72, 200, 255, 0.22);
      border-color: rgba(72, 200, 255, 0.5);
      color: #ffffff;
    }
  }

  .tag-chip {
    display: inline-block;
    padding: 5px 11px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: 
      background 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
