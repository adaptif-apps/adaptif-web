---
// ServicesHero.astro - Full-bleed Hero for /services
---

<section class="sv-hero" id="services-hero" aria-labelledby="sv-hero-title">
  <div class="sv-hero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/services/hero-mobile.jpg" />
      <img
        src="/images/services/hero-desktop.jpg"
        alt=""
        class="sv-hero__bg"
        loading="eager"
        decoding="async"
        data-cms-key="services.hero.image"
      />
    </picture>
    <div class="sv-hero__scrim"></div>
    <div class="sv-hero__bottom-fade"></div>
  </div>

  <div class="container sv-hero__container">
    <div class="sv-hero__content">
      <p
        class="adaptif-eyebrow"
        data-cms-key="services.hero.eyebrow"
      >
        Creative services
      </p>

      <h1
        id="sv-hero-title"
        class="sv-hero__title"
        data-cms-key="services.hero.title"
      >
        Design services <span class="title-highlight">for ambitious brands</span>
      </h1>

      <p
        class="sv-hero__description"
        data-cms-key="services.hero.description"
      >
        Teams at fast-growing companies use Adaptif to get quality graphic design done at scale. Book a call today and get access to your dedicated design team.
      </p>

      <div class="sv-hero__actions">
        <a
          href="#book-a-call"
          class="adaptif-btn"
          data-open-book-call
          data-cms-key="services.hero.cta"
        >
          <span>Book a Call</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .sv-hero {
    position: relative;
    width: 100%;
    min-height: 92vh;
    min-height: 92dvh;
    display: flex;
    align-items: center;
    padding: clamp(120px, 15vh, 170px) 0 clamp(80px, 11vh, 120px);
    overflow: hidden;
    background-color: var(--color-void);
  }

  .sv-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sv-hero__media picture {
    display: contents;
  }

  .sv-hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    opacity: 0.92;
  }

  .sv-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.88) 0%, rgba(1, 3, 7, 0.56) 48%, rgba(1, 3, 7, 0.14) 100%),
      radial-gradient(ellipse 60% 55% at 22% 45%, rgba(72, 200, 255, 0.1) 0%, transparent 70%);
  }

  .sv-hero__bottom-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 160px;
    background: linear-gradient(180deg, transparent 0%, var(--color-void) 100%);
  }

  .sv-hero__container {
    position: relative;
    z-index: 2;
  }

  .sv-hero__content {
    max-width: 640px;
  }

  .sv-hero__title {
    margin: 16px 0 22px;
    font-family: var(--font-family-display);
    font-size: clamp(2.9rem, 5.6vw, 4.65rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .sv-hero__description {
    max-width: 530px;
    margin: 0 0 34px;
    font-family: var(--font-family-body);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .sv-hero__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .sv-hero {
      min-height: 82vh;
      min-height: 82dvh;
      align-items: flex-start;
      padding: 128px 0 88px;
    }

    .sv-hero__bg {
      object-position: center 65%;
    }

    .sv-hero__scrim {
      background:
        linear-gradient(180deg, rgba(1, 3, 7, 0.84) 0%, rgba(1, 3, 7, 0.56) 55%, rgba(1, 3, 7, 0.88) 100%);
    }
  }
</style>
