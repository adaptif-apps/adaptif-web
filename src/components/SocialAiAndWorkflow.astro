---
// SocialAiAndWorkflow.astro - Shared ServiceAiBanner + 5-step workflow + Creative power banner + Related articles
import ServiceAiBanner from "./ServiceAiBanner.astro";

const aiItems = [
  {
    id: "imagery",
    title: "Brand-built imagery",
    description:
      "Skip the stock library. Create a limitless supply of visuals designed around your brand.",
  },
  {
    id: "experimentation",
    title: "Better experimentation",
    description:
      "Produce more test-ready variations based on the copy and imagery that already perform.",
  },
  {
    id: "production",
    title: "Production, accelerated",
    description:
      "Streamline production from rapid storyboards to AI-generated voiceovers.",
  },
  {
    id: "motion",
    title: "Motion, simplified",
    description:
      "Bring static assets to life with AI-powered movement that earns more attention.",
  },
];

const steps = [
  {
    num: "1",
    title: "Simple pricing",
    desc: "Transparent subscription pricing means you have full control over where your budget is going across different teams and projects.",
  },
  {
    num: "2",
    title: "Social experts",
    desc: "Our creative team is fully versed in the formats, channels, and strategies you need to reach your organic and paid goals.",
  },
  {
    num: "3",
    title: "Flexible capacity",
    desc: "Whether you’re planning something big or need to act fast, our flexible capacity lets you add scale when you need it or roll over budget when you don’t.",
  },
  {
    num: "4",
    title: "Seamless platform",
    desc: "Brief, approve, and store your project assets in one place. Our creative project management platform seamlessly integrates with Slack, Asana, Monday.com, and Jira.",
  },
  {
    num: "5",
    title: "Smooth delivery",
    desc: "Your Creative Leads ensure every asset is on-brand and on-strategy, even when you need it fast. We’re always looking for workflow efficiencies to save you time and money.",
  },
];

const articles = [
  {
    id: "art1",
    category: "Creative Leadership",
    readTime: "8 min read",
    title: "6 AI applications that actually save time (with real examples)",
    excerpt:
      "Creative teams don’t need more AI hype. They need practical, proven applications and real results.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
  {
    id: "art2",
    category: "Social Strategy",
    readTime: "6 min read",
    title: "Why native-first creative outperforms repurposed assets on TikTok and Meta",
    excerpt:
      "Platform-specific framing, hooks, and pacing drive higher thumb-stop rates and lower CPMs.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
  {
    id: "art3",
    category: "Motion & Video",
    readTime: "7 min read",
    title: "Adding motion graphics to static social posts for 55% more engagement",
    excerpt:
      "Simple kinetic typography and micro-animations turn everyday social calendars into scroll-stoppers.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
  {
    id: "art4",
    category: "Creative Ops",
    readTime: "5 min read",
    title: "How fast-moving brands keep social calendars full without creative burnout",
    excerpt:
      "Pair an always-on creative pod with modular templates to ship daily across every channel.",
    author: "Tessa",
    role: "Sr. Content Marketing Manager",
    href: "/blog",
  },
];
---

<!-- 1. How Adaptif uses AI (shared 1-col banner template) -->
<ServiceAiBanner
  id="social-ai"
  cmsPrefix="social.ai"
  titleLead="More original content"
  titleHighlight="at social speed"
  lead="From quicker iterations to sharper testing, our specialists use AI-enabled workflows to help you move faster while keeping quality and brand alignment intact."
  image="/images/social-media-creative/ai-banner.jpg"
  items={aiItems}
  showCta={true}
  revealAttr="data-sm-reveal"
/>

<!-- 2. How we work (5 steps) -->
<section class="sm-work" id="social-workflow" aria-labelledby="sm-work-title">
  <div class="container sm-work__grid">
    <div class="sm-work__intro" data-sm-reveal>
      <p class="adaptif-eyebrow" data-cms-key="social.workflow.eyebrow">
        How we work
      </p>
      <h2 id="sm-work-title" class="sm-work__title" data-cms-key="social.workflow.title">
        Scale social output <span class="title-highlight">without losing control</span>
      </h2>
      <p class="sm-work__subtitle" data-cms-key="social.workflow.subtitle">
        Our creative experts and AI-accelerated workflows help you get social campaigns to market fast, without sacrificing coherence or brand consistency.
      </p>
    </div>

    <ol class="sm-work__steps">
      {steps.map((step, idx) => (
        <li class="sm-step" data-sm-reveal style={`--sm-delay: ${idx * 55}ms`}>
          <span class="sm-step__num" aria-hidden="true">{step.num}</span>
          <div class="sm-step__body">
            <h3 class="sm-step__title" data-cms-key={`social.workflow.step${step.num}.title`}>
              {step.title}
            </h3>
            <p class="sm-step__desc" data-cms-key={`social.workflow.step${step.num}.desc`}>
              {step.desc}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 3. Creative power banner -->
<section class="sm-power" id="social-creative-power" aria-labelledby="sm-power-title">
  <div class="sm-power__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/branding/creative-power-mobile.jpg" />
      <img
        src="/images/branding/creative-power-desktop.jpg"
        alt=""
        class="sm-power__bg"
        loading="lazy"
        decoding="async"
        data-cms-key="social.power.image"
      />
    </picture>
    <div class="sm-power__scrim"></div>
  </div>

  <div class="container sm-power__container">
    <div class="sm-power__content" data-sm-reveal>
      <h2 id="sm-power-title" class="sm-power__title" data-cms-key="social.power.title">
        Now imagine this <span class="title-highlight">creative power</span> behind your next project
      </h2>
      <p class="sm-power__desc" data-cms-key="social.power.desc">
        This is just one of many creative services—what you do with them is up to you. Let’s chat.
      </p>
      <a
        href="#book-a-call"
        class="adaptif-btn"
        data-open-book-call
        data-cms-key="social.power.cta"
      >
        <span>Book a Call</span>
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- 4. Related articles -->
<section class="sm-articles" id="social-articles" aria-labelledby="sm-articles-title">
  <div class="container">
    <header class="sm-articles__header" data-sm-reveal>
      <p class="adaptif-eyebrow" data-cms-key="social.articles.eyebrow">
        Related articles
      </p>
      <h2 id="sm-articles-title" class="sm-articles__title" data-cms-key="social.articles.title">
        What <span class="title-highlight">social-at-scale</span> looks like for real teams
      </h2>
    </header>

    <div class="sm-articles__grid">
      {articles.map((art, idx) => (
        <a
          href={art.href}
          class="sm-article-card"
          data-sm-reveal
          style={`--sm-delay: ${idx * 65}ms`}
        >
          <div class="sm-article-card__media">
            <img
              src="/images/branding/article-cover.jpg"
              alt={art.title}
              class="sm-article-card__img"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="sm-article-card__body">
            <p class="sm-article-card__meta">
              <span>{art.category}</span>
              <span aria-hidden="true">•</span>
              <span>{art.readTime}</span>
            </p>
            <h3 class="sm-article-card__title" data-cms-key={`social.articles.${art.id}.title`}>
              {art.title}
            </h3>
            <p class="sm-article-card__excerpt" data-cms-key={`social.articles.${art.id}.excerpt`}>
              {art.excerpt}
            </p>

            <div class="sm-article-card__author">
              <img
                src="/images/branding/author-tessa.jpg"
                alt={art.author}
                class="sm-article-card__avatar"
                loading="lazy"
                decoding="async"
              />
              <div>
                <span class="sm-article-card__author-name">{art.author}</span>
                <span class="sm-article-card__author-role">{art.role}</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .sm-work {
    padding: clamp(64px, 8.5vw, 112px) 0;
    background: var(--color-void);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .sm-work__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }

  .sm-work__intro {
    position: sticky;
    top: 112px;
  }

  .sm-work__title {
    margin: 14px 0 18px;
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.1vw, 3.35rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .sm-work__subtitle {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    line-height: 1.62;
    color: var(--color-text-secondary);
  }

  .sm-work__steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sm-step {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 18px;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
  }

  .sm-step:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  }

  .sm-step__num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-body);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-brand-cyan);
    background: rgba(72, 200, 255, 0.1);
    border: 1px solid rgba(72, 200, 255, 0.35);
    margin-top: 2px;
  }

  .sm-step__title {
    margin: 0 0 8px;
    font-family: var(--font-family-body);
    font-size: 1.12rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .sm-step__desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Power banner */
  .sm-power {
    position: relative;
    min-height: clamp(380px, 44vw, 520px);
    display: flex;
    align-items: center;
    padding: clamp(64px, 8vw, 100px) 0;
    overflow: hidden;
    background: var(--color-void);
  }

  .sm-power__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sm-power__media picture {
    display: contents;
  }

  .sm-power__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .sm-power__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(1, 3, 7, 0.9) 0%,
      rgba(1, 3, 7, 0.65) 48%,
      rgba(1, 3, 7, 0.14) 100%
    );
  }

  .sm-power__container {
    position: relative;
    z-index: 2;
  }

  .sm-power__content {
    max-width: 560px;
  }

  .sm-power__title {
    margin: 0 0 16px;
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.3vw, 3.5rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .sm-power__desc {
    margin: 0 0 28px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Related articles */
  .sm-articles {
    padding: clamp(68px, 8.5vw, 112px) 0;
    background: var(--color-void);
  }

  .sm-articles__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(36px, 5vw, 52px);
  }

  .sm-articles__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .sm-articles__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .sm-article-card {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.025);
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
  }

  .sm-article-card:hover {
    transform: translateY(-4px);
    border-color: rgba(72, 200, 255, 0.35);
  }

  .sm-article-card__media {
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .sm-article-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s ease;
  }

  .sm-article-card:hover .sm-article-card__img {
    transform: scale(1.04);
  }

  .sm-article-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 18px;
  }

  .sm-article-card__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 10px;
    font-family: var(--font-family-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-brand-cyan);
  }

  .sm-article-card__title {
    margin: 0 0 10px;
    font-family: var(--font-family-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-primary);
  }

  .sm-article-card__excerpt {
    margin: 0 0 18px;
    font-family: var(--font-family-body);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .sm-article-card__author {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sm-article-card__avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .sm-article-card__author-name {
    display: block;
    font-family: var(--font-family-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .sm-article-card__author-role {
    display: block;
    font-family: var(--font-family-body);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1100px) {
    .sm-articles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .sm-work__grid {
      grid-template-columns: 1fr;
    }

    .sm-work__intro {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .sm-power__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.86) 0%, rgba(1, 3, 7, 0.65) 55%, rgba(1, 3, 7, 0.9) 100%);
    }
  }

  @media (max-width: 600px) {
    .sm-articles__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
