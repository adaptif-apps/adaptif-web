---
import type { AcademyItem, AcademySettings } from "../lib/academyDb";

interface Props {
  initialItems: AcademyItem[];
  initialSettings: AcademySettings;
}

const { initialItems, initialSettings } = Astro.props;
---

<div id="module-academy" hidden>
  <header class="studio-header">
    <div>
      <p class="studio-eyebrow">Academy CMS</p>
      <h1 class="studio-title">Courses &amp; <span>Guides</span></h1>
    </div>
    <div class="studio-header-actions">
      <button type="button" class="btn-secondary" id="btn-new-guide">+ New Guide</button>
      <button type="button" class="btn-primary" id="btn-new-course">+ New Course</button>
    </div>
  </header>

  <!-- Access & Stripe Preferences -->
  <section class="bc-cms-card acd-prefs-card" aria-label="Course Access & Stripe Preferences">
    <div class="acd-prefs-head">
      <div>
        <h2 class="acd-card-title">Course Access &amp; Stripe Preferences</h2>
        <p class="acd-card-sub">
          Configure how paid courses unlock after checkout. Paste individual Stripe Payment Links on each course below.
        </p>
      </div>
      <button type="button" class="btn-primary" id="btn-save-acd-settings">Save Preferences</button>
    </div>

    <div class="acd-prefs-grid">
      <label class="acd-field">
        <span>Default Course Access Mode</span>
        <select id="acd-default-access-mode">
          <option value="stripe_webhook" selected={initialSettings.defaultCourseAccessMode === "stripe_webhook"}>
            Option A: Stripe Webhook + Secure Token (Recommended)
          </option>
          <option value="checkout_redirect" selected={initialSettings.defaultCourseAccessMode === "checkout_redirect"}>
            Simple Checkout Redirect (?checkout=success)
          </option>
          <option value="open" selected={initialSettings.defaultCourseAccessMode === "open"}>
            Open Access (No Gate)
          </option>
        </select>
      </label>

      <label class="acd-field">
        <span>Stripe Webhook Secret (whsec_...)</span>
        <input
          type="password"
          id="acd-stripe-secret"
          placeholder={initialSettings.hasStripeWebhookSecret ? "Saved (leave blank to keep)" : "whsec_..."}
        />
      </label>

      <div class="acd-field">
        <span>Stripe Webhook Endpoint</span>
        <div class="acd-copy-row">
          <input type="text" id="acd-webhook-url" readonly value="/api/academy/stripe-webhook" />
          <button type="button" class="btn-secondary" id="btn-copy-webhook">Copy</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main CMS Split Workspace -->
  <div class="studio-workspace">
    <!-- Left List -->
    <section class="brand-list-panel" aria-label="Courses and Guides list">
      <div class="acd-filter-tabs" role="tablist">
        <button type="button" class="acd-filter-btn is-active" data-acd-filter="all">All</button>
        <button type="button" class="acd-filter-btn" data-acd-filter="course">Courses</button>
        <button type="button" class="acd-filter-btn" data-acd-filter="guide">Guides</button>
      </div>
      <div class="brand-list" id="acd-item-list"></div>
    </section>

    <!-- Right Editor -->
    <section class="brand-editor-panel" aria-label="Course or Guide editor">
      <div class="acd-empty-editor" id="acd-empty-editor">
        Select a Course or Guide on the left, or click <strong>+ New Guide</strong> / <strong>+ New Course</strong>.
      </div>

      <form id="acd-editor-form" hidden>
        <div class="acd-editor-topbar">
          <div class="acd-editor-links">
            <a href="#" target="_blank" rel="noopener noreferrer" id="acd-preview-landing" class="btn-secondary">
              Preview Landing ↗
            </a>
            <a href="#" target="_blank" rel="noopener noreferrer" id="acd-preview-slides" class="btn-secondary">
              Preview Slides / PDF ↗
            </a>
          </div>
          <div class="acd-editor-actions">
            <button type="button" class="btn-danger" id="btn-delete-acd-item">Delete</button>
            <button type="submit" class="btn-primary" id="btn-save-acd-item">Save Changes</button>
          </div>
        </div>

        <div class="acd-form-grid">
          <label class="acd-field">
            <span>Type</span>
            <select id="acd-kind">
              <option value="guide">Guide (Free + Lead Form)</option>
              <option value="course">Course (Paid + Companion Tool)</option>
            </select>
          </label>

          <label class="acd-field">
            <span>Visibility Status</span>
            <select id="acd-status">
              <option value="draft">Private (Draft)</option>
              <option value="published">Public (Published)</option>
              <option value="scheduled">Scheduled</option>
            </select>
          </label>

          <label class="acd-field" id="acd-publish-at-wrap" hidden>
            <span>Schedule Publish Date &amp; Time</span>
            <input type="datetime-local" id="acd-publish-at" />
          </label>

          <label class="acd-field">
            <span>Title</span>
            <input type="text" id="acd-title" required />
          </label>

          <label class="acd-field">
            <span>Slug (URL)</span>
            <input type="text" id="acd-slug" required />
          </label>

          <label class="acd-field">
            <span>Category</span>
            <input type="text" id="acd-category" placeholder="AI Workflows" />
          </label>

          <label class="acd-field acd-span-2">
            <span>Subtitle (Hero)</span>
            <input type="text" id="acd-subtitle" />
          </label>

          <label class="acd-field acd-span-2">
            <span>Description</span>
            <textarea id="acd-description" rows="3"></textarea>
          </label>

          <div class="acd-field acd-span-2">
            <span>Cover Image URL</span>
            <div class="acd-copy-row">
              <input type="text" id="acd-cover-image" placeholder="/images/..." />
              <label class="btn-secondary acd-upload-label">
                Upload
                <input type="file" id="acd-cover-file" accept="image/*" hidden />
              </label>
            </div>
          </div>
        </div>

        <!-- Course-Specific Fields -->
        <div class="acd-subsection" id="acd-course-only">
          <h3 class="acd-sub-title">Course Pricing &amp; Companion Tool</h3>
          <div class="acd-form-grid">
            <label class="acd-field">
              <span>Price (Display)</span>
              <input type="text" id="acd-price-label" placeholder="$49" />
            </label>

            <label class="acd-field">
              <span>Access Mode</span>
              <select id="acd-access-mode">
                <option value="stripe_webhook">Stripe Webhook + Token (Option A)</option>
                <option value="checkout_redirect">Checkout Redirect (?checkout=success)</option>
                <option value="open">Open Access</option>
              </select>
            </label>

            <label class="acd-field acd-span-2">
              <span>Stripe Checkout Link</span>
              <input type="url" id="acd-stripe-url" placeholder="https://buy.stripe.com/..." />
            </label>

            <label class="acd-field">
              <span>Tool / Template Name (Optional)</span>
              <input type="text" id="acd-tool-name" placeholder="Magnific Prompt Kit" />
            </label>

            <label class="acd-field">
              <span>Tool Type</span>
              <input type="text" id="acd-tool-type" placeholder="Template / Micro-App / Mockups" />
            </label>

            <label class="acd-field acd-span-2">
              <span>Tool / Micro-App URL (Optional)</span>
              <input type="url" id="acd-tool-url" placeholder="https://..." />
            </label>
          </div>
        </div>

        <!-- Landing Copy -->
        <div class="acd-subsection">
          <h3 class="acd-sub-title">Landing Page Content</h3>
          <div class="acd-form-grid">
            <label class="acd-field">
              <span>Hero Badge</span>
              <input type="text" id="acd-hero-badge" placeholder="Free Tactical Guide" />
            </label>
            <label class="acd-field">
              <span>Read Time / Format</span>
              <input type="text" id="acd-read-time" placeholder="12 min read · 6 slides" />
            </label>
            <label class="acd-field acd-span-2">
              <span>Target Audience</span>
              <input type="text" id="acd-audience" placeholder="Creative Directors, Founders & Marketing Leads" />
            </label>
            <label class="acd-field acd-span-2">
              <span>Key Takeaways (one per line)</span>
              <textarea id="acd-takeaways" rows="4"></textarea>
            </label>
          </div>
        </div>

        <!-- Slide Deck Builder -->
        <div class="acd-subsection">
          <div class="acd-slides-head">
            <h3 class="acd-sub-title">Online Slides &amp; PDF Deck</h3>
            <button type="button" class="btn-secondary" id="btn-add-slide">+ Add Slide</button>
          </div>
          <div id="acd-slides-container" class="acd-slides-list"></div>
        </div>
      </form>
    </section>
  </div>
</div>

<script define:vars={{ initialItems, initialSettings }}>
  window.__INITIAL_ACADEMY_ITEMS__ = initialItems;
  window.__INITIAL_ACADEMY_SETTINGS__ = initialSettings;
</script>

<script>
  (() => {
    const w = window as any;
    let items: any[] = Array.isArray(w.__INITIAL_ACADEMY_ITEMS__) ? [...w.__INITIAL_ACADEMY_ITEMS__] : [];
    let activeFilter = "all";
    let selectedId: string | null = items[0]?.id ?? null;

    const listEl = document.getElementById("acd-item-list");
    const formEl = document.getElementById("acd-editor-form") as HTMLFormElement | null;
    const emptyEl = document.getElementById("acd-empty-editor");
    const slidesContainer = document.getElementById("acd-slides-container");
    const courseOnlyEl = document.getElementById("acd-course-only");
    const publishAtWrap = document.getElementById("acd-publish-at-wrap");
    const webhookUrlInput = document.getElementById("acd-webhook-url") as HTMLInputElement | null;

    if (webhookUrlInput) {
      webhookUrlInput.value = `${window.location.origin}/api/academy/stripe-webhook`;
    }

    const showStudioToast = (msg: string) => {
      const toast = document.getElementById("studio-toast");
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add("is-visible");
      setTimeout(() => toast.classList.remove("is-visible"), 2600);
    };

    const el = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;

    function toggleKindAndStatusUI() {
      const kind = el("acd-kind")?.value || "guide";
      const status = el("acd-status")?.value || "draft";
      if (courseOnlyEl) courseOnlyEl.hidden = kind !== "course";
      if (publishAtWrap) publishAtWrap.hidden = status !== "scheduled";
    }

    el("acd-kind")?.addEventListener("change", toggleKindAndStatusUI);
    el("acd-status")?.addEventListener("change", toggleKindAndStatusUI);

    function renderList() {
      if (!listEl) return;
      const filtered = items.filter((it) => activeFilter === "all" || it.kind === activeFilter);
      if (filtered.length === 0) {
        listEl.innerHTML = `<div class="acd-list-empty">No items yet.</div>`;
        return;
      }

      listEl.innerHTML = filtered
        .map((it) => {
          const isSelected = it.id === selectedId;
          const badge = it.kind === "course" ? `Course · ${it.priceLabel || "$49"}` : "Guide · Free";
          const statusLabel = it.status === "published" ? "Public" : it.status === "scheduled" ? "Scheduled" : "Private";
          return `
            <button type="button" class="acd-list-item ${isSelected ? "is-selected" : ""}" data-acd-id="${it.id}">
              <div class="acd-list-row">
                <span class="acd-kind-tag ${it.kind}">${badge}</span>
                <span class="acd-status-tag ${it.status}">${statusLabel}</span>
              </div>
              <div class="acd-list-title">${escapeHtml(it.title)}</div>
              <div class="acd-list-meta">${it.slides?.length || 0} slides · /${it.kind === "course" ? "courses" : "guides"}/${escapeHtml(it.slug)}</div>
            </button>
          `;
        })
        .join("");

      listEl.querySelectorAll<HTMLButtonElement>("[data-acd-id]").forEach((btn) => {
        btn.addEventListener("click", () => {
          selectedId = btn.dataset.acdId || null;
          renderList();
          renderEditor();
        });
      });
    }

    function escapeHtml(str: string) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function renderSlides(slides: any[]) {
      if (!slidesContainer) return;
      slidesContainer.innerHTML = slides
        .map(
          (s, idx) => `
          <div class="acd-slide-card" data-slide-idx="${idx}">
            <div class="acd-slide-card-head">
              <strong>Slide ${idx + 1}</strong>
              <div class="acd-slide-card-btns">
                <button type="button" class="btn-secondary btn-sm" data-slide-up="${idx}">↑</button>
                <button type="button" class="btn-secondary btn-sm" data-slide-down="${idx}">↓</button>
                <button type="button" class="btn-danger btn-sm" data-slide-del="${idx}">Remove</button>
              </div>
            </div>
            <div class="acd-form-grid">
              <label class="acd-field">
                <span>Layout</span>
                <select data-slide-field="layout">
                  ${["cover", "split", "bullets", "grid", "quote", "cta"]
                    .map((l) => `<option value="${l}" ${s.layout === l ? "selected" : ""}>${l}</option>`)
                    .join("")}
                </select>
              </label>
              <label class="acd-field">
                <span>Eyebrow</span>
                <input type="text" data-slide-field="eyebrow" value="${escapeHtml(s.eyebrow || "")}" />
              </label>
              <label class="acd-field acd-span-2">
                <span>Slide Title</span>
                <input type="text" data-slide-field="title" value="${escapeHtml(s.title || "")}" />
              </label>
              <label class="acd-field acd-span-2">
                <span>Body Text</span>
                <textarea rows="2" data-slide-field="body">${escapeHtml(s.body || "")}</textarea>
              </label>
              <label class="acd-field acd-span-2">
                <span>Bullets / Grid Items (one per line)</span>
                <textarea rows="3" data-slide-field="bullets">${escapeHtml((s.bullets || []).join("\n"))}</textarea>
              </label>
              <label class="acd-field acd-span-2">
                <span>Callout Note (optional)</span>
                <input type="text" data-slide-field="callout" value="${escapeHtml(s.callout || "")}" />
              </label>
            </div>
          </div>
        `
        )
        .join("");

      slidesContainer.querySelectorAll<HTMLButtonElement>("[data-slide-del]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = items.find((i) => i.id === selectedId);
          if (!item) return;
          const idx = Number(btn.dataset.slideDel);
          item.slides = collectSlidesFromDOM();
          item.slides.splice(idx, 1);
          renderSlides(item.slides);
        });
      });

      slidesContainer.querySelectorAll<HTMLButtonElement>("[data-slide-up]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = items.find((i) => i.id === selectedId);
          if (!item) return;
          const idx = Number(btn.dataset.slideUp);
          item.slides = collectSlidesFromDOM();
          if (idx > 0) {
            [item.slides[idx - 1], item.slides[idx]] = [item.slides[idx], item.slides[idx - 1]];
            renderSlides(item.slides);
          }
        });
      });

      slidesContainer.querySelectorAll<HTMLButtonElement>("[data-slide-down]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = items.find((i) => i.id === selectedId);
          if (!item) return;
          const idx = Number(btn.dataset.slideDown);
          item.slides = collectSlidesFromDOM();
          if (idx < item.slides.length - 1) {
            [item.slides[idx + 1], item.slides[idx]] = [item.slides[idx], item.slides[idx + 1]];
            renderSlides(item.slides);
          }
        });
      });
    }

    function collectSlidesFromDOM() {
      if (!slidesContainer) return [];
      return Array.from(slidesContainer.querySelectorAll<HTMLElement>(".acd-slide-card")).map((card, i) => {
        const getF = (name: string) =>
          (card.querySelector(`[data-slide-field="${name}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement)?.value ?? "";
        return {
          id: `s-${i + 1}`,
          layout: getF("layout") || "bullets",
          eyebrow: getF("eyebrow").trim(),
          title: getF("title").trim(),
          body: getF("body").trim(),
          bullets: getF("bullets")
            .split("\n")
            .map((x) => x.trim())
            .filter(Boolean),
          callout: getF("callout").trim() || undefined
        };
      });
    }

    function renderEditor() {
      const item = items.find((i) => i.id === selectedId);
      if (!item || !formEl || !emptyEl) {
        if (formEl) formEl.hidden = true;
        if (emptyEl) emptyEl.hidden = false;
        return;
      }

      emptyEl.hidden = true;
      formEl.hidden = false;

      el("acd-kind")!.value = item.kind;
      el("acd-status")!.value = item.status;
      el("acd-publish-at")!.value = item.publishAt ? item.publishAt.slice(0, 16) : "";
      el("acd-title")!.value = item.title || "";
      el("acd-slug")!.value = item.slug || "";
      el("acd-category")!.value = item.category || "";
      el("acd-subtitle")!.value = item.subtitle || "";
      el("acd-description")!.value = item.description || "";
      el("acd-cover-image")!.value = item.coverImage || "";
      el("acd-price-label")!.value = item.priceLabel || "";
      el("acd-access-mode")!.value = item.accessMode || "stripe_webhook";
      el("acd-stripe-url")!.value = item.stripeCheckoutUrl || "";
      el("acd-tool-name")!.value = item.toolName || "";
      el("acd-tool-type")!.value = item.toolType || "";
      el("acd-tool-url")!.value = item.toolUrl || "";
      el("acd-hero-badge")!.value = item.landingData?.heroBadge || "";
      el("acd-read-time")!.value = item.landingData?.readTime || "";
      el("acd-audience")!.value = item.landingData?.audience || "";
      el("acd-takeaways")!.value = (item.landingData?.takeaways || []).join("\n");

      const baseFolder = item.kind === "course" ? "courses" : "guides";
      const landingPreview = document.getElementById("acd-preview-landing") as HTMLAnchorElement | null;
      const slidesPreview = document.getElementById("acd-preview-slides") as HTMLAnchorElement | null;
      if (landingPreview) landingPreview.href = `/academy/${baseFolder}/${item.slug}`;
      if (slidesPreview) slidesPreview.href = `/academy/${baseFolder}/${item.slug}/slides`;

      toggleKindAndStatusUI();
      renderSlides(item.slides || []);
    }

    // Filter buttons
    document.querySelectorAll<HTMLButtonElement>("[data-acd-filter]").forEach((btn) => {
      btn.addEventListener("click", () => {
        activeFilter = btn.dataset.acdFilter || "all";
        document.querySelectorAll("[data-acd-filter]").forEach((b) => b.classList.toggle("is-active", b === btn));
        renderList();
      });
    });

    // Add Slide
    document.getElementById("btn-add-slide")?.addEventListener("click", () => {
      const item = items.find((i) => i.id === selectedId);
      if (!item) return;
      item.slides = collectSlidesFromDOM();
      item.slides.push({
        id: `s-${item.slides.length + 1}`,
        layout: "bullets",
        eyebrow: `0${item.slides.length + 1} · Section`,
        title: "New Slide Title",
        body: "",
        bullets: ["Key point 1", "Key point 2"]
      });
      renderSlides(item.slides);
    });

    // Create New Guide / Course
    async function createItem(kind: "guide" | "course") {
      const res = await fetch("/api/academy/items", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind,
          title: kind === "course" ? "Untitled Course" : "Untitled Guide",
          status: "draft",
          slides: [
            {
              id: "s1",
              layout: "cover",
              eyebrow: kind === "course" ? "Adaptif Academy · Course" : "Adaptif Academy · Free Guide",
              title: kind === "course" ? "Untitled Course" : "Untitled Guide",
              body: "Subtitle goes here.",
              bullets: ["Key Concept 1", "Key Concept 2"]
            }
          ]
        })
      });
      const data = await res.json();
      if (res.ok && data.item) {
        items.unshift(data.item);
        selectedId = data.item.id;
        renderList();
        renderEditor();
        showStudioToast(`Created new ${kind}!`);
      }
    }

    document.getElementById("btn-new-guide")?.addEventListener("click", () => createItem("guide"));
    document.getElementById("btn-new-course")?.addEventListener("click", () => createItem("course"));

    // Save Item
    formEl?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!selectedId) return;
      const item = items.find((i) => i.id === selectedId);
      if (!item) return;

      const payload = {
        kind: el("acd-kind")!.value,
        status: el("acd-status")!.value,
        publishAt: el("acd-publish-at")!.value ? new Date(el("acd-publish-at")!.value).toISOString() : null,
        title: el("acd-title")!.value.trim(),
        slug: el("acd-slug")!.value.trim(),
        category: el("acd-category")!.value.trim(),
        subtitle: el("acd-subtitle")!.value.trim(),
        description: el("acd-description")!.value.trim(),
        coverImage: el("acd-cover-image")!.value.trim(),
        priceLabel: el("acd-price-label")!.value.trim(),
        accessMode: el("acd-access-mode")!.value,
        stripeCheckoutUrl: el("acd-stripe-url")!.value.trim(),
        toolName: el("acd-tool-name")!.value.trim(),
        toolType: el("acd-tool-type")!.value.trim(),
        toolUrl: el("acd-tool-url")!.value.trim(),
        landingData: {
          heroBadge: el("acd-hero-badge")!.value.trim(),
          readTime: el("acd-read-time")!.value.trim(),
          audience: el("acd-audience")!.value.trim(),
          takeaways: el("acd-takeaways")!.value.split("\n").map((x) => x.trim()).filter(Boolean),
          faq: item.landingData?.faq || []
        },
        slides: collectSlidesFromDOM()
      };

      const res = await fetch(`/api/academy/items/${selectedId}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok && data.item) {
        const idx = items.findIndex((i) => i.id === selectedId);
        if (idx !== -1) items[idx] = data.item;
        renderList();
        renderEditor();
        showStudioToast("Saved changes!");
      } else {
        showStudioToast(data?.error || "Save failed");
      }
    });

    // Delete Item
    document.getElementById("btn-delete-acd-item")?.addEventListener("click", async () => {
      if (!selectedId) return;
      if (!confirm("Delete this Academy item permanently?")) return;
      const res = await fetch(`/api/academy/items/${selectedId}`, { method: "DELETE" });
      if (res.ok) {
        items = items.filter((i) => i.id !== selectedId);
        selectedId = items[0]?.id ?? null;
        renderList();
        renderEditor();
        showStudioToast("Deleted item");
      }
    });

    // Upload Cover Image
    document.getElementById("acd-cover-file")?.addEventListener("change", async (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      const fd = new FormData();
      fd.append("file", file);
      const res = await fetch("/api/upload", { method: "POST", body: fd });
      const data = await res.json();
      if (res.ok && data.url) {
        el("acd-cover-image")!.value = data.url;
        showStudioToast("Cover image uploaded!");
      }
    });

    // Save Preferences
    document.getElementById("btn-save-acd-settings")?.addEventListener("click", async () => {
      const mode = (document.getElementById("acd-default-access-mode") as HTMLSelectElement)?.value;
      const secret = (document.getElementById("acd-stripe-secret") as HTMLInputElement)?.value;
      const res = await fetch("/api/academy/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ defaultCourseAccessMode: mode, stripeWebhookSecret: secret })
      });
      if (res.ok) {
        showStudioToast("Academy preferences saved!");
      }
    });

    document.getElementById("btn-copy-webhook")?.addEventListener("click", () => {
      if (webhookUrlInput) {
        navigator.clipboard?.writeText(webhookUrlInput.value);
        showStudioToast("Webhook URL copied!");
      }
    });

    renderList();
    renderEditor();
  })();
</script>

