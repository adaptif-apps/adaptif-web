---
import { FUNNEL_BLOCKS, type AcademyItem, type AcademySettings } from "../lib/academyDb";
import AcademyGeneratorModal from "./AcademyGeneratorModal.astro";

interface Props {
  initialItems: AcademyItem[];
  initialSettings: AcademySettings;
}

const { initialItems, initialSettings } = Astro.props;
---

<div id="module-academy" hidden>
  <header class="studio-header">
    <div>
      <p class="studio-eyebrow" id="acd-module-eyebrow">Academy CMS</p>
      <h1 class="studio-title" id="acd-module-title">Courses &amp; <span>Guides</span></h1>
    </div>
    <div class="studio-header-actions">
      <button type="button" class="acd-btn-cyan" id="btn-new-guide">+ New Guide</button>
      <button type="button" class="acd-btn-cyan" id="btn-new-course">+ New Course</button>
    </div>
  </header>

  <!-- 1st Module: Flat AI Curriculum Generator -->
  <AcademyGeneratorModal initialSettings={initialSettings} />

  <!-- Full-Width Editor Card (selection happens in Sidebar Courses / Guides dropdowns) -->
  <section class="acd-glass-card acd-editor-shell" aria-label="Course or Guide settings">
    <div class="acd-empty-editor" id="acd-empty-editor">
      Select an item from the <strong>Courses</strong> or <strong>Guides</strong> dropdown in the sidebar, or create a new one above.
    </div>

    <form id="acd-editor-form" hidden>
      <div class="acd-editor-topbar">
        <div class="acd-editor-links">
          <a href="#" target="_blank" rel="noopener noreferrer" id="acd-edit-content" class="acd-btn-cyan-outline">
            Edit Content ↗
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" id="acd-preview-landing" class="acd-btn-glass">
            Preview Landing ↗
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" id="acd-preview-slides" class="acd-btn-glass">
            Preview Slides / PDF ↗
          </a>
        </div>
        <div class="acd-editor-actions">
          <button type="button" class="acd-btn-danger" id="btn-delete-acd-item">Delete</button>
          <button type="submit" class="acd-btn-cyan" id="btn-save-acd-item">Save Changes</button>
        </div>
      </div>

      <div class="acd-form-grid">
        <label class="acd-field">
          <span class="acd-label-row">
            Slug (URL)
            <span class="acd-tip-wrap">
              <button type="button" class="acd-tip-btn" aria-label="Slug info">?</button>
              <span class="acd-tip-box" role="tooltip">
                Public URL path for this item (e.g. <code>/academy/courses/my-course</code>). Also used in your Stripe redirect URL.
              </span>
            </span>
          </span>
          <input type="text" id="acd-slug" required />
        </label>

        <label class="acd-field">
          <span class="acd-label-row">
            Category
            <span class="acd-tip-wrap">
              <button type="button" class="acd-tip-btn" aria-label="Category info">?</button>
              <span class="acd-tip-box" role="tooltip">
                Topic badge shown in the Academy catalog, course hero breadcrumb, and slide deck cover.
              </span>
            </span>
          </span>
          <input type="text" id="acd-category" placeholder="AI Workflows" />
        </label>
      </div>
    </form>
  </section>

</div>

<!-- General Payment & Stripe Access Control Module (Left Sidebar: Payment) -->
<div id="module-payment" hidden>
  <header class="studio-header">
    <div>
      <p class="studio-eyebrow">Stripe &amp; Access Control</p>
      <h1 class="studio-title">Payment <span>Settings</span></h1>
    </div>
    <div class="studio-header-actions">
      <button type="button" class="acd-btn-cyan" id="btn-save-acd-settings">Save Preferences</button>
    </div>
  </header>

  <section class="acd-glass-card acd-prefs-card" aria-label="Course Access & Stripe Preferences">
    <div class="acd-prefs-head">
      <div>
        <span class="acd-section-kicker">Global Course Checkout</span>
        <h2 class="acd-card-title">Course Access Preferences</h2>
        <p class="acd-card-sub">
          Configure how paid courses unlock after checkout across all courses. Paste individual Stripe Payment Links on each course.
        </p>
      </div>
    </div>

    <div class="acd-prefs-grid">
      <label class="acd-field">
        <span class="acd-label-row">
          Default Course Access Mode
          <span class="acd-tip-wrap">
            <button type="button" class="acd-tip-btn" aria-label="Access mode info">?</button>
            <span class="acd-tip-box" role="tooltip">
              Controls how all paid courses unlock: <strong>Stripe Webhook</strong> verifies payment tokens &amp; sends backup email; <strong>Checkout Redirect</strong> unlocks via <code>?checkout=success</code>; <strong>Open</strong> disables the paywall.
            </span>
          </span>
        </span>
        <select id="acd-default-access-mode" class="ac-select">
          <option value="stripe_webhook" selected={initialSettings.defaultCourseAccessMode === "stripe_webhook"}>
            Option A: Stripe Webhook + Secure Token (Recommended)
          </option>
          <option value="checkout_redirect" selected={initialSettings.defaultCourseAccessMode === "checkout_redirect"}>
            Simple Checkout Redirect (?checkout=success)
          </option>
          <option value="open" selected={initialSettings.defaultCourseAccessMode === "open"}>
            Open Access (No Gate)
          </option>
        </select>
      </label>

      <label class="acd-field">
        <span class="acd-label-row">
          Stripe Webhook Secret (whsec_...)
          <span class="acd-tip-wrap">
            <button type="button" class="acd-tip-btn" aria-label="Webhook secret info">?</button>
            <span class="acd-tip-box" role="tooltip">
              Found in Stripe Dashboard → Developers → Webhooks → Signing secret. Required to verify <code>checkout.session.completed</code> events before emailing course access.
            </span>
          </span>
        </span>
        <input
          type="password"
          id="acd-stripe-secret"
          placeholder={initialSettings.hasStripeWebhookSecret ? "Saved (leave blank to keep)" : "whsec_..."}
        />
      </label>

      <div class="acd-field">
        <span class="acd-label-row">
          Stripe Webhook Endpoint
          <span class="acd-tip-wrap">
            <button type="button" class="acd-tip-btn" aria-label="Webhook endpoint info">?</button>
            <span class="acd-tip-box" role="tooltip">
              Paste this URL in Stripe → Developers → Webhooks and enable the <code>checkout.session.completed</code> event.
            </span>
          </span>
        </span>
        <div class="acd-copy-row">
          <input type="text" id="acd-webhook-url" readonly value="/api/academy/stripe-webhook" />
          <button type="button" class="acd-btn-glass" id="btn-copy-webhook">Copy</button>
        </div>
      </div>
    </div>
  </section>
</div>

<!-- AI Engine Configuration Module (Left Sidebar: AI Engine) -->
<div id="module-ai-config" hidden>
  <header class="studio-header">
    <div>
      <p class="studio-eyebrow">Curriculum Generation</p>
      <h1 class="studio-title">AI <span>Engine</span></h1>
    </div>
    <div class="studio-header-actions">
      <button type="button" class="acd-btn-cyan" id="btn-save-ai-key">Save AI Configuration</button>
    </div>
  </header>

  <section class="acd-glass-card acd-prefs-card" aria-label="AI Engine Configuration">
    <div class="acd-prefs-head">
      <div>
        <span class="acd-section-kicker">Provider &amp; Credentials</span>
        <h2 class="acd-card-title">AI Generator Model &amp; API Key</h2>
        <p class="acd-card-sub">
          Choose the LLM provider used to synthesize uploaded docs, links, and notes into Courses and Guides.
        </p>
      </div>
      <div class="acd-ai-status-pill">
        <span class:list={["acd-status-dot", { "is-ready": initialSettings.hasAiApiKey }]} id="gen-ai-dot"></span>
        <span id="gen-ai-status-text">
          {initialSettings.hasAiApiKey
            ? `${initialSettings.aiProvider === "openai" ? "OpenAI" : "Gemini"} Ready`
            : "Not Configured"}
        </span>
      </div>
    </div>

    <div class="acd-prefs-grid">
      <label class="acd-field">
        <span class="acd-label-row">
          AI Provider
          <span class="acd-tip-wrap">
            <button type="button" class="acd-tip-btn" aria-label="AI Provider info">?</button>
            <span class="acd-tip-box" role="tooltip">
              Select the LLM engine used by the AI Curriculum Generator to synthesize docs, links, and notes into full course funnels.
            </span>
          </span>
        </span>
        <select id="gen-ai-provider" class="ac-select">
          <option value="gemini" selected={initialSettings.aiProvider !== "openai"}>Google Gemini (2.5 Flash)</option>
          <option value="openai" selected={initialSettings.aiProvider === "openai"}>OpenAI (GPT-4o Mini)</option>
        </select>
      </label>

      <label class="acd-field acd-span-2">
        <span class="acd-label-row">
          API Key
          <span class="acd-tip-wrap">
            <button type="button" class="acd-tip-btn" aria-label="API Key info">?</button>
            <span class="acd-tip-box" role="tooltip">
              Stored encrypted in Postgres. Leave blank when saving if you want to keep your existing saved key.
            </span>
          </span>
        </span>
        <input
          type="password"
          id="gen-ai-key"
          placeholder={initialSettings.hasAiApiKey ? "Saved (leave blank to keep)" : "Paste Gemini or OpenAI API key..."}
        />
      </label>
    </div>
  </section>
</div>

<!-- General Info / System Overview Module (Left Sidebar: General Info) -->
<div id="module-general-info" hidden>
  <header class="studio-header">
    <div>
      <p class="studio-eyebrow">System Overview</p>
      <h1 class="studio-title">General <span>Info</span></h1>
    </div>
    <div class="studio-header-actions">
      <button type="button" class="acd-btn-glass" id="btn-refresh-general-info">Refresh Status</button>
    </div>
  </header>

  <div class="gi-grid">
    <!-- Card 1: Stripe & Checkout Flow -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Payments &amp; Delivery</span>
          <h2 class="acd-card-title">Stripe Checkout &amp; Webhook</h2>
        </div>
        <span class="gi-badge" id="gi-stripe-badge">Checking...</span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>Active Access Mode</span>
          <strong id="gi-access-mode">{initialSettings.defaultCourseAccessMode}</strong>
        </div>
        <div class="gi-row">
          <span>Webhook Secret (whsec_)</span>
          <strong id="gi-webhook-secret-status">{initialSettings.hasStripeWebhookSecret ? "Configured" : "Not set"}</strong>
        </div>
        <div class="gi-row-col">
          <span>Stripe Webhook Endpoint</span>
          <div class="acd-copy-row">
            <input type="text" id="gi-webhook-url" readonly value="/api/academy/stripe-webhook" />
            <button type="button" class="acd-btn-glass" id="gi-copy-webhook">Copy</button>
          </div>
        </div>
        <div class="gi-row-col">
          <span>Stripe Redirect URL Pattern (After Payment)</span>
          <div class="acd-copy-row">
            <input type="text" id="gi-redirect-pattern" readonly value="/academy/courses/<slug>/slides?checkout=success" />
            <button type="button" class="acd-btn-glass" id="gi-copy-redirect">Copy</button>
          </div>
        </div>
      </div>
      <div class="gi-card-foot">
        <button type="button" class="acd-btn-cyan-outline" data-jump-tab="payment">Configure Payment →</button>
      </div>
    </section>

    <!-- Card 2: Email Delivery (Resend.com) -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Automated Backup Email</span>
          <h2 class="acd-card-title">Resend.com Delivery</h2>
        </div>
        <span class="gi-badge" id="gi-resend-badge">Checking...</span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>RESEND_API_KEY (Vercel)</span>
          <strong id="gi-resend-status">Checking...</strong>
        </div>
        <div class="gi-row">
          <span>Sender (ACADEMY_FROM_EMAIL)</span>
          <strong id="gi-from-email">—</strong>
        </div>
      </div>
      <p class="gi-note">
        When a customer completes a Stripe Payment Link, the webhook sends a backup email with their direct Slides &amp; PDF link.
      </p>
      <div class="gi-checklist">
        <span>1. Create an API key at <a href="https://resend.com" target="_blank" rel="noopener noreferrer">resend.com</a></span>
        <span>2. Add <code>RESEND_API_KEY</code> &amp; <code>ACADEMY_FROM_EMAIL</code> in Vercel → Settings → Environment Variables</span>
      </div>
    </section>

    <!-- Card 3: AI Curriculum Engine -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Content Synthesis</span>
          <h2 class="acd-card-title">AI Curriculum Engine</h2>
        </div>
        <span class="gi-badge" id="gi-ai-badge">
          {initialSettings.hasAiApiKey ? "Ready" : "Key Missing"}
        </span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>Active Provider</span>
          <strong id="gi-ai-provider">{initialSettings.aiProvider === "openai" ? "OpenAI (GPT-4o Mini)" : "Google Gemini (2.5 Flash)"}</strong>
        </div>
        <div class="gi-row">
          <span>API Key Status</span>
          <strong id="gi-ai-key-status">{initialSettings.hasAiApiKey ? "Saved in Postgres" : "Not Configured"}</strong>
        </div>
        <div class="gi-row">
          <span>Catalog Items</span>
          <strong id="gi-catalog-counts">—</strong>
        </div>
      </div>
      <div class="gi-card-foot">
        <button type="button" class="acd-btn-cyan-outline" data-jump-tab="ai-config">Configure AI Engine →</button>
      </div>
    </section>

    <!-- Card 4: Hosting & Database (Vercel + Postgres) -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Infrastructure</span>
          <h2 class="acd-card-title">Vercel &amp; Postgres</h2>
        </div>
        <span class="gi-badge is-ok" id="gi-infra-badge">Checking...</span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>Runtime Environment</span>
          <strong id="gi-vercel-env">—</strong>
        </div>
        <div class="gi-row">
          <span>Postgres Database</span>
          <strong id="gi-postgres-status">Checking...</strong>
        </div>
        <div class="gi-row">
          <span>Active Origin</span>
          <strong id="gi-origin">—</strong>
        </div>
      </div>
      <p class="gi-note">
        All courses, guides, frontend edits, funnel block visibility, and Stripe settings persist in Postgres and deploy via Vercel.
      </p>
    </section>
  </div>
</div>

<script define:vars={{ initialItems, initialSettings }}>
  window.__INITIAL_ACADEMY_ITEMS__ = initialItems;
  window.__INITIAL_ACADEMY_SETTINGS__ = initialSettings;
</script>

<script>
  (() => {
    const w = window as any;
    let items: any[] = Array.isArray(w.__INITIAL_ACADEMY_ITEMS__) ? [...w.__INITIAL_ACADEMY_ITEMS__] : [];
    let selectedId: string | null = items[0]?.id ?? null;

    const formEl = document.getElementById("acd-editor-form") as HTMLFormElement | null;
    const emptyEl = document.getElementById("acd-empty-editor");
    const slidesContainer = document.getElementById("acd-slides-container");
    const courseOnlyEl = document.getElementById("acd-course-only");
    const prefsSectionEl = document.getElementById("acd-prefs-section");
    const publishAtWrap = document.getElementById("acd-publish-at-wrap");
    const webhookUrlInput = document.getElementById("acd-webhook-url") as HTMLInputElement | null;
    const titleHeaderEl = document.getElementById("acd-module-title");
    const eyebrowHeaderEl = document.getElementById("acd-module-eyebrow");

    const sidebarCoursesList = document.getElementById("sidebar-courses-list");
    const sidebarGuidesList = document.getElementById("sidebar-guides-list");
    const sidebarCoursesCount = document.getElementById("sidebar-courses-count");
    const sidebarGuidesCount = document.getElementById("sidebar-guides-count");

    if (webhookUrlInput) {
      webhookUrlInput.value = `${window.location.origin}/api/academy/stripe-webhook`;
    }

    const showStudioToast = (msg: string) => {
      const toast = document.getElementById("studio-toast");
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add("is-visible");
      setTimeout(() => toast.classList.remove("is-visible"), 2600);
    };

    const el = (id: string) =>
      document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;

    function escapeHtml(str: string) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function activateAcademyModule() {
      const portfolioModule = document.getElementById("module-portfolio");
      const bookCallModule = document.getElementById("module-book-call");
      const activeCampaignModule = document.getElementById("module-activecampaign");
      const academyModule = document.getElementById("module-academy");
      const paymentModule = document.getElementById("module-payment");
      const aiConfigModule = document.getElementById("module-ai-config");

      document.querySelectorAll<HTMLButtonElement>("[data-module-tab]").forEach((t) => {
        t.classList.remove("is-active");
        t.removeAttribute("aria-current");
      });

      if (portfolioModule) portfolioModule.hidden = true;
      if (bookCallModule) bookCallModule.hidden = true;
      if (activeCampaignModule) activeCampaignModule.hidden = true;
      if (paymentModule) paymentModule.hidden = true;
      if (aiConfigModule) aiConfigModule.hidden = true;
      if (academyModule) academyModule.hidden = false;
    }

    function renderSidebarLists() {
      const courses = items.filter((i) => i.kind === "course");
      const guides = items.filter((i) => i.kind === "guide");

      if (sidebarCoursesCount) sidebarCoursesCount.textContent = String(courses.length);
      if (sidebarGuidesCount) sidebarGuidesCount.textContent = String(guides.length);

      const renderGroup = (container: HTMLElement | null, groupItems: any[], kind: "course" | "guide") => {
        if (!container) return;
        const listHtml = groupItems
          .map((it) => {
            const isActive = it.id === selectedId && !document.getElementById("module-academy")?.hidden;
            const dotClass =
              it.status === "published" ? "is-live" : it.status === "scheduled" ? "is-scheduled" : "is-draft";
            return `
              <button
                type="button"
                class="nav-item nav-academy-item ${isActive ? "is-active" : ""}"
                data-sidebar-academy-id="${it.id}"
                title="${escapeHtml(it.title)}"
              >
                <span class="nav-acd-label">
                  <span class="nav-acd-dot ${dotClass}" aria-hidden="true"></span>
                  <span class="nav-acd-title">${escapeHtml(it.title)}</span>
                </span>
              </button>
            `;
          })
          .join("");

        container.innerHTML =
          listHtml || `<div class="nav-acd-empty">No ${kind}s yet</div>`;

        container.querySelectorAll<HTMLButtonElement>("[data-sidebar-academy-id]").forEach((btn) => {
          btn.addEventListener("click", () => {
            selectedId = btn.dataset.sidebarAcademyId || null;
            activateAcademyModule();
            renderSidebarLists();
            renderEditor();
          });
        });
      };

      renderGroup(sidebarCoursesList, courses, "course");
      renderGroup(sidebarGuidesList, guides, "guide");
    }

    function toggleKindAndStatusUI(kind: string = "course") {
      if (prefsSectionEl) prefsSectionEl.hidden = kind !== "course";

      const newGuideBtn = document.getElementById("btn-new-guide");
      const newCourseBtn = document.getElementById("btn-new-course");
      if (newGuideBtn) newGuideBtn.hidden = kind !== "guide";
      if (newCourseBtn) newCourseBtn.hidden = kind !== "course";

      if (titleHeaderEl && eyebrowHeaderEl) {
        if (kind === "course") {
          eyebrowHeaderEl.textContent = "Academy · Courses CMS";
          titleHeaderEl.innerHTML = "Course <span>Editor</span>";
        } else {
          eyebrowHeaderEl.textContent = "Academy · Guides CMS";
          titleHeaderEl.innerHTML = "Guide <span>Editor</span>";
        }
      }
    }

    function renderEditor() {
      const item = items.find((i) => i.id === selectedId);
      if (!item || !formEl || !emptyEl) {
        if (formEl) formEl.hidden = true;
        if (emptyEl) emptyEl.hidden = false;
        return;
      }

      emptyEl.hidden = true;
      formEl.hidden = false;

      el("acd-slug")!.value = item.slug || "";
      el("acd-category")!.value = item.category || "";

      window.dispatchEvent(new CustomEvent("academy:kind-changed", { detail: { kind: item.kind } }));

      const baseFolder = item.kind === "course" ? "courses" : "guides";
      const editContentLink = document.getElementById("acd-edit-content") as HTMLAnchorElement | null;
      const landingPreview = document.getElementById("acd-preview-landing") as HTMLAnchorElement | null;
      const slidesPreview = document.getElementById("acd-preview-slides") as HTMLAnchorElement | null;
      if (editContentLink) {
        editContentLink.href = `/academy/${baseFolder}/${item.slug}?edit=1`;
        editContentLink.hidden = item.kind !== "course";
      }
      if (landingPreview) landingPreview.href = `/academy/${baseFolder}/${item.slug}`;
      if (slidesPreview) slidesPreview.href = `/academy/${baseFolder}/${item.slug}/slides`;

      toggleKindAndStatusUI(item.kind);
    }

    async function createItem(kind: "guide" | "course") {
      const res = await fetch("/api/academy/items", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind,
          title: kind === "course" ? "Untitled Course" : "Untitled Guide",
          status: "draft",
          slides: [
            {
              id: "s1",
              layout: "cover",
              eyebrow: kind === "course" ? "Adaptif Academy · Course" : "Adaptif Academy · Free Guide",
              title: kind === "course" ? "Untitled Course" : "Untitled Guide",
              body: "Subtitle goes here.",
              bullets: ["Key Concept 1", "Key Concept 2"]
            }
          ]
        })
      });
      const data = await res.json();
      if (res.ok && data.item) {
        items.unshift(data.item);
        selectedId = data.item.id;
        renderSidebarLists();
        renderEditor();
        showStudioToast(`Created new ${kind}!`);
      }
    }

    document.getElementById("btn-new-guide")?.addEventListener("click", () => createItem("guide"));
    document.getElementById("btn-new-course")?.addEventListener("click", () => createItem("course"));

    window.addEventListener("academy:item-generated", (e: any) => {
      const newItem = e?.detail?.item;
      if (!newItem) return;
      items.unshift(newItem);
      selectedId = newItem.id;
      renderSidebarLists();
      renderEditor();
      showStudioToast(`AI generated ${newItem.kind}: ${newItem.title}`);
    });

    formEl?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!selectedId) return;
      const item = items.find((i) => i.id === selectedId);
      if (!item) return;

      const payload = {
        kind: item.kind,
        status: item.status,
        publishAt: item.publishAt,
        title: item.title,
        slug: el("acd-slug")!.value.trim(),
        category: el("acd-category")!.value.trim(),
        subtitle: item.subtitle,
        description: item.description,
        coverImage: item.coverImage,
        priceLabel: item.priceLabel,
        accessMode: item.accessMode,
        stripeCheckoutUrl: item.stripeCheckoutUrl,
        toolName: item.toolName,
        toolType: item.toolType,
        toolUrl: item.toolUrl,
        landingData: item.landingData || {},
        slides: item.slides || []
      };

      const res = await fetch(`/api/academy/items/${selectedId}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok && data.item) {
        const idx = items.findIndex((i) => i.id === selectedId);
        if (idx !== -1) items[idx] = data.item;
        renderSidebarLists();
        renderEditor();
        showStudioToast("Saved changes!");
      } else {
        showStudioToast(data?.error || "Save failed");
      }
    });

    document.getElementById("btn-delete-acd-item")?.addEventListener("click", async () => {
      if (!selectedId) return;
      if (!confirm("Delete this Academy item permanently?")) return;
      const res = await fetch(`/api/academy/items/${selectedId}`, { method: "DELETE" });
      if (res.ok) {
        items = items.filter((i) => i.id !== selectedId);
        selectedId = items[0]?.id ?? null;
        renderSidebarLists();
        renderEditor();
        showStudioToast("Deleted item");
      }
    });

    document.getElementById("btn-save-acd-settings")?.addEventListener("click", async () => {
      const mode = (document.getElementById("acd-default-access-mode") as HTMLSelectElement)?.value;
      const secret = (document.getElementById("acd-stripe-secret") as HTMLInputElement)?.value;
      const res = await fetch("/api/academy/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ defaultCourseAccessMode: mode, stripeWebhookSecret: secret })
      });
      if (res.ok) {
        showStudioToast("Payment preferences saved!");
      }
    });

    const saveAiKeyBtn = document.getElementById("btn-save-ai-key") as HTMLButtonElement | null;
    saveAiKeyBtn?.addEventListener("click", async () => {
      const provider = (document.getElementById("gen-ai-provider") as HTMLSelectElement)?.value || "gemini";
      const apiKey = (document.getElementById("gen-ai-key") as HTMLInputElement)?.value || "";
      const aiDot = document.getElementById("gen-ai-dot");
      const aiStatusText = document.getElementById("gen-ai-status-text");
      saveAiKeyBtn.disabled = true;
      try {
        const res = await fetch("/api/academy/settings", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ aiProvider: provider, aiApiKey: apiKey })
        });
        const data = await res.json();
        if (res.ok) {
          if (data?.settings?.hasAiApiKey) {
            aiDot?.classList.add("is-ready");
            if (aiStatusText) aiStatusText.textContent = `${provider === "openai" ? "OpenAI" : "Gemini"} Ready`;
          }
          showStudioToast("AI Engine configuration saved!");
        } else {
          showStudioToast(data?.error || "Failed to save AI configuration");
        }
      } finally {
        saveAiKeyBtn.disabled = false;
      }
    });

    document.getElementById("btn-copy-webhook")?.addEventListener("click", () => {
      if (webhookUrlInput) {
        navigator.clipboard?.writeText(webhookUrlInput.value);
        showStudioToast("Webhook URL copied!");
      }
    });

    async function refreshGeneralInfo() {
      const origin = window.location.origin;
      const giWebhookInput = document.getElementById("gi-webhook-url") as HTMLInputElement | null;
      const giRedirectInput = document.getElementById("gi-redirect-pattern") as HTMLInputElement | null;
      const giOriginEl = document.getElementById("gi-origin");
      const giCatalogEl = document.getElementById("gi-catalog-counts");

      if (giWebhookInput) giWebhookInput.value = `${origin}/api/academy/stripe-webhook`;
      if (giRedirectInput) giRedirectInput.value = `${origin}/academy/courses/<slug>/slides?checkout=success`;
      if (giOriginEl) giOriginEl.textContent = origin;

      const courseCount = items.filter((i) => i.kind === "course").length;
      const guideCount = items.filter((i) => i.kind === "guide").length;
      if (giCatalogEl) giCatalogEl.textContent = `${courseCount} Courses · ${guideCount} Guides`;

      try {
        const res = await fetch("/api/academy/settings");
        if (!res.ok) return;
        const { settings, system } = await res.json();

        const modeLabels: Record<string, string> = {
          stripe_webhook: "Stripe Webhook + Token",
          checkout_redirect: "Checkout Redirect (?checkout=success)",
          open: "Open Access (No Gate)"
        };

        const modeEl = document.getElementById("gi-access-mode");
        const whSecretEl = document.getElementById("gi-webhook-secret-status");
        const stripeBadge = document.getElementById("gi-stripe-badge");
        if (modeEl) modeEl.textContent = modeLabels[settings?.defaultCourseAccessMode] || settings?.defaultCourseAccessMode || "—";
        if (whSecretEl) whSecretEl.textContent = settings?.hasStripeWebhookSecret ? "Configured ✓" : "Not set";
        if (stripeBadge) {
          const ok = Boolean(settings?.hasStripeWebhookSecret);
          stripeBadge.textContent = ok ? "Webhook Ready" : "Secret Needed";
          stripeBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }

        const resendBadge = document.getElementById("gi-resend-badge");
        const resendStatus = document.getElementById("gi-resend-status");
        const fromEmailEl = document.getElementById("gi-from-email");
        if (resendStatus) resendStatus.textContent = system?.hasResendKey ? "Configured ✓" : "Missing in Vercel";
        if (fromEmailEl) fromEmailEl.textContent = system?.fromEmail || "—";
        if (resendBadge) {
          const ok = Boolean(system?.hasResendKey);
          resendBadge.textContent = ok ? "Ready" : "Key Missing";
          resendBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }

        const aiBadge = document.getElementById("gi-ai-badge");
        const aiProvEl = document.getElementById("gi-ai-provider");
        const aiKeyEl = document.getElementById("gi-ai-key-status");
        if (aiProvEl) aiProvEl.textContent = settings?.aiProvider === "openai" ? "OpenAI (GPT-4o Mini)" : "Google Gemini (2.5 Flash)";
        if (aiKeyEl) aiKeyEl.textContent = settings?.hasAiApiKey ? "Saved in Postgres ✓" : "Not Configured";
        if (aiBadge) {
          const ok = Boolean(settings?.hasAiApiKey);
          aiBadge.textContent = ok ? "Ready" : "Key Missing";
          aiBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }

        const infraBadge = document.getElementById("gi-infra-badge");
        const vercelEnvEl = document.getElementById("gi-vercel-env");
        const pgEl = document.getElementById("gi-postgres-status");
        if (vercelEnvEl) vercelEnvEl.textContent = system?.isVercel ? `Vercel (${system.vercelEnv})` : "Local Dev";
        if (pgEl) pgEl.textContent = system?.hasPostgres ? "Connected ✓" : "Not Detected";
        if (infraBadge) {
          const ok = Boolean(system?.hasPostgres);
          infraBadge.textContent = ok ? "Online" : "Check DB";
          infraBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }
      } catch {
        // silent fallback
      }
    }

    document.getElementById("btn-refresh-general-info")?.addEventListener("click", () => {
      refreshGeneralInfo();
      showStudioToast("System status refreshed");
    });

    document.getElementById("gi-copy-webhook")?.addEventListener("click", () => {
      const inp = document.getElementById("gi-webhook-url") as HTMLInputElement | null;
      if (!inp) return;
      navigator.clipboard?.writeText(inp.value);
      showStudioToast("Copied Webhook URL!");
    });

    document.getElementById("gi-copy-redirect")?.addEventListener("click", () => {
      const inp = document.getElementById("gi-redirect-pattern") as HTMLInputElement | null;
      if (!inp) return;
      navigator.clipboard?.writeText(inp.value);
      showStudioToast("Copied Redirect URL pattern!");
    });

    document.querySelectorAll<HTMLButtonElement>("[data-jump-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.jumpTab;
        if (!target) return;
        const tab = document.querySelector<HTMLButtonElement>(`[data-module-tab="${target}"]`);
        tab?.click();
      });
    });

    window.addEventListener("academy:refresh-general-info", () => {
      refreshGeneralInfo();
    });

    // Clear active state on Academy sidebar items when switching back to other Studio modules
    document.querySelectorAll<HTMLButtonElement>("[data-module-tab]").forEach((tab) => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".nav-academy-item").forEach((b) => b.classList.remove("is-active"));
      });
    });

    renderSidebarLists();
    renderEditor();
    refreshGeneralInfo();
  })();
</script>

