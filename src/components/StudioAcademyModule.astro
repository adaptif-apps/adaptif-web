---
import { FUNNEL_BLOCKS, type AcademyItem, type AcademySettings } from "../lib/academyDb";
import {
  DEFAULT_PAYMENT_CATALOG,
  getPaymentSettings,
  type PaymentSettings
} from "../lib/paymentDb";
import AcademyGeneratorModal from "./AcademyGeneratorModal.astro";
import StudioHeader from "./StudioHeader.astro";
import StudioUpsellPanel from "./StudioUpsellPanel.astro";

interface Props {
  initialItems: AcademyItem[];
  initialSettings: AcademySettings;
}

const { initialItems, initialSettings } = Astro.props;

let paymentSettings: PaymentSettings = {
  activeProvider: "stripe",
  shopifyStoreDomain: "eqkk7t-qy.myshopify.com",
  hasShopifyStorefrontToken: false,
  hasShopifyWebhookSecret: false,
  catalog: DEFAULT_PAYMENT_CATALOG
};

try {
  paymentSettings = await getPaymentSettings();
} catch {
  // Fallback to defaults if DB env is not configured yet
}
---

<div id="module-academy" hidden>
  <StudioHeader eyebrow="CMS" title="Courses" titleId="acd-module-title" actionsId="acd-header-actions">
    <Fragment slot="actions">
      <div class="cms-header-dropdown" id="acd-edit-dropdown">
        <button type="button" class="cms-btn cms-dropdown-trigger" aria-expanded="false">
          Edit ▾
        </button>
        <div class="cms-dropdown-menu" hidden>
          <a href="#" target="_blank" rel="noopener noreferrer" id="acd-edit-content" class="cms-dropdown-item">
            Edit Content ↗
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" id="acd-edit-slides" class="cms-dropdown-item">
            Edit PDF / Slides ↗
          </a>
        </div>
      </div>

      <div class="cms-header-dropdown" id="acd-preview-dropdown">
        <button type="button" class="cms-btn cms-dropdown-trigger" aria-expanded="false">
          Preview ▾
        </button>
        <div class="cms-dropdown-menu" hidden>
          <a href="#" target="_blank" rel="noopener noreferrer" id="acd-preview-landing" class="cms-dropdown-item">
            Preview Landing ↗
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" id="acd-preview-slides" class="cms-dropdown-item">
            Preview Slides / PDF ↗
          </a>
        </div>
      </div>

      <button type="button" class="cms-btn cms-btn--danger" id="btn-delete-acd-item">Delete</button>
      <button type="submit" form="acd-editor-form" class="cms-btn cms-btn--save" id="btn-save-acd-item" disabled>Save Changes</button>

      <span class="studio-actions-divider" id="acd-actions-divider"></span>

      <button type="button" class="adaptif-btn adaptif-btn--sm" id="btn-new-guide">+ New Guide</button>
      <button type="button" class="adaptif-btn adaptif-btn--sm" id="btn-new-course">+ New Course</button>
    </Fragment>
  </StudioHeader>

  <div class="acd-studio-workspace">
    <!-- Left List: Courses or Guides -->
    <section class="acd-list-panel" aria-label="Academy items list">
      <div class="panel-search-wrap">
        <input
          type="search"
          id="acd-studio-search"
          class="panel-search"
          placeholder="Search items..."
          autocomplete="off"
        />
      </div>
      <div class="acd-studio-list" id="acd-studio-list"></div>
    </section>

    <!-- Right Column: Title + Tabs (Settings & Assets | AI Generator) -->
    <div class="acd-editor-col">
      <div class="cms-item-title-bar" id="acd-item-title-bar" hidden>
        <input
          type="text"
          id="acd-item-title-input"
          class="cms-item-title-input"
          placeholder="Course title..."
          aria-label="Item title"
        />
        <span class="cms-status-badge" id="acd-item-status-badge">Draft</span>
      </div>

      <div class="cms-tabs-bar" id="acd-tabs-bar" role="tablist">
        <button type="button" class="cms-tab-btn is-active" data-acd-tab="settings" role="tab" aria-selected="true">
          Settings &amp; Assets
        </button>
        <button type="button" class="cms-tab-btn" data-acd-tab="generator" role="tab" aria-selected="false">
          AI Generator
        </button>
        <button type="button" class="cms-tab-btn" data-acd-tab="upselling" role="tab" aria-selected="false">
          Upselling
        </button>
      </div>

      <!-- Tab 1: Settings & Assets (First / Default) -->
      <section class="acd-glass-card acd-settings-card" id="acd-tab-settings" aria-label="Course Settings and Assets">
        <div class="acd-editor-shell">
          <div class="acd-empty-editor" id="acd-empty-editor">
            Select an item from the list on the left, or click <strong>+ New</strong> above.
          </div>

          <form id="acd-editor-form" hidden>
            <div class="acd-form-grid">
              <label class="acd-field">
                <span class="acd-label-row">
                  Slug (URL)
                  <span class="acd-tip-wrap">
                    <button type="button" class="acd-tip-btn" aria-label="Slug info">?</button>
                    <span class="acd-tip-box" role="tooltip">
                      Public URL path for this item (e.g. <code>/academy/courses/my-course</code>). Also used in your Stripe redirect URL.
                    </span>
                  </span>
                </span>
                <input type="text" id="acd-slug" required />
              </label>

              <label class="acd-field">
                <span class="acd-label-row">
                  Category
                  <span class="acd-tip-wrap">
                    <button type="button" class="acd-tip-btn" aria-label="Category info">?</button>
                    <span class="acd-tip-box" role="tooltip">
                      Topic badge shown in the Academy catalog, course hero breadcrumb, and slide deck cover.
                    </span>
                  </span>
                </span>
                <input type="text" id="acd-category" placeholder="AI Workflows" />
              </label>

              <label class="acd-field">
                <span class="acd-label-row">
                  Publishing Status
                  <span class="acd-tip-wrap">
                    <button type="button" class="acd-tip-btn" aria-label="Publishing Status info">?</button>
                    <span class="acd-tip-box" role="tooltip">
                      <strong>Private (Draft)</strong> hides the item from the public catalog while you edit; <strong>Public</strong> publishes immediately.
                    </span>
                  </span>
                </span>
                <select id="gen-status" class="ac-select">
                  <option value="draft">Private (Draft — review before publishing)</option>
                  <option value="published">Public (Publish immediately)</option>
                  <option value="scheduled">Scheduled</option>
                </select>
              </label>

              <label class="acd-field" id="gen-publish-at-wrap" hidden>
                <span>Publish Date &amp; Time</span>
                <input type="datetime-local" id="gen-publish-at" />
              </label>
            </div>

            <!-- Course Pricing & Optional Micro-App (hidden for Guides) -->
            <div class="acd-course-box" id="gen-course-fields" style="margin-top: 16px;">
              <div class="acd-form-grid acd-prefs-grid">
                <label class="acd-field">
                  <span class="acd-label-row">
                    Course Price
                    <span class="acd-tip-wrap">
                      <button type="button" class="acd-tip-btn" aria-label="Course Price info">?</button>
                      <span class="acd-tip-box" role="tooltip">
                        Display price shown on the course hero, badges, and Buy Course CTA button (e.g. <code>$49</code>).
                      </span>
                    </span>
                  </span>
                  <input type="text" id="gen-price" placeholder="$49" value="$49" />
                </label>
                <label class="acd-field">
                  <span class="acd-label-row">
                    Stripe Checkout Link
                    <span class="acd-tip-wrap">
                      <button type="button" class="acd-tip-btn" aria-label="Stripe Checkout Link info">?</button>
                      <span class="acd-tip-box" role="tooltip">
                        Paste your Stripe Payment Link URL. In Stripe → After payment, set Redirect URL to <code>/academy/courses/&lt;slug&gt;/slides?checkout=success</code>.
                      </span>
                    </span>
                  </span>
                  <input type="url" id="gen-stripe-url" placeholder="https://buy.stripe.com/..." />
                </label>
                <label class="acd-field">
                  <span class="acd-label-row">
                    Shopify Variant ID
                    <span class="acd-tip-wrap">
                      <button type="button" class="acd-tip-btn" aria-label="Shopify Variant ID info">?</button>
                      <span class="acd-tip-box" role="tooltip">
                        Paste the Shopify Product Variant ID (numeric or <code>gid://shopify/ProductVariant/...</code>) used when Shopify is the active payment provider.
                      </span>
                    </span>
                  </span>
                  <input type="text" id="gen-shopify-variant-id" placeholder="e.g. 49281736451234" />
                </label>
              </div>

              <div class="acd-form-grid acd-prefs-grid" style="margin-top: 14px;">
                <label class="acd-field">
                  <span class="acd-label-row">
                    Tool / Template Name (Optional)
                    <span class="acd-tip-wrap">
                      <button type="button" class="acd-tip-btn" aria-label="Tool Name info">?</button>
                      <span class="acd-tip-box" role="tooltip">
                        Optional companion asset included with the course (unlocked after purchase &amp; linked in the buyer email).
                      </span>
                    </span>
                  </span>
                  <input type="text" id="gen-tool-name" placeholder="Magnific Preset Pack" />
                </label>
                <label class="acd-field">
                  <span>Tool Type (Optional)</span>
                  <input type="text" id="gen-tool-type" placeholder="Template / Micro-App / Mockups" />
                </label>
                <label class="acd-field">
                  <span class="acd-label-row">
                    Tool / Micro-App URL (Optional)
                    <span class="acd-tip-wrap">
                      <button type="button" class="acd-tip-btn" aria-label="Tool URL info">?</button>
                      <span class="acd-tip-box" role="tooltip">
                        Destination URL for the included template or micro-app. Only visible to unlocked buyers.
                      </span>
                    </span>
                  </span>
                  <input type="url" id="gen-tool-url" placeholder="https://..." />
                </label>
              </div>
            </div>

            <div class="acd-form-grid" style="margin-top: 16px;">
              <div class="acd-field">
                <span class="acd-label-row">
                  Thumbnail Image (16:9)
                </span>
                <div class="acd-pdf-override-row">
                  <img id="acd-cover-preview" src="" alt="Thumbnail preview" style="width: 112px; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; border: 1px solid rgba(156, 225, 255, 0.2); display: none;" />
                  <input type="file" id="acd-cover-img-input" accept="image/*" hidden />
                  <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-upload-cover-img">Upload Thumbnail</button>
                  <span class="acd-pdf-status" id="acd-cover-img-status">No thumbnail set</span>
                </div>
              </div>

              <div class="acd-field">
                <span class="acd-label-row">
                  Custom PDF Override (Optional)
                  <span class="acd-tip-wrap">
                    <button type="button" class="acd-tip-btn" aria-label="Custom PDF info">?</button>
                    <span class="acd-tip-box" role="tooltip">
                      Upload your own PDF to display it directly in the course PDF viewer instead of the AI-generated slides.
                    </span>
                  </span>
                </span>
                <div class="acd-pdf-override-row">
                  <input type="file" id="acd-custom-pdf-input" accept="application/pdf,.pdf" hidden />
                  <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-upload-custom-pdf">Upload Custom PDF</button>
                  <span class="acd-pdf-status" id="acd-custom-pdf-status">Using AI-generated slides</span>
                  <button type="button" class="cms-btn cms-btn--danger" id="btn-remove-custom-pdf" hidden>Remove PDF</button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </section>

      <!-- Tab 2: AI Curriculum Engine -->
      <section class="acd-glass-card" id="acd-tab-generator" aria-label="AI Curriculum Engine" hidden>
        <AcademyGeneratorModal initialSettings={initialSettings} />
      </section>

      <!-- Tab 3: Upselling -->
      <section class="acd-glass-card" id="acd-tab-upselling" aria-label="Upselling configuration" hidden>
        <StudioUpsellPanel prefix="acd" allowGuide={false} showPlacement={false} />
      </section>
    </div>
  </div>
</div>

<!-- General Payment & Stripe / Shopify Access Control Module (Left Sidebar: Payment) -->
<div id="module-payment" hidden>
  <StudioHeader eyebrow="CONFIGURATION" title="Payment">
    <button slot="actions" type="button" class="adaptif-btn adaptif-btn--sm" id="btn-save-acd-settings">Save Preferences</button>
  </StudioHeader>

  <section class="acd-glass-card acd-prefs-card pay-switcher-card" aria-label="Active Payment Provider">
    <div class="pay-switcher-row">
      <div>
        <span class="acd-section-kicker">1-Click Checkout Engine</span>
        <h2 class="acd-card-title" style="margin-bottom: 4px;">Active Payment Provider</h2>
        <p class="acd-card-sub" style="margin: 0;">
          Switch between Stripe and Shopify with one click across Academy courses, Pricing plans, and Strategic Audit.
        </p>
      </div>
      <div class="pay-provider-pills" role="group" aria-label="Select active payment provider">
        <button
          type="button"
          class:list={["pay-provider-btn", { "is-active": paymentSettings.activeProvider === "stripe" }]}
          data-payment-provider="stripe"
        >
          <span class="pay-provider-dot"></span>
          Stripe
        </button>
        <button
          type="button"
          class:list={["pay-provider-btn", { "is-active": paymentSettings.activeProvider === "shopify" }]}
          data-payment-provider="shopify"
        >
          <span class="pay-provider-dot"></span>
          Shopify API
        </button>
      </div>
    </div>
  </section>

  <div class="acd-config-two-col">
    <div class="pay-left-stack">
      <section class="acd-glass-card acd-prefs-card" aria-label="Course Access & Stripe Preferences">
      <div class="acd-prefs-head">
        <div>
          <span class="acd-section-kicker">Global Course Checkout</span>
          <h2 class="acd-card-title">Course Access Preferences</h2>
          <p class="acd-card-sub">
            Configure how paid courses unlock after checkout across all courses. Paste individual Stripe Payment Links on each course.
          </p>
        </div>
      </div>

      <div class="acd-prefs-grid">
        <label class="acd-field">
          <span class="acd-label-row">
            Default Course Access Mode
            <span class="acd-tip-wrap">
              <button type="button" class="acd-tip-btn" aria-label="Access mode info">?</button>
              <span class="acd-tip-box" role="tooltip">
                Controls how all paid courses unlock: <strong>Stripe Webhook</strong> verifies payment tokens &amp; sends backup email; <strong>Checkout Redirect</strong> unlocks via <code>?checkout=success</code>; <strong>Open</strong> disables the paywall.
              </span>
            </span>
          </span>
          <select id="acd-default-access-mode" class="ac-select">
            <option value="stripe_webhook" selected={initialSettings.defaultCourseAccessMode === "stripe_webhook"}>
              Option A: Stripe Webhook + Secure Token (Recommended)
            </option>
            <option value="checkout_redirect" selected={initialSettings.defaultCourseAccessMode === "checkout_redirect"}>
              Simple Checkout Redirect (?checkout=success)
            </option>
            <option value="open" selected={initialSettings.defaultCourseAccessMode === "open"}>
              Open Access (No Gate)
            </option>
          </select>
        </label>

        <label class="acd-field">
          <span class="acd-label-row">
            Stripe Webhook Secret (whsec_...)
            <a
              href="https://dashboard.stripe.com/webhooks"
              target="_blank"
              rel="noopener noreferrer"
              class="studio-link studio-link--inline"
            >
              Open Stripe Webhooks ↗
            </a>
            <span class="acd-tip-wrap">
              <button type="button" class="acd-tip-btn" aria-label="Webhook secret info">?</button>
              <span class="acd-tip-box" role="tooltip">
                Found in Stripe Dashboard → Developers → Webhooks → Signing secret. Required to verify <code>checkout.session.completed</code> events before emailing course access and recording purchases.
              </span>
            </span>
          </span>
          <input
            type="password"
            id="acd-stripe-secret"
            placeholder={initialSettings.hasStripeWebhookSecret ? "Saved (leave blank to keep)" : "whsec_..."}
          />
        </label>

        <div class="acd-field">
          <span class="acd-label-row">
            Stripe Webhook Endpoint
            <span class="acd-tip-wrap">
              <button type="button" class="acd-tip-btn" aria-label="Webhook endpoint info">?</button>
              <span class="acd-tip-box" role="tooltip">
                Paste this URL in Stripe → Developers → Webhooks and enable the <code>checkout.session.completed</code> event.
              </span>
            </span>
          </span>
          <div class="acd-copy-row">
            <input type="text" id="acd-webhook-url" readonly value="/api/academy/stripe-webhook" />
            <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-copy-webhook">Copy</button>
          </div>
        </div>
      </div>
    </section>

      <section class="acd-glass-card acd-prefs-card" aria-label="Shopify Storefront API Preferences">
        <div class="acd-prefs-head">
          <div>
            <span class="acd-section-kicker">Shopify Storefront API</span>
            <h2 class="acd-card-title">Shopify Checkout Credentials</h2>
            <p class="acd-card-sub">
              Creates dynamic Shopify checkouts via Storefront API (<code>cartCreate</code>) and unlocks courses via <code>orders/paid</code> webhook.
            </p>
          </div>
        </div>

        <div class="acd-prefs-grid">
          <label class="acd-field">
            <span class="acd-label-row">
              Shopify Store Domain
              <a
                href={`https://admin.shopify.com/store/${(paymentSettings.shopifyStoreDomain || "eqkk7t-qy.myshopify.com").replace(/\.myshopify\.com$/i, "")}`}
                target="_blank"
                rel="noopener noreferrer"
                class="studio-link studio-link--inline"
              >
                Open Shopify Admin ↗
              </a>
            </span>
            <input
              type="text"
              id="pay-shopify-domain"
              value={paymentSettings.shopifyStoreDomain}
              placeholder="eqkk7t-qy.myshopify.com"
            />
          </label>

          <label class="acd-field">
            <span class="acd-label-row">
              Storefront Access Token
              <span class="acd-tip-wrap">
                <button type="button" class="acd-tip-btn" aria-label="Storefront Access Token info">?</button>
                <span class="acd-tip-box" role="tooltip">
                  Found in Shopify Admin → Sales channels → Headless → Storefront API → Public access token.
                </span>
              </span>
            </span>
            <input
              type="password"
              id="pay-shopify-token"
              placeholder={paymentSettings.hasShopifyStorefrontToken ? "Saved (leave blank to keep)" : "shpat_... or public storefront token"}
            />
          </label>

          <label class="acd-field">
            <span class="acd-label-row">
              Shopify Webhook Secret
              <span class="acd-tip-wrap">
                <button type="button" class="acd-tip-btn" aria-label="Shopify Webhook Secret info">?</button>
                <span class="acd-tip-box" role="tooltip">
                  Found in Shopify Admin → Settings → Notifications → Webhooks (signing secret at the bottom of the page).
                </span>
              </span>
            </span>
            <input
              type="password"
              id="pay-shopify-secret"
              placeholder={paymentSettings.hasShopifyWebhookSecret ? "Saved (leave blank to keep)" : "Webhook signing secret"}
            />
          </label>

          <div class="acd-field">
            <span class="acd-label-row">Shopify Webhook Endpoint</span>
            <div class="acd-copy-row">
              <input type="text" id="pay-shopify-webhook-url" readonly value="/api/payments/shopify-webhook" />
              <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-copy-shopify-webhook">Copy</button>
            </div>
          </div>
        </div>
      </section>

      <section class="acd-glass-card acd-prefs-card" aria-label="Plans & Audit Product Mapping">
        <div class="acd-prefs-head">
          <div>
            <span class="acd-section-kicker">Pricing &amp; Audit Pages</span>
            <h2 class="acd-card-title">Plans &amp; Audit Checkout Mapping</h2>
            <p class="acd-card-sub">
              Map each Pricing Plan and the Strategic Audit to its Stripe Payment Link and Shopify Variant ID. Leave blank to keep the default Contact / Book a Call flow.
            </p>
          </div>
        </div>

        <div class="pay-catalog-list">
          {paymentSettings.catalog.map((entry) => (
            <div class="pay-catalog-row" data-catalog-key={entry.key}>
              <div class="pay-catalog-head">
                <span class="pay-catalog-badge">{entry.kind === "audit" ? "AUDIT" : "PLAN"}</span>
                <strong>{entry.label}</strong>
                <code class="pay-catalog-key">{entry.key}</code>
              </div>
              <div class="pay-catalog-fields">
                <label class="acd-field">
                  <span class="acd-label-row">Stripe Payment Link</span>
                  <input
                    type="url"
                    class="pay-cat-stripe"
                    value={entry.stripeCheckoutUrl}
                    placeholder="https://buy.stripe.com/..."
                  />
                </label>
                <label class="acd-field">
                  <span class="acd-label-row">Shopify Variant ID</span>
                  <input
                    type="text"
                    class="pay-cat-variant"
                    value={entry.shopifyVariantId}
                    placeholder="e.g. 49281736451234"
                  />
                </label>
                {entry.kind === "plan" && (
                  <label class="acd-field">
                    <span class="acd-label-row">Selling Plan ID (Optional)</span>
                    <input
                      type="text"
                      class="pay-cat-selling-plan"
                      value={entry.shopifySellingPlanId}
                      placeholder="For monthly subscriptions"
                    />
                  </label>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <aside class="acd-glass-card acd-prefs-card acd-guide-aside" aria-label="Payment Setup Guide">
      <span class="acd-section-kicker">Quick Setup</span>
      <h3 class="acd-card-title" style="margin-bottom: 10px;">Connect Your Stripe Account</h3>
      <div class="acd-stripe-guide" style="margin-top: 0;">
        <ol class="acd-stripe-guide-steps">
          <li>
            Open
            <a href="https://dashboard.stripe.com/webhooks/create" target="_blank" rel="noopener noreferrer" class="studio-link studio-link--inline">
              Stripe → Developers → Webhooks ↗
            </a>
            and click <strong>Add endpoint</strong> (or <strong>Add destination</strong>).
          </li>
          <li>
            Paste the <strong>Stripe Webhook Endpoint</strong> URL and select the event:
            <span class="acd-event-chip">
              <code>checkout.session.completed</code>
              <button type="button" class="acd-chip-copy" id="btn-copy-stripe-event">Copy Event</button>
            </span>
          </li>
          <li>
            Copy the <strong>Signing secret (<code>whsec_...</code>)</strong> from Stripe, paste it into <strong>Stripe Webhook Secret</strong>, and click <strong>Save Preferences</strong>.
          </li>
        </ol>
      </div>

      <div class="pay-guide-divider"></div>

      <span class="acd-section-kicker">Shopify API Setup</span>
      <h3 class="acd-card-title" style="margin-bottom: 10px;">Connect Your Shopify Store</h3>
      <div class="acd-stripe-guide" style="margin-top: 0;">
        <ol class="acd-stripe-guide-steps">
          <li>
            In Shopify Admin, go to <strong>Sales channels → Headless</strong> (install if needed) and copy your <strong>Storefront API Public access token</strong>.
          </li>
          <li>
            Create products for your Courses, Plans, and Audit, and copy each <strong>Variant ID</strong> into the corresponding field.
          </li>
          <li>
            Under <strong>Settings → Notifications → Webhooks</strong>, add the <strong>Shopify Webhook Endpoint</strong> for event:
            <span class="acd-event-chip">
              <code>orders/paid</code>
              <button type="button" class="acd-chip-copy" id="btn-copy-shopify-event">Copy Event</button>
            </span>
          </li>
        </ol>
      </div>
    </aside>
  </div>
</div>

<!-- AI Engine Configuration Module (Left Sidebar: AI Engine) -->
<div id="module-ai-config" hidden>
  <StudioHeader eyebrow="CONFIGURATION" title="AI Engine">
    <button slot="actions" type="button" class="adaptif-btn adaptif-btn--sm" id="btn-save-ai-key">Save AI Configuration</button>
  </StudioHeader>

  <div class="acd-config-two-col">
    <section class="acd-glass-card acd-prefs-card" aria-label="AI Engine Configuration">
      <div class="acd-prefs-head">
        <div>
          <span class="acd-section-kicker">Provider &amp; Credentials</span>
          <h2 class="acd-card-title">AI Generator Model &amp; API Key</h2>
          <p class="acd-card-sub">
            Choose the LLM provider used to synthesize uploaded docs, links, and notes into Courses and Guides.
          </p>
        </div>
      </div>

      <div class="acd-prefs-grid">
        <label class="acd-field">
          <span class="acd-label-row">
            AI Provider
            <span class="acd-tip-wrap">
              <button type="button" class="acd-tip-btn" aria-label="AI Provider info">?</button>
              <span class="acd-tip-box" role="tooltip">
                Select the LLM engine used by the AI Curriculum Generator to synthesize docs, links, and notes into full course funnels.
              </span>
            </span>
          </span>
          <select id="gen-ai-provider" class="ac-select">
            <option value="gemini" selected={initialSettings.aiProvider !== "openai"}>Google Gemini (2.5 Flash)</option>
            <option value="openai" selected={initialSettings.aiProvider === "openai"}>OpenAI (GPT-4o Mini)</option>
          </select>
        </label>

        <label class="acd-field acd-span-2">
          <span class="acd-label-row">
            <a
              id="gen-ai-key-link"
              class="studio-link studio-link--inline"
              href={initialSettings.aiProvider === "openai"
                ? "https://platform.openai.com/api-keys"
                : "https://aistudio.google.com/app/apikey"}
              target="_blank"
              rel="noopener noreferrer"
              title={initialSettings.aiProvider === "openai"
                ? "Open OpenAI API Keys"
                : "Open Google AI Studio API Keys"}
            >
              API Key ↗
            </a>
            <span class="acd-tip-wrap">
              <button type="button" class="acd-tip-btn" aria-label="API Key info">?</button>
              <span class="acd-tip-box" role="tooltip">
                Stored encrypted in Postgres. Leave blank when saving if you want to keep your existing saved key.
              </span>
            </span>
          </span>
          <input
            type="password"
            id="gen-ai-key"
            placeholder={initialSettings.hasAiApiKey ? "Saved (leave blank to keep)" : "Paste Gemini or OpenAI API key..."}
          />
        </label>
      </div>
    </section>

    <aside class="acd-glass-card acd-prefs-card acd-guide-aside" aria-label="AI Engine Status">
      <div class="acd-prefs-head" style="margin-bottom: 14px;">
        <div>
          <span class="acd-section-kicker">Connection Status</span>
          <h3 class="acd-card-title">Active Generator</h3>
        </div>
        <div class="acd-ai-status-pill">
          <span class:list={["acd-status-dot", { "is-ready": initialSettings.hasAiApiKey }]} id="gen-ai-dot"></span>
          <span id="gen-ai-status-text">
            {initialSettings.hasAiApiKey
              ? `${initialSettings.aiProvider === "openai" ? "OpenAI" : "Gemini"} Ready`
              : "Not Configured"}
          </span>
        </div>
      </div>
      <p class="acd-card-sub" style="margin: 0 0 12px;">
        Powers curriculum synthesis, slide generation, and structured guide creation inside <strong>Courses</strong> and <strong>Guides</strong>.
      </p>
      <p class="acd-card-sub" style="margin: 0; font-size: 0.8rem; color: #94a3b8;">
        Keys are encrypted at rest in Postgres and never exposed to the public website.
      </p>
    </aside>
  </div>
</div>

<!-- General Info / System Overview Module (Left Sidebar: General Info) -->
<div id="module-general-info" hidden>
  <StudioHeader eyebrow="CONFIGURATION" title="General Info">
    <button slot="actions" type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-refresh-general-info">Refresh Status</button>
  </StudioHeader>

  <div class="gi-grid">
    <!-- Card 1: Stripe & Checkout Flow -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Payments &amp; Delivery</span>
          <h2 class="acd-card-title">Stripe Checkout &amp; Webhook</h2>
        </div>
        <span class="gi-badge" id="gi-stripe-badge">Checking...</span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>Active Access Mode</span>
          <strong id="gi-access-mode">{initialSettings.defaultCourseAccessMode}</strong>
        </div>
        <div class="gi-row">
          <span>Webhook Secret (whsec_)</span>
          <strong id="gi-webhook-secret-status">{initialSettings.hasStripeWebhookSecret ? "Configured" : "Not set"}</strong>
        </div>
        <div class="gi-row-col">
          <span>Stripe Webhook Endpoint</span>
          <div class="acd-copy-row">
            <input type="text" id="gi-webhook-url" readonly value="/api/academy/stripe-webhook" />
            <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="gi-copy-webhook">Copy</button>
          </div>
        </div>
        <div class="gi-row-col">
          <span>Stripe Redirect URL Pattern (After Payment)</span>
          <div class="acd-copy-row">
            <input type="text" id="gi-redirect-pattern" readonly value="/academy/courses/<slug>/slides?checkout=success" />
            <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="gi-copy-redirect">Copy</button>
          </div>
        </div>
      </div>
      <div class="gi-card-foot">
        <button type="button" class="cms-btn cms-btn--save" data-jump-tab="payment">Configure Payment →</button>
      </div>
    </section>

    <!-- Card 2: Email Delivery (Resend.com) -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Automated Backup Email</span>
          <h2 class="acd-card-title">Resend.com Delivery</h2>
        </div>
        <span class="gi-badge" id="gi-resend-badge">Checking...</span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>RESEND_API_KEY (Vercel)</span>
          <strong id="gi-resend-status">Checking...</strong>
        </div>
        <div class="gi-row">
          <span>Sender (ACADEMY_FROM_EMAIL)</span>
          <strong id="gi-from-email">—</strong>
        </div>
      </div>
      <p class="gi-note">
        When a customer completes a Stripe Payment Link, the webhook sends a backup email with their direct Slides &amp; PDF link.
      </p>
      <div class="gi-checklist">
        <span>1. Create an API key at <a href="https://resend.com" target="_blank" rel="noopener noreferrer">resend.com</a></span>
        <span>2. Add <code>RESEND_API_KEY</code> &amp; <code>ACADEMY_FROM_EMAIL</code> in Vercel → Settings → Environment Variables</span>
      </div>
    </section>

    <!-- Card 3: AI Curriculum Engine -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Content Synthesis</span>
          <h2 class="acd-card-title">AI Curriculum Engine</h2>
        </div>
        <span class="gi-badge" id="gi-ai-badge">
          {initialSettings.hasAiApiKey ? "Ready" : "Key Missing"}
        </span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>Active Provider</span>
          <strong id="gi-ai-provider">{initialSettings.aiProvider === "openai" ? "OpenAI (GPT-4o Mini)" : "Google Gemini (2.5 Flash)"}</strong>
        </div>
        <div class="gi-row">
          <span>API Key Status</span>
          <strong id="gi-ai-key-status">{initialSettings.hasAiApiKey ? "Saved in Postgres" : "Not Configured"}</strong>
        </div>
        <div class="gi-row">
          <span>Catalog Items</span>
          <strong id="gi-catalog-counts">—</strong>
        </div>
      </div>
      <div class="gi-card-foot">
        <button type="button" class="cms-btn cms-btn--save" data-jump-tab="ai-config">Configure AI Engine →</button>
      </div>
    </section>

    <!-- Card 4: Hosting & Database (Vercel + Postgres) -->
    <section class="acd-glass-card gi-card">
      <div class="gi-card-head">
        <div>
          <span class="acd-section-kicker">Infrastructure</span>
          <h2 class="acd-card-title">Vercel &amp; Postgres</h2>
        </div>
        <span class="gi-badge is-ok" id="gi-infra-badge">Checking...</span>
      </div>
      <div class="gi-rows">
        <div class="gi-row">
          <span>Runtime Environment</span>
          <strong id="gi-vercel-env">—</strong>
        </div>
        <div class="gi-row">
          <span>Postgres Database</span>
          <strong id="gi-postgres-status">Checking...</strong>
        </div>
        <div class="gi-row">
          <span>Active Origin</span>
          <strong id="gi-origin">—</strong>
        </div>
      </div>
      <p class="gi-note">
        All courses, guides, frontend edits, funnel block visibility, and Stripe settings persist in Postgres and deploy via Vercel.
      </p>
    </section>
  </div>
</div>

<script define:vars={{ initialItems, initialSettings }}>
  window.__INITIAL_ACADEMY_ITEMS__ = initialItems;
  window.__INITIAL_ACADEMY_SETTINGS__ = initialSettings;
</script>

<script>
  import { createUpsellPanelController } from "../lib/studioUpsellClient";

  (() => {
    const w = window as any;
    let items: any[] = Array.isArray(w.__INITIAL_ACADEMY_ITEMS__) ? [...w.__INITIAL_ACADEMY_ITEMS__] : [];
    let selectedId: string | null = items[0]?.id ?? null;
    const acdUpsellCtrl = createUpsellPanelController("acd");
    const syncUpsellCatalog = () => {
      const courseList = items.filter((i) => i.kind === "course");
      const guideList = items.filter((i) => i.kind === "guide");
      acdUpsellCtrl.setCatalog(courseList, guideList);
    };
    syncUpsellCatalog();

    const formEl = document.getElementById("acd-editor-form") as HTMLFormElement | null;
    const emptyEl = document.getElementById("acd-empty-editor");
    const slidesContainer = document.getElementById("acd-slides-container");
    const courseOnlyEl = document.getElementById("acd-course-only");
    const prefsSectionEl = document.getElementById("acd-prefs-section");
    const publishAtWrap = document.getElementById("acd-publish-at-wrap");
    const webhookUrlInput = document.getElementById("acd-webhook-url") as HTMLInputElement | null;
    const titleHeaderEl = document.getElementById("acd-module-title");
    const eyebrowHeaderEl = document.getElementById("acd-module-eyebrow");

    const sidebarCoursesList = document.getElementById("sidebar-courses-list");
    const sidebarGuidesList = document.getElementById("sidebar-guides-list");
    const sidebarCoursesCount = document.getElementById("sidebar-courses-count");
    const sidebarGuidesCount = document.getElementById("sidebar-guides-count");

    if (webhookUrlInput) {
      webhookUrlInput.value = `${window.location.origin}/api/academy/stripe-webhook`;
    }

    const showStudioToast = (msg: string) => {
      const toast = document.getElementById("studio-toast");
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add("is-visible");
      setTimeout(() => toast.classList.remove("is-visible"), 2600);
    };

    const el = (id: string) =>
      document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;

    function escapeHtml(str: string) {
      return String(str ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function activateAcademyModule() {
      const academyModule = document.getElementById("module-academy");

      document.querySelectorAll<HTMLButtonElement>("[data-module-tab]").forEach((t) => {
        t.classList.remove("is-active");
        t.removeAttribute("aria-current");
      });

      document.querySelectorAll<HTMLElement>(".studio-main > [id^='module-']").forEach((mod) => {
        mod.hidden = mod.id !== "module-academy";
      });
      if (academyModule) academyModule.hidden = false;
    }

    let activeKind: "course" | "guide" = "course";
    const acdListEl = document.getElementById("acd-studio-list");
    const acdSearchEl = document.getElementById("acd-studio-search") as HTMLInputElement | null;

    function renderSidebarLists() {
      const courses = items.filter((i) => i.kind === "course");
      const guides = items.filter((i) => i.kind === "guide");

      if (sidebarCoursesCount) sidebarCoursesCount.textContent = String(courses.length);
      if (sidebarGuidesCount) sidebarGuidesCount.textContent = String(guides.length);

      if (acdSearchEl) {
        acdSearchEl.placeholder = activeKind === "course" ? "Search courses..." : "Search guides...";
      }

      if (acdListEl) {
        const q = (acdSearchEl?.value || "").trim().toLowerCase();
        const pool = activeKind === "course" ? courses : guides;
        const filtered = pool.filter(
          (it) => !q || (it.title || "").toLowerCase().includes(q) || (it.category || "").toLowerCase().includes(q)
        );
        acdListEl.innerHTML =
          filtered
            .map((it) => {
              const isActive = it.id === selectedId;
              const statusLabel =
                it.status === "published" ? "● Published" : it.status === "scheduled" ? "◷ Scheduled" : "○ Draft";
              const slidesCount = Array.isArray(it.slides) ? it.slides.length : 0;
              return `
                <button type="button" class="acd-list-item ${isActive ? "is-active" : ""}" data-acd-item-id="${it.id}">
                  <span class="acd-li-title">${escapeHtml(it.title)}</span>
                  <span class="acd-li-meta">
                    <span>${statusLabel}</span>
                    <span>${slidesCount} slides</span>
                  </span>
                </button>
              `;
            })
            .join("") || `<div class="nav-acd-empty">No ${activeKind}s yet</div>`;

        acdListEl.querySelectorAll<HTMLButtonElement>("[data-acd-item-id]").forEach((btn) => {
          btn.addEventListener("click", () => {
            selectedId = btn.dataset.acdItemId || null;
            try {
              if (selectedId) localStorage.setItem("adaptif_studio_academy_id", selectedId);
            } catch {}
            renderSidebarLists();
            renderEditor();
            switchAcdTab("settings");
          });
        });
      }
    }

    acdSearchEl?.addEventListener("input", renderSidebarLists);

    window.addEventListener("academy:select-kind", (e: any) => {
      const k = e?.detail?.kind === "guide" ? "guide" : "course";
      activeKind = k;
      const cur = items.find((i) => i.id === selectedId);
      if (!cur || cur.kind !== activeKind) {
        selectedId = items.find((i) => i.kind === activeKind)?.id || null;
      }
      toggleKindAndStatusUI(activeKind);
      renderSidebarLists();
      renderEditor();
    });

    function switchAcdTab(tab: "settings" | "generator" | "upselling") {
      document.querySelectorAll<HTMLButtonElement>("[data-acd-tab]").forEach((btn) => {
        const active = btn.dataset.acdTab === tab;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
      });
      const settingsPanel = document.getElementById("acd-tab-settings");
      const genPanel = document.getElementById("acd-tab-generator");
      const upsellPanel = document.getElementById("acd-tab-upselling");
      if (settingsPanel) settingsPanel.hidden = tab !== "settings";
      if (genPanel) genPanel.hidden = tab !== "generator";
      if (upsellPanel) upsellPanel.hidden = tab !== "upselling";
    }

    document.querySelectorAll<HTMLButtonElement>("[data-acd-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        switchAcdTab((btn.dataset.acdTab as "settings" | "generator" | "upselling") || "settings");
      });
    });

    // Header dropdowns (Edit / Preview)
    document.querySelectorAll<HTMLElement>("#acd-header-actions .cms-header-dropdown").forEach((dd) => {
      const trigger = dd.querySelector<HTMLButtonElement>(".cms-dropdown-trigger");
      const menu = dd.querySelector<HTMLElement>(".cms-dropdown-menu");
      trigger?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = !menu?.hidden;
        document.querySelectorAll<HTMLElement>(".cms-header-dropdown .cms-dropdown-menu").forEach((m) => {
          m.hidden = true;
        });
        document.querySelectorAll<HTMLButtonElement>(".cms-header-dropdown .cms-dropdown-trigger").forEach((t) => {
          t.setAttribute("aria-expanded", "false");
        });
        if (menu && !isOpen) {
          menu.hidden = false;
          trigger.setAttribute("aria-expanded", "true");
        }
      });
    });
    document.addEventListener("click", () => {
      document.querySelectorAll<HTMLElement>(".cms-header-dropdown .cms-dropdown-menu").forEach((m) => {
        m.hidden = true;
      });
      document.querySelectorAll<HTMLButtonElement>(".cms-header-dropdown .cms-dropdown-trigger").forEach((t) => {
        t.setAttribute("aria-expanded", "false");
      });
    });

    function toggleKindAndStatusUI(kind: string = "course") {
      if (prefsSectionEl) prefsSectionEl.hidden = kind !== "course";

      const newGuideBtn = document.getElementById("btn-new-guide");
      const newCourseBtn = document.getElementById("btn-new-course");
      if (newGuideBtn) newGuideBtn.hidden = kind !== "guide";
      if (newCourseBtn) newCourseBtn.hidden = kind !== "course";

      if (titleHeaderEl) {
        titleHeaderEl.textContent = kind === "course" ? "Courses" : "Guides";
      }
    }

    function renderEditor() {
      const item = items.find((i) => i.id === selectedId);
      const titleBarEl = document.getElementById("acd-item-title-bar");
      const itemTitleInput = el("acd-item-title-input") as HTMLInputElement | null;
      const statusBadgeEl = document.getElementById("acd-item-status-badge");
      const editDd = document.getElementById("acd-edit-dropdown");
      const previewDd = document.getElementById("acd-preview-dropdown");
      const delBtn = document.getElementById("btn-delete-acd-item");
      const saveBtn = document.getElementById("btn-save-acd-item");
      const dividerEl = document.getElementById("acd-actions-divider");

      if (!item || !formEl || !emptyEl) {
        if (titleHeaderEl) titleHeaderEl.textContent = activeKind === "course" ? "Courses" : "Guides";
        if (titleBarEl) titleBarEl.hidden = true;
        if (editDd) editDd.hidden = true;
        if (previewDd) previewDd.hidden = true;
        if (delBtn) delBtn.hidden = true;
        if (saveBtn) saveBtn.hidden = true;
        if (dividerEl) dividerEl.hidden = true;
        if (formEl) formEl.hidden = true;
        if (emptyEl) emptyEl.hidden = false;
        window.dispatchEvent(new CustomEvent("academy:selection-changed", { detail: { item: null } }));
        return;
      }

      if (titleBarEl) titleBarEl.hidden = false;
      if (editDd) editDd.hidden = false;
      if (previewDd) previewDd.hidden = false;
      if (delBtn) delBtn.hidden = false;
      if (saveBtn) saveBtn.hidden = false;
      if (dividerEl) dividerEl.hidden = false;

      if (itemTitleInput) {
        itemTitleInput.value = item.title || "";
        itemTitleInput.placeholder = item.kind === "course" ? "Course title..." : "Guide title...";
      }
      if (statusBadgeEl) {
        const st = item.status || "draft";
        statusBadgeEl.textContent = st === "published" ? "Published" : st === "scheduled" ? "Scheduled" : "Draft";
        statusBadgeEl.className = `cms-status-badge is-${st}`;
      }

      emptyEl.hidden = true;
      formEl.hidden = false;

      el("acd-slug")!.value = item.slug || "";
      el("acd-category")!.value = item.category || "";

      const activeCover = pendingCoverImage ?? item.coverImage ?? "";
      if (coverPreviewEl) {
        if (activeCover) {
          coverPreviewEl.src = activeCover;
          coverPreviewEl.style.display = "block";
        } else {
          coverPreviewEl.style.display = "none";
        }
      }
      if (coverImgStatusEl) {
        coverImgStatusEl.textContent = activeCover ? "Active thumbnail set" : "No thumbnail set";
      }

      // Sync shared Course / Publishing fields in the unified generator block
      const setSharedVal = (id: string, val: string) => {
        const input = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
        if (input) input.value = val;
      };
      setSharedVal("gen-price", item.priceLabel || "$49");
      setSharedVal("gen-stripe-url", item.stripeCheckoutUrl || "");
      setSharedVal("gen-shopify-variant-id", item.shopifyVariantId || "");
      setSharedVal("gen-tool-name", item.toolName || "");
      setSharedVal("gen-tool-type", item.toolType || "");
      setSharedVal("gen-tool-url", item.toolUrl || "");

      const genStatusEl = document.getElementById("gen-status") as HTMLSelectElement | null;
      if (genStatusEl) {
        genStatusEl.value = item.status || "draft";
        (window as any).__STUDIO_SYNC_SELECT__?.(genStatusEl);
      }
      const genPublishAtEl = document.getElementById("gen-publish-at") as HTMLInputElement | null;
      const genPublishAtWrap = document.getElementById("gen-publish-at-wrap");
      if (genPublishAtEl) {
        genPublishAtEl.value = item.publishAt ? new Date(item.publishAt).toISOString().slice(0, 16) : "";
      }
      if (genPublishAtWrap) {
        genPublishAtWrap.hidden = item.status !== "scheduled";
      }

      window.dispatchEvent(new CustomEvent("academy:kind-changed", { detail: { kind: item.kind } }));
      window.dispatchEvent(
        new CustomEvent("academy:selection-changed", {
          detail: { item: { id: item.id, kind: item.kind, title: item.title } }
        })
      );

      const baseFolder = item.kind === "course" ? "courses" : "guides";
      const editContentLink = document.getElementById("acd-edit-content") as HTMLAnchorElement | null;
      const editSlidesLink = document.getElementById("acd-edit-slides") as HTMLAnchorElement | null;
      const landingPreview = document.getElementById("acd-preview-landing") as HTMLAnchorElement | null;
      const slidesPreview = document.getElementById("acd-preview-slides") as HTMLAnchorElement | null;
      if (editContentLink) {
        editContentLink.href = `/academy/${baseFolder}/${item.slug}?edit=1`;
        editContentLink.hidden = false;
      }
      if (editSlidesLink) {
        editSlidesLink.href = `/academy/${baseFolder}/${item.slug}/slides?edit=1`;
        editSlidesLink.hidden = false;
      }
      if (landingPreview) landingPreview.href = `/academy/${baseFolder}/${item.slug}`;
      if (slidesPreview) slidesPreview.href = `/academy/${baseFolder}/${item.slug}/slides?preview=1`;

      const pdfStatusEl = document.getElementById("acd-custom-pdf-status");
      const removePdfBtn = document.getElementById("btn-remove-custom-pdf");
      const effectivePdfUrl =
        pendingCustomPdfUrl !== undefined
          ? pendingCustomPdfUrl || ""
          : item.landingData?.customPdfUrl?.trim() || "";
      const hasCustomPdf = Boolean(effectivePdfUrl);
      const isPendingPdfChange = pendingCustomPdfUrl !== undefined;
      if (pdfStatusEl) {
        if (hasCustomPdf) {
          const rawName = decodeURIComponent(effectivePdfUrl.split("/").pop()?.split("?")[0] || "custom.pdf");
          const cleanName = rawName.replace(/^\d+-/, "").replace(/-[A-Za-z0-9]{20,}(\.pdf)$/i, "$1");
          const prefix = isPendingPdfChange ? "Pending PDF (click Save Changes):" : "Active PDF:";
          pdfStatusEl.innerHTML = `${prefix} <a href="${effectivePdfUrl}" target="_blank" rel="noopener noreferrer" title="${cleanName}" style="color:inherit;text-decoration:underline;">${cleanName}</a>`;
        } else {
          pdfStatusEl.textContent = isPendingPdfChange
            ? "PDF removal pending (click Save Changes)"
            : "Using AI-generated slides";
        }
        pdfStatusEl.classList.toggle("is-active", hasCustomPdf);
      }
      if (removePdfBtn) removePdfBtn.hidden = !hasCustomPdf;
      if (editSlidesLink) {
        editSlidesLink.classList.toggle("is-disabled", hasCustomPdf);
        if (hasCustomPdf) {
          editSlidesLink.setAttribute("aria-disabled", "true");
          editSlidesLink.setAttribute("title", "Disabled while Custom PDF is active");
          editSlidesLink.href = "#";
        } else {
          editSlidesLink.removeAttribute("aria-disabled");
          editSlidesLink.removeAttribute("title");
          editSlidesLink.href = `/academy/${baseFolder}/${item.slug}/slides?edit=1`;
        }
      }

      toggleKindAndStatusUI(item.kind);
      syncUpsellCatalog();
      acdUpsellCtrl.setContext(
        item.kind === "course" ? "course" : "guide",
        item.slug || "",
        item.landingData?.upsell
      );
    }

    async function createItem(kind: "guide" | "course") {
      const res = await fetch("/api/academy/items", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind,
          title: kind === "course" ? "Untitled Course" : "Untitled Guide",
          status: "draft",
          slides: [
            {
              id: "s1",
              layout: "cover",
              eyebrow: kind === "course" ? "Adaptif Academy · Course" : "Adaptif Academy · Free Guide",
              title: kind === "course" ? "Untitled Course" : "Untitled Guide",
              body: "Subtitle goes here.",
              bullets: ["Key Concept 1", "Key Concept 2"]
            }
          ]
        })
      });
      const data = await res.json();
      if (res.ok && data.item) {
        items.unshift(data.item);
        selectedId = data.item.id;
        renderSidebarLists();
        renderEditor();
        switchAcdTab("generator");
        showStudioToast(`Created new ${kind}!`);
      }
    }

    document.getElementById("btn-new-guide")?.addEventListener("click", () => createItem("guide"));
    document.getElementById("btn-new-course")?.addEventListener("click", () => createItem("course"));

    let isDirty = false;
    function setDirty(dirty: boolean) {
      isDirty = dirty;
      const saveBtn = document.getElementById("btn-save-acd-item") as HTMLButtonElement | null;
      if (saveBtn) saveBtn.disabled = !dirty;
    }

    let pendingCustomPdfUrl: string | null | undefined = undefined;
    const customPdfInput = document.getElementById("acd-custom-pdf-input") as HTMLInputElement | null;
    const coverImgInput = document.getElementById("acd-cover-img-input") as HTMLInputElement | null;
    const uploadCoverImgBtn = document.getElementById("btn-upload-cover-img") as HTMLButtonElement | null;
    const coverPreviewEl = document.getElementById("acd-cover-preview") as HTMLImageElement | null;
    const coverImgStatusEl = document.getElementById("acd-cover-img-status");
    let pendingCoverImage: string | undefined = undefined;
    const uploadCustomPdfBtn = document.getElementById("btn-upload-custom-pdf") as HTMLButtonElement | null;
    const removeCustomPdfBtn = document.getElementById("btn-remove-custom-pdf") as HTMLButtonElement | null;

    uploadCoverImgBtn?.addEventListener("click", () => coverImgInput?.click());
    coverImgInput?.addEventListener("change", async () => {
      const file = coverImgInput.files?.[0];
      coverImgInput.value = "";
      if (!file || !selectedId || !uploadCoverImgBtn) return;

      uploadCoverImgBtn.disabled = true;
      uploadCoverImgBtn.textContent = "Uploading...";
      try {
        const fd = new FormData();
        fd.append("file", file);
        fd.append("folder", "academy");
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || !data?.url) throw new Error(data?.error || "Thumbnail upload failed");

        pendingCoverImage = data.url;
        if (coverPreviewEl) {
          coverPreviewEl.src = data.url;
          coverPreviewEl.style.display = "block";
        }
        if (coverImgStatusEl) coverImgStatusEl.textContent = "New thumbnail ready — click Save Changes";
        setDirty(true);
        showStudioToast("Thumbnail uploaded — click Save Changes to apply!");
      } catch (err: any) {
        showStudioToast(err?.message || "Thumbnail upload failed");
      } finally {
        uploadCoverImgBtn.disabled = false;
        uploadCoverImgBtn.textContent = "Upload Thumbnail";
      }
    });

    uploadCustomPdfBtn?.addEventListener("click", () => customPdfInput?.click());
    customPdfInput?.addEventListener("change", async () => {
      const file = customPdfInput.files?.[0];
      customPdfInput.value = "";
      if (!file || !selectedId) return;
      const item = items.find((i) => i.id === selectedId);
      if (!item || !uploadCustomPdfBtn) return;

      uploadCustomPdfBtn.disabled = true;
      uploadCustomPdfBtn.textContent = "Uploading PDF...";
      try {
        const { upload } = await import("@vercel/blob/client");
        const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, "_");
        const blob = await upload(`academy-pdfs/${Date.now()}-${safeName}`, file, {
          access: "public",
          handleUploadUrl: "/api/blob-upload"
        });
        if (!blob?.url) throw new Error("PDF upload failed");

        pendingCustomPdfUrl = blob.url;
        setDirty(true);
        renderEditor();
        showStudioToast("PDF uploaded — click Save Changes to apply!");
      } catch (err: any) {
        showStudioToast(err?.message || "PDF upload failed");
      } finally {
        uploadCustomPdfBtn.disabled = false;
        uploadCustomPdfBtn.textContent = "Upload Custom PDF";
      }
    });

    removeCustomPdfBtn?.addEventListener("click", () => {
      if (!selectedId) return;
      pendingCustomPdfUrl = null;
      setDirty(true);
      renderEditor();
      showStudioToast("PDF marked for removal — click Save Changes to apply");
    });

    window.addEventListener("academy:item-generated", (e: any) => {
      const newItem = e?.detail?.item;
      const mode = e?.detail?.mode;
      if (!newItem) return;
      const existingIdx = items.findIndex((i) => i.id === newItem.id);
      if (existingIdx !== -1) {
        items[existingIdx] = newItem;
      } else {
        items.unshift(newItem);
      }
      selectedId = newItem.id;
      setDirty(mode === "updated");
      renderSidebarLists();
      renderEditor();
      showStudioToast(
        mode === "updated"
          ? `Generated updates for ${newItem.title} — click Save Changes to apply!`
          : `AI generated ${newItem.kind}: ${newItem.title}`
      );
    });

    document.getElementById("acd-item-title-input")?.addEventListener("input", () => setDirty(true));
    document.getElementById("acd-editor-form")?.addEventListener("input", () => setDirty(true));
    document.getElementById("acd-editor-form")?.addEventListener("change", () => setDirty(true));
    ["gen-price", "gen-stripe-url", "gen-tool-name", "gen-tool-type", "gen-tool-url", "gen-status", "gen-publish-at"].forEach((id) => {
      document.getElementById(id)?.addEventListener("input", () => setDirty(true));
      document.getElementById(id)?.addEventListener("change", () => setDirty(true));
    });

    formEl?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!selectedId) return;
      const item = items.find((i) => i.id === selectedId);
      if (!item) return;

      const genVal = (id: string) =>
        (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null)?.value.trim() || "";
      const nextStatus = genVal("gen-status") || item.status;
      const nextPublishAtRaw = genVal("gen-publish-at");

        const nextLandingData = {
          ...(item.landingData || {}),
          upsell: acdUpsellCtrl.getConfig()
        };
        if (pendingCustomPdfUrl === null) {
          delete nextLandingData.customPdfUrl;
        } else if (typeof pendingCustomPdfUrl === "string" && pendingCustomPdfUrl) {
          nextLandingData.customPdfUrl = pendingCustomPdfUrl;
        }

        const payload = {
        kind: item.kind,
        status: nextStatus,
        publishAt: nextStatus === "scheduled" && nextPublishAtRaw ? new Date(nextPublishAtRaw).toISOString() : null,
        title: el("acd-item-title-input")?.value.trim() || item.title,
        slug: el("acd-slug")!.value.trim(),
        category: el("acd-category")!.value.trim(),
        subtitle: item.subtitle,
        description: item.description,
        coverImage: pendingCoverImage ?? item.coverImage,
        priceLabel: item.kind === "course" ? genVal("gen-price") || item.priceLabel : "Free",
        accessMode: item.accessMode,
        stripeCheckoutUrl: item.kind === "course" ? genVal("gen-stripe-url") : "",
        shopifyVariantId: item.kind === "course" ? genVal("gen-shopify-variant-id") : "",
        toolName: item.kind === "course" ? genVal("gen-tool-name") : "",
        toolType: item.kind === "course" ? genVal("gen-tool-type") : "",
        toolUrl: item.kind === "course" ? genVal("gen-tool-url") : "",
        landingData: nextLandingData,
        slides: item.slides || []
      };

      const res = await fetch(`/api/academy/items/${selectedId}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok && data.item) {
        pendingCustomPdfUrl = undefined;
        pendingCoverImage = undefined;
        setDirty(false);
        const idx = items.findIndex((i) => i.id === selectedId);
        if (idx !== -1) items[idx] = data.item;
        renderSidebarLists();
        renderEditor();
        showStudioToast("Saved changes!");
      } else {
        showStudioToast(data?.error || "Save failed");
      }
    });

    document.getElementById("btn-delete-acd-item")?.addEventListener("click", async () => {
      if (!selectedId) return;
      if (!confirm("Delete this Academy item permanently?")) return;
      const res = await fetch(`/api/academy/items/${selectedId}`, { method: "DELETE" });
      if (res.ok) {
        items = items.filter((i) => i.id !== selectedId);
        selectedId = items[0]?.id ?? null;
        renderSidebarLists();
        renderEditor();
        showStudioToast("Deleted item");
      }
    });

    // 1-Click Payment Provider Switcher (Stripe <-> Shopify)
    const providerBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-payment-provider]"));
    providerBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const nextProvider = btn.dataset.paymentProvider === "shopify" ? "shopify" : "stripe";
        providerBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        try {
          const res = await fetch("/api/payments/settings", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ activeProvider: nextProvider })
          });
          if (res.ok) {
            showStudioToast(
              nextProvider === "shopify"
                ? "Switched active checkout to Shopify API!"
                : "Switched active checkout to Stripe!"
            );
          } else {
            const data = await res.json().catch(() => ({}));
            showStudioToast(data?.error || "Failed to switch payment provider");
          }
        } catch {
          showStudioToast("Network error while switching provider");
        }
      });
    });

    document.getElementById("btn-save-acd-settings")?.addEventListener("click", async () => {
      const mode = (document.getElementById("acd-default-access-mode") as HTMLSelectElement)?.value;
      const secret = (document.getElementById("acd-stripe-secret") as HTMLInputElement)?.value;
      const shopifyStoreDomain = (document.getElementById("pay-shopify-domain") as HTMLInputElement)?.value?.trim();
      const shopifyStorefrontToken = (document.getElementById("pay-shopify-token") as HTMLInputElement)?.value;
      const shopifyWebhookSecret = (document.getElementById("pay-shopify-secret") as HTMLInputElement)?.value;

      const activeBtn = document.querySelector<HTMLButtonElement>("[data-payment-provider].is-active");
      const activeProvider = activeBtn?.dataset.paymentProvider === "shopify" ? "shopify" : "stripe";

      const catalog = Array.from(document.querySelectorAll<HTMLElement>("[data-catalog-key]")).map((row) => ({
        key: row.dataset.catalogKey || "",
        stripeCheckoutUrl: (row.querySelector(".pay-cat-stripe") as HTMLInputElement)?.value?.trim() || "",
        shopifyVariantId: (row.querySelector(".pay-cat-variant") as HTMLInputElement)?.value?.trim() || "",
        shopifySellingPlanId: (row.querySelector(".pay-cat-selling-plan") as HTMLInputElement)?.value?.trim() || ""
      }));

      const [acdRes, payRes] = await Promise.all([
        fetch("/api/academy/settings", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ defaultCourseAccessMode: mode, stripeWebhookSecret: secret })
        }),
        fetch("/api/payments/settings", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            activeProvider,
            shopifyStoreDomain,
            shopifyStorefrontToken,
            shopifyWebhookSecret,
            catalog
          })
        })
      ]);

      if (acdRes.ok && payRes.ok) {
        showStudioToast("Payment & Shopify preferences saved!");
      } else {
        showStudioToast("Some preferences failed to save.");
      }
    });

    const aiProviderSelect = document.getElementById("gen-ai-provider") as HTMLSelectElement | null;
    const aiKeyLink = document.getElementById("gen-ai-key-link") as HTMLAnchorElement | null;

    function syncAiKeyLink() {
      if (!aiKeyLink) return;
      const isOpenAi = aiProviderSelect?.value === "openai";
      aiKeyLink.href = isOpenAi ? "https://platform.openai.com/api-keys" : "https://aistudio.google.com/app/apikey";
      aiKeyLink.title = isOpenAi ? "Open OpenAI API Keys" : "Open Google AI Studio API Keys";
    }

    aiProviderSelect?.addEventListener("change", syncAiKeyLink);
    syncAiKeyLink();

    const saveAiKeyBtn = document.getElementById("btn-save-ai-key") as HTMLButtonElement | null;
    saveAiKeyBtn?.addEventListener("click", async () => {
      const provider = (document.getElementById("gen-ai-provider") as HTMLSelectElement)?.value || "gemini";
      const apiKey = (document.getElementById("gen-ai-key") as HTMLInputElement)?.value || "";
      const aiDot = document.getElementById("gen-ai-dot");
      const aiStatusText = document.getElementById("gen-ai-status-text");
      saveAiKeyBtn.disabled = true;
      try {
        const res = await fetch("/api/academy/settings", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ aiProvider: provider, aiApiKey: apiKey })
        });
        const data = await res.json();
        if (res.ok) {
          if (data?.settings?.hasAiApiKey) {
            aiDot?.classList.add("is-ready");
            if (aiStatusText) aiStatusText.textContent = `${provider === "openai" ? "OpenAI" : "Gemini"} Ready`;
          }
          showStudioToast("AI Engine configuration saved!");
        } else {
          showStudioToast(data?.error || "Failed to save AI configuration");
        }
      } finally {
        saveAiKeyBtn.disabled = false;
      }
    });

    document.getElementById("btn-copy-webhook")?.addEventListener("click", () => {
      if (webhookUrlInput) {
        navigator.clipboard?.writeText(webhookUrlInput.value);
        showStudioToast("Webhook URL copied!");
      }
    });

    document.getElementById("btn-copy-stripe-event")?.addEventListener("click", () => {
      navigator.clipboard?.writeText("checkout.session.completed");
      showStudioToast("Event name copied!");
    });

    document.getElementById("btn-copy-shopify-webhook")?.addEventListener("click", () => {
      const input = document.getElementById("pay-shopify-webhook-url") as HTMLInputElement | null;
      if (input) {
        navigator.clipboard?.writeText(input.value);
        showStudioToast("Shopify webhook URL copied!");
      }
    });

    document.getElementById("btn-copy-shopify-event")?.addEventListener("click", () => {
      navigator.clipboard?.writeText("orders/paid");
      showStudioToast("Shopify event copied!");
    });

    async function refreshGeneralInfo() {
      const origin = window.location.origin;
      const giWebhookInput = document.getElementById("gi-webhook-url") as HTMLInputElement | null;
      const giRedirectInput = document.getElementById("gi-redirect-pattern") as HTMLInputElement | null;
      const giOriginEl = document.getElementById("gi-origin");
      const giCatalogEl = document.getElementById("gi-catalog-counts");

      if (giWebhookInput) giWebhookInput.value = `${origin}/api/academy/stripe-webhook`;
      if (giRedirectInput) giRedirectInput.value = `${origin}/academy/courses/<slug>/slides?checkout=success`;
      if (giOriginEl) giOriginEl.textContent = origin;

      const courseCount = items.filter((i) => i.kind === "course").length;
      const guideCount = items.filter((i) => i.kind === "guide").length;
      if (giCatalogEl) giCatalogEl.textContent = `${courseCount} Courses · ${guideCount} Guides`;

      try {
        const res = await fetch("/api/academy/settings");
        if (!res.ok) return;
        const { settings, system } = await res.json();

        const modeLabels: Record<string, string> = {
          stripe_webhook: "Stripe Webhook + Token",
          checkout_redirect: "Checkout Redirect (?checkout=success)",
          open: "Open Access (No Gate)"
        };

        const modeEl = document.getElementById("gi-access-mode");
        const whSecretEl = document.getElementById("gi-webhook-secret-status");
        const stripeBadge = document.getElementById("gi-stripe-badge");
        if (modeEl) modeEl.textContent = modeLabels[settings?.defaultCourseAccessMode] || settings?.defaultCourseAccessMode || "—";
        if (whSecretEl) whSecretEl.textContent = settings?.hasStripeWebhookSecret ? "Configured ✓" : "Not set";
        if (stripeBadge) {
          const ok = Boolean(settings?.hasStripeWebhookSecret);
          stripeBadge.textContent = ok ? "Webhook Ready" : "Secret Needed";
          stripeBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }

        const resendBadge = document.getElementById("gi-resend-badge");
        const resendStatus = document.getElementById("gi-resend-status");
        const fromEmailEl = document.getElementById("gi-from-email");
        if (resendStatus) resendStatus.textContent = system?.hasResendKey ? "Configured ✓" : "Missing in Vercel";
        if (fromEmailEl) fromEmailEl.textContent = system?.fromEmail || "—";
        if (resendBadge) {
          const ok = Boolean(system?.hasResendKey);
          resendBadge.textContent = ok ? "Ready" : "Key Missing";
          resendBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }

        const aiBadge = document.getElementById("gi-ai-badge");
        const aiProvEl = document.getElementById("gi-ai-provider");
        const aiKeyEl = document.getElementById("gi-ai-key-status");
        if (aiProvEl) aiProvEl.textContent = settings?.aiProvider === "openai" ? "OpenAI (GPT-4o Mini)" : "Google Gemini (2.5 Flash)";
        if (aiKeyEl) aiKeyEl.textContent = settings?.hasAiApiKey ? "Saved in Postgres ✓" : "Not Configured";
        if (aiBadge) {
          const ok = Boolean(settings?.hasAiApiKey);
          aiBadge.textContent = ok ? "Ready" : "Key Missing";
          aiBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }

        const infraBadge = document.getElementById("gi-infra-badge");
        const vercelEnvEl = document.getElementById("gi-vercel-env");
        const pgEl = document.getElementById("gi-postgres-status");
        if (vercelEnvEl) vercelEnvEl.textContent = system?.isVercel ? `Vercel (${system.vercelEnv})` : "Local Dev";
        if (pgEl) pgEl.textContent = system?.hasPostgres ? "Connected ✓" : "Not Detected";
        if (infraBadge) {
          const ok = Boolean(system?.hasPostgres);
          infraBadge.textContent = ok ? "Online" : "Check DB";
          infraBadge.className = `gi-badge ${ok ? "is-ok" : "is-warn"}`;
        }
      } catch {
        // silent fallback
      }
    }

    document.getElementById("btn-refresh-general-info")?.addEventListener("click", () => {
      refreshGeneralInfo();
      showStudioToast("System status refreshed");
    });

    document.getElementById("gi-copy-webhook")?.addEventListener("click", () => {
      const inp = document.getElementById("gi-webhook-url") as HTMLInputElement | null;
      if (!inp) return;
      navigator.clipboard?.writeText(inp.value);
      showStudioToast("Copied Webhook URL!");
    });

    document.getElementById("gi-copy-redirect")?.addEventListener("click", () => {
      const inp = document.getElementById("gi-redirect-pattern") as HTMLInputElement | null;
      if (!inp) return;
      navigator.clipboard?.writeText(inp.value);
      showStudioToast("Copied Redirect URL pattern!");
    });

    document.querySelectorAll<HTMLButtonElement>("[data-jump-tab]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.jumpTab;
        if (!target) return;
        const tab = document.querySelector<HTMLButtonElement>(`[data-module-tab="${target}"]`);
        tab?.click();
      });
    });

    window.addEventListener("academy:refresh-general-info", () => {
      refreshGeneralInfo();
    });

    // Clear active state on Academy sidebar items when switching back to other Studio modules
    document.querySelectorAll<HTMLButtonElement>("[data-module-tab]").forEach((tab) => {
      tab.addEventListener("click", () => {
        document.querySelectorAll(".nav-academy-item").forEach((b) => b.classList.remove("is-active"));
      });
    });

    renderSidebarLists();
    renderEditor();
    refreshGeneralInfo();
  })();
</script>

<style>
  .acd-studio-workspace {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .acd-list-panel {
    background: linear-gradient(180deg, rgba(16, 22, 34, 0.88) 0%, rgba(10, 14, 23, 0.94) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 18px;
  }

  .acd-studio-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 12px;
    max-height: 70vh;
    overflow-y: auto;
  }

  :global(.acd-list-item) {
    appearance: none;
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(5, 8, 15, 0.45);
    color: #cbd5e1;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: all 0.15s ease;
  }

  :global(.acd-list-item:hover) {
    border-color: rgba(72, 200, 255, 0.3);
    color: var(--color-text-primary);
  }

  :global(.acd-list-item.is-active) {
    background: rgba(56, 189, 248, 0.14);
    border-color: rgba(72, 200, 255, 0.5);
    color: var(--color-text-primary);
  }

  :global(.acd-li-title) {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  :global(.acd-li-meta) {
    font-size: 11px;
    color: rgba(248, 250, 252, 0.52);
    display: flex;
    justify-content: space-between;
  }

  .acd-editor-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  @media (max-width: 980px) {
    .acd-studio-workspace {
      grid-template-columns: 1fr;
    }
  }

  .acd-glass-card {
    background: var(--glass-bg-card, rgba(8, 18, 44, 0.65));
    backdrop-filter: var(--glass-blur-md, blur(24px));
    -webkit-backdrop-filter: var(--glass-blur-md, blur(24px));
    border: var(--border-subtle, 1px solid rgba(255, 255, 255, 0.12));
    border-radius: 20px;
    padding: 24px 26px;
    box-shadow: var(--shadow-bevel-card, inset 0 1px 1px rgba(255, 255, 255, 0.2), 0 12px 36px -8px rgba(0, 4, 15, 0.8));
  }

  .acd-prefs-card {
    position: relative;
    z-index: 30;
    margin-bottom: 24px;
    background:
      radial-gradient(ellipse 65% 55% at 100% 0%, rgba(72, 200, 255, 0.1) 0%, transparent 65%),
      var(--glass-bg-card, rgba(8, 18, 44, 0.65));
  }

  .acd-config-two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .acd-config-two-col {
      grid-template-columns: 1fr;
    }
  }

  .acd-unified-card {
    position: relative;
    overflow: visible;
  }

  .acd-pdf-override-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .acd-pdf-status {
    font-size: 0.8rem;
    color: var(--text-muted, #7d93ab);
  }

  .acd-pdf-status.is-active {
    color: #4ade80;
    font-weight: 600;
  }

  .acd-editor-shell {
    position: relative;
    z-index: 10;
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .acd-btn-ai {
    gap: 7px;
    border-color: rgba(72, 200, 255, 0.32);
    color: #7dd3fc;
  }

  .acd-section-kicker {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
