---
import type { BlogPost } from "../lib/blogDb";
import type { AcademyItem } from "../lib/academyDb";
import StudioHeader from "./StudioHeader.astro";
import StudioUpsellPanel from "./StudioUpsellPanel.astro";

interface Props {
  initialPosts: BlogPost[];
  academyItems: AcademyItem[];
}

const { initialPosts, academyItems } = Astro.props;
const guides = academyItems
  .filter((i) => i.kind === "guide")
  .map((i) => ({
    slug: i.slug,
    kind: "guide" as const,
    title: i.title,
    subtitle: i.subtitle,
    description: i.description,
    priceLabel: i.priceLabel,
    coverImage: i.coverImage
  }));
const courses = academyItems
  .filter((i) => i.kind === "course")
  .map((i) => ({
    slug: i.slug,
    kind: "course" as const,
    title: i.title,
    subtitle: i.subtitle,
    description: i.description,
    priceLabel: i.priceLabel,
    coverImage: i.coverImage
  }));
---

<div id="module-blogs" hidden>
  <StudioHeader eyebrow="CMS" title="Blogs" actionsId="blog-header-actions">
    <Fragment slot="actions">
      <button type="button" class="adaptif-btn adaptif-btn--sm" id="btn-blog-new">
        + New Blog Post
      </button>
    </Fragment>
  </StudioHeader>

  <div class="blog-studio-workspace">
    <!-- Left List -->
    <section class="studio-bento-card blog-list-panel" aria-label="Blog posts list">
      <div class="panel-search-wrap">
        <input
          type="search"
          id="blog-studio-search"
          class="panel-search"
          placeholder="Search blog posts..."
          autocomplete="off"
        />
      </div>
      <div class="blog-studio-list" id="blog-studio-list"></div>
    </section>

    <!-- Right Unified Editor Card (Single Bento Container) -->
    <section class="studio-bento-card studio-bento-card--flush blog-editor-shell" aria-label="Blog post editor">
      <!-- Top Bar: Post Title + Status + Contextual Post Actions -->
      <div class="blog-editor-topbar" id="blog-item-title-bar">
        <div class="blog-title-group">
          <input
            type="text"
            id="blog-f-title"
            class="cms-item-title-input"
            placeholder="Article headline..."
            aria-label="Blog post title"
          />
          <span class="cms-status-badge" id="blog-item-status-badge">Draft</span>
        </div>

        <div class="blog-item-actions" id="blog-item-actions">
          <div class="cms-header-dropdown" id="blog-actions-dropdown">
            <button type="button" class="cms-btn cms-dropdown-trigger" aria-expanded="false">
              Actions ▾
            </button>
            <div class="cms-dropdown-menu" hidden>
              <a
                id="blog-edit-content-link"
                href="/blog"
                target="_blank"
                rel="noopener noreferrer"
                class="cms-dropdown-item"
              >
                Edit Content ↗
              </a>
              <a
                id="blog-live-link"
                href="/blog"
                target="_blank"
                rel="noopener noreferrer"
                class="cms-dropdown-item"
              >
                View Post ↗
              </a>
            </div>
          </div>

          <button type="button" class="cms-btn cms-btn--danger" id="btn-blog-delete">
            Delete
          </button>
          <button type="button" class="cms-btn cms-btn--save" id="btn-blog-save">
            Save Changes
          </button>
        </div>
      </div>

      <!-- Integrated Tabs -->
      <div class="blog-editor-tabs" id="blog-tabs-bar" role="tablist">
        <button type="button" class="cms-tab-btn is-active" data-blog-tab="settings" role="tab" aria-selected="true">
          Settings &amp; Assets
        </button>
        <button type="button" class="cms-tab-btn" data-blog-tab="generator" role="tab" aria-selected="false">
          AI Generator
        </button>
        <button type="button" class="cms-tab-btn" data-blog-tab="upselling" role="tab" aria-selected="false">
          Upselling
        </button>
      </div>

      <!-- Tab 1: Post Settings & Metadata -->
      <div class="blog-tab-pane" id="blog-tab-settings" aria-label="Blog post settings">
        <div id="blog-editor-empty" class="editor-empty" hidden>
          Select a post on the left or click <strong>+ New Blog Post</strong> above.
        </div>

        <div id="blog-editor-body" class="blog-editor-body">
          <div class="blog-form-grid">
            <label class="blog-field blog-span-2">
              <span>Slug (URL)</span>
              <input type="text" id="blog-f-slug" class="blog-input" placeholder="article-slug" />
            </label>

            <label class="blog-field">
              <span>Status</span>
              <select id="blog-f-status" class="blog-input">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
                <option value="scheduled">Scheduled</option>
              </select>
            </label>

            <label class="blog-field">
              <span>Eyebrow</span>
              <input type="text" id="blog-f-eyebrow" class="blog-input" placeholder="CREATIVE OPERATIONS" />
            </label>

            <label class="blog-field blog-span-2" id="blog-publish-at-wrap" hidden>
              <span>Publish Date &amp; Time (Scheduled)</span>
              <input type="datetime-local" id="blog-f-publish-at" class="blog-input" />
            </label>

            <div class="blog-form-row-3 blog-span-2">
              <label class="blog-field">
                <span>Category</span>
                <input type="text" id="blog-f-category" class="blog-input" placeholder="AI Workflows" />
              </label>
              <label class="blog-field">
                <span>Read Time</span>
                <input type="text" id="blog-f-readtime" class="blog-input" placeholder="5 min read" />
              </label>
              <label class="blog-field">
                <span>Author</span>
                <input type="text" id="blog-f-author" class="blog-input" placeholder="Adaptif Team" />
              </label>
            </div>

            <label class="blog-field blog-span-2">
              <span>Subtitle / Lead</span>
              <textarea id="blog-f-subtitle" class="blog-textarea" rows="2"></textarea>
            </label>
            <label class="blog-field blog-span-2">
              <span>Card Excerpt</span>
              <textarea id="blog-f-excerpt" class="blog-textarea" rows="2"></textarea>
            </label>

            <div class="blog-field blog-span-2">
              <span>Cover Image</span>
              <div class="blog-cover-row">
                <div class="blog-cover-thumb" id="blog-cover-thumb">
                  <img id="blog-cover-preview" alt="Cover preview" hidden />
                  <span id="blog-cover-placeholder">No image</span>
                </div>
                <div class="blog-upload-row">
                  <input type="url" id="blog-f-cover" class="blog-input" placeholder="https://... or upload" />
                  <label class="adaptif-btn adaptif-btn--dark adaptif-btn--sm blog-upload-lbl">
                    <span>Upload Cover</span>
                    <input type="file" id="blog-cover-file" accept="image/*" hidden />
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: AI Blog Generator -->
      <div class="blog-tab-pane" id="blog-tab-generator" aria-label="AI Blog Generator" hidden>
        <div class="blog-dropzone" id="blog-ai-dropzone">
          <input type="file" id="blog-ai-files" accept=".txt,.md,.csv,.json,.pdf,.docx,.png,.jpg,.jpeg,.webp" multiple hidden />
          <div class="blog-dz-icon">↑</div>
          <p class="blog-dz-title">
            Drag &amp; drop files here, or <button type="button" class="blog-dz-browse" id="btn-blog-ai-browse">browse</button>
          </p>
          <p class="blog-dz-sub">
            Supports Docs (.txt/.md/.pdf/.docx) and Images — extracts context automatically
          </p>
          <div class="blog-dz-files" id="blog-ai-files-list"></div>
        </div>

        <div class="blog-form-grid" style="margin-top: 14px;">
          <label class="blog-field">
            <span>Informative Links (articles, docs — one per line)</span>
            <textarea id="blog-ai-links" class="blog-textarea" rows="3" placeholder="https://..."></textarea>
          </label>
          <label class="blog-field">
            <span>Manual Information &amp; Notes</span>
            <textarea
              id="blog-ai-prompt"
              class="blog-textarea"
              rows="3"
              placeholder="Describe the topic, target audience, angle, and key takeaways..."
            ></textarea>
          </label>
        </div>

        <div class="blog-gen-options">
          <label class="blog-field">
            <span>Publishing Status</span>
            <select id="blog-ai-status" class="blog-input">
              <option value="draft">Save as Draft</option>
              <option value="published">Public (Publish immediately)</option>
            </select>
          </label>
          <label class="blog-field">
            <span>Upsell Focus</span>
            <select id="blog-ai-upsell-kind" class="blog-input">
              <option value="plan">Adaptif Plan (/pricing)</option>
              <option value="guide">Academy Guide</option>
              <option value="course">Academy Course</option>
            </select>
          </label>
        </div>

        <div class="blog-ai-progress" id="blog-ai-progress" hidden>
          <div class="blog-ai-bar"><span id="blog-ai-bar-fill"></span></div>
          <p id="blog-ai-status-txt">Starting...</p>
        </div>

        <div class="blog-gen-footer">
          <label class="blog-toggle-pill">
            <input type="checkbox" id="blog-ai-complement" />
            <span id="blog-ai-complement-label">Create as new post</span>
          </label>
          <button type="button" class="adaptif-btn adaptif-btn--sm" id="btn-blog-ai-run">
            ★ Generate
          </button>
        </div>
      </div>

      <!-- Tab 3: Upselling -->
      <div class="blog-tab-pane" id="blog-tab-upselling" aria-label="Blog upsell configuration" hidden>
        <StudioUpsellPanel prefix="blog" allowGuide={true} showPlacement={true} />
      </div>
    </section>
  </div>
</div>

<script define:vars={{ initialPosts, guides, courses }}>
  window.__INITIAL_BLOG_STUDIO__ = {
    posts: initialPosts || [],
    guides: guides || [],
    courses: courses || [],
  };
</script>

<style>
  .blog-studio-workspace {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  /* .blog-list-panel inherits surface from global .studio-bento-card */
  .blog-list-panel {
    padding: 20px;
  }

  .blog-editor-shell {
    min-width: 0;
    overflow: visible;
  }

  .blog-editor-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
    border-bottom: 1px solid rgba(72, 200, 255, 0.12);
    flex-wrap: wrap;
  }

  .blog-editor-topbar[hidden] {
    display: none;
  }

  .blog-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 280px;
    min-width: 0;
  }

  .blog-title-group .cms-item-title-input {
    flex: 1 1 auto;
    min-width: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 8px;
    margin-left: -8px;
    font-size: 1.12rem;
    font-weight: 600;
    color: #f8fafc;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .blog-title-group .cms-item-title-input:focus {
    outline: none;
    background: rgba(5, 10, 22, 0.55);
    border-color: rgba(72, 200, 255, 0.35);
  }

  .blog-item-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .blog-editor-tabs {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(4, 10, 24, 0.35);
    flex-wrap: wrap;
  }

  .blog-tab-pane {
    padding: 22px 24px 24px;
  }

  .blog-tab-pane[hidden] {
    display: none;
  }

  .blog-studio-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 12px;
    max-height: 70vh;
    overflow-y: auto;
  }

  :global(.blog-list-item) {
    appearance: none;
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(5, 8, 15, 0.45);
    color: #cbd5e1;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: all 0.15s ease;
  }

  :global(.blog-list-item:hover) {
    border-color: rgba(72, 200, 255, 0.3);
    color: var(--color-text-primary);
  }

  :global(.blog-list-item.is-active) {
    background: rgba(56, 189, 248, 0.14);
    border-color: rgba(72, 200, 255, 0.5);
    color: var(--color-text-primary);
  }

  :global(.blog-li-title) {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  :global(.blog-li-meta) {
    font-size: 11px;
    color: rgba(248, 250, 252, 0.52);
    display: flex;
    justify-content: space-between;
  }

  .blog-dropzone {
    border: 1.5px dashed rgba(72, 200, 255, 0.28);
    border-radius: 14px;
    background: rgba(5, 10, 22, 0.55);
    padding: 22px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .blog-dropzone.is-dragover {
    border-color: #48c8ff;
    background: rgba(56, 189, 248, 0.1);
  }

  .blog-dz-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.14);
    color: #48c8ff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .blog-dz-title {
    margin: 0;
    font-size: 13.5px;
    color: #e2e8f0;
  }

  .blog-dz-browse {
    background: none;
    border: none;
    color: #48c8ff;
    text-decoration: underline;
    cursor: pointer;
    font-size: inherit;
    padding: 0;
  }

  .blog-dz-sub {
    margin: 0;
    font-size: 11.5px;
    color: rgba(248, 250, 252, 0.48);
  }

  .blog-dz-files {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .blog-gen-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .blog-gen-footer {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .blog-toggle-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: #cbd5e1;
    cursor: pointer;
  }

  .blog-editor-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .blog-top-actions {
    display: flex;
    gap: 8px;
  }

  .blog-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .blog-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .blog-field[hidden] {
    display: none;
  }

  .blog-form-row-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .blog-cover-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .blog-cover-thumb {
    width: 96px;
    height: 54px;
    border-radius: 10px;
    border: 1px solid rgba(72, 200, 255, 0.22);
    background: rgba(5, 10, 22, 0.65);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .blog-cover-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-cover-thumb img[hidden],
  .blog-cover-thumb span[hidden] {
    display: none;
  }

  .blog-cover-thumb span {
    font-size: 11px;
    color: rgba(148, 163, 184, 0.72);
  }

  .blog-upload-row {
    flex: 1 1 240px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (max-width: 780px) {
    .blog-form-row-3 {
      grid-template-columns: 1fr;
    }
  }

  .blog-field > span {
    font-size: 12px;
    font-weight: 500;
    color: rgba(248, 250, 252, 0.78);
  }

  .blog-span-2 {
    grid-column: span 2;
  }

  .blog-input,
  .blog-textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 9px 12px;
    border-radius: 9px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(5, 8, 15, 0.72);
    color: #f8fafc;
    font-family: inherit;
    font-size: 13px;
  }

  .blog-upload-row {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .blog-upload-lbl {
    flex-shrink: 0;
  }

  .blog-ai-progress {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .blog-ai-progress[hidden] {
    display: none;
  }

  .blog-ai-bar {
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .blog-ai-bar span {
    display: block;
    height: 100%;
    width: 0%;
    background: #38bdf8;
    transition: width 0.25s ease;
  }

  .blog-ai-progress p {
    margin: 0;
    font-size: 12px;
    color: #7dd3fc;
  }

  @media (max-width: 980px) {
    .blog-studio-workspace,
    .blog-gen-options {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { createUpsellPanelController } from "../lib/studioUpsellClient";

  const w = window as any;
  const seed = w.__INITIAL_BLOG_STUDIO__ || { posts: [], courses: [], guides: [] };
  const blogUpsellCtrl = createUpsellPanelController("blog");
  blogUpsellCtrl.setCatalog(seed.courses || [], seed.guides || []);
  let posts: any[] = JSON.parse(JSON.stringify(seed.posts || []));
  let selectedId: string | null = posts[0]?.id || null;
  let uploadedDocText = "";

  const listEl = document.getElementById("blog-studio-list");
  const searchEl = document.getElementById("blog-studio-search") as HTMLInputElement | null;
  const emptyEl = document.getElementById("blog-editor-empty");
  const bodyEl = document.getElementById("blog-editor-body");
  const editContentLink = document.getElementById("blog-edit-content-link") as HTMLAnchorElement | null;
  const liveLink = document.getElementById("blog-live-link") as HTMLAnchorElement | null;
  const complementLabel = document.getElementById("blog-ai-complement-label");

  function getSelectedPost() {
    return posts.find((p) => p.id === selectedId) || null;
  }

  function renderPostList() {
    if (!listEl) return;
    const q = (searchEl?.value || "").trim().toLowerCase();
    const filtered = posts.filter(
      (p) => !q || (p.title || "").toLowerCase().includes(q) || (p.category || "").toLowerCase().includes(q)
    );
    listEl.innerHTML = filtered
      .map(
        (p) => `
      <button type="button" class="blog-list-item ${p.id === selectedId ? "is-active" : ""}" data-blog-id="${p.id}">
        <span class="blog-li-title">${(p.title || "Untitled").replace(/</g, "&lt;")}</span>
        <span class="blog-li-meta">
          <span>${p.status === "published" ? "● Published" : "○ Draft"}</span>
          <span>${p.sections?.length || 0} sections</span>
        </span>
      </button>
    `
      )
      .join("");

    listEl.querySelectorAll<HTMLButtonElement>("[data-blog-id]").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedId = btn.dataset.blogId || null;
        renderPostList();
        loadSelectedPost();
        switchBlogTab("settings");
      });
    });
  }

  function switchBlogTab(tab: "settings" | "generator" | "upselling") {
    document.querySelectorAll<HTMLButtonElement>("[data-blog-tab]").forEach((btn) => {
      const active = btn.dataset.blogTab === tab;
      btn.classList.toggle("is-active", active);
      btn.setAttribute("aria-selected", active ? "true" : "false");
    });
    const settingsPanel = document.getElementById("blog-tab-settings");
    const genPanel = document.getElementById("blog-tab-generator");
    const upsellPanel = document.getElementById("blog-tab-upselling");
    if (settingsPanel) settingsPanel.hidden = tab !== "settings";
    if (genPanel) genPanel.hidden = tab !== "generator";
    if (upsellPanel) upsellPanel.hidden = tab !== "upselling";
  }

  document.querySelectorAll<HTMLButtonElement>("[data-blog-tab]").forEach((btn) => {
    btn.addEventListener("click", () => {
      switchBlogTab((btn.dataset.blogTab as "settings" | "generator" | "upselling") || "settings");
    });
  });

  document.querySelectorAll<HTMLElement>("#module-blogs .cms-header-dropdown").forEach((dd) => {
    const trigger = dd.querySelector<HTMLButtonElement>(".cms-dropdown-trigger");
    const menu = dd.querySelector<HTMLElement>(".cms-dropdown-menu");
    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !menu?.hidden;
      document.querySelectorAll<HTMLElement>(".cms-header-dropdown .cms-dropdown-menu").forEach((m) => {
        m.hidden = true;
      });
      document.querySelectorAll<HTMLButtonElement>(".cms-header-dropdown .cms-dropdown-trigger").forEach((t) => {
        t.setAttribute("aria-expanded", "false");
      });
      if (menu && !isOpen) {
        menu.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
      }
    });
  });

  function loadSelectedPost() {
    const post = getSelectedPost();
    const titleBarEl = document.getElementById("blog-item-title-bar");
    const statusBadgeEl = document.getElementById("blog-item-status-badge");
    const actionsDd = document.getElementById("blog-actions-dropdown");
    const delBtn = document.getElementById("btn-blog-delete");
    const saveBtn = document.getElementById("btn-blog-save");
    const dividerEl = document.getElementById("blog-actions-divider");

    if (!emptyEl || !bodyEl) return;
    if (!post) {
      emptyEl.hidden = false;
      bodyEl.hidden = true;
      if (titleBarEl) titleBarEl.hidden = true;
      if (actionsDd) actionsDd.hidden = true;
      if (delBtn) delBtn.hidden = true;
      if (saveBtn) saveBtn.hidden = true;
      if (dividerEl) dividerEl.hidden = true;
      if (complementLabel) complementLabel.textContent = "Create as new post";
      return;
    }
    emptyEl.hidden = true;
    bodyEl.hidden = false;
    if (titleBarEl) titleBarEl.hidden = false;
    if (actionsDd) actionsDd.hidden = false;
    if (delBtn) delBtn.hidden = false;
    if (saveBtn) saveBtn.hidden = false;
    if (dividerEl) dividerEl.hidden = false;

    if (statusBadgeEl) {
      const st = post.status || "draft";
      statusBadgeEl.textContent =
        st === "published" ? "Published" : st === "scheduled" ? "Scheduled" : "Draft";
      statusBadgeEl.className = `cms-status-badge is-${st}`;
    }

    const toLocalInput = (iso: string | null | undefined) => {
      if (!iso) return "";
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return "";
      const pad = (n: number) => String(n).padStart(2, "0");
      return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    };

    const syncPublishAtVisibility = (st: string) => {
      const wrap = document.getElementById("blog-publish-at-wrap");
      const inp = document.getElementById("blog-f-publish-at") as HTMLInputElement | null;
      if (!wrap) return;
      const isSched = st === "scheduled";
      wrap.hidden = !isSched;
      if (isSched && inp && !inp.value) {
        const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);
        tomorrow.setHours(9, 0, 0, 0);
        inp.value = toLocalInput(tomorrow.toISOString());
      }
    };

    const setVal = (id: string, val: string) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      if (el) {
        el.value = val || "";
        if (el instanceof HTMLSelectElement) w.__STUDIO_SYNC_SELECT__?.(el);
      }
    };

    setVal("blog-f-title", post.title);
    setVal("blog-f-slug", post.slug);
    setVal("blog-f-status", post.status || "draft");
    setVal("blog-f-publish-at", toLocalInput(post.publishAt));
    syncPublishAtVisibility(post.status || "draft");
    setVal("blog-f-eyebrow", post.eyebrow);
    setVal("blog-f-category", post.category);
    setVal("blog-f-readtime", post.readTime);
    setVal("blog-f-author", post.authorName);
    setVal("blog-f-subtitle", post.subtitle);
    setVal("blog-f-excerpt", post.excerpt);
    const syncCoverPreview = (url: string) => {
      const img = document.getElementById("blog-cover-preview") as HTMLImageElement | null;
      const ph = document.getElementById("blog-cover-placeholder");
      const trimmed = (url || "").trim();
      if (!img || !ph) return;
      if (trimmed) {
        img.src = trimmed;
        img.hidden = false;
        ph.hidden = true;
      } else {
        img.removeAttribute("src");
        img.hidden = true;
        ph.hidden = false;
      }
    };

    setVal("blog-f-cover", post.coverImage);
    syncCoverPreview(post.coverImage);
    blogUpsellCtrl.setContext("blog", post.slug || "", post.upsell);

    const coverInputEl = document.getElementById("blog-f-cover") as HTMLInputElement | null;
    if (coverInputEl && !coverInputEl.dataset.previewWired) {
      coverInputEl.dataset.previewWired = "1";
      coverInputEl.addEventListener("input", () => syncCoverPreview(coverInputEl.value));
    }

    if (editContentLink) editContentLink.href = `/blog/${post.slug}?edit=1`;
    if (liveLink) liveLink.href = `/blog/${post.slug}`;
    if (complementLabel) complementLabel.textContent = `Complement & update: ${post.title}`;
  }

  searchEl?.addEventListener("input", renderPostList);

  // Drag & drop text files for AI generator
  const dz = document.getElementById("blog-ai-dropzone");
  const fileInp = document.getElementById("blog-ai-files") as HTMLInputElement | null;
  const filesList = document.getElementById("blog-ai-files-list");

  document.getElementById("btn-blog-ai-browse")?.addEventListener("click", () => fileInp?.click());
  dz?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dz.classList.add("is-dragover");
  });
  dz?.addEventListener("dragleave", () => dz.classList.remove("is-dragover"));
  dz?.addEventListener("drop", (e) => {
    e.preventDefault();
    dz.classList.remove("is-dragover");
    if (e.dataTransfer?.files) handleFiles(e.dataTransfer.files);
  });
  fileInp?.addEventListener("change", () => {
    if (fileInp.files) handleFiles(fileInp.files);
  });

  async function handleFiles(fileList: FileList) {
    const names: string[] = [];
    const chunks: string[] = [];
    for (const f of Array.from(fileList)) {
      names.push(f.name);
      if (/\.(txt|md|csv|json)$/i.test(f.name)) {
        chunks.push(`File (${f.name}):\n${await f.text()}`);
      } else {
        chunks.push(`Attached file: ${f.name}`);
      }
    }
    uploadedDocText = chunks.join("\n\n");
    if (filesList) {
      filesList.innerHTML = names.map((n) => `<span class="adaptif-tag adaptif-tag--cyan">${n}</span>`).join("");
    }
  }

  // Cover upload
  document.getElementById("blog-cover-file")?.addEventListener("change", async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      const fd = new FormData();
      fd.append("file", file);
      const res = await fetch("/api/upload", { method: "POST", body: fd });
      const data = await res.json();
      if (!res.ok || !data?.url) throw new Error(data?.error || "Upload failed");
      const coverInp = document.getElementById("blog-f-cover") as HTMLInputElement | null;
      if (coverInp) {
        coverInp.value = data.url;
        coverInp.dispatchEvent(new Event("input"));
      }
      w.__SHOW_STUDIO_TOAST__?.("Cover uploaded!");
    } catch (err: any) {
      w.__SHOW_STUDIO_TOAST__?.(err?.message || "Upload failed", true);
    } finally {
      input.value = "";
    }
  });

  // New post
  document.getElementById("btn-blog-new")?.addEventListener("click", async () => {
    try {
      const res = await fetch("/api/blog/posts", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: "New Blog Article",
          eyebrow: "INSIGHTS",
          category: "AI Workflows",
          status: "draft",
          sections: [
            {
              id: `sec-${Date.now()}`,
              columnsCount: 1,
              columns: [
                {
                  id: `col-${Date.now()}`,
                  type: "text",
                  blocks: [
                    { id: `blk-${Date.now()}-1`, format: "eyebrow", text: "SECTION KICKER" },
                    { id: `blk-${Date.now()}-2`, format: "title", text: "Your section headline" },
                    { id: `blk-${Date.now()}-3`, format: "paragraph", text: "Start writing your article..." },
                  ],
                },
              ],
            },
          ],
          upsell: { enabled: true, kind: "plan", planName: "Creative Plan" },
        }),
      });
      const data = await res.json();
      if (!res.ok || !data?.post) throw new Error(data?.error || "Failed to create post");
      posts.unshift(data.post);
      selectedId = data.post.id;
      renderPostList();
      loadSelectedPost();
      switchBlogTab("generator");
      w.__SHOW_STUDIO_TOAST__?.("Draft blog post created!");
    } catch (err: any) {
      w.__SHOW_STUDIO_TOAST__?.(err?.message || "Create failed", true);
    }
  });

  document.getElementById("blog-f-status")?.addEventListener("change", (e) => {
    const st = (e.target as HTMLSelectElement).value;
    const wrap = document.getElementById("blog-publish-at-wrap");
    const inp = document.getElementById("blog-f-publish-at") as HTMLInputElement | null;
    if (wrap) wrap.hidden = st !== "scheduled";
    if (st === "scheduled" && inp && !inp.value) {
      const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);
      tomorrow.setHours(9, 0, 0, 0);
      const pad = (n: number) => String(n).padStart(2, "0");
      inp.value = `${tomorrow.getFullYear()}-${pad(tomorrow.getMonth() + 1)}-${pad(tomorrow.getDate())}T${pad(tomorrow.getHours())}:${pad(tomorrow.getMinutes())}`;
    }
  });

  // Save post metadata
  document.getElementById("btn-blog-save")?.addEventListener("click", async () => {
    const post = getSelectedPost();
    if (!post) return;
    const val = (id: string) =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement)?.value.trim() || "";

    const statusVal = val("blog-f-status");
    const rawPublishAt = val("blog-f-publish-at");
    let publishAt: string | null = null;
    if (statusVal === "scheduled") {
      if (!rawPublishAt) {
        w.__SHOW_STUDIO_TOAST__?.("Please select a publish date & time for scheduled posts.", true);
        return;
      }
      const parsed = new Date(rawPublishAt);
      if (Number.isNaN(parsed.getTime())) {
        w.__SHOW_STUDIO_TOAST__?.("Invalid publish date & time.", true);
        return;
      }
      publishAt = parsed.toISOString();
    }

    try {
      const res = await fetch(`/api/blog/posts/${post.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: val("blog-f-title"),
          slug: val("blog-f-slug"),
          status: statusVal,
          publishAt,
          eyebrow: val("blog-f-eyebrow"),
          category: val("blog-f-category"),
          readTime: val("blog-f-readtime"),
          authorName: val("blog-f-author"),
          subtitle: val("blog-f-subtitle"),
          excerpt: val("blog-f-excerpt"),
          coverImage: val("blog-f-cover"),
          upsell: blogUpsellCtrl.getConfig(),
        }),
      });
      const data = await res.json();
      if (!res.ok || !data?.post) throw new Error(data?.error || "Failed to save post");
      const idx = posts.findIndex((p) => p.id === post.id);
      if (idx >= 0) posts[idx] = data.post;
      renderPostList();
      loadSelectedPost();
      w.__SHOW_STUDIO_TOAST__?.("Blog post saved!");
    } catch (err: any) {
      w.__SHOW_STUDIO_TOAST__?.(err?.message || "Save failed", true);
    }
  });

  // Delete post
  document.getElementById("btn-blog-delete")?.addEventListener("click", async () => {
    const post = getSelectedPost();
    if (!post || !confirm(`Delete "${post.title}"?`)) return;
    try {
      const res = await fetch(`/api/blog/posts/${post.id}`, { method: "DELETE" });
      if (!res.ok) throw new Error("Delete failed");
      posts = posts.filter((p) => p.id !== post.id);
      selectedId = posts[0]?.id || null;
      renderPostList();
      loadSelectedPost();
      w.__SHOW_STUDIO_TOAST__?.("Post deleted");
    } catch (err: any) {
      w.__SHOW_STUDIO_TOAST__?.(err?.message || "Delete failed", true);
    }
  });

  // Generate with AI
  document.getElementById("btn-blog-ai-run")?.addEventListener("click", async () => {
    const runBtn = document.getElementById("btn-blog-ai-run") as HTMLButtonElement | null;
    const progWrap = document.getElementById("blog-ai-progress");
    const barFill = document.getElementById("blog-ai-bar-fill");
    const statusTxt = document.getElementById("blog-ai-status-txt");
    const prompt = (document.getElementById("blog-ai-prompt") as HTMLTextAreaElement | null)?.value || "";
    const links = ((document.getElementById("blog-ai-links") as HTMLTextAreaElement | null)?.value || "")
      .split("\n")
      .map((s) => s.trim())
      .filter(Boolean);
    const status = (document.getElementById("blog-ai-status") as HTMLSelectElement | null)?.value || "draft";

    if (runBtn) runBtn.disabled = true;
    if (progWrap) progWrap.hidden = false;

    try {
      const res = await fetch("/api/blog/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ prompt, links, docText: uploadedDocText, status }),
      });
      const reader = res.body?.getReader();
      if (!reader) throw new Error("Streaming not supported");
      const dec = new TextDecoder();
      let buf = "";

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += dec.decode(value, { stream: true });
        const chunks = buf.split("\n\n");
        buf = chunks.pop() || "";
        for (const chunk of chunks) {
          const evMatch = chunk.match(/event:\s*(\w+)/);
          const dataMatch = chunk.match(/data:\s*(.+)/s);
          if (!evMatch || !dataMatch) continue;
          const ev = evMatch[1];
          const payload = JSON.parse(dataMatch[1]);
          if (ev === "progress") {
            if (barFill) barFill.style.width = `${payload.percent || 0}%`;
            if (statusTxt) statusTxt.textContent = payload.label || "";
          } else if (ev === "done" && payload.post) {
            posts.unshift(payload.post);
            selectedId = payload.post.id;
            renderPostList();
            loadSelectedPost();
            w.__SHOW_STUDIO_TOAST__?.("AI Blog Post generated!");
          } else if (ev === "error") {
            throw new Error(payload.error || "Generation failed");
          }
        }
      }
    } catch (err: any) {
      w.__SHOW_STUDIO_TOAST__?.(err?.message || "Generation failed", true);
    } finally {
      if (runBtn) runBtn.disabled = false;
      if (progWrap) progWrap.hidden = true;
    }
  });

  renderPostList();
  loadSelectedPost();
</script>
