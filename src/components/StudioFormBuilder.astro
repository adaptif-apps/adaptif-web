---
import type { BookCallConfig } from "../lib/bookCallDb";

interface Props {
  initialConfig: BookCallConfig;
}

const { initialConfig } = Astro.props;
---

<div id="studio-form-builder" class="fb-root" data-mode="edit">
  <!-- Top Control Bar -->
  <div class="studio-card acd-card fb-toolbar-card">
    <div class="fb-toolbar-left">
      <div class="fb-segmented" role="tablist" aria-label="Builder mode">
        <button type="button" class="fb-seg-btn is-active" data-fb-mode="edit">
          Edit
        </button>
        <button type="button" class="fb-seg-btn" data-fb-mode="preview">
          Preview
        </button>
      </div>

      <div class="fb-segmented" id="fb-step-tabs" role="tablist" aria-label="Form steps"></div>

      <button type="button" class="fb-mini-btn fb-edit-only" id="btn-fb-add-step" title="Add new step">
        + Add Step
      </button>
    </div>

    <div class="fb-toolbar-actions">
      <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-pull-ac-fields">
        Pull from AC
      </button>
      <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-pull-klv-fields">
        Pull from Klaviyo
      </button>
      <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm fb-edit-only" id="btn-fb-add-field">
        + Add Field
      </button>
      <button type="button" class="adaptif-btn adaptif-btn--sm" id="btn-save-form-builder">
        Save Form
      </button>
    </div>
  </div>

  <!-- 2-Column Builder Workspace -->
  <div class="fb-workspace">
    <!-- Left: Exact Front-End Modal Canvas -->
    <div class="fb-stage" id="fb-stage">
      <div class="fb-bc-card" id="fb-bc-card">
        <button type="button" class="fb-bc-close" aria-label="Close modal" tabindex="-1">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>

        <!-- Dynamic Fields Step View -->
        <div id="fb-canvas-fields-view">
          <span class="fb-bc-eyebrow" id="fb-view-eyebrow"></span>
          <h2 class="fb-bc-title">
            <span id="fb-view-title"></span>{" "}
            <span class="fb-bc-title-italic" id="fb-view-titleHighlight"></span>{" "}
            <span id="fb-view-titleSuffix"></span>
          </h2>
          <p class="fb-bc-subtitle" id="fb-view-subtitle"></p>

          <div class="fb-bc-grid" id="fb-canvas-grid"></div>

          <div class="fb-bc-footer">
            <div class="fb-bc-footer-left">
              <button type="button" class="fb-bc-back-btn" id="fb-canvas-back" hidden>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
                Back
              </button>
              <div class="fb-bc-privacy" id="fb-canvas-privacy-wrap">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <span id="fb-view-privacyNote"></span>
              </div>
            </div>

            <button type="button" class="fb-bc-cta-btn" id="fb-canvas-cta">
              <span id="fb-view-cta"></span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Confirmation Step View -->
        <div id="fb-canvas-confirm-view" class="fb-bc-success" hidden>
          <div class="fb-bc-success-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          </div>
          <h2 class="fb-bc-title" style="padding-right: 0; text-align: center;">
            <span id="fb-view-c-title"></span>{" "}
            <span class="fb-bc-title-italic" id="fb-view-c-titleHighlight"></span>
          </h2>
          <p class="fb-bc-subtitle fb-bc-subtitle--center" id="fb-view-c-subtitle"></p>
          <button type="button" class="fb-bc-cta-btn" id="fb-canvas-confirm-cta">
            <span id="fb-view-c-cta"></span>
          </button>
        </div>
      </div>
    </div>

    <!-- Right: Fixed-Height Contextual Inspector Panel (Edit Mode Only) -->
    <aside class="studio-card acd-card fb-inspector fb-edit-only" id="fb-inspector">
      <!-- Form Container Inspector -->
      <div id="fb-insp-form" class="fb-insp-body">
        <div class="fb-insp-head">
          <div>
            <span class="acd-section-kicker">Form Container</span>
            <h3 class="fb-insp-title" id="fb-insp-step-heading">Step 1</h3>
          </div>
          <button type="button" class="fb-mini-btn is-danger" id="btn-fb-delete-step">Delete Step</button>
        </div>

        <div class="fb-insp-fields">
          <label class="acd-field">
            <span class="acd-label-row">Form Name</span>
            <input type="text" id="fb-cfg-formName" value={initialConfig.formName} placeholder="e.g. Book a Call" />
          </label>
          <label class="acd-field" id="fb-step-eyebrow-wrap">
            <span class="acd-label-row">Eyebrow</span>
            <input type="text" id="fb-step-eyebrow" />
          </label>
          <label class="acd-field">
            <span class="acd-label-row">Title</span>
            <input type="text" id="fb-step-title" />
          </label>
          <label class="acd-field">
            <span class="acd-label-row">Title Highlight (Italic)</span>
            <input type="text" id="fb-step-titleHighlight" />
          </label>
          <label class="acd-field" id="fb-step-suffix-wrap">
            <span class="acd-label-row">Title Suffix</span>
            <input type="text" id="fb-step-titleSuffix" />
          </label>
          <label class="acd-field">
            <span class="acd-label-row">Description</span>
            <textarea rows="3" id="fb-step-subtitle"></textarea>
          </label>
          <label class="acd-field" id="fb-step-privacy-wrap">
            <span class="acd-label-row">Privacy Note</span>
            <input type="text" id="fb-step-privacy" placeholder="We'll only use your details to coordinate your call. No spam." />
          </label>
        </div>
      </div>

      <!-- Button Inspector -->
      <div id="fb-insp-button" class="fb-insp-body" hidden>
        <div class="fb-insp-head">
          <div>
            <span class="acd-section-kicker">Button Inspector</span>
            <h3 class="fb-insp-title">CTA Button</h3>
          </div>
        </div>

        <div class="fb-insp-fields">
          <label class="acd-field">
            <span class="acd-label-row">Button Text</span>
            <input type="text" id="fb-btn-text-input" placeholder="e.g. Tell us about your project" />
          </label>
        </div>
      </div>

      <!-- Field Inspector -->
      <div id="fb-insp-field" class="fb-insp-body" hidden>
        <div class="fb-insp-head">
          <div>
            <span class="acd-section-kicker">Field Inspector</span>
            <h3 class="fb-insp-title" id="fb-insp-field-name">Field</h3>
          </div>
        </div>

        <div class="fb-insp-fields">
          <label class="acd-field">
            <span class="acd-label-row">Title / Label</span>
            <input type="text" id="fb-f-label" placeholder="e.g. What's your full name?" />
          </label>

          <label class="acd-field">
            <span class="acd-label-row">Placeholder</span>
            <input type="text" id="fb-f-placeholder" placeholder="e.g. Your full name" />
          </label>

          <div class="fb-insp-row-2">
            <label class="acd-field">
              <span class="acd-label-row">Field Type</span>
              <select id="fb-f-type" class="studio-select">
                <option value="text">Text</option>
                <option value="email">Email</option>
                <option value="url">URL</option>
                <option value="select">Dropdown</option>
                <option value="textarea">Long Text</option>
              </select>
            </label>

            <label class="acd-field">
              <span class="acd-label-row">Step</span>
              <select id="fb-f-step" class="studio-select"></select>
            </label>
          </div>

          <div class="acd-field">
            <span class="acd-label-row">Columns</span>
            <div class="fb-col-segmented">
              <button type="button" class="fb-col-btn" data-col-width="half">2 Cols (50%)</button>
              <button type="button" class="fb-col-btn" data-col-width="full">1 Col (100%)</button>
            </div>
          </div>

          <div class="acd-field">
            <span class="acd-label-row">Move Position</span>
            <div class="fb-col-segmented">
              <button type="button" class="fb-col-btn" id="btn-fb-move-left">← Move Left</button>
              <button type="button" class="fb-col-btn" id="btn-fb-move-right">Move Right →</button>
            </div>
          </div>

          <label class="acd-field" id="fb-f-options-wrap" hidden>
            <span class="acd-label-row">Dropdown Options (comma-separated)</span>
            <textarea rows="3" id="fb-f-options" placeholder="Option A, Option B, Option C"></textarea>
          </label>

          <div class="fb-insp-bottom-row">
            <label class="studio-toggle-pill is-inactive" id="fb-f-req-pill">
              <input type="checkbox" class="studio-toggle-chk" id="fb-f-required" />
              <span class="studio-switch" aria-hidden="true"></span>
              <span class="studio-toggle-text" id="fb-f-req-label">Optional</span>
            </label>

            <button type="button" class="fb-mini-btn is-danger" id="btn-fb-delete-field">
              Delete Field
            </button>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<script define:vars={{ initialConfig }}>
  window.__INITIAL_BOOK_CALL_CONFIG__ = initialConfig;
</script>

<style is:global>
  .fb-root {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    gap: 18px;
  }

  .fb-root [hidden] {
    display: none !important;
  }

  .fb-toolbar-card {
    padding: 14px 18px !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }

  .fb-toolbar-left,
  .fb-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .fb-segmented {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: rgba(6, 17, 36, 0.72);
    border: 1px solid rgba(72, 200, 255, 0.18);
    gap: 2px;
  }

  .fb-seg-btn {
    appearance: none;
    border: none;
    background: transparent;
    color: #94a3b8;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    padding: 6px 13px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.16s ease;
    user-select: none;
  }

  .fb-seg-btn[draggable="true"] {
    cursor: grab;
  }

  .fb-seg-btn.is-dragging {
    opacity: 0.45;
  }

  .fb-seg-btn.is-drag-over {
    box-shadow: inset 0 0 0 1.5px #48c8ff;
  }

  .fb-seg-btn:hover {
    color: #e2e8f0;
  }

  .fb-seg-btn.is-active {
    background: rgba(72, 200, 255, 0.18);
    color: #7ee0ff;
    box-shadow: inset 0 0 0 1px rgba(72, 200, 255, 0.35);
  }

  .fb-root[data-mode="preview"] .fb-edit-only {
    display: none !important;
  }

  /* 2-Column Workspace with Full-Height Scrollable Right Inspector */
  .fb-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 20px;
    align-items: stretch;
    flex: 1;
    min-height: 0;
  }

  .fb-root[data-mode="preview"] .fb-workspace {
    grid-template-columns: 1fr;
    flex: 1;
    min-height: 0;
  }

  @media (max-width: 1080px) {
    .fb-workspace {
      grid-template-columns: 1fr;
      flex: none;
      height: auto;
    }
  }

  .fb-stage {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 8px 4px 24px;
    height: 100%;
    overflow-y: auto;
  }

  /* Exact Front-End BookCallModal Card Styles */
  .fb-bc-card {
    position: relative;
    width: 100%;
    max-width: 680px;
    padding: clamp(26px, 4vw, 40px);
    border-radius: 22px;
    background:
      radial-gradient(circle at 82% 18%, rgba(56, 189, 248, 0.22) 0%, rgba(15, 42, 92, 0.18) 38%, transparent 72%),
      linear-gradient(155deg, rgba(16, 39, 80, 0.96) 0%, rgba(8, 22, 48, 0.98) 65%, rgba(6, 15, 34, 0.99) 100%);
    border: 1px solid rgba(72, 200, 255, 0.22);
    box-shadow:
      0 32px 90px rgba(0, 0, 0, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.14);
    transition: max-width 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fb-bc-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(226, 232, 240, 0.72);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: default;
  }

  .fb-bc-eyebrow {
    display: inline-block;
    font-family: var(--font-family-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #48c8ff;
  }

  .fb-bc-title {
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    margin: 10px 0 10px;
    padding-right: 36px;
  }

  .fb-bc-title-italic {
    font-style: italic;
    color: var(--color-brand-cyan, #48c8ff);
  }

  .fb-bc-subtitle {
    font-family: var(--font-family-body);
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(203, 213, 225, 0.78);
    margin: 0 0 24px;
    max-width: 58ch;
  }

  .fb-bc-subtitle--center {
    text-align: center;
    margin-inline: auto;
  }

  .fb-bc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 640px) {
    .fb-bc-grid {
      grid-template-columns: 1fr;
    }
  }

  .fb-bc-field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 7px;
    border-radius: 12px;
    transition: box-shadow 0.16s ease, background 0.16s ease;
  }

  .fb-bc-field.is-full {
    grid-column: span 2;
  }

  @media (max-width: 640px) {
    .fb-bc-field.is-full {
      grid-column: span 1;
    }
  }

  .fb-root[data-mode="edit"] .fb-bc-field {
    cursor: pointer;
    padding: 6px;
    margin: -6px;
  }

  .fb-root[data-mode="edit"] .fb-bc-field:hover {
    background: rgba(72, 200, 255, 0.06);
    box-shadow: inset 0 0 0 1px rgba(72, 200, 255, 0.28);
  }

  .fb-root[data-mode="edit"] .fb-bc-field.is-selected {
    background: rgba(72, 200, 255, 0.1);
    box-shadow:
      inset 0 0 0 1.5px #48c8ff,
      0 0 18px rgba(72, 200, 255, 0.16);
  }

  .fb-bc-label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-family-body);
    font-size: 0.82rem;
    font-weight: 600;
    color: #7dd3fc;
  }

  .fb-bc-required {
    font-size: 0.68rem;
    font-weight: 500;
    color: rgba(203, 213, 225, 0.62);
  }

  .fb-bc-input,
  .fb-bc-textarea,
  .fb-bc-select-box {
    width: 100%;
    font-family: var(--font-family-body);
    font-size: 0.88rem;
    color: #f8fafc;
    background: rgba(18, 44, 88, 0.52);
    border: 1px solid rgba(72, 200, 255, 0.16);
    border-radius: 10px;
    padding: 11px 14px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .fb-root[data-mode="edit"] .fb-bc-input,
  .fb-root[data-mode="edit"] .fb-bc-textarea,
  .fb-root[data-mode="edit"] .fb-bc-select-box {
    pointer-events: none;
  }

  .fb-bc-input::placeholder,
  .fb-bc-textarea::placeholder {
    color: rgba(148, 163, 184, 0.62);
  }

  .fb-bc-textarea {
    resize: vertical;
    min-height: 92px;
  }

  .fb-bc-select-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(148, 163, 184, 0.68);
  }

  .fb-bc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .fb-bc-footer-left {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .fb-bc-privacy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: rgba(148, 163, 184, 0.8);
  }

  .fb-bc-privacy svg {
    color: #38bdf8;
    flex-shrink: 0;
  }

  .fb-bc-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    font-family: var(--font-family-body);
    font-size: 0.84rem;
    font-weight: 500;
    color: rgba(203, 213, 225, 0.78);
    padding: 8px 4px;
    cursor: pointer;
  }

  .fb-bc-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 22px;
    border-radius: 999px;
    border: none;
    background: linear-gradient(135deg, #5ce1ff 0%, #38bdf8 55%, #0ea5e9 100%);
    color: #031528;
    font-family: var(--font-family-body);
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow:
      0 0 24px rgba(56, 189, 248, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.65);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .fb-bc-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 32px rgba(56, 189, 248, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .fb-root[data-mode="edit"] .fb-bc-cta-btn.is-selected {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .fb-bc-success {
    text-align: center;
    padding: 12px 8px;
  }

  .fb-bc-success-icon {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.45);
    color: #38bdf8;
    box-shadow: 0 0 26px rgba(56, 189, 248, 0.25);
  }

  /* Right Inspector Panel: Fixed full height + internal scroll */
  .fb-inspector {
    padding: 20px !important;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(72, 200, 255, 0.3) transparent;
  }

  .fb-insp-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fb-insp-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(72, 200, 255, 0.14);
  }

  .fb-insp-title {
    margin: 0;
    font-size: 0.96rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .fb-insp-fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fb-insp-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .fb-col-segmented {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .fb-col-btn {
    appearance: none;
    border: 1px solid rgba(72, 200, 255, 0.2);
    background: rgba(10, 25, 52, 0.55);
    color: #94a3b8;
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 8px 10px;
    border-radius: 9px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .fb-col-btn:hover:not(:disabled) {
    border-color: rgba(72, 200, 255, 0.5);
    color: #f8fafc;
  }

  .fb-col-btn.is-active {
    background: rgba(72, 200, 255, 0.18);
    border-color: rgba(72, 200, 255, 0.55);
    color: #7ee0ff;
  }

  .fb-col-btn:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }

  .fb-insp-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 8px;
    border-top: 1px solid rgba(72, 200, 255, 0.12);
  }

  .fb-mini-btn {
    appearance: none;
    border: 1px solid rgba(72, 200, 255, 0.25);
    background: rgba(10, 25, 52, 0.65);
    color: #cbd5e1;
    font-family: inherit;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 6px 11px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.14s ease;
  }

  .fb-mini-btn:hover {
    border-color: rgba(72, 200, 255, 0.55);
    color: var(--color-text-primary);
  }

  .fb-mini-btn.is-danger {
    border-color: rgba(248, 113, 113, 0.32);
    color: #fca5a5;
  }

  .fb-mini-btn.is-danger:hover {
    border-color: rgba(248, 113, 113, 0.68);
    background: rgba(248, 113, 113, 0.12);
  }
</style>

<script>
  const w = window as any;
  const root = document.getElementById("studio-form-builder") as HTMLElement | null;
  const stageEl = document.getElementById("fb-stage") as HTMLElement | null;
  const cardEl = document.getElementById("fb-bc-card") as HTMLElement | null;

  let config: any = JSON.parse(JSON.stringify(w.__INITIAL_BOOK_CALL_CONFIG__ || {}));
  let fields: any[] = Array.isArray(config.fields) ? config.fields : [];
  let steps: any[] =
    Array.isArray(config.steps) && config.steps.length > 0
      ? config.steps
      : [
          {
            id: "step_1",
            kind: "fields",
            eyebrow: config.step1Eyebrow || "FREE STRATEGY CALL",
            title: config.step1Title || "Let's see how",
            titleHighlight: config.step1TitleHighlight ?? "Adaptif",
            titleSuffix: config.step1TitleSuffix ?? "can help",
            subtitle: config.step1Subtitle || "",
            privacyNote: config.privacyNote || "We'll only use your details to coordinate your call. No spam.",
            cta: config.step1Cta || "Tell us about your project",
          },
          {
            id: "step_2",
            kind: "fields",
            eyebrow: config.step2Eyebrow || "THIS IS OPTIONAL",
            title: config.step2Title || "Help us prepare for your call",
            titleHighlight: "",
            titleSuffix: "",
            subtitle: config.step2Subtitle || "",
            privacyNote: "",
            cta: config.step2Cta || "Book a Call",
          },
          {
            id: "step_3",
            kind: "confirmation",
            eyebrow: config.successEyebrow || "CALL REQUESTED",
            title: config.successTitle || "We've got your details",
            titleHighlight: "",
            titleSuffix: "",
            subtitle: config.successMessage || "",
            privacyNote: "",
            cta: "Back to website",
          },
        ];
  let activeStepIdx = 0;
  let selectedFieldId: string | null = null;
  let selectionMode: "container" | "button" | "field" = "container";
  let dragFromIdx: number | null = null;

  function toast(msg: string, isErr = false) {
    if (typeof w.__SHOW_STUDIO_TOAST__ === "function") {
      w.__SHOW_STUDIO_TOAST__(msg, isErr);
    }
  }

  function getActiveStep() {
    return steps[activeStepIdx] || steps[0];
  }

  function setMode(mode: "edit" | "preview") {
    if (!root) return;
    root.dataset.mode = mode;
    root.querySelectorAll("[data-fb-mode]").forEach((b) => {
      b.classList.toggle("is-active", (b as HTMLElement).dataset.fbMode === mode);
    });
    if (mode === "preview") {
      selectContainer();
    } else {
      renderCanvas();
    }
  }

  function renderStepTabs() {
    const container = document.getElementById("fb-step-tabs");
    if (!container) return;
    container.innerHTML = "";
    steps.forEach((_, idx) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = `fb-seg-btn ${idx === activeStepIdx ? "is-active" : ""}`;
      btn.textContent = `Step ${idx + 1}`;
      btn.draggable = root?.dataset.mode === "edit";

      btn.addEventListener("click", () => {
        activeStepIdx = idx;
        selectContainer();
      });

      btn.addEventListener("dragstart", (e) => {
        dragFromIdx = idx;
        btn.classList.add("is-dragging");
        e.dataTransfer?.setData("text/plain", String(idx));
      });
      btn.addEventListener("dragend", () => {
        dragFromIdx = null;
        btn.classList.remove("is-dragging");
        container.querySelectorAll(".is-drag-over").forEach((el) => el.classList.remove("is-drag-over"));
      });
      btn.addEventListener("dragover", (e) => {
        if (dragFromIdx === null || dragFromIdx === idx) return;
        e.preventDefault();
        btn.classList.add("is-drag-over");
      });
      btn.addEventListener("dragleave", () => btn.classList.remove("is-drag-over"));
      btn.addEventListener("drop", (e) => {
        e.preventDefault();
        btn.classList.remove("is-drag-over");
        if (dragFromIdx === null || dragFromIdx === idx) return;
        const from = dragFromIdx;
        const to = idx;
        // Swap steps
        [steps[from], steps[to]] = [steps[to], steps[from]];
        // Swap field step numbers (1-based)
        fields.forEach((f) => {
          const s = Number(f.step) || 1;
          if (s === from + 1) f.step = to + 1;
          else if (s === to + 1) f.step = from + 1;
        });
        activeStepIdx = to;
        renderStepTabs();
        syncFieldStepDropdown();
        selectContainer();
      });

      container.appendChild(btn);
    });
  }

  function syncFieldStepDropdown() {
    const fStep = document.getElementById("fb-f-step") as HTMLSelectElement | null;
    if (!fStep) return;
    const prev = fStep.value;
    fStep.innerHTML = steps
      .map((s, idx) =>
        s.kind === "fields" ? `<option value="${idx + 1}">Step ${idx + 1}</option>` : ""
      )
      .join("");
    if (prev) fStep.value = prev;
    w.__STUDIO_SYNC_SELECT__?.(fStep);
  }

  function renderActiveStepView() {
    const st = getActiveStep();
    if (!st) return;
    const fieldsView = document.getElementById("fb-canvas-fields-view");
    const confirmView = document.getElementById("fb-canvas-confirm-view");

    if (st.kind === "confirmation") {
      if (fieldsView) fieldsView.hidden = true;
      if (confirmView) confirmView.hidden = false;
      if (cardEl) cardEl.style.maxWidth = "520px";
      const t = document.getElementById("fb-view-c-title");
      const th = document.getElementById("fb-view-c-titleHighlight");
      const sub = document.getElementById("fb-view-c-subtitle");
      const cta = document.getElementById("fb-view-c-cta");
      if (t) t.textContent = st.title || "";
      if (th) th.textContent = st.titleHighlight || "";
      if (sub) sub.textContent = st.subtitle || "";
      if (cta) cta.textContent = st.cta || "Back to website";
      return;
    }

    if (fieldsView) fieldsView.hidden = false;
    if (confirmView) confirmView.hidden = true;
    if (cardEl) cardEl.style.maxWidth = activeStepIdx > 0 ? "780px" : "680px";

    const eb = document.getElementById("fb-view-eyebrow");
    const t = document.getElementById("fb-view-title");
    const th = document.getElementById("fb-view-titleHighlight");
    const ts = document.getElementById("fb-view-titleSuffix");
    const sub = document.getElementById("fb-view-subtitle");
    const privWrap = document.getElementById("fb-canvas-privacy-wrap");
    const priv = document.getElementById("fb-view-privacyNote");
    const backBtn = document.getElementById("fb-canvas-back");
    const cta = document.getElementById("fb-view-cta");

    if (eb) eb.textContent = st.eyebrow || "";
    if (t) t.textContent = st.title || "";
    if (th) th.textContent = st.titleHighlight || "";
    if (ts) ts.textContent = st.titleSuffix || "";
    if (sub) sub.textContent = st.subtitle || "";
    if (priv) priv.textContent = st.privacyNote || "";
    if (privWrap) privWrap.hidden = !st.privacyNote && activeStepIdx > 0;
    if (backBtn) backBtn.hidden = activeStepIdx === 0;
    if (cta) cta.textContent = st.cta || "Continue";
  }

  // Inspector elements
  const inspForm = document.getElementById("fb-insp-form") as HTMLElement | null;
  const inspButton = document.getElementById("fb-insp-button") as HTMLElement | null;
  const inspField = document.getElementById("fb-insp-field") as HTMLElement | null;
  const stepHeading = document.getElementById("fb-insp-step-heading");
  const formNameInput = document.getElementById("fb-cfg-formName") as HTMLInputElement | null;
  const stepEyebrowWrap = document.getElementById("fb-step-eyebrow-wrap");
  const stepEyebrowInput = document.getElementById("fb-step-eyebrow") as HTMLInputElement | null;
  const stepTitleInput = document.getElementById("fb-step-title") as HTMLInputElement | null;
  const stepTitleHiInput = document.getElementById("fb-step-titleHighlight") as HTMLInputElement | null;
  const stepSuffixWrap = document.getElementById("fb-step-suffix-wrap");
  const stepSuffixInput = document.getElementById("fb-step-titleSuffix") as HTMLInputElement | null;
  const stepSubInput = document.getElementById("fb-step-subtitle") as HTMLTextAreaElement | null;
  const stepPrivWrap = document.getElementById("fb-step-privacy-wrap");
  const stepPrivInput = document.getElementById("fb-step-privacy") as HTMLInputElement | null;
  const btnTextInput = document.getElementById("fb-btn-text-input") as HTMLInputElement | null;

  const inspFieldName = document.getElementById("fb-insp-field-name") as HTMLElement | null;
  const fLabel = document.getElementById("fb-f-label") as HTMLInputElement | null;
  const fPh = document.getElementById("fb-f-placeholder") as HTMLInputElement | null;
  const fType = document.getElementById("fb-f-type") as HTMLSelectElement | null;
  const fStep = document.getElementById("fb-f-step") as HTMLSelectElement | null;
  const fOptsWrap = document.getElementById("fb-f-options-wrap") as HTMLElement | null;
  const fOpts = document.getElementById("fb-f-options") as HTMLTextAreaElement | null;
  const fReq = document.getElementById("fb-f-required") as HTMLInputElement | null;
  const fReqPill = document.getElementById("fb-f-req-pill");
  const fReqLbl = document.getElementById("fb-f-req-label");
  const delBtn = document.getElementById("btn-fb-delete-field") as HTMLButtonElement | null;
  const moveLeftBtn = document.getElementById("btn-fb-move-left") as HTMLButtonElement | null;
  const moveRightBtn = document.getElementById("btn-fb-move-right") as HTMLButtonElement | null;

  function syncReqPill(on: boolean) {
    fReqPill?.classList.toggle("is-active", on);
    fReqPill?.classList.toggle("is-inactive", !on);
    if (fReqLbl) fReqLbl.textContent = on ? "Required" : "Optional";
  }

  function syncCtaSelectionRing() {
    ["fb-canvas-cta", "fb-canvas-confirm-cta"].forEach((id) => {
      document.getElementById(id)?.classList.toggle("is-selected", selectionMode === "button");
    });
  }

  function populateInspector() {
    const st = getActiveStep();
    if (!st) return;

    if (selectionMode === "button") {
      if (inspForm) inspForm.hidden = true;
      if (inspField) inspField.hidden = true;
      if (inspButton) inspButton.hidden = false;
      if (btnTextInput) btnTextInput.value = st.cta || "";
      syncCtaSelectionRing();
      return;
    }

    const field = selectionMode === "field" ? fields.find((x) => x.id === selectedFieldId) : null;
    if (!field) {
      selectionMode = "container";
      if (inspForm) inspForm.hidden = false;
      if (inspButton) inspButton.hidden = true;
      if (inspField) inspField.hidden = true;
      syncCtaSelectionRing();

      if (stepHeading) stepHeading.textContent = `Step ${activeStepIdx + 1}`;
      if (formNameInput) formNameInput.value = config.formName || "Book a Call";
      const isConfirm = st.kind === "confirmation";
      const fieldsStepCount = steps.filter((s) => s.kind === "fields").length;
      const delStepBtn = document.getElementById("btn-fb-delete-step");
      if (delStepBtn) delStepBtn.hidden = isConfirm || fieldsStepCount <= 1;

      if (stepEyebrowWrap) stepEyebrowWrap.hidden = isConfirm;
      if (stepSuffixWrap) stepSuffixWrap.hidden = isConfirm;
      if (stepPrivWrap) stepPrivWrap.hidden = isConfirm;

      if (stepEyebrowInput) stepEyebrowInput.value = st.eyebrow || "";
      if (stepTitleInput) stepTitleInput.value = st.title || "";
      if (stepTitleHiInput) stepTitleHiInput.value = st.titleHighlight || "";
      if (stepSuffixInput) stepSuffixInput.value = st.titleSuffix || "";
      if (stepSubInput) stepSubInput.value = st.subtitle || "";
      if (stepPrivInput) stepPrivInput.value = st.privacyNote || "";
      return;
    }

    if (inspForm) inspForm.hidden = true;
    if (inspButton) inspButton.hidden = true;
    if (inspField) inspField.hidden = false;
    syncCtaSelectionRing();

    if (inspFieldName) inspFieldName.textContent = field.label || field.id;
    if (fLabel) fLabel.value = field.label || "";
    if (fPh) fPh.value = field.placeholder || "";
    if (fType) {
      fType.value = field.type || "text";
      w.__STUDIO_ENHANCE_SELECT__?.(fType);
      w.__STUDIO_SYNC_SELECT__?.(fType);
    }
    if (fStep) {
      syncFieldStepDropdown();
      fStep.value = String(field.step || 1);
      w.__STUDIO_ENHANCE_SELECT__?.(fStep);
      w.__STUDIO_SYNC_SELECT__?.(fStep);
    }
    if (fOpts) fOpts.value = Array.isArray(field.options) ? field.options.join(", ") : "";
    if (fOptsWrap) fOptsWrap.hidden = field.type !== "select";
    if (fReq) fReq.checked = Boolean(field.required);
    syncReqPill(Boolean(field.required));

    root?.querySelectorAll<HTMLElement>("[data-col-width]").forEach((b) => {
      b.classList.toggle("is-active", b.dataset.colWidth === (field.width === "full" ? "full" : "half"));
    });

    if (delBtn) delBtn.hidden = Boolean(field.locked);
    const idx = fields.findIndex((x) => x.id === field.id);
    if (moveLeftBtn) moveLeftBtn.disabled = idx <= 0;
    if (moveRightBtn) moveRightBtn.disabled = idx < 0 || idx >= fields.length - 1;
  }

  function selectContainer() {
    selectedFieldId = null;
    selectionMode = "container";
    renderStepTabs();
    renderActiveStepView();
    renderCanvas();
    populateInspector();
  }

  function selectField(id: string) {
    selectedFieldId = id;
    selectionMode = "field";
    renderCanvas();
    populateInspector();
  }

  function selectButton() {
    selectedFieldId = null;
    selectionMode = "button";
    renderCanvas();
    populateInspector();
  }

  function getSelectedField() {
    return fields.find((x) => x.id === selectedFieldId) || null;
  }

  // Form Container Inspector Listeners
  formNameInput?.addEventListener("input", () => {
    config.formName = formNameInput.value;
    const h = document.getElementById("bc-header-form-name");
    const nav = document.getElementById("nav-book-call-label");
    if (h) h.textContent = config.formName || "Untitled Form";
    if (nav) nav.textContent = config.formName || "Untitled Form";
  });

  stepEyebrowInput?.addEventListener("input", () => {
    const st = getActiveStep();
    if (st) {
      st.eyebrow = stepEyebrowInput.value;
      renderActiveStepView();
    }
  });
  stepTitleInput?.addEventListener("input", () => {
    const st = getActiveStep();
    if (st) {
      st.title = stepTitleInput.value;
      renderActiveStepView();
    }
  });
  stepTitleHiInput?.addEventListener("input", () => {
    const st = getActiveStep();
    if (st) {
      st.titleHighlight = stepTitleHiInput.value;
      renderActiveStepView();
    }
  });
  stepSuffixInput?.addEventListener("input", () => {
    const st = getActiveStep();
    if (st) {
      st.titleSuffix = stepSuffixInput.value;
      renderActiveStepView();
    }
  });
  stepSubInput?.addEventListener("input", () => {
    const st = getActiveStep();
    if (st) {
      st.subtitle = stepSubInput.value;
      renderActiveStepView();
    }
  });
  stepPrivInput?.addEventListener("input", () => {
    const st = getActiveStep();
    if (st) {
      st.privacyNote = stepPrivInput.value;
      renderActiveStepView();
    }
  });

  btnTextInput?.addEventListener("input", () => {
    const st = getActiveStep();
    if (st) {
      st.cta = btnTextInput.value;
      renderActiveStepView();
    }
  });

  // Field Inspector Listeners
  fLabel?.addEventListener("input", () => {
    const f = getSelectedField();
    if (!f) return;
    f.label = fLabel.value;
    if (inspFieldName) inspFieldName.textContent = f.label || f.id;
    renderCanvas();
  });

  fPh?.addEventListener("input", () => {
    const f = getSelectedField();
    if (!f) return;
    f.placeholder = fPh.value;
    renderCanvas();
  });

  fType?.addEventListener("change", () => {
    const f = getSelectedField();
    if (!f) return;
    f.type = fType.value;
    if (fOptsWrap) fOptsWrap.hidden = f.type !== "select";
    renderCanvas();
  });

  fStep?.addEventListener("change", () => {
    const f = getSelectedField();
    if (!f) return;
    f.step = Math.max(1, Number(fStep.value) || 1);
    renderCanvas();
  });

  fOpts?.addEventListener("input", () => {
    const f = getSelectedField();
    if (!f) return;
    f.options = fOpts.value
      .split(",")
      .map((s) => s.trim())
      .filter(Boolean);
    renderCanvas();
  });

  fReq?.addEventListener("change", () => {
    const f = getSelectedField();
    if (!f) return;
    f.required = fReq.checked;
    syncReqPill(f.required);
    renderCanvas();
  });

  root?.querySelectorAll<HTMLElement>("[data-col-width]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const f = getSelectedField();
      if (!f) return;
      f.width = btn.dataset.colWidth === "full" ? "full" : "half";
      populateInspector();
      renderCanvas();
    });
  });

  moveLeftBtn?.addEventListener("click", () => {
    const idx = fields.findIndex((x) => x.id === selectedFieldId);
    if (idx > 0) {
      [fields[idx - 1], fields[idx]] = [fields[idx], fields[idx - 1]];
      populateInspector();
      renderCanvas();
    }
  });

  moveRightBtn?.addEventListener("click", () => {
    const idx = fields.findIndex((x) => x.id === selectedFieldId);
    if (idx >= 0 && idx < fields.length - 1) {
      [fields[idx + 1], fields[idx]] = [fields[idx], fields[idx + 1]];
      populateInspector();
      renderCanvas();
    }
  });

  delBtn?.addEventListener("click", () => {
    const f = getSelectedField();
    if (!f || f.locked) return;
    fields = fields.filter((x) => x.id !== f.id);
    selectContainer();
  });

  // Click on form card background or outside stage deselects field/button -> Form Container
  stageEl?.addEventListener("click", (e) => {
    if (root?.dataset.mode !== "edit") return;
    const target = e.target as HTMLElement;
    if (!target.closest(".fb-bc-field") && !target.closest(".fb-bc-cta-btn")) {
      selectContainer();
    }
  });

  function renderCanvas() {
    const grid = document.getElementById("fb-canvas-grid");
    if (!grid) return;
    grid.innerHTML = "";

    const stepNum = activeStepIdx + 1;
    fields
      .filter((f) => (Number(f.step) || 1) === stepNum)
      .forEach((f) => {
        const wrap = document.createElement("div");
        wrap.className = `fb-bc-field ${f.width === "full" ? "is-full" : ""} ${
          selectionMode === "field" && f.id === selectedFieldId ? "is-selected" : ""
        }`;
        wrap.addEventListener("click", (e) => {
          if (root?.dataset.mode !== "edit") return;
          e.stopPropagation();
          selectField(f.id);
        });

        const lbl = document.createElement("label");
        lbl.className = "fb-bc-label";
        lbl.textContent = f.label || f.id;
        if (f.required) {
          const req = document.createElement("span");
          req.className = "fb-bc-required";
          req.textContent = "*Required";
          lbl.appendChild(req);
        }
        wrap.appendChild(lbl);

        if (f.type === "textarea") {
          const ta = document.createElement("textarea");
          ta.className = "fb-bc-textarea";
          ta.rows = 3;
          ta.placeholder = f.placeholder || "";
          wrap.appendChild(ta);
        } else if (f.type === "select") {
          if (root?.dataset.mode === "preview") {
            const sel = document.createElement("select");
            sel.className = "fb-bc-input";
            const ph = document.createElement("option");
            ph.value = "";
            ph.textContent = f.placeholder || "Select an option...";
            sel.appendChild(ph);
            (f.options || []).forEach((opt: string) => {
              const o = document.createElement("option");
              o.value = opt;
              o.textContent = opt;
              sel.appendChild(o);
            });
            wrap.appendChild(sel);
          } else {
            const box = document.createElement("div");
            box.className = "fb-bc-select-box";
            box.innerHTML = `<span>${f.placeholder || "Select an option..."}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>`;
            wrap.appendChild(box);
          }
        } else {
          const inp = document.createElement("input");
          inp.className = "fb-bc-input";
          inp.type = f.type || "text";
          inp.placeholder = f.placeholder || "";
          wrap.appendChild(inp);
        }

        grid.appendChild(wrap);
      });
  }

  // Top bar bindings
  root?.querySelectorAll("[data-fb-mode]").forEach((btn) => {
    btn.addEventListener("click", () => setMode((btn as HTMLElement).dataset.fbMode as any));
  });

  document.getElementById("btn-fb-delete-step")?.addEventListener("click", () => {
    const st = getActiveStep();
    const fieldsStepCount = steps.filter((s) => s.kind === "fields").length;
    if (!st || st.kind === "confirmation" || fieldsStepCount <= 1) return;

    const delNum = activeStepIdx + 1;
    fields.forEach((f) => {
      const s = Number(f.step) || 1;
      if (s === delNum) {
        f.step = Math.max(1, delNum - 1);
      } else if (s > delNum) {
        f.step = s - 1;
      }
    });

    steps.splice(activeStepIdx, 1);
    activeStepIdx = Math.max(0, Math.min(activeStepIdx, steps.length - 1));
    syncFieldStepDropdown();
    selectContainer();
  });

  document.getElementById("btn-fb-add-step")?.addEventListener("click", () => {
    const confirmIdx = steps.findIndex((s) => s.kind === "confirmation");
    const insertAt = confirmIdx >= 0 ? confirmIdx : steps.length;
    const newStep = {
      id: `step_${Date.now().toString(36)}`,
      kind: "fields",
      eyebrow: `STEP ${insertAt + 1}`,
      title: "Tell us more",
      titleHighlight: "",
      titleSuffix: "",
      subtitle: "Add your details below.",
      privacyNote: "",
      cta: "Continue",
    };
    steps.splice(insertAt, 0, newStep);
    activeStepIdx = insertAt;
    syncFieldStepDropdown();
    selectContainer();
  });

  document.getElementById("fb-canvas-cta")?.addEventListener("click", (e) => {
    if (root?.dataset.mode === "preview") {
      if (activeStepIdx < steps.length - 1) {
        activeStepIdx += 1;
        selectContainer();
      }
    } else {
      e.stopPropagation();
      selectButton();
    }
  });

  document.getElementById("fb-canvas-back")?.addEventListener("click", () => {
    if (activeStepIdx > 0) {
      activeStepIdx -= 1;
      selectContainer();
    }
  });

  document.getElementById("fb-canvas-confirm-cta")?.addEventListener("click", (e) => {
    if (root?.dataset.mode === "preview") {
      activeStepIdx = 0;
      selectContainer();
    } else {
      e.stopPropagation();
      selectButton();
    }
  });

  document.getElementById("btn-fb-add-field")?.addEventListener("click", () => {
    const st = getActiveStep();
    const targetStep = st?.kind === "fields" ? activeStepIdx + 1 : 1;
    const id = `field_${Date.now().toString(36).slice(-5)}`;
    fields.push({
      id,
      label: "New Field",
      type: "text",
      placeholder: "Enter value...",
      required: false,
      step: targetStep,
      width: "half",
      options: [],
    });
    setMode("edit");
    if (st?.kind !== "fields") {
      activeStepIdx = 0;
      renderStepTabs();
      renderActiveStepView();
    }
    selectField(id);
  });

  document.getElementById("btn-save-form-builder")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-save-form-builder") as HTMLButtonElement | null;
    if (btn) btn.disabled = true;
    try {
      // Sync primary step metadata back into legacy fields for full compatibility
      const s1 = steps.find((s) => s.kind === "fields") || steps[0];
      const s2 = steps.filter((s) => s.kind === "fields")[1];
      const sc = steps.find((s) => s.kind === "confirmation");
      const payload = {
        ...config,
        step1Eyebrow: s1?.eyebrow ?? config.step1Eyebrow,
        step1Title: s1?.title ?? config.step1Title,
        step1TitleHighlight: s1?.titleHighlight ?? config.step1TitleHighlight,
        step1TitleSuffix: s1?.titleSuffix ?? config.step1TitleSuffix,
        step1Subtitle: s1?.subtitle ?? config.step1Subtitle,
        privacyNote: s1?.privacyNote ?? config.privacyNote,
        step1Cta: s1?.cta ?? config.step1Cta,
        ...(s2
          ? {
              step2Eyebrow: s2.eyebrow,
              step2Title: s2.title,
              step2Subtitle: s2.subtitle,
              step2Cta: s2.cta,
            }
          : {}),
        ...(sc
          ? {
              successTitle: sc.title,
              successMessage: sc.subtitle,
            }
          : {}),
        steps,
        fields,
      };
      const res = await fetch("/api/book-call/config", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Failed to save form");
      toast("Form saved & synced!");
    } catch (err: any) {
      toast(err?.message || "Failed to save form", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  async function pullFromProvider(provider: "activecampaign" | "klaviyo") {
    try {
      const res = await fetch("/api/forms/sync-fields", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ provider }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Pull failed");
      if (Array.isArray(data.fields)) {
        fields = data.fields;
        renderCanvas();
        populateInspector();
      }
      toast(`Pulled ${data.added || 0} fields from ${provider === "activecampaign" ? "ActiveCampaign" : "Klaviyo"}`);
    } catch (err: any) {
      toast(err?.message || "Failed to pull fields", true);
    }
  }

  document.getElementById("btn-pull-ac-fields")?.addEventListener("click", () => pullFromProvider("activecampaign"));
  document.getElementById("btn-pull-klv-fields")?.addEventListener("click", () => pullFromProvider("klaviyo"));

  if (fType) w.__STUDIO_ENHANCE_SELECT__?.(fType);
  if (fStep) w.__STUDIO_ENHANCE_SELECT__?.(fStep);

  setMode("edit");
  syncFieldStepDropdown();
  selectContainer();
</script>
