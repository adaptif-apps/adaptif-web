---
interface Props {
  initialKlaviyo: {
    enabled: boolean;
    hasApiKey: boolean;
    listId: string;
    cachedLists: Array<{ id: string; name: string }>;
    cachedProperties: string[];
    lastSyncedAt: string;
  };
}

const { initialKlaviyo } = Astro.props;
---

<div id="module-klaviyo" hidden>
  <header class="studio-header">
    <div>
      <p class="studio-eyebrow">INTEGRATIONS · CRM</p>
      <h1 class="studio-title">Klaviyo <span>Sync</span></h1>
      <p class="studio-subtitle">
        Connect Klaviyo to sync leads and custom Form Builder fields automatically into profile properties.
      </p>
    </div>
    <div class="studio-header-actions">
      <button type="button" class="acd-btn-cyan" id="btn-save-klaviyo">
        Save Integration
      </button>
    </div>
  </header>

  <section class="studio-card acd-card" style="padding: 20px;">
    <div class="ac-card-head">
      <div>
        <span class="acd-section-kicker">Connection</span>
        <h2 class="bc-cms-card-title" style="margin: 4px 0;">1. Connect Your Account</h2>
        <p class="field-hint" style="margin: 0;">
          Toggle Active to sync leads from the selected form into Klaviyo automatically.
        </p>
      </div>
      <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
        <div class="ac-form-picker">
          <label for="klv-form-selector" class="ac-form-picker-label">Form</label>
          <select id="klv-form-selector" class="studio-select">
            <option value="book-call">Book a Call</option>
          </select>
        </div>
        <label class={`studio-toggle-pill ${initialKlaviyo.enabled ? "is-active" : "is-inactive"}`} id="klv-toggle-pill">
          <input type="checkbox" class="studio-toggle-chk" id="klv-enabled-toggle" checked={initialKlaviyo.enabled} />
          <span class="studio-switch" aria-hidden="true"></span>
          <span class="studio-toggle-text" id="klv-enabled-label">{initialKlaviyo.enabled ? "Active" : "Inactive"}</span>
        </label>
      </div>
    </div>

    <div class="acd-settings-grid" style="margin-top: 18px;">
      <label class="acd-field">
        <span class="acd-label-row">
          Private API Key (pk_...)
          <a href="https://www.klaviyo.com/account#api-keys-tab" target="_blank" rel="noopener noreferrer" class="acd-inline-link">
            Open Klaviyo API Keys ↗
          </a>
        </span>
        <input
          type="password"
          id="klv-api-key"
          placeholder={initialKlaviyo.hasApiKey ? "Saved (leave blank to keep)" : "pk_..."}
        />
      </label>

      <div class="acd-field">
        <span class="acd-label-row">Target List (Optional)</span>
        <select id="klv-list-id" class="studio-select">
          <option value="">Profile Only (No List)</option>
          {initialKlaviyo.cachedLists.map((l) => (
            <option value={l.id} selected={l.id === initialKlaviyo.listId}>{l.name}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="ac-sync-bar" style="margin-top: 18px;">
      <button type="button" class="studio-btn-ghost" id="btn-test-klaviyo">
        Test Connection &amp; Sync Lists
      </button>
      <span class="ac-sync-status" id="klv-sync-status">
        {initialKlaviyo.cachedLists.length > 0
          ? `Synced • ${initialKlaviyo.cachedLists.length} lists`
          : "Not synced yet"}
      </span>
    </div>
  </section>
</div>

<style is:global>
  .studio-toggle-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 13px 7px 9px;
    border-radius: 999px;
    border: 1px solid rgba(72, 200, 255, 0.35);
    background: rgba(72, 200, 255, 0.1);
    cursor: pointer;
    user-select: none;
    transition: all 0.2s ease;
  }

  .studio-toggle-pill.is-active {
    border-color: rgba(52, 211, 153, 0.48);
    background: rgba(52, 211, 153, 0.12);
  }

  .studio-toggle-chk {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .studio-switch {
    position: relative;
    flex-shrink: 0;
    width: 36px;
    height: 20px;
    border-radius: 999px;
    background: rgba(72, 200, 255, 0.24);
    border: 1px solid rgba(72, 200, 255, 0.55);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .studio-switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #67d4ff;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .studio-toggle-chk:checked + .studio-switch {
    background: rgba(52, 211, 153, 0.28);
    border-color: rgba(52, 211, 153, 0.72);
  }

  .studio-toggle-chk:checked + .studio-switch::after {
    transform: translateX(16px);
    background: #34d399;
  }

  .studio-toggle-text {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #7ee0ff;
    min-width: 50px;
  }

  .studio-toggle-pill.is-active .studio-toggle-text {
    color: #6ee7b7;
  }

  .studio-card,
  .acd-card {
    background: linear-gradient(160deg, rgba(14, 34, 70, 0.56) 0%, rgba(7, 18, 40, 0.78) 100%);
    border: 1px solid rgba(72, 200, 255, 0.16);
    border-radius: 18px;
    padding: 24px;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .acd-btn-cyan {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 18px;
    border-radius: 999px;
    border: none;
    background:
      radial-gradient(ellipse 90% 65% at 50% 0%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #56d3ff 0%, #30baff 48%, #0aa3f8 100%);
    color: #031528;
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(72, 200, 255, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .acd-btn-cyan:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(72, 200, 255, 0.42);
  }

  .acd-section-kicker {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #48c8ff;
    margin-bottom: 4px;
  }

  .acd-settings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 720px) {
    .acd-settings-grid {
      grid-template-columns: 1fr;
    }
  }

  .acd-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 0.78rem;
    font-weight: 500;
    color: #94a3b8;
  }

  .ac-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ac-form-picker {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 240px;
  }

  .ac-form-picker-label {
    font-size: 0.76rem;
    font-weight: 600;
    color: #94a3b8;
    white-space: nowrap;
  }

  .ac-sync-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .ac-sync-status {
    font-size: 0.8rem;
    color: #94a3b8;
  }
</style>

<script>
  const w = window as any;

  function toast(msg: string, isErr = false) {
    if (typeof w.__SHOW_STUDIO_TOAST__ === "function") {
      w.__SHOW_STUDIO_TOAST__(msg, isErr);
    } else {
      const el = document.getElementById("studio-toast");
      if (el) {
        el.textContent = msg;
        el.classList.add("is-visible");
        setTimeout(() => el.classList.remove("is-visible"), 2600);
      }
    }
  }

  const klvToggle = document.getElementById("klv-enabled-toggle") as HTMLInputElement | null;
  const klvPill = document.getElementById("klv-toggle-pill");
  const klvLabel = document.getElementById("klv-enabled-label");
  klvToggle?.addEventListener("change", () => {
    const on = klvToggle.checked;
    if (klvLabel) klvLabel.textContent = on ? "Active" : "Inactive";
    klvPill?.classList.toggle("is-active", on);
    klvPill?.classList.toggle("is-inactive", !on);
  });

  document.getElementById("btn-test-klaviyo")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-test-klaviyo") as HTMLButtonElement | null;
    const keyInput = document.getElementById("klv-api-key") as HTMLInputElement | null;
    const listSel = document.getElementById("klv-list-id") as HTMLSelectElement | null;
    const statusEl = document.getElementById("klv-sync-status");
    if (btn) btn.disabled = true;
    try {
      const res = await fetch("/api/klaviyo/test", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ apiKey: keyInput?.value.trim() || "" }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Connection failed");
      if (listSel && Array.isArray(data.lists)) {
        const current = listSel.value;
        listSel.innerHTML =
          `<option value="">Profile Only (No List)</option>` +
          data.lists.map((l: any) => `<option value="${l.id}">${l.name}</option>`).join("");
        listSel.value = current;
        w.__STUDIO_SYNC_SELECT__?.(listSel);
      }
      if (keyInput) {
        keyInput.value = "";
        keyInput.placeholder = "Saved (leave blank to keep)";
      }
      if (statusEl) {
        statusEl.textContent = `Synced • ${(data.lists || []).length} lists`;
      }
      toast(`Klaviyo connected (${(data.lists || []).length} lists synced)`);
    } catch (err: any) {
      toast(err?.message || "Klaviyo connection failed", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  document.getElementById("btn-save-klaviyo")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-save-klaviyo") as HTMLButtonElement | null;
    const keyInput = document.getElementById("klv-api-key") as HTMLInputElement | null;
    const listSel = document.getElementById("klv-list-id") as HTMLSelectElement | null;
    if (btn) btn.disabled = true;
    try {
      const res = await fetch("/api/klaviyo/config", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          enabled: Boolean(klvToggle?.checked),
          apiKey: keyInput?.value.trim() || undefined,
          listId: listSel?.value || "",
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Save failed");
      if (keyInput && data.hasApiKey) {
        keyInput.value = "";
        keyInput.placeholder = "Saved (leave blank to keep)";
      }
      toast("Klaviyo settings saved!");
    } catch (err: any) {
      toast(err?.message || "Failed to save Klaviyo settings", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
