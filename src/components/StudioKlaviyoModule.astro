---
interface Props {
  initialKlaviyo: {
    enabled: boolean;
    hasApiKey: boolean;
    listId: string;
    cachedLists: Array<{ id: string; name: string }>;
    cachedProperties: string[];
    lastSyncedAt: string;
  };
}

const { initialKlaviyo } = Astro.props;
---

<div id="module-klaviyo" hidden>
  <header class="studio-header">
    <div>
      <p class="studio-eyebrow">INTEGRATIONS · CRM</p>
      <h1 class="studio-title">Klaviyo <span>Sync</span></h1>
      <p class="studio-subtitle">
        Connect Klaviyo to sync leads and custom Form Builder fields automatically into profile properties.
      </p>
    </div>
    <div class="studio-header-actions">
      <button type="button" class="acd-btn-cyan" id="btn-save-klaviyo">
        Save Integration
      </button>
    </div>
  </header>

  <section class="bc-cms-card">
    <div class="ac-card-head">
      <div>
        <h2 class="bc-cms-card-title" style="margin-bottom: 4px;">1. Connect Your Account</h2>
        <p class="field-hint" style="margin: 0;">
          Toggle Active to sync leads from the selected form into Klaviyo automatically.
        </p>
      </div>
      <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
        <div class="ac-form-picker">
          <label for="klv-form-selector" class="ac-form-picker-label">Form</label>
          <select id="klv-form-selector" class="ac-select">
            <option value="book-call">Book a Call</option>
          </select>
        </div>
        <label class="toggle-wrap">
          <input type="checkbox" id="klv-enabled-toggle" checked={initialKlaviyo.enabled} />
          <span id="klv-enabled-label">{initialKlaviyo.enabled ? "Active" : "Inactive"}</span>
        </label>
      </div>
    </div>

    <div class="acd-settings-grid" style="margin-top: 16px;">
      <label class="acd-field">
        <span class="acd-label-row">
          Private API Key (pk_...)
          <a href="https://www.klaviyo.com/account#api-keys-tab" target="_blank" rel="noopener noreferrer" class="acd-inline-link">
            Open Klaviyo API Keys ↗
          </a>
        </span>
        <input
          type="password"
          id="klv-api-key"
          placeholder={initialKlaviyo.hasApiKey ? "Saved (leave blank to keep)" : "pk_..."}
        />
      </label>

      <div class="acd-field">
        <span class="acd-label-row">Target List (Optional)</span>
        <select id="klv-list-id" class="studio-select">
          <option value="">Profile Only (No List)</option>
          {initialKlaviyo.cachedLists.map((l) => (
            <option value={l.id} selected={l.id === initialKlaviyo.listId}>{l.name}</option>
          ))}
        </select>
      </div>
    </div>

    <div class="ac-sync-bar">
      <button type="button" class="btn-secondary" id="btn-test-klaviyo">
        Test Connection &amp; Sync Lists
      </button>
      <span class="ac-sync-status" id="klv-sync-status">
        {initialKlaviyo.cachedLists.length > 0
          ? `Synced • ${initialKlaviyo.cachedLists.length} lists`
          : "Not synced yet"}
      </span>
    </div>
  </section>
</div>

<script>
  const w = window as any;

  function toast(msg: string, isErr = false) {
    if (typeof w.__SHOW_STUDIO_TOAST__ === "function") {
      w.__SHOW_STUDIO_TOAST__(msg, isErr);
    } else {
      const el = document.getElementById("studio-toast");
      if (el) {
        el.textContent = msg;
        el.classList.add("is-visible");
        setTimeout(() => el.classList.remove("is-visible"), 2600);
      }
    }
  }

  const klvToggle = document.getElementById("klv-enabled-toggle") as HTMLInputElement | null;
  const klvLabel = document.getElementById("klv-enabled-label");
  klvToggle?.addEventListener("change", () => {
    if (klvLabel) klvLabel.textContent = klvToggle.checked ? "Active" : "Inactive";
  });

  document.getElementById("btn-test-klaviyo")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-test-klaviyo") as HTMLButtonElement | null;
    const keyInput = document.getElementById("klv-api-key") as HTMLInputElement | null;
    const listSel = document.getElementById("klv-list-id") as HTMLSelectElement | null;
    const statusEl = document.getElementById("klv-sync-status");
    if (btn) btn.disabled = true;
    try {
      const res = await fetch("/api/klaviyo/test", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ apiKey: keyInput?.value.trim() || "" }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Connection failed");
      if (listSel && Array.isArray(data.lists)) {
        const current = listSel.value;
        listSel.innerHTML =
          `<option value="">Profile Only (No List)</option>` +
          data.lists.map((l: any) => `<option value="${l.id}">${l.name}</option>`).join("");
        listSel.value = current;
        w.__STUDIO_SYNC_SELECT__?.(listSel);
      }
      if (keyInput) {
        keyInput.value = "";
        keyInput.placeholder = "Saved (leave blank to keep)";
      }
      if (statusEl) {
        statusEl.textContent = `Synced • ${(data.lists || []).length} lists`;
      }
      toast(`Klaviyo connected (${(data.lists || []).length} lists synced)`);
    } catch (err: any) {
      toast(err?.message || "Klaviyo connection failed", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  document.getElementById("btn-save-klaviyo")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-save-klaviyo") as HTMLButtonElement | null;
    const keyInput = document.getElementById("klv-api-key") as HTMLInputElement | null;
    const listSel = document.getElementById("klv-list-id") as HTMLSelectElement | null;
    if (btn) btn.disabled = true;
    try {
      const res = await fetch("/api/klaviyo/config", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          enabled: Boolean(klvToggle?.checked),
          apiKey: keyInput?.value.trim() || undefined,
          listId: listSel?.value || "",
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Save failed");
      if (keyInput && data.hasApiKey) {
        keyInput.value = "";
        keyInput.placeholder = "Saved (leave blank to keep)";
      }
      toast("Klaviyo settings saved!");
    } catch (err: any) {
      toast(err?.message || "Failed to save Klaviyo settings", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
