---
import StudioHeader from "./StudioHeader.astro";

interface Props {
  initialKlaviyo: {
    enabled: boolean;
    syncedForms: string[];
    hasApiKey: boolean;
    listId: string;
    cachedLists: Array<{ id: string; name: string }>;
    cachedProperties: string[];
    lastSyncedAt: string;
  };
}

const { initialKlaviyo } = Astro.props;
---

<div id="module-klaviyo" hidden>
  <StudioHeader
    eyebrow="INTEGRATIONS"
    title="Klaviyo"
  >
    <button slot="actions" type="button" class="adaptif-btn adaptif-btn--sm" id="btn-save-klaviyo">
      Save Integration
    </button>
  </StudioHeader>

  <div class="gi-flat-layout">
    <section class="gi-section-band pay-section-band--first">
      <div class="gi-section-aside">
        <span class="acd-section-kicker">Connection</span>
        <h2 class="gi-section-heading">1. Connect Your Account</h2>
        <p class="gi-section-sub">
          Toggle Active to sync leads from the selected forms into Klaviyo automatically.
        </p>
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 6px;">
          <div class="ac-form-picker">
            <span class="ac-form-picker-label">Forms</span>
            <div class="studio-multiselect" id="klv-forms-multiselect">
              <button type="button" class={`studio-dropdown-trigger ${initialKlaviyo.syncedForms.length ? "has-value" : ""}`} aria-expanded="false">
                <span class="studio-dropdown-value" data-ms-summary>
                  {initialKlaviyo.syncedForms.includes("book-call") ? "Book a Call" : "No forms selected"}
                </span>
                <svg class="studio-dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="studio-dropdown-menu">
                <label class="studio-ms-option">
                  <input type="checkbox" value="book-call" data-label="Book a Call" checked={initialKlaviyo.syncedForms.includes("book-call")} />
                  <span class="studio-ms-box" aria-hidden="true"></span>
                  <span>Book a Call</span>
                </label>
              </div>
            </div>
          </div>
          <label class={`studio-toggle-pill ${initialKlaviyo.enabled ? "is-active" : "is-inactive"}`} id="klv-toggle-pill">
            <input type="checkbox" class="studio-toggle-chk" id="klv-enabled-toggle" checked={initialKlaviyo.enabled} />
            <span class="studio-switch" aria-hidden="true"></span>
            <span class="studio-toggle-text" id="klv-enabled-label">{initialKlaviyo.enabled ? "Active" : "Inactive"}</span>
          </label>
        </div>
      </div>

      <div class="gi-section-main">
        <div class="acd-settings-grid">
          <label class="acd-field">
            <span class="acd-label-row">
              Private API Key (pk_...)
              <a href="https://www.klaviyo.com/account#api-keys-tab" target="_blank" rel="noopener noreferrer" class="studio-link studio-link--inline">
                Open Klaviyo API Keys ↗
              </a>
            </span>
            <input
              type="password"
              id="klv-api-key"
              placeholder={initialKlaviyo.hasApiKey ? "Saved (leave blank to keep)" : "pk_..."}
            />
          </label>

          <div class="acd-field">
            <span class="acd-label-row">Target List (Optional)</span>
            <select id="klv-list-id" class="studio-select">
              <option value="">Profile Only (No List)</option>
              {initialKlaviyo.cachedLists.map((l) => (
                <option value={l.id} selected={l.id === initialKlaviyo.listId}>{l.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="ac-sync-bar">
          <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm" id="btn-test-klaviyo">
            Test Connection &amp; Sync Lists
          </button>
          <span class="ac-sync-status" id="klv-sync-status">
            {initialKlaviyo.cachedLists.length > 0
              ? `Synced • ${initialKlaviyo.cachedLists.length} lists`
              : "Not synced yet"}
          </span>
        </div>
      </div>
    </section>
  </div>
</div>

<style is:global>
  .studio-toggle-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 13px 7px 9px;
    border-radius: 999px;
    border: 1px solid rgba(72, 200, 255, 0.35);
    background: rgba(72, 200, 255, 0.1);
    cursor: pointer;
    user-select: none;
    transition: all 0.2s ease;
  }

  .studio-toggle-pill.is-active {
    border-color: rgba(52, 211, 153, 0.48);
    background: rgba(52, 211, 153, 0.12);
  }

  .studio-toggle-chk {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .studio-switch {
    position: relative;
    flex-shrink: 0;
    width: 36px;
    height: 20px;
    border-radius: 999px;
    background: rgba(72, 200, 255, 0.24);
    border: 1px solid rgba(72, 200, 255, 0.55);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .studio-switch::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #67d4ff;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .studio-toggle-chk:checked + .studio-switch {
    background: rgba(52, 211, 153, 0.28);
    border-color: rgba(52, 211, 153, 0.72);
  }

  .studio-toggle-chk:checked + .studio-switch::after {
    transform: translateX(16px);
    background: #34d399;
  }

  .studio-toggle-text {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #7ee0ff;
    min-width: 50px;
  }

  .studio-toggle-pill.is-active .studio-toggle-text {
    color: #6ee7b7;
  }

  /* .studio-card surface is defined globally in src/styles/global.css */

  .acd-btn-cyan {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 18px;
    border-radius: 999px;
    border: none;
    background:
      radial-gradient(ellipse 90% 65% at 50% 0%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 70%),
      linear-gradient(180deg, #56d3ff 0%, #30baff 48%, #0aa3f8 100%);
    color: #031528;
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(72, 200, 255, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .acd-btn-cyan:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(72, 200, 255, 0.42);
  }

  .gi-flat-layout {
    display: flex;
    flex-direction: column;
    max-width: 1080px;
  }

  .gi-section-band {
    display: grid;
    grid-template-columns: minmax(220px, 290px) minmax(0, 1fr);
    gap: 28px 40px;
    padding: 28px 0;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
    align-items: start;
  }

  .pay-section-band--first {
    border-top: none;
    padding-top: 20px;
  }

  @media (max-width: 860px) {
    .gi-section-band {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 22px 0;
    }
  }

  .gi-section-aside {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .gi-aside-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .gi-section-heading {
    margin: 0;
    font-family: var(--font-sans, "Roboto", -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: #f8fafc;
    line-height: 1.35;
  }

  .gi-section-sub {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.55;
    color: rgba(203, 213, 225, 0.68);
  }

  .gi-aside-action {
    margin-top: 6px;
  }

  .gi-section-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .pay-inline-guide {
    margin-top: 8px;
    padding: 4px 0 2px 14px;
    border-left: 2px solid rgba(72, 200, 255, 0.4);
  }

  .acd-section-kicker {
    display: block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #48c8ff;
    margin-bottom: 4px;
  }

  .acd-settings-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 720px) {
    .acd-settings-grid {
      grid-template-columns: 1fr;
    }
  }

  .acd-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 0.78rem;
    font-weight: 500;
    color: #94a3b8;
  }

  .ac-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ac-form-picker {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 240px;
  }

  .ac-form-picker-label {
    font-size: 0.76rem;
    font-weight: 600;
    color: #94a3b8;
    white-space: nowrap;
  }

  .ac-sync-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .ac-sync-status {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .bc-cms-card-title {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: #7dd3fc;
    margin: 0 0 16px;
  }

  .field-hint {
    margin: 0;
    font-size: 0.76rem;
    color: #64748b;
  }

  .acd-label-link {
    color: #48c8ff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(72, 200, 255, 0.45);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .acd-label-link:hover {
    color: #9ce2ff;
    text-decoration-color: rgba(156, 226, 255, 0.85);
  }

  .studio-multiselect {
    position: relative;
    width: 100%;
  }

  .studio-multiselect.is-open {
    z-index: 80;
  }

  .studio-multiselect .studio-dropdown-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    min-width: 200px;
    z-index: 60;
    padding: 6px;
    border-radius: 12px;
    background: #0a1834;
    border: 1px solid rgba(72, 200, 255, 0.28);
    box-shadow: 0 14px 32px rgba(2, 8, 22, 0.72);
  }

  .studio-ms-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 0.84rem;
    color: #e2e8f0;
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease;
  }

  .studio-ms-option:hover {
    background: rgba(72, 200, 255, 0.12);
  }

  .studio-ms-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .studio-ms-box {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border: 1px solid rgba(72, 200, 255, 0.45);
    background: rgba(18, 44, 88, 0.55);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .studio-ms-option input:checked + .studio-ms-box {
    background: #48c8ff;
    border-color: #48c8ff;
  }

  .studio-ms-option input:checked + .studio-ms-box::after {
    content: "";
    width: 5px;
    height: 9px;
    border: solid #031528;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) translate(-0.5px, -0.5px);
  }
</style>

<script>
  const w = window as any;

  function toast(msg: string, isErr = false) {
    if (typeof w.__SHOW_STUDIO_TOAST__ === "function") {
      w.__SHOW_STUDIO_TOAST__(msg, isErr);
    } else {
      const el = document.getElementById("studio-toast");
      if (el) {
        el.textContent = msg;
        el.classList.add("is-visible");
        setTimeout(() => el.classList.remove("is-visible"), 2600);
      }
    }
  }

  const klvToggle = document.getElementById("klv-enabled-toggle") as HTMLInputElement | null;
  const klvPill = document.getElementById("klv-toggle-pill");
  const klvLabel = document.getElementById("klv-enabled-label");
  klvToggle?.addEventListener("change", () => {
    const on = klvToggle.checked;
    if (klvLabel) klvLabel.textContent = on ? "Active" : "Inactive";
    klvPill?.classList.toggle("is-active", on);
    klvPill?.classList.toggle("is-inactive", !on);
  });

  function initMultiSelect(root: HTMLElement | null) {
    if (!root || root.dataset.msBound === "1") return;
    root.dataset.msBound = "1";
    const trigger = root.querySelector(".studio-dropdown-trigger") as HTMLButtonElement | null;
    const menu = root.querySelector(".studio-dropdown-menu") as HTMLElement | null;
    const summary = root.querySelector("[data-ms-summary]") as HTMLElement | null;
    const checkboxes = Array.from(root.querySelectorAll('input[type="checkbox"]')) as HTMLInputElement[];

    function syncSummary() {
      const checked = checkboxes.filter((c) => c.checked);
      if (summary) {
        if (checked.length === 0) {
          summary.textContent = "No forms selected";
        } else if (checked.length === 1) {
          summary.textContent = checked[0].dataset.label || checked[0].value;
        } else {
          summary.textContent = `${checked.length} forms selected`;
        }
      }
      trigger?.classList.toggle("has-value", checked.length > 0);
    }

    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const willOpen = !root.classList.contains("is-open");
      document.querySelectorAll(".studio-multiselect.is-open").forEach((el) => {
        if (el !== root) {
          el.classList.remove("is-open");
          el.querySelector(".studio-dropdown-menu")?.setAttribute("hidden", "");
          el.querySelector(".studio-dropdown-trigger")?.setAttribute("aria-expanded", "false");
        }
      });
      root.classList.toggle("is-open", willOpen);
      if (menu) menu.hidden = !willOpen;
      trigger.setAttribute("aria-expanded", String(willOpen));
    });

    checkboxes.forEach((cb) => cb.addEventListener("change", syncSummary));
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) {
        root.classList.remove("is-open");
        if (menu) menu.hidden = true;
        trigger?.setAttribute("aria-expanded", "false");
      }
    });

    syncSummary();
  }

  w.__STUDIO_INIT_MULTISELECT__ = initMultiSelect;
  w.__STUDIO_GET_MULTISELECT_VALUES__ = (root: HTMLElement | null): string[] => {
    if (!root) return [];
    return Array.from(root.querySelectorAll('input[type="checkbox"]:checked')).map(
      (el) => (el as HTMLInputElement).value
    );
  };

  document.querySelectorAll(".studio-multiselect").forEach((el) => {
    initMultiSelect(el as HTMLElement);
  });

  document.getElementById("btn-test-klaviyo")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-test-klaviyo") as HTMLButtonElement | null;
    const keyInput = document.getElementById("klv-api-key") as HTMLInputElement | null;
    const listSel = document.getElementById("klv-list-id") as HTMLSelectElement | null;
    const statusEl = document.getElementById("klv-sync-status");
    if (btn) btn.disabled = true;
    try {
      const res = await fetch("/api/klaviyo/test", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ apiKey: keyInput?.value.trim() || "" }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Connection failed");
      if (listSel && Array.isArray(data.lists)) {
        const current = listSel.value;
        listSel.innerHTML =
          `<option value="">Profile Only (No List)</option>` +
          data.lists.map((l: any) => `<option value="${l.id}">${l.name}</option>`).join("");
        listSel.value = current;
        w.__STUDIO_SYNC_SELECT__?.(listSel);
      }
      if (keyInput) {
        keyInput.value = "";
        keyInput.placeholder = "Saved (leave blank to keep)";
      }
      if (statusEl) {
        statusEl.textContent = `Synced • ${(data.lists || []).length} lists`;
      }
      toast(`Klaviyo connected (${(data.lists || []).length} lists synced)`);
    } catch (err: any) {
      toast(err?.message || "Klaviyo connection failed", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  document.getElementById("btn-save-klaviyo")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-save-klaviyo") as HTMLButtonElement | null;
    const keyInput = document.getElementById("klv-api-key") as HTMLInputElement | null;
    const listSel = document.getElementById("klv-list-id") as HTMLSelectElement | null;
    if (btn) btn.disabled = true;
    try {
      const res = await fetch("/api/klaviyo/config", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          enabled: Boolean(klvToggle?.checked),
          syncedForms: w.__STUDIO_GET_MULTISELECT_VALUES__?.(document.getElementById("klv-forms-multiselect")) ?? ["book-call"],
          apiKey: keyInput?.value.trim() || undefined,
          listId: listSel?.value || "",
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Save failed");
      if (keyInput && data.hasApiKey) {
        keyInput.value = "";
        keyInput.placeholder = "Saved (leave blank to keep)";
      }
      toast("Klaviyo settings saved!");
    } catch (err: any) {
      toast(err?.message || "Failed to save Klaviyo settings", true);
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
