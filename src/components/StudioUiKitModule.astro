---
import StudioHeader from "./StudioHeader.astro";
---

<div id="module-ui-kit" hidden>
  <StudioHeader
    eyebrow="CONFIGURATION"
    title="UI Kit"
  />

  <div class="uikit-workspace">
    <!-- Left List: Categories + Instant Search -->
    <section class="uikit-list-panel" aria-label="UI Kit categories">
      <div class="panel-search-wrap">
        <input
          type="search"
          id="uikit-search"
          class="panel-search"
          placeholder="Search UI Kit..."
          autocomplete="off"
        />
      </div>
      <div class="uikit-cat-list" id="uikit-cat-list">
        <button type="button" class="uikit-cat-item is-active" data-uikit-cat="all">
          <span class="uikit-cat-title">All Elements</span>
          <span class="uikit-cat-meta">8 categories</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="tokens">
          <span class="uikit-cat-title">Color Tokens</span>
          <span class="uikit-cat-meta">01 · Palette &amp; CSS vars</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="typography">
          <span class="uikit-cat-title">Typography</span>
          <span class="uikit-cat-meta">02 · Headings &amp; eyebrows</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="buttons">
          <span class="uikit-cat-title">Buttons &amp; Links</span>
          <span class="uikit-cat-meta">03 · .adaptif-btn, .cms-btn, .studio-link</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="badges">
          <span class="uikit-cat-title">Badges, Pills &amp; Tabs</span>
          <span class="uikit-cat-meta">04 · Tags, status, toggles &amp; tabs</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="inputs">
          <span class="uikit-cat-title">Inputs &amp; Surfaces</span>
          <span class="uikit-cat-meta">05 · Inputs, dropdowns &amp; title bar</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="cards">
          <span class="uikit-cat-title">Cards &amp; Panels</span>
          <span class="uikit-cat-meta">06 · Glass, leader, hairline &amp; rows</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="banners">
          <span class="uikit-cat-title">Banners &amp; Upsells</span>
          <span class="uikit-cat-meta">07 · Upsell &amp; AI spotlight banners</span>
        </button>
        <button type="button" class="uikit-cat-item" data-uikit-cat="layouts">
          <span class="uikit-cat-title">Editorial &amp; Metrics</span>
          <span class="uikit-cat-meta">08 · Metric strips, splits &amp; FAQs</span>
        </button>
      </div>
    </section>

    <!-- Right Column: Live Components -->
    <div class="uikit-main-col" id="uikit-main-col">
      <!-- 1. Colors & Tokens -->
      <section class="uikit-card" data-uikit-section="tokens">
        <div class="uikit-card-head">
          <p class="adaptif-eyebrow">01 · TOKENS</p>
          <h2 class="uikit-card-title">Color Palette</h2>
        </div>
        <div class="uikit-swatch-grid">
          <div class="uikit-swatch" data-uikit-search-item="void --color-void background">
            <span class="uikit-swatch-box" style="background: var(--color-void);"></span>
            <div>
              <strong>Void</strong>
              <code>--color-void</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="obsidian 950 --color-obsidian-950 background">
            <span class="uikit-swatch-box" style="background: var(--color-obsidian-950);"></span>
            <div>
              <strong>Obsidian 950</strong>
              <code>--color-obsidian-950</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="brand cyan --color-brand-cyan">
            <span class="uikit-swatch-box" style="background: var(--color-brand-cyan);"></span>
            <div>
              <strong>Brand Cyan</strong>
              <code>--color-brand-cyan</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="blue radiant --color-blue-radiant">
            <span class="uikit-swatch-box" style="background: var(--color-blue-radiant);"></span>
            <div>
              <strong>Blue Radiant</strong>
              <code>--color-blue-radiant</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="text primary --color-text-primary">
            <span class="uikit-swatch-box" style="background: var(--color-text-primary);"></span>
            <div>
              <strong>Text Primary</strong>
              <code>--color-text-primary</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="text secondary --color-text-secondary">
            <span class="uikit-swatch-box" style="background: var(--color-text-secondary);"></span>
            <div>
              <strong>Text Secondary</strong>
              <code>--color-text-secondary</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="obsidian 900 --color-obsidian-900 background">
            <span class="uikit-swatch-box" style="background: var(--color-obsidian-900);"></span>
            <div>
              <strong>Obsidian 900</strong>
              <code>--color-obsidian-900</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="obsidian 850 --color-obsidian-850 background">
            <span class="uikit-swatch-box" style="background: var(--color-obsidian-850);"></span>
            <div>
              <strong>Obsidian 850</strong>
              <code>--color-obsidian-850</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="blue azure --color-blue-azure">
            <span class="uikit-swatch-box" style="background: var(--color-blue-azure);"></span>
            <div>
              <strong>Blue Azure</strong>
              <code>--color-blue-azure</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="blue cobalt --color-blue-cobalt">
            <span class="uikit-swatch-box" style="background: var(--color-blue-cobalt);"></span>
            <div>
              <strong>Blue Cobalt</strong>
              <code>--color-blue-cobalt</code>
            </div>
          </div>
          <div class="uikit-swatch" data-uikit-search-item="text muted --color-text-muted">
            <span class="uikit-swatch-box" style="background: var(--color-text-muted);"></span>
            <div>
              <strong>Text Muted</strong>
              <code>--color-text-muted</code>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Typography & Eyebrows -->
      <section class="uikit-card" data-uikit-section="typography">
        <div class="uikit-card-head">
          <p class="adaptif-eyebrow">02 · TYPOGRAPHY</p>
          <h2 class="uikit-card-title">Headings, Eyebrows &amp; Highlights</h2>
        </div>
        <div class="uikit-stack">
          <div class="uikit-row" data-uikit-search-item="eyebrow .adaptif-eyebrow .studio-eyebrow">
            <div>
              <p class="adaptif-eyebrow">SECTION EYEBROW</p>
              <code>.adaptif-eyebrow / .studio-eyebrow</code>
            </div>
          </div>
          <div class="uikit-row" data-uikit-search-item="serif title heading .studio-title">
            <div>
              <h3 class="studio-title">Display Serif <span>with Italic Accent</span></h3>
              <code>.studio-title / .studio-title span</code>
            </div>
          </div>
          <div class="uikit-row" data-uikit-search-item="highlight .title-highlight">
            <div>
              <p class="uikit-display-sample">
                Scale creative output <span class="title-highlight">without losing craft</span>
              </p>
              <code>.title-highlight</code>
            </div>
          </div>
          <div class="uikit-row" data-uikit-search-item="glow gradient .text-glow-blue .text-gradient-subtle">
            <div>
              <p class="uikit-display-sample text-glow-blue">Text Glow Blue</p>
              <code>.text-glow-blue</code>
            </div>
            <div>
              <p class="uikit-display-sample text-gradient-subtle">Text Gradient Subtle</p>
              <code>.text-gradient-subtle</code>
            </div>
          </div>
          <div class="uikit-row" data-uikit-search-item="body paragraph copy sans inter sf pro --font-family-body --font-size-subhero --color-text-secondary">
            <div>
              <p class="uikit-body-lead">
                Lead Paragraph — Plug an AI-driven creative department into your team with 48-hour turnarounds.
              </p>
              <code>--font-family-body · --font-size-subhero · --font-line-height-subhero (1.55)</code>
            </div>
          </div>
          <div class="uikit-row" data-uikit-search-item="paragraph body secondary text --font-family-body --color-text-secondary">
            <div>
              <p class="uikit-body-copy">
                Body Paragraph (Roboto) — Used across descriptions, cards, FAQs, and upsell banners for high-legibility dark-mode reading.
              </p>
              <code>--font-family-body · 0.95rem · --color-text-secondary</code>
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Primary & Sober Action Buttons + Links -->
      <section class="uikit-card" data-uikit-section="buttons">
        <div class="uikit-card-head">
          <p class="adaptif-eyebrow">03 · BUTTONS &amp; LINKS</p>
          <h2 class="uikit-card-title">Unified Interactive Controls</h2>
        </div>

        <div class="uikit-subsection" data-uikit-search-item="adaptif-btn primary cta dark danger bevel">
          <p class="uikit-sublabel">Primary &amp; Bevel Buttons (<code>.adaptif-btn</code>)</p>
          <div class="uikit-flex-row">
            <div class="uikit-item">
              <button type="button" class="adaptif-btn">Primary CTA →</button>
              <code>.adaptif-btn</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="adaptif-btn adaptif-btn--sm">Compact Primary</button>
              <code>.adaptif-btn.adaptif-btn--sm</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="adaptif-btn adaptif-btn--dark">Secondary CTA</button>
              <code>.adaptif-btn.adaptif-btn--dark</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="adaptif-btn adaptif-btn--dark adaptif-btn--sm">Compact Secondary</button>
              <code>.adaptif-btn.adaptif-btn--dark.adaptif-btn--sm</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="adaptif-btn adaptif-btn--danger adaptif-btn--sm">Danger Bevel</button>
              <code>.adaptif-btn.adaptif-btn--danger.adaptif-btn--sm</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="adaptif-btn adaptif-btn--light adaptif-btn--sm">Explore all our work →</button>
              <code>.adaptif-btn.adaptif-btn--light</code>
            </div>
          </div>
        </div>

        <div class="uikit-subsection" data-uikit-search-item="cms-btn outline pill sober save danger delete disabled">
          <p class="uikit-sublabel">Sober Outline Pill Buttons (<code>.cms-btn</code>)</p>
          <div class="uikit-flex-row">
            <div class="uikit-item">
              <button type="button" class="cms-btn">Neutral Action ▾</button>
              <code>.cms-btn</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="cms-btn cms-btn--save">Save / Accent Action</button>
              <code>.cms-btn.cms-btn--save</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="cms-btn cms-btn--danger">Delete / Remove</button>
              <code>.cms-btn.cms-btn--danger</code>
            </div>
            <div class="uikit-item">
              <button type="button" class="cms-btn" disabled>Disabled State</button>
              <code>.cms-btn:disabled</code>
            </div>
          </div>
        </div>

        <div class="uikit-subsection" data-uikit-search-item="studio-link link inline sitemap webhook">
          <p class="uikit-sublabel">Navigation &amp; Inline Links (<code>.studio-link</code>)</p>
          <div class="uikit-flex-row">
            <div class="uikit-item">
              <a href="#ui-kit" class="studio-link" onclick="return false;">View Sitemap ↗</a>
              <code>.studio-link</code>
            </div>
            <div class="uikit-item">
              <a href="#ui-kit" class="studio-link studio-link--inline" onclick="return false;">Open Stripe Webhooks ↗</a>
              <code>.studio-link.studio-link--inline</code>
            </div>
          </div>
        </div>
      </section>

      <!-- 4. Tags, Status Badges & Tabs -->
      <section class="uikit-card" data-uikit-section="badges">
        <div class="uikit-card-head">
          <p class="adaptif-eyebrow">04 · BADGES &amp; TABS</p>
          <h2 class="uikit-card-title">Tags, Status Pills &amp; Segmented Tabs</h2>
        </div>
        <div class="uikit-stack">
          <div class="uikit-flex-row" data-uikit-search-item="tag adaptif-tag white cyan muted">
            <div class="uikit-item">
              <span class="adaptif-tag adaptif-tag--white">NEW</span>
              <code>.adaptif-tag--white</code>
            </div>
            <div class="uikit-item">
              <span class="adaptif-tag adaptif-tag--cyan">AI POWERED</span>
              <code>.adaptif-tag--cyan</code>
            </div>
            <div class="uikit-item">
              <span class="adaptif-tag adaptif-tag--muted">OPTIONAL</span>
              <code>.adaptif-tag--muted</code>
            </div>
          </div>

          <div class="uikit-flex-row" data-uikit-search-item="status badge draft published scheduled cms-status-badge">
            <div class="uikit-item">
              <span class="cms-status-badge">Draft</span>
              <code>.cms-status-badge</code>
            </div>
            <div class="uikit-item">
              <span class="cms-status-badge is-published">Published</span>
              <code>.cms-status-badge.is-published</code>
            </div>
            <div class="uikit-item">
              <span class="cms-status-badge is-scheduled">Scheduled</span>
              <code>.cms-status-badge.is-scheduled</code>
            </div>
          </div>

          <div class="uikit-item" data-uikit-search-item="tabs cms-tabs-bar cms-tab-btn">
            <div class="cms-tabs-bar">
              <button type="button" class="cms-tab-btn is-active">Settings &amp; Assets</button>
              <button type="button" class="cms-tab-btn">AI Generator</button>
            </div>
            <code>.cms-tabs-bar / .cms-tab-btn.is-active</code>
          </div>

          <div class="uikit-flex-row" data-uikit-search-item="toggle switch studio-toggle-pill active inactive">
            <div class="uikit-item">
              <label class="studio-toggle-pill is-active">
                <input type="checkbox" class="studio-toggle-chk" checked />
                <span class="studio-switch" aria-hidden="true"></span>
                <span class="studio-toggle-text">Active</span>
              </label>
              <code>.studio-toggle-pill.is-active</code>
            </div>
            <div class="uikit-item">
              <label class="studio-toggle-pill is-inactive">
                <input type="checkbox" class="studio-toggle-chk" />
                <span class="studio-switch" aria-hidden="true"></span>
                <span class="studio-toggle-text">Inactive</span>
              </label>
              <code>.studio-toggle-pill.is-inactive</code>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Form Controls & Editorial Title Bar -->
      <section class="uikit-card" data-uikit-section="inputs">
        <div class="uikit-card-head">
          <p class="adaptif-eyebrow">05 · INPUTS &amp; SURFACES</p>
          <h2 class="uikit-card-title">Inputs, Dropdowns &amp; Title Bar</h2>
        </div>
        <div class="uikit-stack">
          <div class="uikit-item" data-uikit-search-item="input adaptif-input text field">
            <input type="text" class="adaptif-input" value="https://adaptif-web.vercel.app" readonly />
            <code>.adaptif-input</code>
          </div>

          <div class="uikit-item" data-uikit-search-item="select dropdown studio-dropdown">
            <select id="uikit-sample-select">
              <option value="published">Public (Publish immediately)</option>
              <option value="draft">Private (Draft)</option>
              <option value="scheduled">Scheduled</option>
            </select>
            <code>&lt;select&gt; (auto-enhanced .studio-dropdown)</code>
          </div>

          <div class="uikit-item" data-uikit-search-item="title bar cms-item-title-bar cms-item-title-input">
            <div class="cms-item-title-bar" style="width: 100%;">
              <input type="text" class="cms-item-title-input" value="Editable Item Title" readonly />
              <span class="cms-status-badge is-published">Published</span>
            </div>
            <code>.cms-item-title-bar / .cms-item-title-input</code>
          </div>
        </div>
      </section>

      <!-- 6. Cards & Panels (Web Layouts) -->
      <section class="uikit-card" data-uikit-section="cards">
        <div class="uikit-card-head">
          <p class="adaptif-eyebrow">06 · CARDS &amp; PANELS</p>
          <h2 class="uikit-card-title">Website Card Patterns</h2>
        </div>
        <div class="uikit-stack">
          <div class="uikit-subsection" data-uikit-search-item="glass-panel card surface frosted">
            <div class="uikit-subhead-row">
              <p class="uikit-sublabel">Standard Frosted Glass Panel (<code>.glass-panel</code>)</p>
              <button type="button" class="cms-btn" data-copy-snippet='<div class="glass-panel" style="padding: 28px; border-radius: 20px;">...</div>'>Copy Snippet</button>
            </div>
            <div class="glass-panel uikit-demo-glass">
              <p class="adaptif-eyebrow">FEATURED SURFACE</p>
              <h3 class="uikit-demo-h3">Primary Focal Panel</h3>
              <p class="uikit-body-copy" style="margin:0;">Reserved for primary interactive panels, selectors, and pricing cards.</p>
            </div>
          </div>

          <div class="uikit-subsection" data-uikit-search-item="leader expert team card portrait valentina">
            <div class="uikit-subhead-row">
              <p class="uikit-sublabel">Expert / Leader Card (Used in Audit &amp; AI Excellence)</p>
              <button type="button" class="cms-btn" data-copy-snippet='<article class="glass-panel uikit-demo-leader"><img src="/images/ai-excellence/expert-valentina.jpg" alt="" /><div><span class="adaptif-eyebrow">Strategy Lead</span><h3>Valentina Lugo</h3><p>...</p></div></article>'>Copy Snippet</button>
            </div>
            <article class="glass-panel uikit-demo-leader">
              <div class="uikit-demo-leader__img">
                <img src="/images/ai-excellence/expert-valentina.jpg" alt="Valentina Lugo" loading="lazy" />
              </div>
              <div>
                <span class="adaptif-eyebrow">Strategy Lead</span>
                <h3 class="uikit-demo-serif">Valentina Lugo</h3>
                <p class="uikit-body-copy" style="margin:0;">Leads Email &amp; Retention and Website &amp; Funnel audits: offer, funnel, lifecycle, pricing and conversion.</p>
              </div>
            </article>
          </div>

          <div class="uikit-subsection" data-uikit-search-item="hairline grid deliverable cell numbered 01 02 03">
            <div class="uikit-subhead-row">
              <p class="uikit-sublabel">Open Hairline Grid (No Nested Boxes — Used in Deliverables)</p>
              <button type="button" class="cms-btn" data-copy-snippet='<div class="uikit-demo-hairline-grid"><div class="uikit-demo-hairline-cell"><span>01</span><h4>Executive Snapshot</h4><p>...</p></div></div>'>Copy Snippet</button>
            </div>
            <div class="uikit-demo-hairline-grid">
              <div class="uikit-demo-hairline-cell">
                <span class="uikit-demo-num">01</span>
                <h4>Executive Snapshot</h4>
                <p>The central findings and the primary opportunity.</p>
              </div>
              <div class="uikit-demo-hairline-cell">
                <span class="uikit-demo-num">02</span>
                <h4>Visual Scorecard</h4>
                <p>Maturity level per area: critical, weak, acceptable, solid or advanced.</p>
              </div>
              <div class="uikit-demo-hairline-cell">
                <span class="uikit-demo-num">03</span>
                <h4>Opportunity Map</h4>
                <p>Recommendations ordered by impact, effort and priority.</p>
              </div>
            </div>
          </div>

          <div class="uikit-subsection" data-uikit-search-item="scorecard row status badge critical weak solid advanced">
            <div class="uikit-subhead-row">
              <p class="uikit-sublabel">Scorecard Diagnostic Row</p>
              <button type="button" class="cms-btn" data-copy-snippet='<div class="uikit-demo-score-row"><strong>Winback</strong><span>Buyers from 6+ months ago never hear from you again.</span><span class="uikit-sem-badge is-critical">Critical</span></div>'>Copy Snippet</button>
            </div>
            <div class="uikit-demo-score-list">
              <div class="uikit-demo-score-row">
                <strong>Lead capture</strong>
                <span>One 10% popup for every visitor, no origin segmenting.</span>
                <span class="uikit-sem-badge is-weak">Weak</span>
              </div>
              <div class="uikit-demo-score-row">
                <strong>Winback</strong>
                <span>Buyers from 6+ months ago never hear from you again.</span>
                <span class="uikit-sem-badge is-critical">Critical</span>
              </div>
              <div class="uikit-demo-score-row">
                <strong>Mobile &amp; checkout</strong>
                <span>Checkout is clean and fast on mobile.</span>
                <span class="uikit-sem-badge is-solid">Solid</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Banners & Upsells -->
      <section class="uikit-card" data-uikit-section="banners">
        <div class="uikit-card-head">
          <p class="adaptif-eyebrow">07 · BANNERS &amp; UPSELLS</p>
          <h2 class="uikit-card-title">Website Banner Layouts</h2>
        </div>
        <div class="uikit-stack">
          <div class="uikit-subsection" data-uikit-search-item="upsell banner .adaptif-upsell-banner blog academy">
            <div class="uikit-subhead-row">
              <p class="uikit-sublabel">Cross-Sell / Upsell Banner (<code>.adaptif-upsell-banner</code>)</p>
              <button type="button" class="cms-btn" data-copy-snippet='<aside class="adaptif-upsell-banner">...</aside>'>Copy Snippet</button>
            </div>
            <aside class="adaptif-upsell-banner" style="margin: 0;">
              <div style="display:flex; flex-direction:column; gap:6px;">
                <span class="adaptif-tag adaptif-tag--cyan" style="align-self:flex-start;">RECOMMENDED PLAN</span>
                <h3 class="uikit-demo-h3" style="margin-top:4px;">Need your creative team executing this for you?</h3>
                <p class="uikit-body-copy" style="margin:0;">Plug our dedicated designers and AI workflows straight into your Slack.</p>
              </div>
              <button type="button" class="adaptif-btn adaptif-btn--sm">Explore Plans →</button>
            </aside>
          </div>

