<script>
  (() => {
    const searchEl = document.getElementById("uikit-search") as HTMLInputElement | null;
    const catBtns = document.querySelectorAll<HTMLButtonElement>("[data-uikit-cat]");
    const sections = document.querySelectorAll<HTMLElement>("[data-uikit-section]");
    const emptyEl = document.getElementById("uikit-empty");
    let activeCat = "all";

    function applyFilter() {
      const q = (searchEl?.value || "").trim().toLowerCase();
      let visibleSections = 0;

      sections.forEach((sec) => {
        const cat = sec.dataset.uikitSection || "";
        const catMatch = q ? true : activeCat === "all" || activeCat === cat;
        if (!catMatch) {
          sec.hidden = true;
          return;
        }

        if (!q) {
          sec.hidden = false;
          sec.querySelectorAll<HTMLElement>("[data-uikit-search-item]").forEach((el) => {
            el.hidden = false;
          });
          visibleSections++;
          return;
        }

        const sectionText = (sec.textContent || "").toLowerCase();
        const items = sec.querySelectorAll<HTMLElement>("[data-uikit-search-item]");
        let anyItemMatch = false;
        items.forEach((el) => {
          const copyVals = Array.from(el.querySelectorAll<HTMLElement>("[data-copy-value]"))
            .map((c) => c.dataset.copyValue || "")
            .join(" ");
          const haystack = `${el.dataset.uikitSearchItem || ""} ${copyVals} ${el.textContent || ""}`.toLowerCase();
          const match = haystack.includes(q);
          el.hidden = !match;
          if (match) anyItemMatch = true;
        });

        const show = anyItemMatch || sectionText.includes(q);
        sec.hidden = !show;
        if (show) visibleSections++;
      });

      if (emptyEl) emptyEl.hidden = visibleSections > 0;
    }

    catBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCat = btn.dataset.uikitCat || "all";
        catBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
        applyFilter();
      });
    });

    searchEl?.addEventListener("input", applyFilter);

    const copySvg = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
    const checkSvg = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

    const copyText = async (value: string) => {
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = value;
        ta.style.position = "fixed";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
    };

    document.querySelectorAll<HTMLElement>(".uikit-card code").forEach((codeEl) => {
      if (codeEl.closest(".uikit-sublabel") || codeEl.closest(".uikit-copy-pill")) return;
      const value = (codeEl.textContent || "").trim();
      if (!value) return;

      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "uikit-copy-pill";
      btn.dataset.copyValue = value;
      btn.title = `Copy: ${value}`;
      btn.setAttribute("aria-label", `Copy ${value}`);

      const textSpan = document.createElement("span");
      textSpan.className = "uikit-copy-pill__code";
      textSpan.textContent = value;

      const iconSpan = document.createElement("span");
      iconSpan.className = "uikit-copy-pill__icon";
      iconSpan.innerHTML = copySvg;

      btn.appendChild(textSpan);
      btn.appendChild(iconSpan);

      btn.addEventListener("click", async () => {
        await copyText(value);
        btn.classList.add("is-copied");
        iconSpan.innerHTML = checkSvg;
        (window as any).__SHOW_STUDIO_TOAST__?.(`Copied: ${value}`);
        setTimeout(() => {
          btn.classList.remove("is-copied");
          iconSpan.innerHTML = copySvg;
        }, 1400);
      });

      codeEl.replaceWith(btn);
    });

    document.querySelectorAll<HTMLButtonElement>("[data-copy-snippet]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const snippet = btn.dataset.copySnippet || "";
        if (!snippet) return;
        await copyText(snippet);
        const prev = btn.textContent;
        btn.textContent = "Copied!";
        btn.classList.add("cms-btn--save");
        (window as any).__SHOW_STUDIO_TOAST__?.("HTML snippet copied to clipboard");
        setTimeout(() => {
          btn.textContent = prev || "Copy Snippet";
          btn.classList.remove("cms-btn--save");
        }, 1400);
      });
    });
  })();
</script>

