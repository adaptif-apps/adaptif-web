---
import type { ResolvedUpsellBanner } from "../lib/upsell";

interface Props {
  banner: ResolvedUpsellBanner;
  compact?: boolean;
  cmsPrefix?: string;
}

const { banner, compact = false, cmsPrefix } = Astro.props;
---

{banner.visible && (
  <aside
    class:list={[
      "glass-panel",
      "adaptif-upsell-banner",
      { "adaptif-upsell-banner--compact": compact }
    ]}
    aria-label="Recommended next step"
  >
    <div class="adaptif-upsell-inner">
      <div class="adaptif-upsell-copy">
        <div class="adaptif-upsell-eyebrow-row">
          <span
            class="adaptif-eyebrow"
            data-cms-key={cmsPrefix ? `${cmsPrefix}.eyebrow` : undefined}
          >
            {banner.eyebrow}
          </span>
          {banner.badge && (
            <span class="adaptif-tag adaptif-tag--cyan">{banner.badge}</span>
          )}
        </div>
        <h2
          class="adaptif-upsell-title"
          data-cms-key={cmsPrefix ? `${cmsPrefix}.title` : undefined}
        >
          {banner.title}
        </h2>
        <p
          class="adaptif-upsell-desc"
          data-cms-key={cmsPrefix ? `${cmsPrefix}.description` : undefined}
        >
          {banner.description}
        </p>
      </div>
      <div class="adaptif-upsell-actions">
        <a
          href={banner.ctaHref}
          class:list={["adaptif-btn", { "adaptif-btn--sm": compact }]}
          data-cms-key={cmsPrefix ? `${cmsPrefix}.cta` : undefined}
        >
          <span>{banner.ctaLabel}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </aside>
)}
