---
// WebDesignOfferAndEcosystem.astro - "What we offer" (6-card mosaic) + "Digital ecosystems" (light 4-col grid)

const ecosystems = [
  {
    id: "cms",
    title: "Web and CMS design",
    desc: "Purposeful website and CMS design that backs growth, performance, and effortless content management.",
    icon: "cms",
  },
  {
    id: "campaigns",
    title: "Campaign landing pages",
    desc: "Bespoke or modular LPs for demand gen, product launches, ABM, and beyond.",
    icon: "rocket",
  },
  {
    id: "education",
    title: "Product education and resources",
    desc: "Content-dense hubs, solution pages, and resource libraries.",
    icon: "book",
  },
  {
    id: "brand",
    title: "Brand & culture pages",
    desc: "Recruiting, history, ESG, DEI, and culture storytelling delivered with clarity and force.",
    icon: "users",
  },
];
---

<!-- 1. What we offer -->
<section class="wd-offer" id="web-offer" aria-labelledby="wd-offer-title">
  <div class="container">
    <header class="wd-offer__header" data-wd-reveal>
      <p class="adaptif-eyebrow" data-cms-key="webdesign.offer.eyebrow">
        What we offer
      </p>
      <h2 id="wd-offer-title" class="wd-offer__title" data-cms-key="webdesign.offer.title">
        Creative web design, set up <span class="title-highlight">to grow and convert</span>
      </h2>
      <p class="wd-offer__subtitle" data-cms-key="webdesign.offer.subtitle">
        Refining a site you already have or starting from a blank canvas, we hand you everything needed to move ahead with confidence and hit real business numbers.
      </p>
    </header>

    <div class="wd-offer__mosaic">
      <!-- 1. Website design -->
      <article class="wd-offer-card wd-offer--website" data-wd-reveal>
        <img
          src="/images/web-design/offer-website.jpg"
          alt="Responsive website design displayed on laptop"
          class="wd-offer-card__img"
          loading="lazy"
          decoding="async"
          data-cms-key="webdesign.offer.website.image"
        />
        <div class="wd-offer-card__scrim wd-offer-card__scrim--bottom" aria-hidden="true"></div>
        <div class="wd-offer-card__content wd-offer-card__content--bottom">
          <h3 class="wd-offer-card__title" data-cms-key="webdesign.offer.website.title">Website design</h3>
          <p class="wd-offer-card__desc" data-cms-key="webdesign.offer.website.desc">
            Web UX research, wireframes, adaptive layouts, and polished UI, shaped around your goals.
          </p>
        </div>
      </article>

      <!-- 2. Conversion optimization -->
      <article class="wd-offer-card wd-offer--cro" data-wd-reveal style="--wd-delay: 50ms">
        <img
          src="/images/web-design/offer-cro.jpg"
          alt="Conversion rate optimization before and after comparison"
          class="wd-offer-card__img"
          loading="lazy"
          decoding="async"
          data-cms-key="webdesign.offer.cro.image"
        />
        <div class="wd-offer-card__scrim wd-offer-card__scrim--top" aria-hidden="true"></div>
        <div class="wd-offer-card__content">
          <h3 class="wd-offer-card__title" data-cms-key="webdesign.offer.cro.title">Conversion optimization</h3>
          <p class="wd-offer-card__desc" data-cms-key="webdesign.offer.cro.desc">
            User journey analysis plus conversion-led recommendations built to raise performance on the pages that matter.
          </p>
        </div>
      </article>

      <!-- 3. Landing pages -->
      <article class="wd-offer-card wd-offer--landing" data-wd-reveal style="--wd-delay: 100ms">
        <img
          src="/images/web-design/offer-landing.jpg"
          alt="Mobile-first landing page design"
          class="wd-offer-card__img"
          loading="lazy"
          decoding="async"
          data-cms-key="webdesign.offer.landing.image"
        />
        <div class="wd-offer-card__scrim wd-offer-card__scrim--top" aria-hidden="true"></div>
        <div class="wd-offer-card__content">
          <h3 class="wd-offer-card__title" data-cms-key="webdesign.offer.landing.title">Landing pages</h3>
          <p class="wd-offer-card__desc" data-cms-key="webdesign.offer.landing.desc">
            Funnel-stage pages that load fast, fully tuned, mobile first, and on brand. Perfect for product launches, paid media, lifecycle marketing, and SEO.
          </p>
        </div>
      </article>

      <!-- 4. Design systems and UI kits -->
      <article class="wd-offer-card wd-offer--systems" data-wd-reveal style="--wd-delay: 140ms">
        <img
          src="/images/web-design/offer-design-systems.jpg"
          alt="Modular design system and UI component kit"
          class="wd-offer-card__img"
          loading="lazy"
          decoding="async"
          data-cms-key="webdesign.offer.systems.image"
        />
        <div class="wd-offer-card__scrim wd-offer-card__scrim--top" aria-hidden="true"></div>
        <div class="wd-offer-card__content">
          <h3 class="wd-offer-card__title" data-cms-key="webdesign.offer.systems.title">Design systems and UI kits</h3>
          <p class="wd-offer-card__desc" data-cms-key="webdesign.offer.systems.desc">
            Reusable component libraries built on the Atomic design approach to scale with consistency.
          </p>
        </div>
      </article>

      <!-- 5. UX/UI audits -->
      <article class="wd-offer-card wd-offer--audits" data-wd-reveal style="--wd-delay: 180ms">
        <img
          src="/images/web-design/offer-ux-audit.jpg"
          alt="UX/UI audit and usability evaluation"
          class="wd-offer-card__img"
          loading="lazy"
          decoding="async"
          data-cms-key="webdesign.offer.audits.image"
        />
        <div class="wd-offer-card__scrim wd-offer-card__scrim--top" aria-hidden="true"></div>
        <div class="wd-offer-card__content">
          <h3 class="wd-offer-card__title" data-cms-key="webdesign.offer.audits.title">UX/UI audits</h3>
          <p class="wd-offer-card__desc" data-cms-key="webdesign.offer.audits.desc">
            Thorough investigation of conversion leaks and usability gaps, with expert recommendations to lift performance.
          </p>
        </div>
      </article>

      <!-- 6. Copy & motion support -->
      <article class="wd-offer-card wd-offer--copy" data-wd-reveal style="--wd-delay: 220ms">
        <div class="wd-offer-card__content">
          <h3 class="wd-offer-card__title" data-cms-key="webdesign.offer.copy.title">Copy &amp; motion support</h3>
          <p class="wd-offer-card__desc" data-cms-key="webdesign.offer.copy.desc">
            End-to-end creative spanning headlines, content hierarchy, microcopy, and animation.
          </p>
        </div>

        <div class="wd-copy-preview" aria-hidden="true">
          <span class="wd-copy-preview__eyebrow">Rethinking creative teams</span>
          <strong class="wd-copy-preview__headline">The backup your creative team has been waiting for</strong>
          <span class="wd-copy-preview__pill">Microcopy + Motion</span>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- 2. Digital ecosystems (Light 4-col editorial grid) -->
<section class="wd-eco" id="web-ecosystems" data-theme="light" aria-labelledby="wd-eco-title">
  <div class="container">
    <header class="wd-eco__header" data-wd-reveal>
      <p class="adaptif-eyebrow adaptif-eyebrow--light" data-cms-key="webdesign.eco.eyebrow">
        Adapt to your strategy
      </p>
      <h2 id="wd-eco-title" class="wd-eco__title" data-cms-key="webdesign.eco.title">
        <span class="title-highlight">Digital ecosystems</span> built to grow across markets, campaigns, and segments
      </h2>
    </header>

    <div class="wd-eco__grid">
      {ecosystems.map((item, idx) => (
        <article class="wd-eco-item" data-wd-reveal style={`--wd-delay: ${idx * 65}ms`}>
          <div class="wd-eco-item__icon" aria-hidden="true">
            {item.icon === "cms" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <line x1="8" y1="21" x2="16" y2="21" />
                <line x1="12" y1="17" x2="12" y2="21" />
              </svg>
            )}
            {item.icon === "rocket" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
                <path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
              </svg>
            )}
            {item.icon === "book" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
              </svg>
            )}
            {item.icon === "users" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            )}
          </div>
          <h3 class="wd-eco-item__title" data-cms-key={`webdesign.eco.${item.id}.title`}>
            {item.title}
          </h3>
          <p class="wd-eco-item__desc" data-cms-key={`webdesign.eco.${item.id}.desc`}>
            {item.desc}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .wd-offer {
    padding: clamp(64px, 8vw, 112px) 0;
    background: var(--color-void);
  }

  .wd-offer__header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto clamp(36px, 5vw, 56px);
  }

  .wd-offer__title {
    margin: 14px 0 16px;
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.2vw, 3.45rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .wd-offer__subtitle {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .wd-offer__mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(290px, auto);
    gap: 18px;
  }

  .wd-offer-card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--color-obsidian-950);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s ease;
  }

  .wd-offer-card:hover {
    transform: translateY(-3px);
    border-color: rgba(72, 200, 255, 0.36);
  }

  .wd-offer--website { grid-column: 1 / span 4; min-height: 310px; justify-content: flex-end; }
  .wd-offer--cro { grid-column: 5 / span 4; min-height: 310px; }
  .wd-offer--landing { grid-column: 9 / span 4; min-height: 310px; }
  .wd-offer--systems { grid-column: 1 / span 5; min-height: 310px; }
  .wd-offer--audits { grid-column: 6 / span 4; min-height: 310px; }
  .wd-offer--copy {
    grid-column: 10 / span 3;
    min-height: 310px;
    justify-content: space-between;
    background: radial-gradient(circle at 80% 90%, rgba(72, 200, 255, 0.16) 0%, rgba(10, 18, 34, 0.94) 70%);
  }

  .wd-offer-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wd-offer-card:hover .wd-offer-card__img {
    transform: scale(1.03);
  }

  .wd-offer-card__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .wd-offer-card__scrim--top {
    background: linear-gradient(
      180deg,
      rgba(1, 3, 7, 0.9) 0%,
      rgba(1, 3, 7, 0.5) 48%,
      rgba(1, 3, 7, 0.25) 100%
    );
  }

  .wd-offer-card__scrim--bottom {
    background: linear-gradient(
      180deg,
      rgba(1, 3, 7, 0.12) 0%,
      rgba(1, 3, 7, 0.48) 52%,
      rgba(1, 3, 7, 0.92) 100%
    );
  }

  .wd-offer-card__content {
    position: relative;
    z-index: 2;
    padding: clamp(20px, 2.2vw, 26px);
  }

  .wd-offer-card__title {
    margin: 0 0 8px;
    font-family: var(--font-family-body);
    font-size: clamp(1.1rem, 1.28vw, 1.25rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .wd-offer-card__desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgba(241, 245, 249, 0.84);
  }

  .wd-copy-preview {
    position: relative;
    z-index: 2;
    margin: 0 clamp(20px, 2.2vw, 26px) clamp(20px, 2.2vw, 26px);
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(72, 200, 255, 0.28);
    background: rgba(5, 10, 20, 0.72);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wd-copy-preview__eyebrow {
    font-family: var(--font-family-body);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-cyan);
  }

  .wd-copy-preview__headline {
    font-family: var(--font-family-body);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .wd-copy-preview__pill {
    align-self: flex-start;
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--font-family-body);
    font-size: 0.7rem;
    font-weight: 600;
    color: #e0f7ff;
    background: rgba(72, 200, 255, 0.16);
    border: 1px solid rgba(72, 200, 255, 0.36);
  }

  /* Ecosystems (Light) */
  .wd-eco {
    padding: clamp(68px, 8.5vw, 112px) 0;
    background: #ffffff;
    color: #090d16;
  }

  .wd-eco__header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto clamp(40px, 5vw, 56px);
  }

  .wd-eco__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.2vw, 3.4rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #090d16;
  }

  .wd-eco__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 32px;
  }

  .wd-eco-item {
    padding-top: 24px;
    border-top: 1px solid rgba(15, 23, 42, 0.1);
  }

  .wd-eco-item__icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.22);
    color: #0284c7;
    margin-bottom: 14px;
  }

  .wd-eco-item__title {
    margin: 0 0 8px;
    font-family: var(--font-family-body);
    font-size: 1.06rem;
    font-weight: 600;
    line-height: 1.3;
    color: #090d16;
  }

  .wd-eco-item__desc {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.88rem;
    line-height: 1.56;
    color: #475569;
  }

  @media (max-width: 1024px) {
    .wd-offer__mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: auto;
    }

    .wd-offer--website,
    .wd-offer--cro,
    .wd-offer--landing,
    .wd-offer--systems,
    .wd-offer--audits,
    .wd-offer--copy {
      grid-column: auto;
      min-height: 290px;
    }

    .wd-eco__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .wd-offer__mosaic,
    .wd-eco__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
