---
// WebDesignOverviewAndStats.astro - "Why web?" + "Metrics that matter" + "Build quicker, grow sharper"

const stats = [
  {
    id: "conversion",
    count: 30,
    suffix: "%+",
    desc: "lift in conversion once UX is audited & tuned.",
  },
  {
    id: "savings",
    count: 50,
    suffix: "%",
    desc: "possible cost savings through a modular design system.",
  },
  {
    id: "schedule",
    count: 98,
    suffix: "%",
    desc: "of web builds land on schedule or ahead of it.",
  },
];
---

<!-- 1. Why web? -->
<section class="wd-split" id="web-why" aria-labelledby="wd-why-title">
  <div class="wd-split__glow" aria-hidden="true"></div>

  <div class="container wd-split__grid">
    <div class="wd-split__copy" data-wd-reveal>
      <p class="adaptif-eyebrow" data-cms-key="webdesign.why.eyebrow">
        Why web?
      </p>

      <h2 id="wd-why-title" class="wd-split__title" data-cms-key="webdesign.why.title">
        Your site isn’t a poster, <span class="title-highlight">it’s a growth engine</span>
      </h2>

      <p class="wd-split__lead" data-cms-key="webdesign.why.lead">
        For most audiences, your digital presence is the very first encounter with your brand. Yet plenty of teams sit on dated, rigid websites and no clear path to fix them.
      </p>

      <p class="wd-split__body" data-cms-key="webdesign.why.body">
        Building digital experiences that genuinely convert takes more than good-looking screens. It calls for UX thinking, brand cohesion, messaging aimed at conversion, and a design system that scales with you. Adaptif pulls all of it together as one adaptable, expert partner.
      </p>
    </div>

    <div class="wd-split__visual" data-wd-reveal="scale" style="--wd-delay: 120ms">
      <div class="wd-split__frame">
        <img
          src="/images/web-design/why-web.jpg"
          alt="Strategist reviewing digital website architecture on laptop"
          class="wd-split__img"
          loading="lazy"
          decoding="async"
          data-cms-key="webdesign.why.image"
        />
      </div>
    </div>
  </div>
</section>

<!-- 2. Metrics that matter -->
<section class="wd-stats" id="web-metrics" aria-labelledby="wd-stats-title">
  <div class="container">
    <header class="wd-stats__header" data-wd-reveal>
      <p class="adaptif-eyebrow" data-cms-key="webdesign.stats.eyebrow">
        Metrics that matter
      </p>
      <h2 id="wd-stats-title" class="wd-stats__title" data-cms-key="webdesign.stats.title">
        A <span class="title-highlight">creative web design partner</span> worth betting on
      </h2>
    </header>

    <dl class="wd-stats__grid">
      {stats.map((s, idx) => (
        <div class="wd-stats__item" data-wd-reveal style={`--wd-delay: ${idx * 70}ms`}>
          <dt class="wd-stats__desc" data-cms-key={`webdesign.stats.${s.id}.label`}>
            {s.desc}
          </dt>
          <dd
            class="wd-stats__value"
            data-wd-count={s.count}
            data-wd-suffix={s.suffix}
            data-cms-key={`webdesign.stats.${s.id}.value`}
          >
            {`${s.count}${s.suffix}`}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- 3. Adaptif web design (Image left, copy right) -->
<section class="wd-split wd-split--bordered" id="web-connected" aria-labelledby="wd-connected-title">
  <div class="container wd-split__grid">
    <div class="wd-split__visual" data-wd-reveal="scale">
      <div class="wd-split__frame">
        <img
          src="/images/web-design/build-quicker.jpg"
          alt="Designer working on modular web experiences"
          class="wd-split__img"
          loading="lazy"
          decoding="async"
          data-cms-key="webdesign.connected.image"
        />
      </div>
    </div>

    <div class="wd-split__copy" data-wd-reveal style="--wd-delay: 100ms">
      <p class="adaptif-eyebrow" data-cms-key="webdesign.connected.eyebrow">
        Adaptif web design
      </p>

      <h2 id="wd-connected-title" class="wd-split__title" data-cms-key="webdesign.connected.title">
        Build quicker, grow sharper, <span class="title-highlight">convert better</span>
      </h2>

      <p class="wd-split__lead" data-cms-key="webdesign.connected.lead">
        Adaptif’s connected creative services unite strategy, UX, design, and content to shape web experiences engineered for growth.
      </p>

      <p class="wd-split__body" data-cms-key="webdesign.connected.body">
        Our cross-disciplinary teams cover strategy, UX, design, copy, motion, illustration, photography, and video for web, all in one place. Keep creative aligned without babysitting it, reach market sooner, and see stronger results at every stage of the funnel.
      </p>

      <div class="wd-split__actions">
        <a
          href="#book-a-call"
          class="adaptif-btn"
          data-open-book-call
          data-cms-key="webdesign.connected.cta"
        >
          <span>Book a Call</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .wd-split {
    position: relative;
    padding: clamp(64px, 8vw, 112px) 0;
    background: var(--color-void);
    overflow: hidden;
  }

  .wd-split--bordered {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .wd-split__glow {
    position: absolute;
    top: 16%;
    right: 8%;
    width: 480px;
    height: 420px;
    background: radial-gradient(circle, rgba(72, 200, 255, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .wd-split__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 68px);
    align-items: center;
  }

  .wd-split__title {
    margin: 14px 0 20px;
    font-family: var(--font-family-display);
    font-size: clamp(2.3rem, 4vw, 3.35rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .wd-split__lead {
    margin: 0 0 16px;
    font-family: var(--font-family-body);
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    font-weight: 500;
    line-height: 1.55;
    color: var(--color-text-primary);
  }

  .wd-split__body {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: 0.96rem;
    line-height: 1.66;
    color: var(--color-text-secondary);
  }

  .wd-split__actions {
    margin-top: 28px;
  }

  .wd-split__frame {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 26px 60px -20px rgba(0, 0, 0, 0.8),
      0 0 38px -14px rgba(72, 200, 255, 0.16);
    aspect-ratio: 1 / 1;
  }

  .wd-split__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Stats */
  .wd-stats {
    padding: clamp(56px, 7vw, 96px) 0;
    background: var(--color-void);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .wd-stats__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(40px, 5vw, 56px);
  }

  .wd-stats__title {
    margin: 14px 0 0;
    font-family: var(--font-family-display);
    font-size: clamp(2.35rem, 4.2vw, 3.45rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .wd-stats__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px 40px;
    margin: 0;
  }

  .wd-stats__item {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    text-align: center;
    gap: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 28px 16px 12px;
  }

  .wd-stats__desc {
    margin: 0;
    max-width: 260px;
    font-family: var(--font-family-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .wd-stats__value {
    margin: 0;
    font-family: var(--font-family-display);
    font-size: clamp(3.1rem, 5vw, 4.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-brand-cyan);
  }

  @media (max-width: 960px) {
    .wd-split__grid {
      grid-template-columns: 1fr;
    }

    .wd-split__frame {
      max-width: 520px;
      margin: 0 auto;
    }

    .wd-stats__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
