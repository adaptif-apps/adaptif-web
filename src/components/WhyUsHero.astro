---
// WhyUsHero.astro - Hero ("About Adaptif") + Statement Band
---

<section class="wu-hero" id="why-us-hero" aria-labelledby="wu-hero-title">
  <div class="wu-hero__media" aria-hidden="true">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/why-us/hero-mobile.jpg" />
      <img
        src="/images/why-us/hero-desktop.jpg"
        alt=""
        class="wu-hero__bg"
        loading="eager"
        decoding="async"
      />
    </picture>
    <div class="wu-hero__scrim"></div>
    <div class="wu-hero__bottom-fade"></div>
  </div>

  <div class="container wu-hero__container">
    <div class="wu-hero__content">
      <p class="adaptif-eyebrow" data-why-reveal style="--why-delay: 40ms">About Adaptif</p>

      <h1 id="wu-hero-title" class="wu-hero__title" data-why-reveal style="--why-delay: 120ms">
        The creative force <span class="title-highlight">behind world-leading brands</span>
      </h1>

      <p class="wu-hero__description" data-why-reveal style="--why-delay: 200ms">
        The only creative service where enterprise teams get the top 1% of global talent, powered by AI, plugged directly into their workflows.
      </p>

      <div class="wu-hero__actions" data-why-reveal style="--why-delay: 280ms">
        <a href="#book-a-call" class="adaptif-btn" data-open-book-call>
          <span>Book a Call</span>
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              d="M4.16666 10H15.8333M15.8333 10L10 4.16666M15.8333 10L10 15.8333"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="wu-statement" aria-label="Adaptif positioning">
  <div class="container">
    <p class="wu-statement__text" data-why-reveal>
      Not an agency, not a bunch of freelancers, a world-class creative team ready to support you whenever, and however, you need.
    </p>
  </div>
</section>

<style>
  .wu-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding: clamp(110px, 14vh, 160px) 0 clamp(72px, 10vh, 110px);
    overflow: hidden;
    background-color: var(--color-void);
  }

  .wu-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .wu-hero__media picture {
    display: contents;
  }

  .wu-hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    opacity: 0.92;
  }

  .wu-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(1, 3, 7, 0.84) 0%, rgba(1, 3, 7, 0.45) 48%, rgba(1, 3, 7, 0.08) 100%),
      radial-gradient(ellipse 60% 55% at 22% 45%, rgba(72, 200, 255, 0.1) 0%, transparent 70%);
  }

  .wu-hero__bottom-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 160px;
    background: linear-gradient(180deg, transparent 0%, var(--color-void) 100%);
  }

  .wu-hero__container {
    position: relative;
    z-index: 2;
  }

  .wu-hero__content {
    max-width: 620px;
  }

  .wu-hero__title {
    margin: 18px 0 22px;
    font-family: var(--font-family-display);
    font-size: clamp(2.85rem, 5.4vw, 4.5rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .wu-hero__description {
    max-width: 520px;
    margin: 0 0 34px;
    font-family: var(--font-family-body);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .wu-hero__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .wu-statement {
    padding: clamp(48px, 6vw, 76px) 0 clamp(24px, 3vw, 36px);
    background-color: var(--color-void);
    text-align: center;
  }

  .wu-statement__text {
    margin: 0 auto;
    max-width: 780px;
    font-family: var(--font-family-display);
    font-size: clamp(1.75rem, 3.2vw, 2.55rem);
    font-weight: 400;
    line-height: 1.22;
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .wu-hero__scrim {
      background: linear-gradient(180deg, rgba(1, 3, 7, 0.62) 0%, rgba(1, 3, 7, 0.88) 58%, var(--color-void) 100%);
    }
  }
</style>
