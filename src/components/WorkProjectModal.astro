---
import type { PortfolioProject } from "../data/portfolioSeed";

interface Props {
  projects: PortfolioProject[];
  syncUrl?: boolean;
}

const { projects, syncUrl = false } = Astro.props;
---

<!-- Shareable Project Gallery Overlay -->
<div
  class="work-modal"
  id="work-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="work-modal-title"
  data-sync-url={syncUrl ? "true" : "false"}
  hidden
>
  <div class="work-modal-backdrop" data-close-modal></div>

  <div class="work-modal-shell">
    <div class="work-modal-topbar">
      <div class="work-modal-actions">
        <button type="button" class="modal-close-btn" id="work-modal-close" aria-label="Close gallery" data-close-modal>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
    </div>

    <div class="work-modal-body">
      <!-- Horizontal Bento Gallery Strip (Desktop) / Stacked Bento (Mobile) -->
      <div class="modal-gallery-viewport" id="modal-gallery-viewport" tabindex="0" aria-label="Project image gallery">
        <div class="modal-gallery-track" id="modal-gallery-track"></div>
      </div>

      <!-- Bottom Info Bar (Desktop) / Top Info Header (Mobile) -->
      <div class="modal-info-row">
        <div class="modal-info-title-col">
          <h2 class="modal-title" id="work-modal-title"></h2>
        </div>
        <div class="modal-info-desc-col">
          <p class="modal-desc" id="work-modal-desc"></p>
        </div>
        <div class="modal-info-tags-col">
          <ul class="modal-tags" id="work-modal-tags"></ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Fullscreen Image Lightbox -->
<div
  class="work-lightbox"
  id="work-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Fullscreen image preview"
  hidden
>
  <div class="work-lightbox-backdrop" data-close-lightbox></div>
  <button type="button" class="lightbox-close-btn" id="lightbox-close" aria-label="Close fullscreen image" data-close-lightbox>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </button>
  <button type="button" class="lightbox-nav-btn lightbox-prev" id="lightbox-prev" aria-label="Previous image">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6" />
    </svg>
  </button>
  <div class="work-lightbox-stage" id="work-lightbox-stage">
    <img class="work-lightbox-img" id="work-lightbox-img" alt="" />
  </div>
  <button type="button" class="lightbox-nav-btn lightbox-next" id="lightbox-next" aria-label="Next image">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 18 6-6-6-6" />
    </svg>
  </button>
</div>

<script define:vars={{ projects }}>
  window.__ADAPTIF_PROJECTS__ = projects;
</script>

<script>
  interface ProjectItem {
    id: string;
    title: string;
    description: string;
    tags: string[];
    image: string;
    gallery: string[];
  }

  function initWorkProjectModal() {
    const modal = document.getElementById("work-modal");
    if (!modal || modal.dataset.bound === "true") return;
    modal.dataset.bound = "true";

    const lightbox = document.getElementById("work-lightbox");
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }
    if (lightbox && lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    const syncUrl = modal.dataset.syncUrl === "true";
    const modalTitle = document.getElementById("work-modal-title");
    const modalDesc = document.getElementById("work-modal-desc");
    const modalTags = document.getElementById("work-modal-tags");
    const galleryViewport = document.getElementById("modal-gallery-viewport");
    const galleryTrack = document.getElementById("modal-gallery-track");
    const closeBtn = document.getElementById("work-modal-close");

    const lightboxImg = document.getElementById("work-lightbox-img") as HTMLImageElement | null;
    const lightboxStage = document.getElementById("work-lightbox-stage");
    const lightboxCloseBtn = document.getElementById("lightbox-close");
    const lightboxPrevBtn = document.getElementById("lightbox-prev");
    const lightboxNextBtn = document.getElementById("lightbox-next");

    const projectList: ProjectItem[] = (window as any).__ADAPTIF_PROJECTS__ || [];
    const projectMap = new Map(projectList.map((p) => [p.id, p]));

    let lastFocusedTrigger: HTMLElement | null = null;
    let lastLightboxTrigger: HTMLElement | null = null;
    let currentGalleryItems: { src: string; alt: string }[] = [];
    let currentLightboxIndex = 0;

    function openLightbox(index: number) {
      if (!lightbox || !lightboxImg || currentGalleryItems.length === 0) return;
      lastLightboxTrigger = document.activeElement as HTMLElement | null;
      const total = currentGalleryItems.length;
      currentLightboxIndex = ((index % total) + total) % total;
      const item = currentGalleryItems[currentLightboxIndex];
      lightboxImg.src = item.src;
      lightboxImg.alt = item.alt;

      lightbox.hidden = false;
      requestAnimationFrame(() => {
        lightbox.classList.add("is-open");
        lightboxCloseBtn?.focus({ preventScroll: true });
      });
    }

    function stepLightbox(delta: number) {
      if (!lightbox || lightbox.hidden || currentGalleryItems.length === 0) return;
      const total = currentGalleryItems.length;
      currentLightboxIndex = (currentLightboxIndex + delta + total) % total;
      const item = currentGalleryItems[currentLightboxIndex];
      if (lightboxImg) {
        lightboxImg.src = item.src;
        lightboxImg.alt = item.alt;
      }
    }

    function closeLightbox(restoreFocus = true) {
      if (!lightbox || lightbox.hidden) return;
      lightbox.classList.remove("is-open");
      window.setTimeout(() => {
        if (!lightbox.classList.contains("is-open")) {
          lightbox.hidden = true;
          if (restoreFocus) {
            lastLightboxTrigger?.focus({ preventScroll: true });
          }
        }
      }, 180);
    }

    function createTile(src: string, alt: string, extraClass = "", index = 0) {
      const div = document.createElement("div");
      div.className = `bento-tile ${extraClass}`.trim();
      div.style.setProperty("--tile-delay", `${index * 65}ms`);
      div.setAttribute("role", "button");
      div.tabIndex = 0;
      div.setAttribute("aria-label", `View ${alt} in fullscreen`);
      const img = document.createElement("img");
      img.src = src;
      img.alt = alt;
      img.loading = "eager";
      img.decoding = "async";
      div.appendChild(img);

      div.addEventListener("click", (e) => {
        e.stopPropagation();
        openLightbox(index);
      });
      div.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openLightbox(index);
        }
      });
      return div;
    }

    function renderGalleryBento(project: ProjectItem) {
      if (!galleryTrack) return;
      galleryTrack.innerHTML = "";
      const source = project.gallery && project.gallery.length > 0 ? project.gallery : [project.image];
      const imgs = Array.from({ length: 12 }, (_, idx) => source[idx % source.length]);
      const alts = [
        `${project.title} — featured visual`,
        `${project.title} — campaign view`,
        `${project.title} — detail 1`,
        `${project.title} — detail 2`,
        `${project.title} — vertical asset`,
        `${project.title} — detail 3`,
        `${project.title} — detail 4`,
        `${project.title} — wide showcase`,
        `${project.title} — vertical highlight`,
        `${project.title} — wide layout`,
        `${project.title} — detail 5`,
        `${project.title} — detail 6`,
      ];
      currentGalleryItems = imgs.map((src, i) => ({ src, alt: alts[i] }));

      // Block 1: Large 2x2 square (0)
      const b1 = document.createElement("div");
      b1.className = "bento-block bento-block-square";
      b1.appendChild(createTile(imgs[0], alts[0], "", 0));
      galleryTrack.appendChild(b1);

      // Block 2: Top wide (1) + Bottom 2 squares (2, 3)
      const b2 = document.createElement("div");
      b2.className = "bento-block bento-block-top-wide";
      b2.appendChild(createTile(imgs[1], alts[1], "tile-wide", 1));
      b2.appendChild(createTile(imgs[2], alts[2], "", 2));
      b2.appendChild(createTile(imgs[3], alts[3], "", 3));
      galleryTrack.appendChild(b2);

      // Block 3: Tall portrait (4)
      const b3 = document.createElement("div");
      b3.className = "bento-block bento-block-tall";
      b3.appendChild(createTile(imgs[4], alts[4], "", 4));
      galleryTrack.appendChild(b3);

      // Block 4: Top 2 squares (5, 6) + Bottom wide (7)
      const b4 = document.createElement("div");
      b4.className = "bento-block bento-block-bottom-wide";
      b4.appendChild(createTile(imgs[5], alts[5], "", 5));
      b4.appendChild(createTile(imgs[6], alts[6], "", 6));
      b4.appendChild(createTile(imgs[7], alts[7], "tile-wide-bottom", 7));
      galleryTrack.appendChild(b4);

      // Block 5: Tall portrait (8)
      const b5 = document.createElement("div");
      b5.className = "bento-block bento-block-tall";
      b5.appendChild(createTile(imgs[8], alts[8], "", 8));
      galleryTrack.appendChild(b5);

      // Block 6: Top wide (9) + Bottom 2 squares (10, 11)
      const b6 = document.createElement("div");
      b6.className = "bento-block bento-block-top-wide";
      b6.appendChild(createTile(imgs[9], alts[9], "tile-wide", 9));
      b6.appendChild(createTile(imgs[10], alts[10], "", 10));
      b6.appendChild(createTile(imgs[11], alts[11], "", 11));
      galleryTrack.appendChild(b6);
    }

    function openProjectModal(projectId: string, updateUrl = true) {
      const project = projectMap.get(projectId);
      if (!project || !modal || !modalTitle || !modalDesc || !modalTags) return;

      lastFocusedTrigger = document.activeElement as HTMLElement | null;

      modalTitle.textContent = project.title;
      modalDesc.textContent = project.description;
      modalTags.innerHTML = "";
      project.tags.forEach((tag) => {
        const li = document.createElement("li");
        li.className = "modal-tag";
        li.textContent = tag;
        modalTags.appendChild(li);
      });

      renderGalleryBento(project);

      modal.hidden = false;
      requestAnimationFrame(() => {
        modal.classList.add("is-open");
        if (galleryViewport) galleryViewport.scrollLeft = 0;
        closeBtn?.focus({ preventScroll: true });
      });

      document.documentElement.style.overflow = "hidden";

      if (syncUrl && updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set("project", project.id);
        window.history.pushState({ project: project.id }, "", url.toString());
      }
    }

    function closeProjectModal(updateUrl = true) {
      if (!modal || modal.hidden) return;
      closeLightbox(false);
      modal.classList.remove("is-open");
      document.documentElement.style.overflow = "";

      if (syncUrl && updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.delete("project");
        window.history.pushState({}, "", url.pathname + url.search);
      }

      setTimeout(() => {
        if (!modal.classList.contains("is-open")) {
          modal.hidden = true;
          lastFocusedTrigger?.focus({ preventScroll: true });
        }
      }, 220);
    }

    document.addEventListener("click", (e) => {
      const trigger = (e.target as HTMLElement | null)?.closest<HTMLElement>("[data-open-project]");
      if (!trigger) return;
      const id = trigger.dataset.openProject;
      if (id && projectMap.has(id)) {
        openProjectModal(id, true);
      }
    });

    document.addEventListener("keydown", (e) => {
      if ((e.key === "Enter" || e.key === " ") && document.activeElement instanceof HTMLElement) {
        const trigger = document.activeElement.closest<HTMLElement>("[data-open-project]");
        if (trigger && trigger.tagName !== "BUTTON" && trigger.tagName !== "A") {
          const id = trigger.dataset.openProject;
          if (id && projectMap.has(id)) {
            e.preventDefault();
            openProjectModal(id, true);
            return;
          }
        }
      }

      if (lightbox && !lightbox.hidden) {
        if (e.key === "Escape") {
          e.preventDefault();
          closeLightbox(true);
          return;
        }
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          stepLightbox(-1);
          return;
        }
        if (e.key === "ArrowRight") {
          e.preventDefault();
          stepLightbox(1);
          return;
        }
      }

      if (e.key === "Escape" && modal && !modal.hidden) {
        closeProjectModal(true);
      }
    });

    modal.querySelectorAll("[data-close-modal]").forEach((el) => {
      el.addEventListener("click", () => closeProjectModal(true));
    });

    const modalShell = modal.querySelector<HTMLElement>(".work-modal-shell");
    modalShell?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (
        target.classList.contains("work-modal-shell") ||
        target.classList.contains("work-modal-topbar") ||
        target.classList.contains("work-modal-body")
      ) {
        closeProjectModal(true);
      }
    });

    lightbox?.querySelectorAll("[data-close-lightbox]").forEach((el) => {
      el.addEventListener("click", () => closeLightbox(true));
    });

    lightboxStage?.addEventListener("click", (e) => {
      if (e.target === lightboxStage) {
        closeLightbox(true);
      }
    });

    lightboxPrevBtn?.addEventListener("click", () => stepLightbox(-1));
    lightboxNextBtn?.addEventListener("click", () => stepLightbox(1));

    // Convert vertical wheel into horizontal scroll inside the desktop gallery strip
    galleryViewport?.addEventListener(
      "wheel",
      (e) => {
        if (window.innerWidth <= 768) return;
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          e.preventDefault();
          galleryViewport.scrollLeft += e.deltaY;
        }
      },
      { passive: false }
    );

    if (syncUrl) {
      window.addEventListener("popstate", () => {
        const id = new URLSearchParams(window.location.search).get("project");
        if (id && projectMap.has(id)) {
          openProjectModal(id, false);
        } else {
          closeProjectModal(false);
        }
      });

      const initialProjectId = new URLSearchParams(window.location.search).get("project");
      if (initialProjectId && projectMap.has(initialProjectId)) {
        openProjectModal(initialProjectId, false);
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWorkProjectModal);
  } else {
    initWorkProjectModal();
  }

  document.addEventListener("astro:page-load", initWorkProjectModal);
</script>

<style>
  /* --- Shareable Project Gallery Overlay --- */
  .work-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  .work-modal[hidden] {
    display: none;
  }

  .work-modal.is-open {
    opacity: 1;
  }

  .work-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(2, 5, 11, 0.94);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .work-modal-shell {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(18px, 3vh, 32px) 0;
    gap: clamp(16px, 2.5vh, 26px);
    overflow-y: auto;
  }

  .work-modal-topbar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    padding-inline: clamp(16px, 3.5vw, 44px);
  }

  .work-modal-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .modal-close-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: #e2e8f0;
    font-family: var(--font-sans, "Plus Jakarta Sans", sans-serif);
    font-size: 0.82rem;
    font-weight: 500;
    width: 38px;
    height: 38px;
    padding: 0;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .modal-close-btn:hover {
    background: rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.45);
    color: #ffffff;
  }

  .modal-close-btn:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }

  .work-modal-body {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vh, 32px);
    width: 100%;
  }

  .modal-gallery-viewport {
    --cell: clamp(175px, 24.5vh, 250px);
    --gap: 14px;
    order: 1;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(56, 189, 248, 0.45) rgba(255, 255, 255, 0.06);
  }

  .modal-gallery-viewport:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: 4px;
    border-radius: 12px;
  }

  .modal-gallery-viewport::-webkit-scrollbar {
    height: 6px;
  }

  .modal-gallery-viewport::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 999px;
  }

  .modal-gallery-viewport::-webkit-scrollbar-thumb {
    background: rgba(56, 189, 248, 0.45);
    border-radius: 999px;
  }

  .modal-gallery-track {
    display: flex;
    flex-direction: row;
    gap: var(--gap);
    height: calc(var(--cell) * 2 + var(--gap));
    width: max-content;
  }

  :global(.bento-block) {
    flex-shrink: 0;
  }

  :global(.bento-block-square) {
    width: calc(var(--cell) * 2 + var(--gap));
    height: 100%;
  }

  :global(.bento-block-tall) {
    width: var(--cell);
    height: 100%;
  }

  :global(.bento-block-top-wide),
  :global(.bento-block-bottom-wide) {
    display: grid;
    grid-template-columns: repeat(2, var(--cell));
    grid-template-rows: repeat(2, var(--cell));
    gap: var(--gap);
  }

  :global(.bento-tile) {
    width: 100%;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: #0b111e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: zoom-in;
    animation: bentoTileReveal 0.55s cubic-bezier(0.16, 1, 0.3, 1) var(--tile-delay, 0ms) both;
    transition: border-color 0.25s ease;
  }

  :global(.bento-tile:hover) {
    border-color: rgba(56, 189, 248, 0.38);
  }

  :global(.bento-tile:focus-visible) {
    outline: 2px solid #38bdf8;
    outline-offset: 2px;
  }

  @keyframes bentoTileReveal {
    from {
      opacity: 0;
      transform: translateX(18px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  :global(.bento-tile.tile-wide) {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  :global(.bento-tile.tile-wide-bottom) {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  :global(.bento-tile img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.bento-tile:hover img) {
    transform: scale(1.025);
  }

  .modal-info-row {
    order: 2;
    display: grid;
    grid-template-columns: minmax(220px, 0.9fr) minmax(280px, 1.3fr) minmax(240px, 1.1fr);
    align-items: start;
    gap: clamp(18px, 3vw, 40px);
    width: 100%;
    max-width: 1480px;
    margin-inline: auto;
    padding-inline: clamp(16px, 3.5vw, 44px);
    padding-top: 4px;
  }

  .modal-title {
    font-family: var(--font-serif, "Instrument Serif", Georgia, serif);
    font-size: clamp(1.85rem, 2.8vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .modal-desc {
    font-family: var(--font-sans, "Plus Jakarta Sans", sans-serif);
    font-size: 0.92rem;
    line-height: 1.55;
    color: #94a3b8;
    margin: 0;
    max-width: 48ch;
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  :global(.modal-tag) {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #cbd5e1;
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.3;
  }

  @media (max-width: 1024px) {
    .modal-info-row {
      grid-template-columns: 1fr 1fr;
    }

    .modal-info-tags-col {
      grid-column: 1 / -1;
    }

    .modal-tags {
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .work-modal-shell {
      justify-content: flex-start;
      padding: 16px 0 32px;
      gap: 14px;
    }

    .modal-info-row {
      order: 1;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .modal-gallery-viewport {
      order: 2;
      overflow-x: visible;
      overflow-y: visible;
      padding-inline: 16px;
      padding-bottom: 0;
    }

    .modal-gallery-track {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: auto;
      width: 100%;
    }

    :global(.bento-block-square) {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }

    :global(.bento-block-tall) {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }

    :global(.bento-block-top-wide),
    :global(.bento-block-bottom-wide) {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      gap: 12px;
    }

    :global(.bento-block-top-wide .bento-tile),
    :global(.bento-block-bottom-wide .bento-tile) {
      aspect-ratio: 1 / 1;
    }

    :global(.bento-block-top-wide .tile-wide),
    :global(.bento-block-bottom-wide .tile-wide-bottom) {
      aspect-ratio: 16 / 9;
    }
  }

