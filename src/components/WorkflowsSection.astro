---
// WorkflowsSection.astro - "Built on workflows that just work." Bento Section (Light Mode)
// Header:
//   - Eyebrow: "SIMPLE BY DESIGN"
//   - Title: "Built on workflows that just work."
//   - Subtitle: "From brief to delivery, every step is streamlined so you stay focused on strategy, not logistics."
//   - CTA: "Learn more"
// Cards: Selectable HTML text, crisp inline SVG icons, and clean background artwork.
---

<section class="workflows-section" id="workflows" data-theme="light">
  <!-- Soft Ambient Glow -->
  <div class="workflows-ambient-glow" aria-hidden="true"></div>

  <div class="container workflows-container">
    <!-- Header Block (Left Aligned) -->
    <header class="workflows-header">
      <div class="eyebrow-wrapper">
        <span class="eyebrow-text">SIMPLE BY DESIGN</span>
      </div>

      <h2 class="workflows-title">
        Built on workflows <span class="title-highlight">that just work.</span>
      </h2>

      <p class="workflows-subtitle">
        From brief to delivery, every step is streamlined so you stay focused on strategy, not logistics.
      </p>

      <div class="cta-wrapper">
        <a href="#learn-more" class="learn-more-btn">
          <span>Learn more</span>
        </a>
      </div>
    </header>

    <!-- Bento Workflows Grid (3 Columns: 2x2 on left, 1 tall card on right) -->
    <div class="workflows-bento">
      
      <!-- Card 1: From brief to delivery (Light Ice Blue Card + Real UI Mockup) -->
      <article class="bento-card card-delivery" style="--card-index: 0;">
        <div class="card-bg-layer">
          <img src="/workflows/card1-bg.jpg" alt="" aria-hidden="true" class="bento-bg-img" />
        </div>

        <div class="card-inner">
          <!-- Interactive-look UI Mockup: Final Design Checklist -->
          <div class="ui-mockup-delivery" aria-hidden="true">
            <div class="mockup-header">
              <span class="mockup-title">Final design</span>
              <span class="mockup-btn">Send to client</span>
            </div>
            <div class="mockup-list">
              <div class="mockup-row">
                <span class="file-badge">
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="none">
                    <path d="M9.5 2H4.5C3.94772 2 3.5 2.44772 3.5 3V13C3.5 13.5523 3.94772 14 4.5 14H11.5C12.0523 14 12.5 13.5523 12.5 13V5L9.5 2Z" stroke="white" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div class="file-meta">
                  <span class="file-name">15678 - Recipe Graphic Ad 2 - Ultimate...</span>
                  <span class="file-sub">1.4 MB · EPS</span>
                </div>
                <span class="status-pill">Final</span>
              </div>
              <div class="mockup-row">
                <span class="file-badge">
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="none">
                    <path d="M9.5 2H4.5C3.94772 2 3.5 2.44772 3.5 3V13C3.5 13.5523 3.94772 14 4.5 14H11.5C12.0523 14 12.5 13.5523 12.5 13V5L9.5 2Z" stroke="white" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div class="file-meta">
                  <span class="file-name">15679 - Recipe Graphic Ad 3 - Ultimate...</span>
                  <span class="file-sub">1.8 MB · EPS</span>
                </div>
                <span class="status-pill">Final</span>
              </div>
            </div>
          </div>

          <!-- Selectable Content -->
          <div class="card-content card-content-light">
            <div class="card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
              </svg>
            </div>
            <h3 class="card-title">From brief to delivery, no back-and-forth.</h3>
            <p class="card-desc">
              Submit your request, get a delivery in 1–2 days, request revisions if needed. That’s the whole process.
            </p>
          </div>
        </div>
      </article>

      <!-- Card 2: Plugs into your stack instantly -->
      <article class="bento-card card-stack" style="--card-index: 1;">
        <div class="card-bg-layer">
          <img src="/workflows/card2-bg.jpg" alt="" aria-hidden="true" class="bento-bg-img" />
          <div class="card-scrim-dark"></div>
        </div>

        <div class="card-inner">
          <!-- Interactive-look UI Mockup: Slack/App Notification -->
          <div class="ui-mockup-slack" aria-hidden="true">
            <div class="slack-avatar">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M13.5 5.5C9.91 5.5 7 8.41 7 12C7 15.59 9.91 18.5 13.5 18.5C15.5 18.5 17.28 17.59 18.48 16.16L16.35 14.37C15.65 15.22 14.63 15.75 13.5 15.75C11.43 15.75 9.75 14.07 9.75 12C9.75 9.93 11.43 8.25 13.5 8.25C14.63 8.25 15.65 8.78 16.35 9.63L18.48 7.84C17.28 6.41 15.5 5.5 13.5 5.5Z" fill="white"/>
              </svg>
            </div>
            <div class="slack-body">
              <div class="slack-head">
                <span class="slack-app-name">Adaptif</span>
                <span class="slack-badge">APP</span>
                <span class="slack-time">10:39 AM</span>
              </div>
              <div class="slack-status">
                <span class="check-dot">
                  <svg width="9" height="9" viewBox="0 0 12 12" fill="none">
                    <path d="M2.5 6L5 8.5L9.5 3.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span>John Smith marked this asset as approved</span>
              </div>
              <div class="slack-file">FinalDesign.png (42 KB)</div>
            </div>
          </div>

          <!-- Selectable Content -->
          <div class="card-content card-content-dark">
            <div class="card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
            </div>
            <h3 class="card-title">Plugs into your stack instantly.</h3>
            <p class="card-desc">
              Whether you run on Notion, ClickUp, Slack, or Asana, Adaptif connects with it so your team never has to change how they work.
            </p>
          </div>
        </div>
      </article>

      <!-- Card 3: Get inspired by work that actually converted (Wide 2 Columns) -->
      <article class="bento-card card-converted" style="--card-index: 2;">
        <div class="card-bg-layer">
          <img src="/workflows/card3-bg.jpg" alt="" aria-hidden="true" class="bento-bg-img" />
          <div class="card-scrim-wide"></div>
        </div>

        <div class="card-inner card-inner-bottom">
          <div class="card-content card-content-dark card-content-wide">
            <div class="card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </div>
            <h3 class="card-title">Get inspired by work that actually converted.</h3>
            <p class="card-desc">
              Browse a curated library of high-performing creative, from social campaigns to brand identities — and use it to brief your next project faster.
            </p>
          </div>
        </div>
      </article>

      <!-- Card 4: Brand assets, always ready to go (Tall Right Column) -->
      <article class="bento-card card-assets" style="--card-index: 3;">
        <div class="card-bg-layer">
          <img src="/workflows/card4-bg.jpg" alt="" aria-hidden="true" class="bento-bg-img" />
          <div class="card-scrim-tall"></div>
        </div>

        <div class="card-inner card-inner-bottom">
          <div class="card-content card-content-dark">
            <div class="card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
            </div>
            <h3 class="card-title">Brand assets, always ready to go.</h3>
            <p class="card-desc">
              Upload your logos, fonts, and guidelines once. Your creative team uses them on every project from day one.
            </p>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function initWorkflows() {
      const section = document.getElementById("workflows");
      if (!section) return;

      const observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              section.classList.add("is-visible");
            }
          });
        },
        { threshold: 0.08, rootMargin: "0px 0px -40px 0px" }
      );
      observer.observe(section);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initWorkflows);
    } else {
      initWorkflows();
    }
    document.addEventListener("astro:page-load", initWorkflows);
  })();
</script>

<style>
  /* ==========================================================================
     WORKFLOWS SECTION: Light Mode Clean Canvas & Bento Layout
     ========================================================================== */
  .workflows-section {
    position: relative;
    width: 100%;
    padding-top: clamp(80px, 11vh, 130px);
    padding-bottom: clamp(90px, 13vh, 150px);
    background-color: #fafaf8;
    color: #0b0f19;
    overflow: hidden;
    isolation: isolate;
  }

  .workflows-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(1400px, 100vw);
    height: 90%;
    background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(2, 132, 199, 0.05) 0%, rgba(240, 249, 255, 0.4) 40%, transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .workflows-container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max, 1240px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  /* ==========================================================================
     HEADER: Left Aligned Editorial Typography
     ========================================================================== */
  .workflows-header {
    max-width: 740px;
    margin-bottom: clamp(38px, 5.5vh, 60px);
  }

  .eyebrow-wrapper {
    margin-bottom: clamp(10px, 1.6vh, 16px);
    opacity: 0;
    transform: translateY(14px);
    transition: 
      opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eyebrow-text {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0284c7;
    display: inline-block;
  }

  .workflows-title {
    font-family: var(--font-family-display, serif);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.035em;
    color: #0b0f19;
    margin: 0;
    margin-bottom: clamp(14px, 2vh, 20px);
    opacity: 0;
    transform: translateY(20px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  .workflows-title .title-highlight {
    font-style: italic;
    background: linear-gradient(135deg, #0070f3 0%, #0099ff 45%, #00c0f0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
    filter: drop-shadow(0 2px 10px rgba(0, 153, 255, 0.18));
  }

  .workflows-subtitle {
    font-family: var(--font-family-body, sans-serif);
    font-size: clamp(0.96rem, 1.15vw, 1.12rem);
    color: #64748b;
    line-height: 1.6;
    margin: 0;
    margin-bottom: clamp(22px, 3vh, 32px);
    opacity: 0;
    transform: translateY(20px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.18s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.18s;
  }

  .cta-wrapper {
    opacity: 0;
    transform: translateY(16px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.24s;
  }

  .learn-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    font-size: 0.88rem;
    font-weight: 500;
    color: #0f172a;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.05);
    transition: 
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1)),
      box-shadow 0.25s ease;
  }

  .learn-more-btn:hover {
    background: #0b0f19;
    color: #ffffff;
    border-color: #0b0f19;
    box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.22);
    transform: translateY(-2px);
  }

  .workflows-section.is-visible .eyebrow-wrapper,
  .workflows-section.is-visible .workflows-title,
  .workflows-section.is-visible .workflows-subtitle,
  .workflows-section.is-visible .cta-wrapper {
    opacity: 1;
    transform: translateY(0);
  }

  /* ==========================================================================
     BENTO WORKFLOWS GRID
     ========================================================================== */
  .workflows-bento {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: minmax(310px, auto) minmax(300px, auto);
    gap: clamp(16px, 1.8vw, 24px);
    align-items: stretch;
  }

  .bento-card {
    position: relative;
    border-radius: clamp(18px, 2vw, 26px);
    overflow: hidden;
    background-color: #0b1120;
    box-shadow: 
      0 10px 28px -10px rgba(15, 23, 42, 0.1),
      0 2px 8px -2px rgba(15, 23, 42, 0.04),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    opacity: 0;
    transform: translateY(28px);
    transition: 
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) calc(0.2s + var(--card-index, 0) * 0.08s),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) calc(0.2s + var(--card-index, 0) * 0.08s),
      box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .workflows-section.is-visible .bento-card {
    opacity: 1;
    transform: translateY(0);
  }

  .bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 20px 42px -12px rgba(15, 23, 42, 0.16),
      0 4px 14px -2px rgba(15, 23, 42, 0.06),
      0 0 0 1px rgba(15, 23, 42, 0.1);
  }

  .card-delivery {
    grid-column: 1;
    grid-row: 1;
    background-color: #e4f3fc;
  }

  .card-stack {
    grid-column: 2;
    grid-row: 1;
  }

  .card-converted {
    grid-column: 1 / span 2;
    grid-row: 2;
  }

  .card-assets {
    grid-column: 3;
    grid-row: 1 / span 2;
  }

  /* Background Layer & Scrims */
  .card-bg-layer {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .bento-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.01);
    transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover .bento-bg-img {
    transform: scale(1.05);
  }

  .card-scrim-dark {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 8, 16, 0.12) 0%,
      rgba(5, 8, 16, 0.55) 55%,
      rgba(2, 5, 14, 0.92) 100%
    );
  }

  .card-scrim-wide {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 5, 14, 0.05) 0%,
      rgba(2, 5, 14, 0.45) 50%,
      rgba(2, 5, 14, 0.92) 100%
    );
  }

  .card-scrim-tall {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 5, 14, 0.05) 0%,
      rgba(2, 5, 14, 0.25) 55%,
      rgba(2, 5, 14, 0.92) 100%
    );
  }

  /* Card Inner Layout & Selectable Content */
  .card-inner {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: clamp(22px, 2.2vw, 30px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .card-inner-bottom {
    justify-content: flex-end;
  }

  .card-content {
    user-select: text;
    -webkit-user-select: text;
  }

  .card-content-wide {
    max-width: 560px;
  }

  .card-icon {
    margin-bottom: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .card-content-light .card-icon {
    color: #0b0f19;
  }

  .card-content-dark .card-icon {
    color: #ffffff;
  }

  .card-title {
    font-family: var(--font-family-body, sans-serif);
    font-size: clamp(1.1rem, 1.35vw, 1.28rem);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.02em;
    margin: 0 0 8px 0;
    user-select: text;
    -webkit-user-select: text;
  }

  .card-content-light .card-title {
    color: #0b0f19;
  }

  .card-content-dark .card-title {
    color: #ffffff;
  }

  .card-desc {
    font-family: var(--font-family-body, sans-serif);
    font-size: clamp(0.84rem, 0.92vw, 0.92rem);
    line-height: 1.5;
    margin: 0;
    user-select: text;
    -webkit-user-select: text;
  }

  .card-content-light .card-desc {
    color: #475569;
  }

  .card-content-dark .card-desc {
    color: rgba(226, 232, 240, 0.88);
  }

  /* ==========================================================================
     UI MOCKUPS INSIDE CARDS 1 & 2 (Crisp HTML/CSS)
     ========================================================================== */
  /* Card 1: Final Design File Checklist */
  .ui-mockup-delivery {
    background: #ffffff;
    border-radius: 14px;
    padding: 12px 14px;
    box-shadow: 
      0 10px 25px -5px rgba(2, 132, 199, 0.14),
      0 0 0 1px rgba(15, 23, 42, 0.06);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mockup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mockup-title {
    font-size: 0.72rem;
    font-weight: 700;
    color: #0b0f19;
  }

  .mockup-btn {
    font-size: 0.62rem;
    font-weight: 600;
    color: #ffffff;
    background: #0b0f19;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .mockup-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mockup-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 6px;
    border-top: 1px solid rgba(15, 23, 42, 0.06);
  }

  .file-badge {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: linear-gradient(135deg, #0099ff 0%, #48c8ff 100%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .file-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .file-name {
    font-size: 0.64rem;
    font-weight: 600;
    color: #0f172a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .file-sub {
    font-size: 0.56rem;
    color: #94a3b8;
  }

  .status-pill {
    font-size: 0.58rem;
    font-weight: 600;
    color: #0284c7;
    background: #e0f2fe;
    padding: 2px 7px;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  /* Card 2: Slack/App Approval Capsule */
  .ui-mockup-slack {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-radius: 14px;
    padding: 12px 14px;
    box-shadow: 
      0 14px 32px -6px rgba(0, 0, 0, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .slack-avatar {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: linear-gradient(135deg, #0099ff 0%, #48c8ff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .slack-body {
    flex: 1;
    min-width: 0;
  }

  .slack-head {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }

  .slack-app-name {
    font-size: 0.72rem;
    font-weight: 700;
    color: #0f172a;
  }

  .slack-badge {
    font-size: 0.54rem;
    font-weight: 700;
    color: #0284c7;
    background: #e0f2fe;
    padding: 1px 5px;
    border-radius: 4px;
  }

  .slack-time {
    font-size: 0.62rem;
    color: #64748b;
  }

  .slack-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.68rem;
    font-weight: 500;
