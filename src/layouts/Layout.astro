---
import "../styles/global.css";
import BookCallModal from "../components/BookCallModal.astro";
import WhatsAppWidget from "../components/WhatsAppWidget.astro";
import GlobalPageEditor from "../components/GlobalPageEditor.astro";
import { getWhatsAppConfig } from "../lib/whatsappDb";
import { getSeoConfig, resolvePageSeo } from "../lib/seoDb";
import {
  getPageContent,
  listSitePagesForEditor,
  normalizeCmsPath,
} from "../lib/cmsContentDb";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const isEditMode = Astro.url.searchParams.get("edit") === "1";
const currentCmsPath = normalizeCmsPath(Astro.url.pathname);

if (isEditMode) {
  Astro.response.headers.set("Cache-Control", "no-store");
}

const [whatsappConfig, seoConfig, cmsOverrides, cmsPages] = await Promise.all([
  getWhatsAppConfig(),
  getSeoConfig(),
  getPageContent(currentCmsPath),
  isEditMode ? listSitePagesForEditor() : Promise.resolve([]),
]);

const seo = resolvePageSeo(seoConfig, Astro.url.pathname, { title, description });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#010307" />
    <meta name="color-scheme" content="dark" />

    <!-- SEO Meta Tags -->
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={seo.robots} />
    <link rel="canonical" href={seo.canonicalUrl} />
    <meta property="og:title" content={seo.ogTitle} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:type" content="website" />
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    <meta name="twitter:card" content={seo.twitterCard} />
    <meta name="twitter:title" content={seo.ogTitle} />
    <meta name="twitter:description" content={seo.ogDescription} />
    {seo.ogImage && <meta name="twitter:image" content={seo.ogImage} />}
    {seo.googleSiteVerification && (
      <meta name="google-site-verification" content={seo.googleSiteVerification} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(seo.jsonLd)} />
    {seo.ga4MeasurementId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(seo.ga4MeasurementId)}`}></script>
        <script is:inline define:vars={{ gaId: seo.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Speculation Rules API for Predictive Preloading -->
    <script type="speculationrules">
      {
        "prerender": [
          {
            "source": "list",
            "urls": ["/", "/services", "/portfolio", "/pricing", "/blog"]
          }
        ],
        "prefetch": [
          {
            "source": "document",
            "where": {
              "and": [
                { "href_matches": "/*" }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body>
    <!-- Page Content -->
    <slot />
    <BookCallModal />
    <WhatsAppWidget config={whatsappConfig} />
    <GlobalPageEditor
      currentPath={currentCmsPath}
      overrides={cmsOverrides}
      isEditMode={isEditMode}
      pages={cmsPages}
    />

    <!-- Universal Section Staggered Entrance Observer -->
    <script>
      function initSectionScrollReveal() {
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const sections = document.querySelectorAll("section");

        if (prefersReducedMotion) {
          sections.forEach((s) => s.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px"
          }
        );

        sections.forEach((s) => {
          const rect = s.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.85) {
            s.classList.add("is-visible");
          } else {
            observer.observe(s);
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSectionScrollReveal);
      } else {
        initSectionScrollReveal();
      }

      document.addEventListener("astro:page-load", initSectionScrollReveal);
    </script>
  </body>
</html>

<style>
  .ambient-light-container {
    display: none;
  }
</style>
