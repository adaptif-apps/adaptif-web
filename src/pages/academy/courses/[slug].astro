    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 18px;
  }

  .badge-pro,
  .badge-price,
  .badge-meta {
    padding: 5px 13px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .badge-pro {
    background: rgba(72, 200, 255, 0.14);
