  }

  .cf-hero-card-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cf-hc-label {
    color: var(--text-muted);
  }

  .cf-hc-val {
    color: var(--text-primary);
    font-weight: 600;
  }

  .cf-cyan {
    color: var(--cyan-primary);
  }

  /* Value Strip */
  .cf-value-strip {
    padding: 14px 0 24px;
  }

  .cf-strip-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px 28px;
    padding: 16px 22px;
    border-radius: 16px;
    background: rgba(11, 32, 54, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .cf-strip-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .cf-strip-item svg {
    color: var(--cyan-primary);
  }

  /* Sections */
  .cf-section {
    padding: 46px 0;
  }

  .cf-section-head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 32px;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan-primary);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .section-title {
    margin: 0 0 10px;
    font-size: clamp(1.55rem, 2.7vw, 2.2rem);
    line-height: 1.16;
    color: var(--text-primary);
  }

  .section-sub,
  .section-copy {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.62;
    color: var(--text-secondary);
  }

  /* Before / After Grid */
  .cf-ba-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .cf-ba-card {
    padding: 22px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(11, 32, 54, 0.48);
  }

  .cf-ba-before {
    border-color: rgba(255, 107, 107, 0.22);
    background: linear-gradient(180deg, rgba(60, 18, 28, 0.35), rgba(10, 20, 34, 0.55));
  }

  .cf-ba-after {
    border-color: rgba(72, 200, 255, 0.28);
    background: linear-gradient(180deg, rgba(12, 46, 72, 0.48), rgba(7, 20, 36, 0.65));
  }

  .cf-ba-pill {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .cf-pill-before {
    background: rgba(255, 107, 107, 0.14);
    color: #ff9e9e;
    border: 1px solid rgba(255, 107, 107, 0.3);
  }

  .cf-pill-after {
    background: rgba(72, 200, 255, 0.14);
    color: var(--cyan-primary);
    border: 1px solid rgba(72, 200, 255, 0.32);
  }

  .cf-ba-card h3 {
    margin: 0 0 8px;
    font-size: 1.02rem;
    color: var(--text-primary);
  }

  .cf-ba-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Visual Split Proof */
  .cf-split-proof {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 36px;
    align-items: center;
    padding: 30px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(11, 32, 54, 0.42);
  }

  .cf-split-visual {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    aspect-ratio: 16 / 10;
  }

  .cf-split-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cf-split-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .cf-badge-dark,
  .cf-badge-cyan {
    padding: 4px 11px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }

  .cf-badge-dark {
    background: rgba(5, 14, 24, 0.8);
    color: #ffb0b0;
    border: 1px solid rgba(255, 107, 107, 0.35);
  }

  .cf-badge-cyan {
    background: rgba(7, 28, 46, 0.85);
    color: var(--cyan-primary);
    border: 1px solid rgba(72, 200, 255, 0.45);
  }

  /* Pillars */
  .cf-pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .cf-pillar-card {
    padding: 22px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(11, 32, 54, 0.48);
  }

  .cf-pillar-num {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--cyan-primary);
    margin-bottom: 10px;
  }

  .cf-pillar-card h3 {
    margin: 0 0 8px;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .cf-pillar-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* System Showcase */
  .cf-showcase-frame {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(72, 200, 255, 0.22);
    background: rgba(5, 16, 28, 0.85);
  }

  .cf-showcase-topbar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(12, 32, 52, 0.65);
  }

  .cf-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }

  .cf-showcase-url {
    margin-left: 8px;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .cf-showcase-media {
    max-height: 480px;
    overflow: hidden;
  }

  .cf-showcase-media img {
    width: 100%;
    height: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  .cf-showcase-caption {
    margin: 0;
    padding: 12px 18px;
    font-size: 0.82rem;
    color: var(--text-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Explorer */
  .cf-explorer-tabs {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .cf-tab-btn {
    appearance: none;
    padding: 9px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .cf-tab-btn.is-active {
    background: rgba(72, 200, 255, 0.16);
    border-color: rgba(72, 200, 255, 0.5);
    color: var(--cyan-primary);
  }

  .cf-explorer-panel {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 28px;
    align-items: center;
    padding: 26px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(11, 32, 54, 0.48);
  }

  .cf-explorer-panel[hidden] {
    display: none;
  }

  .cf-explorer-img {
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cf-explorer-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cf-explorer-info h3 {
    margin: 0 0 10px;
    font-size: 1.3rem;
    color: var(--text-primary);
  }

  .cf-explorer-info p {
    margin: 0 0 18px;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .cf-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .cf-spec-box {
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(5, 16, 28, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.07);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cf-spec-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .cf-spec-val {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Companion Tool */
  .tool-spotlight-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(16, 48, 80, 0.7), rgba(7, 22, 38, 0.85));
    border: 1px solid rgba(72, 200, 255, 0.3);
  }

  .tool-title {
    margin: 0 0 6px;
    font-size: 1.45rem;
    color: var(--text-primary);
  }

  .tool-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .tool-locked-pill {
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  /* Curriculum Grid */
  .curriculum-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .curriculum-card {
    padding: 18px 20px;
    border-radius: 15px;
    background: rgba(11, 32, 54, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .curr-num {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--cyan-primary);
    margin-bottom: 6px;
  }

  .curr-title {
    margin: 0 0 6px;
    font-size: 0.98rem;
    color: var(--text-primary);
  }

  .curr-body {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Outcomes Split */
  .cf-outcomes-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 34px;
    align-items: center;
    padding: 30px;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(11, 32, 54, 0.42);
  }

  .cf-outcomes-list {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cf-outcome-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .cf-outcome-check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(72, 200, 255, 0.14);
    border: 1px solid rgba(72, 200, 255, 0.35);
    color: var(--cyan-primary);
    margin-top: 2px;
  }

  .cf-outcome-item h4 {
    margin: 0 0 3px;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .cf-outcome-item p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .cf-outcomes-visual {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 4.4;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cf-outcomes-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Deliverables */
  .cf-deliverables-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .cf-deliv-card {
    padding: 24px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(11, 32, 54, 0.5);
  }

  .cf-deliv-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(72, 200, 255, 0.12);
    border: 1px solid rgba(72, 200, 255, 0.28);
    color: var(--cyan-primary);
    margin-bottom: 10px;
  }

  .cf-deliv-card h3 {
    margin: 0 0 6px;
    font-size: 1.05rem;
    color: var(--text-primary);
  }

  .cf-deliv-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* Closing Banner */
  .cf-closing-card {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
    align-items: center;
    padding: 30px;
    border-radius: 24px;
    border: 1px solid rgba(72, 200, 255, 0.3);
    background: linear-gradient(135deg, rgba(14, 46, 78, 0.72), rgba(5, 16, 28, 0.92));
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .cf-closing-visual {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .cf-closing-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cf-closing-title {
    margin: 0 0 10px;
    font-size: clamp(1.55rem, 2.8vw, 2.2rem);
    line-height: 1.15;
    color: var(--text-primary);
  }

  .cf-closing-body {
    margin: 0 0 18px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .cf-closing-list {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px 14px;
  }

  .cf-closing-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--text-primary);
  }

  .cf-closing-list svg {
    color: var(--cyan-primary);
    flex-shrink: 0;
  }

  .cf-closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* FAQ */
  .faq-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .faq-card {
    padding: 18px 20px;
    border-radius: 16px;
    background: rgba(11, 32, 54, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-card summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    font-weight: 600;
    color: var(--text-primary);
    list-style: none;
  }

  .faq-plus {
    color: var(--cyan-primary);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .faq-card p {
    margin: 12px 0 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (max-width: 960px) {
    .cf-hero-grid,
    .cf-split-proof,
    .cf-explorer-panel,
    .cf-outcomes-split,
    .cf-closing-card,
    .cf-ba-grid,
    .cf-pillars-grid,
    .curriculum-grid,
    .cf-deliverables-grid,
    .faq-list {
      grid-template-columns: 1fr;
    }

    .cf-closing-list {
      grid-template-columns: 1fr;
    }

    .tool-spotlight-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Frontend Edit Mode (?edit=1) */
  .cf-showcase-media,
  .cf-explorer-img,
  .cf-outcomes-visual,
  .cf-closing-visual {
    position: relative;
  }

  .course-funnel.is-edit-mode {
    padding-bottom: 130px;
  }

  .course-funnel.is-edit-mode [contenteditable="true"] {
    outline: 1px dashed rgba(72, 200, 255, 0.35);
    outline-offset: 3px;
    border-radius: 6px;
    cursor: text;
    transition: outline-color 0.15s, background 0.15s;
  }

  .course-funnel.is-edit-mode [contenteditable="true"]:hover {
    outline-color: rgba(72, 200, 255, 0.7);
    background: rgba(72, 200, 255, 0.05);
  }

  .course-funnel.is-edit-mode [contenteditable="true"]:focus {
    outline: 2px solid #48c8ff;
    background: rgba(72, 200, 255, 0.09);
  }

  .cf-img-edit-btn {
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 12;
    appearance: none;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid rgba(72, 200, 255, 0.6);
    background: rgba(4, 12, 24, 0.86);
    backdrop-filter: blur(10px);
    color: #9ce1ff;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
  }

  .cf-img-edit-btn:hover {
    background: #48c8ff;
    color: #03121e;
  }

  .cf-edit-bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 300;
    width: min(820px, 94vw);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding: 12px 18px;
    border-radius: 999px;
    background: rgba(5, 16, 30, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(72, 200, 255, 0.42);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75);
  }

  .cf-edit-status {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #f8fafc;
  }

  .cf-edit-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #48c8ff;
    box-shadow: 0 0 10px #48c8ff;
  }

  .cf-edit-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cf-edit-btn-glass,
  .cf-edit-btn-cyan {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .cf-edit-btn-glass {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: #e2e8f0;
  }

  .cf-edit-btn-cyan {
    border: none;
    background: #48c8ff;
    color: #03121e;
  }

  [data-funnel-block][hidden],
  .cf-blocks-drawer[hidden],
  .cf-img-modal-backdrop[hidden],
  .cf-edit-toast[hidden] {
    display: none !important;
  }

  .cf-edit-bar {
    width: min(940px, 95vw);
  }

  .cf-blocks-drawer {
    position: fixed;
    bottom: 84px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 310;
    width: min(940px, 95vw);
    max-height: min(68vh, 520px);
    overflow-y: auto;
    padding: 20px 22px;
    border-radius: 22px;
    background: rgba(5, 16, 30, 0.94);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(72, 200, 255, 0.35);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.78);
  }

  .cf-blocks-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .cf-blocks-eyebrow {
    display: block;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #48c8ff;
    margin-bottom: 4px;
  }

  .cf-blocks-drawer-head h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .cf-blocks-quick {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cf-blocks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 10px;
  }

  .cf-block-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 11px 14px;
    border-radius: 14px;
    border: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
  }

  .cf-block-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .cf-block-meta strong {
    font-size: 0.82rem;
    font-weight: 650;
    color: #f8fafc;
  }

  .cf-block-meta span {
    font-size: 0.72rem;
    color: rgba(203, 213, 225, 0.72);
    line-height: 1.3;
  }

  .cf-block-switch {
