---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import {
  FUNNEL_BLOCKS,
  defaultFunnelVisibility,
  getAcademyItemBySlug,
  getAcademySettings,
  verifyAccessToken
} from "../../../lib/academyDb";

export const prerender = false;

const slug = Astro.params.slug || "";
const item = await getAcademyItemBySlug(slug, "course", false);

if (!item) {
  return Astro.redirect("/academy/courses");
}

const settings = await getAcademySettings();
const effectiveAccessMode = item.accessMode || settings.defaultCourseAccessMode;

const cookieToken = Astro.cookies.get(`adaptif_academy_${item.slug}`)?.value;
const queryToken = Astro.url.searchParams.get("access");
const isUnlocked =
  effectiveAccessMode === "open" ||
  (effectiveAccessMode === "checkout_redirect" && Astro.url.searchParams.get("checkout") === "success") ||
  (await verifyAccessToken(item.id, queryToken || cookieToken));

const vis = defaultFunnelVisibility(item.landingData.funnelVisibility);
const f = item.landingData.funnel || {};
const coverImg = item.coverImage || "/images/why-us/our-technology.jpg";
const isEditMode = Astro.url.searchParams.get("edit") === "1";

const ed = (field: string): Record<string, string> =>
  isEditMode ? { contenteditable: "true", "data-edit-field": field, spellcheck: "false" } : {};

const edImg = (field: string): Record<string, string> =>
  isEditMode ? { "data-edit-image": field } : {};

// Smart fallbacks so every funnel block looks complete even on older courses
const valueStrip =
  Array.isArray(f.valueStrip) && f.valueStrip.length > 0
    ? f.valueStrip
    : [
        "Instant Digital Access",
        "Interactive Web Slide Deck",
        "Selectable-Text Vector PDF",
        item.toolName ? `Includes ${item.toolName}` : "Actionable Templates",
        "No Quizzes or Fluff"
      ];

const beforeAfter = {
  eyebrow: f.beforeAfter?.eyebrow || "The Execution Gap",
  title: f.beforeAfter?.title || "Why ad-hoc workflows stall vs. a structured system",
  subtitle:
    f.beforeAfter?.subtitle ||
    "Stop piecing together scattered tutorials. Move from trial-and-error to a repeatable production pipeline.",
  beforeItems:
    Array.isArray(f.beforeAfter?.beforeItems) && f.beforeAfter!.beforeItems.length > 0
      ? f.beforeAfter!.beforeItems
      : [
          { title: "Fragmented Tools", body: "Jumping between disconnected prompts and docs with inconsistent quality." },
          { title: "Hours of Trial & Error", body: "Rebuilding basic workflows from scratch every time a new project starts." },
          { title: "No Clear Guardrails", body: "Generic outputs that miss brand standards and require heavy manual rework." }
        ],
  afterItems:
    Array.isArray(f.beforeAfter?.afterItems) && f.beforeAfter!.afterItems.length > 0
      ? f.beforeAfter!.afterItems
      : [
          { title: "Unified Playbook", body: "One coherent, step-by-step system you can reference online or as a PDF." },
          { title: "Rapid Execution", body: "Apply proven structures and companion templates in minutes instead of weeks." },
          { title: "Consistent Craft", body: "Repeatable, studio-grade deliverables built for real client and team work." }
        ]
};

const visualComparison = {
  eyebrow: f.visualComparison?.eyebrow || "Side-by-Side Impact",
  title: f.visualComparison?.title || "Built for real-world output, not theory",
  body:
    f.visualComparison?.body ||
    item.description ||
    "See how structured guardrails transform raw inputs into cohesive, client-ready results.",
  beforeLabel: f.visualComparison?.beforeLabel || "Ad-Hoc Approach",
  afterLabel: f.visualComparison?.afterLabel || "With This System",
  image: f.visualComparison?.image || coverImg
};

const pillars = {
  eyebrow: f.pillars?.eyebrow || "Core Architecture",
  title: f.pillars?.title || "6 pillars of the system",
  subtitle:
    f.pillars?.subtitle ||
    "Every concept is organized into practical building blocks you can deploy immediately.",
  items:
    Array.isArray(f.pillars?.items) && f.pillars!.items.length > 0
      ? f.pillars!.items
      : (item.landingData.takeaways.length > 0
          ? item.landingData.takeaways.map((t, idx) => ({
              title: `Pillar 0${idx + 1}`,
              body: t
            }))
          : [
              { title: "Clear Foundations", body: "Establish constraints and structure before generating assets." },
              { title: "Repeatable Pipelines", body: "Turn one-off wins into documented multi-step workflows." },
              { title: "Visual Consistency", body: "Keep typography, lighting, and tone locked across channels." },
              { title: "Companion Assets", body: "Start faster with pre-built templates and prompt kits." },
              { title: "Vector PDF Reference", body: "Keep the entire handbook offline with selectable text." },
              { title: "Zero Busywork", body: "Skip filler modules and jump straight to execution." }
            ])
};

const systemShowcase = {
  eyebrow: f.systemShowcase?.eyebrow || "Complete Workflow",
  title: f.systemShowcase?.title || "How every piece connects",
  subtitle:
    f.systemShowcase?.subtitle ||
    "A unified visual overview of the steps, assets, and deliverables inside this course.",
  image: f.systemShowcase?.image || coverImg,
  caption:
    f.systemShowcase?.caption ||
    `${item.title} — End-to-end production system & companion workflow`
};

const explorerTabs =
  Array.isArray(f.explorer?.tabs) && f.explorer!.tabs.length > 0
    ? f.explorer!.tabs
    : [
        {
          label: "Slide Deck",
          title: `${item.slides.length || 6} Interactive Slides`,
          body: "Navigate the full visual curriculum directly in your browser with crisp typography and structured layouts.",
          image: coverImg,
          specs: [
            { label: "Format", value: "16:9 Web Deck" },
            { label: "Navigation", value: "Keyboard & Click" },
            { label: "Read Time", value: item.landingData.readTime || "Self-paced" },
            { label: "Access", value: "Instant & Lifetime" }
          ]
        },
        {
          label: "Vector PDF",
          title: "Pixel-Perfect Offline Handbook",
          body: "Download a crisp PDF generated directly from the web slides—preserving layout fidelity and selectable text.",
          image: coverImg,
          specs: [
            { label: "Text", value: "100% Selectable" },
            { label: "Fidelity", value: "Matches Web Slides" },
            { label: "Usage", value: "Offline & Team Share" },
            { label: "Updates", value: "Included" }
          ]
        },
        {
          label: item.toolName || "Companion Kit",
          title: item.toolName || "Ready-to-Use Templates",
          body: "Pair the handbook with practical templates, prompt kits, or micro-apps designed for immediate application.",
          image: coverImg,
          specs: [
            { label: "Asset Type", value: item.toolType || "Template / Kit" },
            { label: "Setup Time", value: "Under 5 minutes" },
            { label: "Modules", value: "None required" },
            { label: "License", value: "Commercial Projects" }
          ]
        }
      ];

const explorer = {
  eyebrow: f.explorer?.eyebrow || "Inside the System",
  title: f.explorer?.title || "Explore every component",
  subtitle:
    f.explorer?.subtitle || "Inspect the slide deck, vector PDF, and companion resources before you enroll.",
  tabs: explorerTabs
};

const curriculumModules =
  Array.isArray(f.curriculum?.modules) && f.curriculum!.modules.length > 0
    ? f.curriculum!.modules
    : item.slides.map((s, idx) => ({
        tag: idx < 9 ? `0${idx + 1}` : `${idx + 1}`,
        title: s.title,
        body: s.body || (s.bullets && s.bullets[0]) || "Core tactical breakdown"
      }));

const curriculum = {
  eyebrow: f.curriculum?.eyebrow || "Deck Curriculum",
  title: f.curriculum?.title || `${curriculumModules.length} focused sections + downloadable PDF`,
  subtitle:
    f.curriculum?.subtitle || "Every slide is engineered to be scanned, applied, and referenced without fluff.",
  modules: curriculumModules
};

const outcomes = {
  eyebrow: f.outcomes?.eyebrow || "Target Outcomes",
  title: f.outcomes?.title || "What you will ship after finishing",
  subtitle:
    f.outcomes?.subtitle ||
    (item.landingData.audience ? `Built specifically for ${item.landingData.audience}.` : "Designed for immediate execution."),
  image: f.outcomes?.image || coverImg,
  bullets:
    Array.isArray(f.outcomes?.bullets) && f.outcomes!.bullets.length > 0
      ? f.outcomes!.bullets
      : (item.landingData.takeaways.length > 0
          ? item.landingData.takeaways.map((t, i) => ({
              title: `Outcome 0${i + 1}`,
              body: t
            }))
          : [
              { title: "Faster Production", body: "Cut concept-to-delivery cycles dramatically." },
              { title: "Repeatable Quality", body: "Eliminate guesswork with documented guardrails." }
            ])
};

const deliverables = {
  eyebrow: f.deliverables?.eyebrow || "Included Assets",
  title: f.deliverables?.title || "Everything included with your purchase",
  items:
    Array.isArray(f.deliverables?.items) && f.deliverables!.items.length > 0
      ? f.deliverables!.items
      : [
          { badge: "Deck", title: "Online Slide Viewer", body: "Full-screen 16:9 interactive presentation accessible from any device." },
          { badge: "PDF", title: "Selectable-Text Vector PDF", body: "Exported directly from the slide engine for pixel-perfect offline reference." },
          { badge: "Kit", title: item.toolName || "Companion Templates", body: "Practical templates, prompts, or micro-app links ready to duplicate." },
          { badge: "Access", title: "Zero Locked Modules", body: "Immediate access to all slides and assets the moment checkout completes." }
        ]
};

const closingCta = {
  eyebrow: f.closingCta?.eyebrow || "Instant Access",
  title: f.closingCta?.title || `Start using ${item.title} today`,
  body:
    f.closingCta?.body ||
    item.subtitle ||
    "Unlock the full online slide deck, downloadable PDF, and companion resources in seconds.",
  checklist:
    Array.isArray(f.closingCta?.checklist) && f.closingCta!.checklist.length > 0
      ? f.closingCta!.checklist
      : [
          "Complete online slide deck",
          "High-resolution selectable PDF",
          item.toolName ? `Companion asset: ${item.toolName}` : "Ready-to-use workflows",
          "Instant access upon checkout"
        ],
  image: f.closingCta?.image || coverImg
};

const primaryCtaHref = isUnlocked
  ? `/academy/courses/${item.slug}/slides`
  : item.stripeCheckoutUrl || "#course-enroll";
const primaryCtaExternal = !isUnlocked && Boolean(item.stripeCheckoutUrl);
---

<Layout title={`${item.title} — Course | Adaptif Academy`} description={item.subtitle || item.description}>
  <Header />
  <main class:list={["course-funnel", { "is-edit-mode": isEditMode }]}>
    <!-- 1. HERO SPLIT -->
    <section class="cf-hero is-visible">
      <div class="cf-container">
        <div class="cf-breadcrumb">
          <a href="/academy">Academy</a>
          <span>/</span>
          <a href="/academy/courses">Courses</a>
          <span>/</span>
          <span>{item.category}</span>
        </div>

        <div class="cf-hero-grid">
          <div class="cf-hero-copy">
            <div class="cf-badges">
              <span class="badge-pro" {...ed("landingData.heroBadge")}>{item.landingData.heroBadge || "Pro Course"}</span>
              {item.priceLabel && <span class="badge-price">{item.priceLabel}</span>}
              {item.landingData.readTime && <span class="badge-meta" {...ed("landingData.readTime")}>{item.landingData.readTime}</span>}
            </div>

            <h1 class="cf-title" {...ed("title")}>{item.title}</h1>
            <p class="cf-subtitle" {...ed("subtitle")}>{item.subtitle || item.description}</p>

            <div class="cf-cta-row">
              {isUnlocked ? (
                <>
                  <a href={`/academy/courses/${item.slug}/slides`} class="btn-primary-cyan">
                    Open Course Slides
                  </a>
                  <a href={`/academy/courses/${item.slug}/slides?print=1`} class="btn-outline-glass">
                    Download PDF
                  </a>
                </>
              ) : (
                <a
                  href={primaryCtaHref}
                  target={primaryCtaExternal ? "_blank" : undefined}
                  rel={primaryCtaExternal ? "noopener noreferrer" : undefined}
                  class="btn-primary-cyan"
                >
                  {item.stripeCheckoutUrl
                    ? `Buy Course ${item.priceLabel ? `— ${item.priceLabel}` : ""}`
                    : "Get Course Access"}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 5l7 7-7 7" />
                  </svg>
                </a>
              )}
              {item.toolUrl && isUnlocked && (
                <a href={item.toolUrl} target="_blank" rel="noopener noreferrer" class="btn-tool-pill">
                  Launch {item.toolName || "Companion Tool"}
                </a>
              )}
            </div>

            {(item.landingData.audience || isEditMode) && (
              <p class="cf-hero-meta">
                Designed for <strong {...ed("landingData.audience")}>{item.landingData.audience || "Creative Teams & Founders"}</strong>
              </p>
            )}
          </div>

          <div class="cf-hero-card">
            <div class="cf-hero-card-media">
              <img src={coverImg} alt={item.title} {...edImg("coverImage")} />
              {isEditMode && (
                <button type="button" class="cf-img-edit-btn" data-target-img="coverImage">Change Image</button>
              )}
              <span class="cf-hero-card-tag">{item.category}</span>
            </div>
            <div class="cf-hero-card-body">
              <div class="cf-hero-card-row">
                <span class="cf-hc-label">Format</span>
                <span class="cf-hc-val">Online Slides + Vector PDF</span>
              </div>
              {item.toolName && (
                <div class="cf-hero-card-row">
                  <span class="cf-hc-label">Included Tool</span>
                  <span class="cf-hc-val cf-cyan">{item.toolName}</span>
                </div>
              )}
              <div class="cf-hero-card-row">
                <span class="cf-hc-label">Price</span>
                <span class="cf-hc-val">{item.priceLabel || "Included"}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. VALUE STRIP -->
    {(vis.valueStrip || isEditMode) && valueStrip.length > 0 && (
      <section class="cf-value-strip is-visible" data-funnel-block="valueStrip" hidden={!vis.valueStrip}>
        <div class="cf-container">
          <div class="cf-strip-bar">
            {valueStrip.map((label, idx) => (
              <div class="cf-strip-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span {...ed(`landingData.funnel.valueStrip.${idx}`)}>{label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 3. BEFORE / AFTER GRID -->
    {(vis.beforeAfter || isEditMode) && (
      <section class="cf-section is-visible" data-funnel-block="beforeAfter" hidden={!vis.beforeAfter}>
        <div class="cf-container">
          <div class="cf-section-head">
            <span class="section-eyebrow" {...ed("landingData.funnel.beforeAfter.eyebrow")}>{beforeAfter.eyebrow}</span>
            <h2 class="section-title" {...ed("landingData.funnel.beforeAfter.title")}>{beforeAfter.title}</h2>
            <p class="section-sub" {...ed("landingData.funnel.beforeAfter.subtitle")}>{beforeAfter.subtitle}</p>
          </div>

          <div class="cf-ba-grid">
            {beforeAfter.beforeItems.slice(0, 3).map((card, idx) => (
              <div class="cf-ba-card cf-ba-before">
                <span class="cf-ba-pill cf-pill-before">Before · 0{idx + 1}</span>
                <h3 {...ed(`landingData.funnel.beforeAfter.beforeItems.${idx}.title`)}>{card.title}</h3>
                <p {...ed(`landingData.funnel.beforeAfter.beforeItems.${idx}.body`)}>{card.body}</p>
              </div>
            ))}
            {beforeAfter.afterItems.slice(0, 3).map((card, idx) => (
              <div class="cf-ba-card cf-ba-after">
                <span class="cf-ba-pill cf-pill-after">After · 0{idx + 1}</span>
                <h3 {...ed(`landingData.funnel.beforeAfter.afterItems.${idx}.title`)}>{card.title}</h3>
                <p {...ed(`landingData.funnel.beforeAfter.afterItems.${idx}.body`)}>{card.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 4. VISUAL SPLIT COMPARISON -->
    {(vis.visualComparison || isEditMode) && (
      <section class="cf-section is-visible" data-funnel-block="visualComparison" hidden={!vis.visualComparison}>
        <div class="cf-container">
          <div class="cf-split-proof">
            <div class="cf-split-copy">
              <span class="section-eyebrow" {...ed("landingData.funnel.visualComparison.eyebrow")}>{visualComparison.eyebrow}</span>
              <h2 class="section-title" {...ed("landingData.funnel.visualComparison.title")}>{visualComparison.title}</h2>
              <p class="section-copy" {...ed("landingData.funnel.visualComparison.body")}>{visualComparison.body}</p>
            </div>
            <div class="cf-split-visual">
              <img src={visualComparison.image} alt={visualComparison.title} {...edImg("landingData.funnel.visualComparison.image")} />
              {isEditMode && (
                <button type="button" class="cf-img-edit-btn" data-target-img="landingData.funnel.visualComparison.image">Change Image</button>
              )}
              <div class="cf-split-badges">
                <span class="cf-badge-dark" {...ed("landingData.funnel.visualComparison.beforeLabel")}>{visualComparison.beforeLabel}</span>
                <span class="cf-badge-cyan" {...ed("landingData.funnel.visualComparison.afterLabel")}>{visualComparison.afterLabel}</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 5. CORE METHOD PILLARS -->
    {(vis.pillars || isEditMode) && pillars.items.length > 0 && (
      <section class="cf-section is-visible" data-funnel-block="pillars" hidden={!vis.pillars}>
        <div class="cf-container">
          <div class="cf-section-head">
            <span class="section-eyebrow" {...ed("landingData.funnel.pillars.eyebrow")}>{pillars.eyebrow}</span>
            <h2 class="section-title" {...ed("landingData.funnel.pillars.title")}>{pillars.title}</h2>
            <p class="section-sub" {...ed("landingData.funnel.pillars.subtitle")}>{pillars.subtitle}</p>
          </div>

          <div class="cf-pillars-grid">
            {pillars.items.slice(0, 6).map((pillar, idx) => (
              <div class="cf-pillar-card">
                <span class="cf-pillar-num">0{idx + 1}</span>
                <h3 {...ed(`landingData.funnel.pillars.items.${idx}.title`)}>{pillar.title}</h3>
                <p {...ed(`landingData.funnel.pillars.items.${idx}.body`)}>{pillar.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 6. SYSTEM / WORKFLOW SHOWCASE -->
    {(vis.systemShowcase || isEditMode) && (
      <section class="cf-section is-visible" data-funnel-block="systemShowcase" hidden={!vis.systemShowcase}>
        <div class="cf-container">
          <div class="cf-section-head">
            <span class="section-eyebrow" {...ed("landingData.funnel.systemShowcase.eyebrow")}>{systemShowcase.eyebrow}</span>
            <h2 class="section-title" {...ed("landingData.funnel.systemShowcase.title")}>{systemShowcase.title}</h2>
            <p class="section-sub" {...ed("landingData.funnel.systemShowcase.subtitle")}>{systemShowcase.subtitle}</p>
          </div>

          <div class="cf-showcase-frame">
            <div class="cf-showcase-topbar">
              <span class="cf-dot"></span>
              <span class="cf-dot"></span>
              <span class="cf-dot"></span>
              <span class="cf-showcase-url">{item.title}</span>
            </div>
            <div class="cf-showcase-media">
              <img src={systemShowcase.image} alt={systemShowcase.title} {...edImg("landingData.funnel.systemShowcase.image")} />
              {isEditMode && (
                <button type="button" class="cf-img-edit-btn" data-target-img="landingData.funnel.systemShowcase.image">Change Image</button>
              )}
            </div>
            {(systemShowcase.caption || isEditMode) && (
              <p class="cf-showcase-caption" {...ed("landingData.funnel.systemShowcase.caption")}>{systemShowcase.caption}</p>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- 7. INTERACTIVE TABBED EXPLORER -->
    {(vis.explorer || isEditMode) && explorer.tabs.length > 0 && (
      <section class="cf-section is-visible" data-funnel-block="explorer" hidden={!vis.explorer}>
        <div class="cf-container">
          <div class="cf-section-head">
            <span class="section-eyebrow" {...ed("landingData.funnel.explorer.eyebrow")}>{explorer.eyebrow}</span>
            <h2 class="section-title" {...ed("landingData.funnel.explorer.title")}>{explorer.title}</h2>
            <p class="section-sub" {...ed("landingData.funnel.explorer.subtitle")}>{explorer.subtitle}</p>
          </div>

          <div class="cf-explorer-tabs" role="tablist">
            {explorer.tabs.map((tab, idx) => (
              <button
                type="button"
                class={`cf-tab-btn ${idx === 0 ? "is-active" : ""}`}
                data-tab-index={idx}
              >
                <span {...ed(`landingData.funnel.explorer.tabs.${idx}.label`)}>{tab.label}</span>
              </button>
            ))}
          </div>

          <div class="cf-explorer-panels">
            {explorer.tabs.map((tab, idx) => (
              <div class={`cf-explorer-panel ${idx === 0 ? "is-active" : ""}`} data-panel-index={idx} hidden={idx !== 0}>
                <div class="cf-explorer-img">
                  <img src={tab.image || coverImg} alt={tab.title} {...edImg(`landingData.funnel.explorer.tabs.${idx}.image`)} />
                  {isEditMode && (
                    <button type="button" class="cf-img-edit-btn" data-target-img={`landingData.funnel.explorer.tabs.${idx}.image`}>Change Image</button>
                  )}
                </div>
                <div class="cf-explorer-info">
                  <h3 {...ed(`landingData.funnel.explorer.tabs.${idx}.title`)}>{tab.title}</h3>
                  <p {...ed(`landingData.funnel.explorer.tabs.${idx}.body`)}>{tab.body}</p>
                  <div class="cf-specs-grid">
                    {(tab.specs || []).slice(0, 4).map((spec, sIdx) => (
                      <div class="cf-spec-box">
                        <span class="cf-spec-label" {...ed(`landingData.funnel.explorer.tabs.${idx}.specs.${sIdx}.label`)}>{spec.label}</span>
                        <span class="cf-spec-val" {...ed(`landingData.funnel.explorer.tabs.${idx}.specs.${sIdx}.value`)}>{spec.value}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 8. COMPANION TOOL SPOTLIGHT -->
    {(vis.toolSpotlight || isEditMode) && (item.toolName || item.toolUrl) && (
      <section class="cf-section is-visible" data-funnel-block="toolSpotlight" hidden={!vis.toolSpotlight}>
        <div class="cf-container">
          <div class="tool-spotlight-card">
            <div>
              <span class="section-eyebrow">Included With This Course</span>
              <h2 class="tool-title">{item.toolName || "Companion Tool & Template"}</h2>
              <p class="tool-desc">
                {item.toolType ? `${item.toolType} · ` : ""}Ready-to-use asset built specifically to apply the workflows in this course immediately.
              </p>
            </div>
            {isUnlocked && item.toolUrl ? (
              <a href={item.toolUrl} target="_blank" rel="noopener noreferrer" class="btn-primary-cyan">
                Open {item.toolType || "Tool"}
              </a>
            ) : (
              <span class="tool-locked-pill">Included upon purchase</span>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- 9. CURRICULUM MICRO-GRID -->
    {(vis.curriculum || isEditMode) && curriculum.modules.length > 0 && (
      <section class="cf-section is-visible" data-funnel-block="curriculum" hidden={!vis.curriculum}>
        <div class="cf-container">
          <div class="cf-section-head">
            <span class="section-eyebrow" {...ed("landingData.funnel.curriculum.eyebrow")}>{curriculum.eyebrow}</span>
            <h2 class="section-title" {...ed("landingData.funnel.curriculum.title")}>{curriculum.title}</h2>
            <p class="section-sub" {...ed("landingData.funnel.curriculum.subtitle")}>{curriculum.subtitle}</p>
          </div>

          <div class="curriculum-grid">
            {curriculum.modules.map((mod, idx) => (
              <div class="curriculum-card">
                <span class="curr-num" {...ed(`landingData.funnel.curriculum.modules.${idx}.tag`)}>{mod.tag || `0${idx + 1}`}</span>
                <h3 class="curr-title" {...ed(`landingData.funnel.curriculum.modules.${idx}.title`)}>{mod.title}</h3>
                {(mod.body || isEditMode) && (
                  <p class="curr-body" {...ed(`landingData.funnel.curriculum.modules.${idx}.body`)}>{mod.body}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 10. TARGET OUTCOMES SPLIT -->
    {(vis.outcomes || isEditMode) && outcomes.bullets.length > 0 && (
      <section class="cf-section is-visible" data-funnel-block="outcomes" hidden={!vis.outcomes}>
        <div class="cf-container">
          <div class="cf-outcomes-split">
            <div class="cf-outcomes-copy">
              <span class="section-eyebrow" {...ed("landingData.funnel.outcomes.eyebrow")}>{outcomes.eyebrow}</span>
              <h2 class="section-title" {...ed("landingData.funnel.outcomes.title")}>{outcomes.title}</h2>
              <p class="section-sub" {...ed("landingData.funnel.outcomes.subtitle")}>{outcomes.subtitle}</p>
              <div class="cf-outcomes-list">
                {outcomes.bullets.map((b, idx) => (
                  <div class="cf-outcome-item">
                    <span class="cf-outcome-check" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                      </svg>
                    </span>
                    <div>
                      <h4 {...ed(`landingData.funnel.outcomes.bullets.${idx}.title`)}>{b.title}</h4>
                      <p {...ed(`landingData.funnel.outcomes.bullets.${idx}.body`)}>{b.body}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="cf-outcomes-visual">
              <img src={outcomes.image} alt={outcomes.title} {...edImg("landingData.funnel.outcomes.image")} />
              {isEditMode && (
                <button type="button" class="cf-img-edit-btn" data-target-img="landingData.funnel.outcomes.image">Change Image</button>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 11. DELIVERABLES 4-CARD GRID -->
    {(vis.deliverables || isEditMode) && deliverables.items.length > 0 && (
      <section class="cf-section is-visible" data-funnel-block="deliverables" hidden={!vis.deliverables}>
        <div class="cf-container">
          <div class="cf-section-head">
            <span class="section-eyebrow" {...ed("landingData.funnel.deliverables.eyebrow")}>{deliverables.eyebrow}</span>
            <h2 class="section-title" {...ed("landingData.funnel.deliverables.title")}>{deliverables.title}</h2>
          </div>
          <div class="cf-deliverables-grid">
            {deliverables.items.slice(0, 4).map((deliv, idx) => (
              <div class="cf-deliv-card">
                <span class="cf-deliv-badge" {...ed(`landingData.funnel.deliverables.items.${idx}.badge`)}>{deliv.badge}</span>
                <h3 {...ed(`landingData.funnel.deliverables.items.${idx}.title`)}>{deliv.title}</h3>
                <p {...ed(`landingData.funnel.deliverables.items.${idx}.body`)}>{deliv.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 12. CLOSING CONVERSION BANNER -->
    {(vis.closingCta || isEditMode) && (
      <section class="cf-section is-visible" id="course-enroll" data-funnel-block="closingCta" hidden={!vis.closingCta}>
        <div class="cf-container">
          <div class="cf-closing-card">
            <div class="cf-closing-visual">
              <img src={closingCta.image} alt={item.title} {...edImg("landingData.funnel.closingCta.image")} />
              {isEditMode && (
                <button type="button" class="cf-img-edit-btn" data-target-img="landingData.funnel.closingCta.image">Change Image</button>
              )}
            </div>
            <div class="cf-closing-copy">
              <span class="section-eyebrow" {...ed("landingData.funnel.closingCta.eyebrow")}>{closingCta.eyebrow}</span>
              <h2 class="cf-closing-title" {...ed("landingData.funnel.closingCta.title")}>{closingCta.title}</h2>
              <p class="cf-closing-body" {...ed("landingData.funnel.closingCta.body")}>{closingCta.body}</p>
              <ul class="cf-closing-list">
                {closingCta.checklist.map((line, idx) => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    <span {...ed(`landingData.funnel.closingCta.checklist.${idx}`)}>{line}</span>
                  </li>
                ))}
              </ul>
              <div class="cf-closing-actions">
                {isUnlocked ? (
                  <>
                    <a href={`/academy/courses/${item.slug}/slides`} class="btn-primary-cyan">
                      Open Course Slides
                    </a>
                    <a href={`/academy/courses/${item.slug}/slides?print=1`} class="btn-outline-glass">
                      Download PDF
                    </a>
                  </>
                ) : item.stripeCheckoutUrl ? (
                  <a
                    href={item.stripeCheckoutUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary-cyan"
                  >
                    Buy Course {item.priceLabel ? `— ${item.priceLabel}` : ""}
                  </a>
                ) : (
                  <span class="tool-locked-pill">Stripe Checkout URL not configured yet</span>
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 13. FAQ ACCORDION -->
    {(vis.faq || isEditMode) && item.landingData.faq.length > 0 && (
      <section class="cf-section is-visible" data-funnel-block="faq" hidden={!vis.faq}>
        <div class="cf-container">
          <div class="cf-section-head">
            <span class="section-eyebrow">Questions &amp; Answers</span>
            <h2 class="section-title">Frequently Asked Questions</h2>
          </div>
          <div class="faq-list">
            {item.landingData.faq.map((entry, idx) => (
              <details class="faq-card" open={idx === 0 || isEditMode}>
                <summary>
                  <span {...ed(`landingData.faq.${idx}.q`)}>{entry.q}</span>
                  <span class="faq-plus" aria-hidden="true">+</span>
                </summary>
                <p {...ed(`landingData.faq.${idx}.a`)}>{entry.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  {isEditMode && (
    <>
      <div class="cf-blocks-drawer" id="cf-blocks-drawer" hidden>
        <div class="cf-blocks-drawer-head">
          <div>
            <span class="cf-blocks-eyebrow">LANDING FUNNEL SECTIONS</span>
            <h3>Show or Hide Funnel Blocks</h3>
          </div>
          <div class="cf-blocks-quick">
            <button type="button" class="cf-edit-btn-glass" id="cf-blocks-all-on">All On</button>
            <button type="button" class="cf-edit-btn-glass" id="cf-blocks-minimal">Essential Only</button>
            <button type="button" class="cf-edit-btn-glass" id="cf-blocks-close" aria-label="Close">✕</button>
          </div>
        </div>
        <div class="cf-blocks-grid">
          {FUNNEL_BLOCKS.map((block) => (
            <label class="cf-block-row">
              <div class="cf-block-meta">
                <strong>{block.label}</strong>
                <span>{block.hint}</span>
              </div>
              <span class="cf-block-switch">
                <input
                  type="checkbox"
                  class="cf-block-chk"
                  data-funnel-key={block.key}
                  checked={vis[block.key] !== false}
                />
                <span class="cf-block-slider"></span>
              </span>
            </label>
          ))}
        </div>
      </div>

      <div class="cf-edit-bar" id="cf-edit-bar">
        <div class="cf-edit-status">
          <span class="cf-edit-dot"></span>
          <span>Edit Mode · Click any text or image to edit</span>
        </div>
        <div class="cf-edit-actions">
          <button type="button" class="cf-edit-btn-glass" id="cf-toggle-blocks">Funnel Blocks</button>
          <a href="/studio-adaptif-9x4k" class="cf-edit-btn-glass">← Preferences</a>
          <a href={`/academy/courses/${item.slug}`} class="cf-edit-btn-glass">Exit Edit Mode</a>
          <button type="button" class="cf-edit-btn-cyan" id="cf-save-front-edits">Save Changes</button>
        </div>
      </div>

      <div class="cf-img-modal-backdrop" id="cf-img-modal" hidden role="dialog" aria-modal="true">
        <div class="cf-img-modal-card">
          <h3>Update Image</h3>
          <p class="cf-img-modal-sub">Upload a new image or paste an image URL below.</p>
          <label class="cf-img-field">
            <span>Image URL</span>
            <input type="text" id="cf-img-url-input" placeholder="/images/..." />
          </label>
          <div class="cf-img-upload-row">
            <label class="cf-edit-btn-glass cf-upload-btn">
              Upload File
              <input type="file" id="cf-img-file-input" accept="image/*" hidden />
            </label>
            <span class="cf-img-upload-status" id="cf-img-upload-status"></span>
          </div>
          <div class="cf-img-modal-actions">
            <button type="button" class="cf-edit-btn-glass" id="cf-img-cancel">Cancel</button>
            <button type="button" class="cf-edit-btn-cyan" id="cf-img-apply">Apply Image</button>
          </div>
        </div>
      </div>

      <div class="cf-edit-toast" id="cf-edit-toast" hidden>Changes saved!</div>

      <script
        type="application/json"
        id="cf-edit-seed"
        set:html={JSON.stringify({
          id: item.id,
          slug: item.slug,
          title: item.title,
          subtitle: item.subtitle || item.description,
          coverImage: coverImg,
          landingData: {
            ...item.landingData,
            funnel: {
              valueStrip,
              beforeAfter,
              visualComparison,
              pillars,
              systemShowcase,
              explorer,
              curriculum,
              outcomes,
              deliverables,
              closingCta
            }
          }
        })}
      />
    </>
  )}
  <Footer />
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".cf-tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const idx = btn.dataset.tabIndex;
      document.querySelectorAll(".cf-tab-btn").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      document.querySelectorAll<HTMLElement>(".cf-explorer-panel").forEach((panel) => {
        const match = panel.dataset.panelIndex === idx;
        panel.hidden = !match;
        panel.classList.toggle("is-active", match);
      });
    });
  });

  // Frontend Edit Mode (?edit=1)
  (() => {
    const seedEl = document.getElementById("cf-edit-seed");
    if (!seedEl) return;

    const seed = JSON.parse(seedEl.textContent || "{}");
    const imgModal = document.getElementById("cf-img-modal");
    const imgUrlInput = document.getElementById("cf-img-url-input") as HTMLInputElement | null;
    const imgFileInput = document.getElementById("cf-img-file-input") as HTMLInputElement | null;
    const imgUploadStatus = document.getElementById("cf-img-upload-status");
    const saveBtn = document.getElementById("cf-save-front-edits") as HTMLButtonElement | null;
    const toastEl = document.getElementById("cf-edit-toast");

    let activeImgField: string | null = null;

    function showToast(msg: string) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.hidden = false;
      setTimeout(() => {
        if (toastEl) toastEl.hidden = true;
      }, 2600);
    }

    function setByPath(obj: any, path: string, value: string) {
      const parts = path.split(".");
      let cur = obj;
      for (let i = 0; i < parts.length - 1; i++) {
        const key = parts[i];
        const nextKey = parts[i + 1];
        const isNextIndex = /^\d+$/.test(nextKey);
        if (cur[key] === undefined || cur[key] === null) {
          cur[key] = isNextIndex ? [] : {};
        }
        cur = cur[key];
      }
      cur[parts[parts.length - 1]] = value;
    }

    // Prevent <details> summary toggle when clicking editable text inside FAQ summary
    document.querySelectorAll<HTMLElement>(".faq-card summary [contenteditable]").forEach((el) => {
      el.addEventListener("click", (e) => e.stopPropagation());
    });

    // Image edit triggers
    document.querySelectorAll<HTMLButtonElement>(".cf-img-edit-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const field = btn.dataset.targetImg || "";
        const imgEl = document.querySelector<HTMLImageElement>(`[data-edit-image="${field}"]`);
        activeImgField = field;
        if (imgUrlInput) imgUrlInput.value = imgEl?.getAttribute("src") || "";
        if (imgUploadStatus) imgUploadStatus.textContent = "";
        if (imgModal) imgModal.hidden = false;
      });
    });

    imgFileInput?.addEventListener("change", async () => {
      const file = imgFileInput.files?.[0];
      if (!file) return;
      if (imgUploadStatus) imgUploadStatus.textContent = "Uploading...";
      const fd = new FormData();
      fd.append("file", file);
      try {
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (res.ok && data.url && imgUrlInput) {
          imgUrlInput.value = data.url;
          if (imgUploadStatus) imgUploadStatus.textContent = "Uploaded!";
        } else {
          if (imgUploadStatus) imgUploadStatus.textContent = data?.error || "Upload failed";
        }
      } catch {
        if (imgUploadStatus) imgUploadStatus.textContent = "Upload failed";
      }
      imgFileInput.value = "";
    });

    document.getElementById("cf-img-cancel")?.addEventListener("click", () => {
      if (imgModal) imgModal.hidden = true;
      activeImgField = null;
    });

    imgModal?.addEventListener("click", (e) => {
      if (e.target === imgModal) {
        imgModal.hidden = true;
        activeImgField = null;
      }
    });

    document.getElementById("cf-img-apply")?.addEventListener("click", () => {
      if (!activeImgField || !imgUrlInput) return;
      const newUrl = imgUrlInput.value.trim();
      if (newUrl) {
        const imgEl = document.querySelector<HTMLImageElement>(`[data-edit-image="${activeImgField}"]`);
        if (imgEl) imgEl.src = newUrl;
        setByPath(seed, activeImgField, newUrl);
      }
      if (imgModal) imgModal.hidden = true;
      activeImgField = null;
    });

    const toggleBlocksBtn = document.getElementById("cf-toggle-blocks");
    const blocksDrawer = document.getElementById("cf-blocks-drawer");
    const blocksCloseBtn = document.getElementById("cf-blocks-close");
    const blocksAllOnBtn = document.getElementById("cf-blocks-all-on");
    const blocksMinimalBtn = document.getElementById("cf-blocks-minimal");

    function syncBlockVisibilityFromCheckboxes() {
      const funnelVisibility: Record<string, boolean> = {};
      document.querySelectorAll<HTMLInputElement>(".cf-block-chk").forEach((chk) => {
        const key = chk.dataset.funnelKey || "";
        if (!key) return;
        funnelVisibility[key] = chk.checked;
        const sec = document.querySelector<HTMLElement>(`[data-funnel-block="${key}"]`);
        if (sec) sec.hidden = !chk.checked;
      });
      seed.landingData = {
        ...(seed.landingData || {}),
        funnelVisibility
      };
    }

    toggleBlocksBtn?.addEventListener("click", () => {
      if (!blocksDrawer) return;
      blocksDrawer.hidden = !blocksDrawer.hidden;
    });

    blocksCloseBtn?.addEventListener("click", () => {
      if (blocksDrawer) blocksDrawer.hidden = true;
    });

    document.querySelectorAll<HTMLInputElement>(".cf-block-chk").forEach((chk) => {
      chk.addEventListener("change", syncBlockVisibilityFromCheckboxes);
    });

    blocksAllOnBtn?.addEventListener("click", () => {
      document.querySelectorAll<HTMLInputElement>(".cf-block-chk").forEach((chk) => {
        chk.checked = true;
      });
      syncBlockVisibilityFromCheckboxes();
    });

    blocksMinimalBtn?.addEventListener("click", () => {
      const essential = new Set(["valueStrip", "toolSpotlight", "curriculum", "deliverables", "closingCta", "faq"]);
      document.querySelectorAll<HTMLInputElement>(".cf-block-chk").forEach((chk) => {
        chk.checked = essential.has(chk.dataset.funnelKey || "");
      });
      syncBlockVisibilityFromCheckboxes();
    });

    saveBtn?.addEventListener("click", async () => {
      if (!saveBtn) return;
      saveBtn.disabled = true;
      const prevLabel = saveBtn.textContent;
      saveBtn.textContent = "Saving...";

      syncBlockVisibilityFromCheckboxes();

      document.querySelectorAll<HTMLElement>("[data-edit-field]").forEach((node) => {
        const path = node.dataset.editField;
        if (!path) return;
        setByPath(seed, path, node.innerText.trim());
      });

      document.querySelectorAll<HTMLImageElement>("[data-edit-image]").forEach((img) => {
        const path = img.dataset.editImage;
        if (!path) return;
        setByPath(seed, path, img.getAttribute("src") || "");
      });

      try {
        const res = await fetch(`/api/academy/items/${seed.id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            title: seed.title,
            subtitle: seed.subtitle,
            coverImage: seed.coverImage,
            landingData: seed.landingData
          })
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err?.error || "Save failed");
        }
        showToast("Changes saved!");
      } catch (err: any) {
        showToast(err?.message || "Failed to save changes");
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = prevLabel || "Save Changes";
      }
    });
  })();
</script>

<style>
