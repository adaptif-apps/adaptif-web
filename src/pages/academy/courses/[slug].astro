    --bg-void: var(--color-void, #010307);
    --cyan-primary: var(--color-brand-cyan, #48c8ff);
    --cyan-soft: #9ce1ff;
    --text-primary: var(--color-text-primary, #f8fafc);
    --text-secondary: var(--color-text-secondary, #94a3b8);
    --text-muted: var(--color-text-muted, #64748b);
    padding-top: 108px;
    padding-bottom: 90px;
    background: var(--bg-void);
    min-height: 100vh;
  }

  .cf-container {
    width: min(1180px, 92vw);
    margin: 0 auto;
  }

  .cf-breadcrumb {
