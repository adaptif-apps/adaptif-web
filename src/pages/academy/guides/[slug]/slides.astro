---
import Layout from "../../../../layouts/Layout.astro";
import AcademySlideViewer from "../../../../components/AcademySlideViewer.astro";
import {
  buildSlidesFromLanding,
  getAcademyItemBySlug,
  verifyAccessToken,
} from "../../../../lib/academyDb";

export const prerender = false;

const slug = Astro.params.slug || "";
const item = await getAcademyItemBySlug(slug, "guide", false);

if (!item) {
  return Astro.redirect("/academy/guides");
}

const queryToken = Astro.url.searchParams.get("access");
const cookieToken = Astro.cookies.get(`adaptif_academy_${item.slug}`)?.value;
const token = queryToken || cookieToken || "";
const isUnlocked = token ? await verifyAccessToken(item.id, token) : false;

const isPreview = Astro.url.searchParams.get("preview") === "1";
const isEditMode = Astro.url.searchParams.get("edit") === "1";

if (!isUnlocked && !isPreview && !isEditMode) {
  return Astro.redirect(`/academy/guides/${item.slug}#unlock-form`);
}

if (queryToken) {
  Astro.cookies.set(`adaptif_academy_${item.slug}`, queryToken, {
    path: "/",
    httpOnly: true,
    sameSite: "lax",
    maxAge: 60 * 60 * 24 * 30
  });
}

const autoPrint = Astro.url.searchParams.get("print") === "1";
const derivedItem = {
  ...item,
  slides: Array.isArray(item.slides) && item.slides.length > 0 ? item.slides : buildSlidesFromLanding(item),
};
---

<Layout title={`${item.title} — Slides | Adaptif Academy`} description={item.subtitle || item.description}>
  <AcademySlideViewer
    item={derivedItem}
    backHref={`/academy/guides/${item.slug}`}
    autoPrint={autoPrint}
    isEditMode={isEditMode}
    isPreview={isPreview}
  />
</Layout>
