---
import Layout from "../../../../layouts/Layout.astro";
import AcademySlideViewer from "../../../../components/AcademySlideViewer.astro";
import { getAcademyItemBySlug, verifyAccessToken } from "../../../../lib/academyDb";

export const prerender = false;

const slug = Astro.params.slug || "";
const item = await getAcademyItemBySlug(slug, "guide", false);

if (!item) {
  return Astro.redirect("/academy/guides");
}

const queryToken = Astro.url.searchParams.get("access");
const cookieToken = Astro.cookies.get(`adaptif_academy_${item.slug}`)?.value;
const token = queryToken || cookieToken || "";
const isUnlocked = await verifyAccessToken(item.id, token);

if (!isUnlocked) {
  return Astro.redirect(`/academy/guides/${item.slug}#unlock-form`);
}

if (queryToken) {
  Astro.cookies.set(`adaptif_academy_${item.slug}`, queryToken, {
    path: "/",
    httpOnly: true,
    sameSite: "lax",
    maxAge: 60 * 60 * 24 * 30
  });
}

const autoPrint = Astro.url.searchParams.get("print") === "1";
---

<Layout title={`${item.title} — Slides | Adaptif Academy`} description={item.subtitle || item.description}>
  <AcademySlideViewer item={item} backHref={`/academy/guides/${item.slug}`} autoPrint={autoPrint} />
</Layout>
