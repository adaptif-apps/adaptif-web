---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getBlogPostBySlug } from "../../lib/blogDb";
import { getAcademyItemBySlug } from "../../lib/academyDb";
import { hasValidStudioSession } from "../../lib/studioAuth";

export const prerender = false;

const slug = Astro.params.slug || "";
const isStudio = hasValidStudioSession(Astro.cookies);
const post = await getBlogPostBySlug(slug, isStudio);

if (!post) {
  return Astro.redirect("/blog");
}

function toEmbedUrl(raw: string): { kind: "iframe" | "video" | "none"; url: string } {
  const u = (raw || "").trim();
  if (!u) return { kind: "none", url: "" };
  const ytMatch = u.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([A-Za-z0-9_-]{6,})/);
  if (ytMatch) {
    return { kind: "iframe", url: `https://www.youtube.com/embed/${ytMatch[1]}` };
  }
  const vimeoMatch = u.match(/vimeo\.com\/(\d+)/);
  if (vimeoMatch) {
    return { kind: "iframe", url: `https://player.vimeo.com/video/${vimeoMatch[1]}` };
  }
  if (/\.(mp4|webm|ogg)(\?|$)/i.test(u)) {
    return { kind: "video", url: u };
  }
  return { kind: "iframe", url: u };
}

// Resolve linked Guide or Course for Upsell Banner
let linkedItem: any = null;
if (post.upsell?.enabled && post.upsell.targetSlug && (post.upsell.kind === "guide" || post.upsell.kind === "course")) {
  linkedItem = await getAcademyItemBySlug(post.upsell.targetSlug, post.upsell.kind, isStudio);
}

const upsellEyebrow =
  post.upsell?.eyebrow ||
  (post.upsell?.kind === "course"
    ? "FEATURED PRO COURSE"
    : post.upsell?.kind === "guide"
      ? "FREE TACTICAL GUIDE"
      : "ADAPTIF SUBSCRIPTION");

const upsellTitle =
  post.upsell?.title ||
  linkedItem?.title ||
  `Scale faster with ${post.upsell?.planName || "Adaptif"}`;

const upsellDesc =
  post.upsell?.description ||
  linkedItem?.subtitle ||
  linkedItem?.description ||
  "Plug an AI-driven creative department into your team with unlimited requests and 48-hour turnarounds.";

const upsellHref =
  post.upsell?.ctaHref ||
  (linkedItem
    ? `/academy/${post.upsell.kind === "course" ? "courses" : "guides"}/${linkedItem.slug}`
    : "/pricing");

const upsellCta =
  post.upsell?.ctaLabel ||
  (post.upsell?.kind === "course"
    ? "Explore Course"
    : post.upsell?.kind === "guide"
      ? "Get Free Guide"
      : "View Plans");
---

<Layout title={`${post.title} — Adaptif Blog`} description={post.excerpt || post.subtitle}>
  <Header />
  <main class="blog-post-main">
    <article class="blog-article">
      <header class="blog-post-header">
        <div class="container blog-narrow">
          <div class="blog-breadcrumb">
            <a href="/blog">← Back to Blog</a>
            <span>•</span>
            <span class="adaptif-tag adaptif-tag--cyan">{post.category}</span>
            <span>•</span>
            <span>{post.readTime}</span>
          </div>

          <span class="adaptif-eyebrow" data-cms-key={`blog.${post.slug}.eyebrow`}>
            {post.eyebrow || post.category}
          </span>
          <h1 class="blog-post-title" data-cms-key={`blog.${post.slug}.title`}>
            {post.title}
          </h1>
          {post.subtitle && (
            <p class="blog-post-subtitle" data-cms-key={`blog.${post.slug}.subtitle`}>
              {post.subtitle}
            </p>
          )}
          <div class="blog-author-row">
            <span>By <strong>{post.authorName || "Adaptif Team"}</strong></span>
          </div>

          {post.coverImage && (
            <div class="blog-cover-wrap">
              <img src={post.coverImage} alt={post.title} data-cms-key={`blog.${post.slug}.cover`} />
            </div>
          )}
        </div>
      </header>

      <div class="container blog-narrow blog-sections-stack">
        {post.sections.map((section) => (
          <section class:list={["blog-section is-visible", `cols-${section.columnsCount}`]}>
            {section.columns.map((col) => (
              <div class="blog-col">
                {col.type === "text" && (
                  <div class="blog-text-col">
                    {(col.blocks || []).map((blk) => {
                      if (!blk.text) return null;
                      if (blk.format === "eyebrow") {
                        return <span class="adaptif-eyebrow">{blk.text}</span>;
                      }
                      if (blk.format === "title") {
                        return <h2 class="blog-blk-title">{blk.text}</h2>;
                      }
                      if (blk.format === "title_highlight") {
                        return <h2 class="blog-blk-title title-highlight">{blk.text}</h2>;
                      }
                      if (blk.format === "subtitle") {
                        return <h3 class="blog-blk-subtitle">{blk.text}</h3>;
                      }
                      if (blk.format === "quote") {
                        return <blockquote class="blog-blk-quote">{blk.text}</blockquote>;
                      }
                      return <p class="blog-blk-paragraph">{blk.text}</p>;
                    })}
                  </div>
                )}

                {col.type === "image" && (
                  <figure class="blog-media-col">
                    {col.imageUrl ? (
                      <img src={col.imageUrl} alt={col.imageAlt || col.caption || post.title} loading="lazy" />
                    ) : (
                      <div class="blog-media-placeholder">Image slot</div>
                    )}
                    {col.caption && <figcaption>{col.caption}</figcaption>}
                  </figure>
                )}

                {col.type === "video" && (
                  <figure class="blog-media-col">
                    {(() => {
                      const vid = toEmbedUrl(col.videoUrl || "");
                      if (vid.kind === "video") {
                        return <video src={vid.url} controls playsinline class="blog-video-el"></video>;
                      }
                      if (vid.kind === "iframe") {
                        return (
                          <div class="blog-video-frame">
                            <iframe
                              src={vid.url}
                              title={col.caption || "Embedded video"}
                              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                              allowfullscreen
                            ></iframe>
                          </div>
                        );
                      }
                      return <div class="blog-media-placeholder">No video URL set</div>;
                    })()}
                    {col.caption && <figcaption>{col.caption}</figcaption>}
                  </figure>
                )}
              </div>
            ))}
          </section>
        ))}

        {post.upsell?.enabled && (
          <aside class="glass-panel blog-upsell-banner">
            <div class="blog-upsell-copy">
              <span class="adaptif-eyebrow">{upsellEyebrow}</span>
              <h2 class="blog-upsell-title">{upsellTitle}</h2>
              <p class="blog-upsell-desc">{upsellDesc}</p>
            </div>
            <div class="blog-upsell-actions">
              <a href={upsellHref} class="adaptif-btn">
                <span>{upsellCta}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </aside>
        )}
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .blog-post-main {
    padding-top: 130px;
    padding-bottom: 90px;
  }

  .blog-narrow {
    max-width: 960px;
  }

  .blog-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 0.84rem;
    color: var(--color-text-secondary);
    margin-bottom: 22px;
  }

  .blog-breadcrumb a:hover {
    color: #48c8ff;
  }

  .blog-post-title {
    margin: 12px 0 16px;
    font-size: clamp(2.4rem, 4.6vw, 3.8rem);
    line-height: 1.05;
  }

  .blog-post-subtitle {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin-bottom: 18px;
  }

  .blog-author-row {
    font-size: 0.86rem;
    color: var(--color-text-secondary);
    margin-bottom: 30px;
  }

  .blog-author-row strong {
    color: #ffffff;
  }

  .blog-cover-wrap {
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    aspect-ratio: 16 / 9;
    margin-bottom: 48px;
    box-shadow: var(--shadow-bevel-card);
  }

  .blog-cover-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-sections-stack {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  .blog-section {
    display: grid;
    gap: 28px;
    align-items: start;
  }

  .blog-section.cols-1 {
    grid-template-columns: 1fr;
  }

  .blog-section.cols-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .blog-section.cols-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .blog-text-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .blog-blk-title {
    font-size: clamp(1.85rem, 3vw, 2.55rem);
    line-height: 1.08;
  }

  .blog-blk-subtitle {
    font-family: var(--font-family-body);
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .blog-blk-paragraph {
    font-size: 1.02rem;
    line-height: 1.72;
    color: rgba(248, 250, 252, 0.82);
  }

  .blog-blk-quote {
    margin: 6px 0;
    padding: 16px 20px;
    border-left: 3px solid #48c8ff;
    background: rgba(56, 189, 248, 0.08);
    border-radius: 0 12px 12px 0;
    font-family: var(--font-family-display);
    font-size: 1.45rem;
    line-height: 1.3;
    color: #e0f2fe;
  }

  .blog-media-col {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .blog-media-col img,
  .blog-video-el {
    width: 100%;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .blog-video-frame {
    position: relative;
    padding-top: 56.25%;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #050811;
  }

  .blog-video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .blog-media-col figcaption {
    font-size: 0.84rem;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .blog-media-placeholder {
    padding: 48px 20px;
    border-radius: 16px;
    border: 1.5px dashed rgba(72, 200, 255, 0.3);
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  .blog-upsell-banner {
    margin-top: 16px;
    padding: 32px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    background:
      radial-gradient(circle at 0% 0%, rgba(72, 200, 255, 0.18), transparent 55%),
      linear-gradient(135deg, rgba(16, 28, 52, 0.9), rgba(7, 12, 24, 0.96));
    border: 1px solid rgba(72, 200, 255, 0.32);
  }

  .blog-upsell-copy {
    flex: 1;
    min-width: 260px;
  }

  .blog-upsell-title {
    margin: 10px 0 8px;
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    line-height: 1.12;
  }

  .blog-upsell-desc {
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  @media (max-width: 820px) {
    .blog-section.cols-2,
    .blog-section.cols-3 {
      grid-template-columns: 1fr;
    }
  }
</style>
