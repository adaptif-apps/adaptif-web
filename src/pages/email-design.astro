---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import EmailHero from "../components/EmailHero.astro";
import BrandLogos from "../components/BrandLogos.astro";
import EmailOverviewAndOffer from "../components/EmailOverviewAndOffer.astro";
import EmailWorkflowAndBottom from "../components/EmailWorkflowAndBottom.astro";
import FaqSection, { type FaqItem } from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";

export const prerender = false;

if (Astro.url.searchParams.get("edit") !== "1") {
  Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");
}

const emailFaqs: FaqItem[] = [
  {
    question: "Are email design services included in all Adaptif subscriptions?",
    answer:
      "Yes! All Adaptif subscriptions include access to email design, enabling you to launch email design projects in under 24 hours alongside social media content, motion design, and campaign development.",
  },
  {
    question: "What are the benefits of great email design?",
    answer:
      "Great email design enhances brand perception, builds trust, improves readability, and drives higher click-through rates and conversions—maximizing your overall email marketing ROI.",
  },
  {
    question: "What type of customers use our email design services?",
    answer:
      "Scale-ups and enterprise marketing, brand, and lifecycle teams rely on Adaptif to expand capacity and free up in-house designers for larger strategic initiatives.",
  },
  {
    question: "Why is Adaptif better than other email design services?",
    answer:
      "Adaptif provides always-on access to an elastic creative team that deeply understands your brand, combining creative craft, brand expertise, and managed execution directly in your email platforms.",
  },
  {
    question: "Do you do custom email design plans?",
    answer:
      "Yes, we offer custom capacity for larger or more complex email production needs, while every plan gives you full access to all Adaptif creative services.",
  },
  {
    question: "What is email graphic design?",
    answer:
      "Email graphic design combines layout, color, typography, and imagery to deliver responsive, visually compelling messages that stand out in crowded inboxes and drive action.",
  },
  {
    question: "What makes for a good email design?",
    answer:
      "Clear hierarchy, consistent branding, responsive mobile-first layouts, effective whitespace, strong contrast, and an unmistakable call-to-action.",
  },
  {
    question: "What billing options do you offer?",
    answer: "We offer credit card billing or invoicing.",
  },
];
---

<Layout
  title="Email Design Services — Adaptif"
  description="Email campaigns built to perform without the workflow friction. On-brand, conversion-focused emails and modular design systems built for HubSpot, Klaviyo, Salesforce, and Mailchimp."
>
  <Header />
  <main>
    <EmailHero />
    <BrandLogos />
    <EmailOverviewAndOffer />
    <EmailWorkflowAndBottom />
    <FaqSection faqs={emailFaqs} />
  </main>
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  :global([data-em-reveal]) {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--em-delay, 0ms),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--em-delay, 0ms);
    will-change: opacity, transform;
  }

  :global([data-em-reveal="scale"]) {
    transform: translateY(16px) scale(0.975);
  }

  :global([data-em-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-em-reveal]) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const initEmailPage = () => {
    const revealEls = document.querySelectorAll<HTMLElement>("[data-em-reveal]");
    if (!revealEls.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) {
      revealEls.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.01, rootMargin: "100px 0px 100px 0px" }
    );

    revealEls.forEach((el) => observer.observe(el));
  };

  initEmailPage();
  document.addEventListener("astro:page-load", initEmailPage);
</script>
