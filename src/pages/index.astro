---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BrandLogos from "../components/BrandLogos.astro";
import RethinkingCreativeTeams from "../components/RethinkingCreativeTeams.astro";
import DesignedToKeepUp from "../components/DesignedToKeepUp.astro";
import ProofInMetrics from "../components/ProofInMetrics.astro";
import CreativeRange from "../components/CreativeRange.astro";
import ServicesCarousel from "../components/ServicesCarousel.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import OurWorkGrid from "../components/OurWorkGrid.astro";
import WorkflowsSection from "../components/WorkflowsSection.astro";
import OurDifference from "../components/OurDifference.astro";
import WorldClassTalent from "../components/WorldClassTalent.astro";
import FaqSection from "../components/FaqSection.astro";
import Footer from "../components/Footer.astro";
import { listProjects } from "../lib/portfolioDb";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");

const homeProjects = await listProjects({ onlyHome: true });
---

<Layout 
  title="Adaptif — The fuel behind your creative engine"
  description="A subscription that plugs an AI-driven creative department into your team: design, dev and marketing, unlimited requests and revisions, rapid turnarounds and a single, predictable monthly cost."
>
  <Header />
  <main>
    <Hero />
    <BrandLogos />
    <RethinkingCreativeTeams />
    <DesignedToKeepUp />
    <ProofInMetrics />
    <CreativeRange />
    <ServicesCarousel />
    <ComparisonTable />
    <OurWorkGrid projects={homeProjects} />
    <WorkflowsSection />
    <OurDifference />
    <WorldClassTalent />
    <FaqSection />
  </main>
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
  }
</style>
