---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BrandLogos from "../components/BrandLogos.astro";
import RethinkingCreativeTeams from "../components/RethinkingCreativeTeams.astro";
import DesignedToKeepUp from "../components/DesignedToKeepUp.astro";
import ProofInMetrics from "../components/ProofInMetrics.astro";
import CreativeRange from "../components/CreativeRange.astro";
---

<Layout 
  title="Adaptif — The fuel behind your creative engine"
  description="A subscription that plugs an AI-driven creative department into your team: design, dev and marketing, unlimited requests and revisions, rapid turnarounds and a single, predictable monthly cost."
>
  <Header />
  <main>
    <Hero />
    <BrandLogos />
    <RethinkingCreativeTeams />
    <DesignedToKeepUp />
    <ProofInMetrics />
    <CreativeRange />
  </main>
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
  }
</style>
