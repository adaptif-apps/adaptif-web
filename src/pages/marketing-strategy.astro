---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import MarketingHero from "../components/MarketingHero.astro";
import BrandLogos from "../components/BrandLogos.astro";
import MarketingOverviewAndStats from "../components/MarketingOverviewAndStats.astro";
import MarketingOfferAndFunnel from "../components/MarketingOfferAndFunnel.astro";
import MarketingAiAndWorkflow from "../components/MarketingAiAndWorkflow.astro";
import MarketingBottomAndArticles from "../components/MarketingBottomAndArticles.astro";
import Footer from "../components/Footer.astro";

export const prerender = false;

if (Astro.url.searchParams.get("edit") !== "1") {
  Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");
}
---

<Layout
  title="Marketing Strategy Services — Adaptif"
  description="Sharp, inventive marketing strategy made for impact & speed. Adaptif helps marketing teams launch on-brand, high-performing campaigns with embedded strategic support."
>
  <Header />
  <main>
    <MarketingHero />
    <BrandLogos />
    <MarketingOverviewAndStats />
    <MarketingOfferAndFunnel />
    <MarketingAiAndWorkflow />
    <MarketingBottomAndArticles />
  </main>
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  :global([data-mk-reveal]) {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--mk-delay, 0ms),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--mk-delay, 0ms);
    will-change: opacity, transform;
  }

  :global([data-mk-reveal="scale"]) {
    transform: translateY(16px) scale(0.975);
  }

  :global([data-mk-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-mk-reveal]) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const initMarketingPage = () => {
    const revealEls = document.querySelectorAll<HTMLElement>("[data-mk-reveal]");
    if (!revealEls.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const animateCounter = (el: HTMLElement) => {
      const target = Number(el.dataset.mkCount || "0");
      const suffix = el.dataset.mkSuffix || "";
      if (!target || el.dataset.mkCounted === "1") return;
      el.dataset.mkCounted = "1";

      if (prefersReducedMotion) {
        el.textContent = `${target}${suffix}`;
        return;
      }

      const duration = 950;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(target * eased)}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (prefersReducedMotion) {
      revealEls.forEach((el) => {
        el.classList.add("is-visible");
        el.querySelectorAll<HTMLElement>("[data-mk-count]").forEach(animateCounter);
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const target = entry.target as HTMLElement;
          target.classList.add("is-visible");
          target.querySelectorAll<HTMLElement>("[data-mk-count]").forEach(animateCounter);
          observer.unobserve(target);
        });
      },
      { threshold: 0.01, rootMargin: "100px 0px 100px 0px" }
    );

    revealEls.forEach((el) => observer.observe(el));
  };

  initMarketingPage();
  document.addEventListener("astro:page-load", initMarketingPage);
</script>
