---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CreativeRange from "../components/CreativeRange.astro";
import BrandLogos from "../components/BrandLogos.astro";
import OurWorkShowcase from "../components/OurWorkShowcase.astro";
import Footer from "../components/Footer.astro";
import { listProjects } from "../lib/portfolioDb";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");

const projects = await listProjects({ includeHidden: false });
---

<Layout title="Our Work — Adaptif">
  <Header />
  <main>
    <CreativeRange
      theme="dark"
      asHero={true}
      eyebrow="Our work"
      title="Creative"
      highlightTitle="that works."
      projects={projects}
    />
    <BrandLogos
      heading=""
      title="That's the only metric"
      titleHighlight="we care about."
      lead="Every project here started as a brief and ended as something a brand is genuinely proud of."
    />
    <OurWorkShowcase projects={projects} />
  </main>
  <Footer />
</Layout>
