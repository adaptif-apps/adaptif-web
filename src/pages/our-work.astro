---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CreativeRange from "../components/CreativeRange.astro";
import BrandLogos from "../components/BrandLogos.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Our Work — Adaptif">
  <Header />
  <main>
    <CreativeRange
      theme="dark"
      asHero={true}
      eyebrow="Our work"
      title="Creative"
      highlightTitle="that works."
    />
    <BrandLogos
      heading=""
      title="Every project here started as a brief and ended as something a brand is genuinely proud of."
      titleHighlight="That's the only metric we care about."
    />
  </main>
  <Footer />
</Layout>
