---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PricingHero from "../components/PricingHero.astro";
import BrandLogos from "../components/BrandLogos.astro";
import PricingValueEngine from "../components/PricingValueEngine.astro";
import PricingComparePlans from "../components/PricingComparePlans.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Pricing — Adaptif"
  description="Your full-time creative team, for one hire. Flexible Creative and Full Stack subscription plans with 1–2 day turnarounds."
>
  <Header />
  <main>
    <PricingHero />
    <BrandLogos />
    <PricingValueEngine />
    <PricingComparePlans />
  </main>
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
  }
</style>
