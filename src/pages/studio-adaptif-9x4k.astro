---
import { listProjects } from "../lib/portfolioDb";
import { getBookCallConfig } from "../lib/bookCallDb";
import { getActiveCampaignConfig } from "../lib/activeCampaignDb";

export const prerender = false;

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

const [initialProjects, initialBookCallConfig, rawAcConfig] = await Promise.all([
  listProjects({ includeHidden: true }),
  getBookCallConfig(),
  getActiveCampaignConfig(),
]);

const initialAcState = {
  enabled: rawAcConfig.enabled,
  apiUrl: rawAcConfig.apiUrl,
  hasApiKey: Boolean(rawAcConfig.apiKey),
  listId: rawAcConfig.listId,
  tagIds: rawAcConfig.tagIds,
  tagFromHelpTopic: rawAcConfig.tagFromHelpTopic,
  mapping: rawAcConfig.mapping,
  cachedLists: rawAcConfig.cachedLists,
  cachedTags: rawAcConfig.cachedTags,
  cachedFields: rawAcConfig.cachedFields,
  lastSyncedAt: rawAcConfig.lastSyncedAt,
};

const tagPresets = [
  "Branding",
  "Web Design",
  "Ecommerce Design",
  "App Design",
  "Social Media Creative",
  "Ad Creative",
  "Motion Design",
  "Video Production",
  "Packaging",
  "Print Creative",
  "Email Campaign",
  "Marketing Campaign",
  "P.O.P Material",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Adaptif Studio — Preferences</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="studio-shell">
      <!-- Modular Left Sidebar -->
      <aside class="studio-sidebar">
        <div class="studio-brand">
          <img src="/logo.svg" alt="Adaptif" class="studio-logo" />
          <span class="studio-badge">Preferences</span>
        </div>

        <nav class="studio-nav" aria-label="Preferences modules">
          <div class="nav-group-label">CMS Modules</div>
          <button type="button" class="nav-item is-active" data-module-tab="portfolio" aria-current="page">
            <span>Portfolio</span>
            <span class="nav-count" id="sidebar-project-count">{initialProjects.length}</span>
          </button>
          <button type="button" class="nav-item" data-module-tab="book-call">
            <span>Book a Call Form</span>
            <span class="nav-count">2 steps</span>
          </button>
          <button type="button" class="nav-item" data-module-tab="activecampaign">
            <span>ActiveCampaign</span>
            <span class="nav-count" id="sidebar-ac-status">{initialAcState.enabled ? "On" : "Off"}</span>
          </button>

          <div class="nav-item is-disabled" aria-disabled="true">
            <span>Blog &amp; Guides</span>
            <span class="soon-pill">Soon</span>
          </div>
          <div class="nav-item is-disabled" aria-disabled="true">
            <span>Courses</span>
            <span class="soon-pill">Soon</span>
          </div>
          <div class="nav-item is-disabled" aria-disabled="true">
            <span>Plugins &amp; Site</span>
            <span class="soon-pill">Soon</span>
          </div>
        </nav>

        <div class="studio-sidebar-footer">
          <a href="/our-work" target="_blank" rel="noopener noreferrer" class="view-live-btn">
            <span>View Live /our-work</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        </div>
      </aside>

      <!-- Main Workspace -->
      <main class="studio-main">
        <div id="module-portfolio">
          <header class="studio-header">
            <div>
              <p class="studio-eyebrow">Internal CMS</p>
              <h1 class="studio-title">Portfolio <span>Showcase</span></h1>
            </div>
            <div class="studio-header-actions">
              <button type="button" class="btn-primary" id="btn-add-brand">
                + Add Brand
              </button>
            </div>
          </header>

          <div class="studio-workspace">
          <!-- Left List: Brands -->
          <section class="brand-list-panel" aria-label="Brands list">
            <div class="panel-search-wrap">
              <input
                type="search"
                id="brand-search"
                class="panel-search"
                placeholder="Search brands..."
                autocomplete="off"
              />
            </div>
            <div class="brand-list" id="brand-list"></div>
          </section>

          <!-- Right Editor: Selected Brand -->
          <section class="brand-editor-panel" aria-label="Brand editor">
            <div id="editor-empty" class="editor-empty" hidden>
              Select a brand or click <strong>+ Add Brand</strong> to create one.
            </div>

            <form id="brand-editor-form" class="editor-form">
              <div class="editor-top-bar">
                <div class="editor-meta-info">
                  <span class="editor-mode-pill" id="editor-mode-pill">Editing</span>
                  <a
                    id="editor-share-link"
                    href="/our-work"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="editor-share-link"
                  >
                    /our-work
                  </a>
                </div>

                <div class="editor-toggles" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
                  <label class="toggle-wrap">
                    <input type="checkbox" id="field-published" checked />
                    <span>Visible on /our-work</span>
                  </label>
                  <label class="toggle-wrap">
                    <input type="checkbox" id="field-home" />
                    <span>Show on Home</span>
                  </label>
                </div>
              </div>

              <div class="form-grid">
                <div class="form-field">
                  <label for="field-title">Brand Title</label>
                  <input type="text" id="field-title" required placeholder="e.g. Sideline Podcast" />
                </div>

                <div class="form-field">
                  <label for="field-description">Description</label>
                  <textarea
                    id="field-description"
                    rows="3"
                    placeholder="Short brand story shown inside the open gallery overlay..."
                  ></textarea>
                </div>

                <!-- Tags Editor -->
                <div class="form-field">
                  <label>Tags</label>
                  <div class="tags-editor-box">
                    <div class="active-tags" id="active-tags"></div>
                    <div class="tag-input-row">
                      <input
                        type="text"
                        id="tag-custom-input"
                        placeholder="Add custom tag and press Enter..."
                      />
                      <button type="button" class="btn-secondary" id="btn-add-tag">Add</button>
                    </div>
                    <div class="tag-presets" id="tag-presets">
                      {tagPresets.map((preset) => (
                        <button type="button" class="preset-chip" data-preset-tag={preset}>
                          + {preset}
                        </button>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Thumbnail 1:1 -->
                <div class="form-field">
                  <label>Thumbnail (1:1)</label>
                  <div class="thumb-uploader">
                    <div class="thumb-preview-box">
                      <img id="thumb-preview-img" src="" alt="Thumbnail preview" />
                    </div>
                    <div class="thumb-controls">
                      <label class="btn-secondary upload-label">
                        <input type="file" id="thumb-file-input" accept="image/*" hidden />
                        <span id="thumb-upload-text">Upload New Thumbnail</span>
                      </label>
                      <input
                        type="text"
                        id="field-image"
                        placeholder="Or paste image URL..."
                        required
                      />
                      <p class="field-hint">Uploaded images are saved permanently in Vercel Blob.</p>
                    </div>
                  </div>
                </div>

                <!-- Gallery Images (Bento) -->
                <div class="form-field">
                  <div class="gallery-header-row">
                    <div>
                      <label>Overlay Gallery Images</label>
                      <p class="field-hint">
                        Up to 12 bento slots in the horizontal overlay (cycles automatically if fewer are uploaded).
                      </p>
                    </div>
                    <label class="btn-secondary upload-label">
                      <input type="file" id="gallery-files-input" accept="image/*" multiple hidden />
                      <span id="gallery-upload-text">+ Upload Images</span>
                    </label>
                  </div>

                  <div class="gallery-editor-grid" id="gallery-editor-grid"></div>
                </div>
              </div>

              <div class="editor-footer">
                <button type="button" class="btn-danger" id="btn-delete-brand">
                  Delete Brand
                </button>
                <button type="submit" class="btn-primary" id="btn-save-brand">
                  Save Changes
                </button>
              </div>
            </form>
          </section>
          </div>
        </div>

        <!-- Book a Call Form Module -->
        <div id="module-book-call" hidden>
          <header class="studio-header">
            <div>
              <p class="studio-eyebrow">Lead Capture</p>
              <h1 class="studio-title">Book a Call <span>Form</span></h1>
            </div>
            <div class="studio-header-actions">
              <button type="submit" form="book-call-cms-form" class="btn-primary" id="btn-save-book-call">
                Save Form Settings
              </button>
            </div>
          </header>

          <form id="book-call-cms-form" class="bc-cms-form">
            <section class="bc-cms-card">
              <h2 class="bc-cms-card-title">Step 1 — Strategy Call Intro &amp; Required Fields</h2>
              <div class="bc-cms-grid">
                <div class="form-field">
                  <label for="bc-cfg-step1-eyebrow">Eyebrow</label>
                  <input type="text" id="bc-cfg-step1-eyebrow" value={initialBookCallConfig.step1Eyebrow} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-step1-cta">Primary CTA Button</label>
                  <input type="text" id="bc-cfg-step1-cta" value={initialBookCallConfig.step1Cta} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-step1-title">Title Prefix</label>
                  <input type="text" id="bc-cfg-step1-title" value={initialBookCallConfig.step1Title} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-step1-highlight">Title Italic Highlight</label>
                  <input type="text" id="bc-cfg-step1-highlight" value={initialBookCallConfig.step1TitleHighlight} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-step1-suffix">Title Suffix</label>
                  <input type="text" id="bc-cfg-step1-suffix" value={initialBookCallConfig.step1TitleSuffix} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-privacy">Privacy Note</label>
                  <input type="text" id="bc-cfg-privacy" value={initialBookCallConfig.privacyNote} />
                </div>
              </div>

              <div class="form-field" style="margin-top: 14px;">
                <label for="bc-cfg-step1-subtitle">Subtitle</label>
                <textarea id="bc-cfg-step1-subtitle" rows="2">{initialBookCallConfig.step1Subtitle}</textarea>
              </div>

              <div class="bc-cms-grid" style="margin-top: 14px;">
                <div class="form-field">
                  <label for="bc-cfg-name-label">Name Field Label</label>
                  <input type="text" id="bc-cfg-name-label" value={initialBookCallConfig.nameLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-name-ph">Name Placeholder</label>
                  <input type="text" id="bc-cfg-name-ph" value={initialBookCallConfig.namePlaceholder} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-email-label">Email Field Label</label>
                  <input type="text" id="bc-cfg-email-label" value={initialBookCallConfig.emailLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-email-ph">Email Placeholder</label>
                  <input type="text" id="bc-cfg-email-ph" value={initialBookCallConfig.emailPlaceholder} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-help-label">Help Topic Label</label>
                  <input type="text" id="bc-cfg-help-label" value={initialBookCallConfig.helpLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-help-ph">Help Topic Placeholder</label>
                  <input type="text" id="bc-cfg-help-ph" value={initialBookCallConfig.helpPlaceholder} />
                </div>
              </div>

              <div class="form-field" style="margin-top: 14px;">
                <label for="bc-cfg-help-options">Help Topic Dropdown Options (one per line)</label>
                <textarea id="bc-cfg-help-options" rows="4">{initialBookCallConfig.helpOptions.join("\n")}</textarea>
              </div>
            </section>

            <section class="bc-cms-card">
              <h2 class="bc-cms-card-title">Step 2 — Optional Project Details</h2>
              <div class="bc-cms-grid">
                <div class="form-field">
                  <label for="bc-cfg-step2-eyebrow">Eyebrow</label>
                  <input type="text" id="bc-cfg-step2-eyebrow" value={initialBookCallConfig.step2Eyebrow} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-step2-title">Title</label>
                  <input type="text" id="bc-cfg-step2-title" value={initialBookCallConfig.step2Title} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-step2-cta">Submit Button Text</label>
                  <input type="text" id="bc-cfg-step2-cta" value={initialBookCallConfig.step2Cta} />
                </div>
              </div>

              <div class="form-field" style="margin-top: 14px;">
                <label for="bc-cfg-step2-subtitle">Subtitle</label>
                <textarea id="bc-cfg-step2-subtitle" rows="2">{initialBookCallConfig.step2Subtitle}</textarea>
              </div>

              <div class="bc-cms-grid" style="margin-top: 14px;">
                <div class="form-field">
                  <label for="bc-cfg-goal-label">Goal Field Label</label>
                  <input type="text" id="bc-cfg-goal-label" value={initialBookCallConfig.goalLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-goal-ph">Goal Placeholder</label>
                  <input type="text" id="bc-cfg-goal-ph" value={initialBookCallConfig.goalPlaceholder} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-link-label">Link Field Label</label>
                  <input type="text" id="bc-cfg-link-label" value={initialBookCallConfig.linkLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-link-ph">Link Placeholder</label>
                  <input type="text" id="bc-cfg-link-ph" value={initialBookCallConfig.linkPlaceholder} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-timeline-label">Timeline Label</label>
                  <input type="text" id="bc-cfg-timeline-label" value={initialBookCallConfig.timelineLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-timeline-ph">Timeline Placeholder</label>
                  <input type="text" id="bc-cfg-timeline-ph" value={initialBookCallConfig.timelinePlaceholder} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-budget-label">Budget Label</label>
                  <input type="text" id="bc-cfg-budget-label" value={initialBookCallConfig.budgetLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-budget-ph">Budget Placeholder</label>
                  <input type="text" id="bc-cfg-budget-ph" value={initialBookCallConfig.budgetPlaceholder} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-notes-label">Notes Field Label</label>
                  <input type="text" id="bc-cfg-notes-label" value={initialBookCallConfig.notesLabel} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-notes-ph">Notes Placeholder</label>
                  <input type="text" id="bc-cfg-notes-ph" value={initialBookCallConfig.notesPlaceholder} />
                </div>
              </div>

              <div class="bc-cms-grid" style="margin-top: 14px;">
                <div class="form-field">
                  <label for="bc-cfg-timeline-options">Timeline Options (one per line)</label>
                  <textarea id="bc-cfg-timeline-options" rows="4">{initialBookCallConfig.timelineOptions.join("\n")}</textarea>
                </div>
                <div class="form-field">
                  <label for="bc-cfg-budget-options">Budget Options (one per line)</label>
                  <textarea id="bc-cfg-budget-options" rows="4">{initialBookCallConfig.budgetOptions.join("\n")}</textarea>
                </div>
              </div>
            </section>

            <section class="bc-cms-card">
              <h2 class="bc-cms-card-title">Confirmation Screen</h2>
              <div class="bc-cms-grid">
                <div class="form-field">
                  <label for="bc-cfg-success-eyebrow">Eyebrow</label>
                  <input type="text" id="bc-cfg-success-eyebrow" value={initialBookCallConfig.successEyebrow} />
                </div>
                <div class="form-field">
                  <label for="bc-cfg-success-title">Title</label>
                  <input type="text" id="bc-cfg-success-title" value={initialBookCallConfig.successTitle} />
                </div>
              </div>
              <div class="form-field" style="margin-top: 14px;">
                <label for="bc-cfg-success-message">Confirmation Message</label>
                <textarea id="bc-cfg-success-message" rows="2">{initialBookCallConfig.successMessage}</textarea>
              </div>
            </section>
          </form>
        </div>

        <!-- ActiveCampaign Integration Module -->
        <div id="module-activecampaign" hidden>
          <header class="studio-header">
            <div>
              <p class="studio-eyebrow">Integrations</p>
              <h1 class="studio-title">ActiveCampaign <span>Sync</span></h1>
            </div>
            <div class="studio-header-actions">
              <button type="submit" form="ac-cms-form" class="btn-primary" id="btn-save-ac">
                Save Integration
              </button>
            </div>
          </header>

          <form id="ac-cms-form" class="bc-cms-form">
            <section class="bc-cms-card">
              <div class="ac-card-head">
                <div>
                  <h2 class="bc-cms-card-title" style="margin-bottom: 4px;">1. Connect Your Account</h2>
                  <p class="field-hint" style="margin: 0;">
                    Enter your ActiveCampaign Developer API URL &amp; Key, then fetch your Lists, Tags, and Custom Fields automatically.
                  </p>
                </div>
                <label class="toggle-wrap">
                  <input type="checkbox" id="ac-enabled" checked={initialAcState.enabled} />
                  <span>Enable Sync</span>
                </label>
              </div>

              <div class="bc-cms-grid" style="margin-top: 16px;">
                <div class="form-field">
                  <label for="ac-api-url">Account API URL</label>
                  <input
                    type="url"
                    id="ac-api-url"
                    value={initialAcState.apiUrl}
                    placeholder="https://youraccount.api-us1.com"
                  />
                </div>
                <div class="form-field">
                  <label for="ac-api-key">API Key</label>
                  <input
                    type="password"
                    id="ac-api-key"
                    placeholder={initialAcState.hasApiKey ? "Saved (leave blank to keep current key)" : "Paste your ActiveCampaign API key..."}
                    autocomplete="off"
                  />
                </div>
              </div>

              <div class="ac-sync-bar">
                <button type="button" class="btn-secondary" id="btn-ac-sync-meta">
                  Connect &amp; Fetch Fields
                </button>
                <span class="ac-sync-status" id="ac-sync-status">
                  {initialAcState.cachedFields.length > 0 || initialAcState.cachedLists.length > 0
                    ? `Synced • ${initialAcState.cachedLists.length} lists, ${initialAcState.cachedTags.length} tags, ${initialAcState.cachedFields.length} fields`
                    : "Not synced yet"}
                </span>
              </div>
            </section>

            <section class="bc-cms-card">
              <h2 class="bc-cms-card-title" style="margin-bottom: 4px;">2. Visual Field Mapping</h2>
              <p class="field-hint" style="margin: 0 0 16px;">
                Match each Book a Call form field to its destination in ActiveCampaign.
              </p>

              <div class="ac-map-table">
                <div class="ac-map-head">
                  <span>Book a Call Field</span>
                  <span>ActiveCampaign Destination</span>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>Work Email</strong>
                    <span>Step 1 • Required</span>
                  </div>
                  <div class="ac-map-locked">Contact Email (Always synced)</div>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>Full Name</strong>
                    <span>Step 1 • Required</span>
                  </div>
                  <select id="ac-map-fullname" class="ac-select">
                    <option value="split">Split into First Name + Last Name</option>
                    <option value="firstOnly">Send full text as First Name</option>
                    <option value="ignore">Do not sync</option>
                  </select>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>What would you like help with?</strong>
                    <span>Step 1 • Dropdown</span>
                  </div>
                  <select id="ac-map-help" class="ac-select" data-ac-field-select></select>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>Main Goal of Project</strong>
                    <span>Step 2 • Text</span>
                  </div>
                  <select id="ac-map-goal" class="ac-select" data-ac-field-select></select>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>Website / Reference Link</strong>
                    <span>Step 2 • URL</span>
                  </div>
                  <select id="ac-map-link" class="ac-select" data-ac-field-select></select>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>Ideal Timeline</strong>
                    <span>Step 2 • Dropdown</span>
                  </div>
                  <select id="ac-map-timeline" class="ac-select" data-ac-field-select></select>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>Budget Range</strong>
                    <span>Step 2 • Dropdown</span>
                  </div>
                  <select id="ac-map-budget" class="ac-select" data-ac-field-select></select>
                </div>

                <div class="ac-map-row">
                  <div class="ac-map-source">
                    <strong>Additional Notes</strong>
                    <span>Step 2 • Textarea</span>
                  </div>
                  <select id="ac-map-notes" class="ac-select" data-ac-field-select></select>
                </div>
              </div>
            </section>

            <section class="bc-cms-card">
              <h2 class="bc-cms-card-title" style="margin-bottom: 4px;">3. Lists, Tags &amp; Live Test</h2>
              <p class="field-hint" style="margin: 0 0 16px;">
                Choose which list and tags are applied automatically whenever someone submits Book a Call.
              </p>

              <div class="bc-cms-grid">
                <div class="form-field">
                  <label for="ac-list-id">Subscribe to List</label>
                  <select id="ac-list-id" class="ac-select"></select>
                </div>

                <div class="form-field" style="justify-content: flex-end;">
                  <label class="toggle-wrap" style="padding-bottom: 10px;">
                    <input type="checkbox" id="ac-tag-help-topic" checked={initialAcState.tagFromHelpTopic} />
                    <span>Also auto-tag with selected "Help Topic"</span>
                  </label>
                </div>
              </div>

              <div class="form-field" style="margin-top: 14px;">
                <label>Apply Tags on Submit (click to toggle)</label>
                <div class="ac-tags-chips" id="ac-tags-chips"></div>
              </div>

              <div class="ac-test-bar">
                <input
                  type="email"
                  id="ac-test-email"
                  class="ac-test-input"
                  value="test-lead@adaptif.studio"
                  placeholder="test-lead@yourdomain.com"
                />
                <button type="button" class="btn-secondary" id="btn-ac-test">
                  Send Test Lead
                </button>
              </div>
            </section>
          </form>
        </div>
      </main>
    </div>

    <div class="toast" id="studio-toast" role="status" aria-live="polite"></div>

    <script define:vars={{ initialProjects, initialAcState }}>
      window.__INITIAL_PROJECTS__ = initialProjects;
      window.__INITIAL_AC_STATE__ = initialAcState;
    </script>

    <script>
      interface Project {
        id: string;
        title: string;
        description: string;
        tags: string[];
        image: string;
        gallery: string[];
        sortOrder: number;
        isPublished: boolean;
        showOnHome: boolean;
      }

      let projects: Project[] = Array.isArray((window as any).__INITIAL_PROJECTS__)
        ? (window as any).__INITIAL_PROJECTS__
        : [];

      let selectedId: string | null = projects[0]?.id ?? null;
      let isCreatingNew = false;
      let draftTags: string[] = [];
      let draftGallery: string[] = [];

      const listEl = document.getElementById("brand-list")!;
      const countEl = document.getElementById("sidebar-project-count")!;
      const searchEl = document.getElementById("brand-search") as HTMLInputElement;
      const formEl = document.getElementById("brand-editor-form") as HTMLFormElement;
      const emptyEl = document.getElementById("editor-empty")!;

      const modePillEl = document.getElementById("editor-mode-pill")!;
      const shareLinkEl = document.getElementById("editor-share-link") as HTMLAnchorElement;
      const publishedEl = document.getElementById("field-published") as HTMLInputElement;
      const homeEl = document.getElementById("field-home") as HTMLInputElement;
      const titleEl = document.getElementById("field-title") as HTMLInputElement;
      const descEl = document.getElementById("field-description") as HTMLTextAreaElement;
      const imageEl = document.getElementById("field-image") as HTMLInputElement;
      const thumbImgEl = document.getElementById("thumb-preview-img") as HTMLImageElement;
      const thumbFileEl = document.getElementById("thumb-file-input") as HTMLInputElement;
      const thumbUploadTextEl = document.getElementById("thumb-upload-text")!;

      const activeTagsEl = document.getElementById("active-tags")!;
      const customTagEl = document.getElementById("tag-custom-input") as HTMLInputElement;
      const addTagBtn = document.getElementById("btn-add-tag")!;

      const galleryGridEl = document.getElementById("gallery-editor-grid")!;
      const galleryFilesEl = document.getElementById("gallery-files-input") as HTMLInputElement;
      const galleryUploadTextEl = document.getElementById("gallery-upload-text")!;

      const addBrandBtn = document.getElementById("btn-add-brand")!;
      const deleteBtn = document.getElementById("btn-delete-brand") as HTMLButtonElement;
      const saveBtn = document.getElementById("btn-save-brand") as HTMLButtonElement;
      const toastEl = document.getElementById("studio-toast")!;

      let toastTimer: any = null;
      function showToast(msg: string, isError = false) {
        toastEl.textContent = msg;
        toastEl.classList.toggle("is-error", isError);
        toastEl.classList.add("is-visible");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.remove("is-visible"), 2600);
      }

      async function toClientWebpIfPossible(file: File): Promise<File> {
        // Keep animated GIFs, SVGs, and existing WebPs intact for server-side sharp handling
        if (
          file.type === "image/webp" ||
          file.type === "image/gif" ||
          file.type === "image/svg+xml"
        ) {
          return file;
        }
        try {
          const bitmap = await createImageBitmap(file);
          const canvas = document.createElement("canvas");
          canvas.width = bitmap.width;
          canvas.height = bitmap.height;
          const ctx = canvas.getContext("2d");
          if (!ctx) {
            bitmap.close();
            return file;
          }
          ctx.drawImage(bitmap, 0, 0);
          bitmap.close();

          const blob = await new Promise<Blob | null>((resolve) =>
            canvas.toBlob(resolve, "image/webp", 0.88)
          );
          if (!blob) return file;

          const baseName = file.name.replace(/\.[^/.]+$/, "") || "image";
          return new File([blob], `${baseName}.webp`, { type: "image/webp" });
        } catch {
          // Fallback to server-side sharp conversion (e.g., HEIC/TIFF/etc.)
          return file;
        }
      }

      async function uploadFile(file: File): Promise<string> {
        const preparedFile = await toClientWebpIfPossible(file);
        const fd = new FormData();
        fd.append("file", preparedFile);
        const res = await fetch("/api/upload", { method: "POST", body: fd });
        const data = await res.json();
        if (!res.ok || !data.url) {
          throw new Error(data.error || "Upload failed");
        }
        return data.url;
      }

      function renderTags() {
        activeTagsEl.innerHTML = "";
        draftTags.forEach((tag, idx) => {
          const span = document.createElement("span");
          span.className = "active-tag-chip";
          span.innerHTML = `<span></span><button type="button" aria-label="Remove tag">&times;</button>`;
          span.querySelector("span")!.textContent = tag;
          span.querySelector("button")!.addEventListener("click", () => {
            draftTags.splice(idx, 1);
            renderTags();
          });
          activeTagsEl.appendChild(span);
        });
      }

      function addTag(tag: string) {
        const clean = tag.trim();
        if (!clean || draftTags.includes(clean)) return;
        draftTags.push(clean);
        renderTags();
      }

      function renderGallery() {
        galleryGridEl.innerHTML = "";
        if (draftGallery.length === 0) {
          galleryGridEl.innerHTML = `<div class="gallery-empty">No gallery images yet. Upload images above.</div>`;
          return;
        }

        draftGallery.forEach((url, idx) => {
          const card = document.createElement("div");
          card.className = "gallery-item";
          card.innerHTML = `
            <img src="${url}" alt="Gallery item ${idx + 1}" />
            <span class="gallery-slot-num">#${idx + 1}</span>
            <div class="gallery-item-actions">
              <button type="button" data-move="-1" title="Move earlier" ${idx === 0 ? "disabled" : ""}>&larr;</button>
              <button type="button" data-move="1" title="Move later" ${idx === draftGallery.length - 1 ? "disabled" : ""}>&rarr;</button>
              <button type="button" data-remove="true" title="Remove">&times;</button>
            </div>
          `;

          card.querySelectorAll<HTMLButtonElement>("[data-move]").forEach((btn) => {
            btn.addEventListener("click", () => {
              const delta = Number(btn.dataset.move);
              const targetIdx = idx + delta;
              if (targetIdx < 0 || targetIdx >= draftGallery.length) return;
              const copy = [...draftGallery];
              [copy[idx], copy[targetIdx]] = [copy[targetIdx], copy[idx]];
              draftGallery = copy;
              renderGallery();
            });
          });

          card.querySelector<HTMLButtonElement>("[data-remove]")!.addEventListener("click", () => {
            draftGallery.splice(idx, 1);
            renderGallery();
          });

          galleryGridEl.appendChild(card);
        });
      }

      function loadEditor(project: Project | null, creating = false) {
        isCreatingNew = creating;
        if (!project && !creating) {
          formEl.hidden = true;
          emptyEl.hidden = false;
          return;
        }

        formEl.hidden = false;
        emptyEl.hidden = true;

        if (creating) {
          modePillEl.textContent = "New Brand";
          modePillEl.classList.add("is-new");
          shareLinkEl.textContent = "/our-work (saved on create)";
          shareLinkEl.href = "/our-work";
          publishedEl.checked = true;
          homeEl.checked = false;
          titleEl.value = "";
          descEl.value = "";
          imageEl.value = "";
          thumbImgEl.src = "/work-featured/sideline.jpg";
          draftTags = ["Branding"];
          draftGallery = [];
          deleteBtn.hidden = true;
          saveBtn.textContent = "Create Brand";
        } else if (project) {
          modePillEl.textContent = "Editing";
          modePillEl.classList.remove("is-new");
          shareLinkEl.textContent = `/our-work?project=${project.id}`;
          shareLinkEl.href = `/our-work?project=${project.id}`;
          publishedEl.checked = project.isPublished;
          homeEl.checked = Boolean(project.showOnHome);
          titleEl.value = project.title;
          descEl.value = project.description;
          imageEl.value = project.image;
          thumbImgEl.src = project.image;
          draftTags = [...project.tags];
          draftGallery = [...project.gallery];
          deleteBtn.hidden = false;
          saveBtn.textContent = "Save Changes";
        }

        renderTags();
        renderGallery();
      }

      async function saveOrder(newOrderIds: string[]) {
        await fetch("/api/projects/reorder", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ orderedIds: newOrderIds }),
        });
      }

      function renderList() {
        const query = searchEl.value.trim().toLowerCase();
        countEl.textContent = String(projects.length);
        listEl.innerHTML = "";

        const filtered = projects.filter((p) => p.title.toLowerCase().includes(query));

        filtered.forEach((project) => {
          const globalIdx = projects.findIndex((p) => p.id === project.id);
          const row = document.createElement("div");
          row.className = `brand-row ${!isCreatingNew && project.id === selectedId ? "is-selected" : ""}`;

          row.innerHTML = `
            <button type="button" class="brand-row-main">
              <img src="${project.image}" alt="" class="brand-row-thumb" />
              <div class="brand-row-text">
                <span class="brand-row-title"></span>
                <span class="brand-row-sub">${project.isPublished ? "Visible" : "Hidden"}${project.showOnHome ? " &bull; Home" : ""} &bull; ${project.tags.length} tags</span>
              </div>
            </button>
            <div class="brand-row-order">
              <button type="button" class="order-btn" data-dir="-1" title="Move up" ${globalIdx === 0 ? "disabled" : ""}>&uarr;</button>
              <button type="button" class="order-btn" data-dir="1" title="Move down" ${globalIdx === projects.length - 1 ? "disabled" : ""}>&darr;</button>
            </div>
          `;

          row.querySelector(".brand-row-title")!.textContent = project.title;
          row.querySelector(".brand-row-main")!.addEventListener("click", () => {
            selectedId = project.id;
            loadEditor(project, false);
            renderList();
          });

          row.querySelectorAll<HTMLButtonElement>(".order-btn").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
              e.stopPropagation();
              const dir = Number(btn.dataset.dir);
              const swapIdx = globalIdx + dir;
              if (swapIdx < 0 || swapIdx >= projects.length) return;
              const copy = [...projects];
              [copy[globalIdx], copy[swapIdx]] = [copy[swapIdx], copy[globalIdx]];
              projects = copy;
              renderList();
              try {
                await saveOrder(projects.map((p) => p.id));
                showToast("Order updated");
              } catch {
                showToast("Failed to save order", true);
              }
            });
          });

          listEl.appendChild(row);
        });
      }

      // Events
      searchEl.addEventListener("input", renderList);

      addBrandBtn.addEventListener("click", () => {
        selectedId = null;
        loadEditor(null, true);
        renderList();
        titleEl.focus();
      });

      imageEl.addEventListener("input", () => {
        if (imageEl.value.trim()) {
          thumbImgEl.src = imageEl.value.trim();
        }
      });

      addTagBtn.addEventListener("click", () => {
        addTag(customTagEl.value);
        customTagEl.value = "";
      });

      customTagEl.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          addTag(customTagEl.value);
          customTagEl.value = "";
        }
      });

      document.querySelectorAll<HTMLButtonElement>("[data-preset-tag]").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.dataset.presetTag) addTag(btn.dataset.presetTag);
        });
      });

      thumbFileEl.addEventListener("change", async () => {
        const file = thumbFileEl.files?.[0];
        if (!file) return;
        thumbUploadTextEl.textContent = "Uploading...";
        try {
          const url = await uploadFile(file);
          imageEl.value = url;
          thumbImgEl.src = url;
          if (draftGallery.length === 0) {
            draftGallery.push(url);
            renderGallery();
          }
          showToast("Thumbnail uploaded to Vercel Blob");
        } catch (err: any) {
          showToast(err?.message || "Upload failed", true);
        } finally {
          thumbUploadTextEl.textContent = "Upload New Thumbnail";
          thumbFileEl.value = "";
        }
      });

      galleryFilesEl.addEventListener("change", async () => {
        const files = Array.from(galleryFilesEl.files || []);
        if (files.length === 0) return;
        galleryUploadTextEl.textContent = `Uploading (${files.length})...`;
        try {
          for (const file of files) {
            const url = await uploadFile(file);
            draftGallery.push(url);
          }
          renderGallery();
          showToast(`${files.length} image(s) uploaded to Vercel Blob`);
        } catch (err: any) {
          showToast(err?.message || "Gallery upload failed", true);
        } finally {
          galleryUploadTextEl.textContent = "+ Upload Images";
          galleryFilesEl.value = "";
        }
      });

      formEl.addEventListener("submit", async (e) => {
        e.preventDefault();
        saveBtn.disabled = true;

        const payload = {
          title: titleEl.value.trim(),
          description: descEl.value.trim(),
          tags: draftTags,
          image: imageEl.value.trim(),
          gallery: draftGallery.length > 0 ? draftGallery : [imageEl.value.trim()],
          isPublished: publishedEl.checked,
          showOnHome: homeEl.checked,
        };

        try {
          if (isCreatingNew) {
            const res = await fetch("/api/projects", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed to create brand");
            projects.push(data.project);
            selectedId = data.project.id;
            loadEditor(data.project, false);
            renderList();
            showToast("Brand created & live on /our-work");
          } else if (selectedId) {
            const res = await fetch(`/api/projects/${encodeURIComponent(selectedId)}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Failed to save changes");
            const idx = projects.findIndex((p) => p.id === selectedId);
            if (idx !== -1) projects[idx] = data.project;
            loadEditor(data.project, false);
            renderList();
            showToast("Changes saved & live on /our-work");
          }
        } catch (err: any) {
          showToast(err?.message || "Error saving", true);
        } finally {
          saveBtn.disabled = false;
        }
      });

      deleteBtn.addEventListener("click", async () => {
        if (!selectedId) return;
        const current = projects.find((p) => p.id === selectedId);
        if (!confirm(`Delete "${current?.title || selectedId}" from portfolio?`)) return;

        try {
          const res = await fetch(`/api/projects/${encodeURIComponent(selectedId)}`, {
            method: "DELETE",
          });
          if (!res.ok) throw new Error("Failed to delete");
          projects = projects.filter((p) => p.id !== selectedId);
          selectedId = projects[0]?.id ?? null;
          loadEditor(projects[0] ?? null, false);
          renderList();
          showToast("Brand deleted");
        } catch (err: any) {
          showToast(err?.message || "Delete failed", true);
        }
      });

      // Init
      renderList();
      loadEditor(projects[0] ?? null, false);

      // Module tab switching (Portfolio <-> Book a Call Form)
      const moduleTabs = document.querySelectorAll<HTMLButtonElement>("[data-module-tab]");
      const portfolioModule = document.getElementById("module-portfolio");
      const bookCallModule = document.getElementById("module-book-call");

      moduleTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const target = tab.dataset.moduleTab;
          const activeCampaignModule = document.getElementById("module-activecampaign");
          moduleTabs.forEach((t) => {
            const active = t.dataset.moduleTab === target;
            t.classList.toggle("is-active", active);
            if (active) t.setAttribute("aria-current", "page");
            else t.removeAttribute("aria-current");
          });
          if (portfolioModule) portfolioModule.hidden = target !== "portfolio";
          if (bookCallModule) bookCallModule.hidden = target !== "book-call";
          if (activeCampaignModule) activeCampaignModule.hidden = target !== "activecampaign";
        });
      });

      // Book a Call Form CMS save
      const bcCmsForm = document.getElementById("book-call-cms-form") as HTMLFormElement | null;
      const bcSaveBtn = document.getElementById("btn-save-book-call") as HTMLButtonElement | null;

      bcCmsForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (bcSaveBtn) bcSaveBtn.disabled = true;

        const val = (id: string) =>
          (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement)?.value.trim() ?? "";
        const lines = (id: string) =>
          ((document.getElementById(id) as HTMLTextAreaElement)?.value ?? "")
            .split("\n")
            .map((s) => s.trim())
            .filter(Boolean);

        const payload = {
          step1Eyebrow: val("bc-cfg-step1-eyebrow"),
          step1Title: val("bc-cfg-step1-title"),
          step1TitleHighlight: val("bc-cfg-step1-highlight"),
          step1TitleSuffix: val("bc-cfg-step1-suffix"),
          step1Subtitle: val("bc-cfg-step1-subtitle"),
          nameLabel: val("bc-cfg-name-label"),
          namePlaceholder: val("bc-cfg-name-ph"),
          emailLabel: val("bc-cfg-email-label"),
          emailPlaceholder: val("bc-cfg-email-ph"),
          helpLabel: val("bc-cfg-help-label"),
          helpPlaceholder: val("bc-cfg-help-ph"),
          helpOptions: lines("bc-cfg-help-options"),
          privacyNote: val("bc-cfg-privacy"),
          step1Cta: val("bc-cfg-step1-cta"),

          step2Eyebrow: val("bc-cfg-step2-eyebrow"),
          step2Title: val("bc-cfg-step2-title"),
          step2Subtitle: val("bc-cfg-step2-subtitle"),
          goalLabel: val("bc-cfg-goal-label"),
          goalPlaceholder: val("bc-cfg-goal-ph"),
          linkLabel: val("bc-cfg-link-label"),
          linkPlaceholder: val("bc-cfg-link-ph"),
          timelineLabel: val("bc-cfg-timeline-label"),
          timelinePlaceholder: val("bc-cfg-timeline-ph"),
          timelineOptions: lines("bc-cfg-timeline-options"),
          budgetLabel: val("bc-cfg-budget-label"),
          budgetPlaceholder: val("bc-cfg-budget-ph"),
          budgetOptions: lines("bc-cfg-budget-options"),
          notesLabel: val("bc-cfg-notes-label"),
          notesPlaceholder: val("bc-cfg-notes-ph"),
          step2Cta: val("bc-cfg-step2-cta"),

          successEyebrow: val("bc-cfg-success-eyebrow"),
          successTitle: val("bc-cfg-success-title"),
          successMessage: val("bc-cfg-success-message"),
        };

        try {
          const res = await fetch("/api/book-call/config", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.error || "Failed to save Book a Call form");
          showToast("Book a Call form saved & live!");
        } catch (err: any) {
          showToast(err?.message || "Failed to save form settings", true);
        } finally {
          if (bcSaveBtn) bcSaveBtn.disabled = false;
        }
      });

      // ActiveCampaign Integration CMS
      const acState = (window as any).__INITIAL_AC_STATE__ || {};
      const acForm = document.getElementById("ac-cms-form") as HTMLFormElement | null;
      const acEnabledEl = document.getElementById("ac-enabled") as HTMLInputElement | null;
      const acApiUrlEl = document.getElementById("ac-api-url") as HTMLInputElement | null;
      const acApiKeyEl = document.getElementById("ac-api-key") as HTMLInputElement | null;
      const acSyncBtn = document.getElementById("btn-ac-sync-meta") as HTMLButtonElement | null;
      const acSyncStatusEl = document.getElementById("ac-sync-status");
      const acSidebarStatusEl = document.getElementById("sidebar-ac-status");
      const acListSelectEl = document.getElementById("ac-list-id") as HTMLSelectElement | null;
      const acTagChipsEl = document.getElementById("ac-tags-chips");
      const acTagHelpTopicEl = document.getElementById("ac-tag-help-topic") as HTMLInputElement | null;
      const acSaveBtn = document.getElementById("btn-save-ac") as HTMLButtonElement | null;
      const acTestBtn = document.getElementById("btn-ac-test") as HTMLButtonElement | null;
      const acTestEmailEl = document.getElementById("ac-test-email") as HTMLInputElement | null;

      const acFullNameSelect = document.getElementById("ac-map-fullname") as HTMLSelectElement | null;
      const acFieldMapIds: [string, keyof typeof acState.mapping][] = [
        ["ac-map-help", "helpTopicFieldId"],
        ["ac-map-goal", "projectGoalFieldId"],
        ["ac-map-link", "referenceLinkFieldId"],
        ["ac-map-timeline", "timelineFieldId"],
        ["ac-map-budget", "budgetRangeFieldId"],
        ["ac-map-notes", "notesFieldId"],
      ];

      let acSelectedTags = new Set<string>(Array.isArray(acState.tagIds) ? acState.tagIds : []);
      let acLists: { id: string; name: string }[] = Array.isArray(acState.cachedLists) ? acState.cachedLists : [];
      let acTags: { id: string; name: string }[] = Array.isArray(acState.cachedTags) ? acState.cachedTags : [];
      let acFields: { id: string; title: string; perstag: string }[] = Array.isArray(acState.cachedFields) ? acState.cachedFields : [];

      function renderAcControls(mappingOverride?: Record<string, string>, listOverride?: string) {
        const mapping = mappingOverride || acState.mapping || {};
        if (acFullNameSelect && mapping.fullNameMode) {
          acFullNameSelect.value = mapping.fullNameMode;
        }

        acFieldMapIds.forEach(([elId, mapKey]) => {
          const sel = document.getElementById(elId) as HTMLSelectElement | null;
          if (!sel) return;
          const prevVal = sel.value || String(mapping[mapKey] || "");
          sel.innerHTML = "";
          const noneOpt = document.createElement("option");
          noneOpt.value = "";
          noneOpt.textContent = "— Do not sync —";
          sel.appendChild(noneOpt);
          acFields.forEach((f) => {
            const opt = document.createElement("option");
            opt.value = f.id;
            opt.textContent = f.perstag ? `${f.title} (%${f.perstag}%)` : f.title;
            sel.appendChild(opt);
          });
          sel.value = prevVal;
        });

        if (acListSelectEl) {
          const prevList = listOverride ?? (acListSelectEl.value || String(acState.listId || ""));
          acListSelectEl.innerHTML = "";
          const noneOpt = document.createElement("option");
          noneOpt.value = "";
          noneOpt.textContent = "— None —";
          acListSelectEl.appendChild(noneOpt);
          acLists.forEach((l) => {
            const opt = document.createElement("option");
            opt.value = l.id;
            opt.textContent = l.name;
            acListSelectEl.appendChild(opt);
          });
          acListSelectEl.value = prevList;
        }

        if (acTagChipsEl) {
          acTagChipsEl.innerHTML = "";
          if (acTags.length === 0) {
            const hint = document.createElement("span");
            hint.className = "field-hint";
            hint.textContent = 'Click "Connect & Fetch Fields" above to load your ActiveCampaign tags.';
            acTagChipsEl.appendChild(hint);
          } else {
            acTags.forEach((tag) => {
              const btn = document.createElement("button");
              btn.type = "button";
              btn.className = `ac-tag-chip ${acSelectedTags.has(tag.id) ? "is-active" : ""}`;
              btn.textContent = tag.name;
              btn.addEventListener("click", () => {
                if (acSelectedTags.has(tag.id)) acSelectedTags.delete(tag.id);
                else acSelectedTags.add(tag.id);
                btn.classList.toggle("is-active", acSelectedTags.has(tag.id));
              });
              acTagChipsEl.appendChild(btn);
            });
          }
        }
      }

      renderAcControls(acState.mapping, acState.listId);

      function collectAcPayload() {
        const mapping: Record<string, string> = {
          fullNameMode: acFullNameSelect?.value || "split",
        };
        acFieldMapIds.forEach(([elId, mapKey]) => {
          const sel = document.getElementById(elId) as HTMLSelectElement | null;
          mapping[String(mapKey)] = sel?.value || "";
        });

        return {
          enabled: Boolean(acEnabledEl?.checked),
          apiUrl: acApiUrlEl?.value.trim() || "",
          apiKey: acApiKeyEl?.value.trim() || "",
          listId: acListSelectEl?.value || "",
          tagIds: Array.from(acSelectedTags),
          tagFromHelpTopic: Boolean(acTagHelpTopicEl?.checked),
          mapping,
        };
      }

      acSyncBtn?.addEventListener("click", async () => {
        acSyncBtn.disabled = true;
        acSyncBtn.textContent = "Connecting...";
        try {
          const res = await fetch("/api/activecampaign/sync-meta", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              apiUrl: acApiUrlEl?.value.trim() || "",
              apiKey: acApiKeyEl?.value.trim() || "",
            }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.error || "Connection failed");

          acLists = data.lists || [];
          acTags = data.tags || [];
          acFields = data.fields || [];
          renderAcControls();
          if (acSyncStatusEl) {
            acSyncStatusEl.textContent = `Connected • ${acLists.length} lists, ${acTags.length} tags, ${acFields.length} fields`;
          }
          showToast("ActiveCampaign fields synced!");
        } catch (err: any) {
          showToast(err?.message || "Failed to connect to ActiveCampaign", true);
        } finally {
          acSyncBtn.disabled = false;
          acSyncBtn.textContent = "Connect & Fetch Fields";
        }
      });

      acForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (acSaveBtn) acSaveBtn.disabled = true;
        try {
          const payload = collectAcPayload();
          const res = await fetch("/api/activecampaign/config", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.error || "Failed to save ActiveCampaign settings");
          if (acSidebarStatusEl) acSidebarStatusEl.textContent = payload.enabled ? "On" : "Off";
          if (acApiKeyEl && payload.apiKey) {
            acApiKeyEl.value = "";
            acApiKeyEl.placeholder = "Saved (leave blank to keep current key)";
          }
          showToast("ActiveCampaign settings saved!");
        } catch (err: any) {
          showToast(err?.message || "Failed to save settings", true);
        } finally {
          if (acSaveBtn) acSaveBtn.disabled = false;
        }
      });

      acTestBtn?.addEventListener("click", async () => {
        acTestBtn.disabled = true;
        acTestBtn.textContent = "Sending...";
        try {
          const payload = collectAcPayload();
          const res = await fetch("/api/activecampaign/test", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              ...payload,
              email: acTestEmailEl?.value.trim() || "test-lead@adaptif.studio",
            }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data?.error || "Test sync failed");
          showToast(`Test lead synced (Contact #${data.contactId})`);
        } catch (err: any) {
          showToast(err?.message || "Test sync failed", true);
        } finally {
          acTestBtn.disabled = false;
          acTestBtn.textContent = "Send Test Lead";
        }
      });
    </script>

