---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import WhyUsHero from "../components/WhyUsHero.astro";
import BrandLogos from "../components/BrandLogos.astro";
import WhyUsCreativePartner from "../components/WhyUsCreativePartner.astro";
import WhyUsValuesAndImpact from "../components/WhyUsValuesAndImpact.astro";
import Footer from "../components/Footer.astro";

export const prerender = false;
---

<Layout
  title="Why Us — Adaptif"
  description="The creative force behind world-leading brands. The only creative service where enterprise teams get the top 1% of global talent, powered by AI, plugged directly into their workflows."
>
  <Header />
  <main>
    <WhyUsHero />
    <BrandLogos />
    <WhyUsCreativePartner />
    <WhyUsValuesAndImpact />
  </main>
  <Footer />
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Shared scroll-reveal system for Why Us */
  :global([data-why-reveal]) {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--why-delay, 0ms),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) var(--why-delay, 0ms);
    will-change: opacity, transform;
  }

  :global([data-why-reveal="scale"]) {
    transform: translateY(16px) scale(0.975);
  }

  :global([data-why-reveal].is-visible) {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-why-reveal]) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const initWhyUsAnimations = () => {
    const revealEls = document.querySelectorAll<HTMLElement>("[data-why-reveal]");
    if (!revealEls.length) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const animateCounter = (el: HTMLElement) => {
      const target = Number(el.dataset.whyCount || "0");
      const suffix = el.dataset.whySuffix || "";
      if (!target || el.dataset.whyCounted === "1") return;
      el.dataset.whyCounted = "1";

      if (prefersReducedMotion) {
        el.textContent = `${target}${suffix}`;
        return;
      }

      const duration = 950;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(target * eased)}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    if (prefersReducedMotion) {
      revealEls.forEach((el) => {
        el.classList.add("is-visible");
        el.querySelectorAll<HTMLElement>("[data-why-count]").forEach(animateCounter);
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const target = entry.target as HTMLElement;
          target.classList.add("is-visible");
          target.querySelectorAll<HTMLElement>("[data-why-count]").forEach(animateCounter);
          observer.unobserve(target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -36px 0px" }
    );

    revealEls.forEach((el) => observer.observe(el));
  };

  initWhyUsAnimations();
  document.addEventListener("astro:page-load", initWhyUsAnimations);
</script>
